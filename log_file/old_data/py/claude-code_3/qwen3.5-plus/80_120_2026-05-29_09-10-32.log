99	    def _connect_robot(self) -> None:
100	        """Initialize and connect to robot hardware."""
101	
102	        keys_to_exclude = ["type"]
103	
104	        if self.robot_type == "lekiwi":
105	            keys_to_exclude.append("port")
106	        else:
107	            keys_to_exclude.append("remote_ip")
108	
109	        robot_params = {k: v for k, v in robot_config.lerobot_config.items() if k not in keys_to_exclude}
110	        
111	        try:
112	            # Create config and robot using LeRobot factory
113	            robot_class, config_class = self.ROBOT_TYPES.get(self.robot_type, (None, None))
114	            if not robot_class:
115	                raise ValueError(f"Unsupported robot type: '{self.robot_type}'")
116	            
117	            cfg = config_class(**robot_params)
118	            self.robot = robot_class(cfg)
119	            self.robot.connect()
120	            logger.info(f"Connected to {self.robot_type}")
121	        except Exception as e:
122	            logger.error(f"Failed to connect to robot: {e}")
123	            raise
