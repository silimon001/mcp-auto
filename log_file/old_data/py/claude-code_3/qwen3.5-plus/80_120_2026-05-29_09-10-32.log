284	@server.tool()
285	def update_calendar_event(event_id: str, update_details: EventUpdateDetails, ctx: Context) -> Dict[str, Any]:
286	    """
287	    Updates an existing calendar event by its ID. Only provided fields will be updated.
288	
289	    Args:
290	        event_id: The ID of the event to update.
291	        update_details: A structured object with the fields to update.
292	    """
293	    creds = get_creds_from_context(ctx)
294	    try:
295	        calendar_service = googleapiclient.discovery.build('calendar', 'v3', credentials=creds)
296	        # First, get the existing event to ensure it exists and to merge updates
297	        event = calendar_service.events().get(calendarId='primary', eventId=event_id).execute()
298	
299	        # Create the update body with only the fields that are provided
300	        update_body = update_details.model_dump(exclude_unset=True)
301	        if 'start_time' in update_body:
302	            event['start']['dateTime'] = update_body['start_time']
303	        if 'end_time' in update_body:
304	            event['end']['dateTime'] = update_body['end_time']
305	        if 'summary' in update_body:
306	            event['summary'] = update_body['summary']
307	        if 'description' in update_body:
308	            event['description'] = update_body['description']
309	            
310	        updated_event = calendar_service.events().update(calendarId='primary', eventId=event['id'], body=event).execute()
311	        return updated_event
312	    except HttpError as e:
313	        raise Exception(f"API Calendar error (HTTP {e.status_code}): {e.reason}")
