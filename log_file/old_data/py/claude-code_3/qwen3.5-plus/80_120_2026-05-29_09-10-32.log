124	@asynccontextmanager
125	async def lifespan(_) -> AsyncIterator[ServerContext]:
126	    """Manage Tastytrade session lifecycle."""
127	    client_secret = os.getenv("TASTYTRADE_CLIENT_SECRET")
128	    refresh_token = os.getenv("TASTYTRADE_REFRESH_TOKEN")
129	    account_id = os.getenv("TASTYTRADE_ACCOUNT_ID")
130	
131	    if not client_secret or not refresh_token:
132	        raise ValueError(
133	            "Missing Tastytrade OAuth credentials. Set TASTYTRADE_CLIENT_SECRET and "
134	            "TASTYTRADE_REFRESH_TOKEN environment variables."
135	        )
136	
137	    try:
138	        session = Session(client_secret, refresh_token)
139	        accounts = await Account.get(session)
140	        logger.info("Successfully authenticated with Tastytrade. Found %s account(s).", len(accounts))
141	    except Exception as e:
142	        logger.error("Failed to authenticate with Tastytrade: %s", e)
143	        raise
144	
145	    if account_id:
146	        account = next((acc for acc in accounts if acc.account_number == account_id), None)
147	        if not account:
148	            available = [acc.account_number for acc in accounts]
149	            raise ValueError(f"Account '{account_id}' not found. Available: {available}")
150	        logger.info("Using specified account: %s", account.account_number)
151	    else:
152	        account = accounts[0]
153	        logger.info("Using default account: %s", account.account_number)
154	
155	    yield ServerContext(session=session, account=account)
