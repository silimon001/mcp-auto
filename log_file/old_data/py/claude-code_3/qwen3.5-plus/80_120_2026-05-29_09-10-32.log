123	async def handle_list_views(
124	    name: str, arguments: Optional[Dict[str, Any]] = None
125	) -> Sequence[
126	    Union[mcp_types.TextContent, mcp_types.ImageContent, mcp_types.EmbeddedResource]
127	]:
128	    """Tool handler to list views in a specified database and schema."""
129	    try:
130	        # Get Snowflake connection from connection manager
131	        conn = connection_manager.get_connection()
132	
133	        # Extract arguments
134	        database = arguments.get("database") if arguments else None
135	        schema = arguments.get("schema") if arguments else None
136	
137	        if not database:
138	            return [
139	                mcp_types.TextContent(
140	                    type="text", text="Error: database parameter is required"
141	                )
142	            ]
143	
144	        # Use the provided database and schema, or use default schema
145	        if database:
146	            conn.cursor().execute(f"USE DATABASE {database}")
147	        if schema:
148	            conn.cursor().execute(f"USE SCHEMA {schema}")
149	        else:
150	            # Get the current schema
151	            cursor = conn.cursor()
152	            cursor.execute("SELECT CURRENT_SCHEMA()")
153	            schema_result = cursor.fetchone()
154	            if schema_result:
155	                schema = schema_result[0]
156	            else:
157	                return [
158	                    mcp_types.TextContent(
159	                        type="text", text="Error: Could not determine current schema"
160	                    )
161	                ]
162	
163	        # Execute query to list views
164	        cursor = conn.cursor()
165	        cursor.execute(f"SHOW VIEWS IN {database}.{schema}")
166	
167	        # Process results
168	        views = []
169	        for row in cursor:
170	            view_name = row[1]  # View name is in the second column
171	            created_on = row[5]  # Creation date
172	            views.append(f"{view_name} (created: {created_on})")
173	
174	        cursor.close()
175	        # Don't close the connection, just the cursor
176	
177	        if views:
178	            return [
179	                mcp_types.TextContent(
180	                    type="text",
181	                    text=f"Views in {database}.{schema}:\n" + "\n".join(views),
182	                )
183	            ]
184	        else:
185	            return [
186	                mcp_types.TextContent(
187	                    type="text", text=f"No views found in {database}.{schema}"
188	                )
189	            ]
190	
191	    except Exception as e:
192	        return [
193	            mcp_types.TextContent(type="text", text=f"Error listing views: {str(e)}")
194	        ]
