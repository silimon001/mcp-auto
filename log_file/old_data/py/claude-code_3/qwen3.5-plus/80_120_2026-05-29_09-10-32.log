97	async def _resolve_order_inputs(
98	    ctx: Context,
99	    legs: list[OrderLeg],
100	    target_value: float | None,
101	) -> tuple[list[InstrumentDetail], list[OrderLeg], Decimal, OrderSizingResult | None]:
102	    """Resolve instruments and determine the order price."""
103	    session = get_session(ctx)
104	    instrument_specs = [leg.to_instrument_spec() for leg in legs]
105	    instrument_details = await get_instrument_details(session, instrument_specs)
106	
107	    try:
108	        pricing_policy = default_pricing_policy()
109	        market = await _fetch_order_market(ctx, instrument_details, legs)
110	        resolved_price, warnings = resolve_order_price(market, pricing_policy)
111	        sizing_policy = None
112	        if target_value is not None:
113	            sizing_policy = OrderSizingPolicy(
114	                target_value=Decimal(str(target_value)),
115	                min_quantity=1,
116	                max_quantity=None,
117	            )
118	        sized_legs, sizing_result = apply_order_sizing(instrument_details, legs, resolved_price, sizing_policy)
119	        for warning in warnings:
120	            await ctx.warning(warning)
121	        await ctx.info(
122	            f"Resolved limit price {format_signed_money(resolved_price)} "
123	            f"from mid ({format_order_market(market)})."
124	        )
125	        logger.info(f"Auto-calculated price {resolved_price} for {len(legs)}-leg order")
126	        if sizing_result is not None:
127	            await ctx.info(
128	                f"Sized order to {sizing_result.quantity} unit(s): "
129	                f"${sizing_result.estimated_value.quantize(Decimal('0.01'))} estimated value "
130	                f"from ${sizing_result.target_value} target."
131	            )
132	        return instrument_details, sized_legs, resolved_price, sizing_result
133	    except Exception as e:
134	        logger.warning(f"Failed to resolve safe price for order legs {[leg.symbol for leg in legs]}: {e!s}")
135	        raise ValueError(f"Could not resolve a safe limit price from live quotes: {e!s}") from e
