1	#!/usr/bin/env python3
2	"""
3	Script to start the SemaphoreMCP server using FastMCP.
4	"""
5	
6	import argparse
7	import os
8	
9	from semaphore_mcp.server import start_server
10	
11	
12	def parse_args():
13	    """Parse command-line arguments."""
14	    parser = argparse.ArgumentParser(description="Start the SemaphoreMCP server")
15	
16	    parser.add_argument(
17	        "--url",
18	        help="SemaphoreUI API URL (default: from SEMAPHORE_URL env or http://localhost:3000)",
19	        default=os.environ.get("SEMAPHORE_URL", "http://localhost:3000"),
20	    )
21	    parser.add_argument(
22	        "--token",
23	        help="SemaphoreUI API token (default: from SEMAPHORE_API_TOKEN env)",
24	        default=os.environ.get("SEMAPHORE_API_TOKEN"),
25	    )
26	    parser.add_argument(
27	        "--transport",
28	        help="Transport type: stdio or http (default: from MCP_TRANSPORT env or stdio)",
29	        choices=["stdio", "http"],
30	        default=os.environ.get("MCP_TRANSPORT", "stdio"),
31	    )
32	    parser.add_argument(
33	        "--host",
34	        help="Host to bind to for HTTP transport (default: from MCP_HOST env or 0.0.0.0)",
35	        default=os.environ.get("MCP_HOST", "0.0.0.0"),
36	    )
37	    parser.add_argument(
38	        "--port",
39	        help="Port for HTTP transport (default: from MCP_PORT env or 8000)",
40	        type=int,
41	        default=int(os.environ.get("MCP_PORT", "8000")),
42	    )
43	    parser.add_argument(
44	        "--verbose", "-v", help="Enable verbose logging", action="store_true"
45	    )
46	
47	    return parser.parse_args()
48	
49	
50	def main():
51	    """Main entry point."""
52	    args = parse_args()
53	
54	    if args.verbose:
55	        import logging
56	
57	        logging.getLogger("semaphore_mcp").setLevel(logging.DEBUG)
58	
59	    start_server(
60	        semaphore_url=args.url,
61	        semaphore_token=args.token,
62	        transport=args.transport,
63	        host=args.host,
64	        port=args.port,
65	    )
66	
67	
68	if __name__ == "__main__":
69	    main()
70	

