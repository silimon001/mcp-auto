79	def model_to_json_schema(model_class: Type[PydanticBaseModel]) -> JsonSchema:
80	    """
81	    Convert a Pydantic model to a JSON schema.
82	
83	    Args:
84	        model_class: The Pydantic model class to convert
85	
86	    Returns:
87	        A dictionary representing the JSON schema
88	    """
89	    properties = {}
90	    required = []
91	
92	    for field_name, field_info in model_class.model_fields.items():
93	        field_type = field_info.annotation
94	        field_description = field_info.description
95	
96	        # Track required fields
97	        if field_info.is_required():
98	            required.append(field_name)
99	
100	        # Map field type to JSON schema type
101	        field_schema = {"type": get_json_type(field_type)}
102	
103	        # Add description if available
104	        if field_description:
105	            field_schema["description"] = field_description
106	
107	        properties[field_name] = field_schema
108	
109	    schema = {"type": "object", "properties": properties}
110	    if required:
111	        schema["required"] = required
112	
113	    return schema
114	
115	
116	def get_json_type(python_type) -> str:
117	    """
118	    Map Python types to JSON schema types.
119	
120	    Args:
121	        python_type: The Python type to map
122	
123	    Returns:
124	        The corresponding JSON schema type as a string
125	    """
126	    type_map = {
127	        str: "string",
128	        int: "integer",
129	        float: "number",
130	        bool: "boolean",
131	        list: "array",
132	        dict: "object",
133	    }
134	
135	    if python_type in type_map:
136	        return type_map[python_type]
137	
138	    origin = get_origin(python_type)
139	    if origin is not None:
140	        if origin in (list, set, tuple):
141	            return "array"
142	        elif origin is dict:
143	            return "object"
144	        elif origin is Union:
145	            args = get_args(python_type)
146	            if len(args) == 2 and type(None) in args:
147	                non_none_type = next(arg for arg in args if arg is not type(None))
148	                return get_json_type(non_none_type)
149	
150	    return "string"
