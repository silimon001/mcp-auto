1913	            focus_result = subprocess.run(
1914	                ["rg", "-l", "-i", "--type", "py", focus_area, repo_path],
1915	                capture_output=True,
1916	                text=True,
1917	                cwd=working_directory
1918	            )
1919	            if focus_result.returncode == 0:
1920	                output_lines.append(f"Found {len(focus_result.stdout.split())} files related to {focus_area}")
1921	        
1922	        # Get CodeRank data for prioritization
1923	        try:
1924	            coderank_results = calculate_coderank(repo_path=repo_path)
1925	            module_scores = coderank_results["module_ranks"]
1926	        except:
1927	            module_scores = {}
1928	        
1929	        pattern_results = {}
1930	        
1931	        # Search for each error handling pattern
1932	        for pattern_name, pattern_regex in error_patterns.items():
1933	            rg_result = subprocess.run(
1934	                ["rg", "-n", "-i", "--type", "py", pattern_regex, search_path],
1935	                capture_output=True,
1936	                text=True,
1937	                cwd=working_directory
1938	            )
1939	            
1940	            if rg_result.returncode == 0:
1941	                lines = rg_result.stdout.split('\n')
1942	                pattern_results[pattern_name] = []
1943	                
1944	                for line in lines[:20]:  # Limit to top 20 per pattern
1945	                    if ':' in line:
1946	                        parts = line.split(':', 2)
1947	                        if len(parts) >= 3:
1948	                            file_path = parts[0]
1949	                            line_number = parts[1]
1950	                            content = parts[2].strip()
1951	                            
1952	                            # Get module importance
1953	                            module_fqn = path_to_module_fqn(os.path.join(repo_path, file_path), repo_path)
1954	                            score = module_scores.get(module_fqn, 0) if module_fqn else 0
1955	                            
1956	                            pattern_results[pattern_name].append({
1957	                                'file': file_path,
1958	                                'line': line_number,
1959	                                'content': content,
1960	                                'score': score
1961	                            })
1962	                
1963	                # Sort by importance
1964	                pattern_results[pattern_name].sort(key=lambda x: x['score'], reverse=True)
1965	        
1966	        # Analyze and present results
1967	        for pattern_name, results in pattern_results.items():
1968	            if results:
1969	                output_lines.append(f"\n=== {pattern_name.replace('_', ' ').title()} ({len(results)} occurrences) ===")
1970	                
1971	                # Show top examples
1972	                for result in results[:5]:
1973	                    rel_path = os.path.relpath(result['file'], repo_path)
1974	                    importance = f" (importance: {result['score']:.4f})" if result['score'] > 0 else ""
1975	                    output_lines.append(f"  • {rel_path}:{result['line']}{importance}")
1976	                    output_lines.append(f"    {result['content']}")
1977	                
1978	                if len(results) > 5:
1979	                    output_lines.append(f"    ... and {len(results) - 5} more occurrences")
1980	        
1981	        # Look for antipatterns if requested
1982	        if include_antipatterns:
1983	            output_lines.append(f"\n=== Potential Error Handling Issues ===")
1984	            
1985	            if custom_antipatterns:
1986	                antipatterns = custom_antipatterns
1987	            else:
1988	                antipatterns = {
1989	                    "bare_except": r"except:",
1990	                    "pass_in_except": r"except.*:\s*pass",
1991	                    "print_errors": r"print.*error|print.*exception",
1992	                    "swallowed_exceptions": r"except.*:\s*(?:pass|continue|return)"
1993	                }
1994	            
1995	            issues_found = []
1996	            for antipattern_name, antipattern_regex in antipatterns.items():
1997	                ap_result = subprocess.run(
