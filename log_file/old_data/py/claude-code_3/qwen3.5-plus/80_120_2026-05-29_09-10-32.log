1	#!/usr/bin/env python3
2	"""
3	1C RAG + MCP сервер. Индексирует выгрузку 1С XML, CPU-only.
4	Поддержка нескольких ИБ.
5	Usage: python -m code_search
6	"""
7	import socket
8	import threading
9	import sys
10	import os
11	
12	# Отключаем телеметрию Qdrant ДО всех импортов
13	os.environ["QDRANT_TELEMETRY_DISABLED"] = "1"
14	
15	import uvicorn
16	from pathlib import Path
17	
18	from .config_manager import ConfigManager, IBConfig
19	from .app_context import IBManager
20	from .web import create_app
21	from .cli import parse_args
22	from .logger import setup_logging, get_logger
23	
24	
25	def is_port_in_use(port: int) -> bool:
26	    """Проверка занятости порта."""
27	    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
28	        return s.connect_ex(("127.0.0.1", port)) == 0
29	
30	
31	def find_process_on_port(port: int) -> tuple[int | None, str | None]:
32	    """Найти PID процесса, занявшего порт (Windows)."""
33	    import subprocess
34	    try:
35	        result = subprocess.run(
36	            ["netstat", "-ano", "-p", "TCP"],
37	            capture_output=True, text=True, timeout=5
38	        )
39	        for line in result.stdout.splitlines():
40	            if f":{port}" in line and "LISTENING" in line:
41	                parts = line.split()
42	                if parts:
43	                    pid = int(parts[-1])
44	                    # Получаем имя процесса
45	                    tasklist = subprocess.run(
46	                        ["tasklist", "/FI", f"PID eq {pid}", "/FO", "CSV", "/NH"],
47	                        capture_output=True, text=True, timeout=5
48	                    )
49	                    proc_name = tasklist.stdout.split(",")[0].strip('"') if tasklist.stdout else "unknown"
50	                    return pid, proc_name
51	    except Exception:
52	        pass
53	    return None, None
54	
55	
56	def main():
57	    # 1. Настройка логирования - ПЕРВЫМ ДЕЛОМ (ротация старого лога)
58	    logger = setup_logging()  # Сначала с уровнем по умолчанию
59	    logger.info("Запуск Multi-IB Code Search...")
60	
61	    args = parse_args()
62	    
63	    # 2. Загрузка конфигурации
64	    config_mgr = ConfigManager()
65	    config = config_mgr.load()
66	    
67	    # Переопределение порта из аргументов
68	    if args.port:
69	        config.port = args.port
70	
71	    # Применяем уровень логирования из конфига
72	    import logging
73	    level = getattr(logging, config.log_level.upper(), logging.INFO)
74	    logging.getLogger().setLevel(level)
75	
76	    # 3. Проверка занятости порта ДО тяжёлой инициализации
77	    if is_port_in_use(config.port):
78	        pid, proc_name = find_process_on_port(config.port)
79	        if pid:
80	            logger.error(f"Порт {config.port} занят процессом {proc_name} (PID {pid}). Для завершения: taskkill /PID {pid} /F")
81	        else:
82	            logger.error(f"Порт {config.port} уже занят. Возможно, приложение уже запущено.")
83	        sys.exit(1)
84	
85	    # 4. Инициализация менеджера ИБ (фоновая загрузка моделей)
86	    ib_manager = IBManager(config_mgr)
87	    
88	    # 5. Создание приложения (сразу доступен веб-интерфейс)
89	    app = create_app(ib_manager)
90	    
91	    logger.info(f"Сервер доступен на http://localhost:{config.port}")
92	    if not config.ibs:
93	        logger.warning("Список ИБ пуст. Добавьте ИБ через веб-интерфейс.")
94	
95	    # 6. Запуск сервера
96	    try:
97	        uvicorn.run(app, host="0.0.0.0", port=config.port, log_level=config.log_level.lower())
98	    except KeyboardInterrupt:
99	        logger.info("Остановка по KeyboardInterrupt...")
100	        # Stop background threads
101	        for ctx in ib_manager.get_working_contexts():
102	            ctx.stop_maintenance()
103	
104	
105	if __name__ == "__main__":
106	    main()
107	

