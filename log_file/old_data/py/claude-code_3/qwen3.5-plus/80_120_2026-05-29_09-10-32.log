2067	@mcp.tool()
2068	def trace_feature_implementation(
2069	    repo_path: str,
2070	    working_directory: str,
2071	    feature_keywords: List[str],
2072	    file_categories: Dict[str, List[str]],
2073	    include_tests: bool = True,
2074	    include_config: bool = True,
2075	    trace_depth: int = 3
2076	) -> str:
2077	    """
2078	    Map all code involved in implementing a specific feature from UI to data layer.
2079	    
2080	    Use this tool when you need to:
2081	    - Understand all components involved in a feature before modifying it
2082	    - Map feature implementation across multiple layers (UI, business logic, data)
2083	    - Find all related code that might be affected by feature changes
2084	    - Understand how a feature is structured and organized
2085	    
2086	    Perfect for feature modification, debugging feature issues, or understanding
2087	    complex feature implementations that span multiple modules.
2088	    
2089	    Args:
2090	        repo_path: Repository path (absolute)
2091	        working_directory: Working directory (absolute path)
2092	        feature_keywords: List of keywords that identify the feature (e.g., ["login", "authenticate"])
2093	        file_categories: Dictionary mapping category names to path patterns for file organization.
2094	            Format: {"category_name": ["pattern1", "pattern2", ...]}
2095	            
2096	            Example:
2097	            {
2098	                "ui_frontend": ["view", "template", "component", "ui", "frontend"],
2099	                "api_controllers": ["api", "controller", "endpoint", "route"],
2100	                "business_logic": ["service", "business", "logic", "core"],
2101	                "data_models": ["model", "entity", "schema", "db"],
2102	                "utilities": ["util", "helper", "common"],
2103	                "tests": ["test", "spec"],
2104	                "config": ["config", "setting", "env"]
2105	            }
2106	            
2107	            Files are categorized by checking if any pattern appears in the file path.
2108	            Use descriptive category names that match your project structure.
2109	        include_tests: Whether to include test files in the analysis
2110	        include_config: Whether to include configuration files
2111	        trace_depth: How deep to trace dependencies
2112	    
2113	    Returns:
2114	        Complete feature implementation map with all involved components by layer
2115	    """
2116	    try:
2117	        output_lines = ["=== Feature Implementation Analysis ===\n"]
2118	        output_lines.append(f"Feature keywords: {', '.join(feature_keywords)}")
2119	        output_lines.append(f"Repository: {repo_path}")
2120	        output_lines.append(f"Include tests: {include_tests}")
2121	        output_lines.append(f"Include config: {include_config}")
2122	        output_lines.append(f"Trace depth: {trace_depth}\n")
2123	        
2124	        # Get CodeRank data for prioritization
2125	        try:
2126	            coderank_results = calculate_coderank(repo_path=repo_path)
2127	            module_scores = coderank_results["module_ranks"]
2128	            import_graph = coderank_results["import_graph"]
2129	        except:
2130	            module_scores = {}
2131	            import_graph = None
2132	        
2133	        # Find all files containing feature keywords
2134	        all_matches = []
2135	        
2136	        for keyword in feature_keywords:
2137	            # Search for the keyword in Python files
2138	            rg_result = subprocess.run(
2139	                ["rg", "-l", "-i", "--type", "py", keyword, repo_path],
2140	                capture_output=True,
2141	                text=True,
2142	                cwd=working_directory
2143	            )
2144	            
2145	            if rg_result.returncode == 0:
2146	                for file_path in rg_result.stdout.strip().split('\n'):
2147	                    if file_path:
2148	                        all_matches.append(file_path)
2149	        
2150	        # Remove duplicates and categorize files
2151	        unique_files = list(set(all_matches))
2152	        
2153	        # Categorize files using user-provided patterns
2154	        categorized_files = {category: [] for category in file_categories.keys()}
2155	        categorized_files['uncategorized'] = []
2156	        
2157	        for file_path in unique_files:
2158	            rel_path = os.path.relpath(file_path, repo_path)
2159	            lower_path = rel_path.lower()
2160	            
2161	            # Skip test files if not requested
2162	            if not include_tests and any(test_pattern in lower_path for test_pattern in file_categories.get('tests', [])):
2163	                continue
2164	                
2165	            # Skip config files if not requested  
2166	            if not include_config and any(config_pattern in lower_path for config_pattern in file_categories.get('config', [])):
2167	                continue
2168	            
2169	            # Categorize based on user-provided patterns
2170	            categorized = False
2171	            for category, patterns in file_categories.items():
2172	                if any(pattern in lower_path for pattern in patterns):
2173	                    categorized_files[category].append(file_path)
2174	                    categorized = True
2175	                    break
2176	            
2177	            if not categorized:
2178	                categorized_files['uncategorized'].append(file_path)
2179	        
2180	        # For each category, show files with importance scores and key symbols
2181	        for category, files in categorized_files.items():
2182	            if not files:
2183	                continue
2184	                
2185	            output_lines.append(f"\n=== {category.replace('_', ' ').title()} ({len(files)} files) ===")
2186	            
2187	            # Sort files by importance
2188	            scored_files = []
2189	            for file_path in files:
2190	                module_fqn = path_to_module_fqn(file_path, repo_path)
2191	                score = module_scores.get(module_fqn, 0) if module_fqn else 0
2192	                scored_files.append((file_path, score))
2193	            
2194	            scored_files.sort(key=lambda x: x[1], reverse=True)
2195	            
2196	            for file_path, score in scored_files:
2197	                rel_path = os.path.relpath(file_path, repo_path)
2198	                importance = f" (importance: {score:.4f})" if score > 0 else ""
2199	                output_lines.append(f"  📁 {rel_path}{importance}")
2200	                
2201	                # Get key symbols from this file related to the feature
2202	                try:
2203	                    symbols_output = get_repo_symbols(
2204	                        repo=repo_path,
2205	                        working_directory=working_directory,
2206	                        file_must_contain=rel_path
2207	                    )
2208	                    
2209	                    # Filter symbols that might be related to the feature
2210	                    feature_symbols = []
2211	                    for line in symbols_output:
2212	                        if isinstance(line, str) and '|' in line and not line.startswith('-'):
2213	                            for keyword in feature_keywords:
2214	                                if keyword.lower() in line.lower():
2215	                                    parts = re.split(r'\s{2,}', line)
2216	                                    if len(parts) >= 2:
2217	                                        symbol_name = parts[0]
2218	                                        symbol_type = parts[1]
2219	                                        feature_symbols.append(f"{symbol_type}: {symbol_name}")
2220	                                    break
2221	                    
2222	                    if feature_symbols:
2223	                        for symbol in feature_symbols[:3]:  # Show top 3 related symbols
2224	                            output_lines.append(f"    • {symbol}")
2225	                
2226	                except Exception:
2227	                    pass  # Skip symbol analysis if it fails
2228	        
2229	        # Analyze dependencies between feature files
2230	        if import_graph:
2231	            output_lines.append(f"\n=== Feature Dependencies ===")
2232	            
2233	            feature_modules = []
2234	            for file_path in unique_files:
2235	                module_fqn = path_to_module_fqn(file_path, repo_path)
2236	                if module_fqn:
2237	                    feature_modules.append(module_fqn)
2238	            
2239	            # Find dependencies between feature modules
2240	            internal_deps = []
2241	            external_deps = []
2242	            
2243	            for module in feature_modules:
2244	                if module in import_graph:
2245	                    # Check dependencies
2246	                    for dependency in import_graph.successors(module):
2247	                        if dependency in feature_modules:
2248	                            internal_deps.append((module, dependency))
2249	                        else:
2250	                            # Only show high-importance external dependencies
2251	                            dep_score = module_scores.get(dependency, 0)
2252	                            if dep_score > 0.01:
2253	                                external_deps.append((module, dependency, dep_score))
2254	            
2255	            if internal_deps:
2256	                output_lines.append("Internal feature dependencies:")
2257	                for source, target in internal_deps[:10]:
2258	                    output_lines.append(f"  • {source} → {target}")
2259	            
2260	            if external_deps:
2261	                output_lines.append("Important external dependencies:")
2262	                external_deps.sort(key=lambda x: x[2], reverse=True)
2263	                for source, target, score in external_deps[:5]:
2264	                    output_lines.append(f"  • {source} → {target} (importance: {score:.4f})")
2265	        
2266	        # Find potential feature entry points
2267	        output_lines.append(f"\n=== Potential Entry Points ===")
2268	        entry_patterns = ["def.*" + "|".join(feature_keywords), "class.*" + "|".join(feature_keywords)]
2269	        
2270	        entry_points = []
2271	        for pattern in entry_patterns:
2272	            ep_result = subprocess.run(
2273	                ["rg", "-n", "-i", "--type", "py", pattern, repo_path],
2274	                capture_output=True,
2275	                text=True,
2276	                cwd=working_directory
2277	            )
2278	            
2279	            if ep_result.returncode == 0:
2280	                for line in ep_result.stdout.split('\n')[:5]:
2281	                    if ':' in line:
2282	                        entry_points.append(line)
2283	        
2284	        if entry_points:
2285	            for entry in entry_points:
2286	                output_lines.append(f"  • {entry}")
2287	        else:
2288	            output_lines.append("  • No obvious entry points found")
2289	        
2290	        # Summary
2291	        output_lines.append(f"\n=== Feature Implementation Summary ===")
2292	        total_files = len(unique_files)
2293	        output_lines.append(f"Total files involved: {total_files}")
2294	        
2295	        # Count by category
2296	        for category, files in categorized_files.items():
2297	            if files:
2298	                output_lines.append(f"  • {category.replace('_', ' ').title()}: {len(files)} files")
2299	        
