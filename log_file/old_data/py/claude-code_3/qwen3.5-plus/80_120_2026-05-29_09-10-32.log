390	            playbook: Playbook file path (e.g., "playbook.yml")
391	            inventory_id: Inventory ID
392	            repository_id: Repository ID
393	            environment_id: Environment ID
394	            description: Template description
395	            arguments: Extra arguments (JSON string, e.g., "[]")
396	            allow_override_args_in_task: Allow overriding arguments in task
397	            suppress_success_alerts: Suppress success alerts
398	            app: Application type (default: "ansible")
