143	def format_results(response: AIRecommendationsResponse) -> str:
144	    """
145	    Helper function to format the API response into a human-readable string.
146	    """
147	    if response.status != "success":
148	        return "The API response was not successful."
149	
150	    query = response.response.query or "No query provided"
151	    results = response.response.results or []
152	
153	    formatted_text = f"Search Query: {query}\n\n"
154	    for idx, result in enumerate(results, start=1):
155	        formatted_text += (
156	            f"Result {idx}:\n"
157	            f"Title: {result.title or 'No title'}\n"
158	            f"Author: {result.author or 'Unknown author'}\n"
159	            f"Published on: {result.pubdate or 'No date available'}\n"
160	            f"Source: {result.site or 'Unknown site'} ({result.site_domain or 'No domain'})\n"
161	            f"URL: {result.source_url or 'No URL available'}\n"
162	            f"Image URL: {result.image_url or 'No URL available'}\n"
163	            f"Summary: {result.summary or 'No summary available'}\n"
164	            f"Score: {result.score or 'No score available'}\n\n"
165	        )
166	    return formatted_text
