200	def _compact_order_legs(legs: list[Any] | None) -> str | None:
201	    if not legs:
202	        return None
203	    parts = []
204	    for leg in legs:
205	        action = compact_value(getattr(leg, "action", None))
206	        quantity = compact_value(getattr(leg, "quantity", None))
207	        symbol = getattr(leg, "symbol", None)
208	        if action and quantity and symbol:
209	            parts.append(f"{action} {quantity} {symbol}")
210	        elif symbol:
211	            parts.append(str(symbol))
212	    return "; ".join(parts) if parts else None
213	
