195	@mcp.tool()
196	async def obsidian_create_note(
197	    path: str, 
198	    content: str, 
199	    metadata: Optional[Dict[str, Any]] = None
200	) -> bool:
201	    """Create a new note in your Obsidian vault.
202	    
203	    Creates a new markdown note at the specified path in the currently open Obsidian vault.
204	    If the note already exists, it will be overwritten.
205	    
206	    Args:
207	        path: Path where to create the note relative to vault root (e.g., "Folder/Note.md" or "Note.md")
208	            - Must include the .md extension
209	            - Case-sensitive
210	            - Use forward slashes (/) for folder separators
211	            - Parent folders will be created automatically if they don't exist
212	        content: Content of the note (markdown text)
213	        metadata: Optional YAML frontmatter metadata as a dictionary (default: None)
214	    
215	    Returns:
216	        True if successful
217	    
218	    Examples:
219	        - obsidian_create_note(path="Project Ideas.md", content="# Project Ideas\n\n- First idea\n- Second idea")
220	        - obsidian_create_note(
221	            path="Projects/Website/Tasks.md", 
222	            content="# Website Tasks\n\n1. Design homepage\n2. Create navigation",
223	            metadata={"tags": ["project", "website"], "status": "in-progress"}
224	          )
225	    """
226	    global client
227	    
228	    # Initialize client if needed
229	    if not client:
230	        await initialize_client()
231	    
232	    try:
233	        return await client.create_note(path, content, metadata)
234	    except ObsidianError as e:
235	        raise RuntimeError(f"Failed to create note: {str(e)}")
236	
