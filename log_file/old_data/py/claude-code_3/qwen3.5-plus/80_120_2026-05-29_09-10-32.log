378	async def handle_execute_query(
379	    name: str, arguments: Optional[Dict[str, Any]] = None
380	) -> Sequence[
381	    Union[mcp_types.TextContent, mcp_types.ImageContent, mcp_types.EmbeddedResource]
382	]:
383	    """Tool handler to execute read-only SQL queries against Snowflake."""
384	    try:
385	        # Get Snowflake connection from connection manager
386	        conn = connection_manager.get_connection()
387	
388	        # Extract arguments
389	        query = arguments.get("query") if arguments else None
390	        database = arguments.get("database") if arguments else None
391	        schema = arguments.get("schema") if arguments else None
392	        limit_rows = (
393	            int(arguments.get("limit", 100))
394	            if arguments and arguments.get("limit") is not None
395	            else 100
396	        )  # Default limit to 100 rows
397	
398	        if not query:
399	            return [
400	                mcp_types.TextContent(
401	                    type="text", text="Error: query parameter is required"
402	                )
403	            ]
404	
405	        # Validate that the query is read-only
406	        try:
407	            parsed_statements = sqlglot.parse(query, dialect="snowflake")
408	            read_only_types = {"select", "show", "describe", "explain", "with"}
409	
410	            if not parsed_statements:
411	                raise ParseError("Error: Could not parse SQL query")
412	
413	            for stmt in parsed_statements:
414	                if (
415	                    stmt is not None
416	                    and hasattr(stmt, "key")
417	                    and stmt.key
418	                    and stmt.key.lower() not in read_only_types
419	                ):
420	                    raise ParseError(
421	                        f"Error: Only read-only queries are allowed. Found statement type: {stmt.key}"
422	                    )
423	
424	        except ParseError as e:
425	            return [
426	                mcp_types.TextContent(
427	                    type="text",
428	                    text=f"Error: Only SELECT/SHOW/DESCRIBE/EXPLAIN/WITH queries are allowed for security reasons. {str(e)}",
429	                )
430	            ]
431	
432	        # Use the specified database and schema if provided
433	        if database:
434	            conn.cursor().execute(f"USE DATABASE {database}")
435	        if schema:
436	            conn.cursor().execute(f"USE SCHEMA {schema}")
437	
438	        # Extract database and schema context info for logging/display
439	        context_cursor = conn.cursor()
440	        context_cursor.execute("SELECT CURRENT_DATABASE(), CURRENT_SCHEMA()")
441	        context_result = context_cursor.fetchone()
442	        if context_result:
443	            current_db, current_schema = context_result
444	        else:
445	            current_db, current_schema = "Unknown", "Unknown"
446	        context_cursor.close()
447	
448	        # Ensure the query has a LIMIT clause to prevent large result sets
449	        # Parse the query to check if it already has a LIMIT
450	        if "LIMIT " not in query.upper():
451	            # Remove any trailing semicolon before adding the LIMIT clause
452	            query = query.rstrip().rstrip(";")
453	            query = f"{query} LIMIT {limit_rows};"
454	
455	        # Execute the query
456	        cursor = conn.cursor()
457	        cursor.execute(query)
458	
459	        # Get column names and types
460	        column_names = (
461	            [col[0] for col in cursor.description] if cursor.description else []
462	        )
463	
464	        # Fetch only up to limit_rows
465	        rows = cursor.fetchmany(limit_rows)
466	        row_count = len(rows) if rows else 0
467	
468	        cursor.close()
469	        # Don't close the connection, just the cursor
470	
471	        if rows:
472	            # Format the results as a markdown table
473	            result = f"## Query Results (Database: {current_db}, Schema: {current_schema})\n\n"
474	            result += f"Showing {row_count} row{'s' if row_count != 1 else ''}\n\n"
475	            result += f"```sql\n{query}\n```\n\n"
476	
477	            # Create header row
478	            result += "| " + " | ".join(column_names) + " |\n"
479	            result += "| " + " | ".join(["---" for _ in column_names]) + " |\n"
480	
481	            # Add data rows
482	            for row in rows:
483	                formatted_values = []
484	                for val in row:
485	                    if val is None:
486	                        formatted_values.append("NULL")
487	                    else:
488	                        # Format the value as string and escape any pipe characters
489	                        # Truncate very long values to prevent huge tables
490	                        val_str = str(val).replace("|", "\\|")
491	                        if len(val_str) > 200:  # Truncate long values
492	                            val_str = val_str[:197] + "..."
493	                        formatted_values.append(val_str)
494	                result += "| " + " | ".join(formatted_values) + " |\n"
495	
496	            return [mcp_types.TextContent(type="text", text=result)]
497	        else:
498	            return [
499	                mcp_types.TextContent(
500	                    type="text",
501	                    text=f"Query executed successfully in {current_db}.{current_schema}, but returned no results.",
502	                )
503	            ]
504	
505	    except Exception as e:
506	        return [
507	            mcp_types.TextContent(type="text", text=f"Error executing query: {str(e)}")
508	        ]
