175	@mcp.tool
176	def upload_workout(workout_data: dict) -> dict:
177	    """
178	    Uploads a structured workout to Garmin Connect.
179	
180	    Args:
181	        workout_data: Workout data in JSON format to upload. Use the `generate_workout_data_prompt` tool to create a prompt for the LLM to generate this data.
182	
183	    Returns:
184	        The uploaded workout's ID on Garmin Connect.
185	
186	    Raises:
187	        Exception: If the upload fails or the workout ID is not returned.
188	    """
189	
190	    logger.info("Workout data received from client: %s", workout_data)
191	
192	    try:
193	        # Convert to Garmin payload format
194	        payload = make_payload(workout_data)
195	
196	        # logging the payload for debugging
197	        logger.info("Payload to be sent to Garmin Connect: %s", payload)
198	
199	        # Create workout on Garmin Connect
200	        result = garth.connectapi("/workout-service/workout", method="POST", json=payload)
201	
202	        # logging the result for debugging
203	        logger.info("Response from Garmin Connect: %s", result)
204	
205	        workout_id = result.get("workoutId")
206	
207	        if workout_id is None:
208	            raise Exception("No workout ID returned")
209	
210	        return {"workoutId": str(workout_id)}
211	
212	    except Exception as e:
213	        raise Exception(f"Failed to upload workout to Garmin Connect: {str(e)}")
214	
215	@mcp.tool
216	def get_calendar(year: int, month: int, day: int = None, start: int = 1) -> dict:
217	    """
218	    Get calendar data from Garmin Connect for different time periods.
219	
220	    Args:
221	        year: Year (e.g., 2025)
222	        month: Month (1-12)
223	        day: Day of month (1-31). If provided, gets corresponding weekly view that includes this day.
224	             If omitted, gets monthly view for the entire month.
225	        start: Day offset for weekly queries (defaults to 1). Controls which day of the week
226	               the 7-day period begins. Each increment shifts the start date forward by one day:
227	               - start=0: Week starts on Sunday
228	               - start=1: Week starts on Monday (DEFAULT)
229	               - start=2: Week starts on Tuesday
230	               - start=3: Week starts on Wednesday
231	               - start=4: Week starts on Thursday
232	               And so on. Different start values return different 7-day windows with varying
233	               calendar items, useful for different training schedules and calendar preferences.
234	
235	    Returns:
236	        Calendar data with workouts and activities for the specified period.
237	
238	    Raises:
239	        ValueError: If any of the date parameters are invalid.
240	    """
241	    # Input validation
242	    if not (1900 <= year <= 2100):
243	        raise ValueError(f"Year must be between 1900 and 2100, got {year}")
244	
245	    if not (1 <= month <= 12):
246	        raise ValueError(f"Month must be between 1 and 12, got {month}")
247	
248	    if day is not None:
249	        if not (1 <= day <= 31):
250	            raise ValueError(f"Day must be between 1 and 31, got {day}")
251	
252	    # Convert month from 1-based (human readable) to 0-based (Garmin API)
253	    garmin_month = month - 1
254	
255	    if day is not None:
256	        # Weekly view
257	        endpoint = CALENDAR_WEEK_ENDPOINT.format(
258	            year=year, month=garmin_month, day=day, start=start
259	        )
260	        view_type = "week"
261	    else:
262	        # Monthly view (default)
263	        endpoint = CALENDAR_MONTH_ENDPOINT.format(
264	            year=year, month=garmin_month
265	        )
266	        view_type = "month"
267	
268	    calendar_data = garth.connectapi(endpoint)
269	
270	    return {
271	        "calendar": calendar_data,
272	        "view_type": view_type,
273	        "period": {
274	            "year": year,
275	            "month": month,
276	            "day": day,
277	            "start": start if day else None
278	        }
279	    }
280	
281	@mcp.tool
282	def generate_workout_data_prompt(description: str) -> dict:
283	    """
284	    Generate prompt for LLM to create structured workout data based on a natural language description. The LLM
285	    should use the returned prompt to generate a JSON object that can then be used with the `upload_workout` tool.
286	
287	    Args:
288	        description: Natural language description of the workout
289	
290	    Returns:
291	        Prompt for the LLM to generate structured workout data
292	    """
293	
294	    return {"prompt": f"""
295	    You are a fitness coach.
296	    Given the following workout description, create a structured JSON object that represents the workout.
297	    The generated JSON should be compatible with the `upload_workout` tool.
298	
299	    Workout Description:
300	    {description}
301	
302	    Requirements:
303	    - The output must be valid JSON.
304	    - For pace targets, use decimal minutes per km (e.g., 4:40 min/km = 4.67 minutes per km)
305	    - For time-based steps, use stepDuration in seconds
306	    - For distance-based steps, use stepDistance with appropriate distanceUnit
307	    - Use the following structure for the workout object:
308	    {{
309	    "name": "Workout Name",
310	    "type": "running" | "cycling" | "swimming" | "walking" | "cardio" | "strength",
311	    "steps": [
312	        {{
313	        "stepName": "Step Name",
314	        "stepDescription": "Description",
315	        "endConditionType": "time" | "distance",
316	        "stepDuration": duration_in_seconds,
317	        "stepDistance": distance_value,
318	        "distanceUnit": "m" | "km" | "mile",
319	        "stepType": "warmup" | "cooldown" | "interval" | "recovery" | "rest" | "repeat",
320	        "target": {{
321	            "type": "no target" | "pace" | "heart rate" | "power" | "cadence" | "speed",
322	            "value": [minValue, maxValue] | singleValue,
323	            "unit": "min_per_km" | "bpm" | "watts"
324	        }},
325	        "numberOfIterations": number,
326	        "steps": []
327	        }}
328	    ]
329	    }}
330	
331	    Examples:
332	    - For 4:40 min/km pace: "value": 4.67 or "value": [4.5, 4.8]
333	    - For 160 bpm heart rate: "value": 160 or "value": [150, 170]
334	    - For no target: "type": "no target", "value": null, "unit": null
335	    """}
336	
337	def login():
338	    """Login to Garmin Connect."""
339	    garth_home = os.environ.get("GARTH_HOME", "~/.garth")
340	    try:
341	        garth.resume(garth_home)
342	    except Exception:
343	        email = os.environ.get("GARMIN_EMAIL")
344	        password = os.environ.get("GARMIN_PASSWORD")
345	
346	        if not email or not password:
347	            raise ValueError("Garmin email and password must be provided via environment variables (GARMIN_EMAIL, GARMIN_PASSWORD).")
348	
349	        try:
350	            garth.login(email, password)
351	        except Exception as e:
352	            logger.error("Login failed: %s", e)
353	            sys.exit(1)
354	
355	        # Save credentials for future use
356	        garth.save(garth_home)
357	
358	def main():
359	    """Main entry point for the console script."""
360	    login()
361	    mcp.run()
362	
363	if __name__ == "__main__":
364	    main()
365	

