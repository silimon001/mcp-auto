929	
930	@mcp.tool()
931	def analyze_recent_changes(
932	    repo_path: str,
933	    days_back: int = 30,
934	    target_branch: str = "main",
935	    min_commits: int = 2,
936	    top_n: int = 20,
937	    include_stats: bool = True
938	) -> str:
939	    """
940	    Analyze recent changes using CodeRank to identify most important modifications.
941	    Aggregates changes over the last N days and ranks them by impact.
942	    
943	    Args:
944	        repo_path: Repository path (absolute)
945	        days_back: Number of days to look back for commits
946	        target_branch: Branch to analyze (default: main)
947	        min_commits: Minimum commits to a file to be considered
948	        top_n: Number of top changes to return
949	        include_stats: Include detailed statistics
950	    
951	    Returns:
952	        Ranked list of most important recent changes with metrics
953	    """
954	    try:
955	        # First, get CodeRank scores for context
956	        coderank_results = calculate_coderank(repo_path=repo_path)
957	        module_scores = coderank_results["module_ranks"]
958	        module_map = coderank_results["module_map"]
959	        
960	        # Get recent commits
961	        since_date = (datetime.now() - timedelta(days=days_back)).strftime('%Y-%m-%d')
962	        
963	        # Get commit data with file changes
964	        git_log_cmd = [
965	            "git", "-C", repo_path, "log",
966	            f"--since={since_date}",
967	            f"{target_branch}",
968	            "--name-status",
969	            "--format=%H|%ae|%an|%ad|%s",
970	            "--date=short"
971	        ]
972	        
973	        log_result = subprocess.run(git_log_cmd, capture_output=True, text=True)
974	        if log_result.returncode != 0:
975	            return f"Error getting git log: {log_result.stderr}"
976	        
977	        # Parse commits and changes
978	        commits_data = []
979	        current_commit = None
980	        
981	        for line in log_result.stdout.split('\n'):
982	            if not line.strip():
983	                continue
984	                
985	            if '|' in line and not line.startswith(('A\t', 'M\t', 'D\t')):
986	                # This is a commit line
987	                parts = line.split('|', 4)
988	                if len(parts) >= 5:
989	                    if current_commit:
990	                        commits_data.append(current_commit)
991	                    
992	                    current_commit = {
993	                        'hash': parts[0],
994	                        'author_email': parts[1],
995	                        'author_name': parts[2],
996	                        'date': parts[3],
997	                        'message': parts[4],
998	                        'files': []
999	                    }
1000	            elif line.startswith(('A\t', 'M\t', 'D\t')) and current_commit:
1001	                # This is a file change
1002	                status, filepath = line.split('\t', 1)
1003	                if filepath.endswith('.py'):
1004	                    current_commit['files'].append({
1005	                        'status': status,
1006	                        'path': filepath
1007	                    })
1008	        
1009	        if current_commit:
1010	            commits_data.append(current_commit)
1011	        
1012	        # Aggregate changes by module
1013	        module_changes: Dict[str, ModuleChangeData] = defaultdict(create_module_change_data)
1014	        
1015	        # Process each commit
1016	        for commit in commits_data:
1017	            for file_change in commit['files']:
1018	                filepath = file_change['path']
1019	                abs_filepath = os.path.join(repo_path, filepath)
1020	                
1021	                # Convert to module name
1022	                module_fqn = path_to_module_fqn(abs_filepath, repo_path)
1023	                if not module_fqn:
1024	                    continue
1025	                
1026	                # Update module change data
1027	                change_data = module_changes[module_fqn]
1028	                change_data['commits'].append(commit['hash'][:7])
1029	                change_data['authors'].add(commit['author_name'])
1030	                change_data['commit_count'] += 1
1031	                change_data['files'].add(filepath)
1032	                change_data['coderank_score'] = module_scores.get(module_fqn, 0)
1033	        
1034	        # Get line change statistics if requested
1035	        if include_stats:
1036	            for module_fqn, data in module_changes.items():
1037	                if data['commit_count'] >= min_commits:
1038	                    # Get diff stats for this module's files
1039	                    for filepath in data['files']:
1040	                        diff_cmd = [
1041	                            "git", "-C", repo_path, "diff",
1042	                            f"--since={since_date}",
1043	                            f"{target_branch}",
1044	                            "--numstat",
1045	                            "--", filepath
1046	                        ]
1047	                        diff_result = subprocess.run(diff_cmd, capture_output=True, text=True)
1048	                        
1049	                        if diff_result.returncode == 0 and diff_result.stdout:
1050	                            lines = diff_result.stdout.strip().split('\n')
1051	                            for line in lines:
1052	                                if line:
1053	                                    parts = line.split('\t')
1054	                                    if len(parts) >= 2:
1055	                                        try:
1056	                                            added = int(parts[0]) if parts[0] != '-' else 0
1057	                                            deleted = int(parts[1]) if parts[1] != '-' else 0
1058	                                            data['lines_changed'] += added + deleted
1059	                                        except ValueError:
1060	                                            pass
1061	        
1062	        # Calculate change impact scores
1063	        change_scores = []
1064	        
1065	        for module_fqn, data in module_changes.items():
1066	            if data['commit_count'] < min_commits:
1067	                continue
1068	            
1069	            # Calculate composite score
1070	            impact_score = (
1071	                data['coderank_score'] * 1000 +  # Module importance (heavily weighted)
1072	                data['commit_count'] * 10 +       # Frequency of changes
1073	                len(data['authors']) * 50 +       # Contributor diversity
1074	                data['lines_changed'] * 0.1       # Size of changes
1075	            )
1076	            
1077	            # Get file path for this module
1078	            module_file_path = module_map.get(module_fqn, "N/A")
1079	            rel_file_path = os.path.relpath(module_file_path, repo_path) if module_file_path != "N/A" else "N/A"
1080	            
1081	            change_scores.append({
1082	                'module': module_fqn,
1083	                'file_path': rel_file_path,
1084	                'impact_score': impact_score,
1085	                'coderank_score': data['coderank_score'],
1086	                'commit_count': data['commit_count'],
1087	                'unique_authors': len(data['authors']),
1088	                'lines_changed': data['lines_changed'],
1089	                'authors': list(data['authors']),
1090	                'recent_commits': data['commits'][-5:]  # Last 5 commit hashes
1091	            })
1092	        
1093	        # Sort by impact score
1094	        change_scores.sort(key=lambda x: x['impact_score'], reverse=True)
1095	        top_changes = change_scores[:top_n]
1096	        
1097	        # Format output
1098	        output_lines = ["=== Recent Changes Analysis (CodeRank-based) ===\n"]
1099	        output_lines.append(f"Repository: {repo_path}")
1100	        output_lines.append(f"Analysis period: Last {days_back} days")
1101	        output_lines.append(f"Target branch: {target_branch}")
1102	        output_lines.append(f"Total commits analyzed: {len(commits_data)}")
1103	        output_lines.append(f"Modules with significant changes: {len(change_scores)}\n")
1104	        
1105	        output_lines.append("Top Changed Modules by Impact:")
1106	        output_lines.append(f"{'Module'.ljust(35)} | {'File Path'.ljust(35)} | {'Impact'.rjust(7)} | {'CodeRank'.rjust(8)} | {'Commits'.rjust(7)} | {'Authors'.rjust(7)} | {'Lines ±'.rjust(8)}")
1107	        output_lines.append("-" * 130)
1108	        
1109	        for change in top_changes:
1110	            output_lines.append(
1111	                f"{change['module'][:35].ljust(35)} | "
1112	                f"{change['file_path'][:35].ljust(35)} | "
1113	                f"{change['impact_score']:7.1f} | "
1114	                f"{change['coderank_score']:8.4f} | "
1115	                f"{change['commit_count']:7d} | "
1116	                f"{change['unique_authors']:7d} | "
1117	                f"{change['lines_changed']:8d}"
1118	            )
1119	        
1120	        # Add insights
1121	        output_lines.append("\n=== Key Insights ===")
1122	        
1123	        # Find high-impact changes
1124	        high_impact = [c for c in top_changes if c['coderank_score'] > 0.01]
1125	        if high_impact:
1126	            output_lines.append(f"\n• Critical Module Changes ({len(high_impact)} modules):")
1127	            for change in high_impact[:5]:
1128	                output_lines.append(f"  - {change['module']}: {change['commit_count']} commits by {change['unique_authors']} authors")
1129	                output_lines.append(f"    File: {change['file_path']}")
1130	        
1131	        # Find hotspots (many commits)
1132	        hotspots = [c for c in top_changes if c['commit_count'] > 10]
1133	        if hotspots:
1134	            output_lines.append(f"\n• Change Hotspots (frequently modified):")
1135	            for change in hotspots[:3]:
1136	                output_lines.append(f"  - {change['module']}: {change['commit_count']} commits")
1137	                output_lines.append(f"    File: {change['file_path']}")
1138	        
1139	        # Find collaborative changes
1140	        collaborative = [c for c in top_changes if c['unique_authors'] > 3]
1141	        if collaborative:
1142	            output_lines.append(f"\n• Collaborative Development Areas:")
1143	            for change in collaborative[:3]:
1144	                authors = ", ".join(change['authors'][:3])
1145	                if len(change['authors']) > 3:
1146	                    authors += f" +{len(change['authors'])-3} more"
1147	                output_lines.append(f"  - {change['module']}: {authors}")
1148	        
1149	        return '\n'.join(output_lines)
1150	        
1151	    except Exception as e:
1152	        return f"Error in analyze_recent_changes: {str(e)}"
1153	
