138	async def _place_new_order(
139	    ctx: Context,
140	    legs: list[OrderLeg],
141	    time_in_force: OrderTimeInForce,
142	    target_value: float | None,
143	    dry_run: bool,
144	) -> dict[str, Any]:
145	    """Resolve a new order and place it."""
