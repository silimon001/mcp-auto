78	def main() -> None:
79	    """CLI entry point — accepts optional transport argument (stdio, sse, streamable-http)."""
80	    import sys
81	
82	    valid = ("stdio", "sse", "streamable-http")
83	    transport = sys.argv[1] if len(sys.argv) > 1 else "stdio"
84	    if transport not in valid:
85	        print(f"Invalid transport '{transport}'. Must be one of: {', '.join(valid)}", file=sys.stderr)
86	        sys.exit(1)
87	    mcp_app.run(transport)  # type: ignore[arg-type]  # validated above
