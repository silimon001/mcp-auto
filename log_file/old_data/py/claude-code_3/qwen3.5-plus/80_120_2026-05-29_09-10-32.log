1	import os
2	from typing import Dict
3	from dotenv import load_dotenv
4	from mcp.server.fastmcp import FastMCP
5	import requests
6	import sys
7	import traceback
8	
9	# Set up exception handling to catch and log errors
10	def handle_exception(exc_type, exc_value, exc_traceback):
11	    print("Uncaught exception:", file=sys.stderr)
12	    traceback.print_exception(exc_type, exc_value, exc_traceback)
13	    return sys.__excepthook__(exc_type, exc_value, exc_traceback)
14	
15	sys.excepthook = handle_exception
16	
17	# Load environment variables
18	load_dotenv()
19	
20	# Get gNucleus API from environment variables
21	GNUCLEUS_HOST = os.getenv("GNUCLEUS_HOST")
22	GNUCLEUS_API_KEY = os.getenv("GNUCLEUS_API_KEY")
23	# optional, only need for enterprise user
24	GNUCLEUS_ORG_ID = os.getenv("GNUCLEUS_ORG_ID") 
25	
26	# Set up the MCP server
27	mcp = FastMCP("gNucleus MCP Server", request_timeout=300)
28	
29	# Helper function for gNucleus REST API requests
30	def gnucleus_api_request(endpoint: str, payload: Dict = None) -> Dict | None:
31	    """Make a request to the gNucleus REST API"""
32	    if payload is None:
33	        payload = {}
34	        
35	    if not all([GNUCLEUS_HOST, GNUCLEUS_API_KEY]):
36	        print(f"Missing required GNUCLEUS_HOST and GNUCLEUS_API_KEY in .env file", file=sys.stderr)
37	        return {"message": "Configuration error: Missing API credentials"}
38	
39	    url = f"https://{GNUCLEUS_HOST}:5000/api/{endpoint}"
40	
41	    headers = {
42	        "Authorization": f"Bearer {GNUCLEUS_API_KEY}",
43	        "Content-Type": "application/json"
44	    }
45	    
46	    if GNUCLEUS_ORG_ID:
47	        payload["org_id"] = GNUCLEUS_ORG_ID
48	        
49	    try:
50	        print(f"Making API request to {url}", file=sys.stderr)
51	        response = requests.post(url, headers=headers, json=payload)
52	        response.raise_for_status()
53	        return response.json()
54	    except requests.exceptions.RequestException as e:
55	        print(f"API request error: {e}", file=sys.stderr)
56	        return {"message": f"API request failed: {str(e)}"}
57	    except Exception as e:
58	        print(f"Unexpected error: {e}", file=sys.stderr)
59	        traceback.print_exc(file=sys.stderr)
60	        return {"message": "An unexpected error occurred"}
61	
62	
63	@mcp.tool()
64	def text_to_cad(input: str) -> str:
65	    """Transform a text prompt into a CAD Part or CAD Assembly and
66	    return a markdown summary plus a viewer URL."""
67	    print(f"text_to_cad called with input: {input}", file=sys.stderr)
68	
69	    # ----- call gNucleus API -----
70	    response = gnucleus_api_request("text_to_cad", {"input": input})
71	    if not response:
72	        return f"gNucleus failed to generate CAD for '{input}' and no response from server, check your GNUCLEUS_HOST and GNUCLEUS_API_KEY"
73	
74	    # ----- validate/normalize ID -----
75	    gnucleus_id = str(response.get("id", ""))
76	    if not gnucleus_id or not gnucleus_id.startswith("gnucleus-"):
77	        return f"gNucleus failed to generate CAD for '{input}' and the reponse is {response} "    
78	
79	    # ----- build markdown -----
80	    result_lines: list[str] = []
81	    result_lines.append(f"### gNucleus\n\n{response.get('message', '')}\n")
82	
83	    design_spec = response.get("design_spec", {}) or {}
84	    key_params = design_spec.get("key_parameters")
85	    conditions  = design_spec.get("conditions")
86	    description = design_spec.get("description")
87	
88	    shared_result_url = f"https://gnucleus.ai/app/viewer/{gnucleus_id}"
89	    if response.get("is_assembly", False):
90	        asm_info  = response.get("assemblies_info", {}) or {}
91	        root_asm  = asm_info.get("root_assembly", None)
92	        if root_asm:
93	            result_lines.append(f"**Assembly:** `{root_asm}`\n")
94	            shared_result_url = f"https://gnucleus.ai/app/viewer/{gnucleus_id}/{root_asm}"
95	            result_lines.append(f"\n⚙️⚙️⚙️ **View the generated Root Assembly in this viewer URL:** {shared_result_url}\n")
96	        else:
97	            result_lines.append(f"\n⚙️⚙️⚙️ **Unable to generated Root Assembly**. Please check your input and try again.\n")
98	
99	        if key_params:
100	            result_lines.append("**Key Parameters (assembly)**\n\n")
101	            result_lines.append(key_params.strip() if isinstance(key_params, str) else str(key_params))
102	        if conditions:
103	            result_lines.append(f"**Conditions:** {conditions}\n")
104	        if description:
105	            result_lines.append(f"**Description:** {description}\n")
106	
107	        # list parts
108	        parts = asm_info.get("parts", [])
109	        if parts:
110	            result_lines.append("\n**Parts**\n")
111	            for p in parts:
112	                pname   = p.get("part_name", "(unnamed part)")
113	                pparams = p.get("key_parameters", "")
114	                result_lines.append(f"* **{pname}**\n")
115	                if pparams:
116	                    result_lines.append(pparams.strip() if isinstance(pparams, str) else str(pparams))
117	    else:  # single part
118	        if key_params:
119	            result_lines.append("**Key Parameters**\n")
120	            result_lines.append(key_params.strip() if isinstance(key_params, str) else str(key_params))
121	        if conditions:
122	            result_lines.append(f"**Conditions:** {conditions}\n")
123	        if description:
124	            result_lines.append(f"**Description:** {description}\n")
125	        result_lines.append(f"\n⚙️⚙️⚙️ **View the generated CAD in this viewer URL:** {shared_result_url}\n")
126	
127	    print("Generating response successfully", file=sys.stderr)
128	    return "\n".join(result_lines)
129	
130	
131	if __name__ == "__main__":
132	    # Print a startup message
133	    print("Starting gNucleus MCP Server...", file=sys.stderr)
134	    print(f"GNUCLEUS_HOST is {GNUCLEUS_HOST}", file=sys.stderr)
135	    if GNUCLEUS_ORG_ID:
136	        print(f"GNUCLEUS_ORG_ID is {GNUCLEUS_ORG_ID}", file=sys.stderr)
137	    
138	    # Initialize and run the server
