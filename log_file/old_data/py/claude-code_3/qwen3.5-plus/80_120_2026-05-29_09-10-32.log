1	"""
2	Semaphore API client module.
3	
4	This module provides a client for interacting with SemaphoreUI's API.
5	"""
6	
7	import json
8	import os
9	from copy import deepcopy
10	from typing import Any, Optional
11	
12	import requests
13	
14	DEFAULT_REQUEST_TIMEOUT = 30.0
15	
16	
17	class SemaphoreAPIClient:
18	    """Client for interacting with the SemaphoreUI API."""
19	
20	    def __init__(
21	        self,
22	        base_url: str,
23	        token: Optional[str] = None,
24	        request_timeout: float = DEFAULT_REQUEST_TIMEOUT,
25	    ):
26	        """
27	        Initialize the SemaphoreUI API client.
28	
29	        Args:
30	            base_url: Base URL of the SemaphoreUI API (e.g., "http://localhost:3000")
31	            token: Optional API token for authentication
32	            request_timeout: Timeout in seconds for SemaphoreUI API requests
33	        """
34	        self.base_url = base_url.rstrip("/")
35	        self.token = token or os.environ.get("SEMAPHORE_API_TOKEN")
36	        self.request_timeout = request_timeout
37	        self.session = requests.Session()
38	
39	        if self.token:
40	            self.session.headers.update({"Authorization": f"Bearer {self.token}"})
41	
42	        self.session.headers.update(
43	            {"Content-Type": "application/json", "Accept": "application/json"}
44	        )
45	
46	    def _request(self, method: str, endpoint: str, **kwargs) -> dict[str, Any]:
47	        """
48	        Make an HTTP request to the SemaphoreUI API.
49	
50	        Args:
51	            method: HTTP method (GET, POST, PUT, DELETE)
52	            endpoint: API endpoint (without leading slash)
53	            **kwargs: Additional arguments to pass to requests
54	
55	        Returns:
56	            API response as dictionary
57	
58	        Raises:
59	            requests.exceptions.HTTPError: If the request fails
60	        """
61	        url = f"{self.base_url}/api/{endpoint}"
62	        kwargs.setdefault("timeout", self.request_timeout)
63	        response = self.session.request(method, url, **kwargs)
64	
65	        try:
66	            response.raise_for_status()
67	        except requests.exceptions.HTTPError as e:
68	            # Enhance 404 error messages with more context
69	            if response.status_code == 404:
70	                raise requests.exceptions.HTTPError(
71	                    f"Resource not found (404): {url}. "
72	                    f"The requested resource may have been deleted or the ID may be incorrect.",
73	                    response=response,
74	                ) from e
75	            response_body = response.text.strip()
76	            if response_body:
77	                raise requests.exceptions.HTTPError(
78	                    f"{method} {url} failed with {response.status_code}: "
79	                    f"{response_body[:500]}",
80	                    response=response,
81	                ) from e
82	            raise
83	
84	        if response.content:
85	            try:
86	                return response.json()
87	            except json.JSONDecodeError as e:
88	                # Handle cases where response is not valid JSON
89	                raise ValueError(
90	                    f"Invalid JSON response from {url}: {response.text[:200]}..."
91	                ) from e
92	        return {}
93	
