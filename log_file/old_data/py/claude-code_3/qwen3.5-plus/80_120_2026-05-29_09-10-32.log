102	    _retry_count: int
103	    _max_retry_count: int
104	    _retry_backoff_seconds: List[int]
105	
106	    def __new__(cls) -> "SnowflakeConnectionManager":
107	        with cls._lock:
108	            if cls._instance is None:
109	                cls._instance = super(SnowflakeConnectionManager, cls).__new__(cls)
110	                cls._instance._initialized = False
111	            return cls._instance
112	
113	    def __init__(self) -> None:
114	        """Initialize the connection manager if not already initialized."""
115	        if self._initialized:
116	            return
117	
118	        self._connection = None
119	        self._connection_lock = threading.Lock()
120	        self._config = None
121	        self._last_refresh_time = None
122	        self._refresh_thread = None
