793	    def run_task(
794	        self,
795	        project_id: int,
796	        template_id: int,
797	        environment: Optional[dict[str, str]] = None,
798	        limit: Optional[str] = None,
799	        dry_run: Optional[bool] = None,
800	        diff: Optional[bool] = None,
801	        debug: Optional[bool] = None,
802	        playbook: Optional[str] = None,
803	        git_branch: Optional[str] = None,
804	        message: Optional[str] = None,
805	        arguments: Optional[str] = None,
806	        inventory_id: Optional[int] = None,
807	    ) -> dict[str, Any]:
808	        """
809	        Run a task using a template.
810	
811	        Args:
812	            project_id: Project ID
813	            template_id: Template ID
814	            environment: Optional environment variables for the task
815	            limit: Restrict execution to specific hosts/groups (Ansible --limit)
816	            dry_run: Run without making changes (Ansible --check)
817	            diff: Show differences when changing files (Ansible --diff)
818	            debug: Enable verbose debug output
819	            playbook: Override playbook file path
820	            git_branch: Override git branch to use
821	            message: Task description/message
822	            arguments: Additional CLI arguments
823	            inventory_id: Override inventory to use
824	
825	        Returns:
826	            Task information
827	        """
828	        payload: dict[str, Any] = {"template_id": template_id}
829	        if environment:
830	            # Semaphore API expects environment as a JSON string, not a dict
831	            payload["environment"] = json.dumps(environment)
832	        if limit:
833	            payload["limit"] = limit
834	        if dry_run is not None:
835	            payload["dry_run"] = dry_run
836	        if diff is not None:
837	            payload["diff"] = diff
838	        if debug is not None:
839	            payload["debug"] = debug
840	        if playbook:
841	            payload["playbook"] = playbook
842	        if git_branch:
843	            payload["git_branch"] = git_branch
844	        if message:
845	            payload["message"] = message
846	        if arguments:
847	            payload["arguments"] = arguments
848	        if inventory_id is not None:
849	            payload["inventory_id"] = inventory_id
850	
851	        return self._request("POST", f"project/{project_id}/tasks", json=payload)
852	
