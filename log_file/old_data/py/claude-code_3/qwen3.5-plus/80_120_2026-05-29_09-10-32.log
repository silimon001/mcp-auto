70	@mcp.tool
71	def list_activities(limit: int = 20, start: int = 0, activityType: str = None, search: str = None) -> dict:
72	    """
73	    List activities (completed runs, rides, swims, etc.) from Garmin Connect.
74	
75	    Args:
76	        limit: Number of activities to return (default=20)
77	        start: Starting position for pagination (default=0)
78	        activityType: Filter by activity type. Accepted values include:
79	            - "auto_racing", "backcountry_skiing_snowboarding_ws", "bouldering", "breathwork"
80	            - "cross_country_skiing_ws", "cycling", "diving", "e_sport", "fitness_equipment"
81	            - "hiking", "indoor_climbing", "motorcycling", "multi_sport", "offshore_grinding"
82	            - "onshore_grinding", "other", "resort_skiing_snowboarding_ws", "running"
83	            - "safety", "skate_skiing_ws", "surfing", "swimming", "walking"
84	            - "windsurfing", "winter_sports", "yoga"
85	        search: Search for activities containing this string in their name
86	
87	    Returns:
88	        A dictionary containing a list of activities and pagination info.
89	    """
90	    params = {
91	        "limit": limit,
92	        "start": start
93	    }
94	
95	    if activityType is not None:
96	        params["activityType"] = activityType
97	
98	    if search is not None:
99	        params["search"] = search
100	
101	    activities = garth.connectapi(LIST_ACTIVITIES_ENDPOINT, "GET", params=params)
102	    return {"activities": activities}
