317	@server.tool()
318	def list_drive_files(query: str, ctx: Context) -> List[ListedDriveFile]:
319	    """
320	    Searches for files in Google Drive using a query string.
321	
322	    Args:
323	        query: The search query. Examples: "name contains 'report'", "mimeType='application/vnd.google-apps.spreadsheet'".
324	               See Google Drive API docs for full query syntax.
325	    """
326	    creds = get_creds_from_context(ctx)
327	    try:
328	        drive_service = googleapiclient.discovery.build('drive', 'v3', credentials=creds)
329	        
