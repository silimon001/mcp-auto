685	@mcp.tool()
686	async def load_video_memory(ctx: Context, video_path: str, index_path: str) -> dict[str, Any]:
687	    """Load an existing video memory for search and chat.
688	
689	    This allows switching to a different video memory without rebuilding.
690	    If the memory fails to load, it will attempt to auto-rebuild from the JSON metadata.
691	
692	    Args:
693	        video_path: Path to existing .mp4 video memory file (relative paths use library directory)
694	        index_path: Path to existing .json index file (relative paths use library directory)
695	
696	    Returns:
697	        Status dictionary indicating success/failure of loading operation.
698	    """
699	    try:
700	        # Resolve paths using library directory for relative paths
701	        resolved_video_path = _server_state.resolve_file_path(video_path, "video")
702	        resolved_index_path = _server_state.resolve_file_path(index_path, "index")
703	
704	        # Verify files exist
705	        if not os.path.exists(resolved_video_path):
706	            return {"status": "error", "message": f"Video file not found: {resolved_video_path}"}
707	        if not os.path.exists(resolved_index_path):
708	            return {"status": "error", "message": f"Index file not found: {resolved_index_path}"}
709	
710	        if not _check_memvid_available():
711	            return {"status": "error", "message": "Memvid not available - please install memvid package"}
712	
713	        # Attempt to load the memory directly first
714	        def try_load_memory():
715	            """Try to load the memory and return success status."""
716	            try:
717	                logger.info(f"Attempting to load retriever from {resolved_video_path}, {resolved_index_path}")
718	                logger.info(f"File sizes - Video: {os.path.getsize(resolved_video_path)} bytes, Index: {os.path.getsize(resolved_index_path)} bytes")
719	
720	                # Check if MemvidRetriever and MemvidChat are available
721	                if MemvidRetriever is None or MemvidChat is None:
722	                    raise RuntimeError("MemvidRetriever or MemvidChat is not available. Please ensure the memvid package is installed correctly.")
723	
724	                # Try initializing retriever first
725	                with redirect_stdout(sys.stderr):
726	                    retriever = MemvidRetriever(resolved_video_path, resolved_index_path)
727	                    chat = MemvidChat(resolved_video_path, resolved_index_path)
728	
729	                # Test if retriever actually works
730	                logger.info("Testing retriever functionality...")
731	                with redirect_stdout(sys.stderr):
732	                    test_results = retriever.search("test", top_k=1)
733	
734	                if test_results is None:
735	                    raise Exception("Retriever returned None for test search")
736	
737	                logger.info(f"Test search returned: {len(test_results)} results")
738	
739	                # If we get here, everything works
740	                _server_state.retriever = retriever
741	                _server_state.chat = chat
742	                _server_state.set_active_memory(resolved_video_path, resolved_index_path)
743	
744	                return True, "Memory loaded successfully"
745	
746	            except Exception as e:
747	                logger.error(f"Direct load failed: {e}")
748	                return False, str(e)
749	
750	        # First attempt: try to load directly
751	        success, message = try_load_memory()
752	
753	        if success:
754	            logger.info(f"Successfully loaded video memory: {resolved_video_path}")
755	            return {
756	                "status": "success",
757	                "video_path": resolved_video_path,
758	                "index_path": resolved_index_path,
759	                "message": f"Loaded video memory: {os.path.basename(resolved_video_path)}"
760	            }
761	
762	        # If direct load failed, attempt auto-rebuild
763	        logger.info(f"Direct load failed ({message}), attempting auto-rebuild...")
764	
765	        rebuild_success = await _rebuild_memory_from_json(resolved_video_path, resolved_index_path)
