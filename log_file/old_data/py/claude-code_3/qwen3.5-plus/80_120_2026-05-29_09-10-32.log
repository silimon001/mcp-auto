235	    def _refresh_connection_periodically(self) -> None:
236	        """Background thread that refreshes the connection periodically."""
237	        while not self._stop_event.is_set():
238	            # Sleep for a short interval and check if it's time to refresh
239	            if self._stop_event.wait(60):  # Check every minute
240	                break
