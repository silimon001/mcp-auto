1155	@mcp.tool()
1156	def get_commit_hotspots(
1157	    repo_path: str,
1158	    days_back: int = 30,
1159	    min_cochange_frequency: int = 3,
1160	    top_n: int = 10
1161	) -> str:
1162	    """
1163	    Find modules that are frequently changed together in commits.
1164	    Identifies coupled modules that might have hidden dependencies.
1165	    
1166	    Args:
1167	        repo_path: Repository path
1168	        days_back: Days to analyze
1169	        min_cochange_frequency: Minimum times modules must change together
1170	        top_n: Number of top coupled module pairs to return
1171	    
1172	    Returns:
1173	        Analysis of modules that frequently change together
1174	    """
1175	    try:
1176	        # Get CodeRank data for context
1177	        coderank_results = calculate_coderank(repo_path=repo_path)
1178	        module_scores = coderank_results["module_ranks"]
1179	        
1180	        since_date = (datetime.now() - timedelta(days=days_back)).strftime('%Y-%m-%d')
1181	        
1182	        # Get commits with changed files
1183	        git_cmd = [
1184	            "git", "-C", repo_path, "log",
1185	            f"--since={since_date}",
1186	            "--name-only",
1187	            "--format=%H|%an|%ae|%ad",
1188	            "--date=short"
1189	        ]
1190	        
1191	        result = subprocess.run(git_cmd, capture_output=True, text=True)
1192	        if result.returncode != 0:
1193	            return f"Error getting git log: {result.stderr}"
1194	        
1195	        # Parse commits and their files
1196	        commits = []
1197	        current_commit = None
1198	        
1199	        for line in result.stdout.split('\n'):
1200	            if '|' in line:
1201	                if current_commit and current_commit['modules']:
1202	                    commits.append(current_commit)
1203	                
1204	                parts = line.split('|')
1205	                current_commit = {
1206	                    'hash': parts[0],
1207	                    'author': parts[1],
1208	                    'email': parts[2],
1209	                    'date': parts[3],
1210	                    'modules': set()
1211	                }
1212	            elif line.strip() and line.endswith('.py') and current_commit:
1213	                # Convert file to module
1214	                abs_path = os.path.join(repo_path, line.strip())
1215	                module_fqn = path_to_module_fqn(abs_path, repo_path)
1216	                if module_fqn:
1217	                    current_commit['modules'].add(module_fqn)
1218	        
1219	        if current_commit and current_commit['modules']:
1220	            commits.append(current_commit)
1221	        
1222	        # Find co-occurring modules
1223	        cochange_pairs: Dict[Tuple[str, str], CochangeData] = defaultdict(create_cochange_data)
1224	        
1225	        for commit in commits:
1226	            modules = list(commit['modules'])
1227	            if len(modules) < 2:
1228	                continue
1229	            
1230	            # Generate all pairs
1231	            for i in range(len(modules)):
1232	                for j in range(i + 1, len(modules)):
1233	                    pair = tuple(sorted([modules[i], modules[j]]))
1234	                    data = cochange_pairs[pair]
1235	                    data['count'] += 1
1236	                    data['commits'].append(commit['hash'][:7])
1237	                    data['authors'].add(commit['author'])
1238	                    
1239	                    # Calculate combined CodeRank score
1240	                    score1 = module_scores.get(modules[i], 0)
1241	                    score2 = module_scores.get(modules[j], 0)
1242	                    data['combined_coderank'] = score1 + score2
1243	        
1244	        # Filter and sort
1245	        significant_pairs = []
1246	        for pair, data in cochange_pairs.items():
1247	            if data['count'] >= min_cochange_frequency:
1248	                significant_pairs.append({
1249	                    'modules': pair,
1250	                    'frequency': data['count'],
1251	                    'unique_authors': len(data['authors']),
1252	                    'combined_coderank': data['combined_coderank'],
1253	                    'coupling_score': data['count'] * data['combined_coderank'] * 100,
1254	                    'recent_commits': data['commits'][-3:]
1255	                })
1256	        
1257	        significant_pairs.sort(key=lambda x: x['coupling_score'], reverse=True)
1258	        top_pairs = significant_pairs[:top_n]
1259	        
1260	        # Format output
1261	        output_lines = ["=== Commit Hotspot Analysis ===\n"]
1262	        output_lines.append(f"Repository: {repo_path}")
1263	        output_lines.append(f"Period: Last {days_back} days")
1264	        output_lines.append(f"Total commits analyzed: {len(commits)}")
1265	        output_lines.append(f"Coupled module pairs found: {len(significant_pairs)}\n")
1266	        
1267	        output_lines.append("Top Coupled Modules (frequently changed together):")
1268	        output_lines.append(f"{'Module 1'.ljust(30)} | {'Module 2'.ljust(30)} | {'Freq'.rjust(4)} | {'Score'.rjust(7)}")
1269	        output_lines.append("-" * 80)
1270	        
1271	        for pair_data in top_pairs:
1272	            mod1, mod2 = pair_data['modules']
1273	            output_lines.append(
1274	                f"{mod1[:30].ljust(30)} | "
1275	                f"{mod2[:30].ljust(30)} | "
1276	                f"{pair_data['frequency']:4d} | "
1277	                f"{pair_data['coupling_score']:7.1f}"
1278	            )
1279	        
1280	        # Add insights
1281	        output_lines.append("\n=== Coupling Insights ===")
1282	        
1283	        # Find high-importance coupled modules
1284	        high_importance_pairs = [p for p in top_pairs if p['combined_coderank'] > 0.02]
1285	        if high_importance_pairs:
1286	            output_lines.append("\n• High-importance coupled modules:")
1287	            for pair in high_importance_pairs[:3]:
1288	                output_lines.append(f"  - {pair['modules'][0]} ↔ {pair['modules'][1]}")
1289	                output_lines.append(f"    Changed together {pair['frequency']} times")
1290	        
1291	        # Find potential refactoring candidates
1292	        high_coupling = [p for p in top_pairs if p['frequency'] > 10]
1293	        if high_coupling:
1294	            output_lines.append("\n• Potential refactoring candidates (high coupling):")
1295	            for pair in high_coupling[:3]:
1296	                output_lines.append(f"  - {pair['modules'][0]} & {pair['modules'][1]}")
1297	                output_lines.append(f"    Consider: merge, extract common interface, or clarify boundaries")
1298	        
1299	        return '\n'.join(output_lines)
1300	        
1301	    except Exception as e:
1302	        return f"Error in get_commit_hotspots: {str(e)}"
1303	
