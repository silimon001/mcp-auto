168	def parse_architecture_description(description: str) -> Dict[str, List[str]]:
169	    """解析架构描述，提取组件信息"""
170	    components = {
171	        'frontend': [],
172	        'gateway': [],
173	        'services': [],
174	        'cache': [],
175	        'queue': [],
176	        'database': [],
177	        'storage': [],
178	        'monitoring': [],
179	        'external': []
180	    }
181	    
182	    # 前端组件关键词
183	    frontend_keywords = ['ios app', 'android app', 'web应用', 'mobile', '移动应用', 'app', 'react', 'vue', 'angular', '前端', 'ui', '用户界面', '小程序', 'h5', '单页应用']
184	    # 网关组件关键词
185	    gateway_keywords = ['api网关', 'gateway', '负载均衡', 'load balancer', 'cdn', 'nginx', 'haproxy', '反向代理', 'kong', 'zuul']
186	    # 服务组件关键词
187	    service_keywords = ['用户服务', '商品服务', '订单服务', '购物车服务', '支付服务', '推荐服务', '营销服务', '物流服务', '客服服务', '服务', 'service', '微服务', 'microservice', 'api']
188	    # 缓存组件关键词
189	    cache_keywords = ['redis', 'memcached', '缓存', 'cache', 'redis集群']
190	    # 队列组件关键词
191	    queue_keywords = ['kafka', 'rabbitmq', 'rocketmq', 'mq', '消息队列', 'queue', '队列', 'apache kafka']
192	    # 数据库关键词
193	    database_keywords = ['mysql', 'postgresql', 'mongodb', 'cassandra', 'elasticsearch', 'hbase', 'influxdb', '数据库', 'database', 'db', '主从集群', '数据仓库', 'hadoop', 'spark']
194	    # 存储关键词
