1999	                    capture_output=True,
2000	                    text=True,
2001	                    cwd=working_directory
2002	                )
2003	                
2004	                if ap_result.returncode == 0:
2005	                    lines = ap_result.stdout.split('\n')[:5]  # Top 5 issues
2006	                    for line in lines:
2007	                        if line.strip():
2008	                            issues_found.append(f"{antipattern_name}: {line}")
2009	            
2010	            if issues_found:
2011	                for issue in issues_found:
2012	                    output_lines.append(f"  ⚠️  {issue}")
2013	            else:
2014	                output_lines.append("  ✅ No obvious error handling antipatterns detected")
2015	        
2016	        # Show evolution if requested
2017	        if show_evolution:
2018	            output_lines.append(f"\n=== Error Handling Evolution (last {days_back} days) ===")
2019	            
2020	            since_date = (datetime.now() - timedelta(days=days_back)).strftime('%Y-%m-%d')
2021	            
2022	            # Look for error-related commits
2023	            git_cmd = [
2024	                "git", "-C", repo_path, "log",
2025	                f"--since={since_date}",
2026	                "--grep=error",
2027	                "--grep=exception",
2028	                "--grep=fix",
2029	                "--oneline",
2030	                "--max-count=10"
2031	            ]
2032	            
2033	            git_result = subprocess.run(git_cmd, capture_output=True, text=True)
2034	            if git_result.returncode == 0 and git_result.stdout:
2035	                commits = git_result.stdout.strip().split('\n')
2036	                output_lines.append(f"Recent error-related commits ({len(commits)}):")
2037	                for commit in commits:
2038	                    output_lines.append(f"  • {commit}")
2039	            else:
2040	                output_lines.append("No recent error-related commits found")
2041	        
2042	        # Summary and recommendations
2043	        output_lines.append(f"\n=== Error Handling Summary ===")
2044	        total_patterns = sum(len(results) for results in pattern_results.values())
2045	        output_lines.append(f"Total error handling patterns found: {total_patterns}")
2046	        
2047	        # Most common pattern
2048	        if pattern_results:
2049	            most_common = max(pattern_results.items(), key=lambda x: len(x[1]))
2050	            output_lines.append(f"Most common pattern: {most_common[0]} ({len(most_common[1])} occurrences)")
2051	        
2052	        # Recommendations
2053	        output_lines.append(f"\n=== Recommendations ===")
2054	        if pattern_results.get("try_except"):
2055	            output_lines.append("✅ Codebase uses try/except blocks - follow this pattern")
2056	        if pattern_results.get("logging_errors"):
2057	            output_lines.append("✅ Codebase logs errors - continue this practice")
2058	        if pattern_results.get("custom_exceptions"):
2059	            output_lines.append("✅ Custom exceptions defined - use appropriate ones")
2060	        
2061	        return '\n'.join(output_lines)
2062	        
2063	    except Exception as e:
2064	        return f"Error in analyze_error_patterns: {str(e)}"
