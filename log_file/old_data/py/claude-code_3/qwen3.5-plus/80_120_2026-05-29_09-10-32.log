1	"""MCP server implementation for Snowflake.
2	
3	This module provides a Model Context Protocol (MCP) server that allows Claude
4	to perform read-only operations against Snowflake databases. It connects to
5	Snowflake using either service account authentication with a private key or
6	external browser authentication. It exposes various tools for querying database
7	metadata and data, including support for multi-view and multi-database queries.
8	
9	The server is designed to be used with Claude Desktop as an MCP server, providing
10	Claude with secure, controlled access to Snowflake data for analysis and reporting.
11	"""
12	
13	import os
14	from typing import Any, Dict, List, Optional, Sequence, Union
15	
16	import anyio
17	import mcp.types as mcp_types
18	import sqlglot
19	from dotenv import load_dotenv
20	from mcp.server import Server
21	from mcp.server.stdio import stdio_server
22	from sqlglot.errors import ParseError
23	
24	from snowflake_mcp_server.utils.snowflake_conn import (
25	    AuthType,
26	    SnowflakeConfig,
27	    connection_manager,
28	)
29	
30	# Load environment variables from .env file
31	load_dotenv()
32	
33	
34	# Initialize Snowflake configuration from environment variables
35	def get_snowflake_config() -> SnowflakeConfig:
36	    """Load Snowflake configuration from environment variables."""
37	    auth_type_str = os.getenv("SNOWFLAKE_AUTH_TYPE", "private_key").lower()
38	    auth_type = (
39	        AuthType.PRIVATE_KEY
40	        if auth_type_str == "private_key"
41	        else AuthType.EXTERNAL_BROWSER
42	    )
43	
44	    config = SnowflakeConfig(
45	        account=os.getenv("SNOWFLAKE_ACCOUNT", ""),
46	        user=os.getenv("SNOWFLAKE_USER", ""),
47	        auth_type=auth_type,
48	        warehouse=os.getenv("SNOWFLAKE_WAREHOUSE"),
49	        database=os.getenv("SNOWFLAKE_DATABASE"),
50	        schema_name=os.getenv("SNOWFLAKE_SCHEMA"),
51	        role=os.getenv("SNOWFLAKE_ROLE"),
52	    )
53	
54	    # Only set private_key_path if using private key authentication
55	    if auth_type == AuthType.PRIVATE_KEY:
56	        config.private_key_path = os.getenv("SNOWFLAKE_PRIVATE_KEY_PATH", "")
57	
58	    return config
59	
60	
61	# Initialize the connection manager at startup
62	def init_connection_manager() -> None:
63	    """Initialize the connection manager with Snowflake config."""
64	    config = get_snowflake_config()
65	    connection_manager.initialize(config)
66	
67	
68	# Define MCP server
69	def create_server() -> Server:
70	    """Create and configure the MCP server."""
71	    # Initialize the connection manager before setting up the server
72	    init_connection_manager()
73	
74	    server: Server = Server(
75	        name="snowflake-mcp-server",
76	        version="0.2.0",
77	        instructions="MCP server for performing read-only operations against "
78	        "Snowflake.",
79	    )
80	
81	    return server
