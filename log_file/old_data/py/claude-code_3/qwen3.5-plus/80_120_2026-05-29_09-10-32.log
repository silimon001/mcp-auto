234	@mcp.tool()
235	def coderank_analysis(
236	    repo_path: str,
237	    external_modules: str = "google,genai,langchain,langgraph,dspy,agn,torch,numpy",
238	    top_n: int = 10,
239	    analyze_markdown: bool = False,
240	    output_format: str = "summary"
241	) -> str:
242	    """
243	    Analyze repository importance using CodeRank algorithm to identify critical modules.
244	    
245	    Args:
246	        repo_path: Path to the repository (absolute path)
247	        external_modules: Comma-separated list of external modules to track
248	        top_n: Number of top modules to return
249	        analyze_markdown: Include markdown files in analysis
250	        output_format: "summary" for key results, "detailed" for full analysis, "json" for machine-readable
251	    
252	    Returns:
253	        Ranked list of most important modules with scores
254	    """
255	    try:
256	        # Parse external modules
257	        external_module_list = [m.strip() for m in external_modules.split(',') if m.strip()]
258	        
259	        # Run coderank analysis
260	        results = calculate_coderank(
261	            repo_path=repo_path,
262	            external_modules=external_module_list,
263	            analyze_markdown=analyze_markdown
264	        )
265	        
266	        # Sort module ranks
267	        sorted_module_ranks = sorted(
268	            results["module_ranks"].items(),
269	            key=lambda x: x[1],
270	            reverse=True
271	        )
272	        
273	        # Sort markdown ranks if available
274	        sorted_markdown_ranks = []
275	        if analyze_markdown and results["markdown_ranks"]:
276	            sorted_markdown_ranks = sorted(
277	                results["markdown_ranks"].items(),
278	                key=lambda x: x[1],
279	                reverse=True
280	            )
281	        
282	        if output_format == "json":
283	            # Return JSON format
284	            output = {
285	                "repo_path": repo_path,
286	                "external_modules": external_module_list,
287	                "top_modules": [
288	                    {"module": module, "score": score}
289	                    for module, score in sorted_module_ranks[:top_n]
290	                ],
291	                "total_modules": len(results["module_ranks"])
292	            }
293	            
294	            if analyze_markdown:
295	                output["top_markdown_files"] = [
296	                    {"file": os.path.basename(file), "path": file, "score": score}
297	                    for file, score in sorted_markdown_ranks[:top_n]
298	                ]
299	            
300	            return json.dumps(output, indent=2)
301	        
302	        elif output_format == "summary":
303	            # Build summary output
304	            lines = ["=== CodeRank Analysis Summary ===\n"]
305	            lines.append(f"Repository: {repo_path}")
306	            lines.append(f"Total modules analyzed: {len(results['module_ranks'])}")
307	            lines.append(f"External modules tracked: {', '.join(external_module_list)}\n")
308	            lines.append("Top modules by importance:")
309	            lines.append(f"{'Module'.ljust(40)} | {'CodeRank Score'.rjust(14)}")
310	            lines.append("-" * 57)
311	            
312	            for module, score in sorted_module_ranks[:top_n]:
313	                lines.append(f"{module[:40].ljust(40)} | {score:14.6f}")
314	            
315	            if analyze_markdown and sorted_markdown_ranks:
316	                lines.append("\n=== Top Markdown Files ===")
317	                lines.append(f"{'File'.ljust(30)} | {'Score'.rjust(14)}")
318	                lines.append("-" * 47)
319	                for file, score in sorted_markdown_ranks[:top_n]:
320	                    filename = os.path.basename(file)[:30]
321	                    lines.append(f"{filename.ljust(30)} | {score:14.6f}")
322	            
323	            return '\n'.join(lines)
324	        
325	        else:  # detailed
326	            # Build detailed output
327	            lines = ["=== CodeRank Detailed Analysis ===\n"]
328	            lines.append(f"Repository: {repo_path}")
329	            lines.append(f"Total modules: {len(results['module_ranks'])}")
330	            lines.append(f"Total symbols extracted: {len(results['python_symbols_db'])}")
331	            lines.append(f"External modules: {', '.join(external_module_list)}\n")
332	            
333	            lines.append("All modules ranked by importance:")
334	            lines.append(f"{'Rank'.rjust(5)} | {'Module'.ljust(50)} | {'Score'.rjust(14)} | {'File Path'}")
335	            lines.append("-" * 120)
336	            
337	            for i, (module, score) in enumerate(sorted_module_ranks, 1):
338	                file_path = results["module_map"].get(module, "N/A")
339	                rel_path = os.path.relpath(file_path, repo_path) if file_path != "N/A" else "N/A"
340	                lines.append(f"{i:5d} | {module[:50].ljust(50)} | {score:14.6f} | {rel_path}")
341	            
342	            if analyze_markdown and sorted_markdown_ranks:
343	                lines.append("\n=== All Markdown Files Ranked ===")
344	                lines.append(f"{'Rank'.rjust(5)} | {'File'.ljust(40)} | {'Score'.rjust(14)} | {'Full Path'}")
345	                lines.append("-" * 100)
346	                for i, (file, score) in enumerate(sorted_markdown_ranks, 1):
347	                    filename = os.path.basename(file)[:40]
348	                    lines.append(f"{i:5d} | {filename.ljust(40)} | {score:14.6f} | {file}")
349	            
350	            return '\n'.join(lines)
351	            
352	    except Exception as e:
353	        return f"Error in coderank_analysis: {str(e)}"
