1	"""Unity Catalog Model Context Protocol Server Implementation.
2	
3	This module implements the Model Context Protocol (MCP) server, which enables AI agents to
4	execute Unity Catalog Functions on behalf of user agents.
5	
6	Features:
7	- Implements an MCP server for Unity Catalog Functions execution.
8	
9	License:
10	MIT License (c) 2025 Shingo OKAWA
11	"""
12	
13	import logging
14	from typing import Optional
15	from mcp.server import NotificationOptions, Server
16	from mcp.server.stdio import stdio_server
17	from mcp.types import Tool
18	from pydantic.networks import AnyHttpUrl
19	from unitycatalog.ai.core.client import UnitycatalogFunctionClient
20	from unitycatalog.client.api_client import ApiClient
21	from unitycatalog.client.configuration import Configuration
22	from mcp_server_unitycatalog.tools import (
23	    Content,
24	    list_tools as list_ucai_tools,
25	    list_udf_tools,
26	    dispatch_tool as dispatch_ucai_tool,
27	    execute_function,
28	)
29	
30	
31	# The logger instance for this module.
32	LOGGER = logging.getLogger(__name__)
33	
34	
35	async def start(endpoint: str, catalog: str, schema: str) -> None:
36	    """Starts the MCP Unity Catalog server and initializes the API client.
37	
38	    This function sets up the server and logs the connection details.
39	
40	    Args:
41	        endpoint (str): The base URL of the Unity Catalog API server.
42	        catalog (str): The name of the Unity Catalog catalog.
43	        schema (str): The name of the schema within the catalog.
44	
45	    Returns:
46	        None
47	    """
48	    server = Server("mcp-unitycatalog")
49	    client = UnitycatalogFunctionClient(
50	        api_client=ApiClient(configuration=Configuration(host=endpoint))
51	    )
52	
53	    @server.list_tools()
54	    async def list_tools() -> list[Tool]:
55	        return list_udf_tools(client) + list_ucai_tools()
56	
57	    @server.call_tool()
58	    async def call_tool(name: str, arguments: dict) -> list[Content]:
59	        tool = dispatch_ucai_tool(name)
60	        if tool is not None:
61	            return tool.func(server.request_context, client, arguments)
62	        else:
63	            return execute_function(client, name, arguments)
64	
65	    options = server.create_initialization_options(
66	        notification_options=NotificationOptions(
67	            resources_changed=True, tools_changed=True
68	        )
69	    )
70	    LOGGER.info(f"start serving: options: {options}")
71	    async with stdio_server() as (read_stream, write_stream):
72	        await server.run(read_stream, write_stream, options, raise_exceptions=True)
73	

