300	def list_tools() -> list[Tool]:
301	    """Returns a list of available Unity Catalog AI tools.
302	
303	    This function generates a list of `Tool` instances based on the `UnityCatalogAiTools`
304	    enumeration, providing structured metadata for each tool.
305	
306	    Returns:
307	        list[Tool]: A list of `Tool` objects, each containing:
308	    """
309	    return [
310	        Tool(
311	            name=name,
312	            description=tool.description,
313	            inputSchema=tool.input_schema,
314	        )
315	        for name, tool in UNITY_CATALOG_AI_TOOLS.items()
316	    ]
