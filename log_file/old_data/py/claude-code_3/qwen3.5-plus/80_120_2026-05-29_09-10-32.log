350	def dispatch_tool(name: str) -> Optional[UnityCatalogAiTool]:
351	    """Retrieves the Unity Catalog AI tool function by name.
352	
353	    This function looks up and returns the corresponding function
354	    for a given tool name from the `UNITY_CATALOG_AI_TOOLS` registry.
355	
356	    Args:
357	        name (str): The name of the Unity Catalog AI tool.
358	
359	    Returns:
360	        Optional[UnityCatalogAiFunction]: The function corresponding to
361	        the specified tool name if found, otherwise `None`.
362	    """
363	    return UNITY_CATALOG_AI_TOOLS.get(name)
364	
