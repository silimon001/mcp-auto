455	    def update_template(
456	        self,
457	        project_id: int,
458	        template_id: int,
459	        name: Optional[str] = None,
460	        playbook: Optional[str] = None,
461	        inventory_id: Optional[int] = None,
462	        repository_id: Optional[int] = None,
463	        environment_id: Optional[int] = None,
464	        description: Optional[str] = None,
465	        arguments: Optional[str] = None,
466	        allow_override_args_in_task: Optional[bool] = None,
467	        suppress_success_alerts: Optional[bool] = None,
468	        app: Optional[str] = None,
469	        git_branch: Optional[str] = None,
470	        survey_vars: Optional[list[dict[str, Any]]] = None,
471	        vaults: Optional[list[dict[str, Any]]] = None,
472	        template_type: Optional[str] = None,
473	        start_version: Optional[str] = None,
474	        build_template_id: Optional[int] = None,
475	        autorun: Optional[bool] = None,
476	        view_id: Optional[int] = None,
477	        task_params: Optional[dict[str, Any]] = None,
478	    ) -> dict[str, Any]:
479	        """Update an existing template.
480	
481	        Args:
482	            project_id: Project ID
483	            template_id: Template ID
484	            name: Template name (optional)
485	            playbook: Playbook file path (optional)
486	            inventory_id: Inventory ID (optional)
487	            repository_id: Repository ID (optional)
488	            environment_id: Environment ID (optional)
489	            description: Template description (optional)
490	            arguments: Extra arguments (optional)
491	            allow_override_args_in_task: Allow overriding arguments (optional)
492	            suppress_success_alerts: Suppress success alerts (optional)
493	            app: Application type (optional)
494	            git_branch: Git branch (optional)
495	            survey_vars: Survey variables (optional)
496	            vaults: Vault configurations (optional)
497	            template_type: Template type (optional)
498	            start_version: Start version (optional)
499	            build_template_id: Build template ID (optional)
500	            autorun: Enable autorun (optional)
501	            view_id: View ID (optional)
502	            task_params: App-specific task parameters (optional). For Ansible:
503	                - allow_override_limit: Allow task-level --limit override
504	                - allow_override_inventory: Allow task-level inventory override
505	                - allow_override_tags: Allow task-level --tags override
506	                - allow_override_skip_tags: Allow task-level --skip-tags override
507	                - limit: Default limit (list of hosts/groups)
508	                - tags: Default tags (list)
509	                - skip_tags: Default skip tags (list)
510	
511	        Returns:
512	            Empty dict on success (204 response)
513	        """
514	        # Fetch existing template to preserve unmodified fields
515	        existing = self.get_template(project_id, template_id)
516	
517	        # Build payload starting from existing values
518	        payload: dict[str, Any] = {
519	            "id": template_id,
520	            "project_id": project_id,
521	            "name": existing.get("name", ""),
522	            "playbook": existing.get("playbook", ""),
523	            "inventory_id": existing.get("inventory_id", 0),
524	            "repository_id": existing.get("repository_id", 0),
525	            "environment_id": existing.get("environment_id", 0),
526	            "description": existing.get("description", ""),
527	            "arguments": existing.get("arguments", ""),
528	            "allow_override_args_in_task": existing.get(
529	                "allow_override_args_in_task", False
530	            ),
531	            "suppress_success_alerts": existing.get("suppress_success_alerts", False),
532	            "app": existing.get("app", ""),
533	            "git_branch": existing.get("git_branch", ""),
534	            "survey_vars": existing.get("survey_vars", []),
535	            "vaults": existing.get("vaults", []),
536	            "type": existing.get("type", ""),
537	            "start_version": existing.get("start_version", ""),
538	            "build_template_id": existing.get("build_template_id"),
539	            "autorun": existing.get("autorun", False),
540	            "view_id": existing.get("view_id"),
541	            "task_params": existing.get("task_params", {}),
542	        }
543	
544	        # Override with specified updates
545	        if name is not None:
546	            payload["name"] = name
547	        if playbook is not None:
548	            payload["playbook"] = playbook
549	        if inventory_id is not None:
550	            payload["inventory_id"] = inventory_id
551	        if repository_id is not None:
552	            payload["repository_id"] = repository_id
553	        if environment_id is not None:
554	            payload["environment_id"] = environment_id
555	        if description is not None:
556	            payload["description"] = description
557	        if arguments is not None:
558	            payload["arguments"] = arguments
559	        if allow_override_args_in_task is not None:
560	            payload["allow_override_args_in_task"] = allow_override_args_in_task
561	        if suppress_success_alerts is not None:
562	            payload["suppress_success_alerts"] = suppress_success_alerts
563	        if app is not None:
564	            payload["app"] = app
565	        if git_branch is not None:
566	            payload["git_branch"] = git_branch
567	        if survey_vars is not None:
568	            payload["survey_vars"] = survey_vars
569	        if vaults is not None:
570	            payload["vaults"] = vaults
571	        if template_type is not None:
572	            payload["type"] = template_type
573	        if start_version is not None:
574	            payload["start_version"] = start_version
575	        if build_template_id is not None:
576	            payload["build_template_id"] = build_template_id
577	        if autorun is not None:
578	            payload["autorun"] = autorun
579	        if view_id is not None:
580	            payload["view_id"] = view_id
581	        if task_params is not None:
582	            payload["task_params"] = task_params
583	
584	        return self._request(
585	            "PUT", f"project/{project_id}/templates/{template_id}", json=payload
586	        )
