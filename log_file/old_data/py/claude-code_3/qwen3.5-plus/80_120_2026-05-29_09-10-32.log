1689	
1690	@mcp.tool()
1691	def trace_data_flow(
1692	    repo_path: str,
1693	    working_directory: str,
1694	    data_identifier: str,
1695	    max_depth: int = 5,
1696	    include_transformations: bool = True,
1697	    show_side_effects: bool = True
1698	) -> str:
1699	    """
1700	    Trace how specific data flows through the system from source to destination.
1701	    
1702	    Use this tool when you need to understand:
1703	    - How a piece of data (user_id, email, order_data, etc.) moves through the codebase
1704	    - What functions transform or modify the data
1705	    - Where data comes from and where it goes
1706	    - What side effects might occur when processing this data
1707	    
1708	    Perfect for debugging data-related issues, understanding data dependencies,
1709	    or planning changes that affect data flow.
1710	    
1711	    Args:
1712	        repo_path: Repository path (absolute)
1713	        working_directory: Working directory (absolute path)
1714	        data_identifier: Name of the data to trace (e.g., "user_id", "email", "order")
1715	        max_depth: How deep to trace the data flow
1716	        include_transformations: Whether to show data transformation points
1717	        show_side_effects: Whether to identify potential side effects
1718	    
1719	    Returns:
1720	        Comprehensive data flow analysis with transformation points and dependencies
1721	    """
1722	    try:
1723	        output_lines = ["=== Data Flow Analysis ===\n"]
1724	        output_lines.append(f"Tracing: {data_identifier}")
1725	        output_lines.append(f"Repository: {repo_path}")
1726	        output_lines.append(f"Max depth: {max_depth}\n")
1727	        
1728	        # Use ripgrep to find all mentions of the data identifier
1729	        rg_result = subprocess.run(
1730	            ["rg", "-n", "-i", "--type", "py", data_identifier, repo_path],
1731	            capture_output=True,
1732	            text=True,
1733	            cwd=working_directory
1734	        )
1735	        
1736	        if rg_result.returncode != 0:
1737	            return f"No occurrences found for data identifier: {data_identifier}"
1738	        
1739	        # Parse occurrences and categorize them
1740	        occurrences = []
1741	        for line in rg_result.stdout.split('\n'):
1742	            if ':' in line:
1743	                parts = line.split(':', 2)
1744	                if len(parts) >= 3:
1745	                    file_path = parts[0]
1746	                    line_number = parts[1]
1747	                    content = parts[2].strip()
1748	                    
1749	                    # Categorize the occurrence
1750	                    category = "usage"
1751	                    if any(pattern in content.lower() for pattern in ['def ', 'class ', 'return ', '=']):
1752	                        if 'def ' in content:
1753	                            category = "function_parameter"
1754	                        elif 'return ' in content:
1755	                            category = "return_value"
1756	                        elif '=' in content and data_identifier in content.split('=')[0]:
