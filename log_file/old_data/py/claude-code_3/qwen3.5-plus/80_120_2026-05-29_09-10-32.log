272	
273	# Enumeration of available Unity Catalog AI tools.
274	UNITY_CATALOG_AI_TOOLS: dict[str, UnityCatalogAiTool] = {
275	    "uc_list_functions": UnityCatalogAiTool(
276	        description="List Unity Catalog Functions within the specified parent catalog and schema. "
277	        "There is no guarantee of a specific ordering of the elements in the array.",
278	        input_schema=ListFunctions.model_json_schema(),
279	        func=_list_functions,
