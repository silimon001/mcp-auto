1305	@mcp.tool()
1306	def contributor_impact_analysis(
1307	    repo_path: str,
1308	    days_back: int = 90,
1309	    min_commits: int = 5,
1310	    focus_on_important_modules: bool = True
1311	) -> str:
1312	    """
1313	    Analyze contributor patterns and their impact on important modules.
1314	    Identifies key contributors and their areas of expertise.
1315	    
1316	    Args:
1317	        repo_path: Repository path
1318	        days_back: Days to analyze
1319	        min_commits: Minimum commits by a contributor to be included
1320	        focus_on_important_modules: Weight contributions by module importance
1321	    
1322	    Returns:
1323	        Contributor impact analysis with expertise areas
1324	    """
1325	    try:
1326	        # Get CodeRank data
1327	        coderank_results = calculate_coderank(repo_path=repo_path)
1328	        module_scores = coderank_results["module_ranks"]
1329	        
1330	        since_date = (datetime.now() - timedelta(days=days_back)).strftime('%Y-%m-%d')
1331	        
1332	        # Get detailed commit data
1333	        git_cmd = [
1334	            "git", "-C", repo_path, "log",
1335	            f"--since={since_date}",
1336	            "--name-status",
1337	            "--format=%H|%ae|%an|%ad|%s",
1338	            "--date=short"
1339	        ]
1340	        
1341	        result = subprocess.run(git_cmd, capture_output=True, text=True)
1342	        if result.returncode != 0:
1343	            return f"Error getting git log: {result.stderr}"
1344	        
1345	        # Parse contributor data
1346	        contributor_data: Dict[str, ContributorData] = defaultdict(create_contributor_data)
1347	        
1348	        current_commit = None
1349	        for line in result.stdout.split('\n'):
1350	            if '|' in line and not line.startswith(('A\t', 'M\t', 'D\t')):
1351	                parts = line.split('|', 4)
1352	                if len(parts) >= 5:
1353	                    current_commit = {
1354	                        'hash': parts[0],
1355	                        'email': parts[1],
1356	                        'name': parts[2],
1357	                        'date': parts[3],
1358	                        'message': parts[4],
1359	                        'modules': set()
1360	                    }
1361	            elif line.startswith(('A\t', 'M\t', 'D\t')) and current_commit:
1362	                status, filepath = line.split('\t', 1)
1363	                if filepath.endswith('.py'):
1364	                    abs_path = os.path.join(repo_path, filepath)
1365	                    module_fqn = path_to_module_fqn(abs_path, repo_path)
1366	                    
1367	                    if module_fqn:
1368	                        contributor = contributor_data[current_commit['name']]
1369	                        contributor['commits'] += 1
1370	                        contributor['modules_touched'].add(module_fqn)
1371	                        contributor['recent_commits'].append(current_commit['hash'][:7])
1372	                        
1373	                        # Track important module contributions
1374	                        module_score = module_scores.get(module_fqn, 0)
1375	                        if module_score > 0.01:
1376	                            contributor['important_module_commits'] += 1
1377	                        
1378	                        if focus_on_important_modules:
1379	                            contributor['impact_score'] += module_score * 100
1380	        
1381	        # Get line statistics for top contributors
1382	        active_contributors = {name: data for name, data in contributor_data.items() 
1383	                              if data['commits'] >= min_commits}
1384	        
1385	        for name, data in active_contributors.items():
1386	            # Get contributor's line changes
1387	            stat_cmd = [
1388	                "git", "-C", repo_path, "log",
1389	                f"--author={name}",
1390	                f"--since={since_date}",
1391	                "--pretty=tformat:",
1392	                "--numstat"
1393	            ]
1394	            
1395	            stat_result = subprocess.run(stat_cmd, capture_output=True, text=True)
1396	            if stat_result.returncode == 0:
1397	                for line in stat_result.stdout.split('\n'):
1398	                    if line.strip():
1399	                        parts = line.split('\t')
1400	                        if len(parts) >= 3 and parts[2].endswith('.py'):
1401	                            try:
1402	                                added = int(parts[0]) if parts[0] != '-' else 0
1403	                                removed = int(parts[1]) if parts[1] != '-' else 0
1404	                                data['lines_added'] += added
1405	                                data['lines_removed'] += removed
1406	                            except ValueError:
1407	                                pass
1408	        
1409	        # Calculate final impact scores
1410	        contributor_scores = []
1411	        for name, data in active_contributors.items():
1412	            if not focus_on_important_modules:
1413	                # Alternative scoring without module importance
1414	                data['impact_score'] = (
1415	                    data['commits'] * 10 +
1416	                    len(data['modules_touched']) * 5 +
1417	                    (data['lines_added'] + data['lines_removed']) * 0.01
1418	                )
1419	            
1420	            # Find expertise areas (most touched modules)
1421	            module_touches = defaultdict(int)
1422	            for module in data['modules_touched']:
1423	                module_touches[module] += 1
1424	            
1425	            expertise_areas = sorted(
1426	                [(m, c) for m, c in module_touches.items()],
1427	                key=lambda x: (x[1], module_scores.get(x[0], 0)),
1428	                reverse=True
1429	            )[:3]
1430	            
1431	            contributor_scores.append({
1432	                'name': name,
1433	                'impact_score': data['impact_score'],
1434	                'commits': data['commits'],
1435	                'modules_touched': len(data['modules_touched']),
1436	                'lines_changed': data['lines_added'] + data['lines_removed'],
1437	                'important_module_commits': data['important_module_commits'],
1438	                'expertise_areas': expertise_areas
1439	            })
1440	        
1441	        # Sort by impact
1442	        contributor_scores.sort(key=lambda x: x['impact_score'], reverse=True)
1443	        
1444	        # Format output
1445	        output_lines = ["=== Contributor Impact Analysis ===\n"]
1446	        output_lines.append(f"Repository: {repo_path}")
1447	        output_lines.append(f"Period: Last {days_back} days")
1448	        output_lines.append(f"Active contributors: {len(contributor_scores)}")
1449	        output_lines.append(f"Module importance weighting: {'Enabled' if focus_on_important_modules else 'Disabled'}\n")
1450	        
1451	        output_lines.append("Top Contributors by Impact:")
1452	        output_lines.append(f"{'Contributor'.ljust(25)} | {'Impact'.rjust(7)} | {'Commits'.rjust(7)} | {'Modules'.rjust(7)} | {'Lines ±'.rjust(8)} | {'Critical'.rjust(8)}")
1453	        output_lines.append("-" * 85)
1454	        
1455	        for contributor in contributor_scores[:15]:
1456	            output_lines.append(
1457	                f"{contributor['name'][:25].ljust(25)} | "
1458	                f"{contributor['impact_score']:7.1f} | "
1459	                f"{contributor['commits']:7d} | "
1460	                f"{contributor['modules_touched']:7d} | "
1461	                f"{contributor['lines_changed']:8d} | "
1462	                f"{contributor['important_module_commits']:8d}"
1463	            )
1464	        
1465	        # Add expertise breakdown
1466	        output_lines.append("\n=== Contributor Expertise Areas ===")
1467	        
1468	        for contributor in contributor_scores[:10]:
1469	            if contributor['expertise_areas']:
1470	                output_lines.append(f"\n{contributor['name']}:")
1471	                for module, touch_count in contributor['expertise_areas']:
1472	                    module_score = module_scores.get(module, 0)
1473	                    importance = "HIGH" if module_score > 0.01 else "normal"
1474	                    output_lines.append(f"  • {module} ({touch_count} commits, {importance} importance)")
1475	        
1476	        # Add insights
1477	        output_lines.append("\n=== Key Insights ===")
1478	        
1479	        # Find domain experts
1480	        critical_contributors = [c for c in contributor_scores 
1481	                               if c['important_module_commits'] > 10]
1482	        if critical_contributors:
1483	            output_lines.append("\n• Critical module experts:")
1484	            for contrib in critical_contributors[:3]:
1485	                output_lines.append(f"  - {contrib['name']}: {contrib['important_module_commits']} commits to critical modules")
1486	        
1487	        # Find broad contributors
1488	        broad_contributors = [c for c in contributor_scores 
1489	                            if c['modules_touched'] > 20]
1490	        if broad_contributors:
1491	            output_lines.append("\n• Broad impact contributors:")
1492	            for contrib in broad_contributors[:3]:
1493	                output_lines.append(f"  - {contrib['name']}: touched {contrib['modules_touched']} different modules")
1494	        
1495	        return '\n'.join(output_lines)
1496	        
1497	    except Exception as e:
1498	        return f"Error in contributor_impact_analysis: {str(e)}"
1499	
