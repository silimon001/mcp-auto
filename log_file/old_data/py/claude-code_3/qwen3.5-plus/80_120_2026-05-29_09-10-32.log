318	
319	def list_udf_tools(client: UnitycatalogFunctionClient) -> list[Tool]:
320	    """Retrieves a list of user-defined functions (UDFs) registered in Unity Catalog.
321	
322	    This function queries Unity Catalog for all available UDFs within the specified
323	    catalog and schema, then constructs a list of `Tool` objects representing these
324	    functions, excluding any predefined Unity Catalog AI tools.
325	
326	    Args:
327	        client (UnitycatalogFunctionClient): The Unity Catalog function client used
328	        to query the available functions.
329	
330	    Returns:
331	        list[Tool]: A list of `Tool` objects, each representing a UDF with its
332	        name, description, and input schema.
333	    """
334	    settings = Settings()
335	    return [
336	        Tool(
337	            name=func.name or "",
338	            description=func.comment or "",
339	            inputSchema=generate_function_input_params_schema(
340	                func
341	            ).pydantic_model.model_json_schema(),
342	        )
343	        for func in client.list_functions(
344	            catalog=settings.uc_catalog, schema=settings.uc_schema
345	        ).to_list()
346	        if func.name not in UNITY_CATALOG_AI_TOOLS
347	    ]
348	
