404	            build_template_id: Build template ID (for deploy templates)
405	            autorun: Enable autorun
406	            view_id: View ID
407	            task_params: App-specific task parameters. For Ansible templates:
408	                - allow_override_limit: Allow task-level --limit override
409	                - allow_override_inventory: Allow task-level inventory override
410	                - allow_override_tags: Allow task-level --tags override
411	                - allow_override_skip_tags: Allow task-level --skip-tags override
412	                - limit: Default limit (list of hosts/groups)
413	                - tags: Default tags (list)
414	                - skip_tags: Default skip tags (list)
415	
416	        Returns:
417	            Created template information
418	        """
