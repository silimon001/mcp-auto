301	@mcp.resource("netdisk://help")
302	def get_help() -> str:
303	    """提供网盘工具的帮助信息"""
304	    return """
305	    网盘MCP服务帮助:
306	    
307	    本服务提供以下工具:
308	    1. upload_file - 上传本地文件到网盘
309	       参数: local_file_path, [remote_path]
310	       如不指定remote_path，将默认上传到"/来自：mcp_server"目录下
311	       注意: access_token参数已被隐藏，将自动使用环境变量中的值
312	       
313	    使用示例:
314	    - 上传文件(指定路径): upload_file("/本地文件路径/文件名.ext", "/来自：mcp_server/文件名.ext")
315	    
316	    注意:
317	    - 大于4MB的文件会自动分片上传
318	    - 小于等于4MB的文件会直接上传
319	    - 上传失败时会自动重试
320	    """
321	
322	
323	if __name__ == "__main__":
324	    # 直接运行服务器
325	    mcp.run(transport="stdio")

