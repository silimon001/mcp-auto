206	                    job_id = job_info.get("job_id")
207	            except (json.JSONDecodeError, AttributeError):
208	                pass
209	        
210	        # Process table-to-table lineage
211	        if source_table == main_table_full_name and target_table and target_table != main_table_full_name:
212	            downstream_set.add(target_table)
213	        elif target_table == main_table_full_name and source_table and source_table != main_table_full_name:
214	            upstream_set.add(source_table)
215	        
216	        # Collect notebook-job pairs for batch processing
217	        if notebook_id and job_id:
218	            unique_job_ids.add(job_id)
219	            notebook_job_pairs.append({
220	                'notebook_id': notebook_id,
221	                'job_id': job_id,
222	                'source_table': source_table,
223	                'target_table': target_table
224	            })
225	    
226	    # Pre-load all job information in parallel (this is where the optimization happens)
227	    print(f"Pre-loading {len(unique_job_ids)} unique jobs...")
228	    batch_start = time.time()
229	    
230	    for job_id in unique_job_ids:
231	        _get_job_info_cached(job_id)  # This will cache the job info
232	    
233	    batch_time = time.time() - batch_start
234	    print(f"Job batch loading took {batch_time:.2f} seconds")
235	    
236	    # Now process all notebook-job pairs using cached data
237	    print(f"Processing {len(notebook_job_pairs)} notebook entries...")
238	    for pair in notebook_job_pairs:
239	        notebook_info = _resolve_notebook_info_optimized(pair['notebook_id'], pair['job_id'])
240	        formatted_info = _format_notebook_info_optimized(notebook_info)
241	        
242	        if pair['source_table'] == main_table_full_name:
243	            notebooks_reading_dict[pair['notebook_id']] = formatted_info
244	        elif pair['target_table'] == main_table_full_name:
245	            notebooks_writing_dict[pair['notebook_id']] = formatted_info
246	    
247	    processed_data["upstream_tables"] = sorted(list(upstream_set))
248	    processed_data["downstream_tables"] = sorted(list(downstream_set))
249	    processed_data["notebooks_reading"] = sorted(list(notebooks_reading_dict.values()))
250	    processed_data["notebooks_writing"] = sorted(list(notebooks_writing_dict.values()))
251	    
252	    total_time = time.time() - start_time
253	    print(f"Total lineage processing took {total_time:.2f} seconds")
254	    
255	    return processed_data
