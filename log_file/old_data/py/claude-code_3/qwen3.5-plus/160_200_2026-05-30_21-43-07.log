284	def _format_single_table_md(table_info: TableInfo, base_heading_level: int, display_columns: bool) -> List[str]:
285	    """
286	    Formats the details for a single TableInfo object into a list of Markdown strings.
287	    Uses a base_heading_level to control Markdown header depth for hierarchical display.
288	    """
289	    table_markdown_parts = []
290	    table_header_prefix = "#" * base_heading_level
291	    sub_header_prefix = "#" * (base_heading_level + 1)
292	
293	    table_markdown_parts.append(f"{table_header_prefix} Table: **{table_info.full_name}**")
294	
295	    if table_info.comment:
296	        table_markdown_parts.extend(["", f"**Description**: {table_info.comment}"])
297	    elif base_heading_level == 1:
298	        table_markdown_parts.extend(["", "**Description**: No description provided."])
299	    
300	    # Process and add partition columns
301	    partition_column_names: List[str] = []
302	    if table_info.columns:
303	        temp_partition_cols: List[tuple[str, int]] = []
304	        for col in table_info.columns:
305	            if col.partition_index is not None:
306	                temp_partition_cols.append((col.name, col.partition_index))
307	        if temp_partition_cols:
308	            temp_partition_cols.sort(key=lambda x: x[1])
309	            partition_column_names = [name for name, index in temp_partition_cols]
310	
311	    if partition_column_names:
312	        table_markdown_parts.extend(["", f"{sub_header_prefix} Partition Columns"])
313	        table_markdown_parts.extend([f"- `{col_name}`" for col_name in partition_column_names])
314	    elif base_heading_level == 1:
315	        table_markdown_parts.extend(["", f"{sub_header_prefix} Partition Columns", "- *This table is not partitioned or partition key information is unavailable.*"])
316	
317	    if display_columns:
318	        table_markdown_parts.extend(["", f"{sub_header_prefix} Table Columns"])
319	        if table_info.columns:
320	            table_markdown_parts.extend(_format_column_details_md(table_info.columns))
321	        else:
322	            table_markdown_parts.append("  - *No column information available.*")
323	            
324	    return table_markdown_parts
