188	def main():
189	    """Main entry point for the console script."""
190	    # Note: .env is already loaded during _client import
191	    # Note: version/auth mode are logged at module level
192	    # (works for both direct and uvicorn invocation)
193	
194	    host = os.getenv("SERVER_HOST", "127.0.0.1")
195	    port = int(os.getenv("SERVER_PORT", "8000"))
196	
197	    # Run with our app directly so custom routes (well-known endpoints) are served
198	    uvicorn.run(app, host=host, port=port, log_config=None)
