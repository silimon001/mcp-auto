636	        for time_data in response['ResultsByTime']:
637	            date = time_data['TimePeriod']['Start']
638	            
639	            output_buffer.append(f"\nDate: {date}")
640	            output_buffer.append("=" * 50)
641	            
642	            if 'Groups' in time_data and time_data['Groups']:
643	                # Create data structure for this date
644	                region_services = defaultdict(lambda: defaultdict(float))
645	                
