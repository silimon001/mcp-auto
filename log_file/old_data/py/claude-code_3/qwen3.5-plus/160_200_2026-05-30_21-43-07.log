310	def main():
311	    """Main entry point for the application."""
312	    # Phase 1: extract --config and --base first so they work the same before the subcommand
313	    # (avoids argparse consuming a path like /app/kb as the subcommand when invoked as
314	    # uvx knowledge-mcp --base /app/kb shell)
315	    pre_parser = argparse.ArgumentParser()
316	    pre_parser.add_argument("-c", "--config", type=str, default=None)
317	    pre_parser.add_argument("--base", "--kb-dir", dest="base", type=str, default=None)
318	    pre_args, unknown = pre_parser.parse_known_args()
319	
320	    # Normalize argv: optionals first, then subcommand and its args
321	    argv = [sys.argv[0]]
322	    if pre_args.config is not None:
323	        argv.extend(["--config", pre_args.config])
324	    if pre_args.base is not None:
325	        argv.extend(["--base", pre_args.base])
326	    argv.extend(unknown)
327	
328	    parser = argparse.ArgumentParser(description="Knowledge Base MCP Server and Management Shell")
329	    parser.add_argument(
330	        "-c", "--config",
331	        type=str,
332	        default=None,
333	        required=False,
334	        help="Path to the configuration file (config.yaml). If --base is also provided, --config takes precedence.",
335	    )
