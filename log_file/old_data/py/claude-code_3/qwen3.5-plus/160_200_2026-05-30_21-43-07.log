146	async def health_check(request):
147	    """Health check endpoint for container orchestration and monitoring.
148	
149	    In OAuth mode, also probes Doorkeeper's ``/oauth/introspect`` to surface
150	    upstream availability that was lost in the 503->401 collapse when
151	    FastMCP native auth replaced the bespoke middleware.
152	
153	    In legacy mode, probes ``GET /users/current.json`` to verify the configured
154	    API key (or username/password) is accepted by Redmine.
155	
156	    Returns HTTP 200 in both healthy and degraded states so container
157	    orchestrators continue treating the endpoint as a binary liveness
158	    probe; monitoring systems should inspect the JSON ``status`` field.
159	    """
160	    from starlette.responses import JSONResponse
161	
162	    # Lazy lookup so tests patching _cleanup._ensure_cleanup_started
163	    # observe the override.
164	    from . import _cleanup
165	
166	    # Initialize cleanup task on first health check (lazy initialization)
167	    await _cleanup._ensure_cleanup_started()
168	
169	    response: dict = {
170	        "status": "ok",
171	        "service": "redmine_mcp_tools",
172	        "auth_mode": REDMINE_AUTH_MODE,
173	    }
174	
175	    if REDMINE_AUTH_MODE == "oauth":
176	        probe_status, detail = await _probe_introspection()
177	        checks: dict = {"introspection": probe_status}
178	        if detail:
179	            checks["introspection_detail"] = detail
180	        response["checks"] = checks
181	        if probe_status != "ok":
182	            response["status"] = "degraded"
183	    else:
184	        probe_status, detail = await _probe_redmine_legacy()
185	        checks: dict = {"redmine": probe_status}
186	        if detail:
187	            checks["redmine_detail"] = detail
188	        response["checks"] = checks
189	        # "unconfigured" means the server hasn't been set up yet — not a
190	        # runtime failure, so don't degrade. Only degrade on "unreachable".
191	        if probe_status == "unreachable":
192	            response["status"] = "degraded"
193	
194	    return JSONResponse(response)
