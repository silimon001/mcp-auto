11	from mcp.server.fastmcp import FastMCP
12	
13	logger = logging.getLogger(__name__)
14	
15	
16	class RemarkableMCP(FastMCP):
17	    """Custom FastMCP server that handles VS Code's URI quirks.
18	
19	    VS Code:
20	    - Appends ?version=... to resource URIs for cache busting
21	    - May send URIs with spaces or URL-encoded (%20)
22	
23	    Pydantic's AnyUrl stores URIs with URL-encoded paths, so we need to
24	    normalize incoming URIs to match.
25	    """
26	
27	    async def read_resource(self, uri):
28	        """Read a resource, normalizing the URI for lookup.
29	
30	        Handles:
31	        - Query parameters: ?version=timestamp -> stripped
32	        - Spaces in path: encode to %20 to match stored URIs
33	        """
34	        uri_str = str(uri)
35	
36	        # Strip query parameters (e.g., ?version=1764625282944)
37	        if "?" in uri_str:
38	            uri_str = uri_str.split("?")[0]
39	            logger.debug("Stripped query params from resource URI")
40	
41	        # Normalize path encoding - Pydantic AnyUrl stores with %20 for spaces
42	        # VS Code may send either spaces or %20, so normalize to %20
43	        if ":///" in uri_str:
44	            scheme_end = uri_str.index(":///") + 4
45	            scheme = uri_str[:scheme_end]
46	            path = uri_str[scheme_end:]
47	
48	            # First decode any existing encoding, then re-encode consistently
49	            # This handles both "November 2025" and "November%202025" inputs
50	            decoded_path = unquote(path)
51	            # quote with safe='/' preserves path separators but encodes spaces
52	            encoded_path = quote(decoded_path, safe="/:")
53	            uri_str = scheme + encoded_path
54	            logger.debug(f"Normalized resource URI path: {path} -> {encoded_path}")
55	
56	        return await super().read_resource(uri_str)
57	
