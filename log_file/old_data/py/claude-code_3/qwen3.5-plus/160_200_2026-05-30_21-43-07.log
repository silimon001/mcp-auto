1	"""
2	Main CLI entry point for the Velociraptor MCP Server.
3	"""
4	
5	import argparse
6	import logging
7	import sys
8	
9	from dotenv import load_dotenv
10	
11	from .config import Config
12	from .server import create_server
13	
14	# Load environment variables
15	load_dotenv()
16	
17	logger = logging.getLogger(__name__)
18	
19	
20	def create_parser() -> argparse.ArgumentParser:
21	    """Create argument parser for CLI."""
22	    parser = argparse.ArgumentParser(
23	        description="Velociraptor MCP Server - Model Context Protocol server for Velociraptor DFIR platform",
24	    )
25	    parser.add_argument(
26	        "--host",
27	        default="127.0.0.1",
28	        help="Host to bind server to (default: 127.0.0.1)",
29	    )
30	    parser.add_argument(
31	        "--port",
32	        type=int,
33	        default=8000,
34	        help="Port to bind server to (default: 8000)",
35	    )
36	    parser.add_argument(
37	        "--log-level",
38	        choices=["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
39	        default="INFO",
40	        help="Logging level (default: INFO)",
41	    )
42	    parser.add_argument(
43	        "--api-config",
44	        help="Path to Velociraptor api.config.yaml file (overrides VELOCIRAPTOR_API_KEY env var)",
45	    )
46	    parser.add_argument(
47	        "--no-ssl-verify",
48	        action="store_true",
49	        help="Disable SSL certificate verification",
50	    )
51	    parser.add_argument("--version", action="version", version="%(prog)s 0.1.0")
52	
53	    return parser
54	
55	
56	def main() -> None:
57	    """Main entry point."""
58	    parser = create_parser()
59	    args = parser.parse_args()
60	
61	    # Create config from environment
62	    config = Config.from_env()
63	
64	    # Override with CLI arguments
65	    if args.api_config:
66	        config.velociraptor.api_key = args.api_config
67	    if args.no_ssl_verify:
68	        config.velociraptor.ssl_verify = False
69	
70	    config.server.host = args.host
71	    config.server.port = args.port
72	    config.server.log_level = args.log_level
73	
74	    try:
75	        # Validate configuration
76	        config.validate()
77	        config.setup_logging()
78	
79	        # Create and start server
80	        server = create_server(config)
81	        server.start()
82	
83	    except KeyboardInterrupt:
84	        logger.info("Server stopped by user")
85	        sys.exit(0)
86	    except Exception as e:
87	        logger.error("Failed to start server: %s", e)
88	        sys.exit(1)
89	
90	
91	if __name__ == "__main__":
92	    main()
