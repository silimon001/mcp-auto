326	def execute_databricks_sql(sql_query: str, wait_timeout: str = '50s') -> Dict[str, Any]:
327	    """
328	    Executes a SQL query on Databricks using the global SDK client and global SQL warehouse ID.
329	    """
330	    if not DATABRICKS_SQL_WAREHOUSE_ID:
331	        return {"status": "error", "error": "DATABRICKS_SQL_WAREHOUSE_ID is not set. Cannot execute SQL query."}
332	    
333	    try:
334	        print(f"Executing SQL on warehouse {DATABRICKS_SQL_WAREHOUSE_ID} (timeout: {wait_timeout}):\n{sql_query[:200]}..." + (" (truncated)" if len(sql_query) > 200 else ""))
335	        response: StatementResponse = sdk_client.statement_execution.execute_statement(
336	            statement=sql_query,
337	            warehouse_id=DATABRICKS_SQL_WAREHOUSE_ID, # Use global warehouse ID
338	            wait_timeout=wait_timeout
339	        )
340	
341	        if response.status and response.status.state == StatementState.SUCCEEDED:
342	            if response.result and response.result.data_array:
343	                column_names = [col.name for col in response.manifest.schema.columns] if response.manifest and response.manifest.schema and response.manifest.schema.columns else []
344	                results = [dict(zip(column_names, row)) for row in response.result.data_array]
345	                return {"status": "success", "row_count": len(results), "data": results}
346	            else:
347	                return {"status": "success", "row_count": 0, "data": [], "message": "Query succeeded but returned no data."}
348	        elif response.status:
349	            error_message = response.status.error.message if response.status.error else "No error details provided."
350	            return {"status": "failed", "error": f"Query execution failed with state: {response.status.state.value}", "details": error_message}
351	        else:
352	            return {"status": "failed", "error": "Query execution status unknown."}
353	    except Exception as e:
354	        return {"status": "error", "error": f"An error occurred during SQL execution: {str(e)}"}
355	
356	def get_uc_table_details(full_table_name: str, include_lineage: bool = False) -> str:
357	    """
358	    Fetches table metadata and optionally lineage, then formats it into a Markdown string.
