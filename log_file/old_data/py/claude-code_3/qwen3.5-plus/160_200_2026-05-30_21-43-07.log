156	def _cleanup_event_loop(loop):
157	    """Clean up an event loop and suppress warnings from background tasks."""
158	    if loop and not loop.is_closed():
159	        try:
160	            # Suppress warnings during cleanup
161	            with warnings.catch_warnings():
162	                warnings.simplefilter("ignore", RuntimeWarning)
163	                warnings.simplefilter("ignore", DeprecationWarning)
164	                
165	                # Get all pending tasks
166	                pending = asyncio.all_tasks(loop)
167	                logger.debug(f"Found {len(pending)} pending tasks to cleanup")
168	                
169	                # Cancel all pending tasks
170	                for task in pending:
171	                    if not task.done():
172	                        task.cancel()
173	                        logger.debug(f"Cancelled task: {task}")
174	                
175	                # Give tasks time to cancel gracefully
176	                if pending:
177	                    try:
178	                        # Wait for cancellation with a longer timeout for LightRAG tasks
179	                        loop.run_until_complete(
180	                            asyncio.wait_for(
181	                                asyncio.gather(*pending, return_exceptions=True),
182	                                timeout=2.0  # Increased timeout for LightRAG cleanup
183	                            )
184	                        )
185	                    except (asyncio.TimeoutError, asyncio.CancelledError, Exception) as e:
186	                        logger.debug(f"Task cleanup timeout or error (expected): {e}")
187	                        pass  # Expected for cancelled tasks
188	                
189	                # Shutdown async generators and executors
190	                try:
191	                    loop.run_until_complete(loop.shutdown_asyncgens())
192	                except Exception as e:
193	                    logger.debug(f"Error shutting down async generators: {e}")
194	                    pass
195	                    
196	                try:
197	                    loop.run_until_complete(loop.shutdown_default_executor())
198	                except Exception as e:
199	                    logger.debug(f"Error shutting down default executor: {e}")
200	                    pass
201	                
202	                # Close the loop
203	                loop.close()
204	                logger.debug("Event loop closed successfully")
205	                
206	        except Exception as e:
207	            logger.debug(f"Error during event loop cleanup: {e}")
208	            # Force close on any error
209	            try:
210	                if not loop.is_closed():
211	                    loop.close()
212	            except Exception:
213	                pass
214	    
215	    # Clear the event loop policy to prevent issues with background tasks
216	    try:
217	        asyncio.set_event_loop(None)
218	    except Exception:
219	        pass
220	    
221	    # Comprehensive stderr suppression for LightRAG background tasks
222	    import time
223	    import threading
224	    import sys
225	    import os as os_module
226	    
227	    # Additional global suppression of asyncio warnings
228	    warnings.filterwarnings('ignore', category=RuntimeWarning, module='asyncio')
229	    warnings.filterwarnings('ignore', message='.*Event loop is closed.*')
230	    warnings.filterwarnings('ignore', message='.*no running event loop.*')
231	    
232	    # OS-level stderr suppression for background tasks
233	    def comprehensive_suppression():
234	        # Save original stderr
235	        original_stderr = sys.stderr
236	        original_stderr_fd = os_module.dup(2)  # Duplicate stderr file descriptor
237	        
238	        try:
239	            # Redirect stderr to devnull at both Python and OS level
240	            devnull = open(os_module.devnull, 'w')
241	            sys.stderr = devnull
242	            os_module.dup2(devnull.fileno(), 2)  # Redirect OS-level stderr
243	            
244	            # Give background tasks time to finish
245	            time.sleep(0.8)  # Longer wait for complete cleanup
246	            
247	        finally:
248	            # Restore stderr
249	            try:
250	                os_module.dup2(original_stderr_fd, 2)  # Restore OS-level stderr
251	                sys.stderr = original_stderr
252	                os_module.close(original_stderr_fd)
253	                devnull.close()
254	            except Exception:
255	                pass  # Ignore restoration errors
256	    
257	    # Run comprehensive suppression in background thread
258	    suppression_thread = threading.Thread(target=comprehensive_suppression, daemon=True)
259	    suppression_thread.start()
260	    suppression_thread.join(timeout=1.5)  # Wait a bit longer
