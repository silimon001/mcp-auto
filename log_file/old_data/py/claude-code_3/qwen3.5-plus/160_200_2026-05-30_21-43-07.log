10	import base64
11	import json
12	import logging
13	import os
14	import time
15	import uuid
16	from datetime import datetime, timezone
17	from pathlib import Path
18	from typing import Optional
19	
20	import httpx
21	
22	from ._client import REDMINE_AUTH_MODE
23	from ._env import (
24	    get_health_introspection_ttl_seconds,
25	    get_introspection_credentials,
26	)
27	from .server import mcp
28	
29	logger = logging.getLogger("redmine_mcp_server")
30	
31	# Module-level probe cache: {"ts": <monotonic seconds>, "result": (status, detail)|None}
32	_probe_cache: dict = {"ts": 0.0, "result": None}
33	
34	
35	async def _probe_introspection_uncached() -> tuple[str, Optional[str]]:
36	    """POST a synthetic token to Doorkeeper's /oauth/introspect.
37	
38	    Returns ("ok", None) if reachable (200 response, any body).
39	    Returns ("unreachable", "<reason>") on transport failure or non-200.
40	
41	    A 200 with ``{"active": false}`` for the synthetic token IS healthy:
42	    it proves the endpoint is reachable and our client credentials work.
43	    """
44	    redmine_url = (os.environ.get("REDMINE_URL") or "").rstrip("/")
45	    if not redmine_url:
46	        return "unreachable", "REDMINE_URL not set"
47	    client_id, client_secret = get_introspection_credentials()
48	    if not (client_id and client_secret):
49	        return "unreachable", "introspection credentials not configured"
50	
51	    creds = base64.b64encode(f"{client_id}:{client_secret}".encode()).decode()
52	    headers = {
53	        "Authorization": f"Basic {creds}",
54	        "Content-Type": "application/x-www-form-urlencoded",
55	        "Accept": "application/json",
56	    }
57	    try:
58	        async with httpx.AsyncClient(timeout=5) as client:
59	            r = await client.post(
60	                f"{redmine_url}/oauth/introspect",
61	                headers=headers,
62	                data={"token": "health-probe-synthetic-token"},
63	            )
64	            if r.status_code == 200:
65	                return "ok", None
66	            logger.warning(
67	                "introspection_upstream_failure status_code=%s url=%s",
68	                r.status_code,
69	                f"{redmine_url}/oauth/introspect",
70	            )
71	            return "unreachable", f"HTTP {r.status_code}"
72	    except httpx.RequestError as e:
73	        logger.warning(
74	            "introspection_upstream_failure error=%s url=%s",
75	            type(e).__name__,
76	            f"{redmine_url}/oauth/introspect",
77	        )
78	        return "unreachable", type(e).__name__
79	
80	
81	async def _probe_introspection() -> tuple[str, Optional[str]]:
82	    """Cached wrapper around _probe_introspection_uncached."""
83	    ttl = get_health_introspection_ttl_seconds()
84	    now = time.monotonic()
85	    if _probe_cache["result"] is not None and (now - _probe_cache["ts"]) < ttl:
86	        return _probe_cache["result"]
87	    result = await _probe_introspection_uncached()
88	    _probe_cache["ts"] = now
89	    _probe_cache["result"] = result
90	    return result
