93	async def _probe_redmine_legacy() -> tuple[str, str | None]:
94	    """Check Redmine connectivity for legacy (API key / password) auth mode.
95	
96	    Calls ``GET /users/current.json`` using the configured credentials.
97	
98	    Returns:
99	        ``("ok", None)`` — credentials valid and Redmine reachable.
100	        ``("unconfigured", "<reason>")`` — URL or credentials not set;
101	            health status is NOT degraded (server hasn't been configured yet).
102	        ``("unreachable", "<reason>")`` — credentials present but Redmine
103	            rejected or could not be reached; health status IS degraded.
104	
105	    Not cached — auth failures should surface on every health poll.
106	    """
107	    from ._client import (
108	        REDMINE_API_KEY,
109	        REDMINE_PASSWORD,
110	        REDMINE_URL,
111	        REDMINE_USERNAME,
112	    )
113	
114	    if not REDMINE_URL:
115	        return "unconfigured", "REDMINE_URL not set"
116	    if not (REDMINE_API_KEY or (REDMINE_USERNAME and REDMINE_PASSWORD)):
117	        return "unconfigured", "no credentials configured"
118	
119	    # Use httpx directly against /users/current.json.
120	    # This endpoint works on Redmine 3.x and later (/my/account.json is
121	    # not reliably available on older instances).
122	    # redminelib's user.get('current') is NOT used here because it requires
123	    # admin rights on some Redmine setups.
124	    url = REDMINE_URL.rstrip("/") + "/users/current.json"
125	    try:
126	        if REDMINE_API_KEY:
127	            headers = {"X-Redmine-API-Key": REDMINE_API_KEY}
128	            auth = None
129	        else:
130	            headers = {}
131	            auth = (REDMINE_USERNAME, REDMINE_PASSWORD)
132	        async with httpx.AsyncClient(timeout=5) as client:
133	            r = await client.get(url, headers=headers, auth=auth)
134	        if r.status_code == 200:
135	            return "ok", None
136	        logger.warning(
137	            "legacy_redmine_probe_failure status_code=%s url=%s", r.status_code, url
138	        )
139	        return "unreachable", f"HTTP {r.status_code}"
140	    except httpx.RequestError as exc:
141	        reason = type(exc).__name__
142	        logger.warning("legacy_redmine_probe_failure error=%s url=%s", reason, url)
143	        return "unreachable", reason
