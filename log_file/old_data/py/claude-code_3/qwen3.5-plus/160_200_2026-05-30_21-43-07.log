62	class JuspayHeaderAuthMiddleware(BaseHTTPMiddleware):
63	    """
64	    Middleware to extract Juspay credentials from headers.
65	    Supports partial credentials - tools will fallback to environment variables for missing values.
66	    """
67	    
68	    async def dispatch(self, request: Request, call_next):
69	        api_key = request.headers.get("JUSPAY_API_KEY")
70	        merchant_id = request.headers.get("JUSPAY_MERCHANT_ID") 
71	        dashboard_token = request.headers.get("JUSPAY_WEB_LOGIN_TOKEN")
72	        
73	        juspay_credentials = {}
74	        if api_key:
75	            juspay_credentials["api_key"] = api_key
76	        if merchant_id:
77	            juspay_credentials["merchant_id"] = merchant_id
78	        if dashboard_token:
79	            juspay_credentials["dashboard_token"] = dashboard_token
80	            
81	        if juspay_credentials:
82	            credential_summary = ", ".join(juspay_credentials.keys())
83	            logger.debug(f"Setting partial Juspay credentials from headers: {credential_summary}")
84	        else:
85	            logger.debug("No Juspay credentials in headers, using environment variables")
86	        
87	        request.state.juspay_credentials = juspay_credentials
88	            
89	        response = await call_next(request)
90	        return response
