379	        if not DATABRICKS_SQL_WAREHOUSE_ID:
380	            markdown_parts.append("- *Lineage fetching skipped: `DATABRICKS_SQL_WAREHOUSE_ID` environment variable is not set.*")
381	        else:
382	            print(f"Fetching lineage for {full_table_name}...")
383	            lineage_info = _get_table_lineage(full_table_name)
384	            
385	            has_upstream = lineage_info and isinstance(lineage_info.get("upstream_tables"), list) and lineage_info["upstream_tables"]
386	            has_downstream = lineage_info and isinstance(lineage_info.get("downstream_tables"), list) and lineage_info["downstream_tables"]
387	            has_notebooks_reading = lineage_info and isinstance(lineage_info.get("notebooks_reading"), list) and lineage_info["notebooks_reading"]
388	            has_notebooks_writing = lineage_info and isinstance(lineage_info.get("notebooks_writing"), list) and lineage_info["notebooks_writing"]
389	
390	            if has_upstream:
391	                markdown_parts.extend(["", "### Upstream Tables (tables this table reads from):"])
392	                markdown_parts.extend([f"- `{table}`" for table in lineage_info["upstream_tables"]])
393	            
394	            if has_downstream:
395	                markdown_parts.extend(["", "### Downstream Tables (tables that read from this table):"])
396	                markdown_parts.extend([f"- `{table}`" for table in lineage_info["downstream_tables"]])
397	            
398	            if has_notebooks_reading:
399	                markdown_parts.extend(["", "### Notebooks Reading from this Table:"])
400	                for notebook in lineage_info["notebooks_reading"]:
401	                    markdown_parts.extend([f"- {notebook}", ""])
402	            
403	            if has_notebooks_writing:
404	                markdown_parts.extend(["", "### Notebooks Writing to this Table:"])
405	                for notebook in lineage_info["notebooks_writing"]:
406	                    markdown_parts.extend([f"- {notebook}", ""])
407	            
408	            if not any([has_upstream, has_downstream, has_notebooks_reading, has_notebooks_writing]):
409	                if lineage_info and lineage_info.get("status") == "error" and lineage_info.get("error"):
410	                     markdown_parts.extend(["", "*Note: Could not retrieve complete lineage information.*", f"> *Lineage fetch error: {lineage_info.get('error')}*"])
411	                elif lineage_info and lineage_info.get("status") != "success" and lineage_info.get("error"):
412	                    markdown_parts.extend(["", "*Note: Could not retrieve complete lineage information.*", f"> *Lineage fetch error: {lineage_info.get('error')}*"])
413	                else:
414	                    markdown_parts.append("- *No table, notebook, or job dependencies found or lineage fetch was not fully successful.*")
415	    else:
416	        markdown_parts.extend(["", "## Lineage Information", "- *Lineage fetching skipped as per request.*"])
417	
418	    return "\n".join(markdown_parts)
