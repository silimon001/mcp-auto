786	                    logger.error("Failed to get artifact details: %s", e)
787	                    return [{"type": "text", "text": f"Error getting artifact details: {str(e)}"}]
788	
789	    def _safe_truncate(self, text: str, max_length: int = 32000) -> str:
790	        """Truncate text to avoid overwhelming the client."""
791	        if len(text) <= max_length:
792	            return text
793	        return text[:max_length] + f"\n\n[... truncated {len(text) - max_length} characters ...]"
794	
795	    def _format_collection_results(self, args, artifacts_to_check, all_results, incomplete_sources):
796	        """Format collection results with support for partial results."""
797	        if not all_results:
798	            return [
799	                {
800	                    "type": "text",
801	                    "text": f"Flow {args.flow_id} completed but no results were found for artifact {args.artifact}",
802	                },
803	            ]
804	
805	        # Determine if we have partial results
806	        has_incomplete_sources = bool(incomplete_sources)
807	
808	        if len(artifacts_to_check) == 1:
809	            # Single artifact/source
810	            artifact_name = artifacts_to_check[0]
811	            results = all_results.get(artifact_name, [])
812	            response_text = json.dumps(results, indent=2)
813	
814	            status_msg = ""
815	            if has_incomplete_sources:
816	                status_msg = f"\n\n⚠️  WARNING: This collection timed out. Some sources may still be running: {', '.join(incomplete_sources)}"
817	
818	            return [
819	                {
820	                    "type": "text",
821	                    "text": f"Collection results for flow {args.flow_id} (artifact: {artifact_name}):\n{self._safe_truncate(response_text)}{status_msg}",
822	                },
823	            ]
824	        else:
825	            # Multiple sources - combine results
826	            completed_count = len(all_results)
827	            total_count = len(artifacts_to_check)
828	
829	            combined_response = {
830	                "flow_id": args.flow_id,
831	                "artifact": args.artifact,
832	                "sources": all_results,
833	                "total_records": sum(
834	                    len(results) if results else 0 for results in all_results.values()
835	                ),
836	                "completed_sources": completed_count,
837	                "total_sources": total_count,
838	            }
839	
840	            if has_incomplete_sources:
841	                combined_response["incomplete_sources"] = incomplete_sources
842	                combined_response["status"] = "partial_results"
843	            else:
844	                combined_response["status"] = "complete"
845	
846	            response_text = json.dumps(combined_response, indent=2)
847	
848	            status_msg = ""
849	            if has_incomplete_sources:
850	                status_msg = (
851	                    f"\n\n⚠️  WARNING: Partial results returned after timeout. "
852	                    f"Completed {completed_count}/{total_count} sources. "
853	                    f"Incomplete sources: {', '.join(incomplete_sources)}. "
854	                    f"You may want to check these sources later or increase retry settings."
855	                )
856	
857	            collection_type = (
858	                "with partial results" if has_incomplete_sources else "with multiple sources"
859	            )
860	            return [
861	                {
862	                    "type": "text",
863	                    "text": f"Collection results for flow {args.flow_id} (artifact: {args.artifact} {collection_type}):\n{self._safe_truncate(response_text)}{status_msg}",
864	                },
865	            ]
866	
867	    def _normalize_args(self, raw_args, model_class):
868	        """Normalize arguments to handle both direct and wrapped formats."""
869	        if isinstance(raw_args, dict):
870	            # If it has an 'args' key, use that
871	            if "args" in raw_args:
872	                return model_class(**raw_args["args"])
873	            # Otherwise, assume the dict itself contains the arguments
874	            else:
875	                return model_class(**raw_args)
876	        # If it's already a model instance, return as-is
877	        elif hasattr(raw_args, "__dict__"):
878	            return raw_args
879	        else:
880	            # Fallback to empty model
881	            return model_class()
882	
883	    def start(self, host: str = None, port: int = None) -> None:
884	        """Start the MCP server using stdio transport."""
885	        logger.info("Starting Velociraptor MCP Server (stdio transport)")
886	        logger.info("SSL Verify: %s", self.config.velociraptor.ssl_verify)
887	
888	        # stdio transport is required when the server is invoked via MCP command in .mcp.json
889	        self.app.run()
890	
891	    async def close(self) -> None:
892	        """Close the server and cleanup resources."""
893	        if self._client:
894	            await self._client.close()
