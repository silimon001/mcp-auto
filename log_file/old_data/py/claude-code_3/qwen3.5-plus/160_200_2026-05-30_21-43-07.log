83	data = [("John", 30), ("Alice", 25), ("Bob", 35)]
84	df = spark.createDataFrame(data, ["name", "age"])
85	
86	# Perform operations
87	result = df.show()
88	"""
89	            },
90	            {
91	                "name": "GroupBy and Aggregation",
92	                "code": """
93	# Group and aggregate with caching
94	summary = (
95	    df.groupBy("age")
96	    .agg(F.count("name").alias("count"))
97	    .cache()
98	    .show()
99	)
100	"""
101	            }
102	        ]
103	    }
104	
105	if __name__ == "__main__":
106	    mcp.run()
