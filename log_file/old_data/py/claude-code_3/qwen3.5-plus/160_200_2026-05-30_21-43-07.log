279	@app.list_tools()
280	async def list_my_tools() -> list[types.Tool]:
281	    return [
282	        types.Tool(
283	            name=tool["name"],
284	            description=tool["description"],
285	            inputSchema=tool["schema"],
286	        )
287	        for tool in AVAILABLE_TOOLS
288	    ]
289	
290	@app.call_tool()
291	async def handle_tool_calls(name: str, arguments: dict) -> list[types.TextContent]:
292	    logger.info(f"Calling tool: {name} with args: {arguments}")
293	    try:
294	        # Import here to avoid circular imports
295	        from juspay_mcp.api.utils import set_juspay_credentials
296	        
297	        tool_entry = next((t for t in AVAILABLE_TOOLS if t["name"] == name), None)
298	        if not tool_entry:
299	            raise ValueError(f"Unknown tool: {name}")
300	
301	        schema = tool_entry["schema"]
302	        required = schema.get("required", [])
303	        missing = [key for key in required if key not in arguments]
304	        if missing:
305	            raise ValueError(f"Missing required fields for {name}: {missing}")
306	
307	        handler = tool_entry["handler"]
308	        if not handler:
309	            raise ValueError(f"No handler defined for tool: {name}")
310	
311	        model_cls = tool_entry.get("model")
312	        if model_cls:
313	            try:
314	                payload = model_cls(**arguments)  
315	                payload_dict = payload.dict(exclude_none=True) 
316	            except Exception as e:
317	                raise ValueError(f"Validation error: {str(e)}")
318	        else:
319	            payload_dict = arguments 
320	        
321	        juspay_creds = get_juspay_request_credentials()
322	        if juspay_creds:
323	            logger.info("Using header credentials for Juspay API calls")
324	            set_juspay_credentials(juspay_creds)
325	        else:
326	            logger.info("No header credentials found, falling back to environment variables")
327	            set_juspay_credentials(None)
328	
329	        meta_info = arguments.pop("juspay_meta_info", None)
330	
331	        sig = inspect.signature(handler)
332	        param_count = len(sig.parameters)
333	
334	        if param_count == 0:
335	            response = await handler()
336	
337	        elif param_count == 1:
338	            if arguments or not meta_info:
339	                response = await handler(arguments)
340	            else:
341	                response = await handler(meta_info)
342	
343	        elif param_count == 2:
344	            response = await handler(arguments, meta_info)
345	
346	        else:
347	            raise ValueError(f"Unsupported number of parameters in tool handler: {param_count}")
348	        return [types.TextContent(type="text", text=json.dumps(response))]
349	
350	    except Exception as e:
351	        logger.error(f"Error executing tool {name}: {e}")
352	        return [types.TextContent(type="text", text=f"ERROR: Tool execution failed: {str(e)}")]
