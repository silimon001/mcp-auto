264	def _get_table_lineage(table_full_name: str) -> Dict[str, Any]:
265	    """
266	    Retrieves table lineage information for a given table using the global SDK client
267	    and global SQL warehouse ID. Now includes notebook and job information with enhanced details.
268	    """
269	    if not DATABRICKS_SQL_WAREHOUSE_ID: # Check before attempting query
270	        return {"status": "error", "error": "DATABRICKS_SQL_WAREHOUSE_ID is not set. Cannot fetch lineage."}
271	
272	    lineage_sql_query = f"""
273	    SELECT source_table_full_name, target_table_full_name, entity_type, entity_id, 
274	           entity_run_id, entity_metadata, created_by, event_time
275	    FROM system.access.table_lineage
276	    WHERE source_table_full_name = '{table_full_name}' OR target_table_full_name = '{table_full_name}'
277	    ORDER BY event_time DESC LIMIT 100;
278	    """
279	    print(f"Fetching and processing lineage for table: {table_full_name}")
280	    # execute_databricks_sql will now use the global warehouse_id
281	    raw_lineage_output = execute_databricks_sql(lineage_sql_query, wait_timeout='50s') 
282	    return _process_lineage_results(raw_lineage_output, table_full_name)
