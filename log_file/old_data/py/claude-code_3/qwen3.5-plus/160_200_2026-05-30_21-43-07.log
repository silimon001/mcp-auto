55	async def oauth_authorization_server(request: Request):
56	    """RFC 8414 — Authorization Server Metadata.
57	
58	    Redmine uses Doorkeeper but does not serve this discovery document itself.
59	    We serve it manually, pointing to Redmine's real Doorkeeper endpoints.
60	
61	    Env vars are read at request time (rather than module-import time) so
62	    that the handler responds to runtime configuration changes and is
63	    cleanly testable without module reloads.
64	    """
65	    redmine_url = (os.environ.get("REDMINE_URL", "") or "").rstrip("/")
66	    base_url = (
67	        os.environ.get("REDMINE_MCP_BASE_URL", "http://localhost:3040") or ""
68	    ).rstrip("/")
69	    return JSONResponse(
70	        {
71	            "issuer": base_url,
72	            "authorization_endpoint": f"{redmine_url}/oauth/authorize",
73	            "token_endpoint": f"{redmine_url}/oauth/token",
74	            "revocation_endpoint": f"{redmine_url}/oauth/revoke",
75	            "response_types_supported": ["code"],
76	            "grant_types_supported": [
77	                "authorization_code",
78	                "refresh_token",
79	            ],
80	            "code_challenge_methods_supported": ["S256"],
81	            "token_endpoint_auth_methods_supported": [
82	                "client_secret_post",
83	                "client_secret_basic",
84	            ],
85	            "scopes_supported": advertised_scopes(),
86	        }
87	    )
88	
89	
90	async def revoke_token(request: Request):
91	    """RFC 7009 — Revoke an OAuth2 access or refresh token.
92	
93	    Proxies token revocation to Redmine's Doorkeeper /oauth/revoke endpoint.
94	
95	    Accepts token via:
96	    - Authorization header: Bearer <token>
97	    - POST body: {"token": "<token>"} or form-encoded token=<token>
98	
99	    Returns:
100	        200 OK on success (per RFC 7009, even if token was already invalid)
101	        400 Bad Request if no token provided
102	        502 Bad Gateway if Redmine is unreachable
103	    """
104	    token = None
105	
106	    # Try Authorization header first
107	    auth_header = request.headers.get("Authorization", "")
108	    if auth_header.startswith("Bearer "):
109	        token = auth_header.removeprefix("Bearer ").strip()
110	
111	    # Fall back to request body
112	    if not token:
113	        content_type = request.headers.get("Content-Type", "")
114	        if "application/json" in content_type:
115	            try:
116	                body = await request.json()
117	                token = body.get("token")
118	            except Exception:
119	                pass
120	        else:
121	            # form-encoded
122	            try:
123	                form = await request.form()
124	                token = form.get("token")
125	            except Exception:
126	                pass
127	
128	    if not token:
129	        return JSONResponse(
130	            status_code=400,
131	            content={
132	                "error": "invalid_request",
133	                "error_description": "No token provided",
134	            },
135	        )
136	
137	    # Forward revocation to Redmine's Doorkeeper endpoint. Env vars are read
138	    # at request time so runtime overrides (and tests) are honoured.
139	    redmine_url = (os.environ.get("REDMINE_URL", "") or "").rstrip("/")
140	    async with httpx.AsyncClient() as client:
141	        try:
142	            response = await client.post(
143	                f"{redmine_url}/oauth/revoke",
144	                data={"token": token},
145	                timeout=10,
146	            )
147	        except httpx.RequestError as e:
148	            logger.error(f"Failed to reach Redmine for token revocation: {e}")
149	            return JSONResponse(
150	                status_code=502,
151	                content={"error": "upstream_unavailable"},
152	            )
153	
154	    # RFC 7009: return 200 regardless of whether token was valid
155	    # (to prevent token scanning attacks)
156	    if response.status_code in (200, 204):
157	        return JSONResponse(status_code=200, content={"success": True})
158	
159	    # If Redmine returns an error, log but still return success per RFC 7009
160	    logger.warning(
161	        f"Redmine revocation returned {response.status_code}: " f"{response.text}"
162	    )
163	    return JSONResponse(status_code=200, content={"success": True})
164	
