648	                    region, service = group['Keys']
649	                    cost = float(group['Metrics']['UnblendedCost']['Amount'])
650	                    currency = group['Metrics']['UnblendedCost']['Unit']
651	                    
652	                    region_services[region][service] = cost
653	                    all_data[date][region][service] = cost
654	                
655	                # Add the results for this date to the buffer
656	                for region in sorted(region_services.keys()):
657	                    output_buffer.append(f"\nRegion: {region}")
658	                    output_buffer.append("-" * 40)
659	                    
