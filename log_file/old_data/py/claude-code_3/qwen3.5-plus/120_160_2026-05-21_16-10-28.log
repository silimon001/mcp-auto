1	#!/usr/bin/env python
2	"""
3	Standalone entry script for openai-tool2mcp server.
4	
5	This script is designed to be used with `uv run` as recommended by the MCP documentation.
6	It provides a simple way to start the MCP server with OpenAI tools.
7	
8	Usage:
9	    uv run openai_tool2mcp/server_entry.py
10	"""
11	
12	import argparse
13	import os
14	
15	from dotenv import load_dotenv
16	
17	from openai_tool2mcp import MCPServer, OpenAIBuiltInTools, ServerConfig
18	from openai_tool2mcp.utils.logging import logger, setup_logging
19	
20	# Load environment variables from .env file if present
21	load_dotenv()
22	
23	
24	def main():
25	    """Start the MCP server for OpenAI tools."""
26	    parser = argparse.ArgumentParser(description="Start an MCP server for OpenAI tools")
27	
28	    parser.add_argument("--host", default="127.0.0.1", help="Host to listen on (for HTTP transport)")
29	    parser.add_argument("--port", type=int, default=8000, help="Port to listen on (for HTTP transport)")
30	    parser.add_argument("--api-key", help="OpenAI API key (defaults to OPENAI_API_KEY env var)")
31	    parser.add_argument(
32	        "--tools",
33	        nargs="+",
34	        choices=[t.value for t in OpenAIBuiltInTools],
35	        default=[t.value for t in OpenAIBuiltInTools],
36	        help="Enabled tools",
37	    )
38	    parser.add_argument("--timeout", type=int, default=30, help="Request timeout in seconds")
39	    parser.add_argument("--retries", type=int, default=3, help="Maximum number of retries")
40	    parser.add_argument(
41	        "--log-level", choices=["debug", "info", "warning", "error", "critical"], default="info", help="Logging level"
42	    )
43	    parser.add_argument(
44	        "--transport",
45	        choices=["stdio", "sse", "http"],
46	        default="stdio",
47	        help="Transport method (stdio, sse, or http). Use stdio for MCP compatibility.",
48	    )
49	
50	    # Parse arguments
51	    args = parser.parse_args()
52	
53	    # Set up logging
54	    setup_logging(args.log_level)
55	
56	    # Create server config
57	    config = ServerConfig(
58	        openai_api_key=args.api_key or os.environ.get("OPENAI_API_KEY"),
59	        tools=args.tools,
60	        request_timeout=args.timeout,
61	        max_retries=args.retries,
62	    )
63	
64	    # Create and start the server
65	    logger.info("Starting MCP server with OpenAI tools")
66	    logger.info(f"Transport: {args.transport}")
67	
68	    server = MCPServer(config)
69	    server.start(host=args.host, port=args.port, transport=args.transport)
70	
71	
72	if __name__ == "__main__":
73	    main()
74	

