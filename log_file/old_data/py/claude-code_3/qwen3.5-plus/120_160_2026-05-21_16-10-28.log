39	def _launch_schema_warmup_thread(services, tool_registry):
40	    def run_schema_warmup():
41	        try:
42	            schema_warmup = tool_registry.dispatch(services, GET_SCHEMA_CONTEXT_TOOL_NAME, {"force_refresh": True})
43	            if schema_warmup.get("status") == "success":
44	                services.logger.info("Schema context cache warmup succeeded.")
45	            else:
46	                services.logger.warning("Schema context cache warmup skipped: %s", schema_warmup.get("message"))
47	        except Exception as schema_warmup_error:
48	            services.logger.warning("Schema context cache warmup failed: %s", schema_warmup_error)
49	
50	    threading.Thread(target=run_schema_warmup, name="revitmcp-schema-warmup", daemon=True).start()
51	    services.logger.info("Schema context warmup launched in background thread.")
52	
53	
54	def create_application(
55	    startup_logger=None,
56	    launch_background_tasks: bool = True,
57	    detect_revit_on_startup: bool = True,
58	):
59	    startup_logger = startup_logger or create_startup_logger()
60	    startup_logger.info("--- RevitMCP External Server script starting (inside bootstrap) ---")
61	
62	    config = load_runtime_config()
63	    app = create_flask_app(config)
64	    mcp_server = FastMCP("RevitMCPServer")
65	    app.logger.info("FastMCP server instance created: %s", mcp_server.name)
66	
67	    services = create_services(config=config, startup_logger=startup_logger, app=app)
68	    tool_registry = build_tool_registry()
69	    services.tool_registry = tool_registry
70	    tool_names = [definition.name for definition in tool_registry.list_definitions()]
71	    server_dir = os.path.dirname(os.path.abspath(__file__))
72	    app.logger.info(
73	        "Tool registry loaded from %s with %s tools. get_revit_diagnostics=%s",
74	        server_dir,
75	        len(tool_names),
76	        "get_revit_diagnostics" in tool_names,
77	    )
78	
79	    if detect_revit_on_startup:
80	        services.revit_client.detect_port()
81	
82	    tool_registry.register_mcp_tools(mcp_server, services)
83	    app.logger.info("MCP tools defined and registered from central registry.")
84	
85	    register_routes(app, services, tool_registry)
86	
87	    if launch_background_tasks and config.warm_schema_on_startup:
88	        _launch_schema_warmup_thread(services, tool_registry)
89	    elif launch_background_tasks:
90	        app.logger.info("Schema context warmup disabled via REVITMCP_WARM_SCHEMA_ON_STARTUP.")
91	
92	    return app, mcp_server, services, tool_registry
93	
94	
95	def main(argv=None, startup_logger=None) -> int:
96	    argv = argv or []
97	    startup_logger = startup_logger or create_startup_logger()
98	
99	    runtime_surface = resolve_runtime_surface(argv, startup_logger)
100	    startup_logger.info("--- Runtime surface selected: %s ---", runtime_surface)
101	
102	    app, mcp_server, services, _tool_registry = create_application(
103	        startup_logger=startup_logger,
104	        launch_background_tasks=True,
105	        detect_revit_on_startup=True,
106	    )
107	
108	    try:
109	        if runtime_surface == "mcp":
110	            startup_logger.info("--- Starting FastMCP server over stdio transport ---")
111	            mcp_server.run(transport="stdio")
112	            startup_logger.info("FastMCP server exited normally.")
113	        else:
114	            startup_logger.info(
115	                "--- Starting Flask development server on host %s, port %s ---",
116	                services.config.host,
117	                services.config.port,
118	            )
119	            app.run(debug=services.config.debug_mode, port=services.config.port, host=services.config.host)
120	            startup_logger.info("Flask app.run() exited normally.")
121	        return 0
122	    except OSError as os_error:
123	        startup_logger.error("OS Error during server startup: %s", os_error, exc_info=True)
124	        raise
125	    except Exception as main_error:
126	        startup_logger.error("Unexpected error during server startup: %s", main_error, exc_info=True)
127	        raise
