13	@dataclass(frozen=True)
14	class ToolDefinition:
15	    name: str
16	    description: str
17	    json_schema: dict[str, Any]
18	    handler: Callable[..., dict]
19	
20	
21	def _annotation_from_schema(schema: dict) -> object:
22	    json_type = schema.get("type")
23	    if isinstance(json_type, list):
24	        non_null_types = [item for item in json_type if item != "null"]
25	        json_type = non_null_types[0] if non_null_types else None
26	
27	    if json_type == "string":
28	        return str
29	    if json_type == "integer":
30	        return int
31	    if json_type == "number":
32	        return float
33	    if json_type == "boolean":
34	        return bool
35	    if json_type == "array":
36	        item_annotation = _annotation_from_schema(schema.get("items", {}))
37	        try:
38	            return list[item_annotation]
39	        except Exception:
40	            return list
41	    if json_type == "object":
42	        return dict
43	    return object
44	
45	
46	class ToolRegistry:
47	    def __init__(self, definitions: list[ToolDefinition]):
48	        ordered = OrderedDict()
49	        for definition in definitions:
50	            if definition.name in ordered:
51	                raise ValueError("Duplicate tool name detected: {}".format(definition.name))
52	            ordered[definition.name] = definition
53	        self._definitions = ordered
54	
55	    def list_definitions(self) -> list[ToolDefinition]:
56	        return list(self._definitions.values())
57	
58	    def get(self, tool_name: str) -> ToolDefinition | None:
59	        return self._definitions.get(tool_name)
60	
61	    def dispatch(self, services, tool_name: str, function_args: dict | None = None) -> dict:
62	        normalized_args = function_args or {}
63	        definition = self.get(tool_name)
64	        if not definition:
65	            services.logger.warning("Unknown tool '%s' requested by LLM.", tool_name)
66	            return {"status": "error", "message": "Unknown tool '{}' requested by LLM.".format(tool_name)}
67	
68	        try:
69	            return definition.handler(services, **normalized_args)
70	        except TypeError as exc:
71	            services.logger.error("Invalid arguments for tool '%s': %s", tool_name, exc, exc_info=True)
72	            return {"status": "error", "message": "Invalid arguments for tool '{}': {}".format(tool_name, exc)}
73	        except Exception as exc:
74	            services.logger.error("Exception while executing tool '%s': %s", tool_name, exc, exc_info=True)
75	            return {"status": "error", "message": "Exception while executing tool '{}': {}".format(tool_name, exc)}
76	
77	    def register_mcp_tools(self, mcp_server, services) -> None:
78	        for definition in self.list_definitions():
79	            mcp_server.add_tool(
80	                self._build_mcp_callable(definition, services),
81	                name=definition.name,
82	                description=definition.description,
83	            )
84	
85	    def to_openai_tools(self) -> list[dict]:
86	        return [
87	            {
88	                "type": "function",
89	                "function": {
90	                    "name": definition.name,
91	                    "description": definition.description,
92	                    "parameters": definition.json_schema,
93	                },
94	            }
95	            for definition in self.list_definitions()
96	        ]
97	
98	    def to_anthropic_tools(self) -> list[dict]:
99	        return [
100	            {
101	                "name": definition.name,
102	                "description": definition.description,
103	                "input_schema": definition.json_schema,
104	            }
105	            for definition in self.list_definitions()
106	        ]
107	
108	    def to_google_tools(self) -> list[google_types.Tool]:
109	        function_declarations = [
110	            google_types.FunctionDeclaration(
111	                name=definition.name,
112	                description=definition.description,
113	                parameters=definition.json_schema,
114	            )
115	            for definition in self.list_definitions()
116	        ]
117	        return [google_types.Tool(function_declarations=function_declarations)]
118	
119	    @staticmethod
120	    def _build_mcp_callable(definition: ToolDefinition, services):
121	        properties = definition.json_schema.get("properties", {}) or {}
122	        required = set(definition.json_schema.get("required", []) or [])
123	
124	        def wrapper(**kwargs):
125	            result = definition.handler(services, **kwargs)
126	            artifact = load_image_artifact(result, logger=services.logger)
127	            if artifact:
128	                return mcp_types.CallToolResult(
129	                    content=[
130	                        mcp_types.TextContent(type="text", text=json.dumps(result)),
131	                        mcp_types.ImageContent(
132	                            type="image",
133	                            data=artifact["base64_data"],
134	                            mimeType=artifact["mime_type"],
135	                        ),
136	                    ],
137	                    structuredContent=result,
138	                    isError=False,
139	                )
140	            return result
141	
142	        wrapper.__name__ = definition.name
143	        wrapper.__doc__ = definition.description
144	
145	        parameters = []
146	        annotations = {"return": dict}
147	        for property_name, property_schema in properties.items():
148	            annotation = _annotation_from_schema(property_schema)
149	            annotations[property_name] = annotation
150	            default = inspect.Parameter.empty if property_name in required else None
151	            parameters.append(
152	                inspect.Parameter(
153	                    property_name,
154	                    inspect.Parameter.KEYWORD_ONLY,
155	                    default=default,
156	                    annotation=annotation,
157	                )
158	            )
159	
160	        wrapper.__annotations__ = annotations
161	        wrapper.__signature__ = inspect.Signature(parameters, return_annotation=dict)
162	        return wrapper
163	
164	
165	def build_tool_registry() -> ToolRegistry:
166	    from .context_tools import build_context_tools
167	    from .element_tools import build_element_tools
168	    from .element_operation_tools import build_element_operation_tools
169	    from .memory_tools import build_memory_tools
170	    from .model_tools import build_model_tools
171	    from .view_tools import build_view_tools
172	    from .planning_tools import build_planning_tools
173	    from .schedule_tools import build_schedule_tools
174	
175	    definitions = []
176	    definitions.extend(build_context_tools())
177	    definitions.extend(build_memory_tools())
178	    definitions.extend(build_model_tools())
179	    definitions.extend(build_view_tools())
180	    definitions.extend(build_schedule_tools())
181	    definitions.extend(build_element_tools())
182	    definitions.extend(build_element_operation_tools())
183	    definitions.extend(build_planning_tools())
184	    return ToolRegistry(definitions)
