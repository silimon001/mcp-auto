225	@mcp.tool()
226	def translate_specific_slides(
227	    input_file: str,
228	    slide_numbers: str,
229	    target_language: str = Config.DEFAULT_TARGET_LANGUAGE,
230	    output_file: Optional[str] = None,
231	    model_id: str = Config.DEFAULT_MODEL_ID,
232	    enable_polishing: bool = True,
233	    glossary_file: Optional[str] = None,
234	    cache_backend: str = "sqlite",
235	    dry_run: bool = False,
236	    translate_charts: bool = True,
237	    source_language: Optional[str] = None,
238	    auto_detect_source: bool = True,
239	) -> str:
240	    """
241	    Translate specific slides in a PowerPoint presentation.
242	    
243	    Args:
244	        input_file: Path to the input PowerPoint file (.pptx)
245	        slide_numbers: Comma-separated slide numbers to translate (e.g., "1,3,5" or "2-4,7")
246	        target_language: Target language code (e.g., 'ko', 'ja', 'es', 'fr', 'de')
247	        output_file: Path to save the translated file (optional, auto-generated if not provided)
248	        model_id: AWS Bedrock model ID to use for translation
249	        enable_polishing: Enable natural language polishing for more fluent translation
250	    
251	    Returns:
252	        Success message with translation details
253	    """
254	    try:
255	        # Validate input file using helper function
256	        input_path, error_msg = validate_input_path(input_file)
257	        if error_msg:
258	            return error_msg
259	        
260	        # Validate target language
261	        if target_language not in Config.LANGUAGE_MAP:
262	            available_langs = ', '.join(Config.LANGUAGE_MAP.keys())
263	            return f"❌ Error: Unsupported language '{target_language}'. Available: {available_langs}"
264	        
265	        # Parse slide numbers
266	        try:
267	            slide_list = []
268	            for part in slide_numbers.split(','):
269	                part = part.strip()
270	                if '-' in part:
271	                    start, end = map(int, part.split('-'))
272	                    slide_list.extend(range(start, end + 1))
273	                else:
274	                    slide_list.append(int(part))
275	        except ValueError:
276	            return f"❌ Error: Invalid slide numbers format. Use comma-separated numbers or ranges (e.g., '1,3,5' or '2-4,7')"
277	
278	        glossary = _resolve_glossary_for_mcp(glossary_file, target_language)
279	
280	        if dry_run:
281	            translator = PowerPointTranslator(model_id, enable_polishing,
282	                                              glossary=glossary, translate_charts=translate_charts,
283	                                              source_language=source_language,
284	                                              auto_detect_source=auto_detect_source)
285	            return _dry_run_report(translator, input_path, target_language, model_id,
286	                                   slide_numbers=slide_list,
287	                                   detect_source=auto_detect_source)
288	
289	        # Generate output filename if not provided
290	        if not output_file:
291	            sorted_slides = sorted(set(slide_list))
292	            if len(sorted_slides) > 1 and sorted_slides[-1] - sorted_slides[0] == len(sorted_slides) - 1:
293	                slides_suffix = f"_slides_range_{sorted_slides[0]}_{sorted_slides[-1]}"
294	            else:
295	                slides_suffix = f"_slides_{'_'.join(map(str, sorted_slides))}"
296	            output_file = str(input_path.parent / f"{input_path.stem}_translated_{target_language}{slides_suffix}{input_path.suffix}")
297	
298	        logger.info(f"Starting specific slides translation: {input_path} -> {target_language}")
299	        with build_cache(cache_backend) as cache:
300	            translator = PowerPointTranslator(model_id, enable_polishing,
301	                                              cache=cache, glossary=glossary,
302	                                              translate_charts=translate_charts,
303	                                              source_language=source_language,
304	                                              auto_detect_source=auto_detect_source)
305	            result = translator.translate_specific_slides(str(input_path), output_file, target_language, slide_list)
306	        
307	        # Check for errors
308	        if result.errors:
309	            return f"❌ Translation failed: {'; '.join(result.errors)}"
310	        
311	        # Apply post-processing if enabled
312	        config = Config()
313	        post_processing_applied = False
314	        if config.get_bool('ENABLE_TEXT_AUTOFIT', True):
315	            try:
316	                verbose = config.get_bool('DEBUG', False)
317	                post_processor = PowerPointPostProcessor(config, verbose=verbose)
318	                # Overwrite the original output file instead of creating a new one
319	                final_output = post_processor.process_presentation(output_file, output_file)
320	                post_processing_applied = True
321	                logger.info("Post-processing applied: Text auto-fitting enabled")
322	            except Exception as e:
323	                logger.warning(f"Post-processing failed: {e}")
324	        
325	        # Format success message
326	        lang_name = Config.LANGUAGE_MAP.get(target_language, target_language)
327	        translation_mode = "Natural/Polished" if enable_polishing else "Literal"
328	        post_processing_status = "✅ Applied" if post_processing_applied else "⚠️ Skipped"
329	        
330	        return f"""✅ Specific slides translation completed successfully!
331	
332	📁 Input file: {input_path}
333	📁 Output file: {output_file}
334	📄 Translated slides: {sorted(set(slide_list))}
335	🌐 Target language: {target_language} ({lang_name})
336	🎨 Translation mode: {translation_mode}
337	🤖 Model: {model_id}
338	📝 Translated texts: {result.translated_count}
339	📋 Translated notes: {result.translated_notes_count}
340	📊 Total shapes processed: {result.total_shapes}
341	🔧 Post-processing: {post_processing_status}
342	
343	💡 Translation features used:
344	• Intelligent batch processing for efficiency
345	• Context-aware translation for coherence
346	• Unified text frame processing
347	• Formatting preservation
348	• {'Natural language polishing for fluent output' if enable_polishing else 'Literal translation for accuracy'}"""
349	        
350	    except Exception as e:
351	        logger.error(f"Specific slides translation failed: {str(e)}")
352	        return f"❌ Translation failed: {str(e)}"
353	
354	@mcp.tool()
355	def get_slide_info(input_file: str) -> str:
356	    """
357	    Get information about slides in a PowerPoint presentation.
358	    
359	    Args:
360	        input_file: Path to the PowerPoint file (.pptx)
361	    
362	    Returns:
363	        Information about the presentation including slide count and preview of each slide
364	    """
365	    try:
366	        # Validate input file using helper function
367	        input_path, error_msg = validate_input_path(input_file)
368	        if error_msg:
369	            return error_msg
370	        
371	        # Create translator to access slide info methods
372	        translator = PowerPointTranslator()
373	        slide_count = translator.get_slide_count(str(input_path))
374	        
375	        info_text = f"""📊 PowerPoint Presentation Information
376	
377	📁 File: {input_path}
378	📄 Total slides: {slide_count}
379	
380	📋 Slide previews:
381	"""
382	        
383	        # Get preview for each slide (limit to first 10 slides for readability)
384	        max_preview_slides = min(slide_count, 10)
385	        for i in range(1, max_preview_slides + 1):
386	            try:
387	                preview = translator.get_slide_preview(str(input_path), i, max_chars=150)
388	                info_text += f"\n🔸 Slide {i}: {preview}"
389	            except Exception as e:
390	                info_text += f"\n🔸 Slide {i}: [Error getting preview: {str(e)}]"
391	        
392	        if slide_count > 10:
393	            info_text += f"\n\n... and {slide_count - 10} more slides"
394	        
395	        info_text += f"""
396	
397	💡 Usage examples:
398	• Translate all slides: translate_powerpoint("{input_file}")
399	• Translate specific slides: translate_specific_slides("{input_file}", "1,3,5")
400	• Translate slide range: translate_specific_slides("{input_file}", "2-4")"""
401	        
402	        return info_text
403	        
404	    except Exception as e:
405	        logger.error(f"Failed to get slide info: {str(e)}")
406	        return f"❌ Failed to get slide info: {str(e)}"
