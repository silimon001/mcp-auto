532	        db_config = db_context.db_configs[db_id]
533	        
534	        # Get column names and types
535	        columns = db_config.query_runner.get_table_columns(table_name)
536	        types = db_config.query_runner.get_table_types(table_name)
537	        
538	        # Build description
539	        description = f"Table: {table_name} in Database: {db_config.description} (ID: {db_id})\n\n"
540	        description += "Columns:\n"
541	        
542	        for column in columns:
543	            column_type = types.get(column, "unknown")
544	            description += f"- {column} ({column_type})\n"
545	        
546	        return description
547	    except Exception as e:
548	        return f"Error describing table {table_name}: {str(e)}"
549	
550	@mcp.tool()
551	def get_table_sample(ctx: Context, table_name: str, db_id: str, limit: int = 10) -> str:
552	    """Get a sample of data from a table"""
553	    try:
554	        db_context: DbContext = ctx.request_context.lifespan_context
555	        
556	        if db_id not in db_context.db_configs:
557	            return f"Error: Invalid database ID {db_id}"
558	        
559	        db_config = db_context.db_configs[db_id]
560	        query_runner = db_config.query_runner
561	        
562	        # Construct a safe query to sample data
563	        query = f"SELECT * FROM {table_name} LIMIT {min(limit, 100)}"
564	        result = query_runner.run_query(query)
565	        
566	        # Extract column info
567	        columns = result.get('columns', [])
568	        column_names = []
569	        for col in columns:
570	            if isinstance(col, dict):
571	                column_names.append(col.get('friendly_name', col.get('name', '')))
572	            else:
573	                column_names.append(col)
574	        
575	        # Format as markdown table
576	        header = " | ".join(column_names)
577	        separator = " | ".join(["---"] * len(column_names))
578	        
579	        # Extract row data
580	        rows = result.get('rows', [])
581	        
582	        table_rows = []
583	        for row in rows:
584	            if isinstance(row, dict):
585	                # Handle dict rows
586	                row_values = [str(row.get(col, '')) for col in column_names]
587	            else:
588	                # Handle list rows
589	                row_values = [str(cell) for cell in row]
590	            table_rows.append(" | ".join(row_values))
591	        
592	        sample_data = f"Sample data from table '{table_name}' in Database: {db_config.description} (ID: {db_id})\n\n"
593	        sample_data += f"{header}\n{separator}\n" + "\n".join(table_rows)
594	        
595	        if not rows:
596	            sample_data += "\n\nNo data found in table."
597	        
598	        return sample_data
599	    except Exception as e:
600	        return f"Error getting sample data from table {table_name}: {str(e)}"
601	
602	@mcp.tool()
603	def find_table(table_name: str, ctx: Context) -> str:
604	    """Find which database contains a specific table"""
605	    db_context: DbContext = ctx.request_context.lifespan_context
606	    found_in = []
607	    
608	    for db_id, db_config in db_context.db_configs.items():
609	        if not db_config.schema:
610	            continue
611	        
612	        for table in db_config.schema:
613	            if table.get("name") == table_name:
614	                found_in.append({
615	                    "db_id": db_id,
616	                    "db_name": db_config.description,
617	                    "db_type": db_config.db_type
618	                })
619	                break
620	    
621	    if not found_in:
622	        return f"Table '{table_name}' was not found in any database schema."
623	    
624	    result = f"Table '{table_name}' was found in the following databases:\n"
625	    for db in found_in:
626	        result += f"- Database ID: {db['db_id']} - {db['db_name']} (Type: {db['db_type']})\n"
627	    
628	    return result
629	
630	# Define prompts
631	@mcp.prompt()
632	def sql_query() -> str:
