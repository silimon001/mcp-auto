322	def get_database_schema_summary(db_config: DbConfig) -> str:
323	    """Create a summary of the database schema for display"""
324	    if db_config.schema is None:
325	        return "Schema information not available"
326	    
327	    tables = db_config.schema
328	    if not tables:
329	        return "No tables found in schema"
330	    
331	    table_summaries = []
332	    for table in tables[:10]:  # Limit to first 10 tables
333	        table_name = table.get("name", "")
334	        if not table_name:
335	            continue
336	        
337	        columns = table.get("columns", [])
338	        column_names = [col.get("name", "") for col in columns[:5]]  # Limit to first 5 columns
339	        column_str = ", ".join(column_names)
340	        if len(columns) > 5:
341	            column_str += ", ..."
342	        
343	        table_summaries.append(f"- {table_name} ({column_str})")
344	    
345	    if len(tables) > 10:
346	        table_summaries.append(f"... and {len(tables) - 10} more tables")
347	    
348	    return "\n".join(table_summaries) if table_summaries else "No tables found in schema"
349	
