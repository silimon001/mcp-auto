1	import argparse
2	import os
3	import sys
4	
5	from .server import MCPServer
6	from .tools import OpenAIBuiltInTools
7	from .utils.config import ServerConfig
8	from .utils.logging import setup_logging
9	
10	
11	def main():
12	    """Main function for CLI"""
13	    parser = argparse.ArgumentParser(description="Start an MCP server for OpenAI tools")
14	
15	    # Command subparsers
16	    subparsers = parser.add_subparsers(dest="command", help="Command to run")
17	
18	    # Start command
19	    start_parser = subparsers.add_parser("start", help="Start the MCP server")
20	    start_parser.add_argument("--host", default="127.0.0.1", help="Host to listen on (for HTTP transport)")
21	    start_parser.add_argument("--port", type=int, default=8000, help="Port to listen on (for HTTP transport)")
22	    start_parser.add_argument("--api-key", help="OpenAI API key (defaults to OPENAI_API_KEY env var)")
23	    start_parser.add_argument(
24	        "--tools",
25	        nargs="+",
26	        choices=[t.value for t in OpenAIBuiltInTools],
27	        default=[t.value for t in OpenAIBuiltInTools],
28	        help="Enabled tools",
29	    )
30	    start_parser.add_argument("--timeout", type=int, default=30, help="Request timeout in seconds")
31	    start_parser.add_argument("--retries", type=int, default=3, help="Maximum number of retries")
32	    start_parser.add_argument(
33	        "--log-level", choices=["debug", "info", "warning", "error", "critical"], default="info", help="Logging level"
34	    )
35	    start_parser.add_argument(
36	        "--transport",
37	        choices=["stdio", "sse", "http"],
38	        default="http",
39	        help="Transport method (stdio, sse, or http). Use stdio for MCP compatibility.",
40	    )
41	
42	    # List command
43	    subparsers.add_parser("list", help="List available tools")
44	
45	    # Parse arguments
46	    args = parser.parse_args()
47	
48	    # Set up logging
49	    setup_logging(args.log_level if hasattr(args, "log_level") else "info")
50	
51	    # Handle commands
52	    if args.command == "start":
53	        # Create server config
54	        config = ServerConfig(
55	            openai_api_key=args.api_key or os.environ.get("OPENAI_API_KEY"),
56	            tools=args.tools,
57	            request_timeout=args.timeout,
58	            max_retries=args.retries,
59	        )
60	
61	        # Start server
62	        server = MCPServer(config)
63	        server.start(host=args.host, port=args.port, transport=args.transport)
64	    elif args.command == "list":
65	        # List available tools
66	        print("Available tools:")
67	        for tool in OpenAIBuiltInTools:
68	            print(f"  - {tool.value}: {tool.name.replace('_', ' ').title()}")
69	    else:
70	        # No command specified
