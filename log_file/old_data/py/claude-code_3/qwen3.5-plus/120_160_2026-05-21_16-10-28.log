177	# Define database context that will be available to all handlers
178	@dataclass
179	class DbContext:
180	    db_configs: Dict[str, DbConfig]
181	    last_query: Optional[str] = None
182	    last_result: Optional[Dict[str, Any]] = None
183	    query_history: List[str] = None
184	    
185	    def __post_init__(self):
186	        if self.query_history is None:
187	            self.query_history = []
188	    
189	    def get_default_query_runner(self) -> QueryRunner:
190	        """Gets the default query runner (first one if multiple exist)"""
191	        if not self.db_configs:
192	            raise ValueError("No database connections available")
193	        # Get the first database in the dictionary
194	        first_db_id = next(iter(self.db_configs))
195	        return self.db_configs[first_db_id].query_runner
196	
197	# Server lifespan manager
198	@asynccontextmanager
199	async def db_lifespan(server: FastMCP) -> AsyncIterator[DbContext]:
200	    """Initialize database connections on startup and provide context to handlers"""
201	    
202	    # Initialize context
203	    db_context = DbContext(
204	        db_configs=config_map,
205	    )
206	    
207	    try:
208	        # Test connection on startup for all databases
209	        for db_config in db_context.db_configs.values():
210	            try:
211	                db_config.query_runner.test_connection()
212	                print(f"Successfully connected to {db_config.description}")
213	            except Exception as e:
214	                print(f"Warning: Connection test failed for {db_config.description}: {str(e)}")
215	        
216	        yield db_context
217	    finally:
218	        # Cleanup could happen here if needed
219	        pass
220	
221	# Pass lifespan to server
222	mcp = FastMCP("Legion Multi-Database Access", lifespan=db_lifespan)
