24	    from db import DatabaseManager, get_db_manager
25	    from nl_to_sql import NLToSQLConverter
26	
27	# Configure logging
28	logging.basicConfig(level=logging.INFO)
29	logger = logging.getLogger(__name__)
30	
31	# Pydantic models for request/response
32	class QueryRequest(BaseModel):
33	    nl_query: str
34	    limit: Optional[int] = 50
35	
36	class QueryResponse(BaseModel):
37	    sql_query: str
38	    results: List[Dict[str, Any]]
39	    row_count: int
40	
41	class TableInfo(BaseModel):
42	    table_name: str
43	    column_count: int
44	
45	class ColumnInfo(BaseModel):
46	    column_name: str
47	    data_type: str
48	    is_nullable: bool
49	
50	class TableSchema(BaseModel):
51	    table_name: str
52	    columns: List[ColumnInfo]
53	
54	# Global variables
55	nl_converter: Optional[NLToSQLConverter] = None
56	
57	@asynccontextmanager
58	async def lifespan(app: FastAPI):
59	    """Application lifespan manager"""
60	    global nl_converter
61	    
62	    # Startup
63	    logger.info("Starting MCP Database Server...")
64	    try:
65	        nl_converter = NLToSQLConverter()
66	        logger.info("NL to SQL converter initialized")
67	    except Exception as e:
68	        logger.error(f"Failed to initialize NL converter: {e}")
69	        nl_converter = None
70	    
71	    yield
72	    
73	    # Shutdown
74	    logger.info("Shutting down MCP Database Server...")
75	
76	# Create FastAPI app
77	app = FastAPI(
78	    title="MCP Database Server",
79	    description="An MCP server exposing relational databases (Postgres/MySQL) to AI agents. Supports NL→SQL.",
80	    version="1.0.0",
81	    lifespan=lifespan
82	)
83	
84	# Add CORS middleware
85	app.add_middleware(
86	    CORSMiddleware,
87	    allow_origins=["*"],
88	    allow_credentials=True,
89	    allow_methods=["*"],
90	    allow_headers=["*"],
91	)
92	
93	@app.get("/health")
94	async def health_check():
95	    """Health check endpoint"""
96	    return {
97	        "status": "healthy",
98	        "service": "mcp-db-server",
99	        "version": "1.1.0",
100	        "database_connected": True  # Will be updated with actual DB check
101	    }
102	
103	@app.get("/mcp/list_tables", response_model=List[TableInfo])
104	async def list_tables(db_manager: DatabaseManager = Depends(get_db_manager)):
105	    """List all available tables in the database"""
106	    try:
107	        tables = await db_manager.list_tables()
108	        return [
109	            TableInfo(
110	                table_name=table["table_name"],
111	                column_count=table["column_count"]
112	            )
113	            for table in tables
114	        ]
115	    except Exception as e:
116	        logger.error(f"Error listing tables: {e}")
117	        raise HTTPException(status_code=500, detail=f"Failed to list tables: {str(e)}")
118	
119	@app.get("/mcp/describe/{table_name}", response_model=TableSchema)
120	async def describe_table(table_name: str, db_manager: DatabaseManager = Depends(get_db_manager)):
121	    """Get schema information for a specific table"""
122	    try:
123	        schema = await db_manager.describe_table(table_name)
124	        return TableSchema(
125	            table_name=table_name,
126	            columns=[
127	                ColumnInfo(
128	                    column_name=col["column_name"],
129	                    data_type=col["data_type"],
130	                    is_nullable=col["is_nullable"]
131	                )
132	                for col in schema
133	            ]
134	        )
135	    except Exception as e:
136	        logger.error(f"Error describing table {table_name}: {e}")
137	        raise HTTPException(status_code=500, detail=f"Failed to describe table: {str(e)}")
138	
139	@app.post("/mcp/query", response_model=QueryResponse)
140	async def execute_nl_query(
141	    request: QueryRequest,
142	    db_manager: DatabaseManager = Depends(get_db_manager)
143	):
144	    """Convert natural language query to SQL and execute it"""
145	    global nl_converter
146	    
147	    if not nl_converter:
148	        raise HTTPException(status_code=503, detail="NL to SQL converter not available")
149	    
150	    try:
151	        # Get table schemas for context
152	        tables = await db_manager.list_tables()
153	        table_schemas = {}
154	        for table in tables:
155	            schema = await db_manager.describe_table(table["table_name"])
156	            table_schemas[table["table_name"]] = schema
157	        
158	        # Convert natural language to SQL
159	        sql_query = nl_converter.convert_to_sql(request.nl_query, table_schemas)
160	        
161	        # Execute the query with safety checks
162	        results = await db_manager.execute_safe_query(sql_query, limit=request.limit)
163	        
164	        return QueryResponse(
165	            sql_query=sql_query,
166	            results=results,
167	            row_count=len(results)
168	        )
169	        
170	    except Exception as e:
171	        logger.error(f"Error executing NL query '{request.nl_query}': {e}")
172	        raise HTTPException(status_code=500, detail=f"Failed to execute query: {str(e)}")
173	
174	@app.get("/mcp/tables/{table_name}/sample")
175	async def get_table_sample(
176	    table_name: str,
177	    limit: int = 5,
178	    db_manager: DatabaseManager = Depends(get_db_manager)
179	):
180	    """Get a sample of data from a specific table"""
181	    try:
182	        query = f"SELECT * FROM {table_name} LIMIT {min(limit, 50)}"
183	        results = await db_manager.execute_safe_query(query, limit=min(limit, 50))
184	        
185	        return {
186	            "table_name": table_name,
187	            "sample_data": results,
188	            "row_count": len(results)
189	        }
190	        
191	    except Exception as e:
192	        logger.error(f"Error getting sample from table {table_name}: {e}")
193	        raise HTTPException(status_code=500, detail=f"Failed to get table sample: {str(e)}")
