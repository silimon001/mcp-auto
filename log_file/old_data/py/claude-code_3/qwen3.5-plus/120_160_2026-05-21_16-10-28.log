177	                response += " | ".join(["-" * len(h) for h in headers]) + "\n"
178	                
179	                for row in results[:20]:  # Limit to first 20 rows
180	                    values = [str(row.get(h, "")) for h in headers]
181	                    response += " | ".join(values) + "\n"
