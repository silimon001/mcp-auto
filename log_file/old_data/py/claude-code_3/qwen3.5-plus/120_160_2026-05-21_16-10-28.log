1	"""MCP server for Apple Music - Cross-platform playlist and library management.
2	
3	On macOS, additional AppleScript-powered tools are available for playback control,
4	deleting tracks from playlists, and other operations not supported by the REST API.
5	"""
6	
7	import csv
8	import io
9	import json
10	import os
11	import re
12	import sys
13	import time
14	import unicodedata
15	from dataclasses import dataclass
16	from enum import Enum
17	from pathlib import Path
18	from typing import Callable, Optional
19	
20	import requests
21	from mcp.server.fastmcp import FastMCP
22	
23	from .auth import get_developer_token, get_user_token, get_config_dir, get_user_preferences
24	from . import applescript as asc
25	from .track_cache import get_track_cache, get_cache_dir
26	from . import audit_log
27	
28	# Check if AppleScript is available (macOS only)
29	APPLESCRIPT_AVAILABLE = asc.is_available()
30	
31	# Max characters for track listing output
32	MAX_OUTPUT_CHARS = 50000
33	
34	# Minimum digits for a string to be considered a catalog ID (Apple IDs are 10 digits)
35	MIN_CATALOG_ID_LENGTH = 9
36	
37	
38	class EntityType(Enum):
39	    """Types of Apple Music entities."""
40	
41	    TRACK = "track"
42	    ALBUM = "album"
43	    ARTIST = "artist"
44	    PLAYLIST = "playlist"
45	    GENRE = "genre"
46	
47	
48	class InputType(Enum):
49	    """How the input was interpreted."""
50	
51	    CATALOG_ID = "catalog_id"  # All digits, 9+ chars: "1440783617"
52	    LIBRARY_ID = "library_id"  # Starts with "i.": "i.ABC123"
53	    PLAYLIST_ID = "playlist_id"  # Starts with "p.": "p.ABC123"
54	    ALBUM_ID = "album_id"  # Starts with "l.": "l.ABC123"
