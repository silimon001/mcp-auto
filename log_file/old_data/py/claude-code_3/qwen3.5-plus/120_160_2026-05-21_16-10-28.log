222	                    # Merge SSL configuration with existing uvicorn_config
223	                    uvicorn_config["ssl_keyfile"] = ssl_key
224	                    uvicorn_config["ssl_certfile"] = ssl_cert
225	                    uvicorn_config["ssl_ciphers"] = ":".join(ciphers)
226	                    kwargs["uvicorn_config"] = uvicorn_config
227	                else:
228	                    # No certificates found, but HTTPS is required
229	                    error_msg = (
