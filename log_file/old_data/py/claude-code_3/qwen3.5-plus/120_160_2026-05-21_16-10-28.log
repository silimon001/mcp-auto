141	def run_server(argv: list[str] | None = None) -> None:
142	    parser = argparse.ArgumentParser()
143	    # --config is optional; when omitted we use the module-level CURRENT_CONFIG
144	    parser.add_argument("--config", default=None)
145	    args = parser.parse_args(argv)
146	
147	    if args.config:
148	        # Validate and sanitize the provided config path
149	        config_path = os.path.abspath(args.config)
150	        if not os.path.isfile(config_path):
151	            raise ValueError(f"Invalid config file path: {config_path}")
152	
153	        cfg = load_config(Path(config_path))
154	        # Re-initialize runtime from the provided config
155	        _init_from_config(cfg)
156	        # Update module-level current config
157	        globals()["CURRENT_CONFIG"] = cfg
158	    else:
159	        # Try to read config from current directory, fallback to cached config
160	        current_dir_config = Path("config.json")
161	        if current_dir_config.exists():
162	            cfg = load_config(current_dir_config)
163	            # Re-initialize runtime from the current directory config
164	            _init_from_config(cfg)
165	            # Update module-level current config
166	            globals()["CURRENT_CONFIG"] = cfg
167	        else:
168	            # Use the already-loaded config from import-time initialization
169	            cfg = CURRENT_CONFIG
170	
171	    auth_mode = cfg.get("auth_mode", "none").lower()
172	    transport_mode = cfg.get("transport_mode", "stdio").lower()
173	    port = int(cfg.get("port", 8000))
174	    ssl_keyfile = cfg.get("ssl_keyfile")
175	    ssl_certfile = cfg.get("ssl_certfile")
176	
177	    if transport_mode == "sse" or auth_mode == "oauth":
178	        try:
179	            import fastapi  # noqa: F401
180	            import uvicorn  # noqa: F401
181	        except Exception as exc:
182	            raise RuntimeError("fastapi and uvicorn are required for SSE mode") from exc
183	
184	    if auth_mode == "oauth" and transport_mode != "sse":
185	        raise ValueError("OAuth mode requires TRANSPORT_MODE=sse")
186	
187	    uvicorn_kwargs = {}
188	    if ssl_keyfile and ssl_certfile:
189	        uvicorn_kwargs["ssl_keyfile"] = ssl_keyfile
190	        uvicorn_kwargs["ssl_certfile"] = ssl_certfile
191	
192	    scheme = "https" if ssl_keyfile and ssl_certfile else "http"
193	    host = cfg.get("external_hostname", "0.0.0.0")
194	    if scheme == "http" and port == 80:
195	        audience = f"{scheme}://{host}"
196	    elif scheme == "https" and port == 443:
197	        audience = f"{scheme}://{host}"
198	    else:
199	        audience = f"{scheme}://{host}:{port}"
200	
201	    match auth_mode, transport_mode:
202	        case ("none", "stdio"):
203	            mcp.run(transport="stdio")
204	        case ("none", "sse"):
205	            import uvicorn
206	            from fastapi import FastAPI, Request
207	
208	            from delinea_mcp.transports.sse import mount_sse_routes
209	
210	            app = FastAPI(title="Delinea MCP")
211	            if _debug:
212	
213	                @app.middleware("http")
214	                async def log_requests(request: Request, call_next):
215	                    body = await request.body()
216	                    logger.debug(
217	                        "Request from %s to %s headers=%s body=%s",
218	                        request.client.host if request.client else "unknown",
219	                        request.url.path,
220	                        dict(request.headers),
221	                        body.decode("utf-8", "replace"),
222	                    )
223	                    return await call_next(request)
224	
225	            mount_sse_routes(app, mcp)
226	            uvicorn.run(app, host="0.0.0.0", port=port, **uvicorn_kwargs)
227	        case ("oauth", "sse"):
228	            import uvicorn
229	            from fastapi import FastAPI, Request
230	
231	            from delinea_mcp.auth.routes import mount_oauth_routes
232	            from delinea_mcp.auth.validators import require_scopes
233	            from delinea_mcp.transports.sse import mount_sse_routes
234	
235	            app = FastAPI(title="Delinea MCP (OAuth)")
236	            if _debug:
237	
238	                @app.middleware("http")
239	                async def log_requests(request: Request, call_next):
240	                    body = await request.body()
241	                    logger.debug(
242	                        "Request from %s to %s headers=%s body=%s",
243	                        request.client.host if request.client else "unknown",
244	                        request.url.path,
245	                        dict(request.headers),
246	                        body.decode("utf-8", "replace"),
247	                    )
248	                    return await call_next(request)
249	
250	            mount_oauth_routes(app, cfg)
251	            mount_sse_routes(
252	                app,
253	                mcp,
254	                require_scopes(
255	                    ["mcp.read", "mcp.write"],
256	                    audience=audience,
257	                    chatgpt_no_scope_check=bool(
258	                        cfg.get("chatgpt_disable_scope_checks")
259	                    ),
260	                ),
261	            )
262	            uvicorn.run(app, host="0.0.0.0", port=port, **uvicorn_kwargs)
263	        case ("passthrough", _):
264	            raise NotImplementedError(
265	                "Passthrough auth is slated for a future release."
266	            )
267	        case _:
268	            raise ValueError(
269	                f"Invalid AUTH_MODE '{auth_mode}' or TRANSPORT_MODE '{transport_mode}'"
270	            )
