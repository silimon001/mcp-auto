1	#!/usr/bin/env python3
2	"""Unraid MCP Server - Entry Point.
3	
4	This is the main entry point for the Unraid MCP Server. It imports and starts
5	the modular server implementation from unraid_mcp.server.
6	"""
7	
8	import asyncio
9	import sys
10	
11	
12	async def shutdown_cleanup() -> None:
13	    """Cleanup resources on server shutdown."""
14	    try:
15	        from .subscriptions.manager import subscription_manager
16	
17	        await subscription_manager.stop_all()
18	    except Exception as e:
19	        print(f"Error stopping subscriptions during cleanup: {e}", file=sys.stderr)
20	
21	    try:
22	        from .core.client import close_http_client
23	
24	        await close_http_client()
25	    except Exception as e:
26	        print(f"Error during cleanup: {e}", file=sys.stderr)
27	
28	
29	def _run_shutdown_cleanup() -> None:
30	    """Run shutdown cleanup, suppressing expected event loop errors."""
31	    try:
32	        asyncio.run(shutdown_cleanup())
33	    except RuntimeError as e:
34	        msg = str(e).lower()
35	        if "event loop is closed" in msg or "no running event loop" in msg:
36	            pass  # Expected during shutdown
37	        else:
38	            print(f"WARNING: Unexpected error during cleanup: {e}", file=sys.stderr)
39	
40	
41	def main() -> None:
42	    """Main entry point for the Unraid MCP Server."""
43	    try:
44	        from .server import run_server
45	
46	        run_server()
47	    except KeyboardInterrupt:
48	        print("\nServer stopped by user")
49	        _run_shutdown_cleanup()
50	    except Exception as e:
51	        print(f"Server failed to start: {e}")
52	        _run_shutdown_cleanup()
53	        raise
54	
55	
56	if __name__ == "__main__":
57	    main()
58	

