125	def apply_cli_settings_overrides(args):
126	    """Apply command line argument overrides to settings and print notifications.
127	
128	    Args:
129	        args: Parsed command line arguments
130	    """
131	    if args.transport != settings.server_transport:
132	        settings.server_transport = args.transport
133	        print(f"ℹ Transport overridden via CLI: {args.transport}", file=sys.stderr)
134	
135	    if args.di_url != settings.di_service_url:
136	        settings.di_service_url = args.di_url
137	        print(f"Data Intelligence service URL overridden via CLI: {args.di_url}", file=sys.stderr)
138	
139	    if args.wxo:
140	        settings.wxo = True
141	        print("✅ Watsonx orchestrator compatibility mode enabled", file=sys.stderr)
142	    else:
143	        settings.wxo = False
144	
145	
146	def main():
147	    """Main server entry point."""
148	    parser = argparse.ArgumentParser(description="IKC MCP Server")
149	    parser.add_argument("--transport", choices=["stdio", "http"], default=settings.server_transport, help="Transport protocol")
150	    parser.add_argument("--host", default=settings.server_host, help="Server host address")
151	    parser.add_argument("--port", type=int, default=settings.server_port, help="Server port number")
152	    parser.add_argument("--ssl-cert", help="Path to SSL certificate file")
153	    parser.add_argument("--ssl-key", help="Path to SSL private key file")
154	    parser.add_argument("--di-url", default=settings.di_service_url, help="Data Intelligence service URL")
155	    parser.add_argument("--wxo", action="store_true", help="Enable watsonx orchestrator compatibility mode")
156	    args = parser.parse_args()
157	
158	    apply_cli_settings_overrides(args)
159	
160	    print(" Starting IKC MCP Server...", file=sys.stderr)
161	    print(f"   Transport: {args.transport}", file=sys.stderr)
162	
163	    try:
164	        mcp = create_server()
165	        # Get the actual registered count after registration
166	        actual_registered_count = service_registry.get_registered_count()
167	        print(f"✅ Server initialized with {actual_registered_count} registered tools.", file=sys.stderr)
168	
169	        if args.transport == "http":
170	            # Initialize protocol and port for display
171	            protocol = "http"
172	            port = args.port
173	            
174	            kwargs = {
175	                "transport": "streamable-http",
176	                "host": args.host,
177	                "port": args.port
178	            }
179	            
180	            # Configure uvicorn for high concurrency handling
181	            uvicorn_config: dict[str, Any] = {
182	                "limit_concurrency": settings.server_limit_concurrency,
183	                "timeout_keep_alive": settings.server_timeout_keep_alive,
184	                "backlog": settings.server_backlog,
185	            }
186	            kwargs["uvicorn_config"] = uvicorn_config
187	            
188	            print(
189	                f"   Server concurrency settings: "
190	                f"limit_concurrency={settings.server_limit_concurrency}, "
191	                f"timeout_keep_alive={settings.server_timeout_keep_alive}s, "
192	                f"backlog={settings.server_backlog}",
193	                file=sys.stderr
194	            )
195	
196	            # Add SSL configuration if certificate and key are provided
197	            ssl_cert = args.ssl_cert or settings.ssl_cert_path
198	            ssl_key = args.ssl_key or settings.ssl_key_path
199	
200	            if not settings.use_https:
201	                highlight = "\033[1;33m"  # Bold yellow
202	                reset = "\033[0m"  # Reset formatting
203	                print(f"⚠️ WARNING: Starting server in HTTP mode because {highlight}SERVER_HTTPS=False{reset}.", file=sys.stderr)
204	            
205	            # Check if we should use HTTPS based on settings
206	            if settings.use_https:
207	                # If certificates are available, configure HTTPS
208	                if ssl_cert and ssl_key:
