20	def create_flask_app(config):
21	    base_dir = os.path.dirname(os.path.abspath(__file__))
22	    app = Flask(
23	        __name__,
24	        template_folder=os.path.join(base_dir, "templates"),
25	        static_folder=os.path.join(base_dir, "static"),
26	    )
27	    CORS(app, resources={r"/*": {"origins": config.cors_origins}})
28	    configure_flask_logger(app, config.debug_mode)
29	    app.logger.info(
30	        "Flask app initialized. Debug mode: %s. Host: %s. Port: %s. CORS origins: %s.",
31	        config.debug_mode,
32	        config.host,
33	        config.port,
34	        config.cors_origins,
35	    )
36	    return app
