1	"""
2	Instantly MCP Server - API Client
3	
4	HTTP client for making requests to the Instantly.ai API v2.
5	Features:
6	- Triple authentication (env variable + URL path + headers)
7	- Rate limiting with header tracking
8	- Dynamic timeouts based on operation type
9	- Comprehensive error handling
10	"""
11	
12	import os
13	import asyncio
14	from typing import Any, Optional
15	from dataclasses import dataclass, field
16	from datetime import datetime
17	
18	import httpx
19	
20	# Import per-request API key context (lazy import to avoid circular deps)
21	def _get_request_api_key() -> Optional[str]:
22	    """Get API key from request context if available."""
23	    try:
24	        from .http_app import get_request_api_key
25	        return get_request_api_key()
26	    except ImportError:
27	        return None
28	
29	# API Configuration
30	INSTANTLY_API_URL = "https://api.instantly.ai/api/v2"
31	DEFAULT_TIMEOUT = 60.0  # seconds
32	EXTENDED_TIMEOUT = 90.0  # for list operations
33	SEARCH_TIMEOUT = 120.0  # for search operations
34	
35	
36	@dataclass
37	class RateLimitInfo:
38	    """Track rate limit information from API responses."""
39	    remaining: Optional[int] = None
40	    limit: Optional[int] = None
41	    reset_at: Optional[datetime] = None
42	    last_updated: Optional[datetime] = None
43	
44	
45	@dataclass
46	class InstantlyClient:
47	    """
48	    HTTP client for Instantly.ai API v2.
49	    
50	    Supports dual authentication:
51	    - Environment variable: INSTANTLY_API_KEY
52	    - Per-request: api_key parameter (for multi-tenant HTTP mode)
53	    """
54	    
55	    _api_key: Optional[str] = field(default=None, repr=False)
56	    rate_limit: RateLimitInfo = field(default_factory=RateLimitInfo)
57	    
58	    def __post_init__(self):
59	        # Try to get API key from environment if not provided
60	        if not self._api_key:
61	            self._api_key = os.environ.get("INSTANTLY_API_KEY")
62	    
63	    @property
64	    def has_api_key(self) -> bool:
65	        """Check if an API key is configured."""
66	        return bool(self._api_key)
67	    
68	    def set_api_key(self, api_key: str) -> None:
69	        """Set API key programmatically."""
70	        self._api_key = api_key
71	    
72	    def _get_timeout(self, endpoint: str, has_search: bool = False) -> float:
73	        """
74	        Determine appropriate timeout based on endpoint and operation.
75	        
76	        Search operations and large list operations need longer timeouts
77	        due to potential dataset sizes (10k+ leads).
78	        """
79	        if has_search:
80	            return SEARCH_TIMEOUT
81	        if "/leads" in endpoint and "list" in endpoint:
82	            return EXTENDED_TIMEOUT
83	        return DEFAULT_TIMEOUT
84	    
85	    def _update_rate_limit(self, headers: httpx.Headers) -> None:
86	        """Update rate limit tracking from response headers."""
87	        try:
88	            if "x-ratelimit-remaining" in headers:
89	                self.rate_limit.remaining = int(headers["x-ratelimit-remaining"])
90	            if "x-ratelimit-limit" in headers:
91	                self.rate_limit.limit = int(headers["x-ratelimit-limit"])
92	            if "x-ratelimit-reset" in headers:
93	                self.rate_limit.reset_at = datetime.fromtimestamp(
94	                    int(headers["x-ratelimit-reset"])
95	                )
96	            self.rate_limit.last_updated = datetime.now()
97	        except (ValueError, KeyError):
98	            pass  # Silently ignore parsing errors
99	    
100	    async def request(
101	        self,
102	        method: str,
103	        endpoint: str,
104	        *,
105	        params: Optional[dict[str, Any]] = None,
106	        json: Optional[dict[str, Any]] = None,
107	        api_key: Optional[str] = None,
108	        timeout: Optional[float] = None,
109	    ) -> Any:
110	        """
111	        Make an authenticated request to the Instantly API.
112	        
113	        Args:
114	            method: HTTP method (GET, POST, PATCH, DELETE)
115	            endpoint: API endpoint path (e.g., '/accounts', '/campaigns/{id}')
116	            params: Query parameters for GET requests
117	            json: JSON body for POST/PATCH requests
118	            api_key: Optional per-request API key (overrides configured key)
119	            timeout: Optional custom timeout
120	        
121	        Returns:
122	            Parsed JSON response
123	        
124	        Raises:
125	            ValueError: If no API key is available
126	            httpx.HTTPStatusError: For API errors
127	        """
128	        # Resolve API key (per-request param > request context > instance > environment)
129	        use_api_key = api_key or _get_request_api_key() or self._api_key
130	        if not use_api_key:
131	            raise ValueError(
132	                "Instantly API key is required. Provide via:\n"
133	                "  - URL path: /mcp/YOUR_API_KEY\n"
134	                "  - Header: Authorization: YOUR_API_KEY\n"
135	                "  - Header: x-instantly-api-key: YOUR_API_KEY\n"
136	                "  - Environment: INSTANTLY_API_KEY"
137	            )
138	        
139	        # Build request
140	        url = f"{INSTANTLY_API_URL}{endpoint}"
141	        headers = {"Authorization": f"Bearer {use_api_key}"}
142	        
143	        # Determine timeout
144	        has_search = bool(json and json.get("search"))
145	        request_timeout = timeout or self._get_timeout(endpoint, has_search)
146	        
147	        async with httpx.AsyncClient(timeout=request_timeout) as client:
148	            try:
149	                response = await client.request(
150	                    method=method,
151	                    url=url,
152	                    headers=headers,
153	                    params=params,
154	                    json=json,
155	                )
156	                
157	                # Update rate limit tracking
158	                self._update_rate_limit(response.headers)
159	                
160	                # Handle errors
161	                if response.status_code >= 400:
162	                    error_detail = self._parse_error(response)
163	                    raise httpx.HTTPStatusError(
164	                        message=error_detail,
165	                        request=response.request,
166	                        response=response,
167	                    )
168	                
169	                # Return parsed response
170	                if response.status_code == 204:
171	                    return {"success": True}
172	                
173	                return response.json()
174	                
175	            except httpx.TimeoutException as e:
176	                raise TimeoutError(
177	                    f"Request timed out after {request_timeout}s. "
178	                    f"For large datasets, try using pagination with smaller limits."
179	                ) from e
180	            except httpx.RequestError as e:
181	                raise ConnectionError(
182	                    f"Failed to connect to Instantly API: {e}"
183	                ) from e
184	    
185	    def _parse_error(self, response: httpx.Response) -> str:
186	        """Parse error response and return descriptive message."""
187	        try:
188	            data = response.json()
189	            
190	            # Handle various error formats from Instantly API
191	            if isinstance(data, dict):
192	                # Standard error format
193	                if "error" in data:
194	                    error = data["error"]
195	                    if isinstance(error, dict):
196	                        return error.get("message", str(error))
197	                    return str(error)
198	                
199	                # Validation error format
200	                if "message" in data:
201	                    return data["message"]
202	                
203	                # Detail format
204	                if "detail" in data:
205	                    return data["detail"]
206	            
207	            return f"HTTP {response.status_code}: {response.text[:200]}"
208	            
209	        except Exception:
210	            return f"HTTP {response.status_code}: {response.text[:200]}"
211	    
212	    # Convenience methods
213	    async def get(self, endpoint: str, **kwargs) -> Any:
214	        """GET request."""
215	        return await self.request("GET", endpoint, **kwargs)
216	    
217	    async def post(self, endpoint: str, **kwargs) -> Any:
218	        """POST request."""
219	        return await self.request("POST", endpoint, **kwargs)
220	    
221	    async def patch(self, endpoint: str, **kwargs) -> Any:
222	        """PATCH request."""
223	        return await self.request("PATCH", endpoint, **kwargs)
224	    
225	    async def delete(self, endpoint: str, **kwargs) -> Any:
226	        """DELETE request."""
227	        return await self.request("DELETE", endpoint, **kwargs)
228	
229	
230	# Global client instance
231	client = InstantlyClient()
232	
233	
234	def get_client() -> InstantlyClient:
235	    """Get the global API client instance."""
236	    return client
237	
238	
239	def set_api_key(api_key: str) -> None:
240	    """Set the API key for the global client."""
241	    client.set_api_key(api_key)
242	
243	

