170	def bounded_int(value, default_value: int, min_value: int = 1, max_value: int = 2000) -> int:
171	    try:
172	        normalized = int(value if value is not None else default_value)
173	    except Exception:
174	        normalized = int(default_value)
175	    return max(min_value, min(max_value, normalized))
