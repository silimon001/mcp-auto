1	"""Command-line interface for Apple Music MCP server setup."""
2	
3	import argparse
4	import json
5	import sys
6	import time
7	
8	from .auth import (
9	    get_config_dir,
10	    generate_developer_token,
11	    run_auth_server,
12	    get_developer_token,
13	    get_user_token,
14	)
15	
16	
17	def cmd_init(args):
18	    """Initialize configuration directory and create sample config."""
19	    config_dir = get_config_dir()
20	    config_file = config_dir / "config.json"
21	
22	    if config_file.exists() and not args.force:
23	        print(f"Config already exists: {config_file}")
24	        print("Use --force to overwrite")
25	        return 1
26	
27	    sample_config = {
28	        "team_id": "YOUR_TEAM_ID",
29	        "key_id": "YOUR_KEY_ID",
30	        "private_key_path": str(config_dir / "AuthKey_XXXXXXXX.p8"),
31	    }
32	
33	    with open(config_file, "w") as f:
34	        json.dump(sample_config, f, indent=2)
35	
36	    print(f"Created config file: {config_file}")
37	    print()
38	    print("Next steps:")
39	    print("1. Edit the config file with your Apple Developer credentials")
40	    print("2. Copy your .p8 private key to the config directory")
41	    print("3. Run: applemusic-mcp generate-token")
42	    print("4. Run: applemusic-mcp authorize")
43	    return 0
44	
45	
46	def cmd_generate_token(args):
47	    """Generate a new developer token."""
48	    try:
49	        token = generate_developer_token(expiry_days=args.days)
50	        exp_time = time.time() + (args.days * 24 * 60 * 60)
51	        print(f"Developer token generated!")
52	        print(f"Expires: {time.ctime(exp_time)}")
53	        print(f"Token (first 50 chars): {token[:50]}...")
54	        return 0
55	    except FileNotFoundError as e:
56	        print(f"Error: {e}")
57	        print("Run 'applemusic-mcp init' first to create config")
58	        return 1
59	    except Exception as e:
60	        print(f"Error generating token: {e}")
61	        return 1
62	
63	
64	def cmd_authorize(args):
65	    """Run browser-based authorization to get music user token."""
66	    try:
67	        # Check developer token exists
68	        get_developer_token()
69	    except (FileNotFoundError, ValueError) as e:
70	        print(f"Error: {e}")
71	        return 1
72	
73	    print("Starting authorization flow...")
74	    print()
75	    token = run_auth_server(port=args.port)
76	    if token:
77	        return 0
78	    return 1
79	
80	
81	def cmd_status(args):
82	    """Check authentication status."""
83	    config_dir = get_config_dir()
84	
85	    print("Apple Music MCP Status")
86	    print("=" * 40)
87	    print(f"Config directory: {config_dir}")
88	    print()
89	
90	    # Check config
91	    config_file = config_dir / "config.json"
92	    if config_file.exists():
93	        print("✓ Config file exists")
94	        try:
95	            with open(config_file) as f:
96	                config = json.load(f)
97	            print(f"  Team ID: {config.get('team_id', 'NOT SET')}")
98	            print(f"  Key ID: {config.get('key_id', 'NOT SET')}")
99	        except Exception as e:
100	            print(f"  Error reading config: {e}")
101	    else:
102	        print("✗ Config file missing")
103	
104	    print()
105	
106	    # Check developer token
107	    dev_token_file = config_dir / "developer_token.json"
108	    if dev_token_file.exists():
109	        try:
110	            with open(dev_token_file) as f:
111	                data = json.load(f)
112	            exp = data.get("expires", 0)
113	            if exp > time.time():
114	                days_left = (exp - time.time()) / 86400
115	                print(f"✓ Developer token valid ({days_left:.0f} days remaining)")
116	            else:
117	                print("✗ Developer token expired")
118	        except Exception as e:
119	            print(f"✗ Developer token error: {e}")
120	    else:
121	        print("✗ Developer token missing")
122	
123	    # Check user token
124	    user_token_file = config_dir / "music_user_token.json"
125	    if user_token_file.exists():
126	        print("✓ Music user token exists")
127	    else:
128	        print("✗ Music user token missing")
129	
130	    print()
131	
132	    # Test API connection
133	    try:
134	        import requests
135	        headers = {
136	            "Authorization": f"Bearer {get_developer_token()}",
137	            "Music-User-Token": get_user_token(),
138	        }
139	        response = requests.get(
140	            "https://api.music.apple.com/v1/me/library/playlists",
141	            headers=headers,
142	            params={"limit": 1},
143	        )
144	        if response.status_code == 200:
145	            print("✓ API connection successful")
146	        else:
147	            print(f"✗ API returned status {response.status_code}")
148	    except FileNotFoundError:
149	        print("✗ Cannot test API (missing tokens)")
150	    except Exception as e:
151	        print(f"✗ API error: {e}")
152	
153	    return 0
154	
155	
156	def cmd_serve(args):
157	    """Start the MCP server."""
158	    from .server import main
159	    main()
160	
161	
162	def main():
163	    """Main CLI entry point."""
164	    parser = argparse.ArgumentParser(
165	        description="Apple Music MCP Server - Playlist management via API"
166	    )
167	    subparsers = parser.add_subparsers(dest="command", help="Commands")
168	
169	    # init
170	    init_parser = subparsers.add_parser("init", help="Initialize configuration")
171	    init_parser.add_argument("--force", action="store_true", help="Overwrite existing config")
172	
173	    # generate-token
174	    token_parser = subparsers.add_parser("generate-token", help="Generate developer token")
175	    token_parser.add_argument(
176	        "--days", type=int, default=180, help="Token validity in days (max 180)"
177	    )
178	
179	    # authorize
180	    auth_parser = subparsers.add_parser("authorize", help="Authorize with Apple Music")
181	    auth_parser.add_argument("--port", type=int, default=8765, help="Local server port")
182	
183	    # status
184	    subparsers.add_parser("status", help="Check authentication status")
185	
186	    # serve
187	    subparsers.add_parser("serve", help="Start MCP server")
188	
189	    args = parser.parse_args()
190	
191	    if args.command == "init":
192	        sys.exit(cmd_init(args))
193	    elif args.command == "generate-token":
194	        sys.exit(cmd_generate_token(args))
195	    elif args.command == "authorize":
196	        sys.exit(cmd_authorize(args))
197	    elif args.command == "status":
198	        sys.exit(cmd_status(args))
199	    elif args.command == "serve":
200	        cmd_serve(args)
201	    else:
202	        parser.print_help()
203	        sys.exit(0)
204	
205	
206	if __name__ == "__main__":
207	    main()
208	

