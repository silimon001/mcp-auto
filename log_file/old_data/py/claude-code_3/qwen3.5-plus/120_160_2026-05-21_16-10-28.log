1	#!/usr/bin/env python3
2	# Copyright 2026 Flyto2. Licensed under Apache-2.0. See LICENSE.
3	
4	"""
5	Flyto2 Core MCP Server — STDIO Transport
6	
7	Thin shell over mcp_handler.py for STDIO-based MCP communication.
8	
9	Usage:
10	    python -m core.mcp_server
11	
12	Claude Code config (~/.claude/mcp_servers.json):
13	{
14	    "flyto-core": {
15	        "command": "python",
16	        "args": ["-m", "core.mcp_server"],
17	        "cwd": "/path/to/flyto-core/src"
18	    }
19	}
20	"""
21	
22	import json
23	import sys
24	import os
25	import asyncio
26	from typing import Any, Dict
27	
28	from core.mcp_handler import (
29	    handle_jsonrpc_request,
30	    execute_module as _handler_execute_module,
31	    TOOLS,
32	    SERVER_VERSION,
33	)
34	
35	# Browser session store — persists BrowserDriver across MCP tool calls (STDIO-specific)
36	_browser_sessions: Dict[str, Any] = {}
37	
38	# ============================================================
39	# Local Development: Allow localhost for browser testing
40	# ============================================================
41	os.environ.setdefault('FLYTO_ALLOWED_HOSTS', 'localhost,127.0.0.1')
42	
43	
44	async def execute_module(module_id, params, context=None):
45	    """Backward-compatible wrapper that injects STDIO _browser_sessions."""
46	    return await _handler_execute_module(
47	        module_id, params, context=context, browser_sessions=_browser_sessions,
48	    )
49	
50	
51	async def async_main():
52	    """MCP Server main loop — persistent event loop for browser session survival."""
53	    loop = asyncio.get_event_loop()
54	    while True:
55	        line = await loop.run_in_executor(None, sys.stdin.readline)
56	        if not line:
57	            break  # EOF
58	        try:
59	            request = json.loads(line.strip())
60	            response = await handle_jsonrpc_request(request, _browser_sessions)
61	            if response is not None:
62	                print(json.dumps(response), flush=True)
63	        except json.JSONDecodeError:
64	            pass
65	        except Exception as e:
66	            print(json.dumps({"jsonrpc": "2.0", "error": {"code": -32000, "message": str(e)}}), flush=True)
67	
68	    # Cleanup: close all browser sessions to prevent zombie Chromium processes
69	    for session_id, driver in list(_browser_sessions.items()):
70	        try:
71	            await driver.close()
72	        except Exception:
73	            pass
74	    _browser_sessions.clear()
75	
76	
77	def main():
78	    """Entry point — runs the async main loop."""
79	    asyncio.run(async_main())
80	
81	
82	if __name__ == "__main__":
83	    main()
84	

