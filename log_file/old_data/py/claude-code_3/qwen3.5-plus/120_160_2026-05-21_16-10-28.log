1	#!/usr/bin/env python3
2	"""
3	FastMCP Server for Kroger API
4	
5	This server provides MCP tools for interacting with the Kroger API, including:
6	- Location management (search stores, get details, set preferred location)
7	- Product search and details
8	- Cart management (add items, bulk operations, tracking)
9	- Chain and department information
10	- User profile and authentication
11	
12	Environment Variables Required:
13	- KROGER_CLIENT_ID: Your Kroger API client ID
14	- KROGER_CLIENT_SECRET: Your Kroger API client secret
15	- KROGER_REDIRECT_URI: Redirect URI for OAuth2 flow (default: http://localhost:8000/callback)
16	- KROGER_USER_ZIP_CODE: Default zip code for location searches (optional)
17	"""
18	
19	import sys
20	from fastmcp import FastMCP
21	
22	# Import all tool modules
23	from .tools import location_tools
24	from .tools import product_tools
25	from .tools import cart_tools
26	from .tools import info_tools
27	from .tools import profile_tools
28	from .tools import utility_tools
29	from .tools import auth_tools
30	
31	# Import prompts
32	from . import prompts
33	
34	
35	def create_server() -> FastMCP:
36	    """Create and configure the FastMCP server instance"""
37	    # Initialize the FastMCP server
38	    mcp = FastMCP(
39	        name="Kroger API Server",
40	        instructions="""
41	        This MCP server provides access to Kroger's API for grocery shopping functionality.
42	        
43	        Key Features:
44	        - Search and manage store locations
45	        - Find and search products
46	        - Add items to shopping cart with local tracking
47	        - Access chain and department information
48	        - User profile management
49	        
50	        Common workflows:
51	        1. Set a preferred location with set_preferred_location
52	        2. Search for products with search_products
53	        3. Add items to cart with add_items_to_cart
54	        4. Use bulk_add_to_cart for multiple items at once
55	        5. View current cart with view_current_cart
56	        6. Mark order as placed with mark_order_placed
57	        
58	        Authentication Flow:
59	        1. Use start_authentication to get an authorization URL
60	        2. Open the URL in your browser and authorize the application
61	        3. Copy the full redirect URL from your browser
62	        4. Use complete_authentication with the redirect URL to finish the process
63	        
64	        Cart Tracking:
65	        This server maintains a local record of items added to your cart since the Kroger API
66	        doesn't provide cart viewing functionality. When you place an order through the Kroger
67	        website/app, use mark_order_placed to move the current cart to order history.
68	        """
69	    )
70	
71	    # Register all tools from the modules
72	    location_tools.register_tools(mcp)
73	    product_tools.register_tools(mcp)
74	    cart_tools.register_tools(mcp)
75	    info_tools.register_tools(mcp)
76	    profile_tools.register_tools(mcp)
77	    utility_tools.register_tools(mcp)
78	    auth_tools.register_tools(mcp)
79	    
80	    # Register prompts
81	    prompts.register_prompts(mcp)
82	    
83	    return mcp
84	
85	
86	def main():
87	    """Main entry point for the Kroger MCP server"""
88	    mcp = create_server()
89	    mcp.run()
90	
91	
92	if __name__ == "__main__":
93	    main()
94	

