1	"""Entities Registry for Graphiti MCP Server.
2	
3	This module provides a registry to manage entities in a modular way.
4	"""
5	
6	from typing import Dict, Type
7	
8	from pydantic import BaseModel, ConfigDict
9	
10	# Global registry to store entities
11	_ENTITY_REGISTRY: Dict[str, Type[BaseModel]] = {}
12	
13	
14	def register_entity(name: str, entity_class: Type[BaseModel]) -> None:
15	    """Register an entity with the registry.
16	
17	    Args:
18	        name: The name of the entity
19	        entity_class: The Pydantic model class for the entity
20	    """
21	    _ENTITY_REGISTRY[name] = entity_class
22	
23	
24	def get_entities() -> Dict[str, Type[BaseModel]]:
25	    """Get all registered entities.
26	
27	    Returns:
28	        A dictionary mapping entity names to their Pydantic model classes
29	    """
30	    # Return the actual registry reference, not a copy
31	    return _ENTITY_REGISTRY
32	
33	
34	def get_entity_subset(names: list[str]) -> Dict[str, Type[BaseModel]]:
35	    """Get a subset of registered entities.
36	
37	    Args:
38	        names: List of entity names to include
39	
40	    Returns:
41	        A dictionary containing only the specified entities
42	    """
43	    return {name: _ENTITY_REGISTRY[name] for name in names if name in _ENTITY_REGISTRY} 

