1097	def load_entities_from_directory(directory_path: str, subdir_selection_spec: str = "") -> None:
1098	    """Load Python entity modules from a directory, optionally filtering by subdirectories.
1099	
1100	    If subdir_selection_spec is empty, loads all entities recursively from directory_path.
1101	    If subdir_selection_spec is provided (comma-separated subdir names), loads entities
1102	    recursively only from those specific subdirectories within directory_path.
1103	
1104	    Args:
1105	        directory_path: Base path to the directory containing entity modules/subdirectories.
1106	        subdir_selection_spec: Comma-separated string of subdirectory names to load, or empty to load all.
1107	    """
1108	    logger.info(f"Loading entities from base directory: {directory_path} with selection spec: '{subdir_selection_spec or 'ALL'}'")
1109	    base_directory = Path(directory_path)
1110	    if not base_directory.exists() or not base_directory.is_dir():
