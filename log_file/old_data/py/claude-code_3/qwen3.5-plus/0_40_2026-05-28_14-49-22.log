413	@mcp.tool()
414	async def uv_build_project(
415	    project_path: str | None = None,
416	    wheel: bool = True,
417	    sdist: bool = True,
418	    output_dir: str | None = None,
419	) -> BuildResult:
420	    """
421	    Build the project into distributable packages.
422	
423	    Creates wheel and/or source distribution files that can be uploaded to PyPI
424	    or installed elsewhere.
425	
426	    Args:
427	        project_path: Path to the project directory (defaults to current directory)
428	        wheel: Build a wheel package (default: True)
429	        sdist: Build a source distribution (default: True)
430	        output_dir: Output directory for built packages (default: dist/)
431	
432	    Returns:
433	        BuildResult with build results including artifacts created
434	    """
435	    from pathlib import Path
436	    from .utils import run_uv_command, find_uv_project_root
437	
438	    project_dir = Path(project_path).resolve() if project_path else Path.cwd().resolve()
439	    root = find_uv_project_root(project_dir)
440	    if root:
441	        project_dir = root
442	
443	    cmd = ["build"]
444	
445	    # Add format flags
446	    if wheel and not sdist:
447	        cmd.append("--wheel")
448	    elif sdist and not wheel:
449	        cmd.append("--sdist")
450	    # If both are True (default), build both formats
451	
452	    if output_dir:
453	        cmd.extend(["--out-dir", output_dir])
454	
455	    logger.info(f"Building project in {project_dir}")
456	    success, stdout, stderr = await run_uv_command(cmd, cwd=project_dir)
457	
458	    # Parse output to find artifacts
459	    artifacts: list[str] = []
460	    if success:
461	        dist_dir = Path(output_dir) if output_dir else project_dir / "dist"
462	        if dist_dir.exists():
463	            artifacts = [str(f.name) for f in dist_dir.iterdir() if f.is_file()]
464	
465	    return BuildResult(
466	        project_dir=str(project_dir),
467	        output_dir=str(output_dir) if output_dir else str(project_dir / "dist"),
468	        success=success,
469	        artifacts=artifacts,
470	        message="Build completed successfully" if success else "Build failed",
471	        error=stderr if not success else None,
472	    )
