806	@mcp.tool()
807	async def uv_project_version(
808	    value: str | None = None,
809	    bump: str | None = None,
810	    project_path: str | None = None,
811	    dry_run: bool = False,
812	) -> VersionResult:
813	    """
814	    Read or update the project's version in pyproject.toml.
815	
816	    Args:
817	        value: Set the version to this exact string (e.g., "1.2.3").
818	        bump: Bump semantics: major, minor, patch.
819	        project_path: Project directory (defaults to current directory).
820	        dry_run: If True, do not write changes.
821	
822	    Returns:
823	        VersionResult with the current (and optionally previous) version.
824	    """
825	    from pathlib import Path
826	    from .utils import run_uv_command, find_uv_project_root
827	
828	    project_dir = Path(project_path).resolve() if project_path else Path.cwd().resolve()
829	    root = find_uv_project_root(project_dir)
830	    if root:
831	        project_dir = root
832	
833	    cmd: list[str] = ["version"]
834	    if bump:
835	        cmd.extend(["--bump", bump])
