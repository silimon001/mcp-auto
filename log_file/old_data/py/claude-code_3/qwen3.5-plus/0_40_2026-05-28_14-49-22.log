511	@mcp.tool()
512	async def uv_get_workspace_manifest(
513	    project_path: str | None = None,
514	) -> WorkspaceManifest:
515	    """
516	    Introspect a workspace tree for monorepo / microservice configurations.
517	
518	    Args:
519	        project_path: Path to the project root (defaults to cwd).
520	
521	    Returns:
522	        WorkspaceManifest with members and dependency metadata.
523	    """
524	    from pathlib import Path
525	    from .utils import find_uv_project_root
526	
527	    project_dir = Path(project_path).resolve() if project_path else Path.cwd().resolve()
528	    root = find_uv_project_root(project_dir)
529	    if root:
530	        project_dir = root
531	
532	    # Check if workspace config exists in pyproject.toml
533	    workspace_members: list[str] = []
534	    pyproject = project_dir / "pyproject.toml"
535	    if pyproject.exists():
536	        try:
537	            import tomllib
538	        except ImportError:
539	            import tomli as tomllib  # type: ignore
540	
541	        try:
542	            with open(pyproject, "rb") as f:
543	                data = tomllib.load(f)
544	            tool_uv = data.get("tool", {}).get("uv", {})
545	            workspace = tool_uv.get("workspace", {})
546	            raw_members = workspace.get("members", [])
547	            if isinstance(raw_members, list):
548	                workspace_members = raw_members
549	        except Exception:
550	            pass
551	
552	    members: list[WorkspaceMember] = []
553	
554	    if workspace_members:
555	        for pattern in workspace_members:
556	            resolved = list(project_dir.glob(pattern))
557	            for member_dir in resolved:
558	                if member_dir.is_dir() and (member_dir / "pyproject.toml").exists():
559	                    try:
560	                        with open(member_dir / "pyproject.toml", "rb") as f:
561	                            data = tomllib.load(f)
562	                        name = data.get("project", {}).get("name", member_dir.name)
563	                        deps = data.get("project", {}).get("dependencies", [])
564	                        members.append(
565	                            WorkspaceMember(
566	                                name=name,
567	                                path=str(member_dir.resolve()),
568	                                dependencies=deps if isinstance(deps, list) else [],
569	                            )
570	                        )
571	                    except Exception:
572	                        members.append(
573	                            WorkspaceMember(
574	                                name=member_dir.name,
575	                                path=str(member_dir.resolve()),
576	                                dependencies=[],
577	                            )
578	                        )
579	    else:
580	        # No workspace declared: treat root as sole member
581	        try:
582	            with open(pyproject, "rb") as f:
583	                data = tomllib.load(f)
584	            name = data.get("project", {}).get("name", project_dir.name)
585	            deps = data.get("project", {}).get("dependencies", [])
586	            members.append(
587	                WorkspaceMember(
588	                    name=name,
589	                    path=str(project_dir),
590	                    dependencies=deps if isinstance(deps, list) else [],
591	                )
592	            )
593	        except Exception:
594	            members.append(
595	                WorkspaceMember(
596	                    name=project_dir.name,
597	                    path=str(project_dir),
598	                    dependencies=[],
599	                )
600	            )
601	
602	    return WorkspaceManifest(
603	        root=str(project_dir),
604	        is_workspace=bool(workspace_members),
605	        members=members,
606	    )
607	
608	
609	@mcp.tool()
610	async def uv_self_heal_environment(
611	    project_path: str | None = None,
612	) -> SelfHealingDiagnostics:
613	    """
614	    Self-healing environment diagnostics.
615	
616	    Captures ModuleNotFoundError or layout exceptions, extracts missing
617	    package names via regex, and returns a structured remedy payload.
618	
619	    Args:
620	        project_path: Path to the project directory (defaults to current directory).
621	
622	    Returns:
623	        SelfHealingDiagnostics with detected issues and recommended actions.
624	    """
625	    import re
626	    from .utils import run_uv_command, validate_project_path, find_uv_project_root
627	
628	    try:
629	        project_dir = validate_project_path(project_path)
630	    except Exception as e:
631	        return SelfHealingDiagnostics(
632	            success=False,
633	            error=str(e),
634	        )
635	
636	    root = find_uv_project_root(project_dir)
637	    if root:
638	        project_dir = root
639	
640	    actions: list[HealingAction] = []
641	    missing_packages: list[str] = []
642	    recommendations: list[str] = []
643	
644	    # Attempt a lightweight check: uv pip check
645	    success, stdout, stderr = await run_uv_command(
646	        ["pip", "check"], cwd=project_dir
647	    )
648	
649	    if not success:
650	        # Extract missing packages from stderr
651	        pattern = re.compile(
652	            r"No module named ['\"]?(\w+)['\"]?",
653	            re.IGNORECASE,
654	        )
655	        found = pattern.findall(stderr)
656	        missing_packages.extend(found)
657	
658	        # Also try generic package name extraction (e.g., "requires <package>")
659	        req_pattern = re.compile(
660	            r"requires\s+(\w+)[,;\s]",
661	            re.IGNORECASE,
662	        )
663	        missing_packages.extend(req_pattern.findall(stderr))
664	
665	        actions.append(
666	            HealingAction(
667	                action="pip_check",
668	                status="failed",
669	                error=stderr,
670	            )
671	        )
672	    else:
673	        actions.append(
674	            HealingAction(
675	                action="pip_check",
676	                status="success",
677	                output=stdout,
678	            )
679	        )
680	
681	    # Attempt sync to heal missing packages
682	    if missing_packages:
683	        unique_packages = list(set(missing_packages))
684	        for pkg in unique_packages:
685	            recommendations.append(
686	                f"Package '{pkg}' is missing. Suggested fix: uv add {pkg}"
687	            )
688	        sync_success, sync_out, sync_err = await run_uv_command(
689	            ["sync"], cwd=project_dir
690	        )
691	        actions.append(
692	            HealingAction(
693	                action="sync",
694	                status="success" if sync_success else "failed",
695	                output=sync_out if sync_success else None,
696	                error=sync_err if not sync_success else None,
697	            )
698	        )
699	        if sync_success:
700	            recommendations.append("Environment synced successfully.")
701	        else:
702	            recommendations.append(
703	                "Sync failed. Consider running uv_repair_environment(auto_fix=True)."
704	            )
705	    else:
706	        recommendations.append("No missing packages detected. Environment appears healthy.")
707	
708	    return SelfHealingDiagnostics(
709	        success=all(a.status == "success" for a in actions),
710	        actions=actions,
711	        missing_packages=list(set(missing_packages)),
712	        recommendations=recommendations,
713	    )
714	
715	
