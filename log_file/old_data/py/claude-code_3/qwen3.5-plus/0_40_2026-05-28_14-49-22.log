1	FROM --platform=$BUILDPLATFORM python:3.11-slim AS base
2	
3	# Set environment variables to prevent buffering issues with logs
4	ENV PYTHONUNBUFFERED=1
5	ENV PYTHONDONTWRITEBYTECODE=1
6	
7	# Set the working directory in the container
8	WORKDIR /app
9	
10	# Install curl (needed for the container health‑check) and a *pinned* version of
11	# uv.
12	RUN apt-get update \
13	    && apt-get install -y --no-install-recommends curl \
14	    # Install uv
15	    && pip install --no-cache-dir uv==0.6.14 \
16	    # Verify installation
17	    && uv --version \
18	    && apt-get clean \
19	    && rm -rf /var/lib/apt/lists/*
20	
21	# --- Build Stage ---
22	# Use a build stage to install dependencies
23	# This helps leverage Docker layer caching
24	FROM base AS builder
25	
26	# Create dist directory for local wheel installation if needed
27	RUN mkdir -p /dist/
28	
29	# Copy the dist directory contents (containing local wheels)
30	# This step allows installing local packages like graphiti-core
31	# Ensure 'dist' exists in your project root and contains necessary wheels before building
32	# COPY dist/* /dist/ # Commented out as it's not needed when using published graphiti-core
33	
34	# Copy project configuration
35	COPY pyproject.toml uv.lock* ./
36	
37	# Install dependencies using uv sync (faster than pip install)
38	# This installs dependencies specified in pyproject.toml based on uv.lock
39	# Add --system to allow installation into the container's Python environment
40	RUN uv pip sync uv.lock --system
41	
42	# If you want to install the project itself (rawr-mcp-graphiti), uncomment the line below
43	# This makes 'constants.py', 'graphiti_mcp_server.py', etc., available as installed modules
44	# RUN uv pip install . --no-deps --system
45	
46	
47	# --- Final Stage ---
48	# Start from the base image again for a cleaner final image
49	FROM base
50	
51	# Copy installed dependencies from the builder stage
52	COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
53	# Binaries installed with the dependencies (if any) live in /usr/local/bin which is
54	# already present in the base stage, so no extra COPY step is required.
55	
56	# Copy application code
57	COPY graphiti_mcp_server.py ./
58	COPY constants.py ./
59	COPY entities/ ./entities/
60	COPY entrypoint.sh .
61	
62	# Make entrypoint script executable
63	RUN chmod +x ./entrypoint.sh
64	
65	# --------------------------------------------------
66	# Security hardening – drop root privileges
67	# --------------------------------------------------
68	# 1. Create an unprivileged user *after* all packages are installed.
69	# 2. Give it ownership over /app so the process can write logs, etc.
70	# 3. Switch to that user for the remainder of the image lifetime.
71	
72	RUN useradd --create-home --shell /usr/sbin/nologin --uid 1000 graphiti \
73	    && chown -R graphiti:graphiti /app
74	
75	USER graphiti
76	WORKDIR /app
77	
78	# Expose the default MCP port (adjust if needed)
79	EXPOSE 8000
80	
81	# --------------------------------------------------
82	# Entrypoint / default command
83	# --------------------------------------------------
84	
85	ENTRYPOINT ["./entrypoint.sh"]
86	
87	# Default command can be overridden (e.g., to specify group_id)
88	# Example: docker run <image> --group-id my_project
89	CMD ["--transport", "sse"]
90	

