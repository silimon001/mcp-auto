1344	@mcp.tool()
1345	async def uv_publish_project(
1346	    project_path: str | None = None,
1347	    files: list[str] | None = None,
1348	    dry_run: bool = False,
1349	    token: str | None = None,
1350	) -> PublishResult:
1351	    """
1352	    Publish distributions (wheel / sdist) to a package index.
1353	
1354	    Args:
1355	        project_path: Project directory (defaults to current directory).
1356	        files: Explicit files to publish (defaults to dist/*).
1357	        dry_run: Perform a dry run without uploading.
1358	        token: API token for the index (optional, for security consider env vars).
1359	
1360	    Returns:
1361	        PublishResult with upload status.
1362	    """
1363	    from pathlib import Path
1364	    from .utils import run_uv_command, find_uv_project_root
1365	
1366	    project_dir = Path(project_path).resolve() if project_path else Path.cwd().resolve()
1367	    root = find_uv_project_root(project_dir)
1368	    if root:
1369	        project_dir = root
1370	
1371	    cmd: list[str] = ["publish"]
1372	    if dry_run:
1373	        cmd.append("--dry-run")
1374	    if token:
1375	        cmd.extend(["--token", token])
