330	def _get_library_info():
331	    client = _get_zotero_client()
332	    data: dict[str, Any] = {}
333	    data['info'] = \
334	    """ This is a primary Zotero library through the locally running Zotero library. 
335	    
336	    Additionally the user can have access to further groups that behave like new libraries. 
337	    Currently those can not be queried through this tool.
338	
339	    The recent and collections that are provided are limited to 10 items each, to give you a feeling what you can request.
340	    """
341	    data['number_of_entries'] = client.count_items()
342	    return data
