98	async def uv_diagnose_environment(project_path: str | None = None) -> DiagnosticReport:
99	    """
100	    Analyze the health of a Python environment and project.
101	
102	    This tool checks:
103	    - uv installation and version
104	    - Project structure (pyproject.toml, requirements.txt)
105	    - Virtual environment status
106	    - Dependency health and conflicts
107	    - Python version compatibility
108	    - Lockfile presence
109	
110	    Args:
111	        project_path: Path to the project directory (defaults to current directory)
112	
113	    Returns:
114	        DiagnosticReport with comprehensive diagnostic report
115	    """
116	    project_dir = Path(project_path).resolve() if project_path else Path.cwd().resolve()
117	
118	    if not project_dir.exists():
119	        return DiagnosticReport(
120	            project_dir=str(project_path or "."),
121	            overall_health="critical",
122	            critical_issues=[f"Project directory does not exist: {project_path}"],
123	        )
124	
125	    # Generate diagnostic report
126	    report = await generate_diagnostic_report(project_dir)
127	    report.timestamp = datetime.now().isoformat()
128	
129	    # Add summary
130	    issues_count = 0
131	    warnings_count = 0
132	
133	    if report.structure:
134	        issues_count += len(report.structure.issues)
135	        warnings_count += len(report.structure.warnings)
136	
137	    if report.dependencies:
138	        issues_count += len(report.dependencies.issues)
139	        warnings_count += len(report.dependencies.warnings)
140	
141	    if report.python:
142	        issues_count += len(report.python.issues)
143	        warnings_count += len(report.python.warnings)
144	
145	    report.summary = DiagnosticReportSummary(
146	        overall_health=report.overall_health,
147	        issues_count=issues_count,
148	        warnings_count=warnings_count,
149	    )
150	
151	    return report
152	
