81	@mcp.tool()
82	def image_to_video(
83	    prompt: str,
84	    image_base64: str,
85	    duration: str = "5",
86	    ratio: str = "16:9",
87	    model: str = "doubao-seedance-1-0-lite-i2v-250428"
88	) -> Dict[str, Any]:
89	    """
90	    图生视频功能 - 根据图片和文本描述生成视频
91	    
92	    Args:
93	        prompt: 视频描述提示词
94	        image_base64: 图片的base64编码字符串
95	        duration: 视频时长（秒）
96	        ratio: 视频比例，如"16:9"
97	        model: 使用的模型名称
98	    
99	    Returns:
100	        包含视频URL或错误信息的字典
101	    """
102	    try:
103	        # 构造图片数据URL
104	        image_data_url = f"data:image/jpeg;base64,{image_base64}"
105	        
106	        # 自动添加参数到提示词
107	        if ratio and "--ratio" not in prompt:
108	            prompt += f" --ratio adaptive"
109	        if duration and "--duration" not in prompt and "--dur" not in prompt:
110	            prompt += f" --duration {duration}"
111	        
112	        headers = {
113	            "Content-Type": "application/json",
114	            "Authorization": f"Bearer {API_KEY}"
115	        }
116	        
117	        # 构造请求内容
118	        content = [
119	            {"type": "text", "text": prompt},
120	            {"type": "image_url", "image_url": {"url": image_data_url}}
121	        ]
122	        
123	        request_data = {
124	            "model": model,
125	            "content": content
126	        }
127	        
128	        # 创建视频生成任务
129	        response = requests.post(
130	            f"{BASE_URL}/contents/generations/tasks",
131	            headers=headers,
132	            json=request_data
133	        )
134	        
135	        if response.status_code != 200:
136	            return {
137	                "success": False,
138	                "error": f"创建视频生成任务失败，状态码: {response.status_code}, 信息: {response.text}"
139	            }
140	        
141	        task_id = response.json().get("id")
142	        if not task_id:
143	            return {
144	                "success": False,
145	                "error": "未获取到任务ID"
146	            }
147	        
148	        # 轮询等待任务完成
149	        max_retries = 60
150	        for retry in range(max_retries):
151	            time.sleep(5)
152	            
153	            task_resp = requests.get(
154	                f"{BASE_URL}/contents/generations/tasks/{task_id}",
155	                headers=headers
156	            )
157	            
158	            if task_resp.status_code != 200:
159	                return {
160	                    "success": False,
161	                    "error": f"查询任务失败，状态码: {task_resp.status_code}"
162	                }
163	            
164	            task_data = task_resp.json()
165	            status = task_data.get("status")
166	            
167	            if status == "succeeded":
168	                video_url = task_data.get("content", {}).get("video_url")
169	                return {
170	                    "success": True,
171	                    "video_url": video_url,
172	                    "message": "视频生成成功",
173	                    "task_id": task_id
174	                }
175	            elif status in ("failed", "canceled"):
176	                return {
177	                    "success": False,
178	                    "error": f"任务{status}"
179	                }
180	        
181	        return {
182	            "success": False,
183	            "error": "视频生成超时"
184	        }
185	        
186	    except Exception as e:
187	        return {
188	            "success": False,
189	            "error": f"生成视频时出错: {str(e)}"
190	        }
