169	        params = dict(
170	            host=self.configuration.get("host", ""),
171	            user=self.configuration.get("user", ""),
172	            passwd=self.configuration.get("passwd", ""),
173	            db=self.configuration["db"],
174	            port=self.configuration.get("port", 3306),
175	            charset=self.configuration.get("charset", "utf8"),
176	            use_unicode=self.configuration.get("use_unicode", True),
177	            connect_timeout=self.configuration.get("connect_timeout", 60),
178	            autocommit=self.configuration.get("autocommit", True),
179	        )
180	
181	        ssl_options = self._get_ssl_parameters()
182	
183	        if ssl_options:
184	            params["ssl"] = ssl_options
185	
186	        connection = MySQLdb.connect(**params)
187	
188	        return connection
189	
190	    def _get_tables(self, schema: Dict[str, Dict[str, Any]]) -> List[Dict[str, Any]]:
191	        query = """
192	        SELECT col.table_schema as table_schema,
193	               col.table_name as table_name,
194	               col.column_name as column_name
195	        FROM `information_schema`.`columns` col
196	        WHERE LOWER(col.table_schema) NOT IN ('information_schema', 'performance_schema', 'mysql', 'sys');
197	        """
198	
199	        results, error = self.run_query(query, None)
200	
201	        if error is not None:
202	            self._handle_run_query_error(error)
203	
204	        if results is None:
205	            return []
206	
207	        results_dict = cast(Dict[str, List[Dict[str, Any]]], json.loads(results))
208	        for row in results_dict["rows"]:
209	            if cast(str, row["table_schema"]) != self.configuration["db"]:
210	                table_name = "{}.{}".format(
211	                    cast(str, row["table_schema"]),
212	                    cast(str, row["table_name"])
213	                )
214	            else:
215	                table_name = cast(str, row["table_name"])
216	
217	            if table_name not in schema:
218	                schema[table_name] = {"name": table_name, "columns": []}
219	
220	            schema[table_name]["columns"].append(cast(str, row["column_name"]))
221	
222	        return list(schema.values())
223	
224	    def run_query(self, query: str, user: Optional[str]) -> Tuple[Optional[str], Optional[str]]:
225	        if self._ssh_details:
226	            if not all(self._ssh_details.get(k) for k in ["ssh_host", "ssh_username"]):
227	                raise KeyError("Missing required SSH configuration. Need ssh_host and ssh_username.")
228	            try:
229	                tunnel = with_ssh_tunnel(self, self._ssh_details)
230	                tunnel.__enter__()
231	                try:
232	                    result = self._run_query_impl(query, user)
233	                    tunnel.__exit__(None, None, None)
234	                    return result
235	                except Exception as e:
236	                    tunnel.__exit__(type(e), e, None)
237	                    raise
238	            except Exception as e:
239	                raise Exception(f"SSH tunnel: {str(e)}")
240	        return self._run_query_impl(query, user)
241	
242	    def _run_query_impl(self, query: str, user: Optional[str]) -> Tuple[Optional[str], Optional[str]]:
243	        connection = None
244	        cursor = None
245	
246	        try:
247	            connection = self._connection()
248	            cursor = connection.cursor()
249	            cursor.execute(query)
250	
251	            if cursor.description is not None:
252	                columns = self.fetch_columns([(i[0], types_map.get(i[1], None)) for i in cursor.description])
253	                rows = [dict(zip((c['name'] for c in columns), row)) for row in cursor]
254	
255	                data = {'columns': columns, 'rows': rows}
256	                error = None
257	                json_data = json_dumps(data)
258	            else:
259	                error = None
260	                json_data = json_dumps({'columns': [], 'rows': []})
261	        except MySQLdb.Error as e:
262	            json_data = None
263	            error = str(e)
264	        finally:
265	            if cursor:
266	                cursor.close()
267	            if connection:
268	                connection.close()
269	
270	        return json_data, error
271	
272	    def _get_ssl_parameters(self):
273	        if not self.configuration.get("use_ssl"):
274	            return None
275	
276	        ssl_params = {}
277	
278	        if self.configuration.get("use_ssl"):
279	            config_map = {"ssl_mode": "preferred", "ssl_cacert": "ca", "ssl_cert": "cert", "ssl_key": "key"}
280	            for key, cfg in config_map.items():
281	                val = self.configuration.get(key)
282	                if val:
283	                    ssl_params[cfg] = val
284	
285	        return ssl_params
286	
287	    def _cancel(self, thread_id):
288	        connection = None
289	        cursor = None
290	        error = None
291	
292	        try:
293	            connection = self._connection()
294	            cursor = connection.cursor()
295	            query = "KILL %d" % (thread_id)
296	            logging.debug(query)
297	            cursor.execute(query)
298	        except MySQLdb.Error as e:
299	            if cursor:
300	                cursor.close()
301	            error = e.args[1]
302	        finally:
303	            if connection:
304	                connection.close()
305	
306	        return error
307	
308	
309	class RDSMySQL(Mysql):
310	    @classmethod
311	    def name(cls):
312	        return "MySQL (Amazon RDS)"
313	
314	    @classmethod
315	    def type(cls):
316	        return "rds_mysql"
317	
318	    @classmethod
319	    def configuration_schema(cls):
320	        return {
321	            "type": "object",
322	            "properties": {
323	                "host": {"type": "string"},
324	                "user": {"type": "string"},
325	                "passwd": {"type": "string", "title": "Password"},
326	                "db": {"type": "string", "title": "Database name"},
327	                "port": {"type": "number", "default": 3306},
328	                "use_ssl": {"type": "boolean", "title": "Use SSL"},
329	            },
330	            "order": ["host", "port", "user", "passwd", "db"],
331	            "required": ["db", "user", "passwd", "host"],
332	            "secret": ["passwd"],
333	        }
334	
335	    def _get_ssl_parameters(self):
336	        if self.configuration.get("use_ssl"):
337	            ca_path = os.path.join(os.path.dirname(__file__), "./files/rds-combined-ca-bundle.pem")
338	            return {"ca": ca_path}
339	
340	        return None
341	
342	
343	register(Mysql)
344	register(RDSMySQL)
