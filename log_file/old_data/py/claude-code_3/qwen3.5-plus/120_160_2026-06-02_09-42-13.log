225	@mcp.resource("resource://schema/{database_id}")
226	def get_schema(database_id: Optional[str] = None) -> str:
227	    """Get the database schemas for all databases or a specific database
228	    
229	    Args:
230	        database_id: Optional database ID to get schema for. If None, get schemas for all databases.
231	    """
232	    try:
233	        schemas = []
234	        
235	        if database_id is not None and database_id != "all":
236	            # Get schema for specific database
237	            if database_id not in config_map:
238	                return f"Error: Invalid database ID {database_id}"
239	            
240	            db_config = config_map[database_id]
