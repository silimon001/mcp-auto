479	@mcp.tool()
480	def get_translation_help() -> str:
481	    """
482	    Get help information about using the PowerPoint translator.
483	    
484	    Returns:
485	        Help text with usage examples
486	    """
487	    return """📖 PowerPoint Translator Help
488	
489	🎯 Main Functions:
490	• translate_powerpoint() - Translate entire PowerPoint presentation
491	• translate_specific_slides() - Translate only specific slides
492	• batch_translate_powerpoint() - Translate all PowerPoint files in a folder
493	• get_slide_info() - Get presentation overview and slide previews
494	• get_slide_preview() - Get detailed preview of a specific slide
495	
496	📋 Required Parameters:
497	• input_file: Path to your .pptx file
498	• input_folder: Path to folder containing .pptx files (for batch)
499	
500	🔧 Optional Parameters:
501	• target_language: Language code (default: 'ko' for Korean)
502	• output_file/output_folder: Output path (auto-generated if not specified)
503	• model_id: Bedrock model (default: Claude Sonnet 4.6)
504	• enable_polishing: Natural translation vs literal (default: true)
505	• recursive: Process subfolders (default: true, for batch only)
506	• workers: Parallel workers (default: 4, for batch only)
507	
508	💡 Usage Examples:
509	
510	1. Get presentation information:
511	   get_slide_info("presentation.pptx")
512	
513	2. Preview specific slide:
514	   get_slide_preview("presentation.pptx", 3)
515	
516	3. Translate entire presentation:
517	   translate_powerpoint("presentation.pptx")
518	
519	4. Translate specific slides (individual):
520	   translate_specific_slides("slides.pptx", "1,3,5")
521	
522	5. Translate slide range:
523	   translate_specific_slides("slides.pptx", "2-4")
524	
525	6. Translate mixed (individual + range):
526	   translate_specific_slides("slides.pptx", "1,3-5,8")
527	
528	7. Batch translate folder (includes subfolders by default):
529	   batch_translate_powerpoint("presentations/")
530	
531	8. Batch translate top level only (disable recursion):
532	   batch_translate_powerpoint("presentations/", recursive=False)
533	
534	9. Batch translate to Spanish with custom output:
535	   batch_translate_powerpoint("input/", "es", "output/")
536	
537	10. Translate to Spanish with custom output:
538	    translate_specific_slides("slides.pptx", "1-3", "es", "spanish_slides.pptx")
539	
540	11. Literal translation (no polishing):
541	    translate_specific_slides("doc.pptx", "2,4", "ja", enable_polishing=False)
542	
543	🌐 Get supported languages:
544	   list_supported_languages()
545	
546	🤖 Get supported models:
547	   list_supported_models()
548	
549	⚙️ Configuration:
550	• AWS credentials must be configured (aws configure)
551	• Bedrock access required in your AWS account
552	• Supported file format: .pptx only
553	
554	📄 Slide Number Format:
555	• Individual slides: "1,3,5"
556	• Ranges: "2-4" (translates slides 2, 3, 4)
557	• Mixed: "1,3-5,8" (translates slides 1, 3, 4, 5, 8)
558	
559	📁 Batch Processing:
560	• Non-recursive: Only files in the specified folder
561	• Recursive: Files in all subfolders (like reInvent-2025/session1/, session2/, etc.)
562	• Preserves folder structure in output
563	• Parallel processing for efficiency"""
564	
565	
566	@mcp.tool()
567	def batch_translate_powerpoint(
568	    input_folder: str,
569	    target_language: str = Config.DEFAULT_TARGET_LANGUAGE,
570	    output_folder: Optional[str] = None,
571	    model_id: str = Config.DEFAULT_MODEL_ID,
572	    enable_polishing: bool = True,
573	    recursive: bool = True,
574	    workers: int = 4,
575	    glossary_file: Optional[str] = None,
576	    cache_backend: str = "sqlite",
577	    cache_path: Optional[str] = None,
578	    dry_run: bool = False,
579	    translate_charts: bool = True,
580	    source_language: Optional[str] = None,
581	    auto_detect_source: bool = True,
582	) -> str:
583	    """
584	    Translate all PowerPoint files in a folder (with optional recursive processing).
585	
586	    Args:
587	        input_folder: Path to the input folder containing PowerPoint files
588	        target_language: Target language code (e.g., 'ko', 'ja', 'es', 'fr', 'de')
589	        output_folder: Path to save translated files (optional, auto-generated if not provided)
590	        model_id: AWS Bedrock model ID to use for translation
591	        enable_polishing: Enable natural language polishing for more fluent translation
592	        recursive: Process subfolders recursively (default: True — set to False to limit to top level)
593	        workers: Number of parallel workers (default: 4)
594	        glossary_file: Path to a glossary YAML file (defaults to ./glossary.yaml if present)
595	        cache_backend: Translation cache backend: 'sqlite' (default), 'memory', or 'none'
596	        cache_path: SQLite cache path (ignored for memory/none backends)
597	        dry_run: If True, estimate aggregate cost without translating
598	        translate_charts: If True, translate chart titles/axes/categories/series
599	
600	    Returns:
