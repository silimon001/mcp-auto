366	    async def test_connection(self) -> bool:
367	        """Test database connection"""
368	        try:
369	            if self.database_type == "mongodb":
370	                if self.mongo_client is None:
371	                    return False
372	                await self.mongo_client.admin.command("ping")
373	                return True
374	
375	            async with self.engine.begin() as conn:
