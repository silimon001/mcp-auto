354	@mcp.tool()
355	def get_slide_info(input_file: str) -> str:
356	    """
357	    Get information about slides in a PowerPoint presentation.
358	    
359	    Args:
360	        input_file: Path to the PowerPoint file (.pptx)
361	    
362	    Returns:
363	        Information about the presentation including slide count and preview of each slide
364	    """
365	    try:
366	        # Validate input file using helper function
367	        input_path, error_msg = validate_input_path(input_file)
368	        if error_msg:
369	            return error_msg
370	        
371	        # Create translator to access slide info methods
372	        translator = PowerPointTranslator()
373	        slide_count = translator.get_slide_count(str(input_path))
374	        
375	        info_text = f"""📊 PowerPoint Presentation Information
376	
377	📁 File: {input_path}
378	📄 Total slides: {slide_count}
379	
380	📋 Slide previews:
381	"""
382	        
383	        # Get preview for each slide (limit to first 10 slides for readability)
384	        max_preview_slides = min(slide_count, 10)
385	        for i in range(1, max_preview_slides + 1):
386	            try:
387	                preview = translator.get_slide_preview(str(input_path), i, max_chars=150)
388	                info_text += f"\n🔸 Slide {i}: {preview}"
389	            except Exception as e:
390	                info_text += f"\n🔸 Slide {i}: [Error getting preview: {str(e)}]"
391	        
392	        if slide_count > 10:
393	            info_text += f"\n\n... and {slide_count - 10} more slides"
394	        
395	        info_text += f"""
396	
397	💡 Usage examples:
398	• Translate all slides: translate_powerpoint("{input_file}")
399	• Translate specific slides: translate_specific_slides("{input_file}", "1,3,5")
400	• Translate slide range: translate_specific_slides("{input_file}", "2-4")"""
401	        
402	        return info_text
403	        
404	    except Exception as e:
405	        logger.error(f"Failed to get slide info: {str(e)}")
406	        return f"❌ Failed to get slide info: {str(e)}"
