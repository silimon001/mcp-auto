1	[project]
2	name = "gemini-mcp"
3	version = "0.1.0"
4	description = "MCP server providing integration with Google's Gemini CLI - an unofficial tool"
5	readme = "README.md"
6	requires-python = ">=3.10"
7	license = {text = "MIT"}
8	authors = [
9	    {name = "Diversio Team", email = "tech@diversio.com"},
10	]
11	keywords = ["mcp", "gemini", "ai", "research", "cli", "llm", "tool"]
12	classifiers = [
13	    "Development Status :: 3 - Alpha",
14	    "Intended Audience :: Developers",
15	    "License :: OSI Approved :: MIT License",
16	    "Programming Language :: Python :: 3",
17	    "Programming Language :: Python :: 3.10",
18	    "Programming Language :: Python :: 3.11",
19	    "Programming Language :: Python :: 3.12",
20	    "Programming Language :: Python :: 3.13",
21	]
22	
23	dependencies = [
24	    "mcp>=0.1.0",
25	    "pydantic>=2.0.0",
26	    "click>=8.1.0",
27	    "rich>=13.0.0",
28	    "aiofiles>=23.0.0",
29	]
30	
31	[project.optional-dependencies]
32	dev = [
33	    "pytest>=8.0.0",
34	    "pytest-asyncio>=0.23.0",
35	    "pytest-cov>=4.0.0",
36	    "ruff>=0.4.0",
37	    "mypy>=1.10.0",
38	    "safety>=3.0.0",
39	    "pre-commit>=3.0.0",
40	]
41	
42	[project.urls]
43	Homepage = "https://github.com/DiversioTeam/gemini-cli-mcp"
44	Repository = "https://github.com/DiversioTeam/gemini-cli-mcp"
45	Issues = "https://github.com/DiversioTeam/gemini-cli-mcp/issues"
46	Documentation = "https://github.com/DiversioTeam/gemini-cli-mcp#readme"
47	
48	[project.scripts]
49	gemini-mcp = "gemini_mcp.__main__:main"
50	
51	[build-system]
52	requires = ["hatchling"]
53	build-backend = "hatchling.build"
54	
55	[tool.hatch.build.targets.wheel]
56	packages = ["src/gemini_mcp"]
57	
58	[tool.ruff]
59	line-length = 100
60	target-version = "py310"
61	
62	[tool.ruff.lint]
63	select = [
64	    "E",   # pycodestyle errors
65	    "W",   # pycodestyle warnings
66	    "F",   # pyflakes
67	    "I",   # isort
68	    "N",   # pep8-naming
69	    "B",   # flake8-bugbear
70	    "S",   # flake8-bandit (security)
71	    "RUF", # ruff-specific rules
72	    "SIM", # flake8-simplify
73	    "TCH", # flake8-type-checking
74	    "UP",  # pyupgrade
75	    "PT",  # flake8-pytest-style
76	]
77	ignore = [
78	    "E501",  # line too long (handled by formatter)
79	    "B008",  # do not perform function calls in argument defaults
80	]
81	
82	
83	[tool.ruff.lint.per-file-ignores]
84	"tests/*" = ["S101"]  # Allow assert in tests
85	"src/gemini_mcp/__main__.py" = [
86	    "S404",  # subprocess import - needed for CLI diagnostics
87	    "S603",  # subprocess without shell=True - safe with hardcoded args
88	    "S607",  # partial path - gemini CLI must be in PATH
89	]
90	
91	[tool.mypy]
92	python_version = "3.10"
93	warn_return_any = true
94	warn_unused_configs = true
95	disallow_untyped_defs = true
96	disallow_incomplete_defs = true
97	check_untyped_defs = true
98	disallow_untyped_decorators = true
99	no_implicit_optional = true
100	warn_redundant_casts = true
101	warn_unused_ignores = true
102	warn_no_return = true
103	follow_imports = "normal"
104	ignore_missing_imports = true
105	
106	[[tool.mypy.overrides]]
107	module = "tests.*"
108	disallow_untyped_defs = false
109	disallow_untyped_decorators = false
110	
111	[tool.pytest.ini_options]
112	testpaths = ["tests"]
113	addopts = [
114	    "-ra",
115	    "--strict-markers",
116	    "--cov=src/gemini_mcp",
117	    "--cov-branch",
118	    "--cov-report=term-missing:skip-covered",
119	    "--cov-fail-under=80",
120	]
121	asyncio_mode = "auto"
122	
123	[tool.coverage.run]
124	source = ["src/gemini_mcp"]
125	omit = ["*/tests/*", "*/__main__.py"]
126	
