1	"""Entry point for the Gemini MCP server."""
2	
3	import asyncio
4	import logging
5	import sys
6	
7	import click
8	from rich.console import Console
9	from rich.logging import RichHandler
10	
11	from .server import GeminiMCPServer
12	
13	console = Console()
14	
15	
16	def setup_logging(debug: bool = False) -> None:
17	    """Configure logging with rich output."""
18	    level = logging.DEBUG if debug else logging.INFO
19	
20	    # When running as MCP server, redirect all logs to stderr
21	    stderr_console = Console(stderr=True)
22	
23	    logging.basicConfig(
24	        level=level,
25	        format="%(message)s",
26	        handlers=[RichHandler(console=stderr_console, rich_tracebacks=True)],
27	    )
28	
29	
30	@click.group(invoke_without_command=True)
31	@click.option("--debug", is_flag=True, help="Enable debug logging")
32	@click.pass_context
33	def cli(ctx: click.Context, debug: bool) -> None:
34	    """Gemini MCP Server - AI research assistant via Gemini CLI."""
35	    setup_logging(debug)
36	
37	    if ctx.invoked_subcommand is None:
38	        # Default behavior: run the server
39	        ctx.invoke(serve, debug=debug)
40	
41	
42	@cli.command()
43	@click.option("--debug", is_flag=True, help="Enable debug logging")
44	def serve(debug: bool) -> None:
45	    """Run the MCP server."""
46	    stderr_console = Console(stderr=True)
47	
48	    try:
49	        server = GeminiMCPServer()
50	
51	        stderr_console.print("[green]Starting Gemini MCP Server...[/green]")
52	        asyncio.run(server.run())
53	
54	    except RuntimeError as e:
55	        if "Gemini CLI not found" in str(e):
56	            stderr_console.print(f"[red]Error:[/red] {e}")
57	            stderr_console.print("\nPlease ensure Gemini CLI is installed and in your PATH.")
58	            stderr_console.print("You can check with: [cyan]which gemini[/cyan]")
59	        else:
60	            stderr_console.print(f"[red]Runtime error:[/red] {e}")
61	        sys.exit(1)
62	    except KeyboardInterrupt:
63	        stderr_console.print("\n[yellow]Server stopped by user[/yellow]")
64	        sys.exit(0)
65	    except Exception as e:
66	        stderr_console.print(f"[red]Unexpected error:[/red] {e}")
67	        if debug:
68	            stderr_console.print_exception()
69	        sys.exit(1)
70	
71	
