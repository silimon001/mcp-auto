22	// Determine Python command based on OS
23	const pythonCmd = process.platform === 'win32' ? 'python' : 'python3';
24	
25	// Check if uv is installed, otherwise use pip
26	const checkCommand = (cmd) => {
27	    try {
28	        const result = spawn.sync(cmd, ['--version'], { stdio: 'pipe' });
29	        return result.status === 0;
30	    } catch (e) {
31	        return false;
32	    }
33	};
34	
35	const hasUv = checkCommand('uv');
36	
37	// Function to install dependencies silently
38	const installDependencies = () => {
39	    const deps = [
40	        'fastmcp',
41	        'openpyxl',
42	        'pandas',
43	        'numpy',
44	        'xlsxwriter',
45	        'xlrd',
46	        'xlwt',
47	        'matplotlib'
48	    ];
49	    
50	    if (hasUv) {
51	        // Use uv for faster installation with --system flag
52	        const result = spawn.sync('uv', ['pip', 'install', '--system', '--quiet', ...deps], {
53	            stdio: 'ignore'
54	        });
55	        return result.status === 0;
56	    } else {
57	        // Fallback to pip
58	        const pipCmd = process.platform === 'win32' ? 'pip' : 'pip3';
59	        const result = spawn.sync(pipCmd, ['install', '--quiet', ...deps], {
60	            stdio: 'ignore'
61	        });
62	        return result.status === 0;
63	    }
64	};
65	
66	// Check if this is the first run by checking for a marker file
67	const markerFile = path.join(os.homedir(), '.excel-mcp-server-installed-v3');
68	
69	if (!fs.existsSync(markerFile)) {
70	    // Install dependencies silently
71	    if (installDependencies()) {
72	        // Create marker file
73	        fs.writeFileSync(markerFile, new Date().toISOString());
74	    }
75	}
76	
77	// Run the Python script directly without extra logging
78	const args = process.argv.slice(2);
79	
80	if (hasUv) {
81	    // Use uv run for better dependency management (without --system flag)
82	    const uvArgs = [
83	        'run',
84	        '--with', 'matplotlib',
85	        '--with', 'mcp[cli]',
86	        '--with', 'numpy',
87	        '--with', 'openpyxl',
88	        '--with', 'pandas',
89	        '--with', 'xlsxwriter',
90	        '--with', 'xlrd',
91	        '--with', 'xlwt',
92	        'mcp',
93	        'run',
94	        pythonScript,
95	        ...args
96	    ];
97	    
98	    const child = spawn('uv', uvArgs, {
99	        stdio: 'inherit'
100	    });
101	    
102	    child.on('error', (err) => {
103	        console.error('Failed to start server:', err);
104	        process.exit(1);
105	    });
106	    
107	    child.on('exit', (code) => {
108	        process.exit(code || 0);
109	    });
110	} else {
111	    // Fallback to direct Python execution
112	    const child = spawn(pythonCmd, [pythonScript, ...args], {
113	        stdio: 'inherit'
