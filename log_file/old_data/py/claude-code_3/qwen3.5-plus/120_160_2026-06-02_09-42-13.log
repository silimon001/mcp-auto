813	                    
814	        elif hasattr(mcp, 'tools') and callable(getattr(mcp, 'tools', None)):
815	            # Tools accessed as a method
816	            for name, tool_info in mcp.tools().items():
817	                try:
818	                    tool_data = {
819	                        "name": name,
820	                        "description": tool_info.get("description", "No description available"),
