550	@mcp.tool()
551	def get_table_sample(ctx: Context, table_name: str, db_id: str, limit: int = 10) -> str:
552	    """Get a sample of data from a table"""
553	    try:
554	        db_context: DbContext = ctx.request_context.lifespan_context
