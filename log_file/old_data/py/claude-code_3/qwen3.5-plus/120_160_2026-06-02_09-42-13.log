16	
17	GIMP_HOST = 'localhost'
18	GIMP_PORT = 9877
19	
20	class GimpConnection:
21	    def __init__(self, host=GIMP_HOST, port=GIMP_PORT):
22	        self.host = host
23	        self.port = port
24	        self.sock = None
25	
26	    def connect(self):
27	        if self.sock:
28	            return
29	        try:
30	            self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
31	            self.sock.settimeout(10)
32	            self.sock.connect((self.host, self.port))
33	            logger.info(f"Connected to GIMP at {self.host}:{self.port}")
34	        except Exception as e:
35	            self.sock = None
36	            logger.error(f"Failed to connect: {e}")
37	            raise ConnectionError(f"Could not connect to GIMP at {self.host}:{self.port}. Ensure the MCP Server plugin is running (Tools > Start MCP Server).")
38	
39	    def disconnect(self):
40	        if self.sock:
41	            try:
42	                self.sock.close()
43	            except Exception:
44	                pass
45	            self.sock = None
46	
47	    def send_command(self, command_type, params=None):
48	        if not self.sock:
49	            self.connect()
50	        command = {"type": command_type, "params": params or {"args": []}}

