279	@mcp.tool()
280	def get_query_history(ctx: Context) -> str:
281	    """Get the recent query history"""
282	    db_context = ctx.request_context.lifespan_context
283	    
284	    if not db_context.query_history:
285	        return "No query history available"
286	    
287	    result = "Query History:\n"
288	    for entry in db_context.query_history:
289	        if isinstance(entry, str):
290	            result += f"- {entry}\n"
291	        else:
292	            result += f"- {entry['query']} (Database: {entry['db_name']})\n"
293	    
294	    return result
295	
296	@mcp.tool()
297	def list_databases(ctx: Context) -> str:
298	    """List all available database connections"""
299	    db_context: DbContext = ctx.request_context.lifespan_context
300	    
301	    if not db_context.db_configs:
302	        return "No database connections available."
303	    
304	    db_list = []
305	    for db_id, db_config in db_context.db_configs.items():
306	        db_info = f"ID: {db_id} - {db_config.description} (Type: {db_config.db_type})"
307	        
308	        # Add table count if schema is available
309	        if db_config.schema:
310	            table_count = len(db_config.schema)
311	            db_info += f" - {table_count} tables"
312	        
313	        db_list.append(db_info)
314	    
315	    return "Available databases:\n" + "\n".join(db_list)
316	
