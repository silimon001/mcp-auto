213	            'postgresql+asyncpg://',
214	            'mysql+aiomysql://',
215	            'mongodb://',
216	            'mongodb+srv://',
217	        ]
218	        if not any(database_url.startswith(db_type) for db_type in supported_types):
219	            return f"ERROR: Unsupported database URL format. Supported: {', '.join(supported_types)}"
220	        
221	        # Store current URL and update environment
222	        previous_url = os.getenv('DATABASE_URL', 'None')
223	        os.environ['DATABASE_URL'] = database_url
224	        
225	        # Create new database manager
226	        new_db_manager = DatabaseManager()
227	        
228	        # Test the connection
229	        connection_test = await new_db_manager.test_connection()
230	        if not connection_test:
231	            # Restore previous URL on failure
232	            if previous_url != 'None':
233	                os.environ['DATABASE_URL'] = previous_url
234	            return f"Failed to connect to database: {database_url}"
235	        
236	        # If successful, update the global manager
237	        db_manager = new_db_manager
238	        
239	        # Get table information
240	        tables = await db_manager.list_tables()
241	        table_info = [f"  - {table['table_name']} ({table['column_count']} columns)" for table in tables]
242	        
243	        response = f"Successfully connected to database!\n"
244	        response += f" Database URL: {database_url}\n"
245	        response += f" Database Type: {db_manager.database_type}\n"
246	        response += f" Available Tables ({len(tables)}):\n"
247	        response += "\n".join(table_info) if table_info else "  No tables found"
248	        
249	        logger.info(f"Dynamic database connection successful: {database_url}")
250	        return response
251	        
252	    except Exception as e:
253	        # Restore previous URL on error
254	        if 'previous_url' in locals() and previous_url != 'None':
255	            os.environ['DATABASE_URL'] = previous_url
256	        
257	        error_msg = f" Error connecting to database: {str(e)}"
258	        logger.error(f"Dynamic database connection failed: {error_msg}")
259	        return error_msg
