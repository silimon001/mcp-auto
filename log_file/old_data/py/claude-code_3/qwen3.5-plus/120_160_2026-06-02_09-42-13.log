236	        help="HTTP port (default: 8000)",
237	    )
238	    parser.add_argument(
239	        "--api-key",
240	        help="Instantly API key (overrides INSTANTLY_API_KEY env var)",
241	    )
242	    
243	    args = parser.parse_args()
244	    
245	    # Set API key if provided
