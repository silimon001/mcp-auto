639	async def cleanup_db_manager():
640	    """Cleanup database manager"""
641	    global _db_manager
642	    
643	    if _db_manager and _db_manager.engine:
644	        await _db_manager.engine.dispose()
645	    if _db_manager and _db_manager.mongo_client:
646	        _db_manager.mongo_client.close()
647	    if _db_manager:
648	        _db_manager = None

