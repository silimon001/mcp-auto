242	                schema = db_config.query_runner.get_schema()
243	                schemas.append({
244	                    "id": database_id,
245	                    "description": db_config.description,
246	                    "db_type": db_config.db_type,
247	                    "schema": schema
248	                })
249	            except Exception as e:
250	                schemas.append({
251	                    "id": database_id,
252	                    "description": db_config.description,
253	                    "db_type": db_config.db_type,
254	                    "error": str(e)
255	                })
256	        else:
257	            # Get schema for all databases
258	            for db_id, db_config in config_map.items():
259	                try:
260	                    schema = db_config.query_runner.get_schema()
261	                    schemas.append({
262	                        "id": db_id,
263	                        "description": db_config.description,
264	                        "db_type": db_config.db_type,
265	                        "schema": schema
266	                    })
267	                except Exception as e:
268	                    schemas.append({
269	                        "id": db_id,
270	                        "description": db_config.description,
271	                        "db_type": db_config.db_type,
272	                        "error": str(e)
273	                    })
274	        
275	        return json.dumps(schemas)
276	    except Exception as e:
277	        return f"Error getting schemas: {str(e)}"
