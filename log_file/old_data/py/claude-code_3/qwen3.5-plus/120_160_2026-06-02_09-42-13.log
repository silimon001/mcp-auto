230	            f"{BASE_URL}/contents/generations/tasks",
231	            headers=headers,
232	            json=request_data
233	        )
234	        
235	        if response.status_code != 200:
236	            return {
237	                "success": False,
238	                "error": f"创建视频生成任务失败，状态码: {response.status_code}, 信息: {response.text}"
