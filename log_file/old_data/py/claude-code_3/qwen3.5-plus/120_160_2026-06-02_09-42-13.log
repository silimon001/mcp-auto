162	def main():
163	    """Main CLI entry point."""
164	    parser = argparse.ArgumentParser(
165	        description="Apple Music MCP Server - Playlist management via API"
166	    )
167	    subparsers = parser.add_subparsers(dest="command", help="Commands")
168	
169	    # init
170	    init_parser = subparsers.add_parser("init", help="Initialize configuration")
171	    init_parser.add_argument("--force", action="store_true", help="Overwrite existing config")
172	
173	    # generate-token
174	    token_parser = subparsers.add_parser("generate-token", help="Generate developer token")
175	    token_parser.add_argument(
176	        "--days", type=int, default=180, help="Token validity in days (max 180)"
177	    )
178	
179	    # authorize
180	    auth_parser = subparsers.add_parser("authorize", help="Authorize with Apple Music")
181	    auth_parser.add_argument("--port", type=int, default=8765, help="Local server port")
182	
183	    # status
184	    subparsers.add_parser("status", help="Check authentication status")
185	
186	    # serve
187	    subparsers.add_parser("serve", help="Start MCP server")
188	
189	    args = parser.parse_args()
190	
191	    if args.command == "init":
192	        sys.exit(cmd_init(args))
193	    elif args.command == "generate-token":
194	        sys.exit(cmd_generate_token(args))
195	    elif args.command == "authorize":
196	        sys.exit(cmd_authorize(args))
197	    elif args.command == "status":
198	        sys.exit(cmd_status(args))
199	    elif args.command == "serve":
200	        cmd_serve(args)
201	    else:
