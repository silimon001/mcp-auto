1	"""Tool definitions for Gemini CLI integration."""
2	
3	import asyncio
4	import logging
5	import os
6	import shutil
7	import tempfile
8	from pathlib import Path
9	from typing import Any
10	
11	import aiofiles
12	from mcp.types import Tool
13	
14	logger = logging.getLogger(__name__)
15	
16	
17	# Default model constant to avoid repetition
18	DEFAULT_GEMINI_MODEL = "gemini-2.5-pro"
19	
20	
21	class GeminiTools:
22	    """Tools for interacting with Gemini CLI."""
23	
24	    def __init__(self, allowed_directories: list[str] | None = None) -> None:
25	        """Initialize the tools.
26	
27	        Args:
28	            allowed_directories: List of directories that files can be read from.
29	                                If None, defaults to current working directory.
30	        """
31	        gemini_path = shutil.which("gemini")
32	        if not gemini_path:
33	            raise RuntimeError("Gemini CLI not found in PATH")
34	        self.gemini_path: str = gemini_path
35	        logger.info(f"Found Gemini CLI at: {self.gemini_path}")
36	
37	        # Security: Set allowed directories for file access
38	        if allowed_directories is None:
39	            self.allowed_directories = [Path.cwd()]
40	        else:
41	            self.allowed_directories = [Path(d).resolve() for d in allowed_directories]
42	
43	        logger.info(f"Allowed directories: {[str(d) for d in self.allowed_directories]}")
44	
45	    def get_tool_definitions(self) -> list[Tool]:
46	        """Get the list of available tools."""
47	        return [
48	            Tool(
49	                name="gemini_prompt",
50	                description="Send a prompt to Gemini CLI and get a response",
51	                inputSchema={
52	                    "type": "object",
53	                    "properties": {
54	                        "prompt": {
55	                            "type": "string",
56	                            "description": "The prompt to send to Gemini",
57	                        },
58	                        "model": {
59	                            "type": "string",
60	                            "description": f"The model to use (default: {DEFAULT_GEMINI_MODEL})",
61	                            "default": DEFAULT_GEMINI_MODEL,
62	                        },
63	                        "context": {
64	                            "type": "string",
65	                            "description": "Additional context to prepend to the prompt",
66	                        },
67	                    },
68	                    "required": ["prompt"],
69	                },
70	            ),
71	            Tool(
72	                name="gemini_research",
73	                description="Use Gemini to research a topic with optional file context",
74	                inputSchema={
75	                    "type": "object",
76	                    "properties": {
77	                        "topic": {
78	                            "type": "string",
79	                            "description": "The research topic or question",
80	                        },
81	                        "files": {
82	                            "type": "array",
83	                            "items": {"type": "string"},
84	                            "description": "List of file paths to include as context",
85	                        },
86	                        "model": {
87	                            "type": "string",
88	                            "description": f"The model to use (default: {DEFAULT_GEMINI_MODEL})",
89	                            "default": DEFAULT_GEMINI_MODEL,
90	                        },
91	                    },
92	                    "required": ["topic"],
93	                },
94	            ),
95	            Tool(
96	                name="gemini_analyze_code",
97	                description="Use Gemini to analyze code files",
98	                inputSchema={
99	                    "type": "object",
100	                    "properties": {
101	                        "files": {
102	                            "type": "array",
103	                            "items": {"type": "string"},
104	                            "description": "List of code files to analyze",
105	                        },
106	                        "analysis_type": {
107	                            "type": "string",
108	                            "description": "Type of analysis to perform",
109	                            "enum": ["review", "explain", "optimize", "security", "test"],
110	                        },
111	                        "specific_question": {
112	                            "type": "string",
113	                            "description": "Specific question about the code",
114	                        },
115	                        "model": {
116	                            "type": "string",
117	                            "description": f"The model to use (default: {DEFAULT_GEMINI_MODEL})",
118	                            "default": DEFAULT_GEMINI_MODEL,
119	                        },
120	                    },
121	                    "required": ["files", "analysis_type"],
122	                },
123	            ),
124	            Tool(
125	                name="gemini_summarize",
126	                description="Use Gemini to summarize content from files or text",
127	                inputSchema={
128	                    "type": "object",
129	                    "properties": {
130	                        "content": {
131	                            "type": "string",
132	                            "description": "Text content to summarize",
133	                        },
134	                        "files": {
135	                            "type": "array",
136	                            "items": {"type": "string"},
137	                            "description": "Files to summarize (alternative to content)",
138	                        },
139	                        "summary_type": {
140	                            "type": "string",
141	                            "description": "Type of summary",
142	                            "enum": ["brief", "detailed", "bullet_points", "executive"],
143	                            "default": "brief",
144	                        },
145	                        "model": {
146	                            "type": "string",
147	                            "description": f"The model to use (default: {DEFAULT_GEMINI_MODEL})",
148	                            "default": DEFAULT_GEMINI_MODEL,
149	                        },
150	                    },
151	                    "required": [],
152	                },
153	            ),
154	        ]
155	
156	    async def call_tool(self, name: str, arguments: dict[str, Any]) -> str:
157	        """Call a specific tool."""
158	        if name == "gemini_prompt":
159	            return await self._gemini_prompt(arguments)
160	        elif name == "gemini_research":
161	            return await self._gemini_research(arguments)
162	        elif name == "gemini_analyze_code":
163	            return await self._gemini_analyze_code(arguments)
164	        elif name == "gemini_summarize":
165	            return await self._gemini_summarize(arguments)
166	        else:
167	            raise ValueError(f"Unknown tool: {name}")
168	
169	    def _validate_file_path(self, file_path: str) -> Path:
170	        """Validate that a file path is within allowed directories.
171	
172	        Args:
173	            file_path: Path to validate
174	
175	        Returns:
176	            Resolved Path object
177	
178	        Raises:
179	            ValueError: If path is outside allowed directories
180	        """
181	        # Resolve the path to handle .. and symlinks
182	        try:
183	            resolved_path = Path(file_path).resolve()
184	        except Exception as e:
185	            raise ValueError(f"Invalid file path: {file_path}") from e
186	
187	        # Check if the resolved path is within any allowed directory
188	        for allowed_dir in self.allowed_directories:
189	            try:
190	                resolved_path.relative_to(allowed_dir)
191	                return resolved_path
192	            except ValueError:
193	                continue
194	
195	        raise ValueError(
196	            f"File path '{file_path}' is outside allowed directories. "
197	            f"Allowed: {[str(d) for d in self.allowed_directories]}"
198	        )
199	
200	    async def _run_gemini_command(
201	        self,
202	        prompt: str,
203	        model: str = DEFAULT_GEMINI_MODEL,
204	        files: list[str] | None = None,
205	        stdin_input: str | None = None,
206	    ) -> str:
207	        """Run a Gemini CLI command and return the output.
208	
209	        Args:
210	            prompt: The prompt to send to Gemini
211	            model: The model to use
212	            files: Optional list of file paths to include
213	            stdin_input: Optional input to send via stdin
214	
215	        Returns:
216	            Command output as string
217	
218	        Raises:
219	            RuntimeError: If command execution fails
220	            ValueError: If file paths are invalid
221	        """
222	        cmd = [self.gemini_path, "-m", model, "-p", prompt]
223	
224	        temp_file_list = None
225	        try:
226	            if files:
227	                # Validate all file paths first
228	                validated_paths = []
229	                for file_path in files:
230	                    validated_path = self._validate_file_path(file_path)
231	                    if not validated_path.exists():
232	                        raise ValueError(f"File does not exist: {file_path}")
233	                    validated_paths.append(str(validated_path))
234	
235	                # Create a temporary file listing all files to include
236	                fd, temp_file_list = tempfile.mkstemp(suffix=".txt", text=True)
237	                try:
238	                    # Write file paths using regular file operations to ensure proper cleanup
239	                    with os.fdopen(fd, "w") as f:
240	                        for path in validated_paths:
241	                            f.write(f"{path}\n")
242	
243	                    # Now fd is closed, safe to read the file
244	                    async with aiofiles.open(temp_file_list) as f:
245	                        file_list_content = await f.read()
246	
247	                    # Add all files flag
248	                    cmd.append("-a")
249	                    stdin_input = stdin_input if stdin_input else file_list_content
250	                except Exception:
251	                    # fd is already closed by fdopen, no need to close it again
252	                    raise
253	
254	            logger.debug(f"Running command: {' '.join(cmd)}")
255	
256	            process = await asyncio.create_subprocess_exec(
257	                *cmd,
258	                stdin=asyncio.subprocess.PIPE,
259	                stdout=asyncio.subprocess.PIPE,
260	                stderr=asyncio.subprocess.PIPE,
261	            )
262	
263	            stdout, stderr = await process.communicate(
264	                input=stdin_input.encode() if stdin_input else None
265	            )
266	
267	            if process.returncode != 0:
268	                error_msg = stderr.decode().strip()
269	
270	                # Check for authentication errors
271	                if any(
272	                    phrase in error_msg.lower()
273	                    for phrase in ["not authenticated", "login required", "auth", "credentials"]
274	                ):
275	                    raise RuntimeError(
276	                        f"Gemini CLI authentication error: {error_msg}\n"
277	                        "Please run 'gemini auth login' to authenticate."
278	                    )
279	
280	                raise RuntimeError(f"Gemini CLI error: {error_msg}")
281	
282	            return stdout.decode().strip()
283	
284	        finally:
285	            # Always clean up the temporary file
286	            if temp_file_list and os.path.exists(temp_file_list):
287	                try:
288	                    os.remove(temp_file_list)
289	                except Exception as e:
290	                    logger.warning(f"Failed to remove temporary file {temp_file_list}: {e}")
291	
292	    async def _gemini_prompt(self, arguments: dict[str, Any]) -> str:
293	        """Send a simple prompt to Gemini."""
294	        prompt = arguments["prompt"]
295	        model = arguments.get("model", DEFAULT_GEMINI_MODEL)
296	        context = arguments.get("context", "")
297	
298	        full_prompt = f"{context}\n\n{prompt}" if context else prompt
299	
300	        return await self._run_gemini_command(prompt=full_prompt, model=model)
301	
302	    async def _gemini_research(self, arguments: dict[str, Any]) -> str:
303	        """Research a topic using Gemini."""
304	        topic = arguments["topic"]
305	        files = arguments.get("files", [])
306	        model = arguments.get("model", DEFAULT_GEMINI_MODEL)
307	
308	        research_prompt = f"""Please research the following topic and provide a comprehensive analysis:
309	
310	Topic: {topic}
311	
312	Please include:
313	1. Overview and background
314	2. Key findings and insights
315	3. Relevant details and examples
316	4. Conclusions and recommendations
317	
318	Be thorough but concise."""
319	
320	        return await self._run_gemini_command(
321	            prompt=research_prompt,
322	            model=model,
323	            files=files,
324	        )
325	
326	    async def _gemini_analyze_code(self, arguments: dict[str, Any]) -> str:
327	        """Analyze code using Gemini."""
328	        files = arguments["files"]
329	        analysis_type = arguments["analysis_type"]
330	        specific_question = arguments.get("specific_question", "")
331	        model = arguments.get("model", DEFAULT_GEMINI_MODEL)
332	
333	        analysis_prompts = {
334	            "review": "Please review this code and identify potential issues, bugs, or areas for improvement.",
335	            "explain": "Please explain what this code does in detail, including its purpose and how it works.",
336	            "optimize": "Please suggest optimizations for this code to improve performance, readability, or maintainability.",
337	            "security": "Please analyze this code for security vulnerabilities and suggest fixes.",
338	            "test": "Please suggest test cases and testing strategies for this code.",
339	        }
340	
341	        base_prompt = analysis_prompts.get(analysis_type, "Please analyze this code.")
342	
343	        if specific_question:
344	            prompt = f"{base_prompt}\n\nSpecific question: {specific_question}"
345	        else:
346	            prompt = base_prompt
347	
348	        return await self._run_gemini_command(
349	            prompt=prompt,
350	            model=model,
351	            files=files,
352	        )
353	
354	    async def _gemini_summarize(self, arguments: dict[str, Any]) -> str:
355	        """Summarize content using Gemini."""
356	        content = arguments.get("content", "")
357	        files = arguments.get("files", [])
358	        summary_type = arguments.get("summary_type", "brief")
359	        model = arguments.get("model", DEFAULT_GEMINI_MODEL)
360	
361	        if not content and not files:
362	            return "Error: Either content or files must be provided for summarization."
363	
364	        summary_prompts = {
365	            "brief": "Please provide a brief summary of the following content in 2-3 sentences.",
366	            "detailed": "Please provide a detailed summary of the following content, covering all main points.",
367	            "bullet_points": "Please summarize the following content as bullet points.",
368	            "executive": "Please provide an executive summary of the following content suitable for decision makers.",
369	        }
370	
371	        prompt = summary_prompts.get(summary_type, summary_prompts["brief"])
372	
373	        if content:
374	            full_prompt = f"{prompt}\n\nContent:\n{content}"
375	            return await self._run_gemini_command(prompt=full_prompt, model=model)
376	        else:
377	            return await self._run_gemini_command(
378	                prompt=prompt,
379	                model=model,
380	                files=files,
381	            )
