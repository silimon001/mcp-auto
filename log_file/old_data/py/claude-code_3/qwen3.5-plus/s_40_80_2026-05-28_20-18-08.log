n        # Try to create producer but don't fail if Kafka is unavailable\n        try:\n            await kafka_connector.create_producer()\n        except Exception as e:\n            logger.warning(f\"Could not connect to Kafka: {e}. Tools will be available but operations may fail.\")\n\n        yield {\n            \"kafka_connector\": kafka_connector,\n        }\n    except Exception as e:\n        logger.error(e)\n        raise e\n    finally:\n        pass"}
