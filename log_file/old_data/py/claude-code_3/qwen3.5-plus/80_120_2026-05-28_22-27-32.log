294	async def _rebuild_memory_from_json(video_path: str, index_path: str) -> bool:
295	    """Rebuild a memory from its JSON metadata when the video is corrupted/incompatible."""
296	    try:
297	        # Resolve paths (in case relative paths were passed)
298	        resolved_video_path = _server_state.resolve_file_path(video_path, "video")
299	        resolved_index_path = _server_state.resolve_file_path(index_path, "index")
300	
301	        logger.info(f"Attempting to rebuild memory from {resolved_index_path}")
302	
303	        # Read the JSON metadata
304	        with open(resolved_index_path, 'r') as f:
305	            metadata = json.load(f)
306	
307	        if 'metadata' not in metadata:
308	            logger.error("Invalid JSON format - missing metadata")
309	            return False
310	
311	        # Extract all text chunks
312	        chunks = []
313	        for item in metadata['metadata']:
314	            if 'text' in item:
315	                chunks.append(item['text'])
316	
317	        if not chunks:
318	            logger.error("No text chunks found in metadata")
319	            return False
320	
321	        logger.info(f"Found {len(chunks)} chunks to rebuild")
322	
323	        # Initialize encoder and add chunks
324	        try:
325	            encoder = await _ensure_encoder()
326	        except RuntimeError as e:
327	            logger.error(f"Cannot rebuild - encoder not available: {e}")
328	            return False
329	
330	        with redirect_stdout(sys.stderr):
331	            encoder.add_chunks(chunks)
332	
333	        # Rebuild the video
334	        with redirect_stdout(sys.stderr):
335	            encoder.build_video(
336	                output_file=resolved_video_path,
337	                index_file=resolved_index_path,
338	                codec='h265',
339	                show_progress=False,  # Silent rebuild
340	                auto_build_docker=True,
341	                allow_fallback=True
342	            )
343	
344	        logger.info(f"Successfully rebuilt memory: {resolved_video_path}")
345	        return True
346	
347	    except Exception as e:
348	        logger.error(f"Failed to rebuild memory: {e}")
349	        return False
