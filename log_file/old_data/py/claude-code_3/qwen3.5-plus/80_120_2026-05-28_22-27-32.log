1	"""
2	FastMCP Server implementation for SemaphoreUI.
3	
4	This module implements a Model Context Protocol server using FastMCP that exposes
5	SemaphoreUI API functionality through MCP tools.
6	"""
7	
8	import logging
9	from typing import Optional
10	
11	from mcp.server.fastmcp import FastMCP
12	
13	from .api import create_client
14	from .config import configure_logging, get_config
15	from .tools.access_keys import AccessKeyTools
16	from .tools.environments import EnvironmentTools
17	from .tools.events import EventTools
18	from .tools.project_users import ProjectUserTools
19	from .tools.projects import ProjectTools
20	from .tools.repositories import RepositoryTools
21	from .tools.schedules import ScheduleTools
22	from .tools.tasks import TaskTools
23	from .tools.templates import TemplateTools
24	from .tools.views import ViewTools
25	
26	# Configure logging
27	configure_logging()
28	logger = logging.getLogger("semaphore_mcp")
29	
30	
31	class SemaphoreMCPServer:
32	    """FastMCP server for SemaphoreUI."""
33	
34	    def __init__(
35	        self,
36	        semaphore_url: Optional[str] = None,
37	        semaphore_token: Optional[str] = None,
38	        host: str = "127.0.0.1",
39	        port: int = 8000,
40	    ):
41	        """
42	        Initialize the MCP server.
43	
44	        Args:
45	            semaphore_url: SemaphoreUI API URL
46	            semaphore_token: SemaphoreUI API token
47	            host: Host to bind to (for HTTP transport)
48	            port: Port to listen on (for HTTP transport)
49	        """
50	        # Use provided values or fall back to config
51	        self.url = semaphore_url or get_config("SEMAPHORE_URL")
52	        self.token = semaphore_token or get_config("SEMAPHORE_API_TOKEN")
53	        self.semaphore = create_client(self.url, self.token)
54	
55	        # Initialize FastMCP with host/port for HTTP transport
56	        self.mcp = FastMCP("semaphore", host=host, port=port)
57	
58	        # Initialize tool classes
59	        self.event_tools = EventTools(self.semaphore)
60	        self.project_tools = ProjectTools(self.semaphore)
61	        self.project_user_tools = ProjectUserTools(self.semaphore)
62	        self.template_tools = TemplateTools(self.semaphore)
63	        self.task_tools = TaskTools(self.semaphore)
64	        self.environment_tools = EnvironmentTools(self.semaphore)
65	        self.repository_tools = RepositoryTools(self.semaphore)
66	        self.access_key_tools = AccessKeyTools(self.semaphore)
67	        self.schedule_tools = ScheduleTools(self.semaphore)
68	        self.view_tools = ViewTools(self.semaphore)
69	
70	        # Register tools
71	        self.register_tools()
72	
73	    def register_tools(self):
74	        """Register MCP tools for SemaphoreUI."""
75	        # Event tools
76	        self.mcp.tool()(self.event_tools.list_events)
77	        self.mcp.tool()(self.event_tools.get_last_events)
78	        self.mcp.tool()(self.event_tools.list_project_events)
79	        self.mcp.tool()(self.event_tools.summarize_project_activity)
80	
81	        # Project tools
82	        self.mcp.tool()(self.project_tools.list_projects)
83	        self.mcp.tool()(self.project_tools.get_project)
84	        self.mcp.tool()(self.project_tools.create_project)
85	        self.mcp.tool()(self.project_tools.update_project)
86	        self.mcp.tool()(self.project_tools.delete_project)
87	        self.mcp.tool()(self.project_tools.backup_project)
