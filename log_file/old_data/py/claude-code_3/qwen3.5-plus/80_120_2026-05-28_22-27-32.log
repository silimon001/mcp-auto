81	class SnowflakeConnectionManager:
82	    """Singleton manager for Snowflake connection pooling and refresh.
83	
84	    This class maintains a persistent connection to Snowflake and refreshes it
85	    periodically in the background based on the configured refresh interval.
86	    """
87	
88	    _instance = None
89	    _lock = threading.Lock()
90	
91	    # Class instance variable type annotations
92	    _initialized: bool
93	    _connection: Optional[SnowflakeConnection]
94	    _connection_lock: threading.Lock
95	    _config: Optional[SnowflakeConfig]
96	    _last_refresh_time: Optional[datetime]
97	    _refresh_thread: Optional[threading.Thread]
98	    _stop_event: threading.Event
99	    _refresh_interval: timedelta
100	    _connection_healthy: bool
101	    _last_error: Optional[Exception]
102	    _retry_count: int
103	    _max_retry_count: int
104	    _retry_backoff_seconds: List[int]
105	
106	    def __new__(cls) -> "SnowflakeConnectionManager":
107	        with cls._lock:
108	            if cls._instance is None:
109	                cls._instance = super(SnowflakeConnectionManager, cls).__new__(cls)
110	                cls._instance._initialized = False
111	            return cls._instance
112	
113	    def __init__(self) -> None:
114	        """Initialize the connection manager if not already initialized."""
115	        if self._initialized:
116	            return
117	
118	        self._connection = None
119	        self._connection_lock = threading.Lock()
120	        self._config = None
121	        self._last_refresh_time = None
122	        self._refresh_thread = None
123	        self._stop_event = threading.Event()
124	        self._connection_healthy = False
125	        self._last_error = None
126	        self._retry_count = 0
127	        self._max_retry_count = 3
128	        # Exponential backoff retry intervals in seconds: 10s, 30s, 60s
129	        self._retry_backoff_seconds = [10, 30, 60]
130	
131	        # Get refresh interval from environment variable (in hours, default 8)
132	        refresh_interval_hours = float(os.getenv("SNOWFLAKE_CONN_REFRESH_HOURS", "8"))
133	        self._refresh_interval = timedelta(hours=refresh_interval_hours)
134	
135	        self._initialized = True
136	
137	    def initialize(self, config: SnowflakeConfig) -> None:
138	        """Initialize the connection manager with the given configuration."""
139	        with self._connection_lock:
140	            self._config = config
141	            self._connect()
142	
143	            # Start background refresh thread if not already running
144	            if self._refresh_thread is None or not self._refresh_thread.is_alive():
145	                self._stop_event.clear()
146	                self._refresh_thread = threading.Thread(
147	                    target=self._refresh_connection_periodically, daemon=True
148	                )
149	                self._refresh_thread.start()
150	
151	    def get_connection(self) -> SnowflakeConnection:
152	        """Get the current Snowflake connection, creating it if necessary."""
153	        with self._connection_lock:
154	            if self._connection is None or not self._connection_healthy:
155	                if self._config is None:
156	                    raise ValueError(
157	                        "Connection manager not initialized with a configuration"
158	                    )
159	                self._connect()
160	
161	            # At this point, self._connection should never be None because
162	            # _connect() would have either set it or raised an exception
163	            assert (
164	                self._connection is not None
165	            ), "Connection is None after connect attempt"
166	            return self._connection
167	
168	    def is_healthy(self) -> Tuple[bool, Optional[str]]:
169	        """Check if the connection is healthy.
170	
171	        Returns:
172	            Tuple[bool, Optional[str]]: A tuple containing:
173	                - Boolean indicating if the connection is healthy
174	                - Optional error message if not healthy, None otherwise
175	        """
176	        with self._connection_lock:
177	            error_msg = None
178	            if self._last_error:
179	                error_msg = (
180	                    f"{type(self._last_error).__name__}: {str(self._last_error)}"
181	                )
182	            return (self._connection_healthy, error_msg)
183	
184	    def close(self) -> None:
185	        """Close the current connection and stop the refresh thread."""
186	        self._stop_event.set()
187	
188	        with self._connection_lock:
189	            if self._connection is not None:
190	                try:
191	                    self._connection.close()
192	                except Exception:
193	                    pass  # Ignore errors during close
194	                self._connection = None
195	                self._connection_healthy = False
196	
197	    def _connect(self) -> None:
198	        """Establish a new connection to Snowflake."""
199	        if self._connection is not None:
200	            try:
201	                self._connection.close()
202	            except Exception:
203	                pass  # Ignore errors during close
204	
205	        if self._config is None:
206	            raise ValueError("Connection configuration is not initialized")
207	
208	        try:
209	            self._connection = get_snowflake_connection(self._config)
210	            self._last_refresh_time = datetime.now()
211	            self._connection_healthy = True
212	            self._last_error = None
213	            self._retry_count = 0
214	        except Exception as e:
215	            self._connection_healthy = False
216	            self._last_error = e
217	            raise
218	
219	    @contextlib.contextmanager
220	    def _temporarily_release_lock(self) -> Iterator[None]:
221	        """Context manager to safely release and reacquire the connection lock.
222	
223	        This allows other threads to access the connection while this thread sleeps,
224	        without risking inconsistent lock states.
225	
226	        Yields:
227	            None: This context manager doesn't yield any value.
228	        """
229	        self._connection_lock.release()
230	        try:
231	            yield
232	        finally:
233	            self._connection_lock.acquire()
234	
235	    def _refresh_connection_periodically(self) -> None:
236	        """Background thread that refreshes the connection periodically."""
237	        while not self._stop_event.is_set():
238	            # Sleep for a short interval and check if it's time to refresh
239	            if self._stop_event.wait(60):  # Check every minute
240	                break
241	
242	            with self._connection_lock:
243	                if (
244	                    self._last_refresh_time is not None
245	                    and datetime.now() - self._last_refresh_time
246	                    >= self._refresh_interval
247	                ):
248	                    try:
249	                        self._connect()
250	                    except (OperationalError, DatabaseError) as e:
251	                        # Potentially recoverable errors
252	                        self._connection_healthy = False
253	                        self._last_error = e
254	                        self._retry_count += 1
255	
256	                        if self._retry_count <= self._max_retry_count:
257	                            # Schedule a retry
258	                            retry_delay = self._retry_backoff_seconds[
259	                                min(
260	                                    self._retry_count - 1,
261	                                    len(self._retry_backoff_seconds) - 1,
262	                                )
263	                            ]
264	
265	                            # Safely release the lock during sleep without risk of inconsistent lock state
266	                            with self._temporarily_release_lock():
267	                                time.sleep(retry_delay)
268	
269	                            # Try again immediately after the backoff
270	                            continue
271	                    except Exception as e:
272	                        # All other errors
273	                        self._connection_healthy = False
274	                        self._last_error = e
