137	@mcp.tool()
138	def get_symbol_usages(
139	    repo: str,
140	    symbol_name_or_substring: str,
141	    working_directory: str,
142	    symbol_type: Optional[str] = None,
143	    file_must_contain: Optional[str] = None,
144	    file_must_not_contain: Optional[str] = None,
145	) -> List[str] | str:
146	    """
147	    Run `kit usages <repo> <symbol_name>` and optionally filter by symbol type
148	    at the CLI level and then post-filter the rows by file inclusion/exclusion
149	    substrings.
150	
151	    Parameters
152	    ----------
153	    repo : str | Path
154	        Path or name passed to `kit usages`. Use full absolute path.
155	    symbol_name_or_substring : str
156	        The symbol whose usages we want to inspect, or a substring of the symbol name (which can be used to find multiple symbols which share a naming convention).
157	    working_directory : str
158	        Directory from which to run the command (absolute path).
159	    symbol_type : str | None
160	        "function" or "method" or "class"
161	    file_must_contain : str | None
162	        post-filter: Keep only rows whose **File** column *contains* this substring.
163	        None ⇒ no inclusion filter.
164	    file_must_not_contain : str | None
165	        post-filter: Discard rows whose **File** column contains this substring.
166	        None ⇒ no exclusion filter.
167	
168	    Returns
169	    -------
170	    list[str] | str
171	        Filtered output, ready to `print()` or write to a file.
172	    """
173	
174	    # 1) Build the CLI invocation
175	    cmd: List[str] = ["kit", "usages", str(repo), symbol_name_or_substring]
176	    if symbol_type:
177	        cmd.extend(["--symbol-type", symbol_type])
178	
179	    # 2) Run the external command
180	    result = subprocess.run(
181	        cmd,
182	        check=True,
183	        text=True,
184	        capture_output=True,
185	        cwd=working_directory,
186	    )
187	    raw_lines = result.stdout.splitlines(keepends=False)
188	
189	    # 3) Prepare filters
190	    inc_substr = file_must_contain or ""
191	    exc_substr = file_must_not_contain or ""
192	
193	    splitter = re.compile(r"\s{2,}")  # split on 2-or-more whitespace blocks
194	
195	    filtered: List[str] = []
196	    header_passed = False
197	
198	    for line in raw_lines:
199	        # Always keep the header (first line) and the separator (second line)
200	        if not header_passed:
201	            filtered.append(line)
202	            if re.match(r"-{3,}", line):
203	                header_passed = True
204	            continue
205	
206	        if not line.strip():  # skip blank lines
207	            continue
208	
209	        parts = splitter.split(line)
210	        # Defensive: expect at least a File column in position 2 or 3 depending on layout.
211	        file_col: str
212	        if len(parts) >= 3:
213	            file_col = parts[2]
214	        elif len(parts) >= 2:
215	            file_col = parts[1]
216	        else:
217	            filtered.append(line)
218	            continue
219	
220	        # --- Apply filters ---------------------------------------------------
221	        if inc_substr and inc_substr not in file_col:
222	            continue
223	        if exc_substr and exc_substr in file_col:
224	            continue
225	
226	        filtered.append(line)
227	
228	    return filtered
