214	  private async generateImage(request: CallToolRequest): Promise<CallToolResult> {
215	    if (!this.ensureConfigured()) {
216	      throw new McpError(ErrorCode.InvalidRequest, "Gemini API token not configured. Use configure_gemini_token first.");
217	    }
218	
219	    const { prompt } = request.params.arguments as { prompt: string };
220	    
221	    try {
222	      const response = await this.genAI!.models.generateContent({
223	        model: "gemini-2.5-flash-image-preview",
