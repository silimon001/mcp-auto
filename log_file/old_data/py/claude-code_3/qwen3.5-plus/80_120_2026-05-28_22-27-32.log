503	                f"{scores['combined_score']:13.2f} | "
504	                f"{scores['coderank_score']:9.4f} | "
505	                f"{scores['usage_score']:6.0f} | "
506	                f"{scores['symbol_count']:8d} | "
507	                f"{scores['connections']:6d}"
508	            )
509	        
510	        # Add insights
511	        output_lines.append("\n=== Insights ===")
512	        if sorted_hotspots:
513	            top_module = sorted_hotspots[0][0]
514	            output_lines.append(f"• Most critical module: {top_module}")
515	            
516	            high_usage = [m for m, s in sorted_hotspots if s['usage_score'] > 10]
517	            if high_usage:
518	                output_lines.append(f"• Highly used modules: {', '.join(high_usage[:3])}")
519	            
520	            high_complexity = [m for m, s in sorted_hotspots if s['symbol_count'] > 50]
521	            if high_complexity:
522	                output_lines.append(f"• Complex modules (many symbols): {', '.join(high_complexity[:3])}")
523	            
524	            highly_connected = [m for m, s in sorted_hotspots if s['connections'] > 20]
525	            if highly_connected:
526	                output_lines.append(f"• Highly connected modules: {', '.join(highly_connected[:3])}")
527	        
528	        return '\n'.join(output_lines)
529	        
530	    except Exception as e:
531	        return f"Error in find_code_hotspots: {str(e)}"
