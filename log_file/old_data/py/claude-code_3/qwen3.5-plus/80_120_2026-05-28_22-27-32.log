24	from http import HTTPStatus
25	import dashscope
26	
27	from mcp.server.fastmcp import FastMCP
28	from mcp.server.fastmcp import Context
29	
30	from .xiaohongshu_processor import XiaohongshuProcessor
31	from .douyin_processor import DouyinProcessor
32	from .generic_extractor import extract_generic_media
33	
34	# 创建 MCP 服务器实例
35	mcp = FastMCP("百分百一键去水印",
36	              dependencies=["requests", "ffmpeg-python", "tqdm", "dashscope"])
37	
38	# 请求头，模拟移动端访问
39	HEADERS = {
40	    'User-Agent': 'Mozilla/5.0 (iPhone; CPU iPhone OS 17_2 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) EdgiOS/121.0.2277.107 Version/17.0 Mobile/15E148 Safari/604.1'
41	}
42	
43	# 默认 API 配置
44	DEFAULT_MODEL = "paraformer-v2"
45	
46	
47	def _generic_fallback(share_link: str, reason: str) -> str:
48	    """通用兜底逻辑：在专用解析失败时尝试通用提取。"""
49	
50	    try:
51	        fallback_data = extract_generic_media(share_link)
52	        fallback_data.setdefault("fallback_reason", reason)
53	        return json.dumps(fallback_data, ensure_ascii=False, indent=2)
54	    except Exception as fallback_error:
55	        return json.dumps({
56	            "status": "error",
57	            "error": f"{reason}；兜底解析失败：{fallback_error}"
58	        }, ensure_ascii=False, indent=2)
59	
60	@mcp.tool()
61	def parse_xhs_link(share_link: str) -> str:
62	    """
63	    解析小红书分享链接，自动识别视频或图文类型并返回无水印资源
64	
65	    参数:
66	    - share_link: 小红书分享链接或包含链接的文本
67	
68	    返回:
69	    - 包含资源链接和信息的JSON字符串
70	    - 自动识别类型（video/image）并返回相应格式
71	    - 调用完成后，请将结果整理为以下纯文本格式并反馈给用户（禁止使用Markdown）：
72	      标题（如无则留空）：
73	      文案：
74	      视频/图片链接：
75	    - 返回时请保留完整的标题和文案，不要省略或截断任何内容
76	    - 若专用解析失败，将自动尝试 generic 兜底逻辑；调用方需同样按上述格式反馈结果
77	    - 抖音仅返回 caption 字段，标题需由调用方自行按需补充
78	    """
79	    try:
80	        processor = XiaohongshuProcessor()
81	
82	        # 先尝试解析视频
83	        try:
84	            video_info = processor.parse_share_url(share_link)
85	            return json.dumps({
86	                "status": "success",
87	                "type": "video",
88	                "platform": "xiaohongshu",
89	                "note_id": video_info.get("note_id", ""),
90	                "title": video_info["title"],
91	                "caption": video_info.get("desc", ""),
92	                "url": video_info["url"],
93	                "description": f"视频标题: {video_info['title']}"
94	            }, ensure_ascii=False, indent=2)
95	        except Exception as video_error:
96	            # 如果视频解析失败，尝试图文解析
97	            error_msg = str(video_error).lower()
98	            if "未从页面中发现可用视频直链" in error_msg or "video" in error_msg or "候选" in error_msg:
99	                try:
100	                    note_data = processor.parse_image_note(share_link)
101	                    return json.dumps({
102	                        "status": "success",
103	                        "type": "image",
104	                        "platform": "xiaohongshu",
105	                        "note_id": note_data["note_id"],
106	                        "title": note_data["title"],
107	                        "desc": note_data["desc"],
108	                        "caption": note_data.get("desc", ""),
109	                        "image_count": len(note_data["images"]),
