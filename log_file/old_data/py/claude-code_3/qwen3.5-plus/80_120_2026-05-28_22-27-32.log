356	@mcp.tool()
357	def find_code_hotspots(
358	    repo_path: str,
359	    working_directory: str,
360	    min_connections: int = 5,
361	    include_external: bool = True,
362	    top_n: int = 20
363	) -> str:
364	    """
365	    Identify code hotspots by combining CodeRank with symbol usage frequency.
366	    Uses kit usages + coderank to find modules that are both highly connected
367	    and frequently used.
368	    
369	    Args:
370	        repo_path: Repository to analyze
371	        working_directory: Working directory for commands (absolute path)
372	        min_connections: Minimum import connections to consider
373	        include_external: Include external module dependencies
374	        top_n: Number of top hotspots to return
375	    
376	    Returns:
377	        Hotspot analysis with modules ranked by importance and usage
378	    """
379	    try:
380	        # Get CodeRank analysis
381	        external_modules = ["numpy", "pandas", "sklearn", "torch", "tensorflow", "requests", "django", "flask"] if include_external else []
382	        
383	        coderank_results = calculate_coderank(
384	            repo_path=repo_path,
385	            external_modules=external_modules
386	        )
387	        
388	        module_scores = coderank_results["module_ranks"]
389	        module_map = coderank_results["module_map"]
390	        
391	        # Get all symbols from the repository
392	        symbols_output = get_repo_symbols(
393	            repo=repo_path,
394	            working_directory=working_directory,
395	            keep_types=["function", "class", "method"]
396	        )
397	        
398	        # Parse symbols to count per module
399	        module_symbol_counts = defaultdict(int)
400	        module_symbols = defaultdict(list)
401	        
402	        for line in symbols_output:
403	            if '|' in line and not line.startswith('-') and 'Symbol' not in line:
404	                parts = re.split(r'\s{2,}', line.strip())
405	                if len(parts) >= 4:
406	                    symbol_name = parts[0]
407	                    symbol_type = parts[1]
408	                    file_path = parts[2]
409	                    
410	                    # Convert file path to module name
411	                    abs_file_path = os.path.join(working_directory, file_path) if not os.path.isabs(file_path) else file_path
412	                    module_fqn = path_to_module_fqn(abs_file_path, repo_path)
413	                    
414	                    if module_fqn:
415	                        module_symbol_counts[module_fqn] += 1
416	                        module_symbols[module_fqn].append({
417	                            "name": symbol_name,
418	                            "type": symbol_type
419	                        })
420	        
421	        # Check usage frequency for top symbols
422	        usage_scores = defaultdict(float)
423	        
424	        for module, symbols in module_symbols.items():
425	            if len(symbols) >= min_connections or module in module_scores:
426	                # Sample a few key symbols from each module
427	                key_symbols = symbols[:5]  # Check top 5 symbols
428	                
429	                for symbol in key_symbols:
430	                    try:
431	                        usages = get_symbol_usages(
432	                            repo=repo_path,
433	                            symbol_name_or_substring=symbol["name"],
434	                            working_directory=working_directory,
435	                            symbol_type=symbol["type"]
436	                        )
437	                        
438	                        # Count unique files using this symbol
439	                        unique_files = set()
440	                        for usage_line in usages:
441	                            if '|' in usage_line and not usage_line.startswith('-'):
442	                                parts = re.split(r'\s{2,}', usage_line.strip())
443	                                if len(parts) >= 3:
444	                                    unique_files.add(parts[2])
445	                        
446	                        usage_scores[module] += len(unique_files)
447	                    except:
448	                        pass
449	        
450	        # Calculate import connections from the graph
451	        import_graph = coderank_results["import_graph"]
452	        connection_counts = {}
453	        for module in module_scores:
454	            in_degree = import_graph.in_degree(module)
455	            out_degree = import_graph.out_degree(module)
456	            connection_counts[module] = in_degree + out_degree
457	        
458	        # Combine scores
459	        hotspot_scores = {}
460	        for module in set(list(module_scores.keys()) + list(usage_scores.keys())):
461	            coderank_score = module_scores.get(module, 0)
462	            usage_score = usage_scores.get(module, 0)
463	            symbol_count = module_symbol_counts.get(module, 0)
