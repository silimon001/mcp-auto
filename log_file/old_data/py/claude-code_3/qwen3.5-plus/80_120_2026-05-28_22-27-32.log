107	class ServerState:
108	    """Centralized state management for the memvid MCP server."""
109	
110	    def __init__(self):
111	        self.connections: dict[str, Any] = {}
112	        self.initialized = False
113	        self.encoder: Optional[Any] = None
114	        self.retriever: Optional[Any] = None
115	        self.chat: Optional[Any] = None
116	        self.docker_manager = DockerLifecycleManager()
117	        self._shutdown_event = asyncio.Event()
118	        # Track currently loaded memory
119	        self.current_video_path: Optional[str] = None
120	        self.current_index_path: Optional[str] = None
121	        # Memory library state
122	        self.available_memories: dict[str, dict] = {}
123	        # FAISS configuration
124	        self.faiss_type: str = "none"
125	        # Library directory path (where the server is installed)
126	        self.library_dir = self._detect_library_directory()
127	
128	    def _detect_library_directory(self) -> str:
129	        """Detect the library directory relative to the server installation."""
130	        try:
131	            # Get the directory containing this script
132	            script_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
133	            library_dir = os.path.join(script_dir, "library")
134	
135	            # Create library directory if it doesn't exist
136	            os.makedirs(library_dir, exist_ok=True)
137	
138	            logger.info(f"Using library directory: {library_dir}")
139	            return library_dir
140	        except Exception as e:
141	            logger.error(f"Failed to detect library directory: {e}")
142	            # Fallback to current directory
143	            fallback_dir = os.path.join(os.getcwd(), "library")
144	            os.makedirs(fallback_dir, exist_ok=True)
145	            return fallback_dir
146	
147	    def resolve_file_path(self, path: str, file_type: str = "video") -> str:
148	        """Resolve file path, using library directory for relative paths."""
149	        if os.path.isabs(path):
150	            # Absolute path - use as is
151	            return path
152	        else:
153	            # Relative path - resolve to library directory
154	            resolved_path = os.path.join(self.library_dir, path)
155	            logger.info(f"Resolved relative path '{path}' to '{resolved_path}'")
156	            return resolved_path
157	
158	    async def initialize(self) -> None:
159	        """Initialize server resources."""
160	        if self.initialized:
161	            return
162	
163	        try:
164	            logger.info("Initializing memvid MCP server with Docker lifecycle management")
165	
166	            # Detect and configure FAISS
167	            faiss_type = _detect_and_configure_faiss()
168	            self.faiss_type = faiss_type
169	
170	            # Initialize Docker environment first
171	            with redirect_stdout(sys.stderr):
172	                docker_success = await self.docker_manager.initialize()
173	            if docker_success:
174	                logger.info("✅ Docker environment ready - memvid package will handle containers")
175	            else:
176	                logger.warning("⚠️ Docker initialization failed, memvid will use native mode")
177	
178	            # Check if memvid is available
179	            if MemvidEncoder is None:
180	                logger.warning("Memvid not available - tools will return error messages")
181	            else:
182	                # Initialize encoder only when needed to avoid startup errors
183	                logger.info("Memvid available - ready to create encoder on demand")
184	
185	            self.initialized = True
186	            logger.info("Server initialization completed")
187	
188	        except Exception as e:
189	            logger.error(f"Server initialization failed: {e}")
190	            raise
191	
192	    def update_memory_library(self, video_path: str, index_path: str) -> None:
193	        """Update the memory library with a new or loaded memory."""
194	        try:
195	            name = os.path.basename(os.path.splitext(video_path)[0])
196	            self.available_memories[name] = {
197	                "video_path": video_path,
198	                "index_path": index_path,
199	                "loaded": True
200	            }
201	            logger.info(f"Updated memory library with: {name}")
202	        except Exception as e:
203	            logger.warning(f"Failed to update memory library: {e}")
204	
205	    def set_active_memory(self, video_path: str, index_path: str) -> None:
206	        """Set the currently active memory and update library."""
207	        self.current_video_path = video_path
208	        self.current_index_path = index_path
209	        self.update_memory_library(video_path, index_path)
210	
211	    async def cleanup(self) -> None:
212	        """Clean up server resources."""
213	        if not self.initialized:
214	            return
215	
216	        logger.info("Cleaning up memvid MCP server")
217	
218	        try:
219	            # Clean up Docker resources first
220	            try:
221	                with redirect_stdout(sys.stderr):
222	                    await self.docker_manager.cleanup()
223	            except Exception as e:
224	                logger.warning(f"Docker cleanup failed: {e}")
225	
226	            # Close connections
227	            for conn_id, conn in self.connections.items():
228	                try:
229	                    if hasattr(conn, 'close'):
230	                        if asyncio.iscoroutinefunction(conn.close):
231	                            await conn.close()
232	                        else:
233	                            conn.close()
234	                except Exception as e:
235	                    logger.warning(f"Connection cleanup failed for {conn_id}: {e}")
236	
237	            # Clear state
238	            self.connections.clear()
239	            self.encoder = None
240	            self.retriever = None
241	            self.chat = None
242	            self.current_video_path = None
243	            self.current_index_path = None
244	            self.available_memories.clear()
245	            self.initialized = False
246	
247	            logger.info("Server cleanup completed")
248	
249	        except Exception as e:
250	            logger.error(f"Error during cleanup: {e}")
251	
