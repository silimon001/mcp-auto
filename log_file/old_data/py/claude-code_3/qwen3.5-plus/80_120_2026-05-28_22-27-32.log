151	        video_info = processor.parse_share_url(share_link)
152	
153	        # 直接使用视频URL进行文本提取
154	        ctx.info("正在从视频中提取文本...")
155	        text_content = processor.extract_text_from_video_url(video_info['url'])
156	
157	        ctx.info("文本提取完成!")
158	        return text_content
159	
160	    except Exception as e:
161	        ctx.error(f"处理过程中出现错误: {str(e)}")
162	        raise Exception(f"提取抖音视频文本失败: {str(e)}")
