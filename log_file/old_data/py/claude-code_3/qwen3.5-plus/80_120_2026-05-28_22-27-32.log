68	def load_private_key(private_key_path: str) -> rsa.RSAPrivateKey:
69	    """Load private key from file."""
70	    with open(private_key_path, "rb") as key_file:
71	        p_key = load_pem_private_key(
72	            key_file.read(),
73	            password=None,
74	            backend=default_backend(),
75	        )
76	        if not isinstance(p_key, rsa.RSAPrivateKey):
77	            raise TypeError("Private key is not an RSA private key")
78	        return p_key
