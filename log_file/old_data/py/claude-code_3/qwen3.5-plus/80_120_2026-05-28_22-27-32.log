166	@mcp.tool()
167	def parse_douyin_link(share_link: str) -> str:
168	    """
169	    解析抖音分享链接，自动识别视频或图文类型并返回无水印资源
170	
171	    参数:
172	    - share_link: 抖音分享链接或包含链接的文本
173	
174	    返回:
175	    - 包含资源链接和信息的JSON字符串
176	    - 自动识别类型（video/image）并返回相应格式
177	    - 调用完成后，请将结果整理为以下纯文本格式并反馈给用户（禁止使用Markdown）：
178	      标题（如无则留空）：
179	      文案：
180	      视频/图片链接：
181	    - 返回时请保留完整的标题和文案，不要省略或截断任何内容
182	    - 若专用解析失败，将自动尝试 generic 兜底逻辑；调用方需同样按上述格式反馈结果
183	    - 抖音仅返回 caption 字段，标题需由调用方自行按需补充
184	    """
185	    try:
186	        processor = DouyinProcessor("")  # 获取资源不需要API密钥
187	
