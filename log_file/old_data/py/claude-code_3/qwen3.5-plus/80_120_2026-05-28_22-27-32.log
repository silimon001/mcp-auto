148	@server.tool()
149	def read_email_by_subject(subject: str, ctx: Context) -> List[Dict[str, str]]:
150	    """
151	    Searches for emails by subject and returns the body and snippet of the most recent matches.
152	    
153	    Args:
154	        subject: The subject line to search for.
155	    """
156	    creds = get_creds_from_context(ctx)
157	    try:
158	        gmail_service = googleapiclient.discovery.build('gmail', 'v1', credentials=creds)
159	        # Search for messages with the given subject, get the most recent 5
160	        results = gmail_service.users().messages().list(userId='me', q=f'subject:"{subject}"', maxResults=5).execute()
161	        messages = results.get('messages', [])
162	
163	        if not messages:
164	            return [{"status": f"No emails found with subject: '{subject}'"}]
165	
166	        emails = []
167	        for msg_info in messages:
168	            msg = gmail_service.users().messages().get(userId='me', id=msg_info['id'], format='full').execute()
169	            body = get_email_body(msg['payload']) or "Could not extract plain text body."
170	            emails.append({'id': msg['id'], 'snippet': msg.get('snippet', ''), 'body': body})
171	        return emails
172	    except HttpError as e:
173	        raise Exception(f"API Gmail error (HTTP {e.status_code}): {e.reason}")
