1852	@mcp.tool()
1853	def analyze_error_patterns(
1854	    repo_path: str,
1855	    working_directory: str,
1856	    focus_area: Optional[str] = None,
1857	    custom_patterns: Optional[Dict[str, str]] = None,
1858	    custom_antipatterns: Optional[Dict[str, str]] = None,
1859	    include_antipatterns: bool = True,
1860	    show_evolution: bool = True,
1861	    days_back: int = 180
1862	) -> str:
1863	    """
1864	    Discover error handling patterns and inconsistencies in the codebase.
1865	    
1866	    Use this tool when you need to understand:
1867	    - How errors are typically handled in this codebase
1868	    - What error handling patterns to follow for consistency
1869	    - Where error handling might be missing or inconsistent
1870	    - How error handling has evolved over time
1871	    
1872	    Essential for implementing proper error handling that matches the codebase style,
1873	    debugging error-related issues, or improving error handling consistency.
1874	    
1875	    Args:
1876	        repo_path: Repository path (absolute)
1877	        working_directory: Working directory (absolute path)
1878	        focus_area: Specific area to focus on (e.g., "database", "api", "file_io")
1879	        custom_patterns: Custom regex patterns for error handling (overrides defaults)
1880	        custom_antipatterns: Custom regex patterns for antipatterns (overrides defaults)
1881	        include_antipatterns: Whether to identify problematic error handling
1882	        show_evolution: Whether to show how error handling has changed
1883	        days_back: Days of git history to analyze for evolution
1884	    
1885	    Returns:
1886	        Comprehensive error handling analysis with patterns and recommendations
1887	    """
1888	    try:
1889	        output_lines = ["=== Error Handling Pattern Analysis ===\n"]
1890	        output_lines.append(f"Repository: {repo_path}")
1891	        if focus_area:
1892	            output_lines.append(f"Focus area: {focus_area}")
1893	        output_lines.append(f"Include antipatterns: {include_antipatterns}")
1894	        output_lines.append(f"Show evolution: {show_evolution}\n")
1895	        
1896	        # Define error handling patterns to search for - use custom patterns if provided
1897	        if custom_patterns:
1898	            error_patterns = custom_patterns
1899	        else:
1900	            error_patterns = {
1901	                "try_except": r"try:|except\s+\w+:",
1902	                "raise_statements": r"raise\s+\w+",
1903	                "error_returns": r"return.*[Ee]rror|return.*[Ff]alse",
1904	                "logging_errors": r"log\.error|logger\.error|logging\.error",
1905	                "custom_exceptions": r"class\s+\w*[Ee]rror|class\s+\w*[Ee]xception",
1906	                "error_checking": r"if.*error|if.*failed|if.*success.*false"
1907	            }
1908	        
1909	        # If focus_area specified, adjust search
1910	        search_path = repo_path
1911	        if focus_area:
1912	            # Try to find focus area specific files
1913	            focus_result = subprocess.run(
1914	                ["rg", "-l", "-i", "--type", "py", focus_area, repo_path],
1915	                capture_output=True,
1916	                text=True,
1917	                cwd=working_directory
1918	            )
1919	            if focus_result.returncode == 0:
1920	                output_lines.append(f"Found {len(focus_result.stdout.split())} files related to {focus_area}")
1921	        
1922	        # Get CodeRank data for prioritization
1923	        try:
1924	            coderank_results = calculate_coderank(repo_path=repo_path)
1925	            module_scores = coderank_results["module_ranks"]
1926	        except:
1927	            module_scores = {}
1928	        
1929	        pattern_results = {}
1930	        
1931	        # Search for each error handling pattern
1932	        for pattern_name, pattern_regex in error_patterns.items():
1933	            rg_result = subprocess.run(
1934	                ["rg", "-n", "-i", "--type", "py", pattern_regex, search_path],
1935	                capture_output=True,
1936	                text=True,
1937	                cwd=working_directory
1938	            )
1939	            
1940	            if rg_result.returncode == 0:
1941	                lines = rg_result.stdout.split('\n')
1942	                pattern_results[pattern_name] = []
1943	                
1944	                for line in lines[:20]:  # Limit to top 20 per pattern
1945	                    if ':' in line:
1946	                        parts = line.split(':', 2)
1947	                        if len(parts) >= 3:
1948	                            file_path = parts[0]
1949	                            line_number = parts[1]
1950	                            content = parts[2].strip()
1951	                            
1952	                            # Get module importance
1953	                            module_fqn = path_to_module_fqn(os.path.join(repo_path, file_path), repo_path)
1954	                            score = module_scores.get(module_fqn, 0) if module_fqn else 0
1955	                            
1956	                            pattern_results[pattern_name].append({
1957	                                'file': file_path,
1958	                                'line': line_number,
1959	                                'content': content,
1960	                                'score': score
1961	                            })
1962	                
1963	                # Sort by importance
1964	                pattern_results[pattern_name].sort(key=lambda x: x['score'], reverse=True)
1965	        
1966	        # Analyze and present results
1967	        for pattern_name, results in pattern_results.items():
1968	            if results:
1969	                output_lines.append(f"\n=== {pattern_name.replace('_', ' ').title()} ({len(results)} occurrences) ===")
1970	                
1971	                # Show top examples
1972	                for result in results[:5]:
1973	                    rel_path = os.path.relpath(result['file'], repo_path)
1974	                    importance = f" (importance: {result['score']:.4f})" if result['score'] > 0 else ""
1975	                    output_lines.append(f"  • {rel_path}:{result['line']}{importance}")
1976	                    output_lines.append(f"    {result['content']}")
1977	                
1978	                if len(results) > 5:
1979	                    output_lines.append(f"    ... and {len(results) - 5} more occurrences")
1980	        
1981	        # Look for antipatterns if requested
1982	        if include_antipatterns:
1983	            output_lines.append(f"\n=== Potential Error Handling Issues ===")
1984	            
1985	            if custom_antipatterns:
1986	                antipatterns = custom_antipatterns
1987	            else:
1988	                antipatterns = {
1989	                    "bare_except": r"except:",
1990	                    "pass_in_except": r"except.*:\s*pass",
1991	                    "print_errors": r"print.*error|print.*exception",
1992	                    "swallowed_exceptions": r"except.*:\s*(?:pass|continue|return)"
1993	                }
1994	            
1995	            issues_found = []
1996	            for antipattern_name, antipattern_regex in antipatterns.items():
1997	                ap_result = subprocess.run(
1998	                    ["rg", "-n", "-i", "--type", "py", antipattern_regex, repo_path],
1999	                    capture_output=True,
2000	                    text=True,
2001	                    cwd=working_directory
2002	                )
2003	                
2004	                if ap_result.returncode == 0:
2005	                    lines = ap_result.stdout.split('\n')[:5]  # Top 5 issues
2006	                    for line in lines:
2007	                        if line.strip():
2008	                            issues_found.append(f"{antipattern_name}: {line}")
2009	            
2010	            if issues_found:
2011	                for issue in issues_found:
2012	                    output_lines.append(f"  ⚠️  {issue}")
2013	            else:
2014	                output_lines.append("  ✅ No obvious error handling antipatterns detected")
2015	        
2016	        # Show evolution if requested
2017	        if show_evolution:
2018	            output_lines.append(f"\n=== Error Handling Evolution (last {days_back} days) ===")
2019	            
2020	            since_date = (datetime.now() - timedelta(days=days_back)).strftime('%Y-%m-%d')
2021	            
2022	            # Look for error-related commits
2023	            git_cmd = [
2024	                "git", "-C", repo_path, "log",
2025	                f"--since={since_date}",
2026	                "--grep=error",
2027	                "--grep=exception",
2028	                "--grep=fix",
2029	                "--oneline",
2030	                "--max-count=10"
2031	            ]
2032	            
2033	            git_result = subprocess.run(git_cmd, capture_output=True, text=True)
2034	            if git_result.returncode == 0 and git_result.stdout:
2035	                commits = git_result.stdout.strip().split('\n')
2036	                output_lines.append(f"Recent error-related commits ({len(commits)}):")
2037	                for commit in commits:
2038	                    output_lines.append(f"  • {commit}")
2039	            else:
2040	                output_lines.append("No recent error-related commits found")
2041	        
2042	        # Summary and recommendations
2043	        output_lines.append(f"\n=== Error Handling Summary ===")
2044	        total_patterns = sum(len(results) for results in pattern_results.values())
2045	        output_lines.append(f"Total error handling patterns found: {total_patterns}")
2046	        
2047	        # Most common pattern
2048	        if pattern_results:
2049	            most_common = max(pattern_results.items(), key=lambda x: len(x[1]))
2050	            output_lines.append(f"Most common pattern: {most_common[0]} ({len(most_common[1])} occurrences)")
2051	        
2052	        # Recommendations
2053	        output_lines.append(f"\n=== Recommendations ===")
2054	        if pattern_results.get("try_except"):
2055	            output_lines.append("✅ Codebase uses try/except blocks - follow this pattern")
2056	        if pattern_results.get("logging_errors"):
2057	            output_lines.append("✅ Codebase logs errors - continue this practice")
2058	        if pattern_results.get("custom_exceptions"):
2059	            output_lines.append("✅ Custom exceptions defined - use appropriate ones")
2060	        
2061	        return '\n'.join(output_lines)
2062	        
2063	    except Exception as e:
2064	        return f"Error in analyze_error_patterns: {str(e)}"
2065	
