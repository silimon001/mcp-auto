48	@mcp.tool()
49	def get_repo_symbols(
50	    repo: str,
51	    working_directory: str,
52	    keep_types: Optional[Iterable[str]] = None,
53	    file_must_contain: Optional[str] = None,
54	    file_must_not_contain: Optional[str] = None
55	) -> List[str] | str:
56	    """
57	    Run `kit symbols <repo>` and keep the header plus rows
58	    that satisfy the filters.
59	
60	    Parameters
61	    ----------
62	    repo : str | Path
63	        Path or name passed to `kit symbols`.
64	    working_directory : str
65	        The directory to run the command from. Use full absolute path.
66	    keep_types : Iterable[str] | None
67	        Exact values allowed in the **Type** column
68	        (e.g. {"function", "method", "class"}).  None ⇒ no type filter.
69	    file_must_contain : str | None
70	        post-filter: Keep only rows whose **File** column *contains* this substring.
71	        None ⇒ no inclusion filter.
72	    file_must_not_contain : str | None
73	        post-filter: Discard rows whose **File** column contains this substring.
74	        None ⇒ no exclusion filter.
75	
76	
77	    Returns
78	    -------
79	    list[str] | str
80	        Filtered output, ready to `print()` or write to a file.
81	    """
82	    # 1) Run the external command
83	    
84	    result = subprocess.run(
85	        ["kit", "symbols", str(repo)],
86	        check=True,
87	        text=True,
88	        capture_output=True,
89	        cwd=working_directory  # This ensures the command runs in the specified directory
90	    )
91	    raw_lines = result.stdout.splitlines(keepends=False)
92	
93	    # 2) Prepare filters
94	    keep_types   = set(keep_types) if keep_types else None
95	    inc_substr   = file_must_contain or ""
96	    exc_substr   = file_must_not_contain or ""
97	
98	    # Regex:     split on 2-or-more spaces/tabs
99	    splitter = re.compile(r"\s{2,}")
100	
101	    filtered: List[str] = []
102	    header_passed = False
103	
104	    for line in raw_lines:
105	        # Always keep the header (first line) and the separator (second line)
106	        if not header_passed:
107	            filtered.append(line)
108	            # the separator is a run of dashes:  ------
109	            if re.match(r"-{3,}", line):
110	                header_passed = True
111	            continue
112	
113	        if not line.strip():           # skip blank lines
114	            continue
115	
116	        parts = splitter.split(line)
117	        if len(parts) < 4:
118	            # Unexpected layout—keep it unchanged.
119	            filtered.append(line)
120	            continue
121	
122	        _, symbol_type, file_col, _ = parts[:4]
123	
124	        # --- Apply filters ---------------------------------------------------
125	        if keep_types and symbol_type not in keep_types:
126	            continue
127	        if inc_substr   and inc_substr   not in file_col:
128	            continue
129	        if exc_substr   and exc_substr   in  file_col:
130	            continue
131	
132	        filtered.append(line)
133	
134	    return filtered
135	
