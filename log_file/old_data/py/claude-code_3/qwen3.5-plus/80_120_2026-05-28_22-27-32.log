419	    mcp_server = create_mcp_server(ib_manager)
420	    sse_transport = SseServerTransport("/messages")
421	
422	    @app.get("/sse")
423	    async def handle_sse(request: Request):
424	        try:
425	             async with sse_transport.connect_sse(
426	                 request.scope, request.receive, request._send
427	             ) as streams:
428	                 await mcp_server.run(
429	                     streams[0], streams[1], 
430	                     sse_transport.initialization_options
431	                 )
432	        except Exception:
433	             # Client disconnected or error
434	             pass
435	
436	    @app.post("/messages")
437	    async def handle_messages(request: Request):
