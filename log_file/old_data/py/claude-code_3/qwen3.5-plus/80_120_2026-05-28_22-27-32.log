1690	@mcp.tool()
1691	def trace_data_flow(
1692	    repo_path: str,
1693	    working_directory: str,
1694	    data_identifier: str,
1695	    max_depth: int = 5,
1696	    include_transformations: bool = True,
1697	    show_side_effects: bool = True
1698	) -> str:
1699	    """
1700	    Trace how specific data flows through the system from source to destination.
1701	    
1702	    Use this tool when you need to understand:
1703	    - How a piece of data (user_id, email, order_data, etc.) moves through the codebase
1704	    - What functions transform or modify the data
1705	    - Where data comes from and where it goes
1706	    - What side effects might occur when processing this data
1707	    
1708	    Perfect for debugging data-related issues, understanding data dependencies,
1709	    or planning changes that affect data flow.
1710	    
1711	    Args:
1712	        repo_path: Repository path (absolute)
1713	        working_directory: Working directory (absolute path)
1714	        data_identifier: Name of the data to trace (e.g., "user_id", "email", "order")
1715	        max_depth: How deep to trace the data flow
1716	        include_transformations: Whether to show data transformation points
1717	        show_side_effects: Whether to identify potential side effects
1718	    
1719	    Returns:
1720	        Comprehensive data flow analysis with transformation points and dependencies
1721	    """
1722	    try:
1723	        output_lines = ["=== Data Flow Analysis ===\n"]
1724	        output_lines.append(f"Tracing: {data_identifier}")
1725	        output_lines.append(f"Repository: {repo_path}")
1726	        output_lines.append(f"Max depth: {max_depth}\n")
1727	        
1728	        # Use ripgrep to find all mentions of the data identifier
1729	        rg_result = subprocess.run(
1730	            ["rg", "-n", "-i", "--type", "py", data_identifier, repo_path],
1731	            capture_output=True,
1732	            text=True,
1733	            cwd=working_directory
1734	        )
1735	        
1736	        if rg_result.returncode != 0:
1737	            return f"No occurrences found for data identifier: {data_identifier}"
1738	        
1739	        # Parse occurrences and categorize them
1740	        occurrences = []
1741	        for line in rg_result.stdout.split('\n'):
1742	            if ':' in line:
1743	                parts = line.split(':', 2)
1744	                if len(parts) >= 3:
1745	                    file_path = parts[0]
1746	                    line_number = parts[1]
1747	                    content = parts[2].strip()
1748	                    
1749	                    # Categorize the occurrence
1750	                    category = "usage"
1751	                    if any(pattern in content.lower() for pattern in ['def ', 'class ', 'return ', '=']):
1752	                        if 'def ' in content:
1753	                            category = "function_parameter"
1754	                        elif 'return ' in content:
1755	                            category = "return_value"
1756	                        elif '=' in content and data_identifier in content.split('=')[0]:
1757	                            category = "assignment"
1758	                        else:
1759	                            category = "definition"
1760	                    
1761	                    occurrences.append({
1762	                        'file': file_path,
1763	                        'line': line_number,
1764	                        'content': content,
1765	                        'category': category
1766	                    })
1767	        
1768	        # Group by category
1769	        categories = {}
1770	        for occ in occurrences:
1771	            cat = occ['category']
1772	            if cat not in categories:
1773	                categories[cat] = []
1774	            categories[cat].append(occ)
1775	        
1776	        # Get CodeRank data for prioritization
1777	        try:
1778	            coderank_results = calculate_coderank(repo_path=repo_path)
1779	            module_scores = coderank_results["module_ranks"]
1780	        except:
1781	            module_scores = {}
1782	        
1783	        # Analyze each category
1784	        for category, items in categories.items():
1785	            output_lines.append(f"\n=== {category.replace('_', ' ').title()} ===")
1786	            
1787	            # Sort by importance if possible
1788	            scored_items = []
1789	            for item in items:
1790	                module_fqn = path_to_module_fqn(os.path.join(repo_path, item['file']), repo_path)
1791	                score = module_scores.get(module_fqn, 0) if module_fqn else 0
1792	                scored_items.append((item, score))
1793	            
1794	            scored_items.sort(key=lambda x: x[1], reverse=True)
1795	            
1796	            for item, score in scored_items[:10]:  # Show top 10 per category
1797	                rel_path = os.path.relpath(item['file'], repo_path)
1798	                importance = f" (importance: {score:.4f})" if score > 0 else ""
1799	                output_lines.append(f"  • {rel_path}:{item['line']}{importance}")
1800	                output_lines.append(f"    {item['content']}")
1801	        
1802	        # If include_transformations, look for transformation patterns
1803	        if include_transformations:
1804	            output_lines.append(f"\n=== Data Transformations ===")
1805	            transform_patterns = [
1806	                f"{data_identifier}.transform",
1807	                f"process_{data_identifier}",
1808	                f"convert_{data_identifier}",
1809	                f"format_{data_identifier}",
1810	                f"validate_{data_identifier}"
1811	            ]
1812	            
1813	            transformations_found = []
1814	            for pattern in transform_patterns:
1815	                transform_result = subprocess.run(
1816	                    ["rg", "-n", "-i", "--type", "py", pattern, repo_path],
1817	                    capture_output=True,
1818	                    text=True,
1819	                    cwd=working_directory
1820	                )
1821	                
1822	                if transform_result.returncode == 0:
1823	                    for line in transform_result.stdout.split('\n')[:5]:  # Top 5 matches
1824	                        if ':' in line:
1825	                            transformations_found.append(line)
1826	            
1827	            if transformations_found:
1828	                for transform in transformations_found:
1829	                    output_lines.append(f"  • {transform}")
1830	            else:
1831	                output_lines.append("  • No explicit transformation patterns found")
1832	        
1833	        # Note: Side effect analysis removed due to hardcoded patterns
1834	        # Users should use discover_side_effects tool for detailed side effect analysis
1835	        if show_side_effects:
1836	            output_lines.append(f"\n=== Side Effects Analysis ===")
1837	            output_lines.append("  • Use discover_side_effects tool for detailed side effect analysis")
1838	            output_lines.append("  • Provide custom side effect patterns for your specific use case")
1839	        
1840	        # Summary
1841	        output_lines.append(f"\n=== Summary ===")
1842	        output_lines.append(f"Total occurrences found: {len(occurrences)}")
1843	        output_lines.append(f"Categories: {', '.join(categories.keys())}")
1844	        output_lines.append(f"Files involved: {len(set(occ['file'] for occ in occurrences))}")
1845	        
1846	        return '\n'.join(output_lines)
1847	        
1848	    except Exception as e:
1849	        return f"Error in trace_data_flow: {str(e)}"
1850	
