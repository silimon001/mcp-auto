523	@mcp.tool()
524	async def search_memory(ctx: Context, query: str, top_k: int = 5) -> dict[str, Any]:
525	    """Perform a semantic search on the video memory.
526	
527	    Args:
528	        query: The natural language query to search for.
529	        top_k: The number of top results to retrieve.
530	
531	    Returns:
532	        Status dictionary with search results or error information.
533	    """
534	    try:
535	        if not _server_state.retriever:
536	            return {
537	                "status": "error",
538	                "message": "No video memory loaded. Call build_video or load_video_memory first."
539	            }
540	
541	        # Perform search with stdout redirected to prevent embedding model output
542	        with redirect_stdout(sys.stderr):
543	            results = _server_state.retriever.search(query, top_k=top_k)
544	
545	        if results is None:
546	            return {
547	                "status": "error",
548	                "message": "Search returned None - retriever may be corrupted. Try loading or rebuilding the memory."
549	            }
550	
551	        logger.info(f"Search completed for query: '{query}' with {len(results)} results")
552	
553	        # Include current memory info in response
554	        current_memory = "Unknown"
555	        if _server_state.current_video_path:
556	            current_memory = os.path.basename(os.path.splitext(_server_state.current_video_path)[0])
557	
558	        return {
559	            "status": "success",
560	            "query": query,
561	            "results": results,
562	            "current_memory": current_memory,
563	            "result_count": len(results)
564	        }
565	    except Exception as e:
566	        logger.error(f"Search failed for query '{query}': {e}")
567	        return {"status": "error", "message": str(e)}
