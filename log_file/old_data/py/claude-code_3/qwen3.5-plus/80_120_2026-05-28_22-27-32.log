276	async def _ensure_encoder() -> Any:
277	    """Ensure encoder is initialized."""
278	    await _ensure_server_initialized()
279	
280	    if not _check_memvid_available():
281	        raise RuntimeError("Memvid not available - please install memvid package")
282	
283	    if _server_state.encoder is None:
284	        if MemvidEncoder is None:
285	            raise RuntimeError("MemvidEncoder is not available. Please install the memvid package.")
286	        # Create encoder with stdout redirected to prevent progress bars
287	        with redirect_stdout(sys.stderr):
288	            _server_state.encoder = MemvidEncoder()
289	        logger.info("Created new MemvidEncoder instance")
290	
291	    return _server_state.encoder
