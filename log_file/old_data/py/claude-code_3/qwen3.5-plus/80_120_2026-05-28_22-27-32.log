283	async def handle_query_view(
284	    name: str, arguments: Optional[Dict[str, Any]] = None
285	) -> Sequence[
286	    Union[mcp_types.TextContent, mcp_types.ImageContent, mcp_types.EmbeddedResource]
287	]:
288	    """Tool handler to query data from a view with optional limit."""
289	    try:
290	        # Get Snowflake connection from connection manager
291	        conn = connection_manager.get_connection()
292	
293	        # Extract arguments
294	        database = arguments.get("database") if arguments else None
295	        schema = arguments.get("schema") if arguments else None
296	        view_name = arguments.get("view_name") if arguments else None
297	        limit = (
298	            int(arguments.get("limit", 10))
299	            if arguments and arguments.get("limit") is not None
300	            else 10
301	        )  # Default limit to 10 rows
302	
303	        if not database or not view_name:
304	            return [
305	                mcp_types.TextContent(
306	                    type="text",
307	                    text="Error: database and view_name parameters are required",
308	                )
309	            ]
310	
311	        # Use the provided schema or use default schema
312	        if schema:
313	            full_view_name = f"{database}.{schema}.{view_name}"
314	        else:
315	            # Get the current schema
316	            cursor = conn.cursor()
317	            cursor.execute("SELECT CURRENT_SCHEMA()")
318	            schema_result = cursor.fetchone()
319	            if schema_result:
320	                schema = schema_result[0]
321	                full_view_name = f"{database}.{schema}.{view_name}"
322	            else:
323	                return [
324	                    mcp_types.TextContent(
325	                        type="text", text="Error: Could not determine current schema"
326	                    )
327	                ]
328	
329	        # Execute query to get data from view
330	        cursor = conn.cursor()
331	        cursor.execute(f"SELECT * FROM {full_view_name} LIMIT {limit}")
332	
333	        # Get column names
334	        column_names = (
335	            [col[0] for col in cursor.description] if cursor.description else []
336	        )
337	
338	        # Process results
339	        rows = cursor.fetchall()
340	
341	        cursor.close()
342	        # Don't close the connection, just the cursor
343	
344	        if rows:
345	            # Format the results as a markdown table
346	            result = f"## Data from {full_view_name} (Showing {len(rows)} rows)\n\n"
347	
348	            # Create header row
349	            result += "| " + " | ".join(column_names) + " |\n"
350	            result += "| " + " | ".join(["---" for _ in column_names]) + " |\n"
351	
352	            # Add data rows
353	            for row in rows:
354	                formatted_values = []
355	                for val in row:
356	                    if val is None:
357	                        formatted_values.append("NULL")
358	                    else:
359	                        # Format the value as string and escape any pipe characters
360	                        formatted_values.append(str(val).replace("|", "\\|"))
361	                result += "| " + " | ".join(formatted_values) + " |\n"
362	
363	            return [mcp_types.TextContent(type="text", text=result)]
364	        else:
365	            return [
366	                mcp_types.TextContent(
367	                    type="text",
368	                    text=f"No data found in view {full_view_name} or the view is empty.",
369	                )
370	            ]
371	
372	    except Exception as e:
373	        return [
374	            mcp_types.TextContent(type="text", text=f"Error querying view: {str(e)}")
375	        ]
