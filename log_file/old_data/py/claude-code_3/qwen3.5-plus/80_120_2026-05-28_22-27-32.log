1501	@mcp.tool()
1502	def change_propagation_analysis(
1503	    repo_path: str,
1504	    changed_module: str,
1505	    days_back: int = 90,
1506	    include_test_impact: bool = True
1507	) -> str:
1508	    """
1509	    Analyze how changes in one module historically propagate to others.
1510	    Uses commit history to predict ripple effects of changes.
1511	    
1512	    Args:
1513	        repo_path: Repository path
1514	        changed_module: Module to analyze (e.g., 'src.auth.user')
1515	        days_back: Days of history to analyze
1516	        include_test_impact: Include analysis of test file changes
1517	    
1518	    Returns:
1519	        Analysis of likely modules to be affected by changes
1520	    """
1521	    try:
1522	        # Get CodeRank data
1523	        coderank_results = calculate_coderank(repo_path=repo_path)
1524	        module_scores = coderank_results["module_ranks"]
1525	        import_graph = coderank_results["import_graph"]
1526	        
1527	        if changed_module not in module_scores:
1528	            return f"Module '{changed_module}' not found. Available modules: {', '.join(list(module_scores.keys())[:10])}..."
1529	        
1530	        since_date = (datetime.now() - timedelta(days=days_back)).strftime('%Y-%m-%d')
1531	        
1532	        # Find commits that touched the target module
1533	        module_file = coderank_results["module_map"].get(changed_module)
1534	        if not module_file:
1535	            return f"Could not find file for module {changed_module}"
1536	        
1537	        rel_module_file = os.path.relpath(module_file, repo_path)
1538	        
1539	        # Get commits that changed this module
1540	        git_cmd = [
1541	            "git", "-C", repo_path, "log",
1542	            f"--since={since_date}",
1543	            "--format=%H",
1544	            "--", rel_module_file
1545	        ]
1546	        
1547	        result = subprocess.run(git_cmd, capture_output=True, text=True)
1548	        if result.returncode != 0:
1549	            return f"Error getting git log: {result.stderr}"
1550	        
1551	        target_commits = result.stdout.strip().split('\n')
1552	        if not target_commits or not target_commits[0]:
1553	            return f"No commits found for module {changed_module} in the last {days_back} days"
1554	        
1555	        # For each commit, find what else changed
1556	        propagation_data: Dict[str, PropagationData] = defaultdict(create_propagation_data)
1557	        
1558	        for commit_hash in target_commits:
1559	            # Get all files changed in this commit
1560	            files_cmd = [
1561	                "git", "-C", repo_path, "show",
1562	                "--name-only",
1563	                "--format=",
1564	                commit_hash
1565	            ]
1566	            
1567	            files_result = subprocess.run(files_cmd, capture_output=True, text=True)
1568	            if files_result.returncode == 0:
1569	                changed_files = files_result.stdout.strip().split('\n')
1570	                
1571	                for filepath in changed_files:
1572	                    if filepath and filepath.endswith('.py') and filepath != rel_module_file:
1573	                        abs_filepath = os.path.join(repo_path, filepath)
1574	                        other_module = path_to_module_fqn(abs_filepath, repo_path)
1575	                        
1576	                        if other_module:
1577	                            data = propagation_data[other_module]
1578	                            data['co_change_count'] += 1
1579	                            data['commits'].append(commit_hash[:7])
1580	                            data['module_score'] = module_scores.get(other_module, 0)
1581	                            
1582	                            # Check if it's a test file
1583	                            if 'test' in filepath.lower():
1584	                                data['is_test'] = True
1585	                            
1586	                            # Check if there's an import relationship
1587	                            if (other_module in import_graph.successors(changed_module) or
1588	                                changed_module in import_graph.successors(other_module)):
1589	                                data['is_import_related'] = True
1590	        
1591	        # Calculate propagation scores
1592	        propagation_scores = []
1593	        for module, data in propagation_data.items():
1594	            # Skip tests if not requested
1595	            if not include_test_impact and data['is_test']:
1596	                continue
1597	            
1598	            # Calculate likelihood score
1599	            propagation_score = (
1600	                data['co_change_count'] * 10 +                    # Frequency
1601	                (50 if data['is_import_related'] else 0) +        # Import relationship
1602	                data['module_score'] * 100                        # Module importance
1603	            )
1604	            
1605	            propagation_scores.append({
1606	                'module': module,
1607	                'score': propagation_score,
1608	                'co_changes': data['co_change_count'],
1609	                'probability': data['co_change_count'] / len(target_commits),
1610	                'is_import_related': data['is_import_related'],
1611	                'is_test': data['is_test'],
1612	                'module_importance': data['module_score']
1613	            })
1614	        
1615	        # Sort by score
1616	        propagation_scores.sort(key=lambda x: x['score'], reverse=True)
1617	        
1618	        # Format output
1619	        output_lines = ["=== Change Propagation Analysis ===\n"]
1620	        output_lines.append(f"Target Module: {changed_module}")
1621	        output_lines.append(f"Module Importance: {module_scores[changed_module]:.4f}")
1622	        output_lines.append(f"Analysis Period: Last {days_back} days")
1623	        output_lines.append(f"Commits analyzed: {len(target_commits)}")
1624	        output_lines.append(f"Include test impact: {include_test_impact}\n")
1625	        
1626	        # Direct dependencies from import graph
1627	        direct_importers = list(import_graph.predecessors(changed_module))
1628	        direct_imports = list(import_graph.successors(changed_module))
1629	        
1630	        output_lines.append("Direct Dependencies:")
1631	        output_lines.append(f"  • Imports from {changed_module}: {len(direct_importers)} modules")
1632	        output_lines.append(f"  • {changed_module} imports: {len(direct_imports)} modules\n")
1633	        
1634	        output_lines.append("Likely Affected Modules (based on historical patterns):")
1635	        output_lines.append(f"{'Module'.ljust(35)} | {'Likelihood'.rjust(10)} | {'Co-changes'.rjust(10)} | {'Import Link'} | {'Type'}")
1636	        output_lines.append("-" * 85)
1637	        
1638	        for prop in propagation_scores[:20]:
1639	            import_marker = "Yes" if prop['is_import_related'] else "No"
1640	            module_type = "Test" if prop['is_test'] else "Code"
1641	            
1642	            output_lines.append(
1643	                f"{prop['module'][:35].ljust(35)} | "
1644	                f"{prop['probability']:10.1%} | "
1645	                f"{prop['co_changes']:10d} | "
1646	                f"{import_marker:11} | "
1647	                f"{module_type}"
1648	            )
1649	        
1650	        # Add insights
1651	        output_lines.append("\n=== Propagation Insights ===")
1652	        
1653	        # High probability changes
1654	        high_prob = [p for p in propagation_scores if p['probability'] > 0.5]
1655	        if high_prob:
1656	            output_lines.append(f"\n• High probability ripple effects ({len(high_prob)} modules):")
1657	            for prop in high_prob[:5]:
1658	                reason = "import dependency" if prop['is_import_related'] else "historical coupling"
1659	                output_lines.append(f"  - {prop['module']} ({prop['probability']:.0%} chance, {reason})")
1660	        
1661	        # Test impact
1662	        if include_test_impact:
1663	            test_impacts = [p for p in propagation_scores if p['is_test']]
1664	            if test_impacts:
1665	                output_lines.append(f"\n• Test files likely to need updates ({len(test_impacts)} files):")
1666	                for prop in test_impacts[:5]:
1667	                    output_lines.append(f"  - {prop['module']} ({prop['probability']:.0%} historical correlation)")
1668	        
1669	        # Import-related changes
1670	        import_related = [p for p in propagation_scores if p['is_import_related']]
1671	        if import_related:
1672	            output_lines.append(f"\n• Import-dependent modules ({len(import_related)} modules):")
1673	            for prop in import_related[:5]:
1674	                output_lines.append(f"  - {prop['module']} (direct import relationship)")
1675	        
1676	        # Risk assessment
1677	        output_lines.append("\n=== Change Risk Assessment ===")
1678	        output_lines.append(f"• Estimated modules affected: {len([p for p in propagation_scores if p['probability'] > 0.3])}")
1679	        
1680	        return '\n'.join(output_lines)
1681	        
1682	    except Exception as e:
1683	        return f"Error in change_propagation_analysis: {str(e)}"
