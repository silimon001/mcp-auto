188	    return f"Added task '{task_text}' to {os.path.basename(task_file)}"
189	
190	@mcp.tool()
191	async def mark_task_complete(
192	    description: str,
193	    task_number: int,
194	    repo_path: str = ".",
195	    section: str = "Tasks"
196	) -> str:
197	    """Mark a specific task as completed.
198	    
199	    Args:
200	        description: The description identifier of the task list file
201	        task_number: The number of the task to mark as complete
202	        repo_path: Path to the repository root (defaults to current directory)
203	        section: Which section the task is in (defaults to "Tasks")
204	    
205	    Returns:
206	        Updated markdown task list
207	    """
208	    # Find the task file
209	    task_file, content = find_task_file(description, repo_path)
210	    if not task_file:
211	        return f"Error: Could not find task list with description '{description}'"
212	    
213	    lines = content.split('\n')
214	    section_header = f"## {section}"
215	    
216	    # Find the section
217	    section_index = -1
218	    for i, line in enumerate(lines):
219	        if line.strip() == section_header:
220	            section_index = i
221	            break
222	    
223	    if section_index == -1:
224	        return f"Error: Section '{section}' not found in task list"
225	    
226	    # Find the task
227	    task_index = -1
228	    current_task = 0
229	    
230	    for i in range(section_index + 1, len(lines)):
231	        if lines[i].startswith('#'):
232	            break
233	            
234	        task_match = re.match(r'^(\d+)\.\s+\[[ x]\]', lines[i])
235	        if task_match:
236	            current_task += 1
237	            if current_task == task_number:
238	                task_index = i
239	                break
240	    
241	    if task_index == -1:
242	        return f"Error: Task {task_number} not found in section '{section}'"
243	    
244	    # Update the task status
245	    lines[task_index] = re.sub(r'^\d+\.\s+\[ \]', f"{task_number}. [x]", lines[task_index])
246	    
247	    updated_content = '\n'.join(lines)
248	    
249	    # Save updated content
250	    with open(task_file, 'w') as file:
251	        file.write(updated_content)
252	    
253	    return f"Marked task {task_number} as complete in {os.path.basename(task_file)}"
254	
255	@mcp.tool()
256	async def check_all_tasks_complete(
257	    description: str,
258	    repo_path: str = ".",
259	) -> str:
260	    """Check if all tasks are complete and mark the task list as completed.
261	    
262	    Args:
263	        description: The description identifier of the task list file
264	        repo_path: Path to the repository root (defaults to current directory)
265	        
266	    Returns:
267	        Message indicating if the task list was marked as completed
268	    """
269	    # Find the task file
270	    task_file, content = find_task_file(description, repo_path)
271	    if not task_file:
272	        return f"Error: Could not find task list with description '{description}'"
273	    
274	    # Check if all tasks are complete
275	    all_tasks_complete = True
276	    incomplete_task_count = 0
277	    
278	    # Find all task lines
279	    task_matches = re.finditer(r'^\d+\.\s+\[([ x])\]', content, re.MULTILINE)
280	    for match in task_matches:
281	        if match.group(1) == ' ':  # Unchecked box
282	            all_tasks_complete = False
283	            incomplete_task_count += 1
284	    
285	    if not all_tasks_complete:
286	        return f"Task list has {incomplete_task_count} incomplete tasks. Cannot mark as completed."
287	    
288	    # If all tasks are complete, rename the file with the ✅ prefix
289	    filename = os.path.basename(task_file)
290	    if not filename.startswith(COMPLETED_PREFIX):
291	        task_dir = os.path.dirname(task_file)
292	        new_filename = f"{COMPLETED_PREFIX}{filename}"
293	        new_file_path = os.path.join(task_dir, new_filename)
294	        
295	        os.rename(task_file, new_file_path)
296	        return f"All tasks complete! Renamed task list to {new_filename}"
297	    else:
298	        return "All tasks are already complete and the list is marked as completed."
299	
300	@mcp.tool()
301	async def list_task_files(
302	    repo_path: str = ".",
303	    include_completed: bool = True
304	) -> str:
305	    """List all task files in the .tasks directory.
306	    
307	    Args:
308	        repo_path: Path to the repository root (defaults to current directory)
309	        include_completed: Whether to include completed task lists
310	        
311	    Returns:
312	        List of task files with their completion status
313	    """
314	    tasks_dir = os.path.join(repo_path, TASKS_FOLDER)
315	    if not os.path.exists(tasks_dir):
316	        return "No .tasks directory exists yet."
317	    
318	    # Get list of markdown files
319	    task_files = []
320	    for file in os.listdir(tasks_dir):
321	        if file.endswith('.md'):
322	            is_completed = file.startswith(COMPLETED_PREFIX)
323	            if include_completed or not is_completed:
324	                task_files.append((file, is_completed))
325	    
326	    if not task_files:
327	        return "No task lists found."
328	    
329	    # Format the output
330	    result = "## Task Lists\n\n"
331	    for filename, is_completed in sorted(task_files):
332	        status = "✅ Complete" if is_completed else "⏳ In Progress"
333	        description = filename.replace(COMPLETED_PREFIX, "").replace(".md", "")
334	        result += f"- **{description}**: {status}\n"
335	    
336	    return result
337	
338	def find_task_file(description: str, repo_path: str) -> Tuple[Optional[str], Optional[str]]:
339	    """Find a task file by its description.
340	    
341	    Args:
342	        description: The description identifier of the task list file
343	        repo_path: Path to the repository root
344	        
345	    Returns:
346	        Tuple of (file_path, content) or (None, None) if not found
347	    """
348	    tasks_dir = os.path.join(repo_path, TASKS_FOLDER)
349	    if not os.path.exists(tasks_dir):
350	        return None, None
351	    
352	    # Normalize description for comparison
353	    safe_description = description.lower().replace(" ", "-")
354	    safe_description = re.sub(r'[^a-z0-9\-]', '', safe_description)
355	    
356	    # Look for files that match the description
357	    for file in os.listdir(tasks_dir):
358	        if file.endswith('.md'):
359	            # Remove completion prefix and extension for comparison
360	            file_desc = file.replace(COMPLETED_PREFIX, "").replace(".md", "")
361	            if file_desc == safe_description:
362	                file_path = os.path.join(tasks_dir, file)
363	                with open(file_path, 'r') as f:
364	                    content = f.read()
365	                return file_path, content
366	    
367	    return None, None
368	
369	def extract_tasks(text: str) -> List[str]:
370	    """Extract tasks from the plan text.
371	    
372	    Looks for common patterns that indicate tasks in the text.
373	    
374	    Args:
375	        text: The plan text to parse
376	        
377	    Returns:
378	        A list of extracted tasks
379	    """
380	    tasks = []
381	    
382	    # Try to find numbered steps (1. Step one, 2. Step two)
383	    numbered_steps = re.findall(r'\b(\d+\.?\s*[A-Z].*?)(?=\b\d+\.|\n\n|$)', text, re.DOTALL)
384	    if numbered_steps:
385	        # Clean up the steps
386	        tasks = [re.sub(r'^\d+\.?\s*', '', step).strip() for step in numbered_steps]
387	        return tasks
388	    
389	    # Try to find bullet points
390	    bullet_points = re.findall(r'(?:^|\n)[*\-•]\s*(.*?)(?=\n[*\-•]|\n\n|$)', text, re.DOTALL)
391	    if bullet_points:
392	        tasks = [point.strip() for point in bullet_points]
393	        return tasks
394	    
395	    # Try to find sentences that contain task-like keywords
396	    task_sentences = re.findall(r'(?:need to|should|must|will|going to|let\'s|we can|I\'ll|can|todo|to-do|task)\s+([^\.]+\.)', text, re.IGNORECASE)
397	    if task_sentences:
398	        tasks = [sentence.strip() for sentence in task_sentences]
399	        return tasks
400	    
401	    # If all else fails, split by paragraphs and treat each as a potential task
402	    paragraphs = re.split(r'\n\s*\n', text)
403	    if paragraphs:
404	        # Filter out very short paragraphs and headers
405	        tasks = [p.strip() for p in paragraphs if len(p.strip()) > 10 and not p.strip().startswith('#')]
406	        return tasks
407	    
408	    return tasks
409	
410	def format_plan_sections(text: str) -> str:
411	    """Format the plan into structured sections if no clear tasks were found.
412	    
413	    Args:
414	        text: The plan text to format
415	        
416	    Returns:
417	        Formatted markdown with sections
418	    """
419	    # Look for markdown headers already in the text
420	    has_headers = bool(re.search(r'^#+\s+', text, re.MULTILINE))
421	    
422	    if has_headers:
423	        # If the text already has headers, preserve them
424	        return text
425	    
426	    # Otherwise try to identify sections
427	    sections = {
428	        "## Overview": [],
429	        "## Implementation Details": [],
430	        "## Next Steps": []
431	    }
432	    
433	    lines = text.split('\n')
434	    current_section = "## Overview"
435	    
436	    for line in lines:
437	        # Simple heuristic: Try to identify section breaks
438	        if re.match(r'^.*(overview|summary|about).*$', line, re.IGNORECASE):
439	            current_section = "## Overview"
440	            continue
441	        elif re.match(r'^.*(implementation|details|how to|approach).*$', line, re.IGNORECASE):
442	            current_section = "## Implementation Details"
443	            continue
444	        elif re.match(r'^.*(next steps|future|todo|to do).*$', line, re.IGNORECASE):
445	            current_section = "## Next Steps"
446	            continue
447	        
448	        # Add the line to the current section
449	        if line.strip():
450	            sections[current_section].append(line)
451	    
452	    # Build the final markdown
453	    result = ""
454	    for section, content in sections.items():
455	        if content:
456	            result += f"{section}\n\n"
457	            # Format as a list if it's the "Next Steps" section
458	            if section == "## Next Steps":
459	                for i, line in enumerate(content):
460	                    result += f"{i+1}. [ ] {line.strip()}\n"
461	            else:
462	                result += "\n".join(content) + "\n\n"
463	    
464	    return result
465	
466	if __name__ == "__main__":
467	    # Initialize and run the server
468	    mcp.run(transport='stdio') 

