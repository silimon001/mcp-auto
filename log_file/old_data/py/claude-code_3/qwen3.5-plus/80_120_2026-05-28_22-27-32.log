1	"""
2	Memvid MCP Server - An MCP server to expose Memvid functionalities to AI clients.
3	
4	A FastMCP server that provides video memory encoding, searching, and chat capabilities.
5	Includes Docker lifecycle management for automatic container setup and teardown.
6	"""
7	
8	import asyncio
9	import atexit
10	import glob
11	import json
12	import logging
13	import os
14	import signal
15	import sys
16	import warnings
17	from contextlib import redirect_stdout
18	
19	# from io import StringIO
20	from typing import Any, Optional
21	
22	from mcp.server.fastmcp import Context, FastMCP
23	
24	# Suppress ALL warnings to prevent JSON parsing errors BEFORE importing memvid
25	warnings.filterwarnings("ignore")
26	os.environ["PYTHONWARNINGS"] = "ignore"
27	os.environ["TRANSFORMERS_VERBOSITY"] = "error"
28	os.environ["TOKENIZERS_PARALLELISM"] = "false"
29	os.environ["HF_HUB_DISABLE_PROGRESS_BARS"] = "1"
30	os.environ["HF_HUB_DISABLE_SYMLINKS_WARNING"] = "1"
31	os.environ["TQDM_DISABLE"] = "1"
32	
33	# Redirect stdout for the entire process to prevent any library output
34	class StderrRedirect:
35	    def __init__(self):
36	        self.buffer = sys.stderr.buffer if hasattr(sys.stderr, 'buffer') else None
37	
38	    def write(self, s):
39	        sys.stderr.write(s)
40	
41	    def flush(self):
42	        sys.stderr.flush()
43	
44	    def __getattr__(self, name):
45	        # Delegate any other attributes to stderr
46	        return getattr(sys.stderr, name)
47	
48	# Store original stdout for MCP communication
49	_original_stdout = sys.stdout
50	
51	# DON'T redirect stdout globally - this breaks MCP communication!
52	# Instead, we'll redirect only during specific memvid operations
