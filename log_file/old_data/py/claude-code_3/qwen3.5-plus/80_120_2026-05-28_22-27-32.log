70	def tool_xml(tool_name: str, payload: Any, *, error: bool = False) -> str:
71	    """Format MCP tool output as one concise XML block."""
72	    tag_name = TOOL_XML_TAGS.get(tool_name, tool_name)
73	    attrs = ' error="true"' if error else ""
74	    text = payload if isinstance(payload, str) else json.dumps(payload, default=str, separators=(",", ":"))
75	    return f"<{tag_name}{attrs}>{escape_xml_text(text, quote=False)}</{tag_name}>"
