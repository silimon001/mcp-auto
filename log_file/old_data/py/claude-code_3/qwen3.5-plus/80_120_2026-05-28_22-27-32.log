511	# Function to run the server with stdio interface
512	def run_stdio_server() -> None:
513	    """Run the MCP server using stdin/stdout for communication."""
514	
515	    async def run() -> None:
516	        server = create_server()
517	
518	        # Register all the Snowflake tools
519	        @server.call_tool()
520	        async def call_tool(
521	            name: str, arguments: Optional[Dict[str, Any]] = None
522	        ) -> Sequence[
523	            Union[
524	                mcp_types.TextContent,
525	                mcp_types.ImageContent,
526	                mcp_types.EmbeddedResource,
527	            ]
528	        ]:
529	            if name == "list_databases":
530	                return await handle_list_databases(name, arguments)
531	            elif name == "list_views":
532	                return await handle_list_views(name, arguments)
533	            elif name == "describe_view":
534	                return await handle_describe_view(name, arguments)
535	            elif name == "query_view":
536	                return await handle_query_view(name, arguments)
537	            elif name == "execute_query":
538	                return await handle_execute_query(name, arguments)
539	            else:
540	                return [
541	                    mcp_types.TextContent(type="text", text=f"Unknown tool: {name}")
542	                ]
543	
544	        # Create tool definitions for all Snowflake tools
545	        @server.list_tools()
546	        async def list_tools() -> List[mcp_types.Tool]:
547	            return [
548	                mcp_types.Tool(
549	                    name="list_databases",
550	                    description="List all accessible Snowflake databases",
551	                    inputSchema={"type": "object", "properties": {}, "required": []},
552	                ),
553	                mcp_types.Tool(
554	                    name="list_views",
555	                    description="List all views in a specified database and schema",
556	                    inputSchema={
557	                        "type": "object",
558	                        "properties": {
559	                            "database": {
560	                                "type": "string",
561	                                "description": "The database name (required)",
562	                            },
563	                            "schema": {
564	                                "type": "string",
565	                                "description": "The schema name (optional, will use current schema if not provided)",
566	                            },
567	                        },
568	                        "required": ["database"],
569	                    },
570	                ),
571	                mcp_types.Tool(
572	                    name="describe_view",
573	                    description="Get detailed information about a specific view including columns and SQL definition",
574	                    inputSchema={
575	                        "type": "object",
576	                        "properties": {
577	                            "database": {
578	                                "type": "string",
579	                                "description": "The database name (required)",
580	                            },
581	                            "schema": {
582	                                "type": "string",
583	                                "description": "The schema name (optional, will use current schema if not provided)",
584	                            },
585	                            "view_name": {
586	                                "type": "string",
587	                                "description": "The name of the view to describe (required)",
588	                            },
589	                        },
590	                        "required": ["database", "view_name"],
591	                    },
592	                ),
593	                mcp_types.Tool(
594	                    name="query_view",
595	                    description="Query data from a view with an optional row limit",
596	                    inputSchema={
597	                        "type": "object",
598	                        "properties": {
599	                            "database": {
600	                                "type": "string",
601	                                "description": "The database name (required)",
602	                            },
603	                            "schema": {
604	                                "type": "string",
605	                                "description": "The schema name (optional, will use current schema if not provided)",
606	                            },
607	                            "view_name": {
608	                                "type": "string",
609	                                "description": "The name of the view to query (required)",
610	                            },
611	                            "limit": {
612	                                "type": "integer",
613	                                "description": "Maximum number of rows to return (default: 10)",
614	                            },
615	                        },
616	                        "required": ["database", "view_name"],
617	                    },
618	                ),
619	                mcp_types.Tool(
620	                    name="execute_query",
621	                    description="Execute a read-only SQL query against Snowflake",
622	                    inputSchema={
623	                        "type": "object",
624	                        "properties": {
625	                            "query": {
626	                                "type": "string",
627	                                "description": "The SQL query to execute (supports SELECT, SHOW, DESCRIBE, EXPLAIN, and WITH statements)",
628	                            },
629	                            "database": {
630	                                "type": "string",
631	                                "description": "The database to use (optional)",
632	                            },
