743	@mcp.tool()
744	def smart_code_search(
745	    keyword: str,
746	    repo_path: str,
747	    working_directory: str,
748	    rank_results: bool = True,
749	    context_lines: int = 3,
750	    max_results: int = 20
751	) -> str:
752	    """
753	    Enhanced search that combines ripgrep with CodeRank to prioritize results
754	    from more important modules.
755	    
756	    Args:
757	        keyword: Search term (supports regex)
758	        repo_path: Repository path
759	        working_directory: Working directory (absolute path)
760	        rank_results: Sort results by module importance
761	        context_lines: Lines of context around matches
762	        max_results: Maximum number of results to return
763	    
764	    Returns:
765	        Search results prioritized by code importance
766	    """
767	    try:
768	        # Get CodeRank scores if ranking is enabled
769	        module_scores = {}
770	        if rank_results:
771	            coderank_results = calculate_coderank(repo_path=repo_path)
772	            module_scores = coderank_results["module_ranks"]
773	        
774	        # Run ripgrep search
775	        rg_result = subprocess.run(
776	            [
777	                "rg", "-n", "-i",
778	                "-B", str(context_lines), "-A", str(context_lines),
779	                "--json",  # Use JSON output for easier parsing
780	                keyword, repo_path
781	            ],
782	            capture_output=True,
783	            text=True,
784	            cwd=working_directory
785	        )
786	        
787	        if rg_result.returncode != 0:
788	            # Try without JSON for better error message
789	            simple_result = subprocess.run(
790	                ["rg", "-n", "-i", keyword, repo_path],
791	                capture_output=True,
792	                text=True,
793	                cwd=working_directory
794	            )
795	            if simple_result.returncode != 0:
796	                return f"No results found for keyword: {keyword}"
797	        
798	        # Parse ripgrep JSON output
799	        matches = []
800	        current_match = None
801	        
802	        for line in rg_result.stdout.split('\n'):
803	            if not line.strip():
804	                continue
805	            
806	            try:
807	                data = json.loads(line)
808	                if data.get('type') == 'match':
809	                    file_path = data['data']['path']['text']
810	                    line_number = data['data']['line_number']
811	                    line_content = data['data']['lines']['text'].rstrip()
812	                    
813	                    # Convert file path to module name
814	                    module_name = path_to_module_fqn(file_path, repo_path)
815	                    if not module_name:
816	                        # For non-Python files or files that couldn't be converted
817	                        module_name = os.path.relpath(file_path, repo_path)
818	                    
819	                    # Get module score
820	                    score = module_scores.get(module_name, 0) if rank_results else 0
821	                    
822	                    if current_match and current_match['file'] == file_path and \
823	                       abs(current_match['line_number'] - line_number) <= context_lines + 1:
824	                        # Add to existing match context
825	                        current_match['context_lines'].append({
826	                            'line_number': line_number,
827	                            'content': line_content,
828	                            'is_match': True
829	                        })
830	                        current_match['match_count'] += 1
831	                    else:
832	                        # Save previous match and start new one
833	                        if current_match:
834	                            matches.append(current_match)
835	                        
836	                        current_match = {
837	                            'file': file_path,
838	                            'module': module_name,
839	                            'score': score,
840	                            'line_number': line_number,
841	                            'match_count': 1,
842	                            'context_lines': [{
843	                                'line_number': line_number,
844	                                'content': line_content,
845	                                'is_match': True
846	                            }]
847	                        }
848	                
849	                elif data.get('type') == 'context' and current_match:
850	                    line_number = data['data']['line_number']
851	                    line_content = data['data']['lines']['text'].rstrip()
852	                    current_match['context_lines'].append({
853	                        'line_number': line_number,
854	                        'content': line_content,
855	                        'is_match': False
856	                    })
857	            except json.JSONDecodeError:
858	                continue
859	        
860	        # Don't forget the last match
861	        if current_match:
862	            matches.append(current_match)
863	        
864	        # Sort matches by score if ranking is enabled
865	        if rank_results:
866	            matches.sort(key=lambda x: (x['score'], x['match_count']), reverse=True)
867	        
868	        # Limit results
869	        matches = matches[:max_results]
870	        
871	        # Format output
872	        output_lines = ["=== Smart Code Search Results ===\n"]
873	        output_lines.append(f"Search term: '{keyword}'")
874	        output_lines.append(f"Repository: {repo_path}")
875	        output_lines.append(f"Ranking: {'Enabled (by module importance)' if rank_results else 'Disabled'}")
876	        output_lines.append(f"Found {len(matches)} matches (showing up to {max_results})\n")
877	        
878	        for i, match in enumerate(matches, 1):
879	            output_lines.append(f"--- Match {i}/{len(matches)} ---")
880	            output_lines.append(f"File: {os.path.relpath(match['file'], repo_path)}")
881	            output_lines.append(f"Module: {match['module']}")
882	            if rank_results and match['score'] > 0:
883	                output_lines.append(f"Importance Score: {match['score']:.4f}")
884	            output_lines.append(f"Matches in context: {match['match_count']}")
885	            output_lines.append("")
886	            
887	            # Sort context lines by line number
888	            context = sorted(match['context_lines'], key=lambda x: x['line_number'])
889	
890	            for ctx in context:
891	                line_marker = ">>>" if ctx['is_match'] else "   "
892	                output_lines.append(f"{line_marker} {ctx['line_number']:5d}: {ctx['content']}")
893	            
894	            output_lines.append("")  # Empty line between matches
895	        
896	        # Add summary if ranking was used
897	        if rank_results and matches:
898	            output_lines.append("\n=== Search Insights ===")
899	            
900	            # Find high-importance matches
901	            high_importance = [m for m in matches if m['score'] > 0.01]
902	            if high_importance:
903	                output_lines.append(f"• Found {len(high_importance)} matches in high-importance modules")
904	                top_modules = list(set(m['module'] for m in high_importance[:5]))
905	                output_lines.append(f"• Top modules with matches: {', '.join(top_modules)}")
906	            
907	            # Find files with multiple matches
908	            file_match_counts = defaultdict(int)
909	            for m in matches:
910	                file_match_counts[m['file']] += m['match_count']
911	            
912	            multi_match_files = [(f, c) for f, c in file_match_counts.items() if c > 3]
913	            if multi_match_files:
914	                multi_match_files.sort(key=lambda x: x[1], reverse=True)
915	                output_lines.append(f"\n• Files with multiple matches:")
916	                for file, count in multi_match_files[:3]:
917	                    rel_path = os.path.relpath(file, repo_path)
918	                    output_lines.append(f"  - {rel_path}: {count} matches")
919	        
920	        return '\n'.join(output_lines)
921	        
922	    except Exception as e:
923	        return f"Error in smart_code_search: {str(e)}"
924	
