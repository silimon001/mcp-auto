83	@mcp.tool()
84	async def search_datasets(
85	    query: str,
86	    k: int = 5,
87	    sort_by: str = "similarity",
88	    min_likes: int = 0,
89	    min_downloads: int = 0
90	) -> str:
91	    """
92	    Search for datasets using semantic/similarity search based on a text query.
93	    
94	    This uses AI-powered semantic search to find datasets whose descriptions 
95	    are semantically similar to your query, not just keyword matching.
96	    
97	    Args:
98	        query: Search query text (natural language description of what you're looking for)
99	        k: Number of results to return (1-100)
100	        sort_by: Sort method for results (similarity, likes, downloads, trending)
101	        min_likes: Minimum likes filter
102	        min_downloads: Minimum downloads filter
103	    """
104	    client = await get_client()
105	    params = {
106	        "query": query,
107	        "k": k,
108	        "sort_by": sort_by,
109	        "min_likes": min_likes,
110	        "min_downloads": min_downloads
111	    }
112	    
113	    response = await client.get(f"{base_url}/search/datasets", params=params)
114	    response.raise_for_status()
115	    data = response.json()
116	    
117	    return format_dataset_results(data)
