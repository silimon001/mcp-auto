39	def format_dataset_results(data: Dict[str, Any]) -> str:
40	    """Format dataset search results"""
41	    results = data.get("results", [])
42	    if not results:
43	        return "No datasets found."
44	    
45	    output = []
46	    for i, result in enumerate(results, 1):
47	        output.append(f"{i}. **{result['dataset_id']}**")
48	        output.append(f"   - Summary: {result['summary']}")
49	        output.append(f"   - Similarity: {result['similarity']:.3f}")
50	        output.append(f"   - Likes: {result['likes']:,} | Downloads: {result['downloads']:,}")
51	        output.append("")
52	    
53	    return "\n".join(output)
54	
55	def format_model_results(data: Dict[str, Any]) -> str:
56	    """Format model search results"""
57	    results = data.get("results", [])
58	    if not results:
59	        return "No models found."
60	    
61	    output = []
62	    for i, result in enumerate(results, 1):
63	        output.append(f"{i}. **{result['model_id']}**")
64	        output.append(f"   - Summary: {result['summary']}")
65	        output.append(f"   - Similarity: {result['similarity']:.3f}")
66	        output.append(f"   - Likes: {result['likes']:,} | Downloads: {result['downloads']:,}")
67	        if result.get('param_count') is not None and result['param_count'] > 0:
68	            # Format parameter count nicely
69	            param_count = result['param_count']
70	            if param_count >= 1_000_000_000:
71	                param_str = f"{param_count / 1_000_000_000:.1f}B"
72	            elif param_count >= 1_000_000:
73	                param_str = f"{param_count / 1_000_000:.1f}M"
74	            elif param_count >= 1_000:
75	                param_str = f"{param_count / 1_000:.1f}K"
76	            else:
77	                param_str = str(param_count)
78	            output.append(f"   - Parameters: {param_str}")
79	        output.append("")
80	    
81	    return "\n".join(output)
