515	    ctx: Context, exchanges: list[Literal["Equity", "CME", "CFE", "Smalls"]] | None = None
516	) -> str:
517	    """
518	    Get exchange open/closed status, next open/close, holiday flags, and current NYC time.
519	    """
520	    if exchanges is None:
521	        exchanges = ["Equity"]
522	    session = get_session(ctx)
523	    market_sessions = await get_market_sessions(session, [ExchangeType(exchange) for exchange in exchanges])
524	
525	    if not market_sessions:
526	        raise ValueError(f"No market sessions found for exchanges: {exchanges}")
527	
528	    current_time = datetime.now(UTC)
529	    calendar = await get_market_holidays(session)
530	    is_holiday = current_time.date() in calendar.holidays
531	    is_half_day = current_time.date() in calendar.half_days
532	
533	    results: list[dict[str, Any]] = []
534	    for ms in market_sessions:
535	        result: dict[str, Any] = {"exchange": ms.instrument_collection, "status": ms.status.value}
536	
537	        if ms.status == MarketStatus.OPEN:
538	            if ms.close_at:
539	                result["close_at"] = ms.close_at.isoformat()
540	        else:
541	            open_at = _get_next_open_time(ms, current_time)
542	            if open_at:
543	                result["next_open"] = open_at.isoformat()
544	                result["time_until_open"] = humanize.naturaldelta(open_at - current_time)
545	            if is_holiday:
546	                result["is_holiday"] = True
547	            if is_half_day:
548	                result["is_half_day"] = True
549	
550	        results.append(result)
551	
552	    return tool_xml("market_status", {"current_time_nyc": now_in_new_york().isoformat(), "exchanges": results})
