96	def generate_xml_with_llm(description: str, diagram_name: str, prompt_template: str) -> str:
97	    """使用智谱AI生成draw.io XML内容"""
98	    try:
99	        logger.info("开始使用智谱AI生成架构图XML")
100	        client = get_zhipu_client()
101	        
102	        # 构建完整的提示词
103	        full_prompt = f"""{prompt_template}
104	
105	## 用户需求
106	用户想要绘制的系统架构描述：
107	{description}
108	
109	图表名称：{diagram_name}
110	
111	## 任务要求
112	请根据上述架构描述和提示词模板，生成完整的draw.io XML代码。
113	要求：
114	1. 严格遵循XML格式规范
115	2. 确保所有ID唯一且非空
116	3. 包含完整的图形元素和样式
117	4. 使用合适的颜色和布局
118	5. 只输出XML代码，不要包含任何其他文字说明
119	"""
120	        
121	        logger.info(f"发送请求到智谱AI，提示词长度: {len(full_prompt)}")
122	        
123	        # 调用智谱AI
124	        response = client.chat.completions.create(
125	            model="glm-4-flash",  # 使用免费模型
126	            messages=[
127	                {
128	                    "role": "user",
129	                    "content": full_prompt
130	                }
131	            ],
132	            temperature=0.7,
133	            max_tokens=4000
134	        )
135	        
136	        logger.info("智谱AI响应成功，开始处理返回内容")
137	        xml_content = response.choices[0].message.content.strip()
138	        logger.info(f"原始响应长度: {len(xml_content)}")
139	        
140	        # 清理可能的markdown代码块标记
141	        if xml_content.startswith('```xml'):
142	            xml_content = xml_content[6:]
143	            logger.info("移除了```xml标记")
144	        if xml_content.startswith('```'):
145	            xml_content = xml_content[3:]
146	            logger.info("移除了```标记")
147	        if xml_content.endswith('```'):
148	            xml_content = xml_content[:-3]
149	            logger.info("移除了结尾```标记")
150	        
151	        final_content = xml_content.strip()
152	        logger.info(f"最终XML内容长度: {len(final_content)}")
153	        
154	        # 验证XML内容是否包含实际的组件
155	        if '<mxCell id=' not in final_content or final_content.count('<mxCell') < 5:
156	            logger.warning("智谱AI生成的XML内容过于简单，使用回退方案")
157	            return generate_drawio_xml(description, diagram_name)
158	            
159	        return final_content
160	        
161	    except Exception as e:
162	        logger.error(f"调用智谱AI失败: {e}")
163	        logger.info("使用回退方案生成架构图")
164	        # 如果LLM调用失败，回退到原来的方法
165	        return generate_drawio_xml(description, diagram_name)
