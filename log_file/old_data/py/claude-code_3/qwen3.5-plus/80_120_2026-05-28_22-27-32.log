296	@mcp.tool()
297	async def get_model_safetensors_metadata(model_id: str, filename: str = "model.safetensors") -> str:
298	    """
299	    Get safetensors metadata for a HuggingFace model to understand model architecture and parameter count.
300	    
301	    This tool parses the safetensors file header to extract detailed information about:
302	    - Model parameter count and size breakdown by layer
303	    - Tensor shapes and data types (float16, bfloat16, etc.)
304	    - Layer names and architecture structure
305	    - Memory requirements and model size
306	    
307	    Useful for understanding model complexity, memory needs, and architectural details.
308	    
309	    Args:
310	        model_id: The model ID (e.g., 'username/model-name')
311	        filename: The safetensors filename (default: 'model.safetensors')
312	    
313	    Returns:
314	        JSON string with safetensors metadata including tensor shapes, parameter counts, and architecture info
315	    """
316	    client = await get_client()
317	    
318	    # Construct URL for safetensors metadata
319	    url = f"https://huggingface.co/{model_id}/raw/main/{filename}"
320	    
321	    try:
322	        # Make a HEAD request first to check if file exists
323	        head_response = await client.head(url)
324	        head_response.raise_for_status()
325	        
326	        # Get just the first 8 bytes to read the header length
327	        headers = {"Range": "bytes=0-7"}
328	        response = await client.get(url, headers=headers)
329	        response.raise_for_status()
330	        
331	        # Parse header length (first 8 bytes as little-endian uint64)
332	        header_length = struct.unpack('<Q', response.content)[0]
333	        
334	        # Now get the actual header
335	        headers = {"Range": f"bytes=8-{8 + header_length - 1}"}
336	        response = await client.get(url, headers=headers)
337	        response.raise_for_status()
338	        
339	        # Parse the JSON header
340	        header_data = json.loads(response.content.decode('utf-8'))
341	        
342	        # Format for better readability
343	        return json.dumps(header_data, indent=2)
344	        
345	    except Exception as e:
346	        # Try alternative filename patterns if the default fails
347	        alternative_files = [
348	            "model.safetensors.index.json",
349	            "pytorch_model.bin", 
350	            "model-00001-of-*.safetensors"
351	        ]
352	        
353	        if filename == "model.safetensors":
354	            # Try to get the safetensors index file which lists all the sharded files
355	            try:
356	                index_url = f"https://huggingface.co/{model_id}/raw/main/model.safetensors.index.json"
357	                response = await client.get(index_url)
358	                response.raise_for_status()
359	                index_data = response.json()
360	                
361	                # Return information about the model sharding
362	                result = {
363	                    "error": f"Single safetensors file not found. Model appears to be sharded.",
364	                    "index_metadata": index_data,
365	                    "available_files": list(set(index_data.get("weight_map", {}).values())),
366	                    "suggestion": "Try specifying a specific shard filename like 'model-00001-of-00002.safetensors'"
367	                }
368	                return json.dumps(result, indent=2)
369	                
370	            except:
