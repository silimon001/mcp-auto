484	  private async continueEditing(request: CallToolRequest): Promise<CallToolResult> {
485	    if (!this.ensureConfigured()) {
486	      throw new McpError(ErrorCode.InvalidRequest, "Gemini API token not configured. Use configure_gemini_token first.");
487	    }
488	
489	    if (!this.lastImagePath) {
490	      throw new McpError(ErrorCode.InvalidRequest, "No previous image found. Please generate or edit an image first, then use continue_editing for subsequent edits.");
491	    }
492	
493	    const { prompt, referenceImages } = request.params.arguments as { 
494	      prompt: string; 
495	      referenceImages?: string[];
496	    };
497	
498	    // 检查最后的图片文件是否存在
499	    try {
500	      await fs.access(this.lastImagePath);
501	    } catch {
502	      throw new McpError(ErrorCode.InvalidRequest, `Last image file not found at: ${this.lastImagePath}. Please generate a new image first.`);
503	    }
504	
505	    // Use editImage logic with lastImagePath
506	    
507	    return await this.editImage({
508	      method: "tools/call",
509	      params: {
510	        name: "edit_image",
511	        arguments: {
512	          imagePath: this.lastImagePath,
513	          prompt: prompt,
514	          referenceImages: referenceImages
515	        }
516	      }
517	    } as CallToolRequest);
518	  }
