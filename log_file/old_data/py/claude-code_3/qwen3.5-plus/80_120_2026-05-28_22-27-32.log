276	    # Search for emails
277	    @mcp.tool()
278	    async def search_emails(
279	        query: str,
280	        ctx: Context,
281	        folder: Optional[str] = None,
282	        criteria: str = "text",
283	        limit: int = 10,
284	    ) -> str:
285	        """Search for emails.
286	        
287	        Args:
288	            query: Search query
289	            folder: Folder to search in (None for all folders)
290	            criteria: Search criteria (text, from, to, subject, all, unseen, seen)
291	            limit: Maximum number of results
292	            ctx: MCP context
293	            
294	        Returns:
295	            JSON-formatted list of search results
296	        """
297	        client = get_client_from_context(ctx)
298	        
299	        # Define search criteria
300	        search_criteria_map = {
301	            "text": ["TEXT", query],
302	            "from": ["FROM", query],
303	            "to": ["TO", query],
304	            "subject": ["SUBJECT", query],
305	            "all": "ALL",
306	            "unseen": "UNSEEN",
307	            "seen": "SEEN",
308	            "today": "today",
309	            "week": "week",
310	            "month": "month",
311	        }
312	        
313	        if criteria.lower() not in search_criteria_map:
314	            return f"Invalid search criteria: {criteria}"
315	        
316	        search_criteria = search_criteria_map[criteria.lower()]
317	        
318	        folders_to_search = [folder] if folder else client.list_folders()
319	        results = []
320	        
321	        for current_folder in folders_to_search:
322	            try:
323	                # Search for emails
324	                uids = client.search(search_criteria, folder=current_folder)
325	                
326	                # Limit results and sort by newest first
327	                uids = sorted(uids, reverse=True)[:limit]
328	                
329	                if uids:
330	                    # Fetch emails
331	                    emails = client.fetch_emails(uids, folder=current_folder)
332	                    
333	                    # Create summaries
334	                    for uid, email_obj in emails.items():
335	                        results.append({
336	                            "uid": uid,
337	                            "folder": current_folder,
338	                            "from": str(email_obj.from_),
339	                            "to": [str(to) for to in email_obj.to],
340	                            "subject": email_obj.subject,
341	                            "date": email_obj.date.isoformat() if email_obj.date else None,
342	                            "flags": email_obj.flags,
343	                            "has_attachments": len(email_obj.attachments) > 0,
344	                        })
345	            except Exception as e:
346	                logger.warning(f"Error searching folder {current_folder}: {e}")
347	        
348	        # Sort results by date (newest first)
349	        results.sort(
350	            key=lambda x: x.get("date") or "0", 
351	            reverse=True
352	        )
353	        
354	        # Apply global limit
355	        results = results[:limit]
356	        
357	        return json.dumps(results, indent=2)
