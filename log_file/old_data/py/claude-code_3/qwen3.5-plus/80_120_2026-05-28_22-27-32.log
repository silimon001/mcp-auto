19	@mcp.tool()
20	def contextual_keyword_search(keyword: str, working_directory: str, num_context_lines: int = 2) -> str:
21	    """
22	    Search for a keyword in the current directory (wrapper around ripgrep).
23	
24	    Args:
25	        keyword (str): The keyword to search for (case insensitive).
26	        working_directory (str): The directory to search in. Use full absolute path.
27	        num_context_lines (int): The number of lines of context to return (both before and after the keyword). Default is 2.
28	
29	
30	    Returns:
31	        str: The file path and the lines of context around the keyword.
32	    """
33	    # use ripgrep to search for the keyword in the current directory
34	    result = subprocess.run(
35	        [
36	            "rg", "-n", "-i", 
37	            "-B", str(num_context_lines), "-A", str(num_context_lines), 
38	            keyword, working_directory
39	        ], 
40	        capture_output=True, text=True
41	    )
42	    if result.returncode == 0:
43	        return result.stdout
44	    else:
45	        return f"No results found for keyword: {keyword}"
