30	# Configure logging to stderr only with color support
31	class ColoredFormatter(logging.Formatter):
32	    """Custom formatter with colored output."""
33	    
34	    COLORS = {
35	        'DEBUG': '\033[94m',  # Blue
36	        'INFO': '\033[92m',   # Green
37	        'WARNING': '\033[93m', # Yellow
38	        'ERROR': '\033[91m',  # Red
39	        'CRITICAL': '\033[91m\033[1m',  # Bold Red
40	        'RESET': '\033[0m'    # Reset
41	    }
42	    
43	    def format(self, record):
44	        log_message = super().format(record)
45	        level_name = record.levelname
46	        if level_name in self.COLORS:
47	            return f"{self.COLORS[level_name]}{log_message}{self.COLORS['RESET']}"
48	        return log_message
49	
50	# Set up logger
51	logger = logging.getLogger("mcp_obsidian")
52	logger.setLevel(logging.DEBUG)
53	handler = logging.StreamHandler(sys.stderr)
54	formatter = ColoredFormatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
55	handler.setFormatter(formatter)
56	logger.addHandler(handler)
57	
58	# Initialize FastMCP server with proper configuration
59	mcp = FastMCP(
60	    name="Obsidian MCP Server",
61	    version=__version__,
62	    capabilities={
63	        "tools": True,
64	        "resources": True,
65	        "prompts": True
66	    }
67	)
68	
69	# Register prompts using decorators
70	@mcp.prompt("meeting-notes")
71	async def meeting_notes_prompt(
72	    title: str,
73	    date: str = "",
74	    participants: str = "",
75	    folder: str = "Meetings",
76	    tags: List[str] = None
77	) -> Dict[str, Any]:
78	    """Create a meeting note with the given details."""
79	    global client
80	    if not client:
81	        await initialize_client()
82	    if not date:
83	        date = datetime.now().strftime("%Y-%m-%d")
84	    if not folder.endswith("/"):
85	        folder += "/"
86	    folder_note_path = f"{folder}.folder"
87	    folder_note_content = f"# {folder.rstrip('/')}\nThis folder contains meeting notes."
88	    try:
