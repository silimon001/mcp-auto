557	  private ensureConfigured(): boolean {
558	    return this.config !== null && this.genAI !== null;
559	  }
560	
561	  private getMimeType(filePath: string): string {
562	    const ext = path.extname(filePath).toLowerCase();
563	    switch (ext) {
564	      case '.jpg':
565	      case '.jpeg':
566	        return 'image/jpeg';
567	      case '.png':
568	        return 'image/png';
569	      case '.webp':
570	        return 'image/webp';
571	      default:
572	        return 'image/jpeg';
573	    }
574	  }
575	
576	  private getImagesDirectory(): string {
577	    const platform = os.platform();
578	    
579	    if (platform === 'win32') {
580	      // Windows: Use Documents folder
581	      const homeDir = os.homedir();
582	      return path.join(homeDir, 'Documents', 'nano-banana-images');
583	    } else {
584	      // macOS/Linux: Use current directory or home directory if in system paths
585	      const cwd = process.cwd();
586	      const homeDir = os.homedir();
587	      
588	      // If in system directories, use home directory instead
589	      if (cwd.startsWith('/usr/') || cwd.startsWith('/opt/') || cwd.startsWith('/var/')) {
590	        return path.join(homeDir, 'nano-banana-images');
591	      }
592	      
593	      return path.join(cwd, 'generated_imgs');
594	    }
595	  }
596	
597	  private async saveConfig(): Promise<void> {
598	    if (this.config) {
599	      const configPath = path.join(process.cwd(), '.nano-banana-config.json');
600	      await fs.writeFile(configPath, JSON.stringify(this.config, null, 2));
601	    }
602	  }
603	
604	  private async loadConfig(): Promise<void> {
605	    // Try to load from environment variable first
606	    const envApiKey = process.env.GEMINI_API_KEY;
607	    if (envApiKey) {
608	      try {
609	        this.config = ConfigSchema.parse({ geminiApiKey: envApiKey });
610	        this.genAI = new GoogleGenAI({ apiKey: this.config.geminiApiKey });
611	        this.configSource = 'environment';
612	        return;
613	      } catch (error) {
614	        // Invalid API key in environment
615	      }
616	    }
617	    
618	    // Fallback to config file
619	    try {
620	      const configPath = path.join(process.cwd(), '.nano-banana-config.json');
621	      const configData = await fs.readFile(configPath, 'utf-8');
622	      const parsedConfig = JSON.parse(configData);
623	      
624	      this.config = ConfigSchema.parse(parsedConfig);
625	      this.genAI = new GoogleGenAI({ apiKey: this.config.geminiApiKey });
626	      this.configSource = 'config_file';
627	    } catch {
628	      // Config file doesn't exist or is invalid, that's okay
629	      this.configSource = 'not_configured';
630	    }
631	  }
632	
633	  public async run(): Promise<void> {
634	    await this.loadConfig();
635	    
636	    const transport = new StdioServerTransport();
637	    await this.server.connect(transport);
638	  }
639	}
