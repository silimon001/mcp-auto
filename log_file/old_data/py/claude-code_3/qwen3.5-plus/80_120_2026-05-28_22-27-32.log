425	    # Process meeting invite and generate a draft reply
426	    @mcp.tool()
427	    async def process_meeting_invite(
428	        folder: str,
429	        uid: int,
430	        ctx: Context,
431	        availability_mode: str = "random",
432	    ) -> dict:
433	        """Process a meeting invite email and create a draft reply.
434	        
435	        This tool orchestrates the full workflow:
436	        1. Identifies if the email is a meeting invite
437	        2. Checks calendar availability for the meeting time
438	        3. Generates an appropriate reply (accept/decline)
439	        4. Creates a MIME message for the reply
440	        5. Saves the reply as a draft
441	        
442	        Args:
443	            folder: Folder containing the invite email
444	            uid: UID of the invite email
445	            ctx: MCP context
446	            availability_mode: Mode for availability check (random, always_available, 
447	                              always_busy, business_hours, weekdays)
448	            
449	        Returns:
450	            Dictionary with the processing result:
451	              - status: "success", "not_invite", or "error"
452	              - message: Description of the result
453	              - draft_uid: UID of the saved draft (if successful)
454	              - draft_folder: Folder where the draft was saved (if successful)
455	              - availability: Whether the time slot was available
456	        """
457	        from imap_mcp.workflows.invite_parser import identify_meeting_invite_details
458	        from imap_mcp.workflows.calendar_mock import check_mock_availability
459	        from imap_mcp.workflows.meeting_reply import generate_meeting_reply_content
460	        from imap_mcp.smtp_client import create_reply_mime
461	
462	        client = get_client_from_context(ctx)
463	        result = {
464	            "status": "error",
465	            "message": "An error occurred during processing",
466	            "draft_uid": None,
467	            "draft_folder": None,
468	            "availability": None
469	        }
470	        
471	        try:
472	            # Step 1: Fetch the original email
473	            logger.info(f"Fetching email UID {uid} from folder {folder}")
474	            email_obj = client.fetch_email(uid, folder)
475	            
476	            if not email_obj:
477	                result["message"] = f"Email with UID {uid} not found in folder {folder}"
478	                return result
479	            
480	            # Step 2: Identify if it's a meeting invite
481	            logger.info(f"Analyzing email for meeting invite details: {email_obj.subject}")
482	            invite_result = identify_meeting_invite_details(email_obj)
483	            
484	            if not invite_result["is_invite"]:
485	                result["status"] = "not_invite"
486	                result["message"] = "The email is not a meeting invite"
487	                return result
488	            
489	            invite_details = invite_result["details"]
490	            
491	            # Step 3: Check calendar availability
492	            logger.info(f"Checking calendar availability for meeting: {invite_details['subject']}")
493	            availability_result = check_mock_availability(
494	                invite_details.get("start_time"),
495	                invite_details.get("end_time"),
496	                availability_mode
497	            )
498	            
499	            result["availability"] = availability_result["available"]
500	            
501	            # Step 4: Generate reply content
502	            logger.info(f"Generating {'accept' if availability_result['available'] else 'decline'} reply")
503	            reply_content = generate_meeting_reply_content(invite_details, availability_result)
504	            
505	            # Step 5: Create MIME message for reply
506	            logger.info("Creating MIME message for reply")
507	            # Create EmailAddress object for the reply sender (use the original recipient)
508	            if email_obj.to and len(email_obj.to) > 0:
509	                reply_from = email_obj.to[0]
510	            else:
511	                # Fallback to a default if no recipient in original email
512	                reply_from = EmailAddress(
513	                    name="Me",
514	                    address=client.config.username
515	                )
516	            
517	            # Create the reply MIME message - using the standalone function
518	            mime_message = create_reply_mime(
519	                original_email=email_obj,
520	                reply_to=reply_from,
521	                body=reply_content["reply_body"],
522	                subject=reply_content["reply_subject"],
523	                # Don't use reply_all for meeting responses
524	                reply_all=False
525	            )
526	            
527	            # Step 6: Save as draft
528	            logger.info("Saving reply as draft")
