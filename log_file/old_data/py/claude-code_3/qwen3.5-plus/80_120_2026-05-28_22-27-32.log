197	async def handle_describe_view(
198	    name: str, arguments: Optional[Dict[str, Any]] = None
199	) -> Sequence[
200	    Union[mcp_types.TextContent, mcp_types.ImageContent, mcp_types.EmbeddedResource]
201	]:
202	    """Tool handler to describe the structure of a view."""
203	    try:
204	        # Get Snowflake connection from connection manager
205	        conn = connection_manager.get_connection()
206	
207	        # Extract arguments
208	        database = arguments.get("database") if arguments else None
209	        schema = arguments.get("schema") if arguments else None
210	        view_name = arguments.get("view_name") if arguments else None
211	
212	        if not database or not view_name:
213	            return [
214	                mcp_types.TextContent(
215	                    type="text",
216	                    text="Error: database and view_name parameters are required",
217	                )
218	            ]
219	
220	        # Use the provided schema or use default schema
221	        if schema:
222	            full_view_name = f"{database}.{schema}.{view_name}"
223	        else:
224	            # Get the current schema
225	            cursor = conn.cursor()
226	            cursor.execute("SELECT CURRENT_SCHEMA()")
227	            schema_result = cursor.fetchone()
228	            if schema_result:
229	                schema = schema_result[0]
230	                full_view_name = f"{database}.{schema}.{view_name}"
231	            else:
232	                return [
233	                    mcp_types.TextContent(
234	                        type="text", text="Error: Could not determine current schema"
235	                    )
236	                ]
237	
238	        # Execute query to describe view
239	        cursor = conn.cursor()
240	        cursor.execute(f"DESCRIBE VIEW {full_view_name}")
241	
242	        # Process results
243	        columns = []
244	        for row in cursor:
245	            col_name = row[0]
246	            col_type = row[1]
247	            col_null = "NULL" if row[3] == "Y" else "NOT NULL"
248	            columns.append(f"{col_name} : {col_type} {col_null}")
249	
250	        # Get view definition
251	        cursor.execute(f"SELECT GET_DDL('VIEW', '{full_view_name}')")
252	        view_ddl_result = cursor.fetchone()
253	        view_ddl = view_ddl_result[0] if view_ddl_result else "Definition not available"
254	
255	        cursor.close()
256	        # Don't close the connection, just the cursor
257	
258	        if columns:
259	            result = f"## View: {full_view_name}\n\n"
260	            result += "### Columns:\n"
261	            for col in columns:
262	                result += f"- {col}\n"
263	
264	            result += "\n### View Definition:\n```sql\n"
265	            result += view_ddl
266	            result += "\n```"
267	
268	            return [mcp_types.TextContent(type="text", text=result)]
269	        else:
270	            return [
271	                mcp_types.TextContent(
272	                    type="text",
273	                    text=f"View {full_view_name} not found or you don't have permission to access it.",
274	                )
275	            ]
276	
277	    except Exception as e:
278	        return [
279	            mcp_types.TextContent(type="text", text=f"Error describing view: {str(e)}")
280	        ]
