534	@mcp.tool()
535	def trace_dependency_impact(
536	    repo_path: str,
537	    target_module: str,
538	    working_directory: str,
539	    analysis_type: str = "dependency",
540	    max_depth: int = 3,
541	    change_type: str = "modify"
542	) -> str:
543	    """
544	    Trace dependency chains and analyze refactoring impact for a module.
545	    Combines dependency tracing with impact analysis.
546	    
547	    Args:
548	        repo_path: Repository path
549	        target_module: Module to analyze (e.g., 'src.auth.middleware')
550	        working_directory: Working directory (absolute path)
551	        analysis_type: "dependency" for chain tracing, "refactoring" for impact analysis, "both" for combined
552	        max_depth: Maximum depth to trace dependencies
553	        change_type: For refactoring - "modify", "split", "merge", or "remove"
554	    
555	    Returns:
556	        Dependency chains and/or refactoring impact analysis
557	    """
558	    try:
559	        output_lines = []
560	        
561	        # Get CodeRank data
562	        coderank_results = calculate_coderank(repo_path=repo_path)
563	        module_scores = coderank_results["module_ranks"]
564	        module_map = coderank_results["module_map"]
565	        import_graph = coderank_results["import_graph"]
566	        
567	        target_score = module_scores.get(target_module, 0)
568	        
569	        if target_module not in module_scores:
570	            return f"Module '{target_module}' not found in repository. Available modules: {', '.join(list(module_scores.keys())[:10])}..."
571	        
572	        if analysis_type in ["dependency", "both"]:
573	            output_lines.append("=== Dependency Chain Analysis ===\n")
574	            output_lines.append(f"Target Module: {target_module}")
575	            output_lines.append(f"CodeRank Score: {target_score:.4f}")
576	            output_lines.append(f"Max Depth: {max_depth}\n")
577	            
578	            # Get direct dependencies from the import graph
579	            upstream_deps = set()
580	            downstream_deps = set()
581	            
582	            # Upstream: what this module imports
583	            for edge in import_graph.out_edges(target_module):
584	                upstream_deps.add(edge[1])
585	            
586	            # Downstream: what imports this module
587	            for edge in import_graph.in_edges(target_module):
588	                downstream_deps.add(edge[0])
589	            
590	            output_lines.append("Upstream Dependencies (what this module imports):")
591	            if upstream_deps:
592	                for dep in sorted(upstream_deps):
593	                    score = module_scores.get(dep, 0)
594	                    output_lines.append(f"  • {dep} (score: {score:.4f})")
595	            else:
596	                output_lines.append("  • None")
597	            
598	            output_lines.append(f"\nDownstream Dependencies (what imports this module):")
599	            if downstream_deps:
600	                for dep in sorted(downstream_deps, key=lambda x: module_scores.get(x, 0), reverse=True):
601	                    score = module_scores.get(dep, 0)
602	                    output_lines.append(f"  • {dep} (score: {score:.4f})")
603	            else:
604	                output_lines.append("  • None")
605	            
606	            # Trace deeper dependencies if requested
607	            if max_depth > 1:
608	                output_lines.append(f"\n=== Extended Dependency Chain (up to {max_depth} levels) ===")
609	                
610	                # BFS for dependency chains
611	                visited = {target_module}
612	                current_level = {target_module}
613	                
614	                for level in range(1, max_depth + 1):
615	                    next_level = set()
616	                    level_deps = defaultdict(list)
617	                    
618	                    for module in current_level:
619	                        # Get dependencies
620	                        for edge in import_graph.out_edges(module):
621	                            if edge[1] not in visited:
622	                                next_level.add(edge[1])
623	                                level_deps[f"Level {level} upstream"].append(edge[1])
624	                        
625	                        for edge in import_graph.in_edges(module):
626	                            if edge[0] not in visited:
627	                                next_level.add(edge[0])
628	                                level_deps[f"Level {level} downstream"].append(edge[0])
629	                    
630	                    if level_deps:
631	                        for dep_type, deps in level_deps.items():
632	                            output_lines.append(f"\n{dep_type}:")
633	                            for dep in sorted(deps, key=lambda x: module_scores.get(x, 0), reverse=True)[:10]:
634	                                score = module_scores.get(dep, 0)
635	                                output_lines.append(f"  • {dep} (score: {score:.4f})")
636	                    
637	                    visited.update(next_level)
638	                    current_level = next_level
639	                    
640	                    if not next_level:
641	                        break
642	            
643	            # Calculate dependency metrics
644	            output_lines.append(f"\nDependency Metrics:")
645	            output_lines.append(f"  • Direct upstream dependencies: {len(upstream_deps)}")
646	            output_lines.append(f"  • Direct downstream dependencies: {len(downstream_deps)}")
647	            output_lines.append(f"  • Total direct connections: {len(upstream_deps) + len(downstream_deps)}")
648	            output_lines.append(f"  • Import centrality: {import_graph.degree(target_module)}")
649	        
650	        if analysis_type in ["refactoring", "both"]:
651	            if analysis_type == "both":
652	                output_lines.append("\n" + "="*50 + "\n")
653	            
654	            output_lines.append("=== Refactoring Impact Analysis ===\n")
655	            output_lines.append(f"Target Module: {target_module}")
656	            output_lines.append(f"Change Type: {change_type}")
657	            output_lines.append(f"Module Importance Score: {target_score:.4f}\n")
658	            
659	            # Get module file path
660	            module_file = module_map.get(target_module)
661	            
662	            # Get all symbols in the target module
663	            symbols = []
664	            if module_file:
665	                symbols_output = get_repo_symbols(
666	                    repo=repo_path,
667	                    working_directory=working_directory,
668	                    file_must_contain=os.path.relpath(module_file, repo_path)
669	                )
670	                symbols = [line for line in symbols_output if '|' in line and not line.startswith('-') and 'Symbol' not in line]
671	            
672	            symbol_count = len(symbols)
673	            
674	            # Find usages of symbols from this module
675	            total_usages = 0
676	            affected_files = set()
677	            
678	            for symbol_line in symbols[:10]:  # Sample first 10 symbols
679	                parts = re.split(r'\s{2,}', symbol_line.strip())
680	                if len(parts) >= 1:
681	                    symbol_name = parts[0]
682	                    try:
683	                        usages = get_symbol_usages(
684	                            repo=repo_path,
685	                            symbol_name_or_substring=symbol_name,
686	                            working_directory=working_directory
687	                        )
688	                        for usage_line in usages:
689	                            if '|' in usage_line and not usage_line.startswith('-'):
690	                                usage_parts = re.split(r'\s{2,}', usage_line.strip())
691	                                if len(usage_parts) >= 3:
692	                                    affected_files.add(usage_parts[2])
693	                                    total_usages += 1
694	                    except:
695	                        pass
696	            
697	            # Get downstream dependencies from earlier analysis or recalculate
698	            downstream_deps = set()
699	            for edge in import_graph.in_edges(target_module):
700	                downstream_deps.add(edge[0])
701	            
702	            # Impact assessment based on change type
703	            output_lines.append("Impact Assessment:")
704	            
705	            if change_type == "remove":
706	                output_lines.append(f"  • CRITICAL: Removing this module will break {len(downstream_deps)} dependent modules")
707	                output_lines.append(f"  • Estimated {total_usages * (symbol_count / 10)} symbol usages will need to be updated")
708	                output_lines.append(f"  • At least {len(affected_files)} files will be directly affected")
709	                
710	            elif change_type == "split":
711	                output_lines.append(f"  • Splitting will require updating imports in {len(downstream_deps)} modules")
712	                output_lines.append(f"  • {symbol_count} symbols need to be redistributed")
713	                output_lines.append(f"  • Consider grouping by: functionality, dependencies, or usage patterns")
714	                
715	            elif change_type == "merge":
716	                output_lines.append(f"  • Merging will consolidate {symbol_count} symbols")
717	                output_lines.append(f"  • May increase module complexity")
718	                connections = import_graph.degree(target_module)
719	                output_lines.append(f"  • Current module connections: {connections}")
720	                
721	            else:  # modify
722	                output_lines.append(f"  • Modifications will affect {len(downstream_deps)} dependent modules")
723	                output_lines.append(f"  • Estimated {total_usages * (symbol_count / 10)} symbol usages may need review")
724	                output_lines.append(f"  • Test coverage recommended for {len(affected_files)} files")
725	
726	            
727	            if len(downstream_deps) > 0:
728	                output_lines.append(f"\n  • Update imports in these high-priority modules first:")
729	                priority_deps = sorted(
730	                    [(dep, module_scores.get(dep, 0)) for dep in downstream_deps],
731	                    key=lambda x: x[1],
732	                    reverse=True
733	                )[:5]
734	                for dep, score in priority_deps:
735	                    output_lines.append(f"    - {dep} (score: {score:.4f})")
736	        
737	        return '\n'.join(output_lines)
738	        
739	    except Exception as e:
740	        return f"Error in trace_dependency_impact: {str(e)}"
741	
