204	                try:
205	                    note_data = processor.parse_image_note(share_link)
206	                    # 图文同样只保留 caption，避免重复字段
207	                    return json.dumps({
208	                        "status": "success",
209	                        "type": "image",
210	                        "platform": "douyin",
211	                        "note_id": note_data["note_id"],
212	                        "caption": note_data.get("caption", ""),
213	                        "image_count": len(note_data["images"]),
214	                        "images": note_data["images"]
215	                    }, ensure_ascii=False, indent=2)
216	                except Exception as image_error:
217	                    return _generic_fallback(share_link, f"抖音图文解析失败: {image_error}")
218	            return _generic_fallback(share_link, f"抖音视频解析失败: {video_error}")
219	
220	    except Exception as e:
221	        return _generic_fallback(share_link, f"解析抖音链接失败: {e}")
