17	@mcp.tool()
18	async def create_task_list(
19	    title: str,
20	    description: str,
21	    repo_path: str = ".",
22	    include_metadata: bool = True
23	) -> str:
24	    """Create a new task list and save it to the .tasks folder.
25	    
26	    Args:
27	        title: Title for the task list
28	        description: Short 2-3 word description for the filename (e.g., "refactor-authentication")
29	        repo_path: Path to the repository root (defaults to current directory)
30	        include_metadata: Whether to include creation date/time
31	    
32	    Returns:
33	        Path to the created task list file
34	    """
35	    # Sanitize the description for filename use
36	    safe_description = description.lower().replace(" ", "-")
37	    safe_description = re.sub(r'[^a-z0-9\-]', '', safe_description)
38	    
39	    # Create .tasks directory if it doesn't exist
40	    tasks_dir = os.path.join(repo_path, TASKS_FOLDER)
41	    if not os.path.exists(tasks_dir):
42	        os.makedirs(tasks_dir)
43	    
44	    # Generate markdown content
45	    markdown = f"# {title}\n\n"
46	    
47	    if include_metadata:
48	        markdown += f"*Created on: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}*\n\n"
49	    
50	    markdown += "## Tasks\n\n"
51	    markdown += "*No tasks yet*\n"
52	    
53	    # Save to file
54	    filename = f"{safe_description}.md"
55	    file_path = os.path.join(tasks_dir, filename)
56	    
57	    with open(file_path, 'w') as file:
58	        file.write(markdown)
59	    
60	    return f"Created task list at {file_path}"
61	
