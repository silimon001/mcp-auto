        elif "mysql" in self.database_url:
            return "mysql"
        elif "sqlite" in self.database_url:
            return "sqlite"
        elif self.database_url.startswith("mongodb://") or self.database_url.startswith("mongodb+srv://"):
            return "mongodb"
        else:
            return "postgresql"  # Default fallback

