    """
    tools = await ctx.fastmcp.list_tools()
    summaries = []
    for tool in tools:
        args = ", ".join(tool.inputSchema.get("properties", {}).keys())
        summaries.append(f"• {tool.name}({args}): {tool.description or '(No description)'}")
