56	def get_or_create_erddap(server_url: str, protocol: str = "tabledap") -> ERDDAP:
57	    """Get existing or create new ERDDAP instance for a server."""
58	    key = f"{server_url}_{protocol}"
59	    if key not in erddap_instances:
60	        e = ERDDAP(server=server_url)
61	        e.protocol = protocol
62	        erddap_instances[key] = e
63	    return erddap_instances[key]
