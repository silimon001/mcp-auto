155	    calling ``os.environ.pop("UNRAID_MCP_BEARER_TOKEN", None)`` immediately
156	    after, so the token is no longer accessible via os.environ.
157	    """
158	    global UNRAID_MCP_BEARER_TOKEN
159	    UNRAID_MCP_BEARER_TOKEN = token
160	
161	
