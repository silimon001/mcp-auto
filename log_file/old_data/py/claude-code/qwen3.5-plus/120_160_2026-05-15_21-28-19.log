126	            "env": {
127	                "QISKIT_IBM_TOKEN": "<your IBM Quantum token>",
128	                "QISKIT_IBM_RUNTIME_MCP_INSTANCE": "<Optional: Your IBM Quantum instance CRN>"
129	            },
