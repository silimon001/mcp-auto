80	def create_startup_logger() -> logging.Logger:
81	    global STARTUP_LOG_FILE
82	    _ensure_log_dir()
83	
84	    logger = logging.getLogger("RevitMCPServerStartup")
85	    logger.setLevel(logging.DEBUG)
86	    logger.propagate = False
87	
88	    for handler in list(logger.handlers):
89	        logger.removeHandler(handler)
90	        try:
91	            handler.close()
92	        except Exception:
93	            pass
94	
