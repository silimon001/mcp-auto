1713	                refresh=True,
1714	            )
1715	            profile = await get_device_profile(adapter, device["device_id"])
1716	            supported_lookup = {
1717	                item["operation"]: item["enabled"]
1718	                for item in profile.get("supported_operations", [])
1719	            }
1720	            if supported_lookup.get(parsed["intent"], False):
1721	                kwargs: Dict[str, Any] = {
1722	                    "operation": parsed["intent"],
1723	                    "device_id": device["device_id"],
1724	                    "refresh": True,
1725	                }
1726	                if "value" in parsed:
1727	                    kwargs["value"] = parsed["value"]
1728	                payload = extract_structured_content(await control_device(**kwargs))
1729	                return build_result(
1730	                    bool(payload.get("success")),
1731	                    payload.get("message", "Controlled device"),
1732	                    route="standard_operation",
1733	                    parsed_intent=parsed,
1734	                    result=payload,
1735	                )
1736	
