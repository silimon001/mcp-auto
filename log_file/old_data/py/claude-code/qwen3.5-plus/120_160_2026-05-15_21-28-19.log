676	        return {
677	            "service": {
678	                "name": SERVER_NAME,
679	                "version": SERVER_VERSION,
680	                "connected": False,
681	                "has_saved_login": False,
682	                "auth_file": None,
683	                "log_file": str(log_file_path),
684	                "qr": None,
685	                "device_count": 0,
686	            },
687	            "assistant_summary": "服务尚未初始化，先检查服务启动状态。",
