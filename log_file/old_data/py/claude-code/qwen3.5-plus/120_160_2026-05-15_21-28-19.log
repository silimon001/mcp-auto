197	# Server lifespan manager
198	@asynccontextmanager
199	async def db_lifespan(server: FastMCP) -> AsyncIterator[DbContext]:
200	    """Initialize database connections on startup and provide context to handlers"""
201	    
202	    # Initialize context
203	    db_context = DbContext(
204	        db_configs=config_map,
205	    )
206	    
207	    try:
208	        # Test connection on startup for all databases
209	        for db_config in db_context.db_configs.values():
210	            try:
211	                db_config.query_runner.test_connection()
212	                print(f"Successfully connected to {db_config.description}")
213	            except Exception as e:
214	                print(f"Warning: Connection test failed for {db_config.description}: {str(e)}")
215	        
216	        yield db_context
217	    finally:
218	        # Cleanup could happen here if needed
219	        pass
