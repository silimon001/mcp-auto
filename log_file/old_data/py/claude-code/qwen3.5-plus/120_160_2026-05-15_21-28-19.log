1044	    "--transport",
1045	    type=click.Choice(["stdio", "sse"]),
1046	    default="sse",
1047	    help="Transport type (stdio for command line, sse for Claude Desktop)"
1048	)
1049	@click.option(
1050	    "--debug", 
1051	    is_flag=True, 
1052	    default=False, 
1053	    help="Enable debug mode"
1054	)
1055	def main(port: int, transport: str, debug: bool) -> int:
1056	    """
1057	    Start the Kali MCP Server with the specified transport.
