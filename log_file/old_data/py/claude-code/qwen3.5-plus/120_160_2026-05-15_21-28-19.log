69	        if not os.path.exists(LOG_BASE_DIR):
70	            os.makedirs(LOG_BASE_DIR)
71	
72	        fallback_path = os.path.join(LOG_BASE_DIR, os.path.basename(log_path))
73	        if os.path.basename(log_path) == os.path.basename(STARTUP_LOG_FILE):
74	            STARTUP_LOG_FILE = fallback_path
75	        if os.path.basename(log_path) == os.path.basename(APP_LOG_FILE):
76	            APP_LOG_FILE = fallback_path
77	        return logging.FileHandler(fallback_path, mode=mode, encoding="utf-8"), fallback_path
