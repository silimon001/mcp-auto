68	@app.list_tools()
69	async def handle_list_tools() -> list[types.Tool]:
70	    """List available tools."""
71	    debug_print("Listing erddapy tools")
72	    return [
73	        types.Tool(
74	            name="list_servers",
75	            description="List some well-known ERDDAP servers",
76	            inputSchema={
77	                "type": "object",
78	                "properties": {}
79	            }
80	        ),
81	        types.Tool(
82	            name="search_datasets",
83	            description="Search for datasets on an ERDDAP server",
84	            inputSchema={
85	                "type": "object",
86	                "properties": {
87	                    "query": {"type": "string", "description": "Search query string"},
88	                    "server_url": {"type": "string", "description": "ERDDAP server URL", "default": "https://coastwatch.pfeg.noaa.gov/erddap"}
89	                },
90	                "required": ["query"]
91	            }
92	        ),
93	        types.Tool(
94	            name="get_dataset_info",
95	            description="Get detailed metadata information about a specific dataset",
96	            inputSchema={
97	                "type": "object",
98	                "properties": {
99	                    "dataset_id": {"type": "string", "description": "Dataset ID"},
100	                    "server_url": {"type": "string", "description": "ERDDAP server URL", "default": "https://coastwatch.pfeg.noaa.gov/erddap"},
101	                    "protocol": {"type": "string", "description": "Protocol type (tabledap or griddap)", "default": "tabledap"}
102	                },
103	                "required": ["dataset_id"]
104	            }
105	        ),
106	        types.Tool(
107	            name="to_pandas",
108	            description="Download data and return as a pandas DataFrame (CSV format)",
109	            inputSchema={
110	                "type": "object",
111	                "properties": {
112	                    "dataset_id": {"type": "string", "description": "Dataset ID"},
113	                    "variables": {"type": "array", "items": {"type": "string"}, "description": "Variables to download"},
114	                    "constraints": {"type": "object", "description": "Constraints dict (e.g., {'time>=': '2020-01-01', 'latitude>': 30})"},
115	                    "server_url": {"type": "string", "description": "ERDDAP server URL", "default": "https://coastwatch.pfeg.noaa.gov/erddap"},
116	                    "protocol": {"type": "string", "description": "Protocol type (tabledap or griddap)", "default": "tabledap"}
117	                },
118	                "required": ["dataset_id"]
119	            }
