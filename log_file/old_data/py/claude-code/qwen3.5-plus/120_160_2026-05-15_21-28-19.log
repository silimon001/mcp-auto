109	@asynccontextmanager
110	async def _stdio_server_skip_blank_lines(
111	    stdin: anyio.AsyncFile[str] | None = None,
112	    stdout: anyio.AsyncFile[str] | None = None,
113	):
114	    """Ignore blank input lines so manual terminal runs stay quiet."""
115	    if not stdin:
116	        stdin = anyio.wrap_file(TextIOWrapper(sys.stdin.buffer, encoding="utf-8", errors="replace"))
117	    if not stdout:
118	        stdout = anyio.wrap_file(TextIOWrapper(sys.stdout.buffer, encoding="utf-8"))
119	
120	    read_stream: MemoryObjectReceiveStream[SessionMessage | Exception]
121	    read_stream_writer: MemoryObjectSendStream[SessionMessage | Exception]
122	    write_stream: MemoryObjectSendStream[SessionMessage]
123	    write_stream_reader: MemoryObjectReceiveStream[SessionMessage]
124	
125	    read_stream_writer, read_stream = anyio.create_memory_object_stream(0)
126	    write_stream, write_stream_reader = anyio.create_memory_object_stream(0)
127	
128	    async def stdin_reader():
129	        try:
130	            async with read_stream_writer:
131	                async for line in stdin:
132	                    if not line.strip():
133	                        continue
134	                    try:
135	                        message = types.JSONRPCMessage.model_validate_json(line)
136	                    except Exception as exc:
137	                        await read_stream_writer.send(exc)
138	                        continue
139	                    await read_stream_writer.send(SessionMessage(message))
140	        except anyio.ClosedResourceError:
141	            await anyio.lowlevel.checkpoint()
142	
143	    async def stdout_writer():
144	        try:
145	            async with write_stream_reader:
146	                async for session_message in write_stream_reader:
147	                    payload = session_message.message.model_dump_json(by_alias=True, exclude_none=True)
148	                    await stdout.write(payload + "\n")
149	                    await stdout.flush()
150	        except anyio.ClosedResourceError:
151	            await anyio.lowlevel.checkpoint()
152	
153	    async with anyio.create_task_group() as tg:
154	        tg.start_soon(stdin_reader)
155	        tg.start_soon(stdout_writer)
156	        yield read_stream, write_stream
157	
