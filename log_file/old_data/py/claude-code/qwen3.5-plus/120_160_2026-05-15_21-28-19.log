93	```json
94	{
95	    "mcpServers": {
96	        "qiskit": {
97	            "command": "uvx",
98	            "args": ["qiskit-mcp-server"],
99	            "alwaysAllow": [],
100	            "disabled": false
101	        },
102	        "qiskit-docs": {
103	            "command": "uvx",
104	            "args": ["qiskit-docs-mcp-server"],
105	            "alwaysAllow": [],
106	            "disabled": false
107	        },
108	        "qiskit-gym": {
109	            "command": "uvx",
110	            "args": ["qiskit-gym-mcp-server"],
111	            "alwaysAllow": [],
112	            "disabled": false
113	        },
114	        "qiskit-code-assistant": {
115	            "command": "uvx",
116	            "args": ["qiskit-code-assistant-mcp-server"],
117	            "env": {
118	                "QISKIT_IBM_TOKEN": "<your IBM Quantum token>"
119	            },
120	            "alwaysAllow": [],
121	            "disabled": false
122	        },
123	        "qiskit-ibm-runtime": {
124	            "command": "uvx",
