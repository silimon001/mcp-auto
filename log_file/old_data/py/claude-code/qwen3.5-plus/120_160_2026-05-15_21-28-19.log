118	    formatter = logging.Formatter("%(asctime)s - %(name)s - %(levelname)s - %(message)s")
119	    file_handler.setFormatter(formatter)
120	
121	    for handler in list(app_instance.logger.handlers):
122	        app_instance.logger.removeHandler(handler)
123	        try:
124	            handler.close()
125	        except Exception:
126	            pass
127	
128	    app_instance.logger.addHandler(file_handler)
129	    app_instance.logger.propagate = False
130	
131	    if debug_mode:
132	        console_handler = logging.StreamHandler(sys.stdout)
133	        console_handler.setLevel(logging.DEBUG)
134	        console_handler.setFormatter(formatter)
135	        app_instance.logger.addHandler(console_handler)
136	        app_instance.logger.setLevel(logging.DEBUG)
137	        app_instance.logger.info("Flask app logger: Configured for DEBUG mode (file and console).")
