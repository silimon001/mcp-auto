379	def _execute_and_get_results(query: str, ctx: Context, db_id: str) -> Dict[str, Any]:
380	    """Helper function to execute query and get formatted results"""
381	    db_context = ctx.request_context.lifespan_context
382	    
383	    if db_id not in db_context.db_configs:
384	        raise ValueError(f"Invalid database ID: {db_id}")
385	    
386	    # Get the selected query runner
387	    db_config = db_context.db_configs[db_id]
388	    query_runner = db_config.query_runner
389	    
390	    # Execute query
391	    result = query_runner.run_query(query)
392	    
393	    # Update query history in the context
394	    db_context.last_query = query
395	    db_context.last_result = result
396	    db_context.query_history.append(f"[{db_id}] [{db_config.description}] {query}")
397	    
398	    # Extract column info
399	    columns = result.get('columns', [])
400	    column_names = [col.get('friendly_name', col.get('name', '')) for col in columns]
401	    
402	    # Extract row data
403	    rows = result.get('rows', [])
404	    row_count = len(rows)
405	    
406	    # Process rows - each row is a dictionary with column names as keys
407	    processed_rows = []
408	    for row_dict in rows:
409	        # Create a row with values in the same order as column_names
410	        processed_row = [row_dict.get(col.get('name', '')) for col in columns]
411	        processed_rows.append(processed_row)
412	    
413	    return {
414	        'column_names': column_names,
415	        'columns': columns,
416	        'rows': processed_rows,
417	        'raw_rows': rows,
418	        'row_count': row_count,
419	        'database': {
420	            'id': db_id,
421	            'description': db_config.description,
422	            'db_type': db_config.db_type
423	        }
424	    }
425	
426	# Define tools
427	@mcp.tool()
428	def execute_query(query: str, ctx: Context, db_id: str) -> str:
429	    """Execute a SQL query and return results as a markdown table"""
430	    try:
431	        result = _execute_and_get_results(query, ctx, db_id)
432	        
433	        # Add database info to the output
434	        db_info = f"Database: {result['database']['description']} (Type: {result['database']['db_type']})"
435	        
436	        # Build a markdown table for output
437	        header = " | ".join(result['column_names'])
438	        separator = " | ".join(["---"] * len(result['column_names']))
439	        
440	        table_rows = []
441	        for row in result['rows'][:10]:  # Limit to first 10 rows for display
442	            table_rows.append(" | ".join(str(cell) for cell in row))
443	        
444	        result_table = f"Query executed on Database: {result['database']['description']}\n\n"
445	        result_table += f"{header}\n{separator}\n" + "\n".join(table_rows)
446	        
447	        if result['row_count'] > 10:
448	            result_table += f"\n\n... and {result['row_count'] - 10} more rows (total: {result['row_count']})"
449	            
450	        return f"{db_info}\n\n{result_table}"
451	    except ValueError as e:
452	        if "Invalid database ID" in str(e):
453	            return f"Error: {str(e)}"
454	        return f"Error executing query: {str(e)}"
455	    except Exception as e:
456	        return f"Error executing query: {str(e)}"
457	
458	@mcp.tool()
459	def execute_query_json(query: str, ctx: Context, db_id: str) -> str:
460	    """Execute a SQL query and return results as JSON"""
461	    try:
