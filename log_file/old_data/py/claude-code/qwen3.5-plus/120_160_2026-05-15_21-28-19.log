20	def load_erddap_servers():
21	    """Load ERDDAP servers from erddaps.json file."""
22	    try:
23	        # Get the directory where this script is located
24	        script_dir = os.path.dirname(os.path.abspath(__file__))
25	        json_path = os.path.join(script_dir, 'erddaps.json')
26	        
27	        with open(json_path, 'r') as f:
28	            servers = json.load(f)
29	        
30	        debug_print(f"Loaded {len(servers)} ERDDAP servers from erddaps.json")
31	        return servers
32	    except FileNotFoundError:
33	        debug_print("Warning: erddaps.json not found, using fallback list")
34	        # Fallback to minimal list if file not found
35	        return [
36	            {
37	                "name": "NOAA CoastWatch West Coast",
38	                "short_name": "CSWC",
39	                "url": "https://coastwatch.pfeg.noaa.gov/erddap/",
40	                "public": True
41	            },
42	            {
43	                "name": "IOOS ERDDAP",
44	                "short_name": "IOOS",
45	                "url": "https://erddap.ioos.us/erddap/",
46	                "public": True
47	            }
48	        ]
49	    except Exception as e:
50	        debug_print(f"Error loading erddaps.json: {e}")
51	        return []
