523	@mcp.tool()
524	def describe_table(ctx: Context, table_name: str, db_id: str) -> str:
525	    """Get detailed description of a table including column names and types"""
526	    try:
527	        db_context: DbContext = ctx.request_context.lifespan_context
528	        
529	        if db_id not in db_context.db_configs:
530	            return f"Error: Invalid database ID {db_id}"
531	        
532	        db_config = db_context.db_configs[db_id]
533	        
534	        # Get column names and types
535	        columns = db_config.query_runner.get_table_columns(table_name)
536	        types = db_config.query_runner.get_table_types(table_name)
537	        
538	        # Build description
539	        description = f"Table: {table_name} in Database: {db_config.description} (ID: {db_id})\n\n"
540	        description += "Columns:\n"
541	        
542	        for column in columns:
543	            column_type = types.get(column, "unknown")
544	            description += f"- {column} ({column_type})\n"
545	        
546	        return description
547	    except Exception as e:
