123	@app.call_tool()
124	async def handle_call_tool(name: str, arguments: dict) -> list[types.TextContent]:
125	    """Handle tool calls."""
126	    debug_print(f"Tool called: {name} with args: {arguments}")
127	    
128	    try:
129	        # Get server URL from arguments
130	        server_url = arguments.get("server_url", "https://coastwatch.pfeg.noaa.gov/erddap")
131	        
132	        if name == "search_datasets":
133	            query = arguments.get("query", "")
134	            e = get_or_create_erddap(server_url)
135	            
136	            # Use erddapy's search functionality
137	            search_url = e.get_search_url(response="csv", search_for=query)
138	            debug_print(f"Search URL: {search_url}")
139	            
140	            # For search, we'll use pandas to read the CSV directly
141	            try:
142	                df = pd.read_csv(search_url)
143	                if df.empty:
144	                    return [types.TextContent(type="text", text=f"No datasets found matching '{query}'")]
145	                
146	                # Format results
147	                result = f"Found {len(df)} datasets matching '{query}':\n\n"
148	                for idx, row in df.head(10).iterrows():
149	                    dataset_id = row.get('Dataset ID', 'Unknown')
150	                    title = row.get('Title', 'No title')
151	                    result += f"• **{dataset_id}**: {title}\n"
152	                
153	                if len(df) > 10:
154	                    result += f"\n... and {len(df) - 10} more datasets"
155	                
156	                return [types.TextContent(type="text", text=result)]
157	            except Exception as e:
158	                return [types.TextContent(type="text", text=f"Error searching datasets: {str(e)}")]
159	        
160	        elif name == "get_dataset_info":
161	            dataset_id = arguments.get("dataset_id", "")
162	            protocol = arguments.get("protocol", "tabledap")
163	            e = get_or_create_erddap(server_url, protocol)
164	            e.dataset_id = dataset_id
165	            
166	            # Get info URL and fetch metadata
167	            info_url = e.get_info_url(response="csv")
168	            debug_print(f"Info URL: {info_url}")
169	            
170	            try:
171	                df = pd.read_csv(info_url)
172	                
173	                # Parse the info dataframe
174	                global_attrs = df[df['Variable Name'] == 'NC_GLOBAL']
175	                variables = df[df['Row Type'] == 'variable']['Variable Name'].unique()
176	                
177	                result = f"🌊 **Dataset: {dataset_id}**\n\n"
178	                
179	                # Extract key metadata
180	                title = global_attrs[global_attrs['Attribute Name'] == 'title']['Value'].values
181	                if len(title) > 0:
182	                    result += f"**Title:** {title[0]}\n\n"
183	                
184	                summary = global_attrs[global_attrs['Attribute Name'] == 'summary']['Value'].values
185	                if len(summary) > 0:
186	                    result += f"**Summary:** {summary[0][:300]}...\n\n"
187	                
188	                # Time coverage
189	                time_start = global_attrs[global_attrs['Attribute Name'] == 'time_coverage_start']['Value'].values
190	                time_end = global_attrs[global_attrs['Attribute Name'] == 'time_coverage_end']['Value'].values
191	                if len(time_start) > 0 and len(time_end) > 0:
192	                    result += f"**Time Coverage:** {time_start[0]} to {time_end[0]}\n\n"
193	                
194	                # Variables
195	                result += f"**Variables ({len(variables)}):**\n"
196	                for var in variables[:10]:
197	                    var_attrs = df[df['Variable Name'] == var]
198	                    long_name = var_attrs[var_attrs['Attribute Name'] == 'long_name']['Value'].values
199	                    units = var_attrs[var_attrs['Attribute Name'] == 'units']['Value'].values
200	                    
201	                    var_desc = var
202	                    if len(long_name) > 0:
203	                        var_desc = f"{var}: {long_name[0]}"
204	                    if len(units) > 0:
205	                        var_desc += f" ({units[0]})"
206	                    result += f"• {var_desc}\n"
207	                
208	                if len(variables) > 10:
209	                    result += f"• ... and {len(variables) - 10} more variables"
210	                
211	                return [types.TextContent(type="text", text=result)]
212	            except Exception as e:
213	                return [types.TextContent(type="text", text=f"Error getting dataset info: {str(e)}")]
214	        
215	        elif name == "to_pandas":
216	            dataset_id = arguments.get("dataset_id", "")
217	            variables = arguments.get("variables", [])
218	            constraints = arguments.get("constraints", {})
219	            protocol = arguments.get("protocol", "tabledap")
220	            
221	            e = get_or_create_erddap(server_url, protocol)
222	            e.dataset_id = dataset_id
223	            e.response = "csv"
224	            
225	            if variables:
226	                e.variables = variables
227	            
228	            if constraints:
229	                e.constraints = constraints
230	            
231	            try:
232	                # Initialize griddap if needed
233	                if protocol == "griddap":
234	                    e.griddap_initialize()
235	                    
236	                # Download data as pandas DataFrame
237	                df = e.to_pandas()
238	                
239	                # Format the output
240	                result = f"**Data from {dataset_id}**\n\n"
241	                result += f"Shape: {df.shape[0]} rows × {df.shape[1]} columns\n\n"
242	                result += "**Columns:** " + ", ".join(df.columns.tolist()) + "\n\n"
243	                result += "**First 5 rows:**\n```\n"
244	                result += df.head().to_string() + "\n```\n\n"
245	                result += "**Summary statistics:**\n```\n"
246	                result += df.describe().to_string() + "\n```"
247	                
248	                return [types.TextContent(type="text", text=result)]
249	            except Exception as e:
250	                return [types.TextContent(type="text", text=f"Error downloading data: {str(e)}")]
251	        
252	        elif name == "list_servers":
253	            servers = load_erddap_servers()
254	            
255	            if not servers:
256	                return [types.TextContent(type="text", text="Error: Could not load ERDDAP servers list")]
257	            
258	            result = f"**Available ERDDAP servers ({len(servers)} total):**\n\n"
259	            
260	            # Group by public/private
261	            public_servers = [s for s in servers if s.get('public', True)]
262	            private_servers = [s for s in servers if not s.get('public', True)]
263	            
264	            if public_servers:
265	                result += f"**Public Servers ({len(public_servers)}):**\n\n"
266	                for server in public_servers[:20]:  # Show first 20
267	                    result += f"**{server['name']}**"
268	                    if server.get('short_name'):
269	                        result += f" ({server['short_name']})"
270	                    result += f"\nURL: {server['url']}\n\n"
271	                
272	                if len(public_servers) > 20:
273	                    result += f"... and {len(public_servers) - 20} more public servers\n\n"
274	            
275	            if private_servers:
276	                result += f"\n**Private/Restricted Servers ({len(private_servers)}):**\n\n"
277	                for server in private_servers:
278	                    result += f"• {server['name']} ({server.get('short_name', 'N/A')})\n"
279	            
280	            result += "\n*Loaded from erddaps.json*"
281	            
282	            return [types.TextContent(type="text", text=result)]
283	        
284	        else:
285	            debug_print(f"Unknown tool: {name}")
286	            return [types.TextContent(type="text", text=f"Unknown tool: {name}")]
287	            
288	    except Exception as e:
289	        debug_print(f"Error in tool execution: {str(e)}")
290	        debug_print(f"Traceback: {traceback.format_exc()}")
291	        return [types.TextContent(type="text", text=f"Error: {str(e)}")]
292	
293	async def main():
294	    """Main entry point for the MCP server."""
295	    debug_print("Starting MCP server")
296	    
297	    # We need to check if we're already in an event loop
298	    try:
299	        # Get the current event loop
300	        loop = asyncio.get_running_loop()
301	        debug_print("Already in an event loop, using it")
302	    except RuntimeError:
303	        # No event loop running
304	        loop = None
305	        debug_print("No event loop running, will create one")
306	    
307	    try:
308	        debug_print("Creating stdio server")
309	        async with stdio_server() as (read_stream, write_stream):
310	            debug_print("stdio server created successfully")
311	            try:
312	                debug_print("Starting server.run()")
313	                await app.run(
314	                    read_stream,
315	                    write_stream,
316	                    app.create_initialization_options()
317	                )
318	                debug_print("Server run completed normally")
319	            except Exception as e:
320	                debug_print(f"Error during server.run(): {e}")
321	                debug_print(f"Full traceback: {traceback.format_exc()}")
322	                raise
323	    except Exception as e:
324	        debug_print(f"Error creating stdio server: {e}")
325	        debug_print(f"Full traceback: {traceback.format_exc()}")
326	        raise
327	
328	if __name__ == "__main__":
329	    debug_print("erddapy MCP server starting")
330	    try:
331	        asyncio.run(main())
332	        debug_print("Script completed normally")
333	    except KeyboardInterrupt:
334	        debug_print("Script interrupted by user")
335	        sys.exit(0)
336	    except Exception as e:
337	        debug_print(f"Top-level exception: {e}")
338	        debug_print(f"Full traceback: {traceback.format_exc()}")
339	        sys.exit(1)

