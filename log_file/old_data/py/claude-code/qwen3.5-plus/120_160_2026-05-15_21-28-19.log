111	def validate_required_config() -> tuple[bool, list[str]]:
112	    """Validate that required configuration is present.
113	
114	    Returns:
115	        bool: True if all required config is present, False otherwise.
116	    """
117	    required_vars = [("UNRAID_API_URL", UNRAID_API_URL), ("UNRAID_API_KEY", UNRAID_API_KEY)]
118	
119	    missing = []
120	    for name, value in required_vars:
121	        if not value:
122	            missing.append(name)
123	
124	    return len(missing) == 0, missing
125	
126	
127	def is_configured() -> bool:
128	    """Return True if both required credentials are present."""
129	    return bool(UNRAID_API_URL and UNRAID_API_KEY)
130	
131	
132	def apply_runtime_config(api_url: str, api_key: str) -> None:
133	    """Update module-level credential globals at runtime (post-elicitation).
134	
135	    Credentials are intentionally NOT written to os.environ to prevent
136	    leaking secrets to subprocesses or error reporters that capture
137	    environment snapshots.  All internal consumers read from this module's
138	    globals via ``from ..config import settings as _settings``.
139	    """
140	    global UNRAID_API_URL, UNRAID_API_KEY
141	    UNRAID_API_URL = api_url
142	    UNRAID_API_KEY = api_key
143	
144	
