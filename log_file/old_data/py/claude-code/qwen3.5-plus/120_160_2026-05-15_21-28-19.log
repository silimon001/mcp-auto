1	"""
2	Android Device Operator - Tools Package
3	
4	This package contains modular tools for Android device automation using uiautomator2.
5	Each module focuses on a specific category of device operations.
6	
7	Modules:
8	- device_tools: Device connection, status, and information tools
9	- app_tools: Application management (install, start, stop, clear data)
10	- screen_tools: Screen control (on/off, unlock, wait for screen)
11	- input_tools: User input simulation (click, swipe, text input, key press)
12	- inspection_tools: UI element inspection and hierarchy analysis
13	- advanced_tools: Advanced features (toast messages, activity waiting)
14	"""
15	
16	# Import all tool modules
17	from . import device_tools
18	from . import app_tools
19	from . import screen_tools
20	from . import input_tools
21	from . import inspection_tools
22	from . import advanced_tools
23	
24	
25	# Convenience function to register all tools at once
26	def register_all_tools(mcp):
27	    """Register all tool modules with the MCP server.
28	
29	    Args:
30	        mcp: The FastMCP server instance
31	    """
32	    device_tools.register_device_tools(mcp)
33	    app_tools.register_app_tools(mcp)
34	    screen_tools.register_screen_tools(mcp)
35	    input_tools.register_input_tools(mcp)
36	    inspection_tools.register_inspection_tools(mcp)
37	    advanced_tools.register_advanced_tools(mcp)
38	
39	
40	# Export the registration function
41	__all__ = ["register_all_tools"]
42	

