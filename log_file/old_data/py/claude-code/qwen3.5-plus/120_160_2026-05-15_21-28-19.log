96	        try:
97	            os.remove(STARTUP_LOG_FILE)
98	        except Exception:
99	            pass
100	
101	    file_handler, resolved_path = _create_file_handler(STARTUP_LOG_FILE, mode="a")
102	    if resolved_path != STARTUP_LOG_FILE:
103	        STARTUP_LOG_FILE = resolved_path
104	    file_handler.setFormatter(logging.Formatter("%(asctime)s - %(levelname)s - %(message)s"))
105	    logger.addHandler(file_handler)
