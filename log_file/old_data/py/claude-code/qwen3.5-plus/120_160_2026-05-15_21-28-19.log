1	"""Mijia configuration management module"""
2	
3	import os
4	from dataclasses import dataclass
5	from typing import Optional
6	
7	@dataclass
8	class MijiaConfig:
9	    """Mijia configuration"""
10	    username: Optional[str] = None
11	    password: Optional[str] = None
12	    enableQR: bool = True
13	    qr_open_mode: str = "browser"
14	    log_level: str = "INFO"
15	    
16	    @classmethod
17	    def from_env(cls) -> 'MijiaConfig':
18	        """Load configuration from environment variables"""
19	        enableQR = os.getenv('MIJIA_ENABLE_QR', 'true').lower() == 'true'
20	        username = os.getenv('MIJIA_USERNAME')
21	        password = os.getenv('MIJIA_PASSWORD')
22	        qr_open_mode = os.getenv('MIJIA_QR_OPEN_MODE', 'browser').strip().lower() or 'browser'
23	        if qr_open_mode not in {"browser", "viewer", "none"}:
24	            qr_open_mode = "browser"
25	        log_level = os.getenv('MIJIA_LOG_LEVEL', 'INFO').upper()
26	
27	        return cls(
28	            username=username,
29	            password=password,
30	            enableQR=enableQR,
31	            qr_open_mode=qr_open_mode,
32	            log_level=log_level,
33	        )
34	
35	def load_mijia_config() -> MijiaConfig:
36	    """Load Mijia configuration from environment variables
37	    Environment variables:
38	    - MIJIA_USERNAME: Deprecated in mijiaAPI 3.x, no longer used for login
39	    - MIJIA_PASSWORD: Deprecated in mijiaAPI 3.x, no longer used for login
40	    - MIJIA_ENABLE_QR: Whether to enable QR code login (optional, default: true)
41	    - MIJIA_QR_OPEN_MODE: How to open the generated QR code page, supports browser/viewer/none
42	    - MIJIA_LOG_LEVEL: Log level (optional, default: INFO)
43	    
44	    Returns:
45	        MijiaConfig: Mijia configuration object
46	    """
47	    return MijiaConfig.from_env()
