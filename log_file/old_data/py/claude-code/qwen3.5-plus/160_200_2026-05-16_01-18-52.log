285	class ChatSession:
286	    """Orchestrates the interaction between user, LLM, and tools."""
287	
288	    def __init__(self, servers: list[Server], llm_client: LLMClient) -> None:
289	        self.servers: list[Server] = servers
290	        self.llm_client: LLMClient = llm_client
291	
292	    async def cleanup_servers(self) -> None:
293	        """Clean up all servers properly."""
294	        cleanup_tasks = [
295	            asyncio.create_task(server.cleanup()) for server in self.servers
296	        ]
297	        if cleanup_tasks:
298	            try:
299	                await asyncio.gather(*cleanup_tasks, return_exceptions=True)
300	            except Exception as e:
301	                logging.warning(f"Warning during final cleanup: {e}")
302	
303	    async def process_llm_response(self, llm_response: str) -> str:
304	        """Process the LLM response and execute tools if needed.
305	
306	        Args:
307	            llm_response: The response from the LLM.
308	
309	        Returns:
310	            The result of tool execution or the original response.
311	        """
312	        import json
313	
314	        # 检查是否以 ```json\n 开头
315	        if llm_response.startswith('```json\n'):
316	            # 去掉开头的 ```json\n
317	            llm_response = llm_response[8:]
318	            # 如果末尾有 ``` 也去掉
319	            if llm_response.endswith('\n```'):
320	                llm_response = llm_response[:-4]
321	
322	        try:
323	            tool_call = json.loads(llm_response)
324	            if "tool" in tool_call and "arguments" in tool_call:
325	                logging.info(f"Executing tool: {tool_call['tool']}")
326	                logging.info(f"With arguments: {tool_call['arguments']}")
327	
328	                for server in self.servers:
329	                    tools = await server.list_tools()
330	                    if any(tool.name == tool_call["tool"] for tool in tools):
331	                        try:
332	                            result = await server.execute_tool(
333	                                tool_call["tool"], tool_call["arguments"]
334	                            )
335	
336	                            if isinstance(result, dict) and "progress" in result:
337	                                progress = result["progress"]
338	                                total = result["total"]
339	                                percentage = (progress / total) * 100
340	                                logging.info(
341	                                    f"Progress: {progress}/{total} "
342	                                    f"({percentage:.1f}%)"
343	                                )
344	
345	                            return f"Tool execution result: {result}"
346	                        except Exception as e:
347	                            error_msg = f"Error executing tool: {str(e)}"
348	                            logging.error(error_msg)
349	                            return error_msg
350	
351	                return f"No server found with tool: {tool_call['tool']}"
352	            return llm_response
353	        except json.JSONDecodeError:
354	            return llm_response
355	
356	    async def start(self) -> None:
357	        """Main chat session handler."""
358	        try:
359	            for server in self.servers:
360	                try:
361	                    await server.initialize()
362	                except Exception as e:
363	                    logging.error(f"Failed to initialize server: {e}")
364	                    await self.cleanup_servers()
365	                    return
366	
367	            all_tools = []
368	            for server in self.servers:
369	                tools = await server.list_tools()
370	                all_tools.extend(tools)
371	
372	            tools_description = "\n".join([tool.format_for_llm() for tool in all_tools])
373	
374	            system_message = (
375	                "You are a helpful assistant with access to these tools:\n\n"
376	                f"{tools_description}\n"
377	                "Choose the appropriate tool based on the user's question. "
378	                "If no tool is needed, reply directly.\n\n"
379	                "IMPORTANT: When you need to use a tool, you must ONLY respond with "
380	                "the exact JSON object format below, nothing else:\n"
381	                "{\n"
382	                '    "tool": "tool-name",\n'
383	                '    "arguments": {\n'
384	                '        "argument-name": "value"\n'
385	                "    }\n"
386	                "}\n\n"
387	                "After receiving a tool's response:\n"
388	                "1. Transform the raw data into a natural, conversational response\n"
389	                "2. Keep responses concise but informative\n"
390	                "3. Focus on the most relevant information\n"
391	                "4. Use appropriate context from the user's question\n"
392	                "5. Avoid simply repeating the raw data\n\n"
393	                "Please use only the tools that are explicitly defined above."
394	            )
395	
396	            messages = [{"role": "system", "content": system_message}]
397	
398	            while True:
399	                try:
400	                    user_input = input("You: ").strip().lower()
401	                    if user_input in ["quit", "exit"]:
402	                        logging.info("\nExiting...")
403	                        break
404	
405	                    messages.append({"role": "user", "content": user_input})
406	
407	                    llm_response = self.llm_client.get_response(messages)
408	                    logging.info("\nAssistant: %s", llm_response)
409	
410	                    result = await self.process_llm_response(llm_response)
411	
412	                    if result != llm_response:
413	                        messages.append({"role": "assistant", "content": llm_response})
414	                        messages.append({"role": "user", "content": result})
415	
416	                        final_response = self.llm_client.get_response(messages)
417	                        logging.info("\nFinal response: %s", final_response)
418	                        messages.append(
419	                            {"role": "assistant", "content": final_response}
420	                        )
421	                    else:
422	                        messages.append({"role": "assistant", "content": llm_response})
423	
424	                except KeyboardInterrupt:
425	                    logging.info("\nExiting...")
426	                    break
427	
428	        finally:
429	            await self.cleanup_servers()
430	
431	
432	async def main() -> None:
433	    """Initialize and run the chat session."""
434	    config = Configuration()
435	    server_config = config.load_config("servers_config.json")
436	    servers = [
437	        Server(name, srv_config)
438	        for name, srv_config in server_config["mcpServers"].items()
439	    ]
440	    llm_client = LLMClient(config.llm_api_key)
441	    chat_session = ChatSession(servers, llm_client)
442	    await chat_session.start()
443	
444	
445	if __name__ == "__main__":
446	    asyncio.run(main())
