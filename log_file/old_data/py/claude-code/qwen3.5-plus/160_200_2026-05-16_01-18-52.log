50	def _format_column_details_md(columns: List[ColumnInfo]) -> List[str]:
51	    """
52	    Formats a list of ColumnInfo objects into a list of Markdown strings.
53	    """
54	    markdown_lines = []
55	    if not columns:
56	        markdown_lines.append("  - *No column information available.*")
57	        return markdown_lines
58	
59	    for col in columns:
60	        if not isinstance(col, ColumnInfo):
61	            print(f"Warning: Encountered an unexpected item in columns list: {type(col)}. Skipping.")
62	            continue
63	        col_type = col.type_text or (col.type_name.value if col.type_name and hasattr(col.type_name, 'value') else "N/A")
64	        nullable_status = "nullable" if col.nullable else "not nullable"
65	        col_description = f": {col.comment}" if col.comment else ""
66	        markdown_lines.append(f"  - **{col.name}** (`{col_type}`, {nullable_status}){col_description}")
67	    return markdown_lines
68	
69	def _get_job_info_cached(job_id: str) -> Dict[str, Any]:
70	    """Get job information with caching to avoid redundant API calls"""
71	    if job_id not in _job_cache:
72	        try:
73	            job_info = sdk_client.jobs.get(job_id=job_id)
74	            _job_cache[job_id] = {
75	                'name': job_info.settings.name if job_info.settings.name else f"Job {job_id}",
76	                'tasks': []
77	            }
78	            
79	            # Pre-process all tasks to build notebook mapping
80	            if job_info.settings.tasks:
81	                for task in job_info.settings.tasks:
82	                    if hasattr(task, 'notebook_task') and task.notebook_task:
83	                        task_info = {
84	                            'task_key': task.task_key,
85	                            'notebook_path': task.notebook_task.notebook_path
86	                        }
87	                        _job_cache[job_id]['tasks'].append(task_info)
88	                        
89	        except Exception as e:
90	            print(f"Error fetching job {job_id}: {e}")
91	            _job_cache[job_id] = {
92	                'name': f"Job {job_id}",
93	                'tasks': [],
94	                'error': str(e)
95	            }
96	    
97	    return _job_cache[job_id]
