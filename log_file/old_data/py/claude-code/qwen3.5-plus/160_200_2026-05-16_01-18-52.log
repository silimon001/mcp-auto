1	#!/usr/bin/env python3
2	"""
3	网盘MCP服务器
4	包含文件上传功能
5	"""
6	import os
7	import sys
8	from typing import Dict, Any, Optional
9	import hashlib
10	import requests
11	import datetime
12	import json
13	import io
14	import time
15	import random
16	
17	# 添加当前目录到系统路径
18	BASE_DIR = os.path.dirname(os.path.abspath(__file__))
19	sys.path.append(BASE_DIR)
20	
21	# 导入MCP相关库
22	from mcp.server.fastmcp import FastMCP, Context
23	
24	# 导入网盘SDK相关库
25	import openapi_client
26	from openapi_client.api import fileupload_api
27	from urllib3.util.retry import Retry
28	from requests.adapters import HTTPAdapter
29	
30	access_token = os.getenv('BAIDU_NETDISK_ACCESS_TOKEN')
31	
32	# 创建MCP服务器
33	mcp = FastMCP("网盘服务")
34	
35	# 定义分片大小为4MB
36	CHUNK_SIZE = 4 * 1024 * 1024  # 4MB
37	# 定义重试次数和超时时间
38	MAX_RETRIES = 3
39	RETRY_BACKOFF = 2
40	TIMEOUT = 30
41	
42	def configure_session():
43	    """配置带有重试机制的会话"""
44	    session = requests.Session()
45	    retry_strategy = Retry(
46	        total=MAX_RETRIES,
47	        backoff_factor=RETRY_BACKOFF,
48	        status_forcelist=[429, 500, 502, 503, 504],
49	        allowed_methods=["HEAD", "GET", "PUT", "DELETE", "OPTIONS", "TRACE", "POST"]
50	    )
51	    adapter = HTTPAdapter(max_retries=retry_strategy)
52	    session.mount("https://", adapter)
53	    session.mount("http://", adapter)
54	    return session
55	
56	@mcp.tool()
57	def upload_file(local_file_path: str, remote_path: str = None) -> Dict[str, Any]:
58	    """
59	    上传本地文件到网盘指定路径
60	    
61	    参数:
62	    - local_file_path: 本地文件路径
63	    - remote_path: 网盘存储路径，必须以/开头。如不指定，将默认上传到"/来自：mcp_server"目录下，这个前缀不能修改
64	    
65	    返回:
66	    - 上传结果信息的字典
67	    """
68	    try:
69	        # 1. 检查文件是否存在
70	        if not os.path.isfile(local_file_path):
71	            return {"status": "error", "message": f"本地文件不存在: {local_file_path}"}
72	        
73	        # 如果未指定远程路径，则使用默认路径
74	        filename = os.path.basename(local_file_path)
75	        if not remote_path:
76	            remote_path = f"/来自：mcp_server/{filename}"
77	        else:
78	            remote_path = f"{remote_path}/{filename}"
79	        
80	        # 获取文件大小
81	        file_size = os.path.getsize(local_file_path)
82	        
83	        # 配置API客户端
84	        configuration = openapi_client.Configuration()
85	        configuration.connection_pool_maxsize = 10
86	        configuration.retries = MAX_RETRIES
87	        configuration.socket_options = None  # 使用默认值
88	        
89	        # 决定是否需要分片上传
90	        if file_size <= CHUNK_SIZE:
91	            # 小文件，直接上传
92	            return upload_small_file(local_file_path, remote_path, file_size, access_token, configuration)
93	        else:
94	            # 大文件，分片上传
95	            return upload_large_file(local_file_path, remote_path, file_size, access_token, configuration)
96	                
97	    except Exception as e:
98	        return {"status": "error", "message": f"上传文件过程发生错误: {str(e)}"}
99	
100	
101	def upload_small_file(local_file_path, remote_path, file_size, access_token, configuration=None):
102	    """处理小文件上传，不需要分片"""
103	    # 读取文件内容并计算MD5
104	    with open(local_file_path, 'rb') as f:
105	        file_content = f.read()
106	    
107	    file_md5 = hashlib.md5(file_content).hexdigest()
108	    block_list = f'["{file_md5}"]'
109	    
110	    with openapi_client.ApiClient(configuration) as api_client:
111	        api_instance = fileupload_api.FileuploadApi(api_client)
112	        
113	        # 预创建文件
114	        try:
115	            precreate_response = api_instance.xpanfileprecreate(
116	                access_token=access_token,
117	                path=remote_path,
118	                isdir=0,
119	                size=file_size,
120	                autoinit=1,
121	                block_list=block_list,
122	                rtype=3
123	            )
124	            
125	            if 'errno' in precreate_response and precreate_response['errno'] != 0:
126	                return {"status": "error", "message": f"预创建文件失败: {precreate_response['errno']}"}
127	            
128	            uploadid = precreate_response['uploadid']
129	            
130	        except openapi_client.ApiException as e:
131	            return {"status": "error", "message": f"预创建文件失败: {str(e)}"}
132	        
133	        # 上传文件，添加重试逻辑
134	        for attempt in range(MAX_RETRIES):
135	            try:
136	                with open(local_file_path, 'rb') as file:
137	                    upload_response = api_instance.pcssuperfile2(
138	                        access_token=access_token,
139	                        partseq="0",
140	                        path=remote_path,
141	                        uploadid=uploadid,
142	                        type="tmpfile",
143	                        file=file
144	                    )
145	                
146	                if 'md5' not in upload_response or not upload_response['md5']:
147	                    return {"status": "error", "message": "文件上传失败: 未返回MD5"}
148	                
149	                # 上传成功，跳出重试循环
150	                break
151	                    
152	            except openapi_client.ApiException as e:
153	                if attempt < MAX_RETRIES - 1:
154	                    # 计算退避时间
155	                    sleep_time = RETRY_BACKOFF * (2 ** attempt) + random.uniform(0, 1)
156	                    time.sleep(sleep_time)
157	                    continue
158	                return {"status": "error", "message": f"文件上传失败: {str(e)}"}
159	        
160	        # 创建文件（完成上传）
161	        try:
162	            create_response = api_instance.xpanfilecreate(
163	                access_token=access_token,
164	                path=remote_path,
165	                isdir=0,
166	                size=file_size,
167	                uploadid=uploadid,
168	                block_list=block_list,
169	                rtype=3
170	            )
171	            
172	            if 'errno' in create_response and create_response['errno'] != 0:
173	                return {"status": "error", "message": f"创建文件失败: {create_response['errno']}"}
174	            
175	            # 构造返回结果，不包含敏感信息
176	            return {
177	                "status": "success",
178	                "message": "文件上传成功",
179	                "filename": os.path.basename(remote_path),
180	                "size": file_size,
181	                "remote_path": remote_path,
182	                "fs_id": create_response['fs_id'] if 'fs_id' in create_response else None
183	            }
184	            
185	        except openapi_client.ApiException as e:
186	            return {"status": "error", "message": f"创建文件失败: {str(e)}"}
187	
188	
189	def upload_large_file(local_file_path, remote_path, file_size, access_token, configuration=None):
190	    """处理大文件上传，需要分片"""
191	    # 计算需要的分片数量
192	    chunk_count = (file_size + CHUNK_SIZE - 1) // CHUNK_SIZE
193	    
194	    # 准备存储每个分片的MD5
195	    md5_list = []
196	    
197	    # 计算每个分片的MD5
198	    with open(local_file_path, 'rb') as f:
199	        for i in range(chunk_count):
200	            chunk_data = f.read(CHUNK_SIZE)
201	            chunk_md5 = hashlib.md5(chunk_data).hexdigest()
202	            md5_list.append(chunk_md5)
203	    
204	    # 构建block_list字符串
205	    block_list = json.dumps(md5_list)
206	    
207	    with openapi_client.ApiClient(configuration) as api_client:
208	        api_instance = fileupload_api.FileuploadApi(api_client)
209	        
210	        # 预创建文件
211	        try:
212	            precreate_response = api_instance.xpanfileprecreate(
213	                access_token=access_token,
214	                path=remote_path,
215	                isdir=0,
216	                size=file_size,
217	                autoinit=1,
218	                block_list=block_list,
219	                rtype=3
220	            )
221	            
222	            if 'errno' in precreate_response and precreate_response['errno'] != 0:
223	                return {"status": "error", "message": f"预创建文件失败: {precreate_response['errno']}"}
224	            
225	            uploadid = precreate_response['uploadid']
226	            
227	        except openapi_client.ApiException as e:
228	            return {"status": "error", "message": f"预创建文件失败: {str(e)}"}
229	        
230	        # 分片上传，添加重试逻辑
231	        with open(local_file_path, 'rb') as f:
232	            for i in range(chunk_count):
233	                # 读取当前分片
234	                chunk_data = f.read(CHUNK_SIZE)
235	                
236	                # 重试逻辑
237	                for attempt in range(MAX_RETRIES):
238	                    try:
239	                        # 创建文件对象以进行上传
240	                        file_obj = io.BytesIO(chunk_data)
241	                        file_obj.name = os.path.basename(local_file_path)
242	                        
243	                        # 上传分片
244	                        upload_response = api_instance.pcssuperfile2(
245	                            access_token=access_token,
246	                            partseq=str(i),
247	                            path=remote_path,
248	                            uploadid=uploadid,
249	                            type="tmpfile",
250	                            file=file_obj
251	                        )
252	                        
253	                        if 'md5' not in upload_response or not upload_response['md5']:
254	                            if attempt < MAX_RETRIES - 1:
255	                                # 计算退避时间
256	                                sleep_time = RETRY_BACKOFF * (2 ** attempt) + random.uniform(0, 1)
257	                                time.sleep(sleep_time)
258	                                continue
259	                            return {"status": "error", "message": f"分片 {i} 上传失败: 未返回MD5"}
260	                        
261	                        # 上传成功，跳出重试循环
262	                        break
263	                    
264	                    except openapi_client.ApiException as e:
265	                        if attempt < MAX_RETRIES - 1:
266	                            # 计算退避时间
267	                            sleep_time = RETRY_BACKOFF * (2 ** attempt) + random.uniform(0, 1)
268	                            time.sleep(sleep_time)
269	                            continue
270	                        return {"status": "error", "message": f"分片 {i} 上传失败: {str(e)}"}
271	        
272	        # 创建文件（合并分片完成上传）
273	        try:
274	            create_response = api_instance.xpanfilecreate(
275	                access_token=access_token,
276	                path=remote_path,
277	                isdir=0,
278	                size=file_size,
279	                uploadid=uploadid,
280	                block_list=block_list,
281	                rtype=3
282	            )
283	            
284	            if 'errno' in create_response and create_response['errno'] != 0:
285	                return {"status": "error", "message": f"创建文件失败: {create_response['errno']}"}
286	            
287	            return {
288	                "status": "success",
289	                "message": "文件分片上传成功",
290	                "filename": os.path.basename(remote_path),
291	                "size": file_size,
292	                "chunks": chunk_count,
293	                "remote_path": remote_path,
294	                "fs_id": create_response['fs_id'] if 'fs_id' in create_response else None
295	            }
296	            
297	        except openapi_client.ApiException as e:
298	            return {"status": "error", "message": f"创建文件失败: {str(e)}"}
299	
