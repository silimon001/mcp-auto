91	def get_common_headers(routing_id: str | None = None, juspay_creds: dict = None):
92	    """
93	    Returns common headers used by all API calls.
94	    Uses the provided routing_id, or defaults to JUSPAY_MERCHANT_ID if None.
95	    If juspay_creds is provided, uses dynamic credentials; otherwise falls back to env vars.
96	    """
97	    if juspay_creds:
98	        verify_dynamic_credentials(juspay_creds)
99	        api_key = juspay_creds["api_key"]
100	        merchant_id = juspay_creds["merchant_id"]
101	        effective_routing_id = routing_id or merchant_id
102	        
103	        return {
104	            "Authorization": f"Basic {get_base64_auth(api_key)}",
105	            "x-merchantid": merchant_id,
106	            "x-routing-id": effective_routing_id,
107	            "Accept": "application/json",
108	            "x-request-id": f"mcp-tool-{os.urandom(6).hex()}" 
109	        }
110	    else:
111	        # Fallback to environment variables
112	        verify_env_vars()
113	        effective_routing_id = routing_id or JUSPAY_MERCHANT_ID
114	        return {
115	            "Authorization": f"Basic {get_base64_auth()}",
116	            "x-merchantid": JUSPAY_MERCHANT_ID,
117	            "x-routing-id": effective_routing_id,
118	            "Accept": "application/json",
119	            "x-request-id": f"mcp-tool-{os.urandom(6).hex()}" 
120	        }
121	
122	def get_json_headers(routing_id: str | None = None, juspay_creds: dict = None):
123	    """Returns headers for JSON content type."""
124	    headers = get_common_headers(routing_id, juspay_creds)
125	    headers["Content-Type"] = "application/json"
