176	class Tool:
177	    """Represents a tool with its properties and formatting."""
178	
179	    def __init__(
180	        self, name: str, description: str, input_schema: dict[str, Any]
181	    ) -> None:
182	        self.name: str = name
183	        self.description: str = description
184	        self.input_schema: dict[str, Any] = input_schema
185	
186	    def format_for_llm(self) -> str:
187	        """Format tool information for LLM.
188	
189	        Returns:
190	            A formatted string describing the tool.
191	        """
192	        args_desc = []
193	        if "properties" in self.input_schema:
194	            for param_name, param_info in self.input_schema["properties"].items():
195	                arg_desc = (
196	                    f"- {param_name}: {param_info.get('description', 'No description')}"
197	                )
198	                if param_name in self.input_schema.get("required", []):
199	                    arg_desc += " (required)"
200	                args_desc.append(arg_desc)
201	
202	        return f"""
203	Tool: {self.name}
204	Description: {self.description}
205	Arguments:
206	{chr(10).join(args_desc)}
207	"""
208	
209	
210	class LLMClient:
211	    """Manages communication with the LLM provider."""
212	
213	    def __init__(self, api_key: str) -> None:
214	        self.api_key: str = api_key
215	
216	    def get_response(self, messages: list[dict[str, str]]) -> str:
217	        """Get a response from the LLM.
218	
219	        Args:
220	            messages: A list of message dictionaries.
221	
222	        Returns:
223	            The LLM's response as a string.
224	
225	        Raises:
226	            httpx.RequestError: If the request to the LLM fails.
227	        """
228	        url = "https://qianfan.baidubce.com/v2/chat/completions"
229	
230	        headers = {
231	            "Content-Type": "application/json",
232	            "Authorization": f"Bearer {self.api_key}",
233	        }
234	        payload = {
235	            "messages": messages,
236	            #"model": "ernie-4.5-8k-preview",
237	            "model": "deepseek-v3",
238	            #"model": "ernie-4.0-turbo-8k",
239	            "temperature": 0.7,
240	            "top_p": 1,
241	            "stream": False,
242	            "stop": None,
243	        }
244	
245	        #logging.info(f"request qianfan payload: {payload}")
246	
247	        try:
248	            with httpx.Client(timeout=30.0) as client:
249	                response = client.post(url, headers=headers, json=payload)
250	                #logging.info(f"qianfan response: {response.text}")
251	                response.raise_for_status()
252	                data = response.json()
253	                return data["choices"][0]["message"]["content"]
254	
255	        except httpx.RequestError as e:
256	            error_message = f"Error getting LLM response: {str(e)}"
257	            logging.error(error_message)
258	
259	            if isinstance(e, httpx.HTTPStatusError):
260	                status_code = e.response.status_code
261	                logging.error(f"Status code: {status_code}")
262	                logging.error(f"Response details: {e.response.text}")
263	
264	            return (
265	                f"I encountered an error: {error_message}. "
266	                "Please try again or rephrase your request."
267	            )
268	
269	
270	class ChatSession:
271	    """Orchestrates the interaction between user, LLM, and tools."""
272	
273	    def __init__(self, servers: list[Server], llm_client: LLMClient) -> None:
274	        self.servers: list[Server] = servers
275	        self.llm_client: LLMClient = llm_client
276	
277	    async def cleanup_servers(self) -> None:
278	        """Clean up all servers properly."""
279	        cleanup_tasks = [
280	            asyncio.create_task(server.cleanup()) for server in self.servers
281	        ]
282	        if cleanup_tasks:
283	            try:
284	                await asyncio.gather(*cleanup_tasks, return_exceptions=True)
285	            except Exception as e:
286	                logging.warning(f"Warning during final cleanup: {e}")
287	
288	    async def process_llm_response(self, llm_response: str) -> str:
289	        """Process the LLM response and execute tools if needed.
290	
291	        Args:
292	            llm_response: The response from the LLM.
293	
294	        Returns:
295	            The result of tool execution or the original response.
296	        """
297	        import json
298	
299	        # 检查是否以 ```json\n 开头
300	        if llm_response.startswith('```json\n'):
301	            # 去掉开头的 ```json\n
302	            llm_response = llm_response[8:]
303	            # 如果末尾有 ``` 也去掉
304	            if llm_response.endswith('\n```'):
305	                llm_response = llm_response[:-4]
306	
307	        try:
308	            tool_call = json.loads(llm_response)
309	            if "tool" in tool_call and "arguments" in tool_call:
310	                logging.info(f"Executing tool: {tool_call['tool']}")
311	                logging.info(f"With arguments: {tool_call['arguments']}")
312	
313	                for server in self.servers:
314	                    tools = await server.list_tools()
315	                    if any(tool.name == tool_call["tool"] for tool in tools):
316	                        try:
317	                            result = await server.execute_tool(
318	                                tool_call["tool"], tool_call["arguments"]
319	                            )
320	
321	                            if isinstance(result, dict) and "progress" in result:
322	                                progress = result["progress"]
323	                                total = result["total"]
324	                                percentage = (progress / total) * 100
325	                                logging.info(
326	                                    f"Progress: {progress}/{total} "
327	                                    f"({percentage:.1f}%)"
328	                                )
329	
330	                            return f"Tool execution result: {result}"
331	                        except Exception as e:
332	                            error_msg = f"Error executing tool: {str(e)}"
333	                            logging.error(error_msg)
334	                            return error_msg
335	
336	                return f"No server found with tool: {tool_call['tool']}"
337	            return llm_response
338	        except json.JSONDecodeError:
339	            return llm_response
340	
341	    async def start(self) -> None:
342	        """Main chat session handler."""
343	        try:
344	            for server in self.servers:
345	                try:
346	                    await server.initialize()
347	                except Exception as e:
348	                    logging.error(f"Failed to initialize server: {e}")
349	                    await self.cleanup_servers()
350	                    return
351	
352	            all_tools = []
353	            for server in self.servers:
354	                tools = await server.list_tools()
355	                all_tools.extend(tools)
356	
357	            tools_description = "\n".join([tool.format_for_llm() for tool in all_tools])
358	
359	            system_message = (
360	                "You are a helpful assistant with access to these tools:\n\n"
361	                f"{tools_description}\n"
362	                "Choose the appropriate tool based on the user's question. "
363	                "If no tool is needed, reply directly.\n\n"
364	                "IMPORTANT: When you need to use a tool, you must ONLY respond with "
365	                "the exact JSON object format below, nothing else:\n"
366	                "{\n"
367	                '    "tool": "tool-name",\n'
368	                '    "arguments": {\n'
369	                '        "argument-name": "value"\n'
370	                "    }\n"
371	                "}\n\n"
372	                "After receiving a tool's response:\n"
373	                "1. Transform the raw data into a natural, conversational response\n"
374	                "2. Keep responses concise but informative\n"
375	                "3. Focus on the most relevant information\n"
376	                "4. Use appropriate context from the user's question\n"
377	                "5. Avoid simply repeating the raw data\n\n"
378	                "Please use only the tools that are explicitly defined above."
379	            )
380	
381	            messages = [{"role": "system", "content": system_message}]
382	
383	            while True:
384	                try:
385	                    user_input = input("You: ").strip().lower()
386	                    if user_input in ["quit", "exit"]:
387	                        logging.info("\nExiting...")
388	                        break
389	
390	                    messages.append({"role": "user", "content": user_input})
391	
392	                    llm_response = self.llm_client.get_response(messages)
393	                    logging.info("\nAssistant: %s", llm_response)
394	
395	                    result = await self.process_llm_response(llm_response)
396	
397	                    if result != llm_response:
398	                        messages.append({"role": "assistant", "content": llm_response})
399	                        messages.append({"role": "user", "content": result})
400	
401	                        final_response = self.llm_client.get_response(messages)
402	                        logging.info("\nFinal response: %s", final_response)
403	                        messages.append(
404	                            {"role": "assistant", "content": final_response}
405	                        )
406	                    else:
407	                        messages.append({"role": "assistant", "content": llm_response})
408	
409	                except KeyboardInterrupt:
410	                    logging.info("\nExiting...")
411	                    break
412	
413	        finally:
414	            await self.cleanup_servers()
415	
416	
417	async def main() -> None:
418	    """Initialize and run the chat session."""
419	    config = Configuration()
420	    server_config = config.load_config("servers_config.json")
421	    servers = [
422	        Server(name, srv_config)
423	        for name, srv_config in server_config["mcpServers"].items()
424	    ]
425	    llm_client = LLMClient(config.llm_api_key)
426	    chat_session = ChatSession(servers, llm_client)
427	    await chat_session.start()
428	
429	
430	if __name__ == "__main__":
431	    asyncio.run(main())
