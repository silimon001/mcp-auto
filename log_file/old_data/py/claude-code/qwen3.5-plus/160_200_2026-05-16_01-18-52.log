67	    """Manages MCP server connections and tool execution."""
68	
69	    def __init__(self, name: str, config: dict[str, Any]) -> None:
70	        self.name: str = name
71	        self.config: dict[str, Any] = config
72	        self.stdio_context: Any | None = None
73	        self.session: ClientSession | None = None
74	        self._cleanup_lock: asyncio.Lock = asyncio.Lock()
75	        self.exit_stack: AsyncExitStack = AsyncExitStack()
76	
77	    async def initialize(self) -> None:
78	        """Initialize the server connection."""
79	        server_url = self.config["url"]
80	        try:
81	            streams = await self.exit_stack.enter_async_context(sse_client(server_url))
82	            session = await self.exit_stack.enter_async_context(ClientSession(*streams))
83	            
84	            self.session = session
85	            await self.session.initialize()
86	            
87	            # 测试连接
88	            response = await self.session.list_tools()
89	            print("连接成功，可用工具：", [tool.name for tool in response.tools])
90	            
91	        except Exception as e:
92	            print(f"连接失败: {str(e)}")
93	            await self.cleanup()
94	            raise
95	
96	    async def list_tools(self) -> list[Any]:
97	        """List available tools from the server.
98	
99	        Returns:
100	            A list of available tools.
101	
102	        Raises:
103	            RuntimeError: If the server is not initialized.
104	        """
105	        if not self.session:
106	            raise RuntimeError(f"Server {self.name} not initialized")
107	
108	        tools_response = await self.session.list_tools()
109	        tools = []
110	
111	        for item in tools_response:
112	            if isinstance(item, tuple) and item[0] == "tools":
113	                tools.extend(
114	                    Tool(tool.name, tool.description, tool.inputSchema)
115	                    for tool in item[1]
116	                )
117	
118	        return tools
119	
120	    async def execute_tool(
121	        self,
122	        tool_name: str,
123	        arguments: dict[str, Any],
124	        retries: int = 2,
125	        delay: float = 1.0,
126	    ) -> Any:
127	        """Execute a tool with retry mechanism.
128	
129	        Args:
130	            tool_name: Name of the tool to execute.
131	            arguments: Tool arguments.
132	            retries: Number of retry attempts.
133	            delay: Delay between retries in seconds.
134	
135	        Returns:
136	            Tool execution result.
137	
138	        Raises:
139	            RuntimeError: If server is not initialized.
140	            Exception: If tool execution fails after all retries.
141	        """
142	        if not self.session:
143	            raise RuntimeError(f"Server {self.name} not initialized")
144	
145	        attempt = 0
146	        while attempt < retries:
147	            try:
148	                logging.info(f"Executing {tool_name}...")
149	                result = await self.session.call_tool(tool_name, arguments)
150	
151	                return result
152	
153	            except Exception as e:
154	                attempt += 1
155	                logging.warning(
156	                    f"Error executing tool: {e}. Attempt {attempt} of {retries}."
157	                )
158	                if attempt < retries:
159	                    logging.info(f"Retrying in {delay} seconds...")
160	                    await asyncio.sleep(delay)
161	                else:
162	                    logging.error("Max retries reached. Failing.")
163	                    raise
164	
165	    async def cleanup(self) -> None:
166	        """Clean up server resources."""
167	        async with self._cleanup_lock:
168	            try:
169	                await self.exit_stack.aclose()
170	                self.session = None
171	                self.stdio_context = None
172	            except Exception as e:
173	                logging.error(f"Error during cleanup of server {self.name}: {e}")
174	
