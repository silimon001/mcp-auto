14	"""Google Security Operations MCP server.
15	
16	This module implements the Security Operations MCP server to perform
17	security operations tasks using Chronicle, including natural language search.
18	"""
19	
20	import logging
21	import os
22	from typing import Any, Optional
23	
24	from mcp.server.fastmcp import FastMCP
25	from secops import SecOpsClient
26	
27	# Initialize FastMCP server with a descriptive name
28	server = FastMCP('Google Security Operations MCP server', log_level="ERROR")
29	
30	# Configure logging
31	logging.basicConfig(level=logging.INFO)
32	logger = logging.getLogger('secops-mcp')
33	
34	# Constants
35	USER_AGENT = 'secops-app/0.7.0'
36	
37	# Default Chronicle configuration from environment variables
38	DEFAULT_PROJECT_ID = os.environ.get('CHRONICLE_PROJECT_ID', '725716774503')
39	DEFAULT_CUSTOMER_ID = os.environ.get(
40	    'CHRONICLE_CUSTOMER_ID', 'c3c6260c1c9340dcbbb802603bbf9636'
41	)
42	DEFAULT_REGION = os.environ.get('CHRONICLE_REGION', 'us')
43	
44	
45	def get_chronicle_client(
46	    project_id: Optional[str] = None,
47	    customer_id: Optional[str] = None,
48	    region: Optional[str] = None
49	) -> Any:
50	    """Initialize and return a Chronicle client.
51	
52	    Args:
53	        project_id: Google Cloud project ID (defaults to CHRONICLE_PROJECT_ID env var)
54	        customer_id: Chronicle customer ID (defaults to CHRONICLE_CUSTOMER_ID env var)
55	        region: Chronicle region (defaults to CHRONICLE_REGION env var or "us")
56	
57	    Returns:
58	        Any: Initialized Chronicle client
59	    """
60	    # Use provided values or defaults from environment variables
61	    project_id = project_id or DEFAULT_PROJECT_ID
62	    customer_id = customer_id or DEFAULT_CUSTOMER_ID
63	    region = region or DEFAULT_REGION
64	
65	    if not project_id or not customer_id:
66	        raise ValueError(
67	            'Chronicle project_id and customer_id must be provided either '
68	            'as parameters or through environment variables '
69	            '(CHRONICLE_PROJECT_ID, CHRONICLE_CUSTOMER_ID)'
70	        )
71	    service_account_path = os.getenv("SECOPS_SA_PATH")
72	    if service_account_path:
73	        client = SecOpsClient(service_account_path=service_account_path)
74	    else:
75	        client = SecOpsClient()
76	
77	    chronicle = client.chronicle(
78	        customer_id=customer_id, project_id=project_id, region=region
79	    )
80	    return chronicle
81	
82	
83	# Import all tools
84	from secops_mcp.tools import *
85	
86	
87	def main() -> None:
88	    """Run the MCP server for SecOps tools.
89	
90	    This function initializes and starts the MCP server with all the defined
91	    tools.
92	    """
93	    # Initialize and run the server
94	    server.run(transport='stdio')
95	
96	
97	if __name__ == '__main__':
98	    main()

