66	class Server:
67	    """Manages MCP server connections and tool execution."""
68	
69	    def __init__(self, name: str, config: dict[str, Any]) -> None:
70	        self.name: str = name
71	        self.config: dict[str, Any] = config
72	        self.stdio_context: Any | None = None
73	        self.session: ClientSession | None = None
74	        self._cleanup_lock: asyncio.Lock = asyncio.Lock()
75	        self.exit_stack: AsyncExitStack = AsyncExitStack()
76	
77	    async def initialize(self) -> None:
78	        """Initialize the server connection."""
79	        command = (
80	            shutil.which("npx")
81	            if self.config["command"] == "npx"
82	            else self.config["command"]
83	        )
84	        if command is None:
85	            raise ValueError("The command must be a valid string and cannot be None.")
86	
87	        server_params = StdioServerParameters(
88	            command=command,
89	            args=self.config["args"],
90	            env={**os.environ, **self.config["env"]}
91	            if self.config.get("env")
92	            else None,
93	        )
94	        
95	        try:
96	            stdio_transport = await self.exit_stack.enter_async_context(
97	                stdio_client(server_params)
98	            )
99	            read, write = stdio_transport
100	            session = await self.exit_stack.enter_async_context(
101	                ClientSession(read, write)
102	            )
103	            await session.initialize()
104	            self.session = session
105	        except Exception as e:
106	            logging.error(f"Error initializing server {self.name}: {e}")
107	            await self.cleanup()
108	            raise
109	
110	
111	    async def list_tools(self) -> list[Any]:
112	        """List available tools from the server.
113	
114	        Returns:
115	            A list of available tools.
116	
117	        Raises:
118	            RuntimeError: If the server is not initialized.
119	        """
120	        if not self.session:
121	            raise RuntimeError(f"Server {self.name} not initialized")
122	
123	        tools_response = await self.session.list_tools()
124	        tools = []
125	
126	        for item in tools_response:
127	            if isinstance(item, tuple) and item[0] == "tools":
128	                tools.extend(
129	                    Tool(tool.name, tool.description, tool.inputSchema)
130	                    for tool in item[1]
131	                )
132	
133	        return tools
134	
135	    async def execute_tool(
136	        self,
137	        tool_name: str,
138	        arguments: dict[str, Any],
139	        retries: int = 2,
140	        delay: float = 1.0,
141	    ) -> Any:
142	        """Execute a tool with retry mechanism.
143	
144	        Args:
145	            tool_name: Name of the tool to execute.
146	            arguments: Tool arguments.
147	            retries: Number of retry attempts.
148	            delay: Delay between retries in seconds.
149	
150	        Returns:
151	            Tool execution result.
152	
153	        Raises:
154	            RuntimeError: If server is not initialized.
155	            Exception: If tool execution fails after all retries.
156	        """
157	        if not self.session:
158	            raise RuntimeError(f"Server {self.name} not initialized")
159	
160	        attempt = 0
161	        while attempt < retries:
162	            try:
163	                logging.info(f"Executing {tool_name}...")
164	                result = await self.session.call_tool(tool_name, arguments)
165	
166	                return result
167	
168	            except Exception as e:
169	                attempt += 1
170	                logging.warning(
171	                    f"Error executing tool: {e}. Attempt {attempt} of {retries}."
172	                )
173	                if attempt < retries:
174	                    logging.info(f"Retrying in {delay} seconds...")
175	                    await asyncio.sleep(delay)
176	                else:
177	                    logging.error("Max retries reached. Failing.")
178	                    raise
179	
180	    async def cleanup(self) -> None:
181	        """Clean up server resources."""
182	        async with self._cleanup_lock:
183	            try:
184	                await self.exit_stack.aclose()
185	                self.session = None
186	                self.stdio_context = None
187	            except Exception as e:
188	                logging.error(f"Error during cleanup of server {self.name}: {e}")
