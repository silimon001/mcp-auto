1	#!/usr/bin/env python3
2	# -*- coding: utf-8 -*-
3	
4	"""
5	MCP Server for Deep Research Agent
6	
7	This module provides an MCP (Model Context Protocol) server interface for the
8	Deep Research Agent. It exposes research capabilities through standardized MCP
9	tools that can be used by AI assistants and other MCP‑compatible clients.
10	
11	Transports:
12	- stdio (default) — for editors/CLIs that spawn a local process
13	- http (streaming) — runs a local HTTP server with streaming responses so
14	  MCP‑over‑HTTP clients can connect over the network
15	
16	Features:
17	- Deep research with multiple backend providers (OpenAI Responses API, Gemini Deep Research, Open Deep Research)
18	- Clarification workflows to improve research quality
19	- Task status monitoring for long‑running research
20	- Configurable research parameters and system instructions
21	- Support for data analysis and visualization capabilities
22	
23	Exposed tools:
24	- deep_research: Main research tool with optional clarification
25	- research_with_context: Research using clarification answers
26	- research_status: Monitor task progress
27	
28	Quick start:
29	    # stdio (default)
30	    uv run deep-research-mcp
31	
32	    # HTTP streaming (bind to 127.0.0.1:8080)
33	    uv run deep-research-mcp --transport http --host 127.0.0.1 --port 8080
34	
35	Note: In HTTP mode, responses are streamed by the underlying FastMCP HTTP
36	server. The tools in this module currently return their full results when a
37	research task completes; clients that support streaming will still benefit from
38	the HTTP transport and any incremental events emitted by the server.
39	
40	Based on the deep research patterns from:
41	https://cookbook.openai.com/examples/deep_research_api/introduction_to_deep_research_api_agents
42	"""
43	
44	import argparse
45	import asyncio
46	import logging
47	from contextlib import suppress
48	from typing import Annotated, Literal, cast
49	
50	from mcp.server.fastmcp import Context, FastMCP
51	
52	from deep_research_mcp import __version__
53	from deep_research_mcp.agent import DeepResearchAgent
54	from deep_research_mcp.config import ResearchConfig
55	from deep_research_mcp.errors import ResearchError
56	from deep_research_mcp.results import ResearchResult
57	
58	# Configure logging
59	logging.basicConfig(level=logging.INFO)
60	logger = logging.getLogger(__name__)
61	LogLevelName = Literal["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
62	VALID_LOG_LEVELS: set[str] = {"DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"}
63	
64	DEFAULT_RESEARCH_SYSTEM_PROMPT = """You are a professional researcher preparing a structured, data-driven report.
65	Requirements:
66	- Focus on data-rich insights with specific figures and statistics
67	- Include tables and visualizations when appropriate
68	- Prioritize peer-reviewed sources and authoritative data
69	- Use inline citations throughout
70	- Be analytical and avoid generalities
71	"""
72	
73	# Global agent instance
74	research_agent: DeepResearchAgent | None = None
75	
76	# Initialize FastMCP server at module level with metadata
77	mcp = FastMCP(
78	    name=f"deep-research (v{__version__})",
79	    instructions=(
80	        "Deep Research MCP Server - Autonomous research agent with web search, "
81	        "data analysis, and citation capabilities. Supports OpenAI Responses API, "
82	        "OpenAI Chat Completions API (compatible with Perplexity, Groq, Ollama, "
83	        "and other providers), Gemini Deep Research via the Interactions API, "
84	        "and Open Deep Research. Use deep_research for "
85	        "comprehensive research queries, research_with_context for "
86	        "clarification-enhanced research, and research_status to monitor "
87	        "long-running tasks."
88	    ),
89	    website_url="https://github.com/pminervini/deep-research-mcp",
90	    debug=False,
91	    log_level="INFO",
92	)
93	
94	
95	def _apply_logging_config(log_level: str) -> None:
96	    """Apply configured log level to the root logger and FastMCP settings."""
97	    normalized_log_level = log_level.upper()
98	    if normalized_log_level not in VALID_LOG_LEVELS:
99	        normalized_log_level = "INFO"
100	    typed_log_level = cast(LogLevelName, normalized_log_level)

