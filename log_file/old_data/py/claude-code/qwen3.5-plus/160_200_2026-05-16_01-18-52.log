71	def verify_dynamic_credentials(juspay_creds: dict):
72	    """Verifies that required Juspay credentials are present in the auth context."""
73	    if not juspay_creds:
74	        raise ValueError("No Juspay credentials found in authentication context")
75	    
76	    api_key = juspay_creds.get("api_key")
77	    merchant_id = juspay_creds.get("merchant_id")
78	    
79	    if not api_key or not merchant_id:
80	        raise ValueError("Missing api_key or merchant_id in Juspay credentials")
81	
82	def get_base64_auth(api_key: str = None):
83	    """Returns the base64 encoded auth string."""
84	    if api_key:
85	        auth_string = f"{api_key}:"
86	    else:
87	        verify_env_vars() 
88	        auth_string = f"{JUSPAY_API_KEY}:"
89	    return base64.b64encode(auth_string.encode()).decode()
