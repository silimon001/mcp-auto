1	#!/usr/bin/env python3
2	"""
3	Remotion MCP Server - AI-powered video generation with design system approach
4	
5	This module provides the async MCP server for Remotion video operations.
6	Supports both stdio (for Claude Desktop) and HTTP (for API access) transports.
7	"""
8	
9	import logging
10	import os
11	import sys
12	
13	logger = logging.getLogger(__name__)
14	
15	
16	def _init_artifact_store() -> bool:
17	    """
18	    Initialize the artifact store from environment variables.
19	
20	    Checks for S3/Tigris configuration and sets up the global artifact store.
21	    This enables cloud storage for videos on Fly.io deployments.
22	
23	    Returns:
24	        True if artifact store was initialized, False otherwise
25	    """
26	    # Check if we have S3 configuration (Tigris on Fly.io)
27	    provider = os.environ.get("CHUK_ARTIFACTS_PROVIDER", "memory")
28	    bucket = os.environ.get("BUCKET_NAME")
29	    redis_url = os.environ.get("REDIS_URL")
30	
31	    # For S3 provider, we need bucket and AWS credentials
32	    if provider == "s3":
33	        aws_key = os.environ.get("AWS_ACCESS_KEY_ID")
34	        aws_secret = os.environ.get("AWS_SECRET_ACCESS_KEY")
35	        aws_endpoint = os.environ.get("AWS_ENDPOINT_URL_S3")
36	
37	        if not all([bucket, aws_key, aws_secret]):
38	            logger.warning(
39	                "S3 provider configured but missing credentials. "
40	                "Set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and BUCKET_NAME."
41	            )
42	            return False
43	
44	        logger.info(f"Initializing artifact store with S3 provider (bucket: {bucket})")
45	        logger.info(f"  Endpoint: {aws_endpoint}")
46	        logger.info(f"  Redis URL: {'configured' if redis_url else 'not configured'}")
47	
48	    try:
49	        from chuk_artifacts import ArtifactStore
50	        from chuk_mcp_server import set_global_artifact_store
51	
52	        # Create the artifact store with environment-based configuration
53	        store = ArtifactStore(
54	            storage_provider=provider,
55	            bucket=bucket,
56	            session_provider="redis" if redis_url else "memory",
57	        )
58	
59	        # Set as global artifact store for chuk-mcp-server context
60	        set_global_artifact_store(store)
61	
62	        logger.info(f"Artifact store initialized successfully (provider: {provider})")
63	        return True
64	
65	    except Exception as e:
66	        logger.error(f"Failed to initialize artifact store: {e}")
67	        return False
68	
69	
70	# Initialize artifact store at module load time
71	_artifact_store_ready = _init_artifact_store()
72	
73	# Import mcp instance from async server
74	from .async_server import mcp  # noqa: F401, E402
75	
76	# The tools are registered via decorators in async_server.py
77	# They become available as soon as the module is imported
78	
79	
80	def main():
81	    """Main entry point for the MCP server.
82	
83	    Automatically detects transport mode:
84	    - stdio: When stdin is piped or MCP_STDIO is set (for Claude Desktop)
85	    - HTTP: Default mode for API access
86	    """
87	    import argparse
88	
89	    parser = argparse.ArgumentParser(description="Remotion MCP Server")
90	    parser.add_argument(
91	        "mode",
92	        nargs="?",
93	        choices=["stdio", "http"],
94	        default=None,
95	        help="Transport mode (stdio for Claude Desktop, http for API)",
96	    )
97	    parser.add_argument(
98	        "--host", default="localhost", help="Host for HTTP mode (default: localhost)"
99	    )
100	    parser.add_argument("--port", type=int, default=8000, help="Port for HTTP mode (default: 8000)")
101	
102	    args = parser.parse_args()
103	
104	    # Determine transport mode
105	    if args.mode == "stdio":
106	        print("Remotion MCP Server starting in STDIO mode", file=sys.stderr)
107	        mcp.run(stdio=True)
108	    elif args.mode == "http":
109	        print(
110	            f"Remotion MCP Server starting in HTTP mode on {args.host}:{args.port}",
111	            file=sys.stderr,
112	        )
113	        mcp.run(host=args.host, port=args.port, stdio=False)
114	    else:
115	        # Auto-detect mode based on environment
116	        if os.environ.get("MCP_STDIO") or (not sys.stdin.isatty()):
117	            print("Remotion MCP Server starting in STDIO mode (auto-detected)", file=sys.stderr)
118	            mcp.run(stdio=True)
119	        else:
120	            print(
121	                f"Remotion MCP Server starting in HTTP mode on {args.host}:{args.port}",
122	                file=sys.stderr,
123	            )
124	            mcp.run(host=args.host, port=args.port, stdio=False)
125	
126	
127	if __name__ == "__main__":
128	    main()
129	

