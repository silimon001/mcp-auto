8	class MCPClientError(Exception):
9	    """Custom error class for MCP client errors."""
10	    pass
11	
12	# Configure logging
13	logging.basicConfig(level=logging.INFO)
14	logger = logging.getLogger(__name__)
15	
16	async def write_optimization_examples(original_code: str, optimization_result):
17	    """Write optimization examples to markdown file."""
18	    try:
19	        # Extract data from the response
20	        if not optimization_result.content:
21	            raise MCPClientError("No response data received from server")
22	            
23	        result = json.loads(optimization_result.content[0].text)
24	        
25	        if "status" in result and result["status"] == "error":
26	            raise ValueError(result.get('message', 'Unknown error'))
27	            
28	        # Extract optimized code
29	        optimized_code = result.get("optimized_code", "")
30	        if optimized_code.startswith("Here's the optimized code"):
31	            optimized_code = optimized_code.replace(
32	                "Here's the optimized code for high performance:\n\n```python\n",
33	                ""
34	            ).replace("\n```", "").strip()
35	        
36	        # Fix common import issues
37	        import_fixes = {
38	            "from pyspark.storage import StorageLevel": "from pyspark.storagelevel import StorageLevel",
39	            "from pyspark.sql.storage import StorageLevel": "from pyspark.storagelevel import StorageLevel"
40	        }
41	        
42	        for old_import, new_import in import_fixes.items():
43	            optimized_code = optimized_code.replace(old_import, new_import)
44	        
45	        # Add optimization comments at the top
46	        optimization_comments = """
47	# Spark Code Optimizations Applied:
48	#
49	# 1. Query Optimization:
50	#    - Pushed down filters before joins
51	#    - Eliminated unnecessary transformations
52	#    - Optimized data type conversions
53	#
54	# 2. Resource Management:
55	#    - Strategic data persistence
56	#    - Early filtering to reduce memory pressure
57	#    - Broadcast joins for small tables
58	#
59	# 3. Performance Tuning:
60	#    - Optimized partition strategy
61	#    - Minimized data shuffling
62	#    - Used native Spark functions
63	"""
64	        
65	        # Write optimized code with comments
66	        os.makedirs("output", exist_ok=True)
67	        with open("output/optimized_spark_code.py", "w") as f:
68	            f.write(f"{optimization_comments}\n{optimized_code}")
69	            
70	    except Exception as e:
71	        logger.error(f"Error writing optimization examples: {str(e)}")
72	        os.makedirs("output", exist_ok=True)
73	        with open("output/optimized_spark_code.py", "w") as f:
