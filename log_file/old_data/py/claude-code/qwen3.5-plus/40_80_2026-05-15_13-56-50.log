637	@jsonrpc
638	def get_smali_code(filepath, item_signature):
639	    """Get the smali code of the given class or method in the APK file.
640	    The passed in item_signature needs to be a fully-qualified signature.
641	    Dex units use Java-style internal addresses to identify items:
642	    - package: Lcom/abc/
643	    - type: Lcom/abc/Foo;
644	    - method: Lcom/abc/Foo;->bar(I[JLjava/Lang/String;)V
645	    - field: Lcom/abc/Foo;->flag1:Z
646	    note filepath needs to be an absolute path
647	    """
648	    if not item_signature:
649	        raise JSONRPCError(-1, ErrorMessages.MISSING_PARAM)
650	
651	    apk = getOrLoadApk(filepath)
652	    codeUnit = apk.getDex()
653	
654	    # Optimized: Find item using unified identifier/signature logic
655	    item, item_type = find_item_by_signature(codeUnit, item_signature)
656	    if not item:
657	        # Check if it was a class or method for proper error message
658	        if "->" in item_signature:
659	            print(u"Method not found: {0}".format(item_signature).encode("utf-8"))
660	            raise_method_not_found(item_signature)
661	        else:
662	            print(u"Class not found: {0}".format(item_signature).encode("utf-8"))
663	            raise_class_not_found(item_signature)
664	
665	    if item_type == "method":
666	        instructions = item.getInstructions()
667	        lines = []
668	        for instruction in instructions:
669	            lines.append(instruction.format(None))
670	        return "\n".join(lines)
671	    elif item_type == "class":
672	        lines = []
673	        for method in item.getMethods():
674	            lines.append("method: " + method.getSignature(True))
675	            instructions = method.getInstructions()
676	            for instruction in instructions:
677	                lines.append(instruction.format(None))
678	            lines.append("")
679	        return "\n".join(lines)
680	
681	    return ""
