312	
313	            # Extract and format broker info
314	            brokers = []
315	            for broker_id, broker in metadata.brokers.items():
316	                brokers.append({
317	                    "id": broker_id,
318	                    "host": broker.host,
319	                    "port": broker.port
320	                })
321	
322	            # Get topic info
323	            topics = {}
324	            for topic_name, topic_metadata in metadata.topics.items():
325	                partitions = []
326	                for partition_id, partition in topic_metadata.partitions.items():
327	                    partitions.append({
328	                        "id": partition_id,
329	                        "leader": partition.leader,
330	                        "replicas": partition.replicas,
331	                        "isrs": partition.isrs  # In-sync replicas
332	                    })
333	
334	                topics[topic_name] = {
335	                    "partitions": partitions,
336	                    "partition_count": len(partitions)
337	                }
338	
339	            # Combine into cluster metadata
340	            cluster_metadata = {
341	                "cluster_id": metadata.cluster_id,
342	                "controller_id": metadata.controller_id,
343	                "broker_count": len(brokers),
344	                "brokers": brokers,
345	                "topic_count": len(topics),
346	                "topics": topics
347	            }
348	
