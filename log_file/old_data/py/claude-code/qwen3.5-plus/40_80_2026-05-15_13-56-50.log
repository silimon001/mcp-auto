2290	        formatter_class=argparse.RawDescriptionHelpFormatter,
2291	        epilog="""
2292	Commands:
2293	  install     Install daemon, skill, and configure MCP
2294	  uninstall   Remove daemon (and optionally skill/config)
2295	  start       Start the daemon
2296	  stop        Stop the daemon
2297	  restart     Restart the daemon
2298	  status      Show current status
2299	  run         Run server directly (without daemon)
2300	
2301	Examples:
2302	  coach-claude install
2303	  coach-claude status
2304	  coach-claude run --transport sse --port 8787
2305	""",
2306	    )
