659	@mcp.tool()
660	def execute_python(code: str) -> str:
661	    """
662	    Execute arbitrary Python code in DaVinci Resolve.
663	
664	    Args:
665	        code: The Python code to execute
666	
667	    Returns:
668	        The result of the code execution
669	    """
670	    if not resolve_api.is_connected():
671	        return "Error: Not connected to DaVinci Resolve."
672	
673	    # Create a local namespace with access to the Resolve API
674	    local_namespace = {
675	        "resolve_api": resolve_api,
676	        "resolve": resolve_api.resolve,
677	        "fusion": resolve_api.fusion,
678	        "project_manager": resolve_api.project_manager,
679	        "current_project": resolve_api.current_project,
680	        "media_storage": resolve_api.media_storage,
681	        "media_pool": resolve_api.media_pool,
682	    }
683	
684	    try:
685	        # Execute the code in the local namespace
686	        exec(code, globals(), local_namespace)
687	
688	        # Update the Resolve API objects with any changes made in the code
689	        resolve_api.resolve = local_namespace.get("resolve", resolve_api.resolve)
690	        resolve_api.fusion = local_namespace.get("fusion", resolve_api.fusion)
691	        resolve_api.project_manager = local_namespace.get(
692	            "project_manager", resolve_api.project_manager
693	        )
694	        resolve_api.current_project = local_namespace.get(
695	            "current_project", resolve_api.current_project
696	        )
697	        resolve_api.media_storage = local_namespace.get("media_storage", resolve_api.media_storage)
698	        resolve_api.media_pool = local_namespace.get("media_pool", resolve_api.media_pool)
699	
700	        # Check for a result variable
701	        if "result" in local_namespace:
702	            result = local_namespace["result"]
703	            return str(result)
704	
705	        return "Code executed successfully."
