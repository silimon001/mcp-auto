2323	
2324	    # start
2325	    start_parser = subparsers.add_parser("start", help="Start daemon")
2326	    start_parser.add_argument("--host", default="127.0.0.1", help="Host (default: 127.0.0.1)")
2327	    start_parser.add_argument(
2328	        "--port", type=int, default=DEFAULT_PORT, help=f"Port (default: {DEFAULT_PORT})"
2329	    )
2330	    start_parser.set_defaults(func=cmd_start)
2331	
2332	    # stop
2333	    stop_parser = subparsers.add_parser("stop", help="Stop daemon")
2334	    stop_parser.set_defaults(func=cmd_stop)
2335	
