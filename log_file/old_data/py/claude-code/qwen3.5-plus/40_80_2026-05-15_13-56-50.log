704	        )
705	        raise JSONRPCError(-1, ErrorMessages.DECOMPILE_FAILED)
706	
707	    # Optimized: Find item using unified identifier/signature logic
708	    item, item_type = find_item_by_signature(codeUnit, item_signature)
709	    if not item:
710	        if "->" in item_signature:
711	            print(u"Method not found: {0}".format(item_signature).encode("utf-8"))
