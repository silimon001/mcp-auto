195	            return
196	
197	        content_length = int(self.headers.get("Content-Length", 0))
198	        if content_length == 0:
199	            self.send_jsonrpc_error(-32700, "Parse error: missing request body", None)
200	            return
201	
202	        if content_length > 10 * 1024 * 1024:  # 10MB limit
203	            self.send_jsonrpc_error(-32600, "Request too large", None)
