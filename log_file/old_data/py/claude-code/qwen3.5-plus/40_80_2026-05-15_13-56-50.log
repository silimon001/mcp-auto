529	async def lldb_examine(ctx: Context, session_id: str, expression: str, format: str = "x", count: int = 1) -> str:
530	    """Examine memory"""
531	    try:
532	        session = get_session(ctx, session_id)
533	        
534	        # Map format codes to LLDB format specifiers
