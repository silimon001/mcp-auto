685	def get_decompiled_code(filepath, item_signature):
686	    """Get the decompiled code of the given class or method in the APK file.
687	    The passed in item_signature needs to be a fully-qualified signature.
688	    Dex units use Java-style internal addresses to identify items:
689	    - package: Lcom/abc/
690	    - type: Lcom/abc/Foo;
691	    - method: Lcom/abc/Foo;->bar(I[JLjava/Lang/String;)V
692	    - field: Lcom/abc/Foo;->flag1:Z
693	    note filepath needs to be an absolute path
694	    """
695	    if not item_signature:
696	        raise JSONRPCError(-1, ErrorMessages.MISSING_PARAM)
697	
698	    apk = getOrLoadApk(filepath)
699	    codeUnit = apk.getDex()
700	    decomp = DecompilerHelper.getDecompiler(codeUnit)
701	    if not decomp:
702	        print(
703	            u"Cannot acquire decompiler for unit: {0}".format(codeUnit).encode("utf-8")
704	        )
705	        raise JSONRPCError(-1, ErrorMessages.DECOMPILE_FAILED)
706	
707	    # Optimized: Find item using unified identifier/signature logic
708	    item, item_type = find_item_by_signature(codeUnit, item_signature)
709	    if not item:
710	        if "->" in item_signature:
711	            print(u"Method not found: {0}".format(item_signature).encode("utf-8"))
712	            raise_method_not_found(item_signature)
713	        else:
714	            print(u"Class not found: {0}".format(item_signature).encode("utf-8"))
715	            raise_class_not_found(item_signature)
716	
717	    if item_type == "method":
718	        if not decomp.decompileMethod(item.getSignature()):
719	            print(
720	                u"Failed decompiling method: {0}".format(item_signature).encode("utf-8")
721	            )
722	            raise JSONRPCError(-1, ErrorMessages.DECOMPILE_FAILED)
723	        return decomp.getDecompiledMethodText(item.getSignature())
724	    elif item_type == "class":
