21	
22	class GracefulKiller:
23	    """Handle shutdown signals gracefully."""
24	    
25	    def __init__(self):
26	        self.kill_now = False
27	        signal.signal(signal.SIGINT, self._handle_signal)
28	        signal.signal(signal.SIGTERM, self._handle_signal)
29	    
30	    def _handle_signal(self, signum, frame):
31	        # Only log to stderr when running as MCP server
32	        logger = logging.getLogger(__name__)
33	        logger.info(f"Received signal {signum}, shutting down gracefully...")
34	        self.kill_now = True
35	
36	
37	def setup_logging(level: str = "INFO", log_file: Optional[str] = None, mcp_mode: bool = False):
38	    """Setup logging configuration."""
39	    handlers = []
40	    
41	    # Always add file handler if specified
42	    if log_file:
43	        file_handler = logging.FileHandler(log_file)
44	        file_handler.setFormatter(
45	            logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
46	        )
47	        handlers.append(file_handler)
48	    
49	    # Only add console handler if NOT in MCP mode
50	    if not mcp_mode:
51	        handlers.append(RichHandler(console=console, show_time=True, show_path=False))
52	    else:
53	        # In MCP mode, log to stderr instead of stdout
54	        stderr_handler = logging.StreamHandler(sys.stderr)
55	        stderr_handler.setFormatter(
56	            logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
57	        )
58	        handlers.append(stderr_handler)
59	    
60	    logging.basicConfig(
61	        level=getattr(logging, level),
62	        format="%(message)s",
63	        datefmt="[%X]",
64	        handlers=handlers,
65	        force=True  # Override any existing configuration
66	    )
67	    
68	    # Reduce noise from ib_async
69	    logging.getLogger('ib_async').setLevel(logging.WARNING)
70	
71	
72	async def test_connection():
73	    """Test IBKR connection and basic functionality."""
74	    console.print("[bold blue]🧪 Testing IBKR MCP Server...[/bold blue]")
75	    
76	    try:
77	        # Test connection
78	        console.print("📡 Testing IBKR connection...")
79	        await ibkr_client.connect()
80	        console.print("✅ Connection successful!")
81	        
82	        # Test basic functionality
83	        console.print("🔍 Testing basic functionality...")
84	        accounts = await ibkr_client.get_accounts()
85	        console.print(f"📊 Found {len(accounts)} accounts")
86	        
87	        # Test tools
88	        console.print("🛠️ Testing MCP tools...")
89	        tools = server.list_tools()
90	        console.print(f"⚙️ Loaded {len(tools)} tools")
91	        
92	        console.print("[bold green]✅ All tests passed![/bold green]")
93	        return True
94	        
95	    except Exception as e:
96	        console.print(f"[bold red]❌ Test failed: {e}[/bold red]")
97	        return False
98	    finally:
99	        await ibkr_client.disconnect()
100	
101	
102	async def run_server():
103	    """Run the MCP server with connection management."""
104	    logger = logging.getLogger(__name__)
105	    
106	    # Note: No console.print() calls here as they interfere with MCP protocol
107	    logger.info("Starting IBKR MCP Server...")
108	    
109	    try:
110	        # Start MCP server immediately - connection will be established on demand
111	        logger.info("Starting MCP server...")
112	        async with stdio_server() as (read_stream, write_stream):
113	            await server.run(
114	                read_stream,
115	                write_stream,
116	                server.create_initialization_options()
117	            )
118	            
119	    except KeyboardInterrupt:
120	        logger.info("Keyboard interrupt received")
121	    except Exception as e:
122	        logger.error(f"Server error: {e}")
123	        raise
124	    finally:
125	        try:
126	            await ibkr_client.disconnect()
127	        except:
128	            pass
129	        logger.info("Server shutdown complete")
