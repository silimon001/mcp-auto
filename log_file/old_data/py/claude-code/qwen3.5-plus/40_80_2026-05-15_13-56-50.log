32	@mcp.tool()
33	async def get_today_tasks(timezone: str = "Asia/Jakarta"):
34	    """
35	    Returns all tasks due today across all projects.
36	
37	    Args:
38	        timezone: IANA timezone string (default: Asia/Jakarta).
39	    """
40	    tz = ZoneInfo(timezone)
41	    today_start = datetime.now(tz).replace(hour=0, minute=0, second=0, microsecond=0)
42	    today_end = today_start + timedelta(days=1)
43	
44	    async with httpx.AsyncClient() as client:
45	        # Get all projects
46	        resp = await client.get(f"{TICKTICK_API_BASE}/project", headers=HEADERS)
47	        data = resp.json()
48	        projects = data if isinstance(data, list) else data.get("projects", [])
49	
50	        today_tasks = []
51	        for project in projects:
52	            pid = project["id"]
53	            pname = project.get("name", "")
54	            resp = await client.get(
55	                f"{TICKTICK_API_BASE}/project/{pid}/data", headers=HEADERS
56	            )
57	            data = resp.json()
58	            tasks = data.get("tasks", [])
59	            for task in tasks:
60	                due = task.get("dueDate") or task.get("startDate")
61	                if not due:
62	                    continue
63	                # Parse TickTick date format (e.g. "2019-11-13T03:00:00+0000")
64	                try:
65	                    dt = datetime.fromisoformat(due.replace("+0000", "+00:00"))
66	                    dt_local = dt.astimezone(tz)
67	                    if today_start <= dt_local < today_end:
68	                        task["_projectName"] = pname
69	                        today_tasks.append(task)
70	                except (ValueError, TypeError):
71	                    continue
72	
73	        return today_tasks
