1	#!/usr/bin/env python3
2	"""
3	MCP Server: GAIT (Git for AI Tracking) for Gemini-CLI, Claude Desktop, and VS Code.
4	
5	Design goals:
6	- STDIO MCP: NEVER write to stdout except protocol (FastMCP handles this)
7	- Log to STDERR only
8	- Be resilient when GAIT is not initialized yet (return structured errors)
9	- Enforce: DO NOT init at filesystem root
10	- Provide GAIT-native revert/reset semantics (optionally also reset memory)
11	- Provide remote add/list/get + push/fetch/pull/clone + repo create
12	
13	Gemini-CLI note:
14	Some Gemini wrappers call tools using one of these styles:
15	  tool(args=[...], kwargs={...})
16	  tool(call_args=[...], call_kwargs={...})
17	So we must accept and unpack those safely.
18	"""
19	
20	from __future__ import annotations
21	
22	import functools
23	import inspect
24	import logging
25	import os
26	import re
27	import datetime
28	import sys
29	from pathlib import Path
30	from typing import Any, Dict, List, Optional, Tuple
31	
32	# ---------------------------------------------------------------------
33	# Logging (stderr only)
34	# ---------------------------------------------------------------------
35	logging.basicConfig(
36	    level=logging.INFO,
37	    format="%(asctime)s | %(name)s | %(levelname)s | %(message)s",
38	    stream=sys.stderr,
39	)
40	logging.getLogger("mcp.server.lowlevel.server").setLevel(logging.WARNING)
41	
42	log = logging.getLogger("GaitMCP")
43	
44	# ---------------------------------------------------------------------
45	# MCP
46	# ---------------------------------------------------------------------
47	try:
48	    from mcp.server.fastmcp import FastMCP
49	except Exception:
50	    try:
51	        from fastmcp import FastMCP  # type: ignore
52	    except Exception as e:
53	        log.error("FastMCP not found. Install with: pip install mcp")
54	        raise
55	
56	# ---------------------------------------------------------------------
57	# GAIT core
58	# ---------------------------------------------------------------------
59	from gait.repo import GaitRepo
60	from gait.schema import Turn
61	from gait.tokens import count_turn_tokens
62	from gait.objects import short_oid
63	from gait.log import walk_commits
64	
65	# ---------------------------------------------------------------------
66	# GAIT remote (your real implementation)
67	# ---------------------------------------------------------------------
68	from gait.remote import (
69	    RemoteSpec,
70	    remote_add,
71	    remote_get,
72	    remote_list,
73	    push as remote_push,
74	    fetch as remote_fetch,
75	    pull as remote_pull,
76	    clone_into,
77	    create_repo as remote_create_repo,
78	)
79	
80	if sys.version_info < (3, 11):
81	    # Shim for Python 3.10 compatibility
82	    import datetime as dt
83	    if not hasattr(dt, 'UTC'):
84	        dt.UTC = dt.timezone.utc
85	
86	# ---------------------------------------------------------------------
87	
88	mcp = FastMCP("GAIT")
89	
90	# ---------------------------------------------------------------------
91	# Helpers
92	# ---------------------------------------------------------------------
93	def _err(msg: str, *, detail: str = "", **extra: Any) -> Dict[str, Any]:
94	    out: Dict[str, Any] = {"ok": False, "error": msg}
95	    if detail:
96	        out["detail"] = detail
97	    out.update(extra)
98	    return out
99	
