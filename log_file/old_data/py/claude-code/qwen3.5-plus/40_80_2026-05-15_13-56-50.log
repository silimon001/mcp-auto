953	def _try_rename_in_java_method(decomp, java_method, old_var_name, new_var_name):
954	    """
955	    尝试在一个已反编译的 IJavaMethod 中查找并重命名变量。
956	    返回 (found: bool, debug_info: list)
957	    """
958	    debug_info = []
959	
960	    # Strategy A: Use IdentifierManager
961	    try:
962	        idmgr = java_method.getIdentifierManager()
963	        if idmgr:
964	            all_idents = idmgr.getIdentifiers()
965	            if all_idents:
966	                for ident in all_idents:
967	                    defn = idmgr.getDefinition(ident)
968	                    iname = None
969	                    if defn and hasattr(defn, "getName"):
970	                        iname = defn.getName()
971	                    if not iname:
972	                        iname = str(ident)
973	
974	                    if iname == old_var_name:
975	                        if hasattr(decomp, "setIdentifierName"):
976	                            try:
977	                                res = decomp.setIdentifierName(ident, new_var_name)
978	                                if res:
979	                                    return True, debug_info
980	                            except Exception:
981	                                pass
982	                        try:
983	                            if defn and hasattr(defn, "setName"):
984	                                defn.setName(new_var_name)
985	                                return True, debug_info
986	                        except Exception:
987	                            pass
988	        else:
989	            debug_info.append("idmgr=None")
990	    except Exception as e:
991	        debug_info.append("idmgr_err=" + str(e))
992	
993	    # Strategy B: Check method parameters directly (handles p0, p1...)
994	    try:
995	        params = java_method.getParameters()
996	        if params:
997	            for param in params:
998	                if param.getIdentifier().getName() == old_var_name:
999	                    param.getIdentifier().setName(new_var_name)
1000	                    return True, debug_info
1001	    except Exception as e:
1002	        debug_info.append("param_err=" + str(e))
1003	
1004	    return False, debug_info
1005	
