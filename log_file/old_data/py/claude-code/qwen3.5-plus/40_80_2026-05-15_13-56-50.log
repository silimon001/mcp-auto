1287	def _find_unit_in_index(index, input_path, prefixes):
1288	    """
1289	    Unified fuzzy path matcher. Supports direct, prefix, and suffix matching.
1290	    """
1291	    if not isinstance(input_path, unicode):
1292	        input_path = input_path.decode("utf-8")
1293	
1294	    # Step 1: Direct Matching
1295	    leaf = index.get(input_path)
1296	    if leaf:
1297	        return leaf
1298	
1299	    # Step 2: Try stripping user-provided prefixes if they exist in input_path
1300	    for prefix in prefixes:
1301	        if input_path.startswith(prefix):
1302	            stripped_path = input_path[len(prefix) :]
1303	            if stripped_path in index:
1304	                return index[stripped_path]
1305	
1306	    # Step 3: Try adding prefixes to match index paths
1307	    for prefix in prefixes:
1308	        candidate = prefix + input_path
1309	        if candidate in index:
1310	            return index[candidate]
1311	
1312	    # Step 4: Suffix matching (powerful fallback)
1313	    suffix = input_path if input_path.startswith("/") else ("/" + input_path)
1314	    for path, unit in index.items():
1315	        if path.endswith(suffix):
1316	            return unit
1317	
1318	    return None
1319	
