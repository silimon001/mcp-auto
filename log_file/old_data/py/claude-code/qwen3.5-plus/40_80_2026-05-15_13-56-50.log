536	            "x": "x",      # hex
537	            "d": "d",      # decimal
538	            "u": "u",      # unsigned decimal
539	            "o": "o",      # octal
540	            "t": "t",      # binary
541	            "i": "i",      # instruction
542	            "c": "c",      # character
543	            "f": "f",      # float
544	            "s": "s"       # string
545	        }
546	        
547	        # Get LLDB format or default to hex
548	        lldb_format = format_map.get(format, "x")
549	        
550	        # Build memory examine command
551	        command = f"memory read -f {lldb_format} -c {count} {expression}"
552	        output = await session.execute_command(command)
