2128	def _is_platform_type(signature):
2129	    """判断签名是否属于 Android/Java/Dalvik 平台类型"""
2130	    return (
2131	        signature.startswith("Ldalvik")
2132	        or signature.startswith("Ljava")
2133	        or signature.startswith("Landroid")
2134	    )
2135	
2136	
2137	def raise_class_not_found(class_signature):
2138	    if _is_platform_type(class_signature):
2139	        raise JSONRPCError(-1, ErrorMessages.CLASS_NOT_FOUND_WITHOUT_CHECK)
2140	    raise JSONRPCError(-1, ErrorMessages.CLASS_NOT_FOUND)
2141	
2142	
2143	def raise_method_not_found(method_signature):
2144	    if _is_platform_type(method_signature):
2145	        raise JSONRPCError(-1, ErrorMessages.METHOD_NOT_FOUND_WITHOUT_CHECK)
2146	    raise JSONRPCError(-1, ErrorMessages.METHOD_NOT_FOUND)
2147	
2148	
2149	def raise_field_not_found(field_signature):
2150	    if _is_platform_type(field_signature):
2151	        raise JSONRPCError(-1, ErrorMessages.FIELD_NOT_FOUND_WITHOUT_CHECK)
2152	    raise JSONRPCError(-1, ErrorMessages.FIELD_NOT_FOUND)
