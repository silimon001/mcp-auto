28	class LldbSession:
29	    def __init__(self, session_id: str, lldb_path: str, working_dir: Optional[str] = None):
30	        self.id = session_id
31	        self.lldb_path = lldb_path
32	        self.working_dir = working_dir or os.getcwd()
33	        self.process = None
34	        self.master_fd = None
