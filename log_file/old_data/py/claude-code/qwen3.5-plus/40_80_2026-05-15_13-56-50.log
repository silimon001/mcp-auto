735	def find_item_by_signature(codeUnit, item_signature):
736	    """
737	    Find a code item (Class, Method, or Field) by its fully-qualified signature.
738	    Returns: (item, type_name) where type_name is 'class', 'method', 'field' or ''.
739	    """
740	    if not item_signature:
741	        return None, ""
742	
743	    # Harmonize signature to unicode for handles non-ASCII characters in Jython 2.7
744	    if isinstance(item_signature, str):
745	        try:
746	            item_signature = item_signature.decode("utf-8")
747	        except Exception:
748	            item_signature = item_signature.decode("utf-8", "ignore")
749	
750	    item = None
751	    # 1. Try to determine type by signature pattern
752	    if item_signature.startswith("L") and item_signature.endswith(";"):
753	        item = codeUnit.getClass(item_signature)
754	        if item:
755	            return item, "class"
756	    elif "->" in item_signature:
757	        if "(" in item_signature:
758	            item = codeUnit.getMethod(item_signature)
759	            if item:
760	                return item, "method"
761	        else:
762	            item = codeUnit.getField(item_signature)
763	            if item:
764	                return item, "field"
765	
766	    # 2. Generic fallback if pattern didn't match or direct lookup failed
767	    try:
768	        for lookup in [codeUnit.getClass, codeUnit.getMethod, codeUnit.getField]:
769	            item = lookup(item_signature)
770	            if item:
771	                return item, lookup.__name__[3:].lower()  # getField -> field
772	    except Exception:
773	        pass
774	
775	    return None, ""
776	
