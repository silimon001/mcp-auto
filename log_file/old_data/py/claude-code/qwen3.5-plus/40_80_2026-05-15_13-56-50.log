1938	@jsonrpc
1939	def perform_security_scan(filepath):
1940	    """
1941	    Performs a comprehensive security scan on the APK, covering three areas:
1942	    1. Packer Detection: Identifies known packers/protectors via file signature matching (rules from 'apkpackdata.json').
1943	    2. SDK Identification: Detects embedded third-party SDKs by matching native library names (rules from 'sdk.json').
1944	    3. Sensitive String/API Scan: Searches the DEX string pool, method and class signatures for sensitive patterns (rules from 'sensitive_strings.txt').
1945	    Returns a flat list of dicts, each with 'type' ('Packer', 'SDK', or 'Sensitive String'), 'name', and 'detail'.
1946	    """
1947	    apk = getOrLoadApk(filepath)
1948	    codeUnit = apk.getDex()
1949	
1950	    # 1. Load sensitive APIs (cached)
1951	    u_apis, regex = _load_sensitive_apis()
1952	
1953	    # 2. Packer & SDK Scan
1954	    print(u"[MCP] Phase 1/4: Scanning file signatures for Packers and SDKs...")
1955	    all_file_results = _scan_apk_for_packers(apk)
1956	
1957	    packer_results = [
1958	        r for r in all_file_results if r[u"category"] == u"Packer (ApkCheckPack)"
1959	    ]
1960	    sdk_results = [r for r in all_file_results if r[u"category"] == u"SDK"]
1961	
1962	    # 3. DEX Sensitive Scan
1963	    dex_results = []
1964	    if codeUnit:
1965	        print(u"[MCP] Phase 2/4: Scanning DEX string pool...")
1966	        dex_hits = {}
1967	
1968	        # Pull data once
1969	        all_dex_content = []
1970	        for s in codeUnit.getStrings():
1971	            all_dex_content.append(s.getValue())
1972	        for m in codeUnit.getMethods():
1973	            all_dex_content.append(m.getSignature(True))
1974	        for c in codeUnit.getClasses():
1975	            all_dex_content.append(c.getSignature(True))
1976	
1977	        print(u"[MCP] Phase 3/4: Matching rules against DEX content...")
1978	        # 优化：使用预编译的正则全局对象
1979	        if regex:
1980	            for content in all_dex_content:
1981	                if not content:
1982	                    continue
1983	                # findall 返回所有非重叠匹配
1984	                matches = regex.findall(content)
1985	                if matches:
1986	                    for rule in set(matches):
1987	                        if rule not in dex_hits:
1988	                            dex_hits[rule] = set()
1989	                        dex_hits[rule].add(content)
1990	
1991	        print(u"[MCP] Phase 4/4: Finalizing DEX results...")
1992	        for rule in u_apis:
1993	            if rule in dex_hits:
1994	                unique_matches = list(dex_hits[rule])
1995	                dex_results.append(
1996	                    {
1997	                        "category": "Sensitive API/String",
1998	                        "name": rule,
1999	                        "count": len(unique_matches),
2000	                        "matches": unique_matches[:10],
2001	                    }
2002	                )
2003	
2004	    # Combine results into a flat list as required by the return type list[dict]
2005	    final_results = []
2006	
2007	    for p in packer_results:
2008	        final_results.append(
2009	            {u"type": u"Packer", u"name": p[u"name"], u"detail": p[u"detail"]}
2010	        )
2011	
2012	    for s in sdk_results:
2013	        final_results.append({u"type": u"SDK", u"name": s[u"name"], u"detail": s[u"detail"]})
2014	
2015	    for d in dex_results:
2016	        final_results.append(
2017	            {
2018	                u"type": u"Sensitive String",
2019	                u"name": d[u"name"],
2020	                u"detail": u"Hits: {0}".format(d[u"count"]),
2021	            }
2022	        )
2023	
2024	    return final_results
2025	
