132	@click.command()
133	@click.option('--test', is_flag=True, help='Test connection and exit')
134	@click.option('--log-level', default=settings.log_level, help='Logging level')
135	@click.option('--log-file', default=settings.log_file, help='Log file path')
136	def cli(test: bool, log_level: str, log_file: str):
137	    """IBKR MCP Server - Interactive Brokers integration for Claude."""
138	    setup_logging(log_level, log_file, mcp_mode=not test)
139	    
140	    if test:
141	        # Run connection test
142	        success = asyncio.run(test_connection())
143	        sys.exit(0 if success else 1)
144	    else:
145	        # Run the server
146	        asyncio.run(run_server())
147	
