1591	    for r in file_results:
1592	        if r["type"] == "content":
1593	            for m in r["matches"]:
1594	                results.append(
1595	                    {
1596	                        "Text": m,
1597	                        "Unit": unit_label,
1598	                        "Document": r["path"],
1599	                        "Location": r["path"],
1600	                    }
1601	                )
1602	        elif r["type"] == "path":
1603	            results.append(
1604	                {
1605	                    "Text": r["path"],
1606	                    "Unit": unit_label,
1607	                    "Document": "Directory/File",
1608	                    "Location": r["path"],
1609	                }
1610	            )
