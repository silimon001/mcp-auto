567	@mcp.tool()
568	def create_fusion_node_chain(node_chain: List[Dict[str, Any]]) -> str:
569	    """
570	    Create a chain of connected Fusion nodes in the current composition.
571	
572	    Args:
573	        node_chain: A list of dictionaries, each containing:
574	                    - 'type': The type of node to create
575	                    - 'name': Optional name for the node
576	                    - 'params': Optional dictionary of parameters to set on the node
577	
578	    Returns:
579	        A message indicating success or failure
580	    """
581	    if not resolve_api.is_connected():
582	        return "Error: Not connected to DaVinci Resolve."
583	
584	    # Get the current Fusion composition
585	    comp = resolve_api.get_current_comp()
586	    if not comp:
587	        return "No active Fusion composition. Please open the Fusion page and select a composition first."
588	
589	    if not node_chain or len(node_chain) == 0:
590	        return "No nodes specified in the chain."
591	
592	    try:
593	        # Create the first node
594	        prev_node = None
595	        nodes_created = []
596	
597	        for node_info in node_chain:
598	            node_type = node_info.get("type")
599	            if not node_type:
600	                continue
601	
602	            # Create the node
603	            node = resolve_api.create_fusion_node(comp, node_type, node_info.get("params"))
604	
605	            if not node:
606	                continue
607	
608	            # Set the node name if provided
609	            if "name" in node_info and node_info["name"]:
610	                node.SetAttrs({"TOOLS_Name": node_info["name"]})
611	
612	            # Connect to previous node if this isn't the first node
613	            if prev_node:
614	                # Connect the main output of the previous node to the main input of this node
615	                node.ConnectInput("Input", prev_node)
616	
617	            prev_node = node
618	            nodes_created.append(node_type)
619	
620	        if not nodes_created:
621	            return "Failed to create any nodes in the chain."
622	
623	        return f"Successfully created node chain: {' -> '.join(nodes_created)}"
624	    except Exception as e:
625	        return f"Error creating node chain: {str(e)}"
