1	import os, json, httpx
2	from fastmcp import FastMCP
3	
4	client = httpx.AsyncClient(
5	    base_url="https://developers-oaplus.line.biz",
6	    headers={"X-API-KEY": os.getenv("X_API_KEY")}
7	)
8	
9	with open("./openapi.json", "r") as f:
10	    openapi_spec = json.load(f)
11	
12	# Create the MCP server
13	mcp = FastMCP.from_openapi(
14	    openapi_spec=openapi_spec,
15	    client=client,
16	    name="LINE Shopping API MCP server",
17	)
18	
19	if __name__ == "__main__":
