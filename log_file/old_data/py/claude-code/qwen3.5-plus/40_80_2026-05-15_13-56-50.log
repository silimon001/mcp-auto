2155	CTX = None
2156	
2157	# ---------------------------------------------------------------------------
2158	# 热重载支持
2159	# ---------------------------------------------------------------------------
2160	# 核心问题：JEB 每次 Run Script 时, Jython 会重新执行整个模块, 产生新的
2161	# rpc_registry / Server 实例。但旧的 HTTP Server 线程仍在运行并占用端口。
2162	#
2163	# 解决方案：利用 Java 的 System Properties 在 JVM 级别保存旧 Server 的引用。
2164	# 脚本被重新执行时, 可以通过同一个 property key 找到并关闭旧 Server, 然后
2165	# 启动携带最新代码的新 Server，无需重启 JEB。
2166	# ---------------------------------------------------------------------------
2167	
2168	
2169	_MCP_SERVER_PROP_KEY = "__jeb_mcp_server_instance__"
2170	
2171	
2172	def _stop_previous_server():
2173	    """
2174	    尝试关闭上一次脚本运行时遗留的 HTTP Server。
2175	    通过 Java System Properties 存取跨模块加载的 Server 引用。
2176	    """
2177	    try:
2178	        old_server = JavaSystem.getProperties().get(_MCP_SERVER_PROP_KEY)
2179	        if old_server is not None:
2180	            print("[MCP] Hot-reload: stopping previous server...")
2181	            old_server.stop()
2182	            JavaSystem.getProperties().remove(_MCP_SERVER_PROP_KEY)
2183	            # 给操作系统一点时间释放端口
2184	            time.sleep(0.3)
2185	            print("[MCP] Hot-reload: previous server stopped.")
2186	    except Exception as e:
2187	        print(u"[MCP] Hot-reload: failed to stop previous server: {0}".format(e))
2188	
2189	
2190	def _save_server_reference(server):
2191	    """将当前 Server 实例保存到 Java System Properties 中，供下次热重载使用。"""
2192	    JavaSystem.getProperties().put(_MCP_SERVER_PROP_KEY, server)
2193	
2194	
2195	class MCP(IScript):
2196	    def __init__(self):
2197	        self.server = None
2198	        print(u"[MCP] Plugin loaded")
2199	
2200	    def run(self, ctx):
2201	        global CTX
2202	        CTX = ctx
2203	
2204	        # 1. 关闭上一次运行遗留的旧 Server (热重载核心)
