16	def format_time_ago(minutes: int, timestamp: int = None) -> str:
17	    """Format minutes ago into human-friendly text.
18	
19	    Args:
20	        minutes: Number of minutes ago
21	        timestamp: Optional unix timestamp (used to show actual time for longer durations)
22	
23	    Returns:
24	        Human-friendly time string like "a few minutes ago" or "around 9:30 AM"
25	    """
26	    from datetime import datetime
27	
28	    if minutes < 5:
29	        return "just now"
30	    elif minutes < 15:
31	        return "a few minutes ago"
32	    elif minutes < 30:
33	        return "about 20 minutes ago"
34	    elif minutes < 45:
35	        return "about half an hour ago"
36	    elif minutes < 75:
37	        return "about an hour ago"
38	    elif minutes < 120:
39	        return "a bit over an hour ago"
40	    elif minutes < 180:
41	        return "a couple hours ago"
42	    else:
43	        # For longer times, show the actual time
44	        if timestamp:
45	            dt = datetime.fromtimestamp(timestamp)
46	            now = datetime.now()
47	            # Check if it's a different day
48	            if dt.date() != now.date():
49	                # Show date and time for different days
50	                if dt.year != now.year:
51	                    return f"{dt.strftime('%b %d, %Y')} at {dt.strftime('%I:%M %p').lstrip('0')}"
52	                else:
53	                    return f"{dt.strftime('%b %d')} at {dt.strftime('%I:%M %p').lstrip('0')}"
54	            return f"around {dt.strftime('%I:%M %p').lstrip('0')}"
55	        else:
56	            hours = minutes // 60
57	            if hours < 24:
58	                return f"about {hours} hours ago"
59	            else:
60	                days = hours // 24
61	                return f"about {days} day{'s' if days > 1 else ''} ago"
