2028	def export_all_resources(filepath, output_dir=""):
2029	    """
2030	    Export all accessible resources and assets to a local directory structure.
2031	    If output_dir is empty, defaults to a 'dump' directory next to the APK.
2032	    """
2033	    apk = getOrLoadApk(filepath)
2034	
2035	    if not output_dir:
2036	        # Determine the default output directory from the active Artifact
2037	        apk_path = None
2038	        engctx = CTX.getEnginesContext()
2039	        if engctx and engctx.getProjects():
2040	            prj = engctx.getProjects()[0]
2041	            for art in prj.getLiveArtifacts():
2042	                if art.getMainUnit() == apk:
2043	                    apk_path = art.getArtifact().getName()
2044	                    break
2045	
2046	        if apk_path and os.path.exists(apk_path):
2047	            base = os.path.splitext(apk_path)[0]
2048	            output_dir = base + "_dump"
2049	        else:
2050	            output_dir = os.path.join(os.getcwd(), "dump")
2051	
2052	    # 1. Export Resources
2053	    res_index = _get_resource_index(apk)
2054	    # 2. Export Assets
2055	    asset_index = _get_asset_index(apk)
2056	
2057	    total = len(res_index) + len(asset_index)
2058	    success = 0
2059	
2060	    # helper for exporting
2061	    def save_units(index, base_name):
2062	        import java.lang.Throwable
2063	        from java.io import FileOutputStream
2064	
2065	        curr_success = 0
2066	        for path, unit in index.items():
2067	            try:
2068	                # Sanitize path for local FS
2069	                rel_path = path.replace("/", os.sep)
2070	                # 过滤 Windows 非法路径字符
2071	                for c in '<>:"|?*':
2072	                    rel_path = rel_path.replace(c, "_")
2073	
2074	                full_path = os.path.join(output_dir, base_name, rel_path)
2075	
2076	                p_dir = os.path.dirname(full_path)
2077	                if not os.path.exists(p_dir):
2078	                    os.makedirs(p_dir)
2079	
2080	                # 优先：直接调用 Java 原生 IO 缓冲流将文件推到磁盘，绕过 Jython 字符串内存分配，防止超大体积 OOM
2081	                has_streamed = False
2082	                if hasattr(unit, "getInput"):
2083	                    inp = unit.getInput()
2084	                    if inp:
2085	                        stream = inp.getStream()
2086	                        if stream:
2087	                            fos = FileOutputStream(full_path)
2088	                            buffer = zeros(16384, "b")  # 16KB block
2089	                            while True:
2090	                                read_bytes = stream.read(buffer)
2091	                                if read_bytes <= 0:
2092	                                    break
2093	                                fos.write(buffer, 0, read_bytes)
2094	                            fos.close()
2095	                            stream.close()
2096	                            has_streamed = True
2097	                            curr_success += 1
2098	
2099	                if has_streamed:
2100	                    continue
2101	
2102	                # 降级备用：如果不是物理文件源，则尝试使用内部文字提取并序列化
2103	                content = _extract_text_content(unit)
2104	                if content:
2105	                    with open(full_path, "wb") as f:
2106	                        if isinstance(content, unicode):
2107	                            f.write(content.encode("utf-8"))
2108	                        else:
2109	                            f.write(content)
2110	                    curr_success += 1
2111	            except java.lang.Throwable:
2112	                pass
2113	            except Exception:
2114	                pass
2115	        return curr_success
2116	
2117	    success += save_units(res_index, "res")
2118	    success += save_units(asset_index, "assets")
2119	
2120	    return {
2121	        "status": "success",
2122	        "total": total,
2123	        "exported": success,
2124	        "output_dir": output_dir,
2125	    }
