1613	@jsonrpc
1614	def search_in_project(filepath, query, search_type="string"):
1615	    """
1616	    Search for strings or identifiers (classes/methods) in the project.
1617	    search_type can be 'string' (default), 'identifier', 'resource', or 'asset'.
1618	    - 'string': search DEX string pool for matching values.
1619	    - 'identifier': search class/method signatures.
1620	    - 'resource': search resource file paths and text content (xml, json, etc).
1621	    - 'asset': search asset file paths and text content.
1622	    """
1623	    if not query:
1624	        raise JSONRPCError(-1, ErrorMessages.MISSING_PARAM)
1625	
1626	    apk = getOrLoadApk(filepath)
1627	    results = []
1628	
1629	    if search_type == "string":
1630	        codeUnit = apk.getDex()
1631	        if codeUnit:
1632	            unit_name = (
1633	                codeUnit.getName() if hasattr(codeUnit, "getName") else "Bytecode"
1634	            )
1635	            for s in codeUnit.getStrings():
1636	                val = s.getValue()
1637	                if val and query in val:
1638	                    loc_addr = (
1639	                        u"0x{0:X}".format(s.getItemId())
1640	                        if hasattr(s, "getItemId")
1641	                        else u""
1642	                    )
1643	                    results.append(
1644	                        {
1645	                            "Text": val,
1646	                            "Unit": unit_name,
1647	                            "Document": "String pool",
1648	                            "Location": loc_addr,
1649	                        }
1650	                    )
1651	
1652	        # Search resources and assets to mimic 'Entire Project' search
1653	        _append_file_search_results(
1654	            results,
1655	            _search_in_file_index(_get_resource_index(apk), query, "resource"),
1656	            "Resources",
1657	        )
1658	        _append_file_search_results(
1659	            results,
1660	            _search_in_file_index(_get_asset_index(apk), query, "asset"),
1661	            "Assets",
1662	        )
1663	
1664	    elif search_type == "identifier":
1665	        codeUnit = apk.getDex()
1666	        if not codeUnit:
1667	            raise JSONRPCError(-1, "[Error] DEX unit not found.")
1668	        unit_name = codeUnit.getName() if hasattr(codeUnit, "getName") else "Bytecode"
1669	        for c in codeUnit.getClasses():
1670	            sig = c.getSignature(True)
1671	            if query in sig:
1672	                results.append(
1673	                    {
1674	                        "Text": sig,
1675	                        "Unit": unit_name,
1676	                        "Document": "Class",
1677	                        "Location": sig,
1678	                    }
1679	                )
1680	        for m in codeUnit.getMethods():
1681	            sig = m.getSignature(True)
1682	            if query in sig:
1683	                results.append(
1684	                    {
1685	                        "Text": sig,
1686	                        "Unit": unit_name,
1687	                        "Document": "Method",
1688	                        "Location": sig,
1689	                    }
1690	                )
1691	
1692	    elif search_type == "resource":
1693	        _append_file_search_results(
1694	            results,
1695	            _search_in_file_index(_get_resource_index(apk), query, "resource"),
1696	            "Resources",
1697	        )
1698	    elif search_type == "asset":
1699	        _append_file_search_results(
1700	            results,
1701	            _search_in_file_index(_get_asset_index(apk), query, "asset"),
1702	            "Assets",
1703	        )
1704	    else:
1705	        raise JSONRPCError(
1706	            -1,
1707	            "[Error] Invalid search_type. Use 'string', 'identifier', 'resource', or 'asset'.",
1708	        )
1709	
1710	    return results
