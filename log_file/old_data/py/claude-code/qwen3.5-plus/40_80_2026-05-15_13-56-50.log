1376	@mcp.tool()
1377	@requires_graph_auth
1378	async def upload_file_to_sharepoint_folder(ctx: Context, drive_id: str, folder_id: str, file_name: str, file_content: bytes):
1379	    """
1380	    Upload a file to a specific folder in SharePoint
1381	
1382	    Args:
1383	        ctx: FastMCP Context
1384	        drive_id: The drive ID
1385	        folder_id: The folder's item ID
1386	        file_name: Name for the file
1387	        file_content: File content as bytes
1388	    """
1389	    import httpx
1390	
1391	    settings = ctx.request_context.lifespan_context.settings
1392	    token = settings.credential.get_token("https://graph.microsoft.com/.default")
1393	
1394	    async with httpx.AsyncClient() as client:
1395	        response = await client.put(
1396	            f"https://graph.microsoft.com/v1.0/drives/{drive_id}/items/{folder_id}:/{file_name}:/content",
1397	            headers={
1398	                "Authorization": f"Bearer {token.token}",
1399	                "Content-Type": "text/plain"
1400	            },
1401	            content=file_content
1402	        )
1403	        return response.json()
