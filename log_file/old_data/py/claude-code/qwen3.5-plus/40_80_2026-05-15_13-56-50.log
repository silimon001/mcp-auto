450	def getOrLoadApk(filepath):
451	    engctx = CTX.getEnginesContext()
452	    if not engctx:
453	        print("Back-end engines not initialized")
454	        raise JSONRPCError(-1, ErrorMessages.LOAD_APK_FAILED)
455	
456	    if not filepath:
457	        # 尝试返回当前已经在 JEB 中打开的活动 APK
458	        projects = engctx.getProjects()
459	        if projects and len(projects) > 0:
460	            prj = projects[0]
461	
462	            # 使用 JEB 官方工具寻找已经建立连接的 APK 单元
463	            apks = RuntimeProjectUtil.findUnitsByType(prj, IApkUnit, False)
464	            if apks and len(apks) > 0:
465	                print("[MCP] No filepath provided, returning active APK unit.")
466	                return apks[0]
467	
468	            # Fallback 策略
469	            for artifact in prj.getLiveArtifacts():
470	                unit = artifact.getMainUnit()
471	                if isinstance(unit, IApkUnit):
472	                    print("[MCP] No filepath provided, returning active APK artifact.")
473	                    return unit
474	        raise JSONRPCError(
475	            -1,
476	            "[Error] No active APK currently opened in JEB, please specify filepath.",
477	        )
478	
479	    if not os.path.exists(filepath):
480	        print(u"File not found: %s" % filepath)
481	        raise JSONRPCError(-1, ErrorMessages.LOAD_APK_NOT_FOUND)
482	
483	    # Load or create the project in the same directory as the APK file
484	    project_path = filepath + ".jdb2"
485	    project = engctx.loadProject(project_path)
486	    correspondingArtifact = None
487	    for artifact in project.getLiveArtifacts():
488	        if artifact.getArtifact().getName() == filepath:
489	            # If the artifact is already loaded, return it
490	            correspondingArtifact = artifact
491	            break
492	
493	    if correspondingArtifact:
494	        # Update its position in the queue to mark it as most recently used
495	        if correspondingArtifact in artifactQueue:
496	            artifactQueue.remove(correspondingArtifact)
497	            artifactQueue.append(correspondingArtifact)
498	    else:
499	        # try to load the artifact, but first check if the queue size has been exceeded
500	        while len(artifactQueue) >= MAX_OPENED_ARTIFACTS:
501	            # unload the oldest artifact
502	            oldestArtifact = getArtifactFromQueue()
503	            if oldestArtifact:
504	                # unload the artifact
505	                oldestArtifactName = oldestArtifact.getArtifact().getName()
506	                print(
507	                    u"Unloading artifact: %s because queue size limit exceeded"
508	                    % oldestArtifactName
509	                )
510	                try:
511	                    RuntimeProjectUtil.destroyLiveArtifact(oldestArtifact)
512	                except Exception as e:
513	                    print(u"[MCP] Error destroying artifact: %s" % str(e))
514	
515	        # Fix: 直接用filepath而不是basename作为Artifact的名称，否则如果加载了多个同名不同路径的apk，会出现问题。
516	        correspondingArtifact = project.processArtifact(
517	            Artifact(filepath, FileInput(File(filepath)))
518	        )
519	        if not correspondingArtifact:
520	            raise JSONRPCError(-1, ErrorMessages.LOAD_APK_FAILED)
521	        addArtifactToQueue(correspondingArtifact)
522	        clear_apk_cache()
523	
524	    unit = correspondingArtifact.getMainUnit()
525	    if isinstance(unit, IApkUnit):
526	        # If the unit is already loaded, return it
527	        return unit
528	    raise JSONRPCError(-1, ErrorMessages.LOAD_APK_FAILED)
529	
