1256	def _build_unit_tree_index(root_unit, cache_key):
1257	    """
1258	    Unified iterative DFS to build a path -> Unit index for any tree-like Unit structure.
1259	    Uses LRU caching based on the provided cache_key.
1260	    """
1261	    cached = _get_from_cache(cache_key)
1262	    if cached is not None:
1263	        return cached
1264	
1265	    index = {}
1266	    if not root_unit:
1267	        return index
1268	
1269	    # Iterative DFS to build index
1270	    stack = [(root_unit, "")]
1271	    while stack:
1272	        current, current_path = stack.pop()
1273	        children = current.getChildren()
1274	        if not children:
1275	            if current_path:
1276	                index[current_path] = current
1277	            continue
1278	        for child in children:
1279	            name = child.getName()
1280	            new_path = (current_path + "/" + name) if current_path else name
1281	            stack.append((child, new_path))
1282	
1283	    _add_to_cache(cache_key, index)
1284	    return index
1285	
