355	    def check_cluster_health(self):
356	        """
357	        Check the health of the Kafka cluster.
358	
359	        Returns:
360	            Dict with health status and details
361	        """
362	        try:
363	            metadata = self.get_cluster_metadata()
364	
365	            # Extract broker and topic info
366	            broker_count = metadata["broker_count"]
367	            topics = metadata["topics"]
368	
369	            # Check if we have at least one broker
370	            if broker_count == 0:
371	                return {
372	                    "status": "critical",
373	                    "message": "No brokers available in the cluster",
374	                    "details": metadata
375	                }
376	
377	            # Check for topics with under-replicated partitions
378	            under_replicated_topics = []
379	            for topic_name, topic_info in topics.items():
380	                for partition in topic_info["partitions"]:
381	                    if len(partition["isrs"]) < len(partition["replicas"]):
382	                        under_replicated_topics.append(topic_name)
383	                        break
384	
385	            # Determine overall health status
386	            if under_replicated_topics:
387	                status = "warning"
388	                message = f"Cluster has {len(under_replicated_topics)} topics with under-replicated partitions"
389	            else:
390	                status = "healthy"
391	                message = f"Cluster is healthy with {broker_count} brokers and {len(topics)} topics"
392	
393	            return {
394	                "status": status,
395	                "message": message,
396	                "broker_count": broker_count,
397	                "topic_count": len(topics),
398	                "under_replicated_topics": under_replicated_topics,
399	                "timestamp": datetime.now().isoformat()
400	            }
401	        except Exception as e:
402	            error_msg = f"Failed to check cluster health: {str(e)}"
