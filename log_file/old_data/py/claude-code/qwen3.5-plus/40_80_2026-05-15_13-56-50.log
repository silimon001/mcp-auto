41	def get_type_hints(func):
42	    """
43	    Mock for get_type_hints for Python 2.7 / Jython compatibility.
44	    Extracts positional arg names via inspect.getargspec.
45	    """
46	    hints = {}
47	
48	    if hasattr(func, "__annotations__"):
49	        hints.update(getattr(func, "__annotations__", {}))
50	
51	    try:
52	        args, varargs, keywords, defaults = inspect.getargspec(func)
53	    except Exception:
54	        return hints
55	
56	    for arg in args:
57	        if arg == "self":
58	            continue
59	        if arg not in hints:
60	            hints[arg] = Any
61	
62	    return hints
