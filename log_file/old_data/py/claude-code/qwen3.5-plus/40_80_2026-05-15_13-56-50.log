1400	def add_comment(filepath, address, comment):
1401	    """
1402	    Add a comment to function, class, field or any address in a code unit.
1403	    The address can be a signature (e.g., Lcom/abc/Foo;->bar()V) or a virtual address.
1404	    """
1405	    if not address or comment is None:
1406	        raise JSONRPCError(-1, ErrorMessages.MISSING_PARAM)
1407	
1408	    apk = getOrLoadApk(filepath)
1409	    codeUnit = apk.getDex()
1410	
1411	    # Support offset syntax: Lcom/abc/Foo;->bar()V+0x10
1412	    lookup_address = address
1413	    offset_str = ""
1414	    if "->" in address and "+" in address:
1415	        parts = address.split("+")
1416	        lookup_address = parts[0]
1417	        offset_str = parts[1]
1418	
1419	    item, item_type = find_item_by_signature(codeUnit, lookup_address)
1420	
1421	    if item:
1422	        # Align instruction boundary if providing an offset for a method
1423	        if item_type == "method" and offset_str:
1424	            try:
1425	                # strip potential 'h' suffix and parse as hex
1426	                raw_hex = offset_str.lower().replace("h", "").replace("0x", "")
1427	                req_offset = int(raw_hex, 16)
1428	
1429	                instructions = item.getInstructions()
1430	                if instructions:
1431	                    valid_offsets = [inst.getOffset() for inst in instructions]
1432	                    if req_offset not in valid_offsets:
1433	                        closest_offset = 0
1434	                        for off in valid_offsets:
1435	                            if off <= req_offset:
1436	                                closest_offset = off
1437	                            else:
1438	                                break
1439	                        # Fix the address to the valid boundary
1440	                        address = lookup_address + u"+0x{0:x}".format(closest_offset)
1441	                        print(
1442	                            "[MCP] add_comment: requested offset {0:x} is inside an instruction. Auto-aligned to boundary {1:x} ({2})".format(
1443	                                req_offset, closest_offset, address
1444	                            ).encode("utf-8")
1445	                        )
1446	            except Exception as e:
1447	                print(
1448	                    "[MCP] add_comment boundary check failed: {0}".format(e).encode(
1449	                        "utf-8"
1450	                    )
1451	                )
1452	
1453	        itemId = item.getItemId()
1454	        # Using string formatting carefully for Python 2.7 unicode
1455	        print(
1456	            u"[MCP] add_comment: item found, itemId={0}, address={1}".format(
1457	                itemId, address
1458	            )
1459	        )
1460	
1461	        # JEB comment workflow: prepare -> set -> execute
1462	        data = ActionCommentData()
1463	        # Using the original 'address' which contains the +offset if provided
1464	        act_ctx = ActionContext(codeUnit, Actions.COMMENT, itemId, address)
1465	        if codeUnit.prepareExecution(act_ctx, data):
1466	            data.setNewComment(comment)
1467	            if codeUnit.executeAction(act_ctx, data):
1468	                return True
1469	
1470	        # Fallback: trying with address only if it looks like a hex/dec address
1471	        data2 = ActionCommentData()
1472	        act_ctx2 = ActionContext(codeUnit, Actions.COMMENT, 0, address)
1473	        if codeUnit.prepareExecution(act_ctx2, data2):
1474	            data2.setNewComment(comment)
1475	            if codeUnit.executeAction(act_ctx2, data2):
1476	                return True
1477	
1478	        msg = u"[Error] Failed to add comment to item: " + address
1479	        raise JSONRPCError(-1, msg)
1480	    else:
1481	        # Handle decimal or hex virtual addresses directly
1482	
1483	        try:
1484	            # Check if address is numeric (dec or hex)
1485	            if address.lower().startswith("0x"):
1486	                int(address, 16)
1487	            else:
1488	                int(address)
1489	
1490	            data = ActionCommentData()
1491	            act_ctx = ActionContext(codeUnit, Actions.COMMENT, 0, address)
1492	            if codeUnit.prepareExecution(act_ctx, data):
1493	                data.setNewComment(comment)
1494	                if codeUnit.executeAction(act_ctx, data):
1495	                    return True
1496	        except ValueError:
1497	            pass
1498	
1499	        msg = u"[Error] Could not resolve address or signature: " + address
1500	        raise JSONRPCError(-1, msg)
