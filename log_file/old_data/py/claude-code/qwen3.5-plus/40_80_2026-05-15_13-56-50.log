1008	def rename_pseudo_code_variables(
1009	    filepath, method_signature, old_var_name, new_var_name
1010	):
1011	    """
1012	    Rename one or more local variables or parameters defined in the decompiled pseudo-code of a method.
1013	    The method must have been decompiled first.
1014	    Also supports renaming variables inside lambda expressions by automatically
1015	    searching synthetic lambda methods in the same class.
1016	    """
1017	    if not method_signature or not old_var_name or not new_var_name:
1018	        raise JSONRPCError(-1, ErrorMessages.MISSING_PARAM)
1019	
1020	    apk = getOrLoadApk(filepath)
1021	
1022	    codeUnit = apk.getDex()
1023	    method = codeUnit.getMethod(method_signature)
1024	    if not method:
1025	        raise_method_not_found(method_signature)
1026	
1027	    decomp = DecompilerHelper.getDecompiler(codeUnit)
1028	    if not decomp:
1029	        raise JSONRPCError(-1, ErrorMessages.DECOMPILE_FAILED)
1030	
1031	    # Ensure method is decompiled
1032	    method_sig = method.getSignature()
1033	    if not decomp.decompileMethod(method_sig):
1034	        raise JSONRPCError(-1, ErrorMessages.DECOMPILE_FAILED)
1035	
1036	    java_method = None
1037	    try:
1038	        java_method = decomp.getMethod(method_sig, False)
1039	    except Exception as e:
1040	        print(u"[MCP] decomp.getMethod failed: {0}".format(e).encode("utf-8"))
1041	
1042	    all_debug = []
1043	
1044	    # Strategy 1 & 2: Try in the target method itself
1045	    if java_method:
1046	        found, dbg = _try_rename_in_java_method(
1047	            decomp, java_method, old_var_name, new_var_name
1048	        )
1049	        all_debug.extend(dbg)
1050	        if found:
1051	            return True
1052	
1053	    # Strategy 3: Search lambda/synthetic methods in the same class
1054	    # Lambda variables belong to compiler-generated methods like lambda$xxx$0
1055	    try:
1056	        # Extract class signature from method signature: "Lcom/Foo;->bar()V" -> "Lcom/Foo;"
1057	        class_sig = method_signature.split("->")[0]
1058	        if not class_sig.endswith(";"):
1059	            class_sig = class_sig + ";"
1060	        dex_class = codeUnit.getClass(class_sig)
1061	        if dex_class:
1062	            class_methods = dex_class.getMethods()
1063	            if class_methods:
1064	                for m in class_methods:
1065	                    m_sig = m.getSignature(True)
1066	                    m_name = m.getName(True)
1067	                    # Only check lambda$ and access$ synthetic methods
1068	                    if not m_name:
1069	                        continue
1070	                    if "lambda$" not in m_name and "access$" not in m_name:
1071	                        continue
1072	                    # Skip the original method itself
1073	                    if m_sig == method_sig:
1074	                        continue
1075	                    try:
1076	                        if not decomp.decompileMethod(m_sig):
1077	                            continue
1078	                        jm = decomp.getMethod(m_sig, False)
1079	                        if not jm:
1080	                            continue
1081	                        found, dbg = _try_rename_in_java_method(
1082	                            decomp, jm, old_var_name, new_var_name
1083	                        )
1084	                        all_debug.extend(dbg)
1085	                        if found:
1086	                            return True
1087	                    except Exception:
1088	                        continue
1089	        else:
1090	            all_debug.append("class_not_found=" + class_sig)
1091	
1092	        # Strategy 4: Search inner anonymous classes (e.g. OuterClass$1)
1093	        inner_class_prefix = class_sig[:-1] + "$"
1094	        for clz in codeUnit.getClasses():
1095	            if clz.getSignature(True).startswith(inner_class_prefix):
1096	                for m in clz.getMethods():
1097	                    m_sig = m.getSignature(True)
1098	                    if m_sig == method_sig:
1099	                        continue
1100	                    try:
1101	                        if not decomp.decompileMethod(m_sig):
1102	                            continue
1103	                        jm = decomp.getMethod(m_sig, False)
1104	                        if not jm:
1105	                            continue
1106	                        found, dbg = _try_rename_in_java_method(
1107	                            decomp, jm, old_var_name, new_var_name
1108	                        )
1109	                        # We don't append every single inner class dbg failure to avoid huge error msgs
1110	                        if found:
1111	                            return True
1112	                    except Exception:
1113	                        continue
1114	
1115	    except Exception as e:
1116	        all_debug.append("lambda_scan_err=" + str(e))
1117	
1118	    msg = u"[Error] Variable '{0}' not found in method {1} (including lambda methods). Debug: {2}".format(
1119	        old_var_name, method_signature, u"; ".join(all_debug)
1120	    )
1121	    raise JSONRPCError(-1, msg)
1122	
