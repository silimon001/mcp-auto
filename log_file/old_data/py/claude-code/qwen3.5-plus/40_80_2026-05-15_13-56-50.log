554	@jsonrpc
555	def get_exported_components(filepath, component_type):
556	    """
557	    Get all exported components of the specified type from the APK manifest.
558	    A component is considered "exported" if:
559	    - It explicitly sets android:exported="true", or
560	    - It omits android:exported but includes an <intent-filter> (implicitly exported).
561	    component_type can be: 'activity', 'service', 'receiver', 'provider'.
562	    Returns a list of fully qualified exported component class names.
563	    """
564	    if not component_type:
565	        raise JSONRPCError(-1, ErrorMessages.MISSING_PARAM)
566	
567	    # 校验组件类型
568	    valid_types = ("activity", "service", "receiver", "provider")
569	    if component_type not in valid_types:
570	        raise JSONRPCError(
571	            -1,
572	            "[Error] Invalid component_type. Must be one of: " + ", ".join(valid_types),
573	        )
574	
575	    cache_key = "exported_" + component_type + "s_" + filepath
576	
577	    # 首先尝试在缓存中取，跳过XML解析。
578	    cached = _get_from_cache(cache_key)
579	    if cached is not None:
580	        return cached
581	
582	    manifest_text = get_manifest(filepath)
583	    manifest_text = preprocess_manifest_py2(manifest_text)
584	
585	    if not manifest_text:
586	        raise JSONRPCError(-1, ErrorMessages.GET_MANIFEST_FAILED)
587	
588	    try:
589	        root = ET.fromstring(manifest_text.encode("utf-8"))
590	    except Exception as e:
591	        print("[MCP] Error parsing manifest:", e)
592	        raise JSONRPCError(-1, ErrorMessages.GET_MANIFEST_FAILED)
593	
594	    ANDROID_NS = "http://schemas.android.com/apk/res/android"
595	    exported_components = []
596	
597	    # 获取包名
598	    package_name = root.attrib.get("package", "").strip()
599	
600	    # 查找 <application> 节点
601	    app_node = root.find("application")
602	    if app_node is None:
603	        raise JSONRPCError(-1, ErrorMessages.GET_MANIFEST_FAILED)
604	
605	    for node in app_node.findall(component_type):
606	        name = node.attrib.get("{" + ANDROID_NS + "}name")
607	        exported = node.attrib.get("{" + ANDROID_NS + "}exported")
608	        has_intent_filter = len(node.findall("intent-filter")) > 0
609	
610	        if not name:
611	            continue
612	
613	        if exported == "true" or (exported is None and has_intent_filter):
614	            normalized = []
615	            seen = set()
616	
617	            def _add_unique(val):
618	                if val not in seen:
619	                    seen.add(val)
620	                    normalized.append(val)
621	
622	            if name.startswith("."):
623	                _add_unique(package_name + name)
624	            elif "." not in name:
625	                _add_unique(name)
626	                _add_unique(package_name + "." + name)
627	            else:
628	                _add_unique(name)
629	
630	            exported_components.extend(normalized)
631	
632	    # 缓存数据
633	    _add_to_cache(cache_key, exported_components)
634	    return exported_components
635	
