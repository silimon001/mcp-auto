1744	def _scan_apk_for_packers(apk):
1745	    """
1746	    Internal helper to scan APK units for packer signatures (File-based).
1747	    Inspired by ApkCheckPack.
1748	    """
1749	    results = []
1750	    script_dir = os.path.dirname(os.path.abspath(__file__))
1751	    rules_dir = os.path.join(script_dir, "rules")
1752	
1753	    # Load rules
1754	    # from https://github.com/moyuwa/ApkCheckPack/tree/main/data
1755	    apkpack_data = _load_json_rules(os.path.join(rules_dir, "apkpackdata.json"))
1756	    sdk_data = _load_json_rules(os.path.join(rules_dir, "sdk.json"))
1757	
1758	    # Collect all file paths and potentially contents in APK
1759	    all_paths = set()
1760	    all_contents_list = []  # Use a list for safer joining
1761	
1762	    # Iterative DFS to collect all unit paths (avoids stack overflow on deep trees)
1763	    stack = [(apk, "")]
1764	    while stack:
1765	        current_unit, current_path = stack.pop()
1766	        try:
1767	            name = current_unit.getName()
1768	            if name:
1769	                if isinstance(name, bytes):
1770	                    name = name.decode("utf-8", "ignore")
1771	                elif not isinstance(name, unicode):
1772	                    name = unicode(name)
1773	
1774	                all_paths.add(name)
1775	                # Full composite path
1776	                full_p = (current_path + "/" + name) if current_path else name
1777	                all_paths.add(full_p)
1778	
1779	                # Content extraction
1780	                if (
1781	                    name.endswith(".xml")
1782	                    or name.endswith(".txt")
1783	                    or name.endswith(".json")
1784	                ):
1785	                    # 防止由于恶意打包大尺寸文本导致 Jython 内存溢出
1786	                    if hasattr(current_unit, "getInput"):
1787	                        inp = current_unit.getInput()
1788	                        if inp and inp.getSize() > 2 * 1024 * 1024:
1789	                            continue
1790	
1791	                    content = _extract_text_content(current_unit)
1792	                    if content:
1793	                        if isinstance(content, str):
1794	                            content = content.decode("utf-8", "ignore")
1795	                        all_contents_list.append(content)
1796	            else:
1797	                full_p = current_path
1798	
1799	            children = current_unit.getChildren()
1800	            if children:
1801	                for child in children:
1802	                    stack.append((child, full_p))
1803	        except Exception:
1804	            pass
1805	
1806	    all_contents_combined = u"\n".join(all_contents_list)
1807	    print(
1808	        u"[MCP] Collected {0} paths and content length {1}".format(
1809	            len(all_paths), len(all_contents_combined)
1810	        )
1811	    )
1812	
1813	    # Match against apkpackdata.json
1814	    if apkpack_data:
1815	        for packer_name, rules in apkpack_data.items():
1816	            hit = False
1817	            matched_feature = None
1818	
1819	            # soname
1820	            sonames = rules.get("soname", [])
1821	            for sn in sonames:
1822	                for ap in all_paths:
1823	                    if sn in ap:
1824	                        hit = True
1825	                        matched_feature = "SO: " + sn
1826	                        break
1827	                if hit:
1828	                    break
1829	
1830	            # other (files)
1831	            if not hit:
1832	                others = rules.get("other", [])
1833	                for ot in others:
1834	                    if ot in all_paths:
1835	                        hit = True
1836	                        matched_feature = "File: " + ot
1837	                        break
1838	
1839	            # Match content
1840	            if not hit and all_contents_combined:
1841	                others = rules.get("other", [])
1842	                for ot in others:
1843	                    if ot in all_contents_combined:
1844	                        hit = True
1845	                        matched_feature = "Content: " + ot
1846	                        break
1847	
1848	                if not hit:
1849	                    keywords = rules.get("keywords", [])
1850	                    for kw in keywords:
1851	                        if kw in all_contents_combined:
1852	                            hit = True
1853	                            matched_feature = "Keyword: " + kw
1854	                            break
1855	
1856	            if hit:
1857	                results.append(
1858	                    {
1859	                        u"category": u"Packer (ApkCheckPack)",
1860	                        u"name": packer_name,
1861	                        u"detail": matched_feature,
1862	                    }
1863	                )
1864	
1865	    # Match against sdk.json (List of dicts: {"soname": "...", "zh": {"label": "..."}})
1866	    if sdk_data:
1867	        for sdk_entry in sdk_data:
1868	            sn = sdk_entry.get("soname")
1869	            if not sn:
1870	                continue
1871	
1872	            hit = False
1873	            for ap in all_paths:
1874	                if sn in ap:
1875	                    hit = True
1876	                    break
1877	
1878	            if hit:
1879	                label = (
1880	                    sdk_entry.get(u"zh", {}).get(u"label")
1881	                    or sdk_entry.get(u"en", {}).get(u"label")
1882	                    or sn
1883	                )
1884	                dev = (
1885	                    sdk_entry.get(u"zh", {}).get(u"dev_team")
1886	                    or sdk_entry.get(u"en", {}).get(u"dev_team")
1887	                    or u"Unknown"
1888	                )
1889	                results.append(
1890	                    {
1891	                        u"category": u"SDK",
1892	                        u"name": label,
1893	                        u"detail": u"Team: {0} (Match: {1})".format(dev, sn),
1894	                    }
1895	                )
1896	
1897	    return results
