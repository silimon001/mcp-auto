338	# 定义为 unicode 字符串 (u'...')
339	def preprocess_manifest_py2(manifest_text):
340	    """
341	    一个为 Python 2 设计的、健壮的 Manifest 预处理函数。
342	    它会清理非法字符，并强行移除所有 <meta-data> 标签以避免解析错误。
343	    """
344	    # 1. 确保输入是 unicode 字符串，并忽略解码错误
345	    if isinstance(manifest_text, str):
346	        try:
347	            manifest_text = manifest_text.decode("utf-8")
348	        except UnicodeDecodeError:
349	            manifest_text = manifest_text.decode("utf-8", "ignore")
350	
351	    # 2. 清理基本的非法 XML 字符
352	    # (保留这个作为基础卫生措施)
353	    cleaned_chars = []
354	    for char in manifest_text:
355	        codepoint = ord(char)
356	        if (
357	            codepoint == 0x9
358	            or codepoint == 0xA
359	            or codepoint == 0xD
360	            or (codepoint >= 0x20 and codepoint <= 0xD7FF)
361	            or (codepoint >= 0xE000 and codepoint <= 0xFFFD)
362	            or (codepoint >= 0x10000 and codepoint <= 0x10FFFF)
363	        ):
364	            cleaned_chars.append(char)
365	    text_no_illegal_chars = "".join(cleaned_chars)
366	
367	    # 3. 使用正则表达式，强行移除所有 <meta-data ... /> 标签
368	    # re.DOTALL 使得 '.' 可以匹配包括换行在内的任意字符
369	    # re.IGNORECASE 忽略大小写
370	    # ur'...' 定义一个 unicode 正则表达式
371	    text_no_metadata = re.sub(
372	        r"<\s*meta-data.*?/>",
373	        "",  # 替换为空字符串，即直接删除
374	        text_no_illegal_chars,
375	        flags=re.DOTALL | re.IGNORECASE,
376	    )
377	
378	    return text_no_metadata
