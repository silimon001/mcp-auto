92	class RPCRegistry(object):
93	    def __init__(self):
94	        self.methods = {}
95	
96	    def register(self, func):
97	        self.methods[func.__name__] = func
98	        return func
99	
100	    def dispatch(self, method, params):
101	        if method not in self.methods:
102	            raise JSONRPCError(-32601, u"Method '{0}' not found".format(method))
103	
104	        func = self.methods[method]
105	        hints = get_type_hints(func)
106	
107	        # Remove return annotation if present
108	        if "return" in hints:
109	            hints.pop("return", None)
110	
111	        # Python 2.7 兼容性：统一将字符串参数转换为 unicode
112	        def to_unicode(v):
113	            if isinstance(v, str):
114	                try:
115	                    return v.decode("utf-8")
116	                except Exception:
117	                    return v.decode("utf-8", "ignore")
118	            return v
119	
120	        # 获取参数默认值信息以支持可选参数
121	        try:
122	            _args, _, _, _defaults = inspect.getargspec(func)
123	            _args = [a for a in _args if a != "self"]
124	            _num_defaults = len(_defaults) if _defaults else 0
125	            _num_required = len(_args) - _num_defaults
126	        except Exception:
127	            _args = list(hints.keys())
128	            _num_required = len(_args)
129	
130	        def validate_list(params, hints):
131	            if len(params) < _num_required or len(params) > len(_args):
132	                raise JSONRPCError(
133	                    -32602,
134	                    u"Expected {0}-{1} args, got {2}".format(
135	                        _num_required, len(_args), len(params)
136	                    ),
137	                )
138	            return [to_unicode(p) for p in params]
139	
140	        def validate_dict(params, hints):
141	            extra = set(params.keys()) - set(hints.keys())
142	            if extra:
143	                raise JSONRPCError(-32602, u"Unexpected params: {0}".format(list(extra)))
144	            # 检查必需参数是否存在
145	            required_keys = set(_args[:_num_required])
146	            missing = required_keys - set(params.keys())
147	            if missing:
148	                raise JSONRPCError(
149	                    -32602, u"Missing required params: {0}".format(list(missing))
150	                )
151	            return {k: to_unicode(params[k]) for k in params}
152	
153	        if isinstance(params, list):
154	            return func(*validate_list(params, hints))
155	        elif isinstance(params, dict):
156	            return func(**validate_dict(params, hints))
157	        else:
158	            raise JSONRPCError(
159	                -32600, "Invalid Request: params must be array or object"
160	            )
