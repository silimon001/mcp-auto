1426	            const ws = new WebSocket(protocol + '//' + window.location.host + '/ws');
1427	
1428	            ws.onmessage = function(event) {{
1429	                const data = JSON.parse(event.data);
1430	                if (data.type === 'sessions') {{
1431	                    const count = data.count;
1432	                    const sessions = data.sessions || [];
1433	                    const dot = document.getElementById('sessions-dot');
1434	                    const countEl = document.getElementById('sessions-count');
1435	                    const detailsEl = document.getElementById('sessions-details');
1436	
1437	                    countEl.textContent = count + (count === 1 ? ' session' : ' sessions');
1438	
1439	                    if (count > 0) {{
1440	                        dot.classList.add('active');
1441	                        countEl.classList.add('active');
1442	                        detailsEl.innerHTML = sessions.map(s =>
1443	                            `<div class="session-item">
1444	                                <span class="session-id">${{s.id}}</span>
1445	                                <span class="session-duration">${{s.duration}}</span>
1446	                            </div>`
1447	                        ).join('');
1448	                    }} else {{
1449	                        dot.classList.remove('active');
1450	                        countEl.classList.remove('active');
1451	                        detailsEl.innerHTML = '<div class="no-sessions">No active sessions</div>';
1452	                    }}
1453	                }}
1454	            }};
1455	
1456	            ws.onclose = function() {{
1457	                // Reconnect after 2 seconds
1458	                setTimeout(connectWebSocket, 2000);
1459	            }};
1460	
1461	            ws.onerror = function() {{
1462	                ws.close();
1463	            }};
1464	        }}
1465	        connectWebSocket();
1466	    </script>
1467	</body>
1468	</html>"""
1469	        return html.encode("utf-8")
