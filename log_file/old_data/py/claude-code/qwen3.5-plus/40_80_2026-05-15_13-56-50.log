281	class Server(object):  # Use explicit inheritance from object for py2
282	    HOST = os.getenv("JEB_MCPC_HOST", "127.0.0.1")
283	    PORT = int(os.getenv("JEB_MCPC_PORT", "16161"))
284	
285	    def __init__(self):
286	        self.server = None
287	        self.server_thread = None
288	        self.running = False
289	
290	    def start(self):
291	        if self.running:
292	            print("[MCP] Server is already running")
293	            return
294	
295	        # Python 2.7 doesn't support daemon parameter in Thread constructor
296	        self.server_thread = threading.Thread(target=self._run_server)
297	        self.server_thread.daemon = True  # Set daemon attribute after creation
298	        self.running = True
299	        self.server_thread.start()
300	
301	    def stop(self):
302	        if not self.running:
303	            return
304	
305	        self.running = False
306	        if self.server:
307	            self.server.shutdown()
308	            self.server.server_close()
309	        if self.server_thread:
310	            self.server_thread.join()
311	            self.server = None
312	        print("[MCP] Server stopped")
313	
314	    def _run_server(self):
315	        try:
316	            # Create server in the thread to handle binding
317	            self.server = MCPHTTPServer(
318	                (Server.HOST, Server.PORT), JSONRPCRequestHandler
319	            )
320	            print(
321	                u"[MCP] Server started at http://{0}:{1}".format(
322	                    Server.HOST, Server.PORT
323	                )
324	            )
325	            self.server.serve_forever()
326	        except OSError as e:
327	            if e.errno == 98 or e.errno == 10048:  # Port already in use (Linux/Windows)
328	                print(u"[MCP] Error: Port {0} is already in use".format(Server.PORT))
329	            else:
330	                print(u"[MCP] Server error: {0}".format(e))
331	            self.running = False
332	        except Exception as e:
333	            print(u"[MCP] Server error: {0}".format(e))
334	        finally:
