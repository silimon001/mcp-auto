888	@jsonrpc
889	def check_java_identifier(filepath, identifier):
890	    """
891	    Check an identifier in the APK file and recognize if this is a class, method or field.
892	    the passed in identifier needs to be a fully-qualified name (like `com.abc.def.Foo`) or a signature;
893	    the passed in filepath needs to be a fully-qualified absolute path;
894	    the return value will be a list to tell you the possible type of the passed identifier.
895	    """
896	    if not identifier:
897	        raise JSONRPCError(-1, ErrorMessages.MISSING_PARAM)
898	
899	    apk = getOrLoadApk(filepath)
900	    codeUnit = apk.getDex()
901	
902	    # Normalize input to signature if needed
903	    sig = identifier
904	    if not (sig.startswith("L") and (sig.endswith(";") or ";->" in sig)):
905	        # Try converting from dot notation to signature notation
906	        if "." in identifier or not identifier.startswith("L"):
907	            sig = "L" + identifier.replace(".", "/") + ";"
908	
909	    # Use index-based lookup via find_item_by_signature for O(1) performance
910	    item, item_type = find_item_by_signature(codeUnit, sig)
911	
912	    # If not found with original sig, maybe it's a method without signature details
913	    if not item and ";" in sig and ";->" not in sig:
914	        # Try as a partial method match via replace_last_once
915	        fake_sig = replace_last_once(sig, ";", ";->")
916	        item, item_type = find_item_by_signature(codeUnit, fake_sig)
917	
918	    result = []
919	    if item:
920	        parent_sig = "N/A"
921	        if item_type == "class":
922	            parent_sig = item.getPackage().getSignature(True)
923	        elif item_type in ("method", "field"):
924	            parent_sig = item.getClassType().getSignature(True)
925	
926	        result.append(
927	            {
928	                "type": item_type,
929	                "signature": item.getSignature(True),
930	                "parent": parent_sig,
931	            }
932	        )
933	
934	    if len(result) == 0:
935	        if (
936	            identifier.startswith("dalvik")
937	            or identifier.startswith("Landroid")
938	            or identifier.startswith("android")
939	        ):
940	            result.append(
941	                {"type": "Android base type", "signature": "N/A", "parent": "N/A"}
942	            )
943	        elif identifier.startswith("Ljava") or identifier.startswith("java"):
944	            result.append(
945	                {"type": "Java base type", "signature": "N/A", "parent": "N/A"}
946	            )
947	        else:
948	            result.append({"type": "Not found", "signature": "N/A", "parent": "N/A"})
949	
950	    return result
951	
