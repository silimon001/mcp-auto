726	            print(
727	                u"Failed decompiling class: {0}".format(item_signature).encode("utf-8")
728	            )
729	            raise JSONRPCError(-1, ErrorMessages.DECOMPILE_FAILED)
730	        return decomp.getDecompiledClassText(item.getSignature())
731	
732	    return ""
