1503	def _search_in_file_index(index, query, category):
1504	    """
1505	    在文件索引(resource/asset)中搜索路径和文本内容。
1506	    - 路径匹配: 返回 {"type": "path", "category": ..., "path": ...}
1507	    - 内容匹配: 返回 {"type": "content", "category": ..., "path": ..., "matches": [...]}
1508	    """
1509	    TEXT_EXTENSIONS = (
1510	        ".xml",
1511	        ".json",
1512	        ".txt",
1513	        ".html",
1514	        ".htm",
1515	        ".css",
1516	        ".js",
1517	        ".properties",
1518	        ".cfg",
1519	        ".ini",
1520	        ".yml",
1521	        ".yaml",
1522	        ".csv",
1523	        ".smali",
1524	        ".pro",
1525	        ".gradle",
1526	        ".md",
1527	    )
1528	    results = []
1529	
1530	    for path, unit in index.items():
1531	        # 1. 路径匹配
1532	        if query in path:
1533	            results.append({"type": "path", "category": category, "path": path})
1534	
1535	        # 2. 文本内容匹配 (仅对文本类文件)
1536	        path_lower = path.lower()
1537	
1538	        # 优化：通过后缀快速过滤
1539	        is_text = False
1540	        for ext in TEXT_EXTENSIONS:
1541	            if path_lower.endswith(ext):
1542	                is_text = True
1543	                break
1544	
1545	        if is_text:
1546	            try:
1547	                # 检查输入源大小以避免内存暴涨
1548	                if hasattr(unit, "getInput"):
1549	                    inp = unit.getInput()
1550	                    if inp and inp.getSize() > 2 * 1024 * 1024:  # 2MB 限制
1551	                        continue
1552	
1553	                content = _extract_text_content(unit)
1554	                if not content:
1555	                    continue
1556	
1557	                if isinstance(content, str):
1558	                    try:
1559	                        content = content.decode("utf-8")
1560	                    except Exception:
1561	                        content = content.decode("utf-8", "ignore")
1562	
1563	                if query in content:
1564	                    matching_lines = []
1565	                    lines = content.split("\n")
1566	                    # 限制结果行数避免前端拥堵
1567	                    for i, line in enumerate(lines, 1):
1568	                        current_line = line.strip()
1569	                        if query in current_line:
1570	                            matching_lines.append(u"L{0}: {1}".format(i, current_line))
1571	                            if len(matching_lines) > 50:  # 每个文件最多匹配 50 行
1572	                                matching_lines.append("... (too many matches)")
1573	                                break
1574	                    if matching_lines:
1575	                        results.append(
1576	                            {
1577	                                "type": "content",
1578	                                "category": category,
1579	                                "path": path,
1580	                                "matches": matching_lines,
1581	                            }
1582	                        )
1583	            except Exception:
1584	                pass
1585	
1586	    return results
1587	
1588	
1589	def _append_file_search_results(results, file_results, unit_label):
1590	    """将 _search_in_file_index 的结果转换并追加到 results 列表中"""
1591	    for r in file_results:
1592	        if r["type"] == "content":
1593	            for m in r["matches"]:
1594	                results.append(
1595	                    {
1596	                        "Text": m,
1597	                        "Unit": unit_label,
1598	                        "Document": r["path"],
1599	                        "Location": r["path"],
1600	                    }
1601	                )
1602	        elif r["type"] == "path":
1603	            results.append(
1604	                {
1605	                    "Text": r["path"],
1606	                    "Unit": unit_label,
1607	                    "Document": "Directory/File",
1608	                    "Location": r["path"],
1609	                }
1610	            )
