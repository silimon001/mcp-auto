1910	    async def broadcast_sessions():
1911	        """Broadcast session count and details to all connected dashboard WebSockets."""
1912	        import json
1913	
1914	        now = int(time.time())
1915	        sessions_list = []
1916	        for sid, info in active_sessions.items():
1917	            duration = now - info["connected_at"]
1918	            mins = duration // 60
1919	            secs = duration % 60
1920	            sessions_list.append(
1921	                {
1922	                    "id": sid,
1923	                    "duration": f"{mins}m {secs}s" if mins > 0 else f"{secs}s",
1924	                }
1925	            )
1926	
1927	        message = json.dumps(
1928	            {
1929	                "type": "sessions",
1930	                "count": len(active_sessions),
1931	                "sessions": sessions_list,
1932	            }
1933	        )
1934	        disconnected = set()
1935	        for ws in dashboard_websockets:
1936	            try:
1937	                await ws.send({"type": "websocket.send", "text": message})
1938	            except Exception:
1939	                disconnected.add(ws)
1940	        dashboard_websockets.difference_update(disconnected)
1941	
1942	    async def handle_websocket(scope, receive, send):
1943	        """Handle WebSocket connection for real-time dashboard updates."""
1944	        import json
1945	
1946	        # Wait for the WebSocket connection request
1947	        message = await receive()
1948	        if message["type"] != "websocket.connect":
1949	            return
1950	
1951	        # Create a simple send wrapper
1952	        class WSSender:
1953	            def __init__(self, send_func):
1954	                self._send = send_func
1955	
1956	            async def send(self, message):
1957	                await self._send(message)
1958	
1959	        ws = WSSender(send)
1960	
1961	        # Accept the WebSocket connection
1962	        await send({"type": "websocket.accept"})
1963	        dashboard_websockets.add(ws)
1964	
1965	        # Send initial session data with details
1966	        now = int(time.time())
1967	        sessions_list = []
1968	        for sid, info in active_sessions.items():
1969	            duration = now - info["connected_at"]
1970	            mins = duration // 60
1971	            secs = duration % 60
1972	            sessions_list.append(
1973	                {
1974	                    "id": sid,
1975	                    "duration": f"{mins}m {secs}s" if mins > 0 else f"{secs}s",
1976	                }
1977	            )
1978	        initial = json.dumps(
1979	            {
1980	                "type": "sessions",
1981	                "count": len(active_sessions),
1982	                "sessions": sessions_list,
1983	            }
1984	        )
1985	        await send({"type": "websocket.send", "text": initial})
1986	
1987	        try:
1988	            while True:
1989	                message = await receive()
1990	                if message["type"] == "websocket.disconnect":
1991	                    break
1992	                # We don't expect any messages from the client, but handle ping/pong if needed
1993	        finally:
1994	            dashboard_websockets.discard(ws)
1995	
1996	    async def asgi_app(scope, receive, send):
1997	        """Pure ASGI application for MCP SSE server."""
1998	        if scope["type"] == "websocket":
1999	            path = scope["path"]
2000	            if path == "/ws":
2001	                await handle_websocket(scope, receive, send)
2002	            else:
2003	                await send({"type": "websocket.close", "code": 4004})
2004	            return
2005	
2006	        if scope["type"] == "lifespan":
2007	            # Handle lifespan events
2008	            while True:
2009	                message = await receive()
2010	                if message["type"] == "lifespan.startup":
2011	                    await db.init_db()
2012	                    print(f"Coach Claude MCP server running on http://{host}:{port}")
2013	                    print(f"SSE endpoint: http://{host}:{port}/sse")
2014	                    print(f"Dashboard: http://{host}:{port}/")
2015	                    print(f"Installation: http://{host}:{port}/installation")
2016	                    print(f"Database: {get_db_path()}")
2017	                    await send({"type": "lifespan.startup.complete"})
2018	                elif message["type"] == "lifespan.shutdown":
2019	                    await send({"type": "lifespan.shutdown.complete"})
2020	                    return
2021	        elif scope["type"] == "http":
2022	            path = scope["path"]
2023	            method = scope["method"]
2024	
2025	            if path == "/" and method == "GET":
2026	                # Stats page
2027	                html = await render_stats_page()
2028	                await send(
2029	                    {
2030	                        "type": "http.response.start",
2031	                        "status": 200,
2032	                        "headers": [[b"content-type", b"text/html; charset=utf-8"]],
2033	                    }
2034	                )
2035	                await send(
2036	                    {
2037	                        "type": "http.response.body",
2038	                        "body": html,
2039	                    }
2040	                )
2041	            elif path == "/installation" and method == "GET":
2042	                # Installation page
2043	                html = await render_installation_page(port)
2044	                await send(
2045	                    {
