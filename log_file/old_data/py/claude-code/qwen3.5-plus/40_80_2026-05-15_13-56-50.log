1900	_u_apis_cache = None
1901	_u_apis_regex_cache = None
1902	
1903	
1904	def _load_sensitive_apis():
1905	    global _u_apis_cache, _u_apis_regex_cache
1906	    if _u_apis_cache is not None:
1907	        return _u_apis_cache, _u_apis_regex_cache
1908	
1909	    script_dir = os.path.dirname(os.path.abspath(__file__))
1910	    rules_dir = os.path.join(script_dir, "rules")
1911	    config_path = os.path.join(rules_dir, "sensitive_strings.txt")
1912	
1913	    u_apis = []
1914	    if os.path.exists(config_path):
1915	        try:
1916	            with open(config_path, "rb") as f:
1917	                for line_b in f:
1918	                    line_b = line_b.strip()
1919	                    if line_b and not line_b.startswith(b"#"):
1920	                        try:
1921	                            line_str = line_b.decode("utf-8")
1922	                        except Exception:
1923	                            line_str = line_b.decode("utf-8", "ignore")
1924	                        u_apis.append(line_str)
1925	        except Exception as e:
1926	            print(u"[MCP] Error reading sensitive APIs: {0}".format(e))
1927	
1928	    _u_apis_cache = u_apis
1929	    if u_apis:
1930	        pattern = "|".join(re.escape(r) for r in u_apis)
1931	        _u_apis_regex_cache = re.compile("(" + pattern + ")")
1932	    else:
1933	        _u_apis_regex_cache = None
1934	
1935	    return _u_apis_cache, _u_apis_regex_cache
