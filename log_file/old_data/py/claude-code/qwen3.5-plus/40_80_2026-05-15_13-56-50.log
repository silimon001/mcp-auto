387	# implement a FIFO queue to store the artifacts
388	artifactQueue = list()
389	
390	
391	def addArtifactToQueue(artifact):
392	    """Add an artifact to the queue"""
393	    artifactQueue.append(artifact)
394	
395	
396	def getArtifactFromQueue():
397	    """Get an artifact from the queue"""
398	    if len(artifactQueue) > 0:
399	        return artifactQueue.pop(0)
400	    return None
401	
402	
403	def clearArtifactQueue():
404	    """Clear the artifact queue"""
405	    global artifactQueue
406	    artifactQueue = list()
407	
408	
409	MAX_OPENED_ARTIFACTS = 1
410	
411	# 全局缓存管理 (LRU 思想)
412	# 限制缓存条目数量以保护内存
413	MAX_CACHE_ENTRIES = 10
414	apk_cached_data = {}
415	apk_cache_order = []
416	_cache_lock = threading.Lock()
417	
418	
419	def _add_to_cache(key, value):
420	    """添加数据到缓存并维护顺序，超过限制时弹出最早的数据（线程安全）"""
421	    with _cache_lock:
422	        if key in apk_cached_data:
423	            apk_cache_order.remove(key)
424	        elif len(apk_cached_data) >= MAX_CACHE_ENTRIES:
425	            oldest = apk_cache_order.pop(0)
426	            print(u"[MCP] Cache eviction: popping %s" % oldest)
427	            del apk_cached_data[oldest]
428	
429	        apk_cached_data[key] = value
430	        apk_cache_order.append(key)
431	
432	
433	def _get_from_cache(key):
434	    """从缓存获取数据并将 key 移至最新（线程安全）"""
435	    with _cache_lock:
436	        if key in apk_cached_data:
437	            apk_cache_order.remove(key)
438	            apk_cache_order.append(key)
439	            return apk_cached_data[key]
440	        return None
441	
442	
443	def clear_apk_cache():
444	    """清理所有缓存（线程安全）"""
445	    with _cache_lock:
446	        apk_cached_data.clear()
447	        del apk_cache_order[:]
448	
