1195	def _extract_text_content(unit):
1196	    """
1197	    Unified method to extract text representation from any JEB Unit.
1198	    Handles formatter -> presentation -> document -> text flow.
1199	    """
1200	
1201	    if not unit:
1202	        return None
1203	
1204	    try:
1205	        formatter = unit.getFormatter()
1206	        if formatter:
1207	            presentation = formatter.getPresentation(0)
1208	            if presentation:
1209	                doc = presentation.getDocument()
1210	                if doc:
1211	                    return TextDocumentUtil.getText(doc)
1212	    except Exception:
1213	        try:
1214	            print("[MCP] Error extracting text: " + str(sys.exc_info()[1]))
1215	        except Exception:
1216	            pass
1217	
1218	    # Fallback: try to read raw bytes (up to 1MB)
1219	    stream = None
1220	    try:
1221	        if hasattr(unit, "getInput"):
1222	            inp = unit.getInput()
1223	            if inp:
1224	                stream = inp.getStream()
1225	                if stream:
1226	                    # JEB Input Streams are usually limited length, read it
1227	                    # Jython stream reading might need a byte array
1228	                    length = (
1229	                        stream.available()
1230	                        if hasattr(stream, "available")
1231	                        else 1024 * 1024
1232	                    )
1233	                    if length > 0:
1234	                        length = min(length, 1024 * 1024)
1235	                        buf = zeros(length, "b")
1236	                        read_len = stream.read(buf, 0, length)
1237	                        if read_len > 0:
1238	                            # Convert to Python string
1239	                            raw_str = buf[:read_len].tostring()
1240	                            return raw_str
1241	    except Exception:
1242	        try:
1243	            print("[MCP] Fallback raw read failed: " + str(sys.exc_info()[1]))
1244	        except Exception:
1245	            pass
1246	    finally:
1247	        if stream:
1248	            try:
1249	                stream.close()
1250	            except Exception:
1251	                pass
1252	
1253	    return None
1254	
