11	class AzureSettings:
12	    """
13	    Manages authentication with Azure GraphController API
14	    Assumes .env storing client_id, tenant_id, and scopes in environment variables
15	    Stores authentication record in auth_cache directory (creates directory if needed)
16	    Claude Desktop can't trigger interactive authentication challenges (e.g. in browser)
17	    Azure's DeviceCodeCredential allows authentication challenge (url, code) via text that Claude can serve to user
18	    """
19	    def __init__(self):
20	        # Load configuration from environment variables
21	        self.client_id = os.getenv("AZURE_CLIENT_ID")
22	        self.tenant_id = os.getenv("AZURE_TENANT_ID")
23	        self.client_secret = os.getenv("AZURE_CLIENT_SECRET")
24	        self.scopes = self._get_scopes()
25	
26	        # Create .env file with these values if it doesn't exist
27	        if not self.client_id or not self.tenant_id or not self.scopes:
28	            raise ValueError("Missing one of AZURE_CLIENT_ID, AZURE_TENANT_ID, or AZURE_GRAPH_SCOPES in .env")
29	
30	        self.cache_options = TokenCachePersistenceOptions(
31	            name="OutlookMCP",
32	            allow_unencrypted_storage=False  # Use secure storage
33	        )
34	
35	        # Set up paths
36	        self.auth_cache_dir = Path(__file__).parent / "auth_cache"
37	        self.auth_record_path = self.auth_cache_dir / "auth_record.json"
38	
39	        # Authentication state
40	        self.credential = None
41	        self.user_client = None
42	        logging.info("AzureSettings initialized")
43	        # Configure cache options
44	
45	    def _get_scopes(self):
46	        """Ensures scopes from environment variable are valid and split into a list of strings"""
47	        raw_scopes = os.getenv("AZURE_GRAPH_SCOPES", "")
48	        if not raw_scopes:
49	            return None
50	        scopes = raw_scopes.strip().split()
51	        return scopes
52	
53	    def get_client_from_silent_auth(self):
54	        """Fetch existing credential, return None if not found
55	        """
56	        # If no auth_record returns none so auth wrapper can trigger interactive auth
57	        logging.info("Checking for existing authentication record")
58	        if not os.path.exists(self.auth_record_path):
59	            logging.info("No authentication record found")
60	            return None
61	
62	        try:
63	            # If auth record exists, attempts to load it
64	            with open(self.auth_record_path, "r") as file:
65	                auth_record_json = file.read()
66	                auth_record = AuthenticationRecord.deserialize(auth_record_json)
67	
68	
69	            # Create credential with the authentication record (silent auth)
70	            self.credential = DeviceCodeCredential(
71	                client_id=self.client_id,
72	                tenant_id=self.tenant_id,
73	                cache_persistence_options=self.cache_options,
74	                authentication_record=auth_record
75	            )
76	
77	
78	            self.user_client = GraphServiceClient(
79	                credentials=self.credential,
80	                scopes=self.scopes
81	            )
82	            logging.info("Loaded existing authentication record")
83	            return self.user_client
84	        except Exception as e:
85	            logging.error(f"Error loading existing authentication record: {str(e)}")
86	            return None
87	
88	    def get_auth_instructions(self):
89	        """Return authentication instructions from Azure, to bot, for the user to auth in browser"""
90	        logging.info("Starting interactive authentication")
91	        auth_info = {"url": None, "code": None}
92	
93	        # Takes the auth_info dict from the outer scope so, when called by authenticate, we can access the dict values
94	        def prompt_callback(url, code, expiration=None, *args, **kwargs):
95	            auth_info["url"] = url
96	            auth_info["code"] = code
97	            logging.info(f"Got device code: URL={url}, code={code}, expires={expiration}")
98	            return None
99	
100	        # Create the credential
101	        self.credential = DeviceCodeCredential(
102	            client_id=self.client_id,
103	            tenant_id=self.tenant_id,
104	            cache_persistence_options=self.cache_options,
105	            prompt_callback=prompt_callback
106	        )
107	
108	        # Just trigger the callback - don't wait for auth to complete
109	        import threading
110	
111	        # The callback will execute immediately in the thread, giving us access to auth flow strings
112	        # Main thread: returns auth instructions to bot
113	        # Auth thread: waits for user to complete auth in browser, saves auth record, creates client
114	        # If success, user can retry their request without having to reauthenticate
115	        def auth_thread():
116	            try:
117	                # This will call prompt_callback immediately and then block waiting for auth
118	                auth_record = self.credential.authenticate(scopes=self.scopes)
119	
120	                # If we get here, user completed auth - save the record
121	                with open(self.auth_record_path, "w") as file:
122	                    file.write(auth_record.serialize())
123	                logging.info(f"Authentication succeeded, record saved to {self.auth_record_path}")
124	
125	                # Create the client
126	                self.user_client = GraphServiceClient(
127	                    credentials=self.credential,
128	                    scopes=self.scopes
129	                )
130	            except Exception as e:
131	                logging.info(f"Auth thread: {str(e)}")
132	
133	        # Start in background thread
134	        t = threading.Thread(target=auth_thread)
135	        t.daemon = True
136	        t.start()
137	
138	        # Wait briefly for callback
139	        import time
140	        time.sleep(2)
141	
142	        # Return auth instructions
143	        if auth_info["url"] and auth_info["code"]:
144	            return f"""
145	    Please authenticate this application in browser.
146	
147	    1. Visit this URL: {auth_info['url']}
148	    2. Enter the code: {auth_info['code']}
149	
150	    After authenticating, please retry your request.
151	    """
152	        else:
153	            return "Failed to get authentication code. Please try again."
154	
155	    def get_user_client(self) -> Optional[GraphServiceClient]:
156	        """Get an authenticated GraphServiceClient if available"""
157	        logging.info("Getting authenticated GraphServiceClient")
158	        if self.user_client is not None:
159	            logging.info("GraphServiceClient already set")
160	            return self.user_client
161	
162	        if self.get_client_from_silent_auth():
163	            logging.info("Loading existing authenticated GraphServiceClient")
164	            return self.user_client
165	
166	        # Returns None if no authenticated client is available
167	        # Auth wrapper will use this to trigger interactive auth if needed
168	        logging.info("No graph_client; returning None")
169	        return None

