160	@mcp.tool()
161	async def obsidian_read_note(path: str, include_metadata: bool = False) -> str:
162	    """Get content of a note from your Obsidian vault.
163	    
164	    Retrieves the content of a specific note from the currently open Obsidian vault.
165	    
166	    Args:
167	        path: Path to the note relative to vault root (e.g., "Folder/Note.md" or "Note.md")
168	            - Must include the .md extension
169	            - Case-sensitive
170	            - Use forward slashes (/) for folder separators
171	        include_metadata: Whether to include YAML frontmatter metadata (default: False)
172	    
173	    Returns:
174	        The content of the note as text
175	    
176	    Examples:
177	        - obsidian_read_note(path="Meeting Notes.md")
178	        - obsidian_read_note(path="Projects/Website/Ideas.md")
179	        - obsidian_read_note(path="Daily Notes/2025-05-17.md", include_metadata=True)
180	    """
181	    global client
182	    
183	    # Initialize client if needed
184	    if not client:
185	        await initialize_client()
186	    
187	    try:
188	        return await client.get_note_content(path, include_metadata)
189	    except ObsidianNotFoundError:
190	        raise ValueError(f"Note not found: {path}")
191	    except ObsidianError as e:
192	        raise RuntimeError(f"Failed to read note: {str(e)}")
