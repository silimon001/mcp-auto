141	      "command": "python3",
142	      "args": ["$CURRENT_DIR/mcp_server.py"],
143	      "env": {
144	        "PYTHONPATH": "$CURRENT_DIR"
145	      }
146	    }
147	  }
148	}
149	EOF
150	        fi
151	    else
152	        # 生成新的配置文件
153	        cat > "$CONFIG_FILE" << EOF
154	{
155	  "mcpServers": {
156	    "draw-architecture": {
157	      "command": "python3",
158	      "args": ["$CURRENT_DIR/mcp_server.py"],
159	      "env": {
160	        "PYTHONPATH": "$CURRENT_DIR"
161	      }
162	    }
163	  }
164	}
165	EOF
166	    fi
167	    
168	    print_success "Trae IDE 配置已更新"
169	    print_info "配置文件位置: $CONFIG_FILE"
170	    print_info "请重启 Trae IDE 以加载新配置"
171	}
172	
173	# 显示使用说明
