97	    else
98	        print_warning "未找到测试脚本，跳过测试"
99	    fi
100	}
101	
102	# 配置 Trae IDE
103	configure_trae() {
104	    print_info "配置 Trae IDE..."
105	    
106	    if [[ "$OS" == "macos" ]]; then
107	        CONFIG_DIR="$HOME/Library/Application Support/Trae"
108	        CONFIG_FILE="$CONFIG_DIR/mcp_config.json"
109	    else
110	        CONFIG_DIR="$HOME/.config/trae"
111	        CONFIG_FILE="$CONFIG_DIR/mcp_config.json"
112	    fi
113	    
114	    # 创建配置目录
115	    mkdir -p "$CONFIG_DIR"
116	    
117	    # 获取当前目录的绝对路径
118	    CURRENT_DIR=$(pwd)
119	    
120	    # 检查是否已有配置文件
121	    if [ -f "$CONFIG_FILE" ]; then
122	        print_info "检测到现有配置文件，将备份并更新..."
123	        cp "$CONFIG_FILE" "$CONFIG_FILE.backup.$(date +%Y%m%d_%H%M%S)"
124	        
125	        # 读取现有配置并合并
126	        if command -v jq &> /dev/null; then
