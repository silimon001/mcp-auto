54	        if python3 -c "import sys; exit(0 if sys.version_info >= (3, 8) else 1)"; then
55	            print_success "Python 版本满足要求 (>= 3.8)"
56	        else
57	            print_error "Python 版本过低，需要 3.8 或更高版本"
58	            exit 1
