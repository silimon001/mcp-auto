28	@dataclass
29	class MoveResult:
30	    """Result of a robot movement operation."""
31	    ok: bool
32	    msg: str
33	    warnings: List[str] = field(default_factory=list)
34	    robot_state: Dict[str, Any] = field(default_factory=dict)
