60	    else
61	        print_error "未找到 Python3，请先安装 Python 3.8+"
62	        exit 1
63	    fi
64	    
65	    # 检查 pip
66	    if command -v pip3 &> /dev/null; then
67	        print_success "pip3 已安装"
68	    else
69	        print_error "未找到 pip3，请先安装 pip"
70	        exit 1
