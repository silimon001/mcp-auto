129	               --arg cmd "python3" \
130	               --arg script "$CURRENT_DIR/mcp_server.py" \
131	               --arg pythonpath "$CURRENT_DIR" \
132	               '.mcpServers[$name] = {"command": $cmd, "args": [$script], "env": {"PYTHONPATH": $pythonpath}}' \
133	               "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
134	        else
135	            # 手动合并（简单方式）
136	            print_warning "未安装 jq，将生成新的配置文件"
137	            cat > "$CONFIG_FILE" << EOF
