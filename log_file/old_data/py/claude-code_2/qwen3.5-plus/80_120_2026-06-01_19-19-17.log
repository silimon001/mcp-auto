496	def run_server():
497	    """Run the MCP server."""
498	    # Print banner
499	    print("\n" + "=" * 60)
500	    print(f"  Obsidian MCP Server v{__version__}")
501	    print(f"  MCP SDK Version: {mcp_version}")
502	    print(f"  Python: {platform.python_version()} on {platform.system()}")
503	    print("=" * 60)
504	    
505	    # Log startup information
506	    logger.info(f"Starting Obsidian MCP Server v{__version__}")
507	    logger.info(f"System: {platform.system()} {platform.release()} ({os.name})")
508	    logger.info(f"Python: {platform.python_version()}")
509	    logger.info(f"MCP SDK: {mcp_version}")
510	    
511	    # Log available tools
512	    tool_count = len([attr for attr in dir(sys.modules[__name__]) if attr.startswith('obsidian_')])
513	    logger.info(f"Registered {tool_count} Obsidian tools")
514	    
515	    # Log transport information
516	    logger.info("Using stdio transport for communication")
517	    logger.info("Starting server...")
518	    
519	    try:
520	        # Run the server
521	        print("\nServer is running. Press Ctrl+C to stop.\n")
522	        mcp.run(transport="stdio")
523	        logger.info("Server started successfully")
524	    except KeyboardInterrupt:
525	        print("\nServer stopped by user")
526	        logger.info("Server stopped by user")
527	    except Exception as e:
528	        logger.error(f"Unhandled exception: {str(e)}", exc_info=True)
529	        sys.exit(1)
530	    finally:
531	        logger.info("Server shutdown complete")
