20	from mcp.server.stdio import stdio_server
21	from mcp.types import (
22	    CallToolRequest,
23	    CallToolResult,
24	    TextContent,
25	    Tool,
26	)
27	from mcp.server.models import ServerCapabilities
28	from mcp.server.lowlevel.server import NotificationOptions
29	from zhipuai import ZhipuAI
30	
31	# 加载环境变量
32	try:
33	    from dotenv import load_dotenv
34	    load_dotenv()
35	except ImportError:
36	    # 如果没有安装python-dotenv，手动读取.env文件
37	    env_file = Path(__file__).parent / ".env"
38	    if env_file.exists():
39	        with open(env_file, 'r', encoding='utf-8') as f:
40	            for line in f:
41	                line = line.strip()
42	                if line and not line.startswith('#') and '=' in line:
43	                    key, value = line.split('=', 1)
44	                    os.environ[key.strip()] = value.strip()
45	
46	# 配置日志
47	import os
48	log_file_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'mcp_server.log')
49	logging.basicConfig(
50	    level=logging.INFO,
51	    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
52	    handlers=[
53	        logging.StreamHandler(),  # 输出到控制台
54	        logging.FileHandler(log_file_path, encoding='utf-8')  # 输出到文件
55	    ],
56	    force=True  # 强制重新配置
57	)
58	logger = logging.getLogger(__name__)
59	
60	# 确保日志立即写入文件
61	for handler in logging.getLogger().handlers:
62	    if isinstance(handler, logging.FileHandler):
63	        handler.flush()
64	
65	# 创建服务器实例
66	server = Server("draw-architecture")
67	
68	# 提示词模板路径
69	PROMPT_FILE = Path(__file__).parent / "draw_architecture_prompt.md"
70	
71	# 智谱AI客户端初始化
72	def get_zhipu_client():
73	    """获取智谱AI客户端"""
74	    api_key = os.getenv('ZHIPUAI_API_KEY')
75	    if not api_key:
76	        logger.error("未找到ZHIPUAI_API_KEY环境变量，请在.env文件中配置")
77	        raise ValueError("ZHIPUAI_API_KEY未配置")
78	    
79	    logger.info(f"使用智谱AI API Key: {api_key[:8]}...")
80	    return ZhipuAI(api_key=api_key)
81	
82	
83	def load_prompt_template() -> str:
84	    """加载提示词模板"""
85	    try:
86	        with open(PROMPT_FILE, 'r', encoding='utf-8') as f:
87	            return f.read()
88	    except FileNotFoundError:
89	        logger.error(f"提示词文件未找到: {PROMPT_FILE}")
90	        return ""
91	    except Exception as e:
92	        logger.error(f"读取提示词文件失败: {e}")
93	        return ""
94	
95	
96	def generate_xml_with_llm(description: str, diagram_name: str, prompt_template: str) -> str:
97	    """使用智谱AI生成draw.io XML内容"""
98	    try:
99	        logger.info("开始使用智谱AI生成架构图XML")
100	        client = get_zhipu_client()
101	        
102	        # 构建完整的提示词
103	        full_prompt = f"""{prompt_template}
104	
105	## 用户需求
106	用户想要绘制的系统架构描述：
107	{description}
108	
109	图表名称：{diagram_name}
110	
111	## 任务要求
112	请根据上述架构描述和提示词模板，生成完整的draw.io XML代码。
113	要求：
114	1. 严格遵循XML格式规范
115	2. 确保所有ID唯一且非空
116	3. 包含完整的图形元素和样式
117	4. 使用合适的颜色和布局
118	5. 只输出XML代码，不要包含任何其他文字说明
119	"""
120	        
121	        logger.info(f"发送请求到智谱AI，提示词长度: {len(full_prompt)}")
122	        
123	        # 调用智谱AI
124	        response = client.chat.completions.create(
125	            model="glm-4-flash",  # 使用免费模型
126	            messages=[
127	                {
128	                    "role": "user",
129	                    "content": full_prompt
130	                }
131	            ],
132	            temperature=0.7,
133	            max_tokens=4000
134	        )
135	        
136	        logger.info("智谱AI响应成功，开始处理返回内容")
137	        xml_content = response.choices[0].message.content.strip()
138	        logger.info(f"原始响应长度: {len(xml_content)}")
139	        
140	        # 清理可能的markdown代码块标记
141	        if xml_content.startswith('```xml'):
142	            xml_content = xml_content[6:]
143	            logger.info("移除了```xml标记")
144	        if xml_content.startswith('```'):
145	            xml_content = xml_content[3:]
146	            logger.info("移除了```标记")
147	        if xml_content.endswith('```'):
148	            xml_content = xml_content[:-3]
149	            logger.info("移除了结尾```标记")
150	        
151	        final_content = xml_content.strip()
152	        logger.info(f"最终XML内容长度: {len(final_content)}")
153	        
154	        # 验证XML内容是否包含实际的组件
155	        if '<mxCell id=' not in final_content or final_content.count('<mxCell') < 5:
156	            logger.warning("智谱AI生成的XML内容过于简单，使用回退方案")
157	            return generate_drawio_xml(description, diagram_name)
158	            
159	        return final_content
160	        
161	    except Exception as e:
162	        logger.error(f"调用智谱AI失败: {e}")
163	        logger.info("使用回退方案生成架构图")
164	        # 如果LLM调用失败，回退到原来的方法
165	        return generate_drawio_xml(description, diagram_name)
166	
