40	    async def send_to_freecad(tool_name: str, args: dict) -> str:
41	        """Send command to FreeCAD via socket (cross-platform)"""
42	        try:
43	            # Create socket connection based on platform
44	            if platform.system() == "Windows":
45	                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
46	                sock.connect(('localhost', 23456))
47	            else:
48	                if not os.path.exists(socket_path):
49	                    return json.dumps({"error": "FreeCAD socket not available. Please start FreeCAD and switch to AI Copilot workbench"})
50	                sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
51	                sock.connect(socket_path)
52	            
53	            # Send command
54	            command = json.dumps({"tool": tool_name, "args": args})
55	            sock.send(command.encode('utf-8'))
56	            
57	            # Receive response
58	            response = sock.recv(8192).decode('utf-8')
59	            sock.close()
60	            
61	            # Check if this is a selection workflow response
62	            try:
63	                result = json.loads(response)
64	                if isinstance(result, dict) and result.get("status") == "awaiting_selection":
65	                    # Handle interactive selection workflow
66	                    return await handle_selection_workflow(tool_name, args, result)
67	            except json.JSONDecodeError:
68	                pass  # Not JSON, return as-is
69	            
70	            return response
71	            
72	        except Exception as e:
73	            return json.dumps({"error": f"Socket communication error: {e}"})
