254	def generate_component_xml(comp_id: str, name: str, x: int, y: int, width: int, height: int, color: str) -> str:
255	    """生成单个组件的XML"""
256	    return f'''        <mxCell id="{comp_id}" value="{name}" style="rounded=1;whiteSpace=wrap;html=1;fillColor={color};strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
257	          <mxGeometry x="{x}" y="{y}" width="{width}" height="{height}" as="geometry" />
258	        </mxCell>'''
259	
260	
261	def generate_connection_xml(edge_id: str, source_id: str, target_id: str) -> str:
262	    """生成连接线的XML"""
263	    return f'''        <mxCell id="{edge_id}" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="{source_id}" target="{target_id}">
264	          <mxGeometry relative="1" as="geometry" />
265	        </mxCell>'''
266	
267	
268	def generate_drawio_xml(architecture_description: str, diagram_name: str = "系统架构图") -> str:
269	    """根据架构描述和提示词模板生成draw.io XML格式的架构图"""
270	    
271	    logger.info("使用回退方案生成架构图XML")
272	    
273	    # 解析架构描述
274	    components = parse_architecture_description(architecture_description)
275	    logger.info(f"解析到的组件: {components}")
276	    
277	    # 生成时间戳和ID
278	    timestamp = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime())
279	    diagram_id = str(uuid.uuid4())
280	    
281	    # 定义颜色方案（根据提示词模板）
282	    colors = {
283	        'frontend': '#e1d5e7',    # 紫色系 - 用户界面
284	        'gateway': '#d5e8d4',     # 绿色系 - 基础设施
285	        'services': '#dae8fc',    # 蓝色系 - 核心业务服务
286	        'cache': '#fff2cc',       # 橙色系 - 缓存
287	        'queue': '#fff2cc',       # 橙色系 - 队列
288	        'database': '#f8cecc',    # 灰色系 - 数据库
289	        'storage': '#f8cecc',     # 灰色系 - 存储
290	        'monitoring': '#d5e8d4',  # 绿色系 - 监控
291	        'external': '#ffe6cc'     # 黄色系 - 外部服务
292	    }
293	    
294	    # 生成XML内容
295	    xml_content = []
296	    
297	    # 添加标题
298	    xml_content.append(f'''        <mxCell id="title" value="{diagram_name}" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
299	          <mxGeometry x="500" y="30" width="200" height="40" as="geometry" />
300	        </mxCell>''')
301	    
302	    # 当前Y位置
303	    current_y = 100
304	    layer_height = 120
305	    component_width = 150
306	    component_height = 60
307	    
308	    # 生成各层组件
309	    layers = [
310	        ('frontend', '前端层', components['frontend']),
311	        ('gateway', '接入层', components['gateway']),
312	        ('services', '业务服务层', components['services']),
313	        ('cache', '缓存层', components['cache']),
314	        ('queue', '消息队列层', components['queue']),
315	        ('database', '数据存储层', components['database'] + components['storage']),
316	        ('monitoring', '监控运维层', components['monitoring'])
317	    ]
318	    
319	    prev_layer_components = []
320	    
321	    for layer_type, layer_name, layer_components in layers:
322	        if not layer_components:
323	            continue
324	            
325	        # 添加层标题
326	        layer_title_id = f"layer-{layer_type}-title"
327	        xml_content.append(f'''        <mxCell id="{layer_title_id}" value="{layer_name}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
328	          <mxGeometry x="50" y="{current_y}" width="100" height="30" as="geometry" />
329	        </mxCell>''')
330	        
331	        # 计算组件位置
332	        num_components = len(layer_components)
333	        total_width = num_components * component_width + (num_components - 1) * 50
334	        start_x = (1200 - total_width) // 2
335	        
336	        current_layer_components = []
337	        
338	        # 生成组件
339	        for i, component in enumerate(layer_components):
340	            comp_id = f"comp-{layer_type}-{i}"
341	            comp_x = start_x + i * (component_width + 50)
342	            comp_y = current_y + 40
343	            
344	            # 清理组件名称
345	            clean_name = re.sub(r'^[\s\-•]+', '', component).strip()
346	            if '：' in clean_name:
347	                clean_name = clean_name.split('：')[0]
348	            
349	            xml_content.append(generate_component_xml(
350	                comp_id, clean_name, comp_x, comp_y, 
351	                component_width, component_height, colors[layer_type]
352	            ))
353	            
354	            current_layer_components.append(comp_id)
355	        
356	        # 生成连接线（连接到上一层）
357	        if prev_layer_components and current_layer_components:
358	            for i, source_id in enumerate(prev_layer_components):
359	                for j, target_id in enumerate(current_layer_components):
360	                    if abs(i - j) <= 1:  # 只连接相邻的组件
361	                        edge_id = f"edge-{source_id}-to-{target_id}"
362	                        xml_content.append(generate_connection_xml(edge_id, source_id, target_id))
363	        
364	        prev_layer_components = current_layer_components
365	        current_y += layer_height
366	    
367	    # 组装完整的XML
368	    xml_template = f'''<?xml version="1.0" encoding="UTF-8"?>
369	<mxfile host="app.diagrams.net" modified="{timestamp}" agent="MCP Draw Architecture Server" version="24.7.17">
370	  <diagram name="{diagram_name}" id="{diagram_id}">
371	    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
372	      <root>
373	        <mxCell id="0" />
374	        <mxCell id="1" parent="0" />
375	        
376	{chr(10).join(xml_content)}
377	        
378	      </root>
379	    </mxGraphModel>
380	  </diagram>
381	</mxfile>'''
382	    
383	    return xml_template
384	
