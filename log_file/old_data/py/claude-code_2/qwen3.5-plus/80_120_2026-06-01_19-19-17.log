342	@mcp.tool()
343	async def obsidian_list_files(folder: str = "") -> List[Dict[str, Any]]:
344	    """List files and folders in your Obsidian vault.
345	    
346	    Lists all files and folders at the specified path in the currently open Obsidian vault.
347	    
348	    Args:
349	        folder: Folder path relative to vault root (default: "" for root folder)
350	            - Use empty string ("") to list files/folders at the vault root
351	            - For subfolders, include trailing slash (e.g., "Projects/" or "Projects/Website/")
352	            - Case-sensitive
353	            - Use forward slashes (/) for folder separators
354	    
355	    Returns:
356	        List of files and folders with metadata (type, path, name, etc.)
357	    
358	    Examples:
359	        - obsidian_list_files() - Lists all files/folders at vault root
360	        - obsidian_list_files(folder="") - Same as above, lists vault root
361	        - obsidian_list_files(folder="Projects/") - Lists contents of Projects folder
362	        - obsidian_list_files(folder="Daily Notes/") - Lists contents of Daily Notes folder
363	    
364	    Note:
365	        The trailing slash (/) is important for folder paths. "Projects/" is recognized as a folder,
366	        while "Projects" might be treated as a file.
367	    """
368	    global client
369	    
370	    # Initialize client if needed
371	    if not client:
372	        await initialize_client()
373	    
374	    # Ensure folder path ends with a slash if not empty
375	    if folder and not folder.endswith("/"):
376	        folder = folder + "/"
377	    
378	    try:
379	        return await client.list_files(folder)
380	    except ObsidianNotFoundError:
381	        raise ValueError(f"Folder not found: {folder}")
382	    except ObsidianError as e:
383	        raise RuntimeError(f"Failed to list files: {str(e)}")
