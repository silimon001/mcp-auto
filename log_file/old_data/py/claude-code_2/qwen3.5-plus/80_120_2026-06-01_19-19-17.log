36	    def to_json(self) -> Dict[str, Any]:
37	        """Convert to JSON format for API responses."""
38	        json_output: Dict[str, Any] = {
39	            "robot_state": self.robot_state or {"error": "Robot state not available."}
40	        }
41	        if not self.ok:
42	            json_output["status"] = "error"
43	        if self.msg:
44	            json_output["message"] = self.msg
45	        if self.warnings:
46	            json_output["warnings"] = self.warnings
47	
48	        logger.info(f"MoveResult JSON: {json.dumps(json_output)}")
49	        return json_output
