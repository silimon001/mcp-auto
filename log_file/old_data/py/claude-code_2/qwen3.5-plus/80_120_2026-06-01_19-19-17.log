185	    echo "   - Cline: 使用生成的 cline_config.json"
186	    echo "   - Trae IDE: 自动配置到用户配置目录"
187	    echo
188	    echo "4. 查看更多示例:"
189	    echo "   - 阅读 README.md"
190	    echo "   - 查看 examples/ 目录"
191	    echo
192	    echo "5. 如果遇到问题:"
193	    echo "   - 运行测试: python3 test_mcp_server.py"
194	    echo "   - 查看日志文件"
195	    echo "   - 检查配置文件"
196	    echo "   - 确保客户端已重启"
197	    echo
198	}
199	
200	# 主函数
201	main() {
202	    echo "=================================================="
203	    echo "  Draw.io Architecture MCP Server 安装程序"
204	    echo "=================================================="
205	    echo
206	    
207	    # 检查是否在正确的目录
208	    if [ ! -f "mcp_server.py" ]; then
209	        print_error "请在包含 mcp_server.py 的目录中运行此脚本"
210	        exit 1
211	    fi
212	    
213	    # 执行安装步骤
214	    check_system
215	    echo
216	    
217	    install_dependencies
218	    echo
219	    
220	    test_installation
221	    echo
222	    
223	    # 询问是否配置客户端
224	    read -p "是否配置 Trae IDE? (y/n): " -n 1 -r
225	    echo
