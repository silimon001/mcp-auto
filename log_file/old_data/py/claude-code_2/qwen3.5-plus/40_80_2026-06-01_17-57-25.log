18	def execute_masscan_streaming(target: str, ports: str, rate: int = 100, timeout: int = 300,
19	                             progress_callback=None) -> tuple[bool, str, Path]:
20	    """Execute masscan with streaming output processing and return success status, stderr output, and output file path."""
21	    try:
22	        # Create temporary output file
23	        with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
24	            output_file = Path(f.name)
25	
26	        # Build masscan command with banner grabbing
27	        cmd = [
28	            "sudo", "masscan",
29	            target,
30	            "-p", ports,
31	            "--rate", str(rate),
32	            "--banners",
33	            "-oJ", str(output_file)
34	        ]
35	
36	        # Execute scan with streaming output
37	        process = subprocess.Popen(
38	            cmd,
39	            stdout=subprocess.PIPE,
40	            stderr=subprocess.PIPE,
41	            text=True,
42	            bufsize=1,  # Line buffered
43	            universal_newlines=True
44	        )
45	
46	        stderr_output = ""
47	        hosts_found = 0
48	        ports_found = 0
49	
50	        try:
51	            # Monitor the output file for new results
52	            import time
53	            start_time = time.time()
54	            last_size = 0
55	
56	            while process.poll() is None:
57	                # Check for timeout
58	                if time.time() - start_time > timeout:
59	                    process.terminate()
60	                    process.wait(timeout=5)
61	                    return False, f"Scan timed out after {timeout} seconds", output_file
62	
63	                # Check if output file has grown
64	                if output_file.exists():
