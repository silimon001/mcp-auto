33	    from davinci_resolve_mcp.resolve_api import ResolveAPI
34	except ImportError as e:
35	    logger.warning("Absolute import failed for ResolveAPI: %s", e)
36	    try:
37	        # Fall back to relative import (when running from source)
38	        from .resolve_api import ResolveAPI
39	    except ImportError as e2:
40	        logger.exception("Relative import failed for ResolveAPI: %s", e2)
41	        raise
