742	                    exploit['updated_at'] = exploit['updated_at'].isoformat()
743	            exploits.append(exploit)
744	
745	        return {
746	            "success": True,
747	            "total_found": len(exploits),
748	            "exploits": exploits,
749	            "filters_applied": {
750	                "platform": platform or "none",
