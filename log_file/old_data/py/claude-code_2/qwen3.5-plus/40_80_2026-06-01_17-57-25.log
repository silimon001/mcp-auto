291	    async def read_email(self, email_id: str) -> dict[str, str]| str:
292	        """Retrieves email contents including to, from, subject, and contents."""
293	        try:
294	            msg = self.service.users().messages().get(userId="me", id=email_id, format='raw').execute()
295	            email_metadata = {}
296	
297	            # Decode the base64URL encoded raw content
298	            raw_data = msg['raw']
299	            decoded_data = urlsafe_b64decode(raw_data)
300	
301	            # Parse the RFC 2822 email
302	            mime_message = message_from_bytes(decoded_data)
303	
304	            # Extract the email body
305	            body = None
306	            if mime_message.is_multipart():
307	                for part in mime_message.walk():
308	                    # Extract the text/plain part
309	                    if part.get_content_type() == "text/plain":
310	                        body = part.get_payload(decode=True).decode()
311	                        break
312	            else:
313	                # For non-multipart messages
314	                body = mime_message.get_payload(decode=True).decode()
315	            email_metadata['content'] = body
316	            
317	            # Extract metadata
318	            email_metadata['subject'] = decode_mime_header(mime_message.get('subject', ''))
319	            email_metadata['from'] = mime_message.get('from','')
320	            email_metadata['to'] = mime_message.get('to','')
321	            email_metadata['date'] = mime_message.get('date','')
322	            
323	            logger.info(f"Email read: {email_id}")
324	            
325	            # We want to mark email as read once we read it
326	            await self.mark_email_as_read(email_id)
327	
328	            return email_metadata
329	        except HttpError as error:
330	            return f"An HttpError occurred: {str(error)}"
331	        
