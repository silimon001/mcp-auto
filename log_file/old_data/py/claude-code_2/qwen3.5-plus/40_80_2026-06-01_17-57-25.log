237	    async def send_email(self, recipient_id: str, subject: str, message: str,) -> dict:
238	        """Creates and sends an email message"""
239	        try:
240	            message_obj = EmailMessage()
241	            message_obj.set_content(message)
242	            
243	            message_obj['To'] = recipient_id
244	            message_obj['From'] = self.user_email
245	            message_obj['Subject'] = subject
246	
247	            encoded_message = base64.urlsafe_b64encode(message_obj.as_bytes()).decode()
