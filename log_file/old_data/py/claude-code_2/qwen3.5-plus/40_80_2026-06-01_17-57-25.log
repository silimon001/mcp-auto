140	def get_lack_params(arguments: dict) -> str | None:
141	    """Check if the parameters dictionary is missing a required field for the EmailMessage model.
142	
143	    Args:
144	        arguments (dict): The supplied parameter dictionary.
145	
146	    Returns:
147	        str | None: If a field is missing, returns an error message for the missing field; otherwise returns None.
148	    """
149	    # Get the field names of the EmailMessage model
150	    required_fields = EmailMessage.model_fields.keys()
151	
152	    # Find the missing fields
153	    missing_fields = [field for field in required_fields if field not in arguments]
154	
155	    # Logging
156	    logger.info(f"Missing params: {missing_fields}")
157	
158	    # If there is a missing field, returns an error message; otherwise returns None
159	    if missing_fields:
160	        return "\n".join(f"{field} is required" for field in missing_fields)
161	    return None
