689	
690	        # Execute query with sorting by rank and disclosure date
691	        rank_order = {
692	            "excellent": 1,
693	            "great": 2,
694	            "good": 3,
695	            "normal": 4,
696	            "average": 5,
697	            "low": 6,
698	            "manual": 7
699	        }
700	
701	        pipeline = [
702	            {"$match": query_filter},
703	            {"$addFields": {
704	                "rank_order": {
705	                    "$switch": {
706	                        "branches": [
707	                            {"case": {"$eq": ["$rank", "excellent"]}, "then": 1},
708	                            {"case": {"$eq": ["$rank", "great"]}, "then": 2},
709	                            {"case": {"$eq": ["$rank", "good"]}, "then": 3},
710	                            {"case": {"$eq": ["$rank", "normal"]}, "then": 4},
711	                            {"case": {"$eq": ["$rank", "average"]}, "then": 5},
712	                            {"case": {"$eq": ["$rank", "low"]}, "then": 6},
713	                            {"case": {"$eq": ["$rank", "manual"]}, "then": 7}
714	                        ],
715	                        "default": 8
716	                    }
717	                }
718	            }},
719	            {"$sort": {"rank_order": 1, "disclosure_date": -1}},
720	            {"$limit": limit},
721	            {"$project": {"rank_order": 0}}  # Remove the temporary field
722	        ]
723	
724	        results_cursor = db.exploits.aggregate(pipeline)
725	        exploits_raw = list(results_cursor)
726	
727	        # Convert ObjectIds and datetime objects to strings to avoid JSON serialization errors
728	        exploits = []
729	        for exploit in exploits_raw:
730	            # Convert ObjectId to string
731	            if '_id' in exploit:
732	                exploit['_id'] = str(exploit['_id'])
733	            # Convert datetime objects to ISO strings
734	            if 'disclosure_date' in exploit and exploit['disclosure_date']:
735	                if hasattr(exploit['disclosure_date'], 'isoformat'):
736	                    exploit['disclosure_date'] = exploit['disclosure_date'].isoformat()
737	            if 'created_at' in exploit and exploit['created_at']:
