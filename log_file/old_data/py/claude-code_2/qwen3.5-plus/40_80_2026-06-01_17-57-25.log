866	    async def batch_archive(self, query: str, max_emails: int = 100) -> dict:
867	        """
868	        Archives multiple emails matching a search query
869	        
870	        Args:
871	            query: Gmail search query to find emails to archive
872	            max_emails: Maximum number of emails to archive in one batch
873	            
874	        Returns:
875	            Dictionary with status and count of archived emails
876	        """
877	        try:
878	            # First, search for emails matching the query
879	            user_id = 'me'
880	            
881	            response = await asyncio.to_thread(
882	                self.service.users().messages().list(
883	                    userId=user_id,
884	                    q=query,
885	                    maxResults=max_emails
886	                ).execute
887	            )
888	            
889	            messages = []
890	            if 'messages' in response:
891	                messages.extend(response['messages'])
892	            
893	            if not messages:
894	                return {
895	                    'status': 'success',
896	                    'archived_count': 0,
897	                    'message': 'No emails found matching the query.'
898	                }
899	            
900	            # Archive each email in the batch
901	            archived_count = 0
902	            for msg in messages:
903	                try:
904	                    await asyncio.to_thread(
905	                        self.service.users().messages().modify(
906	                            userId="me", 
907	                            id=msg['id'], 
908	                            body={'removeLabelIds': ['INBOX']}
909	                        ).execute
910	                    )
911	                    archived_count += 1
912	                except Exception as e:
913	                    logger.error(f"Error archiving email {msg['id']}: {str(e)}")
914	            
915	            logger.info(f"Batch archived {archived_count} emails")
916	            return {
917	                'status': 'success',
918	                'archived_count': archived_count,
919	                'total_found': len(messages),
920	                'message': f"Successfully archived {archived_count} out of {len(messages)} emails."
921	            }
922	        except HttpError as error:
923	            return {
924	                'status': 'error',
925	                'error_message': str(error)
926	            }
927	    
