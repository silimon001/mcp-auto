9	import click
10	import uvicorn
11	from starlette.requests import Request
12	from starlette.responses import JSONResponse
13	from starlette.routing import Route
14	
15	from . import __version__
16	from .auth import BearerAuthMiddleware
17	from .config import load_settings
18	from .server import create_server
19	from .tools import discover_predefined_tools
20	
21	
22	async def _health(_request: Request) -> JSONResponse:
23	    """Liveness probe used by Docker HEALTHCHECK and any external monitor."""
24	    return JSONResponse({"status": "ok", "version": __version__})
25	
26	
27	def _configure_logging(level: str) -> None:
28	    logging.basicConfig(
29	        level=level.upper(),
30	        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
31	    )
32	
33	
34	@click.group(context_settings={"help_option_names": ["-h", "--help"]})
35	@click.version_option(__version__, prog_name="teslamate-mcp")
36	def main() -> None:
37	    """TeslaMate MCP server — query your Tesla data from any MCP-aware client."""
38	
39	
40	@main.command()
41	def stdio() -> None:
42	    """Run the MCP server over stdio (for local clients like Cursor or Claude Desktop)."""
43	    settings = load_settings()
44	    _configure_logging(settings.log_level)
45	    mcp = create_server(settings)
46	    mcp.run(transport="stdio")
47	
48	
49	@main.command()
50	@click.option("--host", default=None, help="HTTP bind host (overrides config).")
51	@click.option("--port", default=None, type=int, help="HTTP bind port (overrides config).")
52	@click.option(
53	    "--auth-token",
54	    default=None,
55	    envvar="AUTH_TOKEN",
56	    help="Bearer token; auth disabled if omitted.",
57	)
58	@click.option(
59	    "--json-response/--sse-response",
60	    default=False,
61	    help="Return JSON instead of streaming SSE.",
62	)
63	def http(host: str | None, port: int | None, auth_token: str | None, json_response: bool) -> None:
64	    """Run the MCP server over streamable HTTP (for remote deployments)."""
65	    settings = load_settings()
66	    if host is not None:
67	        settings.host = host
68	    if port is not None:
69	        settings.port = port
70	    if auth_token is not None:
71	        from pydantic import SecretStr
72	
73	        settings.auth_token = SecretStr(auth_token)
74	
75	    _configure_logging(settings.log_level)
76	    mcp = create_server(settings)
77	
78	    # FastMCP exposes a Starlette app for streamable-http; we wrap it for auth
79	    # and mount a small /health probe alongside it.
80	    app = mcp.streamable_http_app()
81	    app.router.routes.append(Route("/health", _health, methods=["GET"]))
82	    if json_response:
83	        # The FastMCP attribute lives on the session manager; set it before serving.
84	        mcp.settings.streamable_http_json_response = True  # type: ignore[attr-defined]
85	
86	    token = settings.auth_token.get_secret_value() if settings.auth_token else ""
87	    if token:
88	        app.add_middleware(BearerAuthMiddleware, auth_token=token)
89	        logging.getLogger(__name__).info("Bearer token authentication enabled")
90	    else:
91	        logging.getLogger(__name__).warning(
92	            "No AUTH_TOKEN set — the HTTP endpoint is unauthenticated"
93	        )
94	
95	    uvicorn.run(app, host=settings.host, port=settings.port, log_level=settings.log_level.lower())
96	
97	
98	@main.command("gen-token")
99	@click.option("--length", default=32, show_default=True, help="Token byte length.")
100	def gen_token(length: int) -> None:
101	    """Print a cryptographically random bearer token suitable for AUTH_TOKEN."""
102	    click.echo(f"AUTH_TOKEN={secrets.token_urlsafe(length)}")
103	
104	
105	@main.command("list-tools")
106	def list_tools_cmd() -> None:
107	    """Print the names of all registered tools without starting the server."""
108	    tools = discover_predefined_tools()
109	    for tool in tools:
110	        click.echo(f"{tool.name:<45} {tool.source}")
111	    click.echo(f"{'get_database_schema':<45} (built-in)")
112	    click.echo(f"{'run_sql':<45} (built-in)")
113	
