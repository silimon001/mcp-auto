89	
90	            # Wait for process to complete and get stderr
91	            _, stderr = process.communicate()
92	            stderr_output = stderr.strip()
93	
94	            # Process any remaining output
95	            if output_file.exists():
96	                final_results = _process_new_output(output_file, last_size)
97	                if final_results and progress_callback:
98	                    for result in final_results:
99	                        if 'ip' in result and 'ports' in result:
100	                            hosts_found += 1
101	                            ports_found += len(result.get('ports', []))
102	                            progress_callback({
103	                                'type': 'host_found',
104	                                'ip': result.get('ip'),
105	                                'ports': result.get('ports', []),
106	                                'total_hosts': hosts_found,
107	                                'total_ports': ports_found
108	                            })
109	
110	            # Final progress update
111	            if progress_callback:
112	                progress_callback({
113	                    'type': 'scan_complete',
114	                    'total_hosts': hosts_found,
115	                    'total_ports': ports_found,
116	                    'return_code': process.returncode
117	                })
118	
119	            return process.returncode == 0, stderr_output, output_file
120	
121	        except Exception as e:
122	            process.terminate()
123	            process.wait(timeout=5)
124	            raise e
125	
126	    except subprocess.TimeoutExpired:
127	        return False, f"Scan timed out after {timeout} seconds", output_file
128	    except Exception as e:
129	        return False, str(e), output_file
