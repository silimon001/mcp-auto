167	def decode_mime_header(header: str) -> str: 
168	    """Helper function to decode encoded email headers"""
169	    
170	    decoded_parts = decode_header(header)
171	    decoded_string = ''
172	    for part, encoding in decoded_parts: 
173	        if isinstance(part, bytes): 
174	            # Decode bytes to string using the specified encoding 
175	            decoded_string += part.decode(encoding or 'utf-8') 
176	        else: 
177	            # Already a string 
178	            decoded_string += part 
179	    return decoded_string
