526	    async def create_filter(self, 
527	                           from_email: str = None,
528	                           to_email: str = None,
529	                           subject: str = None,
530	                           query: str = None,
531	                           has_attachment: bool = None,
532	                           exclude_chats: bool = None,
533	                           size_comparison: str = None,
534	                           size: int = None,
535	                           add_label_ids: list[str] = None,
536	                           remove_label_ids: list[str] = None,
537	                           forward_to: str = None) -> dict | str:
538	        """Creates a new email filter
539	        
540	        Args:
541	            from_email: Email from a specific sender
542	            to_email: Email to a specific recipient
543	            subject: Email with a specific subject
544	            query: Email matching a custom query
545	            has_attachment: Email has an attachment
546	            exclude_chats: Exclude chats from filter
547	            size_comparison: 'larger' or 'smaller'
548	            size: Size in bytes for comparison
549	            add_label_ids: Labels to add to matching emails
550	            remove_label_ids: Labels to remove from matching emails
551	            forward_to: Email address to forward matching emails to
552	        """
553	        try:
554	            # Build the filter criteria
555	            criteria = {}
556	            if from_email:
557	                criteria['from'] = from_email
558	            if to_email:
559	                criteria['to'] = to_email
560	            if subject:
561	                criteria['subject'] = subject
562	            if query:
563	                criteria['query'] = query
564	            if has_attachment is not None:
565	                criteria['hasAttachment'] = has_attachment
566	            if exclude_chats is not None:
567	                criteria['excludeChats'] = exclude_chats
568	            if size_comparison and size:
569	                if size_comparison.lower() == 'larger':
570	                    criteria['sizeComparison'] = 'larger'
571	                    criteria['size'] = size
572	                elif size_comparison.lower() == 'smaller':
573	                    criteria['sizeComparison'] = 'smaller'
574	                    criteria['size'] = size
575	            
576	            # Build the filter actions
577	            action = {}
578	            if add_label_ids:
579	                action['addLabelIds'] = add_label_ids
580	            if remove_label_ids:
581	                action['removeLabelIds'] = remove_label_ids
582	            if forward_to:
583	                action['forward'] = forward_to
584	            
585	            # Create the filter
586	            filter_object = {
587	                'criteria': criteria,
588	                'action': action
589	            }
590	            
591	            created_filter = await asyncio.to_thread(
592	                self.service.users().settings().filters().create(
593	                    userId="me", 
594	                    body=filter_object
595	                ).execute
596	            )
597	            
598	            logger.info(f"Filter created: {created_filter['id']}")
599	            return {
600	                'status': 'success',
601	                'filter_id': created_filter['id'],
602	                'filter': created_filter
603	            }
604	        except HttpError as error:
605	            return {"status": "error", "error_message": str(error)}
