51	def format_email_headers(message_page):
52	    """Format email headers for display
53	
54	    Args:
55	        message_page: Page of messages from the GraphController API
56	
57	    Returns:
58	        String with formatted email headers
59	
60	    """
61	    result = ""
62	    if message_page:
63	        # Limit to requested count
64	        messages = message_page.value
65	
66	        # Format each message
67	        for i, message in enumerate(messages, 1):
68	            result += f"{i}. Subject: {message.subject}\n"
69	            if message.from_ and message.from_.email_address:
70	                result += f"   From: {message.from_.email_address.name or 'Unknown'} <{message.from_.email_address.address or 'No email'}>\n"
71	            else:
72	                result += f"   From: Unknown\n"
73	
74	            # Add To recipients
75	            if message.to_recipients and len(message.to_recipients) > 0:
76	                to_addresses = []
77	                for recipient in message.to_recipients:
78	                    if recipient.email_address:
79	                        to_addresses.append(
80	                            f"{recipient.email_address.name or 'Unknown'} <{recipient.email_address.address or 'No email'}>")
81	                if to_addresses:
82	                    result += f"   To: {', '.join(to_addresses)}\n"
83	
84	            # Add Reply To field if present
85	            if hasattr(message, 'reply_to') and message.reply_to and len(message.reply_to) > 0:
86	                reply_to_addresses = []
87	                for recipient in message.reply_to:
88	                    if recipient.email_address:
89	                        reply_to_addresses.append(
90	                            f"{recipient.email_address.name or 'Unknown'} <{recipient.email_address.address or 'No email'}>")
91	                if reply_to_addresses:
92	                    result += f"   Reply-To: {', '.join(reply_to_addresses)}\n"
93	
94	            # Add CC recipients
95	            if message.cc_recipients and len(message.cc_recipients) > 0:
96	                cc_addresses = []
97	                for recipient in message.cc_recipients:
98	                    if recipient.email_address:
99	                        cc_addresses.append(
100	                            f"{recipient.email_address.name or 'Unknown'} <{recipient.email_address.address or 'No email'}>")
101	                if cc_addresses:
102	                    result += f"   CC: {', '.join(cc_addresses)}\n"
103	
104	            # Add BCC recipients
105	            if message.bcc_recipients and len(message.bcc_recipients) > 0:
106	                bcc_addresses = []
107	                for recipient in message.bcc_recipients:
108	                    if recipient.email_address:
109	                        bcc_addresses.append(
110	                            f"{recipient.email_address.name or 'Unknown'} <{recipient.email_address.address or 'No email'}>")
111	                if bcc_addresses:
112	                    result += f"   BCC: {', '.join(bcc_addresses)}\n"
113	
114	            result += f"   Status: {'Read' if message.is_read else 'Unread'}\n"
115	            result += f"   Received: {message.received_date_time}\n"
116	            result += f"   Message ID: {message.id}\n\n"
117	
118	    else:
119	        result += "No messages found in the folder."
120	
121	    return result
