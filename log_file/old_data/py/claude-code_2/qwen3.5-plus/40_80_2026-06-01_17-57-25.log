483	@mcp.tool()
484	def add_fusion_comp_to_clip(
485	    timeline_index: int, track_type: str, track_index: int, item_index: int
486	) -> str:
487	    """
488	    Add a Fusion composition to a clip in the timeline.
489	
490	    Args:
491	        timeline_index: The index of the timeline (1-based)
492	        track_type: The type of track ("video", "audio", or "subtitle")
493	        track_index: The index of the track (1-based)
494	        item_index: The index of the item in the track (1-based)
495	
496	    Returns:
497	        A message indicating success or failure
498	    """
499	    if not resolve_api.is_connected():
500	        return "Error: Not connected to DaVinci Resolve."
501	
502	    project = resolve_api.get_current_project()
503	    if not project:
504	        return "No project is currently open."
505	
506	    timeline_count = project.GetTimelineCount()
507	    if timeline_index < 1 or timeline_index > timeline_count:
508	        return f"Invalid timeline index. Valid range is 1-{timeline_count}."
509	
510	    timeline = project.GetTimelineByIndex(timeline_index)
511	    if not timeline:
512	        return f"Failed to get timeline at index {timeline_index}."
513	
514	    if track_type not in ["video", "audio", "subtitle"]:
515	        return "Invalid track type. Valid types are 'video', 'audio', or 'subtitle'."
516	
517	    track_count = timeline.GetTrackCount(track_type)
518	    if track_index < 1 or track_index > track_count:
519	        return f"Invalid track index. Valid range is 1-{track_count}."
520	
521	    items = timeline.GetItemsInTrack(track_type, track_index)
522	    if not items:
523	        return f"No items in {track_type} track {track_index}."
524	
525	    if item_index < 1 or item_index > len(items):
526	        return f"Invalid item index. Valid range is 1-{len(items)}."
527	
528	    item = items[item_index - 1]
529	    fusion_comp = item.AddFusionComp()
530	
531	    if fusion_comp:
532	        # Switch to the Fusion page to edit the composition
533	        resolve_api.open_page("fusion")
534	        return f"Successfully added Fusion composition to {track_type} track {track_index}, item {item_index}."
535	    else:
536	        return f"Failed to add Fusion composition to {track_type} track {track_index}, item {item_index}."
537	
