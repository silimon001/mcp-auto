622	    async def search_emails(self, query: str, max_results: int = 50) -> list[dict] | str:
623	        """
624	        Searches for emails using Gmail's search syntax.
625	        
626	        Args:
627	            query: Gmail search query (e.g., 'from:example@gmail.com', 'subject:hello', etc.)
628	            max_results: Maximum number of results to return (default: 50)
629	            
630	        Returns:
631	            List of message objects or error message
632	        """
633	        try:
634	            user_id = 'me'
635	            
636	            response = await asyncio.to_thread(
637	                self.service.users().messages().list(
638	                    userId=user_id,
639	                    q=query,
640	                    maxResults=max_results
641	                ).execute
642	            )
643	            
644	            messages = []
645	            if 'messages' in response:
646	                messages.extend(response['messages'])
647	
648	            # Get additional pages if available and needed
649	            while 'nextPageToken' in response and len(messages) < max_results:
650	                page_token = response['nextPageToken']
651	                response = await asyncio.to_thread(
652	                    self.service.users().messages().list(
653	                        userId=user_id, 
654	                        q=query,
655	                        pageToken=page_token,
656	                        maxResults=max_results - len(messages)
657	                    ).execute
658	                )
659	                if 'messages' in response:
660	                    messages.extend(response['messages'])
661	            
662	            # Get basic metadata for each message
663	            result_messages = []
664	            for msg in messages:
665	                msg_data = await asyncio.to_thread(
666	                    self.service.users().messages().get(
667	                        userId=user_id,
668	                        id=msg['id'],
669	                        format='metadata',
670	                        metadataHeaders=['Subject', 'From', 'Date']
671	                    ).execute
672	                )
673	                
674	                headers = msg_data.get('payload', {}).get('headers', [])
675	                
676	                subject = next((header['value'] for header in headers if header['name'].lower() == 'subject'), 'No Subject')
677	                sender = next((header['value'] for header in headers if header['name'].lower() == 'from'), 'Unknown Sender')
678	                date = next((header['value'] for header in headers if header['name'].lower() == 'date'), '')
679	                
680	                result_messages.append({
681	                    'id': msg['id'],
682	                    'threadId': msg['threadId'],
683	                    'subject': subject,
684	                    'from': sender,
685	                    'date': date,
686	                    'snippet': msg_data.get('snippet', '')
687	                })
688	                
689	            return result_messages
690	            
691	        except HttpError as error:
692	            return f"An HttpError occurred: {str(error)}"
