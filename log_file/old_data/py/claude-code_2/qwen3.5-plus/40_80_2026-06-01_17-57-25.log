202	    current_folder = media_pool.GetCurrentFolder()
203	    if not current_folder:
204	        return "No current folder available."
205	
206	    folder_name = current_folder.GetName()
207	    clips = current_folder.GetClips()
208	    clip_count = len(clips) if clips else 0
209	
210	    clip_info = []
211	    if clips:
212	        for i, clip in enumerate(clips, 1):
213	            if i > 10:  # Limit to 10 clips to avoid overwhelming response
214	                clip_info.append(f"... and {clip_count - 10} more clips")
215	                break
216	            clip_info.append(f"{i}. {clip.GetName()}")
217	
218	    clips_text = "No clips in this folder." if clip_count == 0 else "\n".join(clip_info)
219	
220	    return f"Current Folder: {folder_name}\nClip Count: {clip_count}\nClips:\n{clips_text}"
