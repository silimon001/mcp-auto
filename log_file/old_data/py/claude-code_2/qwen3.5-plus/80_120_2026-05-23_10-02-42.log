23	
24	
25	# _ReturnType represents the return type of the function passed to `_fmap`.
26	_ReturnType = TypeVar("_ReturnType")
27	
28	
29	def _fmap(
30	    func: Callable[..., Optional[_ReturnType]], *maybe_nones: Optional[Any]
31	) -> Optional[_ReturnType]:
32	    """Applies a function to multiple Optional values, flattening the result.
33	
34	    If any input is None, returns None. Otherwise, applies `func` to the
35	    unwrapped values and returns its result.
36	
37	    Args:
38	        func: A function that takes multiple arguments of potentially different types
39	              and returns an Optional[R].
40	        *maybe_nones: A variable number of Optional values of different types.
41	
42	    Returns:
43	        An Optional[_ReturnType] resulting from applying `func` to the unwrapped values,
44	        or None if any input is None.
45	    """
46	    if any(maybe is None for maybe in maybe_nones):
47	        return None
48	    return func(*maybe_nones)
49	
50	
51	def dump_json(maybe_model: Union[BaseModel, list, dict, None]) -> str:
52	    """Serializes a Pydantic model, list, or dictionary to a JSON string.
53	
54	    This function ensures proper serialization using Pydantic's encoding utilities,
55	    handling both single model instances and lists/dicts of models.
56	
57	    Args:
58	        maybe_model (Union[BaseModel, list, dict, None]): The object to serialize.
59	
60	    Returns:
61	        str: A JSON string representation of the input, or an empty string if None
62	        is provided.
63	    """
64	    if maybe_model is None:
65	        return ""
66	    elif isinstance(maybe_model, list) or isinstance(maybe_model, dict):
67	        return json.dumps(maybe_model, default=pydantic_encoder, separators=(",", ":"))
68	    else:
69	        return maybe_model.model_dump_json(by_alias=True, exclude_unset=True)
70	
71	
72	@contextmanager
73	def create_module(script: str) -> Iterator[Optional[ModuleType]]:
74	    """Creates a temporary Python module from a given script string.
75	
76	    This context manager writes the provided script to a temporary file,
77	    loads it as a module, and yields it for use.
78	
79	    Args:
80	        script (str): The Python script to be dynamically loaded.
81	
82	    Yields:
83	        ModuleType: The loaded temporary module.
84	    """
85	    with NamedTemporaryFile(suffix=".py") as tmp:
86	        tmp.write(script.encode())
87	        tmp.flush()
88	        spec = spec_from_file_location(Path(tmp.name).stem, tmp.name)
89	        module = _fmap(module_from_spec, spec)
90	        loader = _fmap(lambda spec: spec.loader, spec)
91	        _ = _fmap(lambda loader, module: loader.exec_module(module), loader, module)
92	        yield module
