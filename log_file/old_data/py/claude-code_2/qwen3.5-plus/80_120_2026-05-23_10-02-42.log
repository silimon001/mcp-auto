1	"""Unity Catalog Model Context Protocol (MCP) Server Configuration/CLI.
2	
3	This module defines the server configuration/cli class for the Model Context Protocol (MCP) in Unity Catalog.
4	
5	Features:
6	- Defines default values for the MCP server configuration.
7	- Supports automatic loading of environment variables.
8	
9	License:
10	MIT License (c) 2025 Shingo Okawa
11	"""
12	
13	from functools import lru_cache
14	from typing import Literal, Optional
15	from pathlib import Path
16	from pydantic import AliasChoices, Field
17	from pydantic_settings import BaseSettings, SettingsConfigDict
18	
19	
20	class Cli(BaseSettings):
21	    """Configuration class for the Unity Catalog CLI.
22	
23	    This class defines configuration options for interacting with the Unity Catalog server
24	    through the CLI. It leverages `pydantic.BaseSettings` to support environment variable
25	    loading and command-line argument parsing.
26	
27	    Attributes:
28	        uc_server (str): The base URL of the Unity Catalog server for API interactions.
29	        uc_catalog (str): The top-level catalog name in Unity Catalog.
30	        uc_schema (str): The schema name within a Unity Catalog catalog.
31	        uc_token (Optional[str]): The API access token for authentication.
32	        uc_verbosity (Literal["debug", "info", "warn", "error", "critical"]): Logging verbosity level.
33	        uc_log_directory (Path): Directory where Unity Catalog logs will be stored.
34	    """
35	
36	    model_config = SettingsConfigDict(
37	        env_file=".env",
38	        env_file_encoding="utf-8",
39	        cli_parse_args=True,
40	    )
41	    uc_server: str = Field(
42	        description="The base URL of the Unity Catalog server, "
43	        "used to interact with the Unity Catalog API.",
44	        validation_alias=AliasChoices("u", "uc_server"),
45	    )
46	    uc_catalog: str = Field(
47	        description="The name of the Unity Catalog catalog, "
48	        "which serves as the top-level container for schemas "
49	        "and assets within Unity Catalog.",
50	        validation_alias=AliasChoices("c", "uc_catalog"),
51	    )
52	    uc_schema: str = Field(
53	        description="The name of the schema within a Unity Catalog "
54	        "catalog. Schemas organize assets, providing a structured "
55	        "namespace for data objects.",
56	        validation_alias=AliasChoices("s", "uc_schema"),
57	    )
58	    uc_token: Optional[str] = Field(
59	        default=None,
60	        description="The access token used to authorize API requests "
61	        "to the Unity Catalog server.",
62	        validation_alias=AliasChoices("t", "uc_token"),
63	    )
64	    uc_verbosity: Literal["debug", "info", "warn", "error", "critical"] = Field(
65	        default="warn",
66	        description="The verbosity level for logging or debugging "
67	        "MCP Unity Catalog server.",
68	        validation_alias=AliasChoices("v", "uc_verbosity"),
69	    )
70	    uc_log_directory: Path = Field(
71	        default=Path(".mcp_server_unitycatalog"),
72	        description="The directory where log files for the MCP Unity "
73	        "Catalog server will be stored.",
74	        validation_alias=AliasChoices("l", "uc_log_directory"),
75	    )
76	
77	
78	@lru_cache
79	def get_settings():
80	    """Returns a cached instance of the `Cli` class.
81	
82	    This function ensures that the configuration settings are loaded only once
83	    and reused across multiple calls, improving performance by avoiding redundant
84	    parsing of environment variables or CLI arguments.
85	
86	    Returns:
87	        Settings: A singleton instance of the `Cli` class.
88	    """
89	    return Cli()  # pyright: ignore[reportCallIssue]
90	

