63	
64	class CreateFunction(BaseModel):
65	    """Represents a request to create a new function in Unity Catalog.
66	
67	    This model is used to define the parameters required for registering
68	    a Python function within Unity Catalog.
69	
70	    Attributes:
71	        name (str): The name of the function to be registered.
72	        script (str): The Python script containing the function definition.
73	    """
74	
75	    name: str = Field(
76	        description="The name of the function to be registered in the given script.",
77	    )
78	    script: str = Field(
79	        description="The Python script including the function to be registered.",
80	    )
81	
82	
83	class DeleteFunction(BaseModel):
84	    """Represents a request to delete a function in Unity Catalog.
85	
86	    This model is used to define the parameters required for deleting
87	    a Python function within Unity Catalog.
88	
89	    Attributes:
90	        name (str): The name of the function to be deleted.
91	    """
92	
93	    name: str = Field(
94	        description="The name of the function to be deleted.",
95	    )
96	
97	
98	# Represents MCP tool response content.
99	Content: TypeAlias = Union[TextContent, ImageContent, EmbeddedResource]
100	# Represents MCP tool implementations.
101	UnityCatalogAiFunction: TypeAlias = Callable[
102	    [RequestContext[ServerSession], UnitycatalogFunctionClient, dict], list[Content]
103	]
104	
105	
106	@observe(by=LOGGER, args=[2])
107	def _list_functions(
108	    context: RequestContext[ServerSession],
109	    client: UnitycatalogFunctionClient,
110	    arguments: dict,
111	) -> list[Content]:
112	    """Lists functions within the configured Unity Catalog catalog and schema.
113	
114	    This function retrieves a list of functions from the Unity Catalog
115	    using the preconfigured catalog and schema settings.
116	
117	    Args:
118	        context (RequestContext[ServerSession]): The request context with session details.
119	        client (UnitycatalogFunctionClient): The client used to interact with Unity Catalog.
120	        arguments (dict): A dictionary of additional arguments (currently unused).
121	
122	    Returns:
123	        list[Content]: A list of functions retrieved from Unity Catalog.
124	    """
125	    settings, model = Settings(), ListFunctions.model_validate(arguments)
126	    content = dump_json(
127	        client.list_functions(
128	            catalog=settings.uc_catalog, schema=settings.uc_schema
129	        ).to_list()
130	    )
131	    return [
