139	@observe(by=LOGGER, args=[2])
140	def _get_function(
141	    context: RequestContext[ServerSession],
142	    client: UnitycatalogFunctionClient,
143	    arguments: dict,
144	) -> list[Content]:
145	    """Retrieves details of a specific Unity Catalog function.
146	
147	    This function queries the Unity Catalog for a function specified by
148	    the provided arguments and returns its details as a JSON-formatted string.
149	
150	    Args:
151	        context (RequestContext[ServerSession]): The request context with session details.
152	        client (UnitycatalogFunctionClient): The client used to interact with the Unity Catalog.
153	        arguments (dict): A dictionary containing the function name.
154	
155	    Returns:
156	        list[Content]: A list containing a single TextContent object
157	        with the function details in JSON format.
158	    """
159	    settings, model = Settings(), GetFunction.model_validate(arguments)
160	    content = dump_json(
161	        client.get_function(
162	            function_name=f"{settings.uc_catalog}.{settings.uc_schema}.{model.name}",
163	        )
164	    )
165	    return [
166	        TextContent(
167	            type="text",
168	            text=content,
169	        )
170	    ]
171	
172	
173	@observe(by=LOGGER, args=[2])
174	def _create_function(
175	    context: RequestContext[ServerSession],
176	    client: UnitycatalogFunctionClient,
177	    arguments: dict,
178	) -> list[Content]:
179	    """Creates a new Python function in Unity Catalog based on the provided script.
180	
181	    This function extracts a specified function from the given script,
182	    registers it in Unity Catalog, and notifies the session of changes.
183	
184	    Args:
185	        context (RequestContext[ServerSession]): The request context with session details.
186	        client (UnitycatalogFunctionClient): The client for interacting with Unity Catalog.
187	        arguments (dict): A dictionary containing:
188	            - "name" (str): The function name to register.
189	            - "script" (str): The Python script containing the function definition.
190	
191	    Returns:
192	        list[Content]: A list containing the JSON response of the created function.
193	    """
194	    settings, model = Settings(), CreateFunction.model_validate(arguments)
195	    # NOTE:
196	    # `inspect.getsourcelines` expects the argument to be a Python object defined in an actual
197	    # source file, meaning it does not work for objects that exist only in memory.
198	    # Hence, we provided a context manager responsible for handling temporary module creation.
199	    with create_module(model.script) as module:
200	        func = getattr(module, model.name)
201	        content = dump_json(
202	            client.create_python_function(
203	                catalog=settings.uc_catalog,
204	                schema=settings.uc_schema,
205	                func=func,
206	            )
207	        )
208	    asyncio.run(context.session.send_tool_list_changed())
209	    return [
210	        TextContent(
211	            type="text",
212	            text=content,
213	        )
214	    ]
215	
216	
217	@observe(by=LOGGER, args=[2])
218	def _delete_function(
219	    context: RequestContext[ServerSession],
220	    client: UnitycatalogFunctionClient,
221	    arguments: dict,
222	) -> list[Content]:
223	    """Deletes a function from Unity Catalog.
224	
225	    This function removes a registered function from the Unity Catalog,
226	    and notifies the session that the available tools list has changed.
227	
228	    Args:
229	        context (RequestContext[ServerSession]): The request context, which manages the session state.
230	        client (UnitycatalogFunctionClient): The client used to interact with Unity Catalog.
231	        arguments (dict): A dictionary containing the function name to be deleted.
232	
233	    Returns:
234	        list[Content]: A list containing the deletion result as a text response.
235	    """
236	    settings, model = Settings(), DeleteFunction.model_validate(arguments)
237	    content = dump_json(
238	        client.delete_function(
239	            function_name=f"{settings.uc_catalog}.{settings.uc_schema}.{model.name}",
240	        )
241	    )
242	    asyncio.run(context.session.send_tool_list_changed())
243	    return [
244	        TextContent(
245	            type="text",
246	            text=content,
247	        )
248	    ]
