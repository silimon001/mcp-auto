1	"""Unity Catalog Model Context Protocol (MCP) Server Tools.
2	
3	This module provides utility functions for interacting with the Unity Catalog AI MCP server.
4	
5	Features:
6	- Lists Unity Catalog Functions.
7	- Retrieves information about a specific Unity Catalog Function.
8	- Creates Unity Catalog (Python) Functions.
9	- Executes Unity Catalog (Python) Functions.
10	- Deletes Unity Catalog Functions.
11	
12	License:
13	MIT License (c) 2025 Shingo Okawa
14	"""
15	
16	import asyncio
17	import logging
18	from typing import Callable, Optional, Union, TypeAlias
19	from mcp.shared.context import RequestContext
20	from mcp.server.session import ServerSession
21	from mcp.types import (
22	    TextContent,
23	    ImageContent,
24	    EmbeddedResource,
25	    Tool,
26	)
27	from pydantic import BaseModel, Field
28	from unitycatalog.ai.core.client import UnitycatalogFunctionClient
29	from unitycatalog.ai.core.utils.function_processing_utils import (
30	    generate_function_input_params_schema,
31	)
32	from unitycatalog.client.models.function_info import FunctionInfo
33	from mcp_server_unitycatalog.cli import get_settings as Settings
34	from mcp_server_unitycatalog.logger import observe
35	from mcp_server_unitycatalog.utils import create_module, dump_json
36	
37	
38	# The logger instance for this module.
39	LOGGER = logging.getLogger(__name__)
40	
41	
42	class ListFunctions(BaseModel):
43	    """Represents a request to list Unity Catalog Functions.
44	
45	    This model defines parameters for listing functions within a Unity Catalog
46	    schema, allowing pagination and optional result limits.
47	    """
48	
49	    pass
