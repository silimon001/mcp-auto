58	# --- Lifespan Management for Credentials ---
59	
60	@asynccontextmanager
61	async def credential_manager(server: FastMCP) -> AsyncIterator[Dict[str, Any]]:
62	    """
63	    Manages loading and refreshing Google API credentials on server startup.
64	    """
65	    creds = None
66	    if not os.path.exists(TOKEN_PATH):
67	        print(f"ERROR: Token file '{TOKEN_PATH}' not found.", file=sys.stderr)
68	        print("Please run 'python get_credentials.py' first to authorize the application.", file=sys.stderr)
69	        # Yield an empty context and let tool calls fail gracefully
70	        yield {"creds": None}
71	        return
72	
73	    print(f"Loading credentials from {TOKEN_PATH}", file=sys.stderr)
74	    creds = google.oauth2.credentials.Credentials.from_authorized_user_file(TOKEN_PATH, SCOPES)
75	
76	    if creds and creds.expired and creds.refresh_token:
77	        print("Credentials expired. Refreshing...", file=sys.stderr)
78	        try:
79	            creds.refresh(Request())
80	            # Re-save the refreshed token
81	            with open(TOKEN_PATH, 'w') as token_file:
82	                token_file.write(creds.to_json())
83	            print("Token refreshed and saved.", file=sys.stderr)
84	        except Exception as e:
85	            print(f"ERROR: Failed to refresh token: {e}", file=sys.stderr)
86	            creds = None # Mark credentials as invalid
87	            
88	    # Make credentials available to all tool handlers via context
89	    yield {"creds": creds}
90	    print("Server shutting down.", file=sys.stderr)
91	
92	# Initialize the server with the lifespan manager
93	server = FastMCP(
94	    "GsuiteMCPServer", 
95	    title="Gsuite MCP Server",
96	    lifespan=credential_manager
97	)
