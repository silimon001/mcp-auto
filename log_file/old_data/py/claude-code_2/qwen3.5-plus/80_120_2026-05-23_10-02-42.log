321	                "cpe:2.3:a:vendor:product:version:update:edition:language:"
322	                "sw_edition:target_sw:target_hw:other - eventually use the wildcard *, e.g.: cpe:2.3:a:ntp:ntp:4.2.8:p3:*:*:*:*:*:*")
323	
324	    url = f"{NVD_BASE}/cves{NVD_VERSION}"
325	    params = {"cpeName": cpe_name}
