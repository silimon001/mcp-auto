1	"""
2	MCP Server for Code Analysis Tools
3	
4	This module implements a Model-Code-Prompt (MCP) server that exposes various
5	code analysis tools through a standardized interface. It supports both stdio and
6	SSE transport mechanisms for communication.
7	"""
8	
9	import argparse
10	import anyio
11	from typing import Any, Dict, List, Optional, Type, TypeVar, Union, get_args, get_origin
12	import mcp.types as types
13	from mcp.server.lowlevel import NotificationOptions, Server
14	from mcp.server.models import InitializationOptions
15	import mcp.server.stdio
16	import mcp.server.sse
17	from pydantic import AnyUrl, BaseModel as PydanticBaseModel
18	from starlette.applications import Starlette
19	from starlette.routing import Mount, Route
20	
21	from coderetrx.tools.base import BaseTool
22	from coderetrx.tools import list_tool_class, get_tool
23	import logging
24	
25	
26	logger = logging.getLogger("mcp")
27	
28	# Create MCP server instance
29	server = Server("code_tool")
30	
31	# Type definitions for improved type hinting
32	ToolType = TypeVar("ToolType", bound=BaseTool)
33	JsonSchema = Dict[str, Any]
34	
35	# Global dictionary to map tool names to tool instances
36	
37	
38	def parse_arguments() -> argparse.Namespace:
39	    """
40	    Parse command-line arguments using argparse.
41	
42	    Returns:
43	        Parsed command-line arguments
44	    """
45	    parser = argparse.ArgumentParser(description="MCP Server for Code Analysis Tools")
46	
47	    # Required arguments
48	    parser.add_argument(
49	        "repo_url", type=str, help="repo_urlsitory URL or identifier to analyze"
50	    )
51	
52	    # Optional arguments
53	    parser.add_argument(
54	        "--use-sse",
55	        action="store_true",
56	        help="Use Server-Sent Events (SSE) instead of stdio",
57	    )
58	    parser.add_argument(
59	        "--port",
60	        type=int,
61	        default=10001,
62	        help="Port number for SSE server (default: 10001)",
63	    )
64	    parser.add_argument(
65	        "--host",
66	        type=str,
67	        default="0.0.0.0",
68	        help="Host address for SSE server (default: 0.0.0.0)",
69	    )
70	    parser.add_argument(
71	        "--debug",
72	        action="store_true",
73	        help="Enable debug logging",
74	    )
75	
76	    return parser.parse_args()
77	
78	
79	def model_to_json_schema(model_class: Type[PydanticBaseModel]) -> JsonSchema:
80	    """
81	    Convert a Pydantic model to a JSON schema.
82	
83	    Args:
84	        model_class: The Pydantic model class to convert
85	
86	    Returns:
87	        A dictionary representing the JSON schema
88	    """
89	    properties = {}
90	    required = []
91	
92	    for field_name, field_info in model_class.model_fields.items():
93	        field_type = field_info.annotation
94	        field_description = field_info.description
95	
96	        # Track required fields
97	        if field_info.is_required():
98	            required.append(field_name)
99	
100	        # Map field type to JSON schema type
101	        field_schema = {"type": get_json_type(field_type)}
102	
103	        # Add description if available
104	        if field_description:
105	            field_schema["description"] = field_description
106	
107	        properties[field_name] = field_schema
108	
109	    schema = {"type": "object", "properties": properties}
110	    if required:
111	        schema["required"] = required
112	
113	    return schema
114	
115	
116	def get_json_type(python_type) -> str:
117	    """
118	    Map Python types to JSON schema types.
119	
120	    Args:
121	        python_type: The Python type to map
122	
123	    Returns:
124	        The corresponding JSON schema type as a string
125	    """
126	    type_map = {
127	        str: "string",
128	        int: "integer",
129	        float: "number",
130	        bool: "boolean",
131	        list: "array",
132	        dict: "object",
133	    }
134	
135	    if python_type in type_map:
136	        return type_map[python_type]
137	
138	    origin = get_origin(python_type)
139	    if origin is not None:
140	        if origin in (list, set, tuple):
141	            return "array"
142	        elif origin is dict:
143	            return "object"
144	        elif origin is Union:
145	            args = get_args(python_type)
146	            if len(args) == 2 and type(None) in args:
147	                non_none_type = next(arg for arg in args if arg is not type(None))
148	                return get_json_type(non_none_type)
149	
150	    return "string"
151	
152	
153	@server.list_resources()
154	async def handle_list_resources() -> list[types.Resource]:
155	    return []
156	
157	
158	@server.read_resource()
159	async def handle_read_resource(uri: AnyUrl) -> str:
160	    return ""
161	
162	
163	@server.list_tools()
164	async def handle_list_tools() -> List[types.Tool]:
165	    """
166	    Handle the list_tools request by providing metadata for all available tools.
167	
168	    Returns:
169	        List of Tool objects containing metadata for each available tool
170	    """
171	    mcp_tools = []
172	    try:
173	        for tool_class in list_tool_class():
174	            mcp_tools.append(
175	                types.Tool(
176	                    name=tool_class.name,
177	                    description=tool_class.description,
178	                    inputSchema=model_to_json_schema(tool_class.args_schema),
179	                )
180	            )
181	        return mcp_tools
182	    except Exception as e:
183	        logging.error(f"Error listing tools: {str(e)}")
184	        raise
185	
186	
187	@server.call_tool()
188	async def handle_call_tool(
189	    name: str, arguments: Optional[Dict[str, Any]] = None
190	) -> List[types.TextContent]:
191	    """
192	    Handle tool execution requests.
193	
194	    Args:
195	        name: The name of the tool to call
196	        arguments: Tool arguments as a dictionary
197	
198	    Returns:
199	        List of content objects containing tool execution results
200	    """
201	    if arguments is None:
202	        arguments = {}
203	
204	    tool = get_tool(repo_url, name)
205	    if not tool:
206	        raise ValueError(f"Unknown tool name: {name}")
207	
208	    try:
209	        result = await tool.run(**arguments)
210	        return [types.TextContent(type="text", text=str(result))]
211	    except Exception as e:
212	        logging.error(f"Error executing tool '{name}': {str(e)}")
213	        return [types.TextContent(type="text", text=f"Error: {str(e)}")]
214	
215	
216	async def run_stdio_server() -> None:
217	    """Run the server using stdio transport."""
218	    async with mcp.server.stdio.stdio_server() as (read_stream, write_stream):
219	        await server.run(
220	            read_stream,
221	            write_stream,
222	            InitializationOptions(
223	                server_name="code_analysis_server",
224	                server_version="0.1.0",
225	                capabilities=server.get_capabilities(
226	                    notification_options=NotificationOptions(),
227	                    experimental_capabilities={},
228	                ),
229	            ),
230	        )
231	
232	
233	def run_sse_server(host: str, port: int, debug: bool) -> None:
234	    """Run the server using SSE transport."""
235	    sse = mcp.server.sse.SseServerTransport("/messages/")
236	
237	    async def handle_sse(request) -> None:
238	        async with sse.connect_sse(
239	            request.scope, request.receive, request._send
240	        ) as streams:
241	            await server.run(
242	                streams[0],
243	                streams[1],
244	                server.create_initialization_options(),
245	            )
246	
247	    app = Starlette(
248	        debug=debug,
249	        routes=[
250	            Route("/sse", endpoint=handle_sse),
251	            Mount("/messages/", app=sse.handle_post_message),
252	        ],
253	    )
254	
255	    import uvicorn
256	
257	    uvicorn.run(app, host=host, port=port)
258	
259	
260	def main() -> None:
261	    """Main entry point for the MCP server."""
262	    args = parse_arguments()
263	    global repo_url
264	    repo_url = args.repo_url
265	    if args.use_sse:
266	        run_sse_server(args.host, args.port, args.debug)
267	    else:
268	        anyio.run(run_stdio_server)
269	
270	
271	if __name__ == "__main__":
272	    main()
273	

