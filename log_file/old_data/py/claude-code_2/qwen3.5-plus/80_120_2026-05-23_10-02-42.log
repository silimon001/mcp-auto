1	"""MCP server implementation using FastMCP for Obsidian integration."""
2	
3	import logging
4	import sys
5	import os
6	import platform
7	from typing import Dict, Any, List, Optional
8	from datetime import datetime
9	
10	from mcp.server.fastmcp import FastMCP
11	import mcp
12	
13	from mcp_obsidian.config import load_config
14	from mcp_obsidian.obsidian import ObsidianClient
15	from mcp_obsidian.utils.errors import (
16	    ObsidianError,
17	    ObsidianNotFoundError,
18	    ConfigurationError
19	)
20	
21	# Version of this MCP server
22	__version__ = "0.1.0"
23	
24	# Try to get MCP version
25	try:
26	    mcp_version = getattr(mcp, "__version__", "unknown")
27	except:
28	    mcp_version = "unknown"
29	
30	# Configure logging to stderr only with color support
31	class ColoredFormatter(logging.Formatter):
32	    """Custom formatter with colored output."""
33	    
34	    COLORS = {
35	        'DEBUG': '\033[94m',  # Blue
36	        'INFO': '\033[92m',   # Green
37	        'WARNING': '\033[93m', # Yellow
38	        'ERROR': '\033[91m',  # Red
39	        'CRITICAL': '\033[91m\033[1m',  # Bold Red
40	        'RESET': '\033[0m'    # Reset
41	    }
42	    
43	    def format(self, record):
44	        log_message = super().format(record)
45	        level_name = record.levelname
46	        if level_name in self.COLORS:
47	            return f"{self.COLORS[level_name]}{log_message}{self.COLORS['RESET']}"
48	        return log_message
49	
50	# Set up logger
51	logger = logging.getLogger("mcp_obsidian")
52	logger.setLevel(logging.DEBUG)
53	handler = logging.StreamHandler(sys.stderr)
54	formatter = ColoredFormatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
55	handler.setFormatter(formatter)
56	logger.addHandler(handler)
57	
58	# Initialize FastMCP server with proper configuration
59	mcp = FastMCP(
60	    name="Obsidian MCP Server",
61	    version=__version__,
62	    capabilities={
63	        "tools": True,
64	        "resources": True,
65	        "prompts": True
66	    }
67	)
68	
69	# Register prompts using decorators
70	@mcp.prompt("meeting-notes")
71	async def meeting_notes_prompt(
72	    title: str,
73	    date: str = "",
74	    participants: str = "",
75	    folder: str = "Meetings",
76	    tags: List[str] = None
77	) -> Dict[str, Any]:
78	    """Create a meeting note with the given details."""
79	    global client
80	    if not client:
81	        await initialize_client()
82	    if not date:
83	        date = datetime.now().strftime("%Y-%m-%d")
84	    if not folder.endswith("/"):
85	        folder += "/"
86	    folder_note_path = f"{folder}.folder"
87	    folder_note_content = f"# {folder.rstrip('/')}\nThis folder contains meeting notes."
88	    try:
89	        await client.create_note(folder_note_path, folder_note_content)
90	    except Exception as e:
91	        if "already exists" not in str(e):
92	            raise e
93	    content = f"""# {title}\n\nDate: {date}\nParticipants: {participants}\n\n## Agenda\n- \n\n## Notes\n- \n\n## Action Items\n- [ ] \n\n## Next Steps\n- \n\n---\ntags: [meeting]\n"""
94	    path = f"{folder}{title}.md"
95	    success = await client.create_note(path, content)
96	    return {
97	        "status": "success" if success else "error",
98	        "path": path,
99	        "content": content
100	    }
101	
102	@mcp.prompt("create-note")
103	async def create_note_prompt(
104	    title: str,
105	    content: str,
106	    folder: str = "",
107	    tags: List[str] = None
108	) -> Dict[str, Any]:
109	    """Create a new note with the given details."""
110	    path = f"{folder}/{title}.md" if folder else f"{title}.md"
111	    success = await obsidian_create_note(
112	        path=path,
113	        content=content,
114	        metadata={"tags": tags} if tags else None
115	    )
116	    return {"success": success, "path": path}
117	
118	# Organize notes prompt removed - planned for Phase 2
119	
120	# Global client instance
121	client: Optional[ObsidianClient] = None
122	
123	
124	# Initialize client
125	async def initialize_client():
126	    """Initialize the Obsidian client."""
127	    global client
128	    
129	    if client is not None:
130	        logger.debug("Client already initialized, reusing existing client")
131	        return
132	    
133	    logger.info("Initializing Obsidian client...")
134	    
135	    # Load configuration
136	    config = load_config()
137	    
138	    # Validate configuration
139	    if not config.api_key:
140	        logger.error("Missing API key in configuration")
141	        raise ConfigurationError("Missing required configuration. Please set OBSIDIAN_API_KEY.")
142	    
143	    # Initialize Obsidian client
144	    client = ObsidianClient(config)
145	    logger.info(f"Connecting to Obsidian API at {config.protocol}://{config.host}:{config.port}")
146	    
147	    # Test connection
148	    try:
149	        connected = await client.connect()
150	        if not connected:
151	            logger.error("Failed to connect to Obsidian API")
152	            raise ConfigurationError("Failed to connect to Obsidian API")
153	        logger.info("✅ Successfully connected to Obsidian API")
154	    except ObsidianError as e:
155	        logger.error(f"Failed to connect to Obsidian API: {str(e)}")
156	        raise ConfigurationError(f"Failed to connect to Obsidian API: {str(e)}")
157	
158	
159	# File operation tools
160	@mcp.tool()
161	async def obsidian_read_note(path: str, include_metadata: bool = False) -> str:
162	    """Get content of a note from your Obsidian vault.
163	    
164	    Retrieves the content of a specific note from the currently open Obsidian vault.
165	    
166	    Args:
167	        path: Path to the note relative to vault root (e.g., "Folder/Note.md" or "Note.md")
168	            - Must include the .md extension
