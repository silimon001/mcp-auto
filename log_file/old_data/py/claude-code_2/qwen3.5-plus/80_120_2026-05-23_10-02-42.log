3	"""Запуск BSL MCP сервера из виртуального окружения."""
4	import sys
5	import subprocess
6	import platform
7	from pathlib import Path
8	
9	def main():
10	    base_dir = Path(__file__).parent
11	    venv_dir = base_dir / ".venv"
12	    
13	    # Путь к python в venv
14	    if platform.system() == "Windows":
15	        venv_python = venv_dir / "Scripts" / "python.exe"
16	    else:
17	        venv_python = venv_dir / "bin" / "python"
18	
19	    # Проверка наличия venv
20	    if not venv_python.exists():
21	        print(f"Ошибка: виртуальное окружение не найдено.")
22	        print(f"Сначала выполните: python install.py")
23	        pass
24	        sys.exit(1)
25	
26	    # Запуск приложения
27	    print("--- [START] Запуск BSL MCP ---")
28	    
29	    # Отключаем телеметрию Qdrant (убирает задержку 25с при старте)
30	    import os
31	    os.environ["QDRANT_TELEMETRY_DISABLED"] = "1"
32	
33	    try:
34	        cmd = [str(venv_python), "-m", "code_search"] + sys.argv[1:]
35	        # Явно передаем environment с установленной переменной
36	        env = os.environ.copy()
37	        env["QDRANT_TELEMETRY_DISABLED"] = "1"
38	        subprocess.run(cmd, env=env)
39	    except KeyboardInterrupt:
40	        print("\nОстановлено пользователем.")
41	    except Exception as e:
42	        print(f"Ошибка запуска: {e}")
43	        pass
44	
