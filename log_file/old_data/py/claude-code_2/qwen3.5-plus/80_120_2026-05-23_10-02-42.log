202	def list_calendar_events(ctx: Context, start_time: str, end_time: str, query: Optional[str] = None) -> List[ListedEvent]:
203	    """
204	    Lists calendar events within a specified time range, optionally filtering by a search query.
205	
206	    Args:
207	        start_time: The start of the time range in ISO 8601 format (e.g., '2025-07-05T00:00:00Z').
208	        end_time: The end of the time range in ISO 8601 format (e.g., '2025-07-06T00:00:00Z').
209	        query: An optional text query to filter events by (e.g., 'meeting').
210	    """
211	    creds = get_creds_from_context(ctx)
212	    try:
213	        calendar_service = googleapiclient.discovery.build('calendar', 'v3', credentials=creds)
214	        events_result = calendar_service.events().list(
215	            calendarId='primary', 
216	            timeMin=start_time, 
217	            timeMax=end_time,
218	            q=query, # TODO: study it
219	            maxResults=20,  # Limit results to a reasonable number
220	            singleEvents=True, 
221	            orderBy='startTime'
222	        ).execute()
223	        
224	        events = events_result.get('items', [])
225	        if not events:
226	            return []
227	
228	        listed_events = []
229	        for event in events:
230	            # Handle all-day events which have 'date' instead of 'dateTime'
231	            start = event['start'].get('dateTime', event['start'].get('date'))
232	            end = event['end'].get('dateTime', event['end'].get('date'))
233	            listed_events.append(
234	                ListedEvent(
235	                    id=event['id'],
236	                    summary=event.get('summary', 'No Title'),
237	                    start_time=start,
238	                    end_time=end
239	                )
240	            )
241	        return listed_events
242	    except HttpError as e:
243	        raise Exception(f"API Calendar error (HTTP {e.status_code}): {e.reason}")
244	
245	@server.tool()
246	def create_calendar_event(event_details: EventDetails, ctx: Context) -> Dict[str, Any]:
247	    """
248	    Creates a Google Calendar event from structured event details.
249	    
250	    Args:
251	        event_details: A structured object containing the summary, start time, end time, and description.
252	    """
253	    creds = get_creds_from_context(ctx)
254	    event_body = {
255	        'summary': event_details.summary,
256	        'description': event_details.description or f'Created from an email automation.',
257	        'start': {'dateTime': event_details.start_time, 'timeZone': 'Europe/Rome'},
258	        'end': {'dateTime': event_details.end_time, 'timeZone': 'Europe/Rome'},
259	    }
260	
261	    try:
262	        calendar_service = googleapiclient.discovery.build('calendar', 'v3', credentials=creds)
263	        created_event = calendar_service.events().insert(calendarId='primary', body=event_body).execute()
264	        return created_event
