1	"""Unity Catalog Model Context Protocol (MCP) Server Logger Utility Functions.
2	
3	This module provides a decorator for logging function calls, enabling
4	automatic logging before execution, after execution, and upon exceptions.
5	
6	Features:
7	- Logs function arguments, return values, and exceptions.
8	- Enhances debugging and observability.
9	
10	License:
11	MIT License (c) 2025 Shingo OKAWA
12	"""
13	
14	import functools
15	import time
16	import uuid
17	from enum import Enum
18	from logging import Logger
19	from pydantic import BaseModel, Field
20	from typing import Any, Callable, Optional, ParamSpec, TypeVar
21	from mcp_server_unitycatalog.utils import dump_json
22	
23	
24	class When(str, Enum):
25	    """Specifies when logging was performed in the `log` decorator.
26	
27	    Attributes:
28	        BEFORE: Log before the function is called.
29	        AFTER: Log after the function has returned successfully.
30	        EXCEPTION: Log when an exception is raised during execution.
31	    """
32	
33	    BEFORE = "before"
34	    AFTER = "after"
35	    EXCEPTION = "exception"
36	
37	
38	class Log(BaseModel):
39	    """Represents a structured log entry for function calls.
40	
41	    This model captures details about function execution, including
42	    its arguments, results, and any exceptions that may occur.
43	    """
44	
45	    id: str = Field(
46	        description="Unique identifier for the log entry.",
47	    )
48	    when: When = Field(
49	        description="Indicates when the log was generated (e.g., before, after, or on exception).",
50	    )
51	    name: str = Field(
52	        description="Name of the logged function.",
53	    )
54	    args: Optional[tuple] = Field(
55	        default=None,
56	        description="Positional arguments passed to the function.",
57	    )
58	    kwargs: Optional[dict] = Field(
59	        default=None,
60	        description="Keyword arguments passed to the function.",
61	    )
62	    result: Optional[Any] = Field(
63	        default=None,
64	        description="Return value of the function (if applicable).",
65	    )
66	    exception: Optional[str] = Field(
67	        default=None,
68	        description="Exception raised during function execution (if any).",
69	    )
70	    logged_at: int = Field(
71	        description="Timestamp (epoch time in seconds) when the log was created.",
72	    )
73	
74	
75	# `_Params` represents the parameter types of the function passed to `log`.
76	_Params = ParamSpec("_Params")
77	# `_ReturnType` represents the return type of the function passed to `log`.
78	_ReturnType = TypeVar("_ReturnType")
79	
80	
81	def observe(
82	    by: Logger,
83	    args: Optional[list[int]] = None,
84	    kwargs: Optional[list[str]] = None,
85	):
86	    """A decorator for logging function execution details.
87	
88	    This decorator logs function calls before execution, after execution,
89	    and upon exceptions using a structured log format.
90	
91	    Args:
92	        by (Logger): The logger instance to be used for logging.
93	        args (Optional[list[int]]): Indices of positional arguments to log.
94	            If None, all positional arguments are logged.
95	        kwargs (Optional[list[str]]): Keys of keyword arguments to log.
96	            If None, all keyword arguments are logged.
97	
98	    Returns:
99	        Callable: A decorated function with logging behavior.
100	
101	    Logs:
102	        - BEFORE: Logs the function name, arguments, and timestamp before execution.
103	        - AFTER: Logs the function name, return value, and timestamp after execution.
104	        - EXCEPTION: Logs the function name, exception details, and timestamp if an exception occurs.
105	    """
106	
107	    def decorator(
108	        func: Callable[_Params, _ReturnType],
109	    ) -> Callable[_Params, _ReturnType]:
110	        @functools.wraps(func)
111	        def wrapper(*_args: _Params.args, **_kwargs: _Params.kwargs):
112	            id = str(uuid.uuid4())
113	            logger = by.getChild(func.__name__)
114	            before = Log(
115	                id=id,
116	                when=When.BEFORE,
117	                name=func.__name__,
118	                args=_args if args is None else tuple(_args[i] for i in args),
119	                kwargs=_kwargs if kwargs is None else {k: _kwargs[k] for k in kwargs},
120	                logged_at=time.time_ns(),
121	            )
122	            logger.info(dump_json(before))
123	            try:
124	                result = func(*_args, **_kwargs)
125	                after = Log(
126	                    id=id,
127	                    when=When.AFTER,
128	                    name=func.__name__,
129	                    result=result,
130	                    logged_at=time.time_ns(),
131	                )
132	                logger.info(dump_json(after))
133	            except Exception as e:
134	                exception = Log(
135	                    id=id,
136	                    when=When.EXCEPTION,
137	                    name=func.__name__,
138	                    exception=str(e),
139	                    logged_at=time.time_ns(),
140	                )
141	                logger.info(dump_json(exception))
142	                raise e
143	            return result
144	
145	        return wrapper
146	
147	    return decorator
148	

