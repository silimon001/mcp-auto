1	[build-system]
2	requires = ["hatchling"]
3	build-backend = "hatchling.build"
4	
5	[project]
6	name = "applemusic-mcp"
7	version = "0.11.0"
8	description = "MCP server for Apple Music - playlist management, playback control (macOS), and library access"
9	readme = "README.md"
10	license = "MIT"
11	requires-python = ">=3.10"
12	authors = [
13	    { name = "Eric Pheterson" }
14	]
15	keywords = ["mcp", "apple-music", "musickit", "playlist", "claude"]
16	classifiers = [
17	    "Development Status :: 4 - Beta",
18	    "Environment :: Console",
19	    "Intended Audience :: Developers",
20	    "License :: OSI Approved :: MIT License",
21	    "Operating System :: MacOS",
22	    "Operating System :: Microsoft :: Windows",
23	    "Operating System :: POSIX :: Linux",
24	    "Programming Language :: Python :: 3",
25	    "Programming Language :: Python :: 3.10",
26	    "Programming Language :: Python :: 3.11",
27	    "Programming Language :: Python :: 3.12",
28	    "Programming Language :: Python :: 3.13",
29	    "Topic :: Multimedia :: Sound/Audio",
30	]
31	
32	dependencies = [
33	    "mcp>=1.0.0",
34	    "pyjwt[crypto]>=2.8.0",
35	    "requests>=2.31.0",
36	    "cryptography>=41.0.0",
37	]
38	
39	[project.optional-dependencies]
40	dev = [
41	    "pytest>=7.0.0",
42	    "pytest-mock>=3.0.0",
43	    "pytest-xdist>=3.0.0",  # parallel test execution: pytest -n auto
44	    "responses>=0.23.0",
45	    "black>=23.0.0",
46	    "ruff>=0.1.0",
47	]
48	
49	[project.scripts]
50	applemusic-mcp = "applemusic_mcp.cli:main"
51	
52	[project.urls]
53	Homepage = "https://github.com/epheterson/applemusic-mcp"
54	Repository = "https://github.com/epheterson/applemusic-mcp"
55	Issues = "https://github.com/epheterson/applemusic-mcp/issues"
56	
57	[tool.hatch.build.targets.wheel]
58	packages = ["src/applemusic_mcp"]
59	
60	[tool.black]
61	line-length = 100
62	target-version = ["py310"]
63	
64	[tool.ruff]
65	line-length = 100
66	select = ["E", "F", "I", "W"]
67	
68	[tool.pytest.ini_options]
69	markers = [
70	    "slow: marks tests as slow (live AppleScript / Music.app I/O); deselect with '-m \"not slow\"'",
71	    "ui: marks tests that drive Music.app UI automation; require TEST_UI=1 + visible Music.app",
72	]
73	# Default: skip slow + ui tests unless explicitly opted in. Local pre-commit
74	# runs the fast subset; CI and `make test-all` run everything.
75	addopts = "-m 'not slow and not ui'"
76	

