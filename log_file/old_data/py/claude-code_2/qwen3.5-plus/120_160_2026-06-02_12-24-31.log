37	    def _initialize_model(self):
38	        """Initialize the HuggingFace model"""
39	        if not HF_AVAILABLE:
40	            logger.warning("HuggingFace transformers not available. Using rule-based fallback.")
41	            return
42	
43	        # Default disabled to avoid model downloads in low-connectivity environments.
44	        enable_hf = os.getenv("ENABLE_HF_MODEL", "false").lower() in {"1", "true", "yes", "on"}
45	        if not enable_hf:
46	            logger.info("ENABLE_HF_MODEL is disabled. Using rule-based SQL generation.")
47	            return
48	
49	        # Default true to avoid network fetches unless explicitly allowed.
50	        local_files_only = os.getenv("HF_LOCAL_FILES_ONLY", "true").lower() in {"1", "true", "yes", "on"}
51	        cache_dir = os.getenv("HF_MODEL_CACHE_DIR") or None
52	
53	        try:
54	            self.tokenizer = AutoTokenizer.from_pretrained(
55	                self.model_name,
56	                local_files_only=local_files_only,
57	                cache_dir=cache_dir,
58	            )
59	            self.model = AutoModelForSeq2SeqLM.from_pretrained(
60	                self.model_name,
61	                local_files_only=local_files_only,
62	                cache_dir=cache_dir,
63	            )
64	            self.pipeline = pipeline(
65	                "text2text-generation",
66	                model=self.model,
67	                tokenizer=self.tokenizer,
68	            )
69	            logger.info("HuggingFace text2sql model loaded: %s", self.model_name)
70	        except Exception as e:
71	            self.model = None
72	            self.tokenizer = None
73	            self.pipeline = None
74	            logger.warning("Failed to load HuggingFace model (%s). Falling back to rule-based SQL.", e)
75	            return
