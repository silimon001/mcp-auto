319	async def shutdown(loop, server):
320	    """Handle graceful shutdown."""
321	    logger.info("Shutdown signal received")
322	
323	    # Give pending tasks a chance to complete
324	    await asyncio.sleep(0.2)
325	
326	    # Perform cleanup
327	    await server.cleanup()
328	
329	    # Cancel all running tasks
330	    tasks = [t for t in asyncio.all_tasks(loop) if t is not asyncio.current_task()]
331	    if tasks:
332	        logger.info(f"Cancelling {len(tasks)} pending tasks")
333	        for task in tasks:
334	            task.cancel()
335	
336	        # Wait for tasks to cancel with a timeout
337	        try:
338	            await asyncio.wait_for(
339	                asyncio.gather(*tasks, return_exceptions=True),
340	                timeout=3.0,  # Increased timeout
341	            )
342	        except asyncio.TimeoutError:
343	            logger.warning("Some tasks did not cancel within the timeout period")
344	        except Exception as e:
345	            logger.warning(f"Error during task cancellation: {e}")
346	
347	    # Stop the loop
348	    loop.stop()
