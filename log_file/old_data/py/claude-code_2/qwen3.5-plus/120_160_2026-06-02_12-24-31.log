77	    def _create_table_context(self, table_schemas: Dict[str, List[Dict[str, Any]]]) -> str:
78	        """Create table context string for the model"""
79	        context_parts = []
80	        
81	        for table_name, columns in table_schemas.items():
82	            column_info = []
83	            for col in columns:
84	                col_str = f"{col['column_name']} {col['data_type']}"
85	                if not col['is_nullable']:
86	                    col_str += " NOT NULL"
87	                column_info.append(col_str)
88	            
89	            context_parts.append(f"Table {table_name}: {', '.join(column_info)}")
90	        
91	        return " | ".join(context_parts)
92	    
93	    def _generate_with_pipeline(self, prompt: str) -> str:
94	        """Generate SQL using the pipeline"""
95	        try:
96	            result = self.pipeline(prompt, max_length=512, num_return_sequences=1)
97	            return result[0]['generated_text'].strip()
98	        except Exception as e:
99	            logger.error(f"Error generating with pipeline: {e}")
100	            raise
