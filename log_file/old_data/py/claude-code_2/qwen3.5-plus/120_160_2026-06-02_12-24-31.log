290	def summarize_device_profile(profile: Dict[str, Any]) -> Dict[str, Any]:
291	    capability_profile = profile["capability_profile"]
292	    summary_controls = []
293	    for capability_name, target in capability_profile.get("controls", {}).items():
294	        summary_controls.append(
295	            {
296	                "capability": capability_name,
297	                "kind": target.get("kind"),
298	                "name": target.get("name"),
299	                "readable": target.get("readable"),
300	                "writable": target.get("writable"),
301	            }
302	        )
303	
304	    summary_supported_operations = [
305	        {
306	            "operation": item["operation"],
307	            "enabled": item["enabled"],
308	            "preferred_tool": item["preferred_tool"],
309	        }
310	        for item in profile.get("supported_operations", [])
311	        if item.get("enabled")
312	    ]
313	
314	    mapping_report = profile.get("mapping_report", {})
315	    return {
316	        "primary_domain": capability_profile.get("primary_domain"),
317	        "device_domains": capability_profile.get("device_domains", []),
318	        "capability_families": capability_profile.get("capability_families", []),
319	        "controls": summary_controls,
320	        "supported_operations": summary_supported_operations,
321	        "state": profile.get("state", {}),
322	        "state_summary": build_state_summary(profile.get("state", {})),
323	        "mapping_summary": {
324	            "mapped_property_count": mapping_report.get("mapped_property_count", 0),
325	            "unmapped_property_count": mapping_report.get("unmapped_property_count", 0),
326	            "mapped_action_count": mapping_report.get("mapped_action_count", 0),
327	            "unmapped_action_count": mapping_report.get("unmapped_action_count", 0),
328	            "coverage": mapping_report.get("coverage", {}),
329	        },
330	        "profile_driven_controls": {
331	            "generic_operations": profile.get("profile_driven_schema", {}).get("generic_operations", {}),
332	            "writable_properties": [
333	                {
334	                    "name": item.get("name"),
335	                    "description": item.get("description"),
336	                    "type": item.get("type"),
337	                    "range": item.get("range"),
338	                    "value_list": item.get("value_list"),
339	                }
340	                for item in profile.get("profile_driven_schema", {}).get("writable_properties", [])
341	            ],
342	            "actions": [
343	                {
344	                    "name": item.get("name"),
345	                    "description": item.get("description"),
346	                }
347	                for item in profile.get("profile_driven_schema", {}).get("actions", [])
348	            ],
349	        },
350	        "device_resource": profile.get("device_resource", {}),
351	    }
352	
