1497	        return build_result(False, "Adapter not initialized")
1498	
1499	    try:
1500	        await ensure_connected(adapter)
1501	        device = await resolve_device(
1502	            adapter,
1503	            device_name=device_name,
1504	            device_id=device_id,
1505	            room=room,
1506	            home=home,
1507	            refresh=refresh,
1508	        )
1509	        before_profile = await get_device_profile(adapter, device["device_id"])
1510	        execution = await execute_operation(
1511	            adapter,
1512	            device["raw"],
1513	            device["device_id"],
1514	            operation=operation,
1515	            value=value,
1516	            property_name=property_name,
1517	            action_name=action_name,
1518	        )
1519	        after_profile = await get_device_profile(adapter, device["device_id"])
1520	        outcome = summarize_control_outcome(operation, before_profile["state"], after_profile["state"])
1521	        return build_result(
1522	            True,
1523	            f"Executed {operation} on {device['name']}",
1524	            device={k: v for k, v in device.items() if k != "raw"},
1525	            execution=execution,
1526	            previous_state=before_profile["state"],
1527	            current_state=after_profile["state"],
1528	            state=after_profile["state"],
1529	            outcome=outcome,
1530	            assistant_summary=build_control_assistant_summary(device["name"], operation, outcome),
1531	        )
1532	    except Exception as exc:
1533	        logger.error(f"Failed to control device: {exc}")
1534	        return build_error_result(exc)
