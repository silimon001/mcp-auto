102	    def _generate_with_model(self, prompt: str) -> str:
103	        """Generate SQL using model directly"""
104	        try:
105	            inputs = self.tokenizer.encode(prompt, return_tensors="pt", max_length=512, truncation=True)
106	            
107	            with self.tokenizer.as_target_tokenizer():
108	                outputs = self.model.generate(
109	                    inputs,
110	                    max_length=150,
111	                    num_beams=4,
112	                    num_return_sequences=1,
113	                    temperature=0.7,
114	                    do_sample=False,
115	                    early_stopping=True
116	                )
117	            
118	            sql = self.tokenizer.decode(outputs[0], skip_special_tokens=True)
119	            return sql.strip()
120	        except Exception as e:
121	            logger.error(f"Error generating with model: {e}")
122	            raise
