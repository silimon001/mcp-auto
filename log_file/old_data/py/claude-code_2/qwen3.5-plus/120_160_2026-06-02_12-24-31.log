780	def find_profile_control_match(query: str, profile: Dict[str, Any]) -> Dict[str, Any] | None:
781	    lowered_query = query.strip().lower()
782	    if not lowered_query:
783	        return None
784	
785	    profile_driven = profile.get("profile_driven_schema", {})
786	    writable_properties = profile_driven.get("writable_properties", [])
787	    actions = profile_driven.get("actions", [])
788	
789	    def score_match(item: Dict[str, Any]) -> int:
790	        score = 0
791	        for term in item.get("matching_terms", []):
792	            normalized_term = str(term).strip().lower()
793	            if not normalized_term:
794	                continue
795	            if normalized_term in lowered_query:
796	                score = max(score, len(normalized_term))
797	        return score
798	
799	    best_property = None
800	    best_property_score = 0
801	    for item in writable_properties:
802	        score = score_match(item)
803	        if score > best_property_score:
804	            best_property = item
805	            best_property_score = score
806	
807	    best_action = None
808	    best_action_score = 0
809	    for item in actions:
810	        score = score_match(item)
811	        if score > best_action_score:
812	            best_action = item
813	            best_action_score = score
814	
815	    if best_property_score <= 0 and best_action_score <= 0:
816	        return None
817	
818	    if best_property_score >= best_action_score and best_property:
819	        return {
820	            "kind": "property",
821	            "name": best_property.get("name"),
822	            "description": best_property.get("description"),
823	            "type": best_property.get("type"),
824	            "range": best_property.get("range"),
825	            "value_list": best_property.get("value_list"),
826	        }
827	
828	    if best_action:
829	        return {
830	            "kind": "action",
831	            "name": best_action.get("name"),
832	            "description": best_action.get("description"),
833	        }
834	    return None
835	
