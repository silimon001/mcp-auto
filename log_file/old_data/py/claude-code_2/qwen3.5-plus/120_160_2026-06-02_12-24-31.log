1849	            })
1850	        
1851	        await wikijs.authenticate()
1852	        
1853	        # Get all pages to find hierarchy
1854	        all_pages_query = """
1855	        query {
1856	            pages {
1857	                list {
1858	                    id
1859	                    title
1860	                    path
1861	                }
1862	            }
1863	        }
1864	        """
1865	        
