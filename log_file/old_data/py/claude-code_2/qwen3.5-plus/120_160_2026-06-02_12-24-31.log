20	from ppt_translator.pricing import estimate_cost, estimate_tokens
21	
22	
23	def _resolve_glossary_for_mcp(glossary_file: Optional[str], target_language: str):
24	    """Resolve glossary (explicit or auto-discover ./glossary.yaml) for MCP tools."""
25	    path = glossary_file
26	    if not path:
27	        default = find_default_glossary()
28	        if default is not None:
29	            path = str(default)
30	    glossary_map = load_glossary(path) if path else {}
31	    return get_glossary_for_language(glossary_map, target_language)
32	
33	
34	def _dry_run_report(translator: PowerPointTranslator, input_path: Path,
35	                    target_language: str, model_id: str,
36	                    slide_numbers: Optional[list] = None,
37	                    detect_source: bool = True) -> str:
38	    stats = translator.collect_all_texts(str(input_path), slide_numbers=slide_numbers,
39	                                         detect_source=detect_source)
40	    src_lang = stats.get('source_language') or 'en'
41	    tokens_in = estimate_tokens(stats['total_chars'], src_lang)
42	    tokens_out = estimate_tokens(stats['total_chars'], target_language)
43	    cost = estimate_cost(tokens_in, tokens_out, model_id)
44	    cost_line = f"${cost:.4f}" if cost > 0 else "(pricing unavailable for this model)"
45	    same_lang = src_lang and src_lang.split('-')[0].lower() == target_language.split('-')[0].lower()
46	    body = (
47	        f"📊 Dry-Run Report: {input_path} → {target_language}\n"
48	        f"  Source language:     {stats.get('source_language') or '(not detected)'}\n"
49	        f"  Total slides:        {stats['slide_count']}\n"
50	        f"  Translatable items:  {stats['translatable_items']}\n"
51	        f"  Total characters:    {stats['total_chars']:,}\n"
52	    )
53	    if same_lang:
54	        body += (f"\n⏭️  Source '{src_lang}' already matches target '{target_language}'. "
55	                 "No API calls would be made.\n")
56	    else:
57	        body += (
58	            f"\n💰 Cost Estimate ({model_id}):\n"
59	            f"  Input tokens (est.):  ~{tokens_in:,}\n"
60	            f"  Output tokens (est.): ~{tokens_out:,}\n"
61	            f"  Estimated cost:       {cost_line}\n"
62	        )
63	    body += "\nℹ️  Run with dry_run=False to perform actual translation."
64	    return body
65	
66	# Configure logging
67	logging.basicConfig(level=logging.INFO)
68	logger = logging.getLogger(__name__)
69	
70	# Initialize FastMCP server
71	mcp = FastMCP("PowerPoint Translator")
72	
73	def validate_input_path(input_file: str) -> tuple[Path, str]:
74	    """
75	    Validate input file path, handling both absolute and relative paths.
76	    
77	    Args:
78	        input_file: Input file path (absolute or relative)
79	    
80	    Returns:
81	        Tuple of (validated_path, error_message). If error_message is not empty, path validation failed.
82	    """
83	    input_path = Path(input_file)
84	    
85	    # If it's a relative path, try to resolve it from current working directory
86	    if not input_path.is_absolute():
87	        # Try current working directory first
88	        cwd_path = Path.cwd() / input_file
89	        if cwd_path.exists():
90	            input_path = cwd_path
91	        else:
92	            # Try the script's directory as fallback
93	            script_dir = Path(__file__).parent
94	            script_path = script_dir / input_file
95	            if script_path.exists():
96	                input_path = script_path
97	    
98	    if not input_path.exists():
99	        # Provide more helpful error message with current working directory info
100	        cwd = Path.cwd()
101	        script_dir = Path(__file__).parent
102	        error_msg = f"""❌ Error: File not found: {input_file}
103	📁 Current working directory: {cwd}
104	📁 Script directory: {script_dir}
105	💡 Tried paths:
106	   • {input_file} (as provided)
107	   • {cwd / input_file} (from current directory)
108	   • {script_dir / input_file} (from script directory)
109	💡 Try using absolute path or ensure file is in one of these directories"""
110	        return input_path, error_msg
111	    
112	    if not input_path.suffix.lower() == '.pptx':
113	        return input_path, f"❌ Error: File must be a PowerPoint (.pptx) file: {input_file}"
114	    
115	    return input_path, ""
116	
117	@mcp.tool()
118	def translate_powerpoint(
119	    input_file: str,
120	    target_language: str = Config.DEFAULT_TARGET_LANGUAGE,
121	    output_file: Optional[str] = None,
122	    model_id: str = Config.DEFAULT_MODEL_ID,
123	    enable_polishing: bool = True,
124	    glossary_file: Optional[str] = None,
125	    cache_backend: str = "sqlite",
126	    dry_run: bool = False,
127	    translate_charts: bool = True,
128	    source_language: Optional[str] = None,
129	    auto_detect_source: bool = True,
130	) -> str:
131	    """
132	    Translate a PowerPoint presentation to the specified language.
133	
134	    Args:
135	        input_file: Path to the input PowerPoint file (.pptx)
136	        target_language: Target language code (e.g., 'ko', 'ja', 'es', 'fr', 'de')
137	        output_file: Path to save the translated file (optional, auto-generated if not provided)
138	        model_id: AWS Bedrock model ID to use for translation
139	        enable_polishing: Enable natural language polishing for more fluent translation
140	        glossary_file: Path to a glossary YAML file (defaults to ./glossary.yaml if present)
141	        cache_backend: Translation cache backend: 'sqlite' (default), 'memory', or 'none'
142	        dry_run: If True, estimate cost without translating or saving the output file
143	        translate_charts: If True, translate chart titles, axes, categories, and series names
144	
145	    Returns:
146	        Success message with translation details (or dry-run report if dry_run=True)
147	    """
148	    try:
149	        # Validate input file using helper function
150	        input_path, error_msg = validate_input_path(input_file)
151	        if error_msg:
152	            return error_msg
153	
154	        # Validate target language
155	        if target_language not in Config.LANGUAGE_MAP:
156	            available_langs = ', '.join(Config.LANGUAGE_MAP.keys())
157	            return f"❌ Error: Unsupported language '{target_language}'. Available: {available_langs}"
158	
159	        glossary = _resolve_glossary_for_mcp(glossary_file, target_language)
160	
161	        # Dry-run path: collect stats without calling Bedrock.
162	        if dry_run:
163	            translator = PowerPointTranslator(model_id, enable_polishing,
164	                                              glossary=glossary, translate_charts=translate_charts,
165	                                              source_language=source_language,
166	                                              auto_detect_source=auto_detect_source)
167	            return _dry_run_report(translator, input_path, target_language, model_id,
168	                                   detect_source=auto_detect_source)
169	
170	        # Generate output filename if not provided
171	        if not output_file:
172	            output_file = str(input_path.parent / f"{input_path.stem}_translated_{target_language}{input_path.suffix}")
173	
174	        logger.info(f"Starting translation: {input_path} -> {target_language}")
175	        with build_cache(cache_backend) as cache:
176	            translator = PowerPointTranslator(model_id, enable_polishing,
177	                                              cache=cache, glossary=glossary,
178	                                              translate_charts=translate_charts,
179	                                              source_language=source_language,
180	                                              auto_detect_source=auto_detect_source)
181	            result = translator.translate_presentation(str(input_path), output_file, target_language)
182	        
183	        # Apply post-processing if enabled
184	        config = Config()
185	        post_processing_applied = False
186	        if config.get_bool('ENABLE_TEXT_AUTOFIT', True):
187	            try:
188	                verbose = config.get_bool('DEBUG', False)
189	                post_processor = PowerPointPostProcessor(config, verbose=verbose)
190	                # Overwrite the original output file instead of creating a new one
191	                final_output = post_processor.process_presentation(output_file, output_file)
192	                post_processing_applied = True
193	                logger.info("Post-processing applied: Text auto-fitting enabled")
194	            except Exception as e:
195	                logger.warning(f"Post-processing failed: {e}")
196	        
197	        # Format success message
198	        lang_name = Config.LANGUAGE_MAP.get(target_language, target_language)
199	        translation_mode = "Natural/Polished" if enable_polishing else "Literal"
200	        post_processing_status = "✅ Applied" if post_processing_applied else "⚠️ Skipped"
201	        
202	        return f"""✅ PowerPoint translation completed successfully!
203	
204	📁 Input file: {input_path}
205	📁 Output file: {output_file}
206	🌐 Target language: {target_language} ({lang_name})
207	🎨 Translation mode: {translation_mode}
208	🤖 Model: {model_id}
209	📝 Translated texts: {result.translated_count}
210	📋 Translated notes: {result.translated_notes_count}
211	📊 Total shapes processed: {result.total_shapes}
212	🔧 Post-processing: {post_processing_status}
213	
214	💡 Translation features used:
215	• Intelligent batch processing for efficiency
216	• Context-aware translation for coherence
217	• Unified text frame processing
218	• Formatting preservation
219	• {'Natural language polishing for fluent output' if enable_polishing else 'Literal translation for accuracy'}"""
220	        
221	    except Exception as e:
222	        logger.error(f"Translation failed: {str(e)}")
223	        return f"❌ Translation failed: {str(e)}"
