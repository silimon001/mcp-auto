388	def build_home_overview(
389	    homes: List[Dict[str, Any]],
390	    devices: List[Dict[str, Any]],
391	    home_name: str = "",
392	    room: str = "",
393	) -> Dict[str, Any]:
394	    home_name_lower = home_name.strip().lower()
395	    room_lower = room.strip().lower()
396	    normalized_homes = [normalize_home(home) for home in homes]
397	    normalized_devices = [normalize_device_summary(device) for device in devices]
398	
399	    if home_name_lower:
400	        normalized_homes = [home for home in normalized_homes if home_name_lower in str(home.get("name", "")).lower()]
401	        normalized_devices = [device for device in normalized_devices if home_name_lower in str(device.get("home_name", "")).lower()]
402	
403	    overview_homes = []
404	    for home in normalized_homes:
405	        rooms = []
406	        for room_info in home.get("rooms", []):
407	            room_devices = [
408	                device for device in normalized_devices
409	                if str(device.get("home_id", home.get("home_id"))) == str(home.get("home_id"))
410	                and str(device.get("room_name", "") or "") == str(room_info.get("name", "") or "")
411	            ]
412	            if room_lower and room_lower not in str(room_info.get("name", "")).lower():
413	                continue
414	            rooms.append(
415	                {
416	                    "room_id": room_info.get("room_id"),
417	                    "name": room_info.get("name"),
418	                    "device_count": len(room_devices),
419	                    "devices": room_devices[:12],
420	                }
421	            )
422	
423	        home_devices = [
424	            device for device in normalized_devices
425	            if str(device.get("home_name", "") or "") == str(home.get("name", "") or "")
426	        ]
427	        overview_homes.append(
428	            {
429	                "home_id": home.get("home_id"),
430	                "name": home.get("name"),
431	                "room_count": len(rooms),
432	                "device_count": len(home_devices),
433	                "rooms": rooms,
434	            }
435	        )
436	
437	    return {
438	        "homes": overview_homes,
439	        "home_count": len(overview_homes),
440	        "device_count": len(normalized_devices),
441	        "assistant_summary": (
442	            f"已整理 {len(overview_homes)} 个家庭、{len(normalized_devices)} 台设备的房间视图。"
443	            "优先查看 rooms 和 devices 字段即可。"
444	        ),
445	        "next_steps": {
446	            "refresh_with": "refresh_devices",
447	            "inspect_device_with": "get_device_status",
448	            "control_with": "control_by_intent",
449	        },
450	    }
