147	    Useful for debugging and verifying server setup.
148	    """
149	    import json
150	    
151	    client = get_client()
152	    categories = get_requested_categories()
153	    
154	    info = {
155	        "server": SERVER_NAME,
156	        "version": SERVER_VERSION,
157	        "api_key_configured": client.has_api_key,
158	        "lazy_loading_enabled": is_lazy_loading_enabled(),
159	        "loaded_categories": categories,
160	        "tool_counts": {
161	            "accounts": 6 if "accounts" in categories else 0,
162	            "campaigns": 8 if "campaigns" in categories else 0,  # +2: delete_campaign, search_campaigns_by_contact
163	            "leads": 12 if "leads" in categories else 0,  # +1: delete_lead_list
164	            "emails": 6 if "emails" in categories else 0,  # +1: mark_thread_as_read
165	            "analytics": 3 if "analytics" in categories else 0,
166	            "background_jobs": 2 if "background_jobs" in categories else 0,
167	        },
168	        "total_tools": sum([
169	            6 if "accounts" in categories else 0,
170	            8 if "campaigns" in categories else 0,
171	            12 if "leads" in categories else 0,
172	            6 if "emails" in categories else 0,
173	            3 if "analytics" in categories else 0,
174	            2 if "background_jobs" in categories else 0,
175	        ]) + 1,  # +1 for get_server_info
176	        "rate_limit": {
