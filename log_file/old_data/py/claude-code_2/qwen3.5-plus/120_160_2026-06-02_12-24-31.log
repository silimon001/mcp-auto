231	    def _is_valid_sql(self, sql: str) -> bool:
232	        """Basic validation of generated SQL"""
233	        if not sql:
234	            return False
235	        
236	        sql_upper = sql.upper()
237	        
238	        # Must start with SELECT
239	        if not sql_upper.startswith('SELECT'):
240	            return False
241	        
242	        # Must contain FROM
243	        if 'FROM' not in sql_upper:
244	            return False
245	        
246	        # Should not contain dangerous operations
247	        dangerous = ['DROP', 'DELETE', 'INSERT', 'UPDATE', 'ALTER', 'CREATE', 'TRUNCATE']
248	        for op in dangerous:
249	            if op in sql_upper:
250	                return False
251	        
252	        return True

