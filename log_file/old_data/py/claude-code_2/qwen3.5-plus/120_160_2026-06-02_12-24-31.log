1	#!/usr/bin/env python3
2	"""
3	MCP Terminal Server
4	
5	This module implements a terminal control server using the Model Context Protocol (MCP).
6	It supports both standard input/output (stdio) and Server-Sent Events (SSE) transports.
7	"""
8	
9	import argparse
10	import asyncio
11	import logging
12	import platform
13	import signal
14	import sys
15	from enum import Enum
16	from typing import Optional
17	
18	from mcp.server.fastmcp import FastMCP
19	
20	from mcp_terminal.tools.file import FileTool
21	from mcp_terminal.tools.terminal import TerminalTool
22	
23	# Configure logging
24	logging.basicConfig(
25	    level=logging.INFO, format="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
26	)
27	logger = logging.getLogger("MCP:Terminal:Server")
28	
29	
30	class ServerMode(str, Enum):
31	    """Server transport modes."""
32	
33	    STDIO = "stdio"
34	    SSE = "sse"
35	
36	
37	class MCPTerminalServer:
38	    """
39	    MCP Terminal Server that registers and exposes terminal tools.
40	    """
41	
42	    def __init__(
43	        self,
44	        controller_type: Optional[str] = None,
45	        mode: ServerMode = ServerMode.STDIO,
46	        host: str = "127.0.0.1",
47	        port: int = 3000,
48	        log_level: str = "INFO",
49	        whitelist_file: Optional[str] = None,
50	        blacklist_file: Optional[str] = None,
51	        whitelist_mode: bool = False,
52	    ):
53	        """
54	        Initialize the MCP Terminal Server.
55	
56	        Args:
57	            controller_type: Type of terminal controller to use ("iterm", "applescript", "subprocess")
58	            mode: Server transport mode (stdio or sse)
59	            host: Host to bind the server to (for SSE mode)
60	            port: Port to bind the server to (for SSE mode)
61	            log_level: Logging level
62	            whitelist_file: Path to command whitelist file
63	            blacklist_file: Path to command blacklist file
64	            whitelist_mode: If True, only whitelisted commands are allowed
65	        """
66	        self.controller_type = controller_type
67	        self.mode = mode
68	        self.host = host
69	        self.port = port
70	        self.whitelist_file = whitelist_file
71	        self.blacklist_file = blacklist_file
72	        self.whitelist_mode = whitelist_mode
73	
74	        # Set up logging
75	        logging.getLogger().setLevel(getattr(logging, log_level))
76	
77	        # Create MCP server
78	        self.mcp = FastMCP("mcp-terminal", host=host, port=port, log_level=log_level)
79	
80	        self.tools = {}
81	        self.tools_registered = False
82	
83	    def register_tools(self) -> None:
84	        """
85	        Register all tools with the MCP server.
86	        """
87	        if self.tools_registered:
88	            return
89	
90	        logger.info("Registering terminal tool with MCP server")
91	
92	        try:
93	            # Create and register the terminal tool
94	            terminal_tool = TerminalTool(
95	                self.controller_type,
96	                whitelist_file=self.whitelist_file,
97	                blacklist_file=self.blacklist_file,
98	                whitelist_mode=self.whitelist_mode,
99	            )
100	            file_tool = FileTool()
101	            terminal_tool.register_mcp(self.mcp)
102	            file_tool.register_mcp(self.mcp)
103	            self.tools["terminal"] = terminal_tool
104	            self.tools["file"] = file_tool
105	
106	            self.tools_registered = True
107	            logger.info("Terminal tool registered with MCP server")
108	        except Exception as e:
109	            logger.error(f"Failed to register terminal tool: {str(e)}", exc_info=True)
110	            raise
111	
112	    async def start(self) -> None:
113	        """
114	        Start the MCP Terminal Server.
115	        """
116	        # Register all tools
117	        self.register_tools()
118	
119	        # Start the server using the appropriate transport
120	        if self.mode == ServerMode.SSE:
121	            logger.info(
122	                f"Starting MCP Terminal Server in SSE mode on {self.host}:{self.port}"
123	            )
124	            await self.mcp.run_sse_async()
125	        else:  # STDIO mode
126	            logger.info("Starting MCP Terminal Server in stdio mode")
127	            await self.mcp.run_stdio_async()
128	
129	    async def cleanup(self) -> None:
130	        """
131	        Clean up resources before shutting down.
132	        """
133	        logger.info("Starting cleanup process")
134	
135	        # First ensure MCP resources are properly cleaned up
136	        if hasattr(self.mcp, "_mcp_server") and hasattr(
137	            self.mcp._mcp_server, "_task_group"
138	        ):
139	            logger.info("Ensuring MCP task groups are properly closed")
140	            try:
141	                # Give in-flight requests a chance to complete
142	                await asyncio.sleep(0.1)
143	            except Exception as e:
144	                logger.warning(f"Error during MCP cleanup delay: {e}")
145	
146	        # Then clean up tool controllers
147	        for tool_name, tool in self.tools.items():
148	            if hasattr(tool, "controller") and hasattr(tool.controller, "cleanup"):
149	                logger.info(f"Cleaning up {tool_name} controller")
150	                try:
151	                    await tool.controller.cleanup()
152	                except Exception as e:
153	                    logger.warning(f"Error cleaning up {tool_name} controller: {e}")
154	
155	        logger.info("Cleanup process completed")
156	
157	
158	def main() -> None:
159	    """
160	    Main entry point for the MCP Terminal Server.
161	    """
162	    # Parse command line arguments
163	    parser = argparse.ArgumentParser(description="MCP Terminal Server")
164	
165	    # Terminal controller options
166	    controller_group = parser.add_argument_group("Terminal Controller Options")
167	    controller_group.add_argument(
168	        "--controller",
169	        "-c",
170	        choices=["auto", "iterm", "applescript", "subprocess"],
171	        default="auto",
172	        help="Terminal controller to use (default: auto-detect)",
173	    )
174	
175	    # Server mode options
176	    server_group = parser.add_argument_group("Server Options")
177	    server_group.add_argument(
178	        "--mode",
179	        "-m",
180	        choices=[mode.value for mode in ServerMode],
181	        default=ServerMode.STDIO.value,
182	        help=f"Server mode (default: {ServerMode.STDIO.value})",
183	    )
184	    server_group.add_argument(
185	        "--host",
186	        default="127.0.0.1",
187	        help="Host to bind the server to in SSE mode (default: 127.0.0.1)",
188	    )
189	    server_group.add_argument(
190	        "--port",
191	        "-p",
192	        type=int,
193	        default=3000,
194	        help="Port to bind the server to in SSE mode (default: 3000)",
195	    )
196	
197	    # Command filtering options
198	    security_group = parser.add_argument_group("Security Options")
199	    security_group.add_argument(
200	        "--whitelist-file",
201	        type=str,
202	        help="Path to whitelist file with allowed commands (one per line)",
203	    )
204	    security_group.add_argument(
205	        "--blacklist-file",
206	        type=str,
207	        help="Path to blacklist file with blocked commands (one per line)",
208	    )
209	    security_group.add_argument(
210	        "--whitelist-mode",
211	        action="store_true",
212	        help="Enable whitelist mode (only allow commands in whitelist)",
213	    )
214	
215	    # Logging options
216	    logging_group = parser.add_argument_group("Logging Options")
217	    logging_group.add_argument(
218	        "--log-level",
219	        "-l",
220	        choices=["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
221	        default="INFO",
222	        help="Logging level (default: INFO)",
223	    )
224	
225	    args = parser.parse_args()
226	
227	    # Determine controller type
228	    controller_type = None if args.controller == "auto" else args.controller
229	
230	    # Adjust controller based on platform
231	    if controller_type in ["iterm", "applescript"] and platform.system() != "Darwin":
232	        logger.warning(
233	            f"{controller_type} controller not available on {platform.system()}. Falling back to subprocess."
234	        )
235	        controller_type = "subprocess"
236	
237	    # Create the server
238	    server = MCPTerminalServer(
239	        controller_type=controller_type,
240	        mode=args.mode,
241	        host=args.host,
242	        port=args.port,
243	        log_level=args.log_level,
244	        whitelist_file=args.whitelist_file,
245	        blacklist_file=args.blacklist_file,
246	        whitelist_mode=args.whitelist_mode,
247	    )
248	
249	    # Run the server
250	    loop = asyncio.get_event_loop()
251	    shutdown_in_progress = False
252	
253	    # Define a shutdown handler that ensures we only run shutdown once
254	    async def handle_shutdown():
255	        nonlocal shutdown_in_progress
256	        if shutdown_in_progress:
257	            logger.info("Shutdown already in progress, ignoring additional signal")
258	            return
259	
260	        shutdown_in_progress = True
261	        await shutdown(loop, server)
262	
263	    try:
264	        # Set up signal handlers for graceful shutdown
265	        if (
266	            sys.platform != "win32"
267	        ):  # Windows doesn't support SIGTERM/SIGINT handling in the same way
268	            for signal_name in ["SIGTERM", "SIGINT"]:
269	                loop.add_signal_handler(
270	                    getattr(signal, signal_name),
271	                    lambda: asyncio.create_task(handle_shutdown()),
272	                )
273	
274	        # Run the server
275	        loop.run_until_complete(server.start())
276	    except KeyboardInterrupt:
277	        logger.info("Received keyboard interrupt")
278	        # Handle KeyboardInterrupt manually by running the shutdown coroutine
279	        if not shutdown_in_progress:
280	            try:
281	                # Make sure we properly shut down even if interrupted
282	                loop.run_until_complete(handle_shutdown())
283	            except Exception as e:
284	                logger.error(f"Error during shutdown after keyboard interrupt: {e}")
285	    except Exception as e:
286	        logger.error(f"Error during server execution: {e}", exc_info=True)
287	    finally:
288	        logger.info("Server shutting down")
289	
290	        # Close the event loop
291	        try:
292	            # Gather any remaining tasks
293	            pending = asyncio.all_tasks(loop)
294	            if pending:
295	                # Cancel all remaining tasks
296	                for task in pending:
297	                    task.cancel()
298	
299	                # Use a separate try/except block to avoid suppressing the original exception
300	                try:
301	                    # Wait for a short time for tasks to cancel
302	                    loop.run_until_complete(asyncio.wait(pending, timeout=0.5))
303	                except (asyncio.CancelledError, RuntimeError):
304	                    # Ignore cancelled errors and "Event loop stopped before Future completed"
305	                    pass
306	        except Exception as e:
307	            logger.error(f"Error during final cleanup: {e}")
308	        finally:
309	            # Close the event loop
310	            try:
311	                loop.close()
312	            except Exception as e:
313	                logger.error(f"Error closing event loop: {e}")
314	
315	        # Exit with a success code
316	        sys.exit(0)
317	
