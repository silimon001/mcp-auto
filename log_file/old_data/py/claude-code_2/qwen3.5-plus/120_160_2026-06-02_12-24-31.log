172	    def _parse_where_equals(self, where_clause: str) -> Dict[str, Any]:
173	        """Parse a minimal SQL WHERE clause of key=value [AND key=value ...]."""
174	        clause = where_clause.strip()
175	        if not clause:
176	            return {}
177	
178	        filters: Dict[str, Any] = {}
179	        conditions = re.split(r"\s+AND\s+", clause, flags=re.IGNORECASE)
180	        for cond in conditions:
181	            match = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.+)$", cond.strip())
182	            if not match:
183	                raise ValueError(f"Unsupported WHERE condition for MongoDB: {cond}")
184	            key = match.group(1)
185	            value = self._parse_sql_like_literal(match.group(2).strip())
186	            filters[key] = value
187	        return filters
