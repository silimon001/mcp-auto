479	@mcp.tool()
480	def get_translation_help() -> str:
481	    """
482	    Get help information about using the PowerPoint translator.
483	    
484	    Returns:
485	        Help text with usage examples
486	    """
487	    return """📖 PowerPoint Translator Help
488	
489	🎯 Main Functions:
490	• translate_powerpoint() - Translate entire PowerPoint presentation
491	• translate_specific_slides() - Translate only specific slides
492	• batch_translate_powerpoint() - Translate all PowerPoint files in a folder
493	• get_slide_info() - Get presentation overview and slide previews
494	• get_slide_preview() - Get detailed preview of a specific slide
495	
496	📋 Required Parameters:
497	• input_file: Path to your .pptx file
498	• input_folder: Path to folder containing .pptx files (for batch)
499	
500	🔧 Optional Parameters:
501	• target_language: Language code (default: 'ko' for Korean)
502	• output_file/output_folder: Output path (auto-generated if not specified)
503	• model_id: Bedrock model (default: Claude Sonnet 4.6)
504	• enable_polishing: Natural translation vs literal (default: true)
505	• recursive: Process subfolders (default: true, for batch only)
506	• workers: Parallel workers (default: 4, for batch only)
507	
508	💡 Usage Examples:
509	
510	1. Get presentation information:
511	   get_slide_info("presentation.pptx")
512	
513	2. Preview specific slide:
514	   get_slide_preview("presentation.pptx", 3)
515	
516	3. Translate entire presentation:
517	   translate_powerpoint("presentation.pptx")
518	
519	4. Translate specific slides (individual):
520	   translate_specific_slides("slides.pptx", "1,3,5")
521	
522	5. Translate slide range:
523	   translate_specific_slides("slides.pptx", "2-4")
524	
525	6. Translate mixed (individual + range):
526	   translate_specific_slides("slides.pptx", "1,3-5,8")
527	
528	7. Batch translate folder (includes subfolders by default):
529	   batch_translate_powerpoint("presentations/")
530	
531	8. Batch translate top level only (disable recursion):
532	   batch_translate_powerpoint("presentations/", recursive=False)
533	
534	9. Batch translate to Spanish with custom output:
535	   batch_translate_powerpoint("input/", "es", "output/")
536	
537	10. Translate to Spanish with custom output:
538	    translate_specific_slides("slides.pptx", "1-3", "es", "spanish_slides.pptx")
539	
540	11. Literal translation (no polishing):
541	    translate_specific_slides("doc.pptx", "2,4", "ja", enable_polishing=False)
542	
543	🌐 Get supported languages:
544	   list_supported_languages()
545	
546	🤖 Get supported models:
547	   list_supported_models()
548	
549	⚙️ Configuration:
550	• AWS credentials must be configured (aws configure)
551	• Bedrock access required in your AWS account
552	• Supported file format: .pptx only
553	
554	📄 Slide Number Format:
555	• Individual slides: "1,3,5"
556	• Ranges: "2-4" (translates slides 2, 3, 4)
557	• Mixed: "1,3-5,8" (translates slides 1, 3, 4, 5, 8)
558	
559	📁 Batch Processing:
560	• Non-recursive: Only files in the specified folder
561	• Recursive: Files in all subfolders (like reInvent-2025/session1/, session2/, etc.)
562	• Preserves folder structure in output
563	• Parallel processing for efficiency"""
564	
565	
566	@mcp.tool()
567	def batch_translate_powerpoint(
568	    input_folder: str,
569	    target_language: str = Config.DEFAULT_TARGET_LANGUAGE,
570	    output_folder: Optional[str] = None,
571	    model_id: str = Config.DEFAULT_MODEL_ID,
572	    enable_polishing: bool = True,
573	    recursive: bool = True,
574	    workers: int = 4,
575	    glossary_file: Optional[str] = None,
576	    cache_backend: str = "sqlite",
577	    cache_path: Optional[str] = None,
578	    dry_run: bool = False,
579	    translate_charts: bool = True,
580	    source_language: Optional[str] = None,
581	    auto_detect_source: bool = True,
582	) -> str:
583	    """
584	    Translate all PowerPoint files in a folder (with optional recursive processing).
585	
586	    Args:
587	        input_folder: Path to the input folder containing PowerPoint files
588	        target_language: Target language code (e.g., 'ko', 'ja', 'es', 'fr', 'de')
589	        output_folder: Path to save translated files (optional, auto-generated if not provided)
590	        model_id: AWS Bedrock model ID to use for translation
591	        enable_polishing: Enable natural language polishing for more fluent translation
592	        recursive: Process subfolders recursively (default: True — set to False to limit to top level)
593	        workers: Number of parallel workers (default: 4)
594	        glossary_file: Path to a glossary YAML file (defaults to ./glossary.yaml if present)
595	        cache_backend: Translation cache backend: 'sqlite' (default), 'memory', or 'none'
596	        cache_path: SQLite cache path (ignored for memory/none backends)
597	        dry_run: If True, estimate aggregate cost without translating
598	        translate_charts: If True, translate chart titles/axes/categories/series
599	
600	    Returns:
601	        Success message with batch translation details
602	    """
603	    try:
604	        from concurrent.futures import ProcessPoolExecutor, as_completed
605	        # Reuse the module-level worker from the CLI so ProcessPoolExecutor can
606	        # pickle it — an inner function can't be pickled across fork/spawn.
607	        from ppt_translator.cli import _translate_single_file
608	
609	        input_path = Path(input_folder)
610	        if not input_path.exists() or not input_path.is_dir():
611	            return f"❌ Error: Input folder not found or not a directory: {input_folder}"
612	
613	        if target_language not in Config.LANGUAGE_MAP:
614	            available_langs = ', '.join(Config.LANGUAGE_MAP.keys())
615	            return f"❌ Error: Unsupported language '{target_language}'. Available: {available_langs}"
616	
617	        output_path = Path(output_folder) if output_folder else input_path / f"translated_{target_language}"
618	        output_path.mkdir(parents=True, exist_ok=True)
619	
620	        if recursive:
621	            ppt_files = list(input_path.rglob("*.pptx")) + list(input_path.rglob("*.ppt"))
622	        else:
623	            ppt_files = list(input_path.glob("*.pptx")) + list(input_path.glob("*.ppt"))
624	
625	        if not ppt_files:
626	            search_type = "recursively" if recursive else ""
627	            return f"❌ No PowerPoint files found {search_type} in {input_folder}"
628	
629	        # Resolve glossary once so every worker loads the same file.
630	        resolved_glossary_path = glossary_file
631	        if resolved_glossary_path is None:
632	            default = find_default_glossary()
633	            if default is not None:
634	                resolved_glossary_path = str(default)
635	
636	        if dry_run:
637	            glossary = _resolve_glossary_for_mcp(glossary_file, target_language)
638	            total_chars = 0
639	            total_items = 0
640	            translator = PowerPointTranslator(model_id, enable_polishing,
641	                                              glossary=glossary, translate_charts=translate_charts,
642	                                              source_language=source_language,
643	                                              auto_detect_source=auto_detect_source)
644	            for ppt_file in ppt_files:
645	                stats = translator.collect_all_texts(
646	                    str(ppt_file),
647	                    detect_source=auto_detect_source and translator.source_language is None,
648	                )
649	                total_chars += stats['total_chars']
650	                total_items += stats['translatable_items']
651	                if translator.source_language is None and stats.get('source_language'):
652	                    translator.source_language = stats['source_language']
653	                    translator.engine.source_language = stats['source_language']
654	            src_for_estimate = translator.source_language or source_language or 'en'
655	            tokens_in = estimate_tokens(total_chars, src_for_estimate)
656	            tokens_out = estimate_tokens(total_chars, target_language)
657	            cost = estimate_cost(tokens_in, tokens_out, model_id)
658	            cost_line = f"${cost:.4f}" if cost > 0 else "(pricing unavailable for this model)"
659	            return (
660	                f"📊 Batch Dry-Run Report\n"
661	                f"  Source language:     {translator.source_language or '(not detected)'}\n"
662	                f"  Files:               {len(ppt_files)}\n"
663	                f"  Translatable items:  {total_items}\n"
664	                f"  Total characters:    {total_chars:,}\n"
665	                f"  Input tokens (est.): ~{tokens_in:,}\n"
666	                f"  Output tokens (est.):~{tokens_out:,}\n"
667	                f"  Estimated cost:      {cost_line}\n"
668	            )
669	
670	        # Prepare tasks with relative path preservation
671	        tasks = []
672	        for ppt_file in ppt_files:
673	            relative_path = ppt_file.relative_to(input_path)
674	            output_file = output_path / relative_path.parent / f"{relative_path.stem}_{target_language}{relative_path.suffix}"
675	            output_file.parent.mkdir(parents=True, exist_ok=True)
676	            tasks.append((
677	                ppt_file, output_file, target_language, model_id, enable_polishing,
678	                cache_backend, cache_path or str(Path.home() / '.ppt-translator' / 'cache.db'),
679	                resolved_glossary_path, translate_charts,
680	                source_language, auto_detect_source,
681	            ))
682	
683	        success_count = 0
684	        failed_files = []
685	
686	        with ProcessPoolExecutor(max_workers=workers) as executor:
687	            futures = {executor.submit(_translate_single_file, task): task for task in tasks}
688	            for future in as_completed(futures):
689	                filename, output_name, result, error = future.result()
690	                if result:
691	                    success_count += 1
692	                else:
693	                    failed_files.append(f"{filename}: {error}" if error else filename)
694	        
695	        # Format results
696	        lang_name = Config.LANGUAGE_MAP.get(target_language, target_language)
697	        translation_mode = "Natural/Polished" if enable_polishing else "Literal"
698	        
699	        result_text = f"""✅ Batch PowerPoint translation completed!
700	
701	📁 Input folder: {input_path}
702	📁 Output folder: {output_path}
703	🔄 Recursive mode: {'ON' if recursive else 'OFF'}
704	🌐 Target language: {target_language} ({lang_name})
705	🎨 Translation mode: {translation_mode}
706	🤖 Model: {model_id}
707	⚡ Workers: {workers}
708	
709	📊 Results:
710	• Total files found: {len(ppt_files)}
711	• Successfully translated: {success_count}
712	• Failed: {len(failed_files)}"""
713	
714	        if failed_files:
715	            result_text += "\n\n❌ Failed files:\n"
716	            for failed in failed_files[:5]:  # Show first 5 failures
717	                result_text += f"• {failed}\n"
718	            if len(failed_files) > 5:
719	                result_text += f"... and {len(failed_files) - 5} more"
720	        
721	        return result_text
722	        
723	    except Exception as e:
724	        logger.error(f"Batch translation failed: {str(e)}")
725	        return f"❌ Batch translation failed: {str(e)}"
726	
727	@mcp.tool()
728	def post_process_powerpoint(
729	    input_file: str,
730	    output_file: Optional[str] = None,
731	    text_threshold: Optional[int] = None,
732	    enable_autofit: bool = True
733	) -> str:
734	    """
735	    Apply post-processing to a PowerPoint presentation to optimize text boxes.
736	    
737	    This function enables text wrapping and shrink text on overflow for text boxes
738	    that contain text longer than the specified threshold.
739	    
740	    Args:
741	        input_file: Path to the input PowerPoint file (.pptx)
742	        output_file: Path to save the processed file (optional, auto-generated if not provided)
743	        text_threshold: Text length threshold for enabling auto-fit (overrides .env setting)
744	        enable_autofit: Enable text auto-fitting (default: True)
745	    
746	    Returns:
747	        Success message with post-processing details
748	    """
749	    try:
750	        # Validate input file using helper function
751	        input_path, error_msg = validate_input_path(input_file)
752	        if error_msg:
753	            return error_msg
754	        
755	        # Create configuration
756	        config = Config()
757	        if text_threshold is not None:
758	            config.set('TEXT_LENGTH_THRESHOLD', str(text_threshold))
759	        if not enable_autofit:
760	            config.set('ENABLE_TEXT_AUTOFIT', 'false')
761	        
762	        # Generate output filename if not provided
763	        if not output_file:
764	            output_file = str(input_path)  # Overwrite the original file
765	        
766	        # Apply post-processing
767	        logger.info(f"Starting post-processing: {input_path}")
768	        verbose = config.get_bool('DEBUG', False)
769	        post_processor = PowerPointPostProcessor(config, verbose=verbose)
770	        final_output = post_processor.process_presentation(str(input_path), output_file)
771	        
772	        threshold = config.get_int('TEXT_LENGTH_THRESHOLD', 10)
773	        autofit_enabled = config.get_bool('ENABLE_TEXT_AUTOFIT', True)
774	        
775	        return f"""✅ PowerPoint post-processing completed successfully!
776	
777	📁 Input file: {input_path}
778	📁 Output file: {final_output}
779	🔧 Text auto-fitting: {'✅ Enabled' if autofit_enabled else '❌ Disabled'}
780	📏 Text length threshold: {threshold} characters
781	📝 Processing applied to text boxes longer than {threshold} characters
782	
783	💡 Post-processing features applied:
784	• Text wrapping in shape enabled
785	• Shrink text on overflow enabled
786	• Text box margins optimized
787	• Formatting preservation maintained"""
788	        
789	    except Exception as e:
790	        logger.error(f"Post-processing failed: {str(e)}")
791	        return f"❌ Post-processing failed: {str(e)}"
792	
793	
794	def main():
795	    """Main entry point for the FastMCP server."""
796	    # Run the FastMCP server
797	    mcp.run()
798	
799	if __name__ == "__main__":
800	    main()
801	

