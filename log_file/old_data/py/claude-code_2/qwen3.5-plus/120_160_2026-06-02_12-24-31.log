365	def build_device_status_payload(device: Dict[str, Any], profile: Dict[str, Any]) -> Dict[str, Any]:
366	    enabled_operations = build_enabled_operations(profile)
367	    state_summary = profile.get("state_summary", build_state_summary(profile.get("state", {})))
368	    return {
369	        "device": {k: v for k, v in device.items() if k != "raw"},
370	        "device_resource": profile.get("device_resource", {}),
371	        "state": profile.get("state", {}),
372	        "state_summary": state_summary,
373	        "supported_operations": enabled_operations,
374	        "assistant_summary": (
375	            f"{device.get('name')} 当前位于 {device.get('location', {}).get('label') or '未知位置'}，"
376	            f"在线状态为 {'在线' if device.get('online') else '离线'}。"
377	            f"当前摘要：{state_summary}"
378	        ),
379	        "quick_actions": [item["operation"] for item in enabled_operations[:5]],
380	        "next_steps": {
381	            "use_control_by_intent": bool(profile.get("device_resource", {}).get("usage")),
382	            "use_control_device": bool(profile.get("profile_driven_schema", {}).get("generic_operations")),
383	            "check_capabilities_with": "get_device_capabilities",
384	        },
385	    }
