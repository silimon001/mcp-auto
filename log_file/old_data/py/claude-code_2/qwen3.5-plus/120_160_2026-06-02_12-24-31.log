837	async def control_device_with_profile_fallback(
838	    adapter: MijiaAdapter,
839	    query: str,
840	    device_name: str,
841	    room: str = "",
842	    home: str = "",
843	    prefer_device_type: str = "",
844	    parsed_intent: Dict[str, Any] | None = None,
845	) -> ControlToolResult:
846	    device = await resolve_device(
847	        adapter,
848	        device_name=device_name,
849	        room=room,
850	        home=home,
851	        device_type=prefer_device_type,
852	    )
853	    profile = await get_device_profile(adapter, device["device_id"])
854	    match = find_profile_control_match(query, profile)
855	    if not match:
856	        return build_result(
857	            False,
858	            f"Could not match a profile-driven control for {device['name']}",
859	            device={k: v for k, v in device.items() if k != "raw"},
860	            device_resource=profile.get("device_resource"),
861	            profile_driven_controls=profile.get("profile_driven_schema", {}),
862	            parsed_intent=parsed_intent or {},
863	        )
864	
865	    if match["kind"] == "property":
866	        value = parsed_intent.get("value") if parsed_intent else None
867	        if value is None:
868	            return build_result(
869	                False,
870	                f"Matched property {match['name']} on {device['name']} but no value was provided",
871	                device={k: v for k, v in device.items() if k != "raw"},
872	                matched_control=match,
873	                device_resource=profile.get("device_resource"),
874	                parsed_intent=parsed_intent or {},
875	            )
876	        capability_name = None
877	        for item in profile.get("profile_driven_schema", {}).get("writable_properties", []):
878	            if item.get("name") == match["name"]:
879	                if item.get("value_list"):
880	                    capability_name = "mode"
881	                break
882	        if capability_name:
883	            resolved_target = {
884	                "name": match["name"],
885	                "value_list": next(
886	                    (
887	                        item.get("value_list")
888	                        for item in profile.get("profile_driven_schema", {}).get("writable_properties", [])
889	                        if item.get("name") == match["name"]
890	                    ),
891	                    None,
892	                ),
893	                "range": next(
894	                    (
895	                        item.get("range")
896	                        for item in profile.get("profile_driven_schema", {}).get("writable_properties", [])
897	                        if item.get("name") == match["name"]
898	                    ),
899	                    None,
900	                ),
901	            }
902	            value = coerce_value_for_target(capability_name, resolved_target, value)
903	        return await control_device(
904	            "set_property",
905	            device_id=device["device_id"],
906	            value=value,
907	            property_name=match["name"],
908	        )
909	
910	    return await control_device(
911	        "run_action",
912	        device_id=device["device_id"],
913	        value=[],
914	        action_name=match["name"],
915	    )
