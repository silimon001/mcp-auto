1485	    device_name: str = "",
1486	    device_id: str = "",
1487	    room: str = "",
1488	    home: str = "",
1489	    value: Any = None,
1490	    property_name: str = "",
1491	    action_name: str = "",
1492	    refresh: bool = False,
1493	) -> ControlToolResult:
1494	    """Control a device through capability operations like turn_on, set_brightness, set_target_temperature, or run_action."""
1495	    adapter = get_adapter()
