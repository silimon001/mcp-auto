1	"""
2	Subprocess terminal controller.
3	Uses Python's subprocess module to execute commands.
4	Works on all platforms.
5	"""
6	
7	import asyncio
8	from typing import Any, Dict
9	
10	from mcp_terminal.controllers.base import BaseTerminalController
11	
12	
13	class SubprocessTerminalController(BaseTerminalController):
14	    """Terminal controller using subprocess."""
15	
16	    async def execute_command(
17	        self, command: str, wait_for_output: bool = True, timeout: int = 10
18	    ) -> Dict[str, Any]:
19	        """
20	        Execute a command using subprocess.
21	
22	        Args:
23	            command: The command to execute
24	            wait_for_output: Whether to wait for output
25	            timeout: Timeout in seconds
26	
27	        Returns:
28	            A dictionary with the result of the command execution
29	        """
30	        try:
31	            # Create subprocess
32	            process = await asyncio.create_subprocess_shell(
33	                command,
34	                stdout=asyncio.subprocess.PIPE,
35	                stderr=asyncio.subprocess.PIPE,
36	            )
37	
38	            if wait_for_output:
39	                try:
40	                    # Wait for the process to complete with timeout
41	                    stdout, stderr = await asyncio.wait_for(
42	                        process.communicate(), timeout=timeout
43	                    )
44	
45	                    return {
46	                        "success": process.returncode == 0,
47	                        "output": stdout.decode("utf-8", errors="replace"),
48	                        "error": stderr.decode("utf-8", errors="replace"),
49	                        "return_code": process.returncode,
50	                    }
51	                except asyncio.TimeoutError:
52	                    # Kill the process if it times out
53	                    try:
54	                        process.kill()
55	                    except ProcessLookupError:
56	                        pass
57	                    return {
58	                        "success": False,
59	                        "error": f"Command timed out after {timeout} seconds",
60	                    }
61	            else:
62	                # Don't wait for output
63	                return {
64	                    "success": True,
65	                    "output": "Command sent (output not captured)",
66	                }
67	
68	        except Exception as e:
69	            return {
70	                "success": False,
71	                "error": f"Error executing command: {str(e)}",
72	            }
73	
74	    async def get_terminal_type(self) -> str:
75	        """
76	        Get the terminal type.
77	
78	        Returns:
79	            The terminal type
80	        """
81	        return "subprocess"
