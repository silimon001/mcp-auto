145	    def _parse_sql_like_literal(self, token: str) -> Any:
146	        """Parse SQL-like literal text into Python values for MongoDB writes."""
147	        t = token.strip()
148	        if not t:
149	            return None
150	
151	        upper = t.upper()
152	        if upper == "NULL":
153	            return None
154	        if upper == "TRUE":
155	            return True
156	        if upper == "FALSE":
157	            return False
158	
159	        if (t.startswith("'") and t.endswith("'")) or (t.startswith('"') and t.endswith('"')):
160	            inner = t[1:-1]
161	            return inner.replace("\\'", "'").replace('\\"', '"')
162	
163	        try:
164	            if "." in t:
165	                return float(t)
166	            return int(t)
167	        except ValueError:
168	            pass
169	
170	        return t
