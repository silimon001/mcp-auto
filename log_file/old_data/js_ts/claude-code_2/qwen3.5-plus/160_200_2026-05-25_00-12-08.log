151			buildPaths(outfile).map((file) =>
152				rm(file, {
153					force: true
154				})
155			)
156		)
157	}
158	
159	const findOutputPath = async (outfile: string) => {
160		const files = buildPaths(outfile)
161		const existing = await Promise.all(
162			files.map(async (file) => ({
163				exists: await Bun.file(file).exists(),
164				file
165			}))
166		)
167	
168		const match = existing.find((entry) => entry.exists)
