29	
30	const TARGETS: readonly BuildTarget[] = [
31		{
32			id: HOST_TARGET,
33			label: "current platform",
34			outfile: join(DIST_DIR, APP_NAME)
35		},
36		{
37			id: "linux-x64",
38			label: "Linux x64",
39			outfile: join(DIST_DIR, `${APP_NAME}-linux-x64`),
