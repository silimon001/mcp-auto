399	def add_extra_info(dataset_name: str, repo_id: str) -> str:
400	    """从数据集读取仓库额外信息"""
401	    final_text = ''
402	    repo_info_path = Path.cwd() / "data" / "dataset" / dataset_name / "repo_info.json"
403	    if repo_info_path.exists():
404	        with open(repo_info_path, 'r', encoding='utf-8') as f:
405	            repo_infos = json.load(f)
406	        for repo_info in repo_infos:
407	            if repo_info.get('id') == int(repo_id):
408	                info = {k: repo_info.get(k) for k in ["id", "description", "language", "size", "topic", "html_url"]}
409	                info['owner'] = repo_info.get('full_name').split('/')[0]
410	                info['name'] = repo_info.get('full_name').split('/')[1]
411	                final_text += f'\n=== REPO INFO START ===\n{info}\n=== REPO INFO END ===\n'
412	                break
413	    return final_text
