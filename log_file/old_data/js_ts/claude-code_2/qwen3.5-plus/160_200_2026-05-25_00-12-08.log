85	const readArgValue = (args: string[], name: string) => {
86		for (const arg of args) {
87			if (arg.startsWith(`${name}=`)) {
88				return arg.slice(name.length + 1)
89			}
90		}
91	
92		const index = args.indexOf(name)
93		if (index < 0) {
94			return
95		}
96	
97		return args[index + 1]
98	}
99	
100	const parseArgs = (args: string[]) => {
101		const positional = args.filter((arg) => !arg.startsWith("--"))
102		const targetArg = readArgValue(args, "--target")
103		const targetName = targetArg ?? positional[0] ?? HOST_TARGET
104	
105		return {
106			clean: args.includes("--clean"),
107			showHelp: args.some((arg) => HELP_FLAGS.has(arg)),
108			showList: args.some((arg) => LIST_FLAGS.has(arg)),
109			targetName
110		}
111	}
112	
113	const resolveTarget = (name: string) => {
114		if (name === ALL_TARGET) {
115			return TARGETS.filter((build) => build.id !== HOST_TARGET)
116		}
117	
118		if (name === HOST_TARGET) {
