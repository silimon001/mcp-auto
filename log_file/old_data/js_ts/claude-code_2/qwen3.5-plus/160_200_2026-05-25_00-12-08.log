68	const TARGET_LOOKUP = new Map(
69		TARGETS.flatMap((build) => [
70			[
71				build.id,
72				build
73			],
74			...(build.target
75				? [
76						[
77							build.target,
78							build
79						] as const
80					]
81				: [])
