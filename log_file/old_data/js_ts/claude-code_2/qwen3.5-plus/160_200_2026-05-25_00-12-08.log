284	
285	## Tools
286	
287	### `list_calendars`
288	
289	Discover available calendars and their IDs. Usually not needed since `search_events` searches all calendars by default.
290	
291	```ts
292	// Input
293	{}
294	
295	// Output
296	{
297	  items: Array<{
298	    id, summary, primary?, backgroundColor?,
299	    accessRole, timeZone, description?
300	  }>;
301	}
302	```
303	
304	### `search_events`
305	
306	Search events across **all calendars by default**. Returns merged results sorted by start time.
307	
308	```ts
309	// Input
310	{
311	  calendarId?: string | string[];  // Default: "all" (searches ALL calendars)
312	                                   // Can be: "all", single ID, or array of IDs
313	  timeMin?: string;          // ISO 8601
314	  timeMax?: string;          // ISO 8601
315	  query?: string;            // Text search
316	  maxResults?: number;       // Default: 50 (total across all calendars)
317	  eventTypes?: string[];     // default, birthday, focusTime, outOfOffice
318	  orderBy?: "startTime" | "updated";
319	  fields?: string[];         // Control output verbosity
320	  pageToken?: string;        // Pagination (single calendar only)
321	}
322	
323	// Output
324	{
325	  items: Array<{
326	    id, summary, start, end, location?,
327	    calendarId, calendarName,  // NEW: which calendar this event belongs to
328	    htmlLink, status, attendees?, hangoutLink?
329	  }>;
330	  calendarsSearched: string[];  // List of calendars that were searched
331	  nextPageToken?: string;
332	}
333	```
334	
335	> **Note:** Each event includes `calendarId` and `calendarName` so you know which calendar it belongs to. Use this `calendarId` when calling `update_event` or `delete_event`.
336	
337	### `check_availability`
338	
339	Check free/busy status before scheduling.
340	
341	```ts
342	// Input
343	{
344	  timeMin: string;           // ISO 8601 (required)
345	  timeMax: string;           // ISO 8601 (required)
346	  calendarIds?: string[];    // Default: ["primary"]
347	}
348	
349	// Output
350	{
351	  calendars: {
352	    [calendarId]: {
353	      busy: Array<{ start, end }>;
354	    }
355	  }
356	}
357	```
358	
359	### `create_event`
360	
361	Create events using natural language OR structured input.
362	
363	```ts
364	// Natural language mode
365	{
366	  text: "Lunch with Anna tomorrow at noon for 1 hour";
367	  calendarId?: string;
368	  sendUpdates?: "all" | "externalOnly" | "none";
369	}
370	
371	// Structured mode
372	{
373	  summary: string;           // Required
374	  start: string;             // ISO 8601 or YYYY-MM-DD
375	  end: string;               // ISO 8601 or YYYY-MM-DD
376	  calendarId?: string;
377	  description?: string;
378	  location?: string;
379	  attendees?: string[];      // Email addresses
380	  addGoogleMeet?: boolean;   // Auto-create Meet link
381	  recurrence?: string[];     // RRULE array
382	  visibility?: "default" | "public" | "private";
383	  sendUpdates?: "all" | "externalOnly" | "none";
384	}
385	```
386	
387	### `update_event`
388	
389	Update or move existing events (PATCH semantics).
390	
391	```ts
392	{
393	  eventId: string;           // Required
394	  calendarId?: string;
395	  targetCalendarId?: string; // Move to different calendar
396	  summary?: string;
397	  start?: string;
398	  end?: string;
399	  description?: string;
400	  location?: string;
401	  attendees?: string[];
402	  addGoogleMeet?: boolean;
403	  sendUpdates?: "all" | "externalOnly" | "none";
404	}
405	```
406	
407	### `delete_event`
408	
409	Remove an event from calendar.
410	
411	```ts
412	{
413	  eventId: string;           // Required
414	  calendarId?: string;
415	  sendUpdates?: "all" | "externalOnly" | "none";
416	}
417	```
418	
419	### `respond_to_event`
420	
421	Accept, decline, or tentatively accept an event invitation.
422	
423	```ts
424	// Input
425	{
426	  eventId: string;           // Required
427	  calendarId?: string;       // Default: "primary"
428	  response: "accepted" | "declined" | "tentative";  // Required
429	  sendUpdates?: "all" | "externalOnly" | "none";    // Default: "all"
430	}
431	
432	// Output
433	{
434	  ok: true,
435	  response: "accepted",  // Your response
436	  event: { ... }         // Updated event
437	}
438	```
439	
440	> **Note:** Only works for events you were invited to. For events you created, you are the organizer, not an attendee.
441	
