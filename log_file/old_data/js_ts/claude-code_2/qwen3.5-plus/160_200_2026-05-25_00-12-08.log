225	def collect_messages(events):
226	    """聚合事件，记录时间戳，并捕获 result 事件用于总结"""
227	    messages = {}
228	    order = []      # dict(system/user/result) 或 str(assistant msg_id)
229	
230	    for event in events:
231	        etype = event.get("type")
232	        ts = event.get("timestamp") or event.get("_received_at", datetime.now(timezone.utc).isoformat())
233	
234	        # -------- system --------
235	        if etype == "system":
236	            order.append({
237	                "type": "system",
238	                "content": f"[SYSTEM] {event.get('subtype', '')}",
239	                "timestamp": ts
240	            })
241	            continue
242	
243	        # -------- user --------
244	        if etype == "user":
245	            contents = event.get("message", {}).get("content", [])
246	            text = render_content(contents)
247	            order.append({
248	                "type": "user",
249	                "content": text,
250	                "timestamp": ts
251	            })
252	            continue
253	
254	        # -------- result (最终总结) --------
255	        if etype == "result":
256	            order.append({
257	                "type": "result",
258	                "timestamp": ts,
259	                "data": {
260	                    "subtype": event.get("subtype"),
261	                    "is_error": event.get("is_error"),
262	                    "num_turns": event.get("num_turns"),
263	                    "stop_reason": event.get("stop_reason"),
264	                    "total_cost_usd": event.get("total_cost_usd"),
265	                    "duration_ms": event.get("duration_ms"),
266	                    "duration_api_ms": event.get("duration_api_ms"),
267	                    "usage": event.get("usage", {}),
268	                    "errors": event.get("errors", []),
269	                    "terminal_reason": event.get("terminal_reason")
270	                }
271	            })
272	            continue
273	
274	        # -------- assistant --------
275	        if etype == "assistant":
276	            msg = event.get("message", {})
277	            msg_id = msg.get("id")
278	
279	            if msg_id not in messages:
280	                messages[msg_id] = {
281	                    "type": "assistant",
282	                    "texts": [],
283	                    "tools": [],
284	                    "tokens": None,
285	                    "timestamp": ts
286	                }
287	                order.append(msg_id)     # 保证顺序
288	
289	            entry = messages[msg_id]
290	
291	            for c in msg.get("content", []):
292	                ctype = c.get("type")
293	                if ctype == "text":
294	                    entry["texts"].append(c.get("text", ""))
295	                elif ctype == "tool_use":
296	                    entry["tools"].append({
297	                        "name": c.get("name"),
298	                        "input": c.get("input")
299	                    })
300	
301	            if msg.get("usage"):
302	                entry["tokens"] = {
303	                    "input": msg["usage"].get("input_tokens"),
304	                    "output": msg["usage"].get("output_tokens")
305	                }
306	
307	    return messages, order
308	
