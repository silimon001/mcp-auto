gs.json not found") 424 sys.exit(1) 425 426 settings = json.loads(settings_path.read_text()) 427 428 anthropic_model = settings.get('env').get("ANTHROPIC_MODEL") 429 430 if not anthropic_model: 431 print("ANTHROPIC_MODEL not found in settings.json") 432 sys.exit(1) 433 434 normalized = normalize_model_name(anthropic_model) 435 436 if normalized != model_name: 437 print( 438 f"Model mismatch:\n" 439 f"expected: {model_name}\n" 440 f"actual: {anthropic_model}" 441 ) 442 sys.exit(1) 443 444 print(f"Model verified: {anthropic_model}") 445 446 def env_ready(): 447 import shutil 448 # 1. Delete .mcp.json 449 mcp_file = CWD / ".mcp.json" 450 451 if mcp_file.exists(): 452 mcp_file.unlink() 453 print("Deleted .mcp.json") 454 455 # 2. Delete .claude dir 456 skills_dir = CWD / ".claude" 457 458 if skills_dir.exists(): 459 shutil.rmtree(skills_dir) 460 print(f"Deleted {skills_dir} folder") 461 462 # 3. Delete CLAUDE.md 463 claude_md = CWD / 'CLAUDE.md' 464 465 if claude_md.exists(): 466 claude_md.unlink() 467 print(f"Deleted {claude_md}") 468 469 470 # ========================= 471 # 6. 示例入口 472 # ========================= 473 if __name__ == "__main__": 474 475 os.makedirs('mcp_server', exist_ok=True) 476 os.makedirs('mcp_server_config', exist_ok=True) 477 with open('mcp_server_config/config.json', 'w', encoding='utf-8') as f: 478 f.write('{\n "Servers": {\n\n }\n}') 479 480 with open('prompt_for_exp.md', 'r', encoding='utf-8') as f: 481 task_prompt = f.read() 482 task_prompt = task_prompt.replace("{WORKSPACE}", str(CWD)) 483 484 from glob import glob 485 readme_dir = MAIN_CWD / "data" / "dataset" / dataset_name / "sampled_validated_readme" 486 readme_files = sorted(glob(str(readme_dir / "*.md")), key=os.path.getsize) 487 488 pos = 0 489 count = 40 490 491 for readme_path in readme_files[pos:pos+count]: 492 493 verify_model(model_name) 494 env_ready() 495 496 readme_path = Path(readme_path) 497 filename_parts = readme_path.stem.split('_') 498 repo_id = filename_parts[0] 499 500 with open(readme_path, 'r', encoding='utf-8') as f: 501 readme_content = f.read() 502 503 extra_info = add_extra_info(dataset_name, repo_id) 504 505 query = f'''\n=== README.md START ===\n{readme_content}\n=== README.md END ===\n{extra_info}''' 506 507 all_prompt = task_prompt + query 508 509 run_task(all_prompt, "claude_code", pos, count)
