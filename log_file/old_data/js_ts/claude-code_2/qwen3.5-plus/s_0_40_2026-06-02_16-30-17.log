loop 18 | Tool=Write, Args={"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/905326996_flexpa_mcp-fhir/src/index.ts","content":"#!/usr/bin/env node\n\nimport { Server } from \"@modelcontextprotocol/sdk/server/index.js\";\nimport { StdioServerTransport } from \"@modelcontextprotocol/sdk/server/stdio.js\";\nimport {\n  CallToolRequestSchema,\n  ListToolsRequestSchema,\n  ListResourcesRequestSchema,\n  ReadResourceRequestSchema,\n} from \"@modelcontextprotocol/sdk/types.js\";\n\nconst FHIR_BASE_URL = process.env.FHIR_BASE_URL || \"\";\nconst FHIR_ACCESS_TOKEN = process.env.FHIR_ACCESS_TOKEN || \"\";\n\nasync function fhirRequest(path: string, searchParams?: Record<string, string>) {\n  const url = new URL(path, FHIR_BASE_URL);\n  if (searchParams) {\n    Object.entries(searchParams).forEach(([k, v]) => url.searchParams.set(k, v));\n  }\n  const headers: Record<string, string> = {\n    \"Accept\": \"application/fhir+json\",\n    \"Content-Type\": \"application/fhir+json\",\n  };\n  if (FHIR_ACCESS_TOKEN) {\n    headers[\"Authorization\"] = `Bearer ${FHIR_ACCESS_TOKEN}`;\n  }\n  const response = await fetch(url.toString(), { headers });\n  if (!response.ok) {\n    throw new Error(`FHIR request failed: ${response.status} ${response.statusText}`);\n  }\n  return response.json();\n}\n\nconst server = new Server(\n  { name: \"mcp-fhir\", version: \"0.1.0\" },\n  { capabilities: { tools: {}, resources: {} } }\n);\n\nserver.setRequestHandler(ListToolsRequestSchema, async () => ({\n  tools: [\n    {\n      name: \"search_fhir\",\n      description: \"Search FHIR resources\",\n      inputSchema: {\n        type: \"object\",\n        properties: {\n          resourceType: { type: \"string\", description: \"FHIR resource type\" },\n          searchParams: { type: \"object\", description: \"Search parameters\" },\n        },\n        required: [\"resourceType\"],\n      },\n    },\n    {\n      name: \"read_fhir\",\n      description: \"Read an individual FHIR resource\",\n      inputSchema: {\n        type: \"object\",\n        properties: {\n          uri: { type: \"string\", description: \"FHIR resource URI (e.g., Patient/123)\" },\n        },\n        required: [\"uri\"],\n      },\n    },\n  ],\n}));\n\nserver.setRequestHandler(CallToolRequestSchema, async (request) => {\n  const { name, arguments: args } = request.params;\n\n  if (name === \"search_fhir\") {\n    const { resourceType, searchParams } = args as { resourceType: string; searchParams?: Record<string, string> };\n    const result = await fhirRequest(resourceType, searchParams);\n    return { content: [{ type: \"text\", text: JSON.stringify(result, null, 2) }] };\n  }\n\n  if (name === \"read_fhir\") {\n    const { uri } = args as { uri: string };\n    const result = await fhirRequest(uri);\n    return { content: [{ type: \"text\", text: JSON.stringify(result, null, 2) }] };\n  }\n\n  throw new Error(`Unknown tool: ${name}`);\n});\n\nserver.setRequestHandler(ListResourcesRequestSchema, async () => {\n  const capabilityStatement = await fhirRequest(\"metadata\");\n  const resources: Array<{ uri: string; name: string; description: string }> = [];\n  for (const resource of capabilityStatement.rest?.[0]?.resource || []) {\n    resources.push({\n      uri: `fhir://${resource.type}`,\n      name: resource.type,\n      description: `FHIR ${resource.type} resource`,\n    });\n  }\n  return { resources };\n});\n\nserver.setRequestHandler(ReadResourceRequestSchema, async (request) => {\n  const { uri } = request.params;\n  if (!uri.startsWith(\"fhir://\")) {\n    throw new Error(`Invalid URI: ${uri}`);\n  }\n  const resourceType = uri.replace(\"fhir://\", \"\").split(\"/\")[0];\n  const parts = uri.replace(\"fhir://\", \"\").split(\"/\");\n  const result = await fhirRequest(parts.join(\"/\"));\n  return {\n    contents: [{\n      uri,\n      mimeType: \"application/fhir+json\",\n      text: JSON.stringify(result, null, 2),\n    }],\n  };\n});\n\nasync function main() {\n  const transport = new StdioServerTransport();\n  await server.connect(transport);\n  console.error(\"FHIR MCP server running on stdio\");\n}\n\nmain().catch((error) => {\n  console.error(\"Server error:\", error);\n  process.exit(1);\n});\n"}
