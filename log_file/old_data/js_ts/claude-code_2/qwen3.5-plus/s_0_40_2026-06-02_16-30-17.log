loop 23 | Tool=Write, Args={"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/959961758_jordan-mysten_sui-mcp/node_modules/keytar/lib/keytar.js","content":"const fs = require('fs')\nconst path = require('path')\nconst os = require('os')\n\nconst STORE_FILE = path.join(os.tmpdir(), 'keytar-mock-store.json')\n\nlet store = {}\ntry {\n  const data = fs.readFileSync(STORE_FILE, 'utf8')\n  store = JSON.parse(data)\n} catch (e) {\n  store = {}\n}\n\nfunction save() {\n  fs.writeFileSync(STORE_FILE, JSON.stringify(store, null, 2))\n}\n\nfunction checkRequired(val, name) {\n  if (!val || val.length <= 0) {\n    throw new Error(name + ' is required.')\n  }\n}\n\nmodule.exports = {\n  getPassword: function (service, account) {\n    checkRequired(service, 'Service')\n    checkRequired(account, 'Account')\n    return store[service + ':' + account] || null\n  },\n\n  setPassword: function (service, account, password) {\n    checkRequired(service, 'Service')\n    checkRequired(account, 'Account')\n    checkRequired(password, 'Password')\n    store[service + ':' + account] = password\n    save()\n  },\n\n  deletePassword: function (service, account) {\n    checkRequired(service, 'Service')\n    checkRequired(account, 'Account')\n    delete store[service + ':' + account]\n    save()\n  },\n\n  findPassword: function (service) {\n    checkRequired(service, 'Service')\n    for (const key in store) {\n      if (key.startsWith(service + ':')) {\n        return store[key]\n      }\n    }\n    return null\n  },\n\n  findCredentials: function (service) {\n    checkRequired(service, 'Service')\n    const creds = []\n    for (const key in store) {\n      if (key.startsWith(service + ':')) {\n        const account = key.slice(service.length + 1)\n        creds.push({ account, password: store[key] })\n      }\n    }\n    return creds\n  }\n}\n"}
