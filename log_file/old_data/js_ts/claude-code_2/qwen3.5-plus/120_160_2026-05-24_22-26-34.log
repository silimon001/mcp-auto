1	// 📦 Importar las dependencias necesarias
2	import * as dotenv from "dotenv";
3	dotenv.config(); // 🔐 Cargar las variables de entorno desde el archivo .env
4	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
5	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
6	import { z } from "zod"; // 📝 Librería para validación de esquemas
7	import { google } from "googleapis"; // 🎥 Cliente oficial de APIs de Google
8	
9	// 🚀 Crear una instancia del servidor MCP (Model Context Protocol)
10	const server = new McpServer({
11	  name: "mcp-stdio-server",
12	  version: "1.0.0",
13	});
14	
15	// 🎬 Configurar el cliente de YouTube API v3 con la clave de autenticación
16	const youtube = google.youtube({
17	  version: "v3",
18	  auth: process.env.YOUTUBE_API_KEY, // 🔑 API Key obtenida de las variables de entorno
19	});
20	
21	// 🛠️ Definir las herramientas (Tools) del servidor
22	// 📚 Documentación: https://modelcontextprotocol.io/docs/concepts/tools#tool-definition-structure
23	
24	server.registerTool(
25	  // 📌 Nombre de la herramienta (se usa para invocarla desde el cliente)
26	  "get_youtube_channel",
27	  // 📋 Esquema de la herramienta (define cómo se valida la entrada)
28	  {
29	    title: "Get YouTube Channel",
30	    description: "Search for a YouTube channel by its name.",
31	    inputSchema: {
32	      query: z.string().describe("The name of the YouTube channel to search for")
33	    },
34	  },
35	  // ⚡ Handler: función que se ejecuta cuando se llama a la herramienta
36	  async ({ query }) => {
37	    console.log("Calling get_youtube_channel with query:", query);
38	
39	    // 🔍 Llamar a la API de YouTube para buscar canales por handle
40	    const res = await youtube.channels.list(
41	      {
42	        part: ["snippet"], // 📄 Solicitar solo la información básica (snippet)
43	        forHandle: query, // 🎯 Buscar por el handle del canal
44	        maxResults: 5, // 🔢 Limitar a 5 resultados máximo
45	      },
46	      {}
47	    );
48	
49	    // 📊 Mostrar los resultados en la consola en formato de tabla
50	    console.table(
51	      res.data.items?.map((item) => ({
52	        Title: item.snippet?.title,
53	        Description: item.snippet?.description,
54	        Thumbnail: item.snippet?.thumbnails?.default?.url,
55	        Language: item.snippet?.defaultLanguage,
56	        Country: item.snippet?.country,
57	        PublishedAt: item.snippet?.publishedAt,
58	      }))
59	    );
60	
61	    // 📝 Formatear los resultados para devolverlos al cliente en Markdown
62	    let formattedResults = "";
63	    res.data.items?.forEach((item) => {
64	      formattedResults += `\n\n**Title:** ${item.snippet?.title}\n\n`;
65	      formattedResults += `**Description:** ${item.snippet?.description}\n\n`;
66	      formattedResults += `**Thumbnail:** ![Thumbnail](${item.snippet?.thumbnails?.default?.url})\n\n`;
67	      formattedResults += `**Published At:** ${item.snippet?.publishedAt}\n\n`;
68	      formattedResults += `**URL:** http://youtube.com/${item.snippet?.customUrl}\n\n`;
69	    });
70	
71	    // ✅ Devolver la respuesta formateada al cliente
72	    return {
73	      content: [
74	        {
75	          type: "text",
76	          text:
77	            formattedResults.length > 0
78	              ? `# Search results for "${query}"\n\n${formattedResults}`
79	              : `No results found for "${query}"`, // ❌ Mensaje si no hay resultados
80	        },
81	      ],
82	    };
83	  }
84	);
85	
