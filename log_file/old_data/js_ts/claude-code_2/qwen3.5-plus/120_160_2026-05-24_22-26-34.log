1	#!/usr/bin/env node
2	
3	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
4	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
5	import {
6	  CallToolRequestSchema,
7	  ListResourcesRequestSchema,
8	  ListToolsRequestSchema,
9	  ReadResourceRequestSchema,
10	} from "@modelcontextprotocol/sdk/types.js";
11	import pg from "pg";
12	
13	// Initialize the server
14	const server = new Server(
15	  {
16	    name: "example-servers/postgres",
17	    version: "0.1.0",
18	  },
19	  {
20	    capabilities: {
21	      resources: {},
22	      tools: {},
23	    },
24	  },
25	);
26	
27	const args = process.argv.slice(2);
28	
29	// Check if the database URL is passed
30	if (args.length === 0) {
31	  process.exit(1);
32	}
33	
34	const databaseUrl = args[0];
35	
36	const resourceBaseUrl = new URL(databaseUrl);
37	resourceBaseUrl.protocol = "postgres:";
38	resourceBaseUrl.password = "";
39	
40	const pool = new pg.Pool({
41	  connectionString: databaseUrl,
42	});
43	
44	
45	const SCHEMA_PATH = "schema";
46	
47	// Debug Insert for testing purposes
48	async function insertDebugEntry() {
49	  const client = await pool.connect();
50	  try {
51	
52	    // Example insert query into `example_table`
53	    const result = await client.query(
54	      "INSERT INTO users (name, email, age) VALUES ($1, $2, $3) RETURNING id",
55	      ["sample1", "sample1@gmail.com", 30],
56	    );
57	
58	  } catch (error) {
59	  } finally {
60	    client.release();
61	  }
62	}
63	
64	// List resources handler - provides information about all available database tables
65	server.setRequestHandler(ListResourcesRequestSchema, async () => {
66	
67	  const client = await pool.connect();
68	  try {
69	
70	    const result = await client.query(
71	      "SELECT table_name FROM information_schema.tables WHERE table_schema = 'public'"
72	    );
73	
74	
75	    return {
76	      resources: result.rows.map((row) => ({
77	        uri: new URL(`${row.table_name}/${SCHEMA_PATH}`, resourceBaseUrl).href,
