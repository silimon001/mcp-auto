1052	/**
1053	 * Helper function to make API requests to VirusTotal
1054	 * Handles authentication and error handling for all VirusTotal API calls
1055	 * 
1056	 * @template T The expected response type
1057	 * @param {string} endpoint The API endpoint to call
1058	 * @param {string} method The HTTP method to use
1059	 * @param {any} data Data to send in request body (for POST requests)
1060	 * @param {Record<string, string | number>} params Query parameters to include
1061	 * @returns {Promise<T>} The API response
1062	 * @throws {Error} If the API request fails or if the API key is not set
1063	 */
1064	async function virusTotalApiRequest<T>(
1065	  endpoint: string, 
1066	  method: 'get' | 'post' = 'get',
1067	  data?: any,
1068	  params?: Record<string, string | number>
1069	): Promise<T> {
1070	  
1071	  if (!virusTotalApiKey) {
1072	    throw new Error("VirusTotal API key is not set");
1073	  }
1074	  
1075	  try {
1076	    const config = {
1077	      headers: {
1078	        'x-apikey': virusTotalApiKey
1079	      },
1080	      params
1081	    };
1082	    
1083	    let response;
1084	    
1085	    if (method === 'get') {
1086	      response = await axios.get(`${VIRUSTOTAL_API_BASE_URL}${endpoint}`, config);
1087	    } else {
1088	      response = await axios.post(`${VIRUSTOTAL_API_BASE_URL}${endpoint}`, data, config);
1089	    }
1090	    
1091	    return response.data as T;
1092	  } catch (error) {
1093	    if (axios.isAxiosError(error)) {
1094	      const errorMessage = error.response?.data?.error?.message || error.message;
1095	      throw new Error(`VirusTotal API error: ${errorMessage}`);
1096	    }
1097	    console.error(`Error making request to VirusTotal ${endpoint}:`, error);
1098	    throw error;
1099	  }
1100	}
