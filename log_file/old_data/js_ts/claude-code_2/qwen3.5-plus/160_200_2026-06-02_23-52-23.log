7	import { join } from 'node:path';
8	import { pathToFileURL } from 'node:url';
9	import { stat } from 'node:fs/promises';
10	import { fsReadAll } from '@adonisjs/core/helpers';
11	import string from '@adonisjs/core/helpers/string';
12	import { UriTemplate } from '../src/utils/uri_template.js';
13	import McpServer from '../src/server.js';
14	export default class McpProvider {
15	    app;
16	    constructor(app) {
17	        this.app = app;
18	    }
19	    register() {
20	        this.app.container.singleton('jrmc.mcp', async () => {
21	            const config = this.app.config.get('mcp', {});
22	            const logger = await this.app.container.make('logger');
23	            const emitter = await this.app.container.make('emitter');
24	            return new McpServer(config, { logger, emitter });
25	        });
26	    }
27	    async start() {
28	        const router = await this.app.container.make('router');
29	        const McpController = () => import('../src/server/controllers/mcp_controller.js');
30	        router.mcp = (pattern = '/mcp') => {
31	            return router.group(() => {
32	                router.post(pattern, [McpController, 'post']);
33	            });
34	        };
35	        await this.registerTools();
36	        await this.registerResources();
37	        await this.registerPrompts();
38	    }
39	    async registerTools() {
40	        await this.registerMethods('tool');
41	    }
42	    async registerResources() {
43	        await this.registerMethods('resource');
44	    }
45	    async registerPrompts() {
46	        await this.registerMethods('prompt');
47	    }
48	    async registerMethods(type) {
49	        const server = await this.app.container.make('jrmc.mcp');
50	        const mcpPath = this.app.makePath(this.app.rcFile.directories['mcp'] || 'app/mcp/', `${string.plural(type)}/`);
51	        try {
52	            await stat(mcpPath);
53	        }
54	        catch {
55	            return;
56	        }
57	        const files = await fsReadAll(mcpPath, {
58	            filter: (filePath) => !filePath.endsWith('.map') &&
59	                (filePath.includes(`_${type}.ts`) || filePath.includes(`_${type}.js`)),
60	        });
61	        await Promise.all(files.map(async (file) => {
62	            const path = pathToFileURL(join(mcpPath, file)).href;
63	            const { default: Method } = await import(path);
64	            const instance = new Method();
65	            const entry = { path, json: instance.toJson() };
66	            switch (type) {
67	                case 'tool':
68	                    server.addTool({
69	                        [instance.name]: entry,
70	                    });
71	                    break;
72	                case 'resource':
73	                    if (UriTemplate.isTemplate(instance.uri)) {
74	                        server.addResourceTemplate({
75	                            [instance.uri]: entry,
76	                        });
77	                    }
78	                    else {
79	                        server.addResource({
80	                            [instance.uri]: entry,
81	                        });
82	                    }
83	                    break;
84	                case 'prompt':
85	                    server.addPrompt({
86	                        [instance.name]: entry,
87	                    });
88	                    break;
89	            }
90	        }));
91	    }
92	}
