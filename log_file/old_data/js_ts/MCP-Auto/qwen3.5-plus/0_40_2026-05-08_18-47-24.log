        "description": "获取指定笔记的详细数据。参数中的note_id和xsec_token禁止伪造或随机生成，一定要严格确保数据正确且为最新，否则会触发风控！数据可以在如获取笔记列表等工具中获取",
        "handler": "async ({ note_id, xsec_token }) => {\n  return await XHSWEB_API.post('/api/sns/web/v1/feed', {\n    \"source_note_id\": note_id,\n    \"image_formats\": [\n      \"jpg\",\n      \"webp\",\n      \"avif\"\n    ],\n    \"extra\": {\n      \"need_body_topic\": \"1\"\n    },\n    \"xsec_source\": \"pc_feed\",\n    \"xsec_token\": xsec_token\n  })\n}",
        "inputSchema": {
          "type": "object",
          "properties": {
            "note_id": {
              "type": "string",
              "description": "小红书笔记的note_id"
            },
            "xsec_token": {
              "type": "string",
              "description": "笔记对应的xsec_token"
            }
          },
          "required": [
            "note_id",
            "xsec_token"
          ]
        },
        "enabled": true
      },
      {
        "id": "7bd289b8-6277-4a95-ba1b-2eece9796142",
        "name": "getHomeFeeds",
        "pattern": "/mcp/getHomeFeeds",
        "description": "获取小红书网站首页的帖子列表。 分类数据如下（csv格式）： id,name homefeed_recommend,推荐 homefeed.fashion_v3,穿搭 homefeed.food_v3,美食 homefeed.cosmetics_v3,彩妆 homefeed.movie_and_tv_v3,影视 homefeed.career_v3,职场 homefeed.love_v3,情感 homefeed.household_product_v3,家居 homefeed.gaming_v3,游戏 homefeed.travel_v3,旅行 homefeed.fitness_v3,健身",
        "handler": "async ({ count = 10, category = 'homefeed_recommend' }) => {\n  try {\n    let cursor_score = '';\n    let note_index = 0;\n    // 总共获取了多少\n    let loaded_count = 0;\n    // 结果缓存\n    let results_all = [];\n    while (loaded_count < count) {\n      try {\n        const res = await XHSWEB_API.post(\"/api/sns/web/v1/homefeed\", {\n          \"cursor_score\": cursor_score,\n          \"num\": 27,\n          \"refresh_type\": 1,\n          \"note_index\": note_index,\n          \"unread_begin_note_id\": \"\",\n          \"unread_end_note_id\": \"\",\n          \"unread_note_count\": 0,\n          \"category\": category,\n          \"search_key\": \"\",\n          \"need_num\": 12,\n          \"image_formats\": [\n            \"jpg\",\n            \"webp\",\n            \"avif\"\n          ],\n          \"need_filter_image\": false\n        });\n        res['items'].map((item) => {\n          if (loaded_count >= count) return;\n          results_all.push(item);\n          loaded_count++;\n        })\n        if (loaded_count >= count) break;\n        cursor_score = res['cursor_score'];\n        note_index = res['items'].length;\n        await XHSWEB_API.sleep(2);\n      } catch (e) {\n        break;\n      }\n    }\n    return results_all;\n  } catch (e) {\n    return {\n      msg: '获取笔记列表失败',\n      error: e\n    }\n  }\n}",
        "inputSchema": {
          "type": "object",
          "properties": {
            "count": {
              "type": "number",
              "description": "要获取的数据量，默认10"
            },
            "category": {
              "type": "string",
              "description": "帖子的分类id，默认是推荐分类"
            }
          },
          "required": []
        },
        "enabled": true
      },
      {
        "id": "83281e2d-4626-4ae1-9e5f-4f2f013621a6",
        "name": "getCurrentUser",
        "pattern": "/mcp/getCurrentUser",
        "description": "获取当前登录的小红书账号的详细信息",
        "handler": "async ({ moreInfo = false }) => {\n  const result = {};\n  try {\n    result['me'] = await XHSWEB_API.get('/api/sns/web/v2/user/me');\n    if (moreInfo) {\n      result['info'] = await XHSWEB_API.get(`/api/sns/web/v1/user/selfinfo`);\n    }\n  } catch (e) {\n    result['msg'] = '获取用户数据失败';\n    result['error'] = e.message;\n  }\n  return result;\n}",
        "inputSchema": {
          "type": "object",
          "properties": {
