import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import z from "zod";
import { convertMermaidToExcalidraw } from "../excalidraw/index.js";

export function createServer(): McpServer {
    const server = new McpServer({
        name: "excalidraw",
        version: "1.0.0",
        capabilities: {
            resources: {},
            tools: {},
        },
    });

    server.tool("draw-diagram",
        "Convert a mermaid diagram to an image and preview URL displaying the Excalidraw diagram",
        {
            diagram: z.string().describe("The mermaid diagram to convert"),
        },
        async ({diagram}) => {
            let result 
            try {
                result = await convertMermaidToExcalidraw(diagram)
            } catch (error) {
                console.error(error);
                return {
                    content: [
                        {
                            type: "text",
                            text: "Failed to export mermaid diagram: " + (error instanceof Error ? error.message : String(error)),
                        }
                    ]
                };
            }

            // Create an Excalidraw-compatible JSON structure
            const excalidrawData = {
                type: "excalidraw",
                version: 2,
                source: "https://excalidraw.com",
                elements: result.elements,
                appState: {
                    viewBackgroundColor: "#ffffff",
                },
                files: {}
            };

            // Send elements to the user app via simple API call
            const userAppPort = process.env.USER_APP_PORT || '8080';
            const userAppUrl = `http://localhost:${userAppPort}/user/`;
            
            try {
                const response = await fetch(`http://localhost:${userAppPort}/api/current-diagram`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        elements: excalidrawData.elements,
                        appState: excalidrawData.appState,
                        timestamp: Date.now()
                    }),
                });

                if (response.ok) {
                    console.log('✅ Elements sent to user Excalidraw app via API');
                } else {
                    console.warn('⚠️ Failed to send elements to user app via API');
                }
            } catch (error) {
                console.warn('⚠️ Could not send elements to user app via API:', error);
            }

            return {
                content: [
                    {
                        type: "text",
                        text: "Diagram created successfully!",
                    },
                    {
                        type: "text",
                        text: `🎨 View diagram in Excalidraw app: ${userAppUrl}`,
                    },
                    {
                        type: "image",
                        data: result.screenshot.toString('base64'),
                        mimeType: "image/png",
                    }
                ]
            };
        }
    );

    return server;
}

