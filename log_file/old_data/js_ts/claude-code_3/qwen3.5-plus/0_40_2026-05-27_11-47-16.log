1	#!/usr/bin/env node
2	import { config } from 'dotenv';
3	config();
4	import { HttpServer } from './httpServer.js';
5	import i18n from './i18n/index.js';
6	import { StdioServer } from './stdioServer.js';
7	export async function startServer() {
8	    const isServer = process.argv.includes('--server');
9	    i18n.language = process.env.LANGUAGE || 'zh';
10	    if (!process.env.RPA_MODEL) {
11	        process.env.RPA_MODEL = 'local';
12	    }
13	    if (isServer) {
14	        const server = new HttpServer();
15	        await server.start();
16	    }
17	    else {
18	        const server = new StdioServer();
19	        await server.start();
20	    }
21	}
22	if (process.argv[1]) {
23	    startServer().catch(error => {
24	        console.error("Failed to start server:", error);
25	        process.exit(1);
26	    });
27	    console.log('yingdao-mcp-server started');
28	}
