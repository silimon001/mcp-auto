5	export function createServer(): McpServer {
6	    const server = new McpServer({
7	        name: "excalidraw",
8	        version: "1.0.0",
9	        capabilities: {
10	            resources: {},
11	            tools: {},
12	        },
13	    });
14	
15	    server.tool("draw-diagram",
16	        "Convert a mermaid diagram to an image and preview URL displaying the Excalidraw diagram",
17	        {
18	            diagram: z.string().describe("The mermaid diagram to convert"),
19	        },
20	        async ({diagram}) => {
21	            let result 
22	            try {
23	                result = await convertMermaidToExcalidraw(diagram)
24	            } catch (error) {
25	                console.error(error);
26	                return {
27	                    content: [
28	                        {
29	                            type: "text",
30	                            text: "Failed to export mermaid diagram: " + (error instanceof Error ? error.message : String(error)),
31	                        }
32	                    ]
33	                };
34	            }
35	
36	            // Create an Excalidraw-compatible JSON structure
37	            const excalidrawData = {
38	                type: "excalidraw",
39	                version: 2,
40	                source: "https://excalidraw.com",
41	                elements: result.elements,
42	                appState: {
43	                    viewBackgroundColor: "#ffffff",
44	                },
45	                files: {}
46	            };
47	
48	            // Send elements to the user app via simple API call
49	            const userAppPort = process.env.USER_APP_PORT || '8080';
50	            const userAppUrl = `http://localhost:${userAppPort}/user/`;
51	            
52	            try {
53	                const response = await fetch(`http://localhost:${userAppPort}/api/current-diagram`, {
54	                    method: 'POST',
55	                    headers: {
56	                        'Content-Type': 'application/json',
57	                    },
58	                    body: JSON.stringify({
59	                        elements: excalidrawData.elements,
60	                        appState: excalidrawData.appState,
61	                        timestamp: Date.now()
62	                    }),
63	                });
64	
65	                if (response.ok) {
66	                    console.log('✅ Elements sent to user Excalidraw app via API');
67	                } else {
68	                    console.warn('⚠️ Failed to send elements to user app via API');
69	                }
70	            } catch (error) {
71	                console.warn('⚠️ Could not send elements to user app via API:', error);
72	            }
73	
74	            return {
75	                content: [
76	                    {
77	                        type: "text",
78	                        text: "Diagram created successfully!",
79	                    },
80	                    {
81	                        type: "text",
82	                        text: `🎨 View diagram in Excalidraw app: ${userAppUrl}`,
83	                    },
84	                    {
85	                        type: "image",
86	                        data: result.screenshot.toString('base64'),
87	                        mimeType: "image/png",
88	                    }
89	                ]
90	            };
91	        }
92	    );
93	
94	    return server;
95	}

