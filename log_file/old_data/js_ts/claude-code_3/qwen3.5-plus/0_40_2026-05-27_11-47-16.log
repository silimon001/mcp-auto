1	// silimon
2	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
3	import process from "node:process";
4	
5	interface LogNotification {
6	  jsonrpc: "2.0";
7	  method: "notifications/message";
8	  params: {
9	    level: "emergency" | "alert" | "critical" | "error" | "warning" | "notice" | "info" | "debug";
10	    logger?: string;
11	    data: any;
12	  };
13	}
14	
15	/**
16	 * Enhanced StdioServerTransport that wraps console output in valid JSON-RPC structures
17	 * instead of filtering them out. This prevents crashes while maintaining debug visibility.
18	 */
19	export class FilteredStdioServerTransport extends StdioServerTransport {
20	  private originalConsole: {
21	    log: typeof console.log;
22	    warn: typeof console.warn;
23	    error: typeof console.error;
24	    debug: typeof console.debug;
25	    info: typeof console.info;
26	  };
27	  private originalStdoutWrite: typeof process.stdout.write;
28	  private isInitialized: boolean = false;
29	  private messageBuffer: Array<{
30	    level: "emergency" | "alert" | "critical" | "error" | "warning" | "notice" | "info" | "debug";
31	    args: any[];
32	    timestamp: number;
33	  }> = [];
34	  private clientName: string = 'unknown';
35	  private disableNotifications: boolean = false;
36	
37	  constructor() {
38	    super();
39	    
40	    // Store original methods
41	    this.originalConsole = {
42	      log: console.log,
43	      warn: console.warn,
44	      error: console.error,
45	      debug: console.debug,
46	      info: console.info,
47	    };
48	    
49	    this.originalStdoutWrite = process.stdout.write;
50	    
51	    // Setup console redirection
52	    this.setupConsoleRedirection();
53	    
54	    // Setup stdout filtering for any other output
55	    this.setupStdoutFiltering();
56	    
57	    // Note: We defer the initialization notification until enableNotifications() is called
58	    // to ensure MCP protocol compliance - notifications must not be sent before initialization
59	  }
60	
61	  /**
62	   * Call this method after MCP initialization is complete to enable JSON-RPC notifications
63	   */
64	  public enableNotifications() {
65	    this.isInitialized = true;
66	    
67	    // Check if notifications should be disabled based on client
68	    if (this.disableNotifications) {
69	      // Clear buffer without sending - just log to stderr instead
70	      if (this.messageBuffer.length > 0) {
71	        process.stderr.write(`[INFO] ${this.messageBuffer.length} buffered messages suppressed for ${this.clientName}\n`);
72	      }
73	      this.messageBuffer = [];
74	      return;
75	    }
76	    
77	    // Send the deferred initialization notification first
78	    this.sendLogNotification('info', ['Enhanced FilteredStdioServerTransport initialized']);
79	    
80	    // Replay all buffered messages in chronological order
81	    if (this.messageBuffer.length > 0) {
82	      this.sendLogNotification('info', [`Replaying ${this.messageBuffer.length} buffered initialization messages`]);
83	      
84	      this.messageBuffer
85	        .sort((a, b) => a.timestamp - b.timestamp)
86	        .forEach(msg => {
87	          this.sendLogNotification(msg.level, msg.args);
88	        });
89	      
90	      // Clear the buffer
91	      this.messageBuffer = [];
92	    }
93	    
94	    this.sendLogNotification('info', ['JSON-RPC notifications enabled']);
95	  }
96	
97	  /**
98	   * Configure client-specific behavior
99	   * Call this BEFORE enableNotifications()
100	   */
101	  public configureForClient(clientName: string) {
102	    this.clientName = clientName.toLowerCase();
103	    
104	    // Detect Cline and disable notifications
105	    if (this.clientName.includes('cline') || 
106	        this.clientName.includes('vscode') ||
107	        this.clientName === 'claude-dev') {
108	      this.disableNotifications = true;
109	      process.stderr.write(`[INFO] Desktop Commander: Notifications disabled for ${clientName}\n`);
110	    }
111	  }
112	
113	  /**
114	   * Check if notifications are enabled
115	   */
116	  public get isNotificationsEnabled(): boolean {
117	    return this.isInitialized;
118	  }
119	
120	  /**
121	   * Get the current count of buffered messages
122	   */
123	  public get bufferedMessageCount(): number {
124	    return this.messageBuffer.length;
125	  }
126	
127	  private setupConsoleRedirection() {
128	    console.log = (...args: any[]) => {
129	      if (this.isInitialized) {
130	        this.sendLogNotification("info", args);
131	      } else {
132	        // Buffer for later replay to client
133	        this.messageBuffer.push({
134	          level: "info",
135	          args,
136	          timestamp: Date.now()
137	        });
138	      }
139	    };
140	
141	    console.info = (...args: any[]) => {
142	      if (this.isInitialized) {
143	        this.sendLogNotification("info", args);
144	      } else {
145	        this.messageBuffer.push({
146	          level: "info",
147	          args,
148	          timestamp: Date.now()
149	        });
150	      }
151	    };
152	
153	    console.warn = (...args: any[]) => {
154	      if (this.isInitialized) {
155	        this.sendLogNotification("warning", args);
156	      } else {
157	        this.messageBuffer.push({
158	          level: "warning",
159	          args,
160	          timestamp: Date.now()
161	        });
162	      }
163	    };
164	
165	    console.error = (...args: any[]) => {
166	      if (this.isInitialized) {
167	        this.sendLogNotification("error", args);
168	      } else {
169	        this.messageBuffer.push({
170	          level: "error",
171	          args,
172	          timestamp: Date.now()
173	        });
174	      }
175	    };
176	
177	    console.debug = (...args: any[]) => {
178	      if (this.isInitialized) {
179	        this.sendLogNotification("debug", args);
180	      } else {
181	        this.messageBuffer.push({
182	          level: "debug",
183	          args,
184	          timestamp: Date.now()
185	        });
186	      }
187	    };
188	  }
189	
190	  private setupStdoutFiltering() {
191	    process.stdout.write = (buffer: any, encoding?: any, callback?: any): boolean => {
192	      // Handle different call signatures
193	      if (typeof buffer === 'string') {
194	        const trimmed = buffer.trim();
195	        
196	        // Check if this looks like a valid JSON-RPC message
197	        if (trimmed.startsWith('{') && (
198	          trimmed.includes('"jsonrpc"') || 
199	          trimmed.includes('"method"') || 
200	          trimmed.includes('"id"')
201	        )) {
202	          // This looks like a valid JSON-RPC message, allow it
203	          return this.originalStdoutWrite.call(process.stdout, buffer, encoding, callback);
204	        } else if (trimmed.length > 0) {
205	          // Non-JSON-RPC output, wrap it in a log notification
206	          if (this.isInitialized) {
207	            this.sendLogNotification("info", [buffer.replace(/\n$/, '')]);
208	          } else {
209	            // Buffer for later replay to client
210	            this.messageBuffer.push({
211	              level: "info",
212	              args: [buffer.replace(/\n$/, '')],
213	              timestamp: Date.now()
214	            });
215	          }
216	          if (callback) callback();
217	          return true;
218	        }
219	      }
220	      
221	      // For non-string buffers or empty strings, let them through
222	      return this.originalStdoutWrite.call(process.stdout, buffer, encoding, callback);
223	    };
224	  }
225	
226	  private sendLogNotification(level: "emergency" | "alert" | "critical" | "error" | "warning" | "notice" | "info" | "debug", args: any[]) {
227	    // Skip if notifications are disabled (e.g., for Cline)
228	    if (this.disableNotifications) {
229	      return;
230	    }
231	    
232	    try {
233	      // For data, we can send structured data or string according to MCP spec
234	      let data: any;
235	      if (args.length === 1 && typeof args[0] === 'object' && args[0] !== null) {
236	        // Single object - send as structured data
237	        data = args[0];
238	      } else {
239	        // Multiple args or primitives - convert to string
240	        data = args.map(arg => {
241	          if (typeof arg === 'object') {
242	            try {
