34	// Cache implementation to store results and reduce Julia process spawns
35	class Cache<T> {
36	  private cache = new Map<string, { value: T; timestamp: number }>();
37	  private ttl: number;
38	
39	  constructor(ttlSeconds: number = 300) { // Default 5 minute TTL
40	    this.ttl = ttlSeconds * 1000; // Convert to milliseconds
41	  }
42	
43	  get(key: string): T | undefined {
44	    const item = this.cache.get(key);
45	    if (!item) return undefined;
46	    // Check if cache entry has expired
47	    if (Date.now() - item.timestamp > this.ttl) {
48	      this.cache.delete(key);
49	      return undefined;
50	    }
51	    return item.value;
52	  }
53	
54	  set(key: string, value: T): void {
55	    this.cache.set(key, { value, timestamp: Date.now() });
56	  }
57	}
