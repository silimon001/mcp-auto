258	
259	function getTopNearestPositions(positions, latitude, longitude, size = 10) {
260	  return getOrderedPositionsByDistance(positions, latitude, longitude).slice(
261	    0,
262	    size
263	  );
264	}
265	
266	function getOrderedPositionsByDistance(positions, latitude, longitude) {
267	  return positions
268	    .map((position) => {
269	      const distanceInMeters = haversineDistanceInMeters(
270	        { lat: latitude, lon: longitude },
271	        position
272	      );
273	      return {
274	        ...position,
275	        distanceInMeters,
276	      };
277	    })
278	    .sort((a, b) => a.distanceInMeters - b.distanceInMeters);
279	}
280	
281	function haversineDistanceInMeters(position1, position2) {
282	  const toRadians = (degrees) => degrees * (Math.PI / 180);
283	
284	  const radiusOfEarth = 6371;
285	  const dLat = toRadians(position2.lat - position1.lat);
286	  const dLon = toRadians(position2.lon - position1.lon);
287	
288	  const a =
289	    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
290	    Math.cos(toRadians(position1.lat)) *
291	      Math.cos(toRadians(position2.lat)) *
292	      Math.sin(dLon / 2) *
293	      Math.sin(dLon / 2);
294	
295	  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
296	  return radiusOfEarth * c * 1000;
297	}
