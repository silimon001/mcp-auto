23	export class FeishuMcpServer {
24	  private server: McpServer;
25	  private feishuClient: FeishuClient;
26	  private transport: Transport | null = null;
27	
28	  /**
29	   * 构造函数
30	   * @param appId 飞书应用ID
31	   * @param appSecret 飞书应用密钥
32	   */
33	  constructor(appId?: string, appSecret?: string) {
34	    // 创建飞书客户端
35	    this.feishuClient = new FeishuClient(appId, appSecret);
36	
37	    // 创建MCP服务器
38	    this.server = new McpServer({
39	      name: "飞书文档MCP服务",
40	      version: "1.0.0",
41	    }, {
42	      capabilities: {
43	        logging: {},
44	        tools: {},
45	      },
46	    });
47	
48	    // 注册工具
49	    this.registerTools();
50	  }
51	
52	  /**
53	   * 注册MCP工具
54	   */
55	  private registerTools() {
56	    const { feishuClient } = this;
57	
58	    // 列出文档空间
59	    this.server.tool(
60	      "list-spaces",
61	      "列出所有可用的飞书文档空间",
62	      {},
63	      async () => {
64	        try {
65	          const response = await feishuClient.getSpaces();
66	          const spaces = response.items || [];
67	          
68	          return {
69	            content: [
70	              {
71	                type: "text",
72	                text: JSON.stringify({
73	                  spaces: spaces.map(space => ({
74	                    id: space.space_id, 
75	                    name: space.name
76	                  }))
77	                })
78	              }
79	            ]
80	          };
81	        } catch (error: any) {
82	          Logger.error(`获取空间列表失败:`, error);
83	          return {
84	            isError: true,
85	            content: [
86	              { 
87	                type: "text", 
88	                text: `获取空间列表失败: ${error.message || '未知错误'}` 
89	              }
90	            ]
91	          };
92	        }
93	      }
94	    );
95	
96	    // 列出文档
97	    this.server.tool(
98	      "list-documents",
99	      "获取指定空间或所有空间的文档列表",
100	      {
101	        spaceId: z.string().optional().describe("空间ID，不提供则返回所有空间的文档")
102	      },
103	      async ({ spaceId }: { spaceId?: string }) => {
104	        try {
105	          let allDocuments: any[] = [];
106	
107	          if (spaceId) {
108	            // 获取指定空间的文档
109	            try {
110	              const response = await feishuClient.getNodes(spaceId);
111	              allDocuments = (response.items || []).map(node => ({
112	                id: node.node_token,
113	                name: node.title || 'Untitled',
114	                type: node.obj_type || 'Unknown',
115	                spaceId: spaceId
116	              }));
117	            } catch (error: any) {
118	              if (error.message?.includes('权限')) {
119	                return {
120	                  isError: true,
121	                  content: [{ type: "text", text: `无权访问空间(${spaceId})的文档` }]
122	                };
123	              }
124	              throw error;
125	            }
126	          } else {
127	            // 获取所有空间的文档
128	            const spacesResponse = await feishuClient.getSpaces();
129	            const spaces = spacesResponse.items || [];
130	            
131	            for (const space of spaces) {
132	              try {
133	                const response = await feishuClient.getNodes(space.space_id);
134	                const documents = (response.items || []).map(node => ({
135	                  id: node.node_token,
136	                  name: node.title || 'Untitled',
137	                  type: node.obj_type || 'Unknown',
138	                  spaceId: space.space_id,
139	                  spaceName: space.name
140	                }));
141	                allDocuments = [...allDocuments, ...documents];
142	              } catch (error: any) {
143	                // 跳过无法访问的空间
144	                if (!error.message?.includes('权限')) {
145	                  Logger.error(`获取空间(${space.space_id})的文档列表失败:`, error);
146	                }
147	              }
148	            }
149	          }
150	          
151	          return {
152	            content: [
153	              {
154	                type: "text",
155	                text: JSON.stringify({ documents: allDocuments })
156	              }
157	            ]
158	          };
159	        } catch (error: any) {
160	          Logger.error(`获取文档列表失败:`, error);
161	          return {
162	            isError: true,
163	            content: [
164	              { 
165	                type: "text", 
166	                text: `获取文档列表失败: ${error.message || '未知错误'}` 
167	              }
168	            ]
169	          };
170	        }
171	      }
172	    );
173	  }
