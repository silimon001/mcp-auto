279	  /**
280	   * Public method to send log notifications from anywhere in the application
281	   */
282	  public sendLog(level: "emergency" | "alert" | "critical" | "error" | "warning" | "notice" | "info" | "debug", message: string, data?: any) {
283	    // Skip if notifications are disabled (e.g., for Cline)
284	    if (this.disableNotifications) {
285	      return;
286	    }
287	    
288	    try {
