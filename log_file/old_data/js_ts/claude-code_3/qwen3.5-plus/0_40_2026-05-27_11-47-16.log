292	        params: {
293	          level: level,
294	          logger: "mcp-auto",
295	          data: data ? { message, ...data } : message
296	        }
297	      };
298	
299	      this.originalStdoutWrite.call(process.stdout, JSON.stringify(notification) + '\n');
300	    } catch (error) {
