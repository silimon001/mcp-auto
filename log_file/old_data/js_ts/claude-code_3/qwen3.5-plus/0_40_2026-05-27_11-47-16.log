90	  private findJuliaPath(): string {
91	    // First check if explicitly set via env var
92	    if (process.env.JULIA_PATH) {
93	      return process.env.JULIA_PATH;
94	    }
95	
96	    const home = homedir();
97	    const commonPaths = [
98	      // Juliaup installation (most common)
99	      `${home}/.juliaup/bin/julia`,
100	      // Homebrew installation
101	      '/opt/homebrew/bin/julia',
102	      // Manual installation
103	      '/Applications/Julia-1.9.app/Contents/Resources/julia/bin/julia',
104	      // System-wide installation
105	      '/usr/local/bin/julia'
106	    ];
107	
108	    // Check common installation paths
109	    for (const path of commonPaths) {
110	      if (existsSync(path)) {
111	        console.error(`Found Julia at: ${path}`);
112	        return path;
113	      }
114	    }
115	
116	    // Fall back to PATH-based julia
117	    console.error('Falling back to Julia from system PATH');
118	    return 'julia';
119	  }
120	
121	  private async verifyJuliaInstallation(): Promise<void> {
122	    try {
123	      const { stdout } = await execAsync(`${this.juliaPath} --version`);
124	      console.error(`Found Julia: ${stdout.trim()}`);
125	    } catch (error) {
126	      console.error('Failed to find Julia installation:', error);
127	      throw new Error(
128	        'Julia not found. Please ensure Julia is installed and either:\n' +
129	        '1. Add Julia to your PATH, or\n' +
130	        '2. Set JULIA_PATH environment variable to point to your Julia executable'
131	      );
132	    }
133	  }
134	
135	  private async runJuliaCommand(code: string, packageName?: string): Promise<string> {
136	    try {
137	      let fullCode = '';
138	      
139	      // Add package loading if specified
140	      if (packageName) {
141	        fullCode += `using ${packageName}; `;
142	      }
143	
144	      // Add the main code
145	      fullCode += code;
146	      
147	      // Properly escape the code for the -e flag
148	      // Replace single quotes with '\'' for shell escaping
149	      const escapedCode = fullCode.replace(/'/g, "'\\''");
150	      
151	      // Properly quote the project path if specified
152	      const projectFlag = this.projectPath ? 
153	        `--project='${this.projectPath.replace(/'/g, "'\\''")}'` : 
154	        '';
155	      
156	      // Construct the full command
157	      const command = `${this.juliaPath} ${projectFlag} -e '${escapedCode}'`;
158	      
159	      console.error(`Executing command: ${command}`);
160	      
161	      // Execute with explicit environment
162	      const { stdout, stderr } = await execAsync(command, {
163	        env: {
164	          ...process.env,
165	          // Ensure JULIA_PROJECT is set in the environment
166	          JULIA_PROJECT: this.projectPath || '',
167	          // Preserve other important Julia env vars
168	          JULIA_DEPOT_PATH: process.env.JULIA_DEPOT_PATH,
169	          JULIA_LOAD_PATH: process.env.JULIA_LOAD_PATH,
170	          PATH: process.env.PATH,
171	        }
172	      });
173	      
174	      console.error('Command output:', stdout, stderr);
175	      
176	      if (stderr) {
177	        // Run diagnostics when we hit an error to help debug
178	        const diagnosticCommand = `${this.juliaPath} ${projectFlag} -e 'println("Active project: ", Base.active_project()); println("DEPOT_PATH: ", DEPOT_PATH); using Pkg; println("Installed packages:"); Pkg.status()'`;
179	        console.error('Running diagnostics:', diagnosticCommand);
180	        const { stdout: diagnosticOutput } = await execAsync(diagnosticCommand);
181	        
182	        if (stderr.includes("Package") && stderr.includes("not found in current path")) {
183	          throw new Error(
184	            `Package ${packageName} not found in the current project environment.\n` +
185	            `Environment Info:\n${diagnosticOutput}\n` +
186	            `If using a custom project (JULIA_PROJECT), make sure to add the package first:\n` +
187	            `julia> using Pkg; Pkg.add("${packageName}")`
188	          );
189	        } else if (stderr.includes("could not load package")) {
190	          throw new Error(`Package not found: ${stderr}\n${diagnosticOutput}`);
191	        } else if (stderr.includes("not found")) {
192	          throw new Error(`Symbol not found: ${stderr}\n${diagnosticOutput}`);
193	        } else if (stderr.includes("UndefVarError")) {
194	          throw new Error(`Package not loaded. Try installing the package first.\n${diagnosticOutput}`);
195	        }
196	        throw new Error(`${stderr}\n${diagnosticOutput}`);
197	      }
198	      
199	      if (!stdout.trim()) {
200	        throw new Error("No documentation found");
201	      }
202	      
203	      return stdout.trim();
204	    } catch (error) {
205	      console.error(`Julia command error:`, error);
206	      if (error instanceof Error) {
207	        if (error.message.includes("ENOENT")) {
208	          throw new Error("Julia executable not found. Please ensure Julia is installed and in your PATH.");
209	        }
210	        throw new Error(`Julia error: ${error.message}`);
211	      }
212	      throw error;
213	    }
214	  }
