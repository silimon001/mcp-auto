8	import { logger } from './utils/logger.js';
9	
10	import { existsSync } from "node:fs";
11	import { mkdir } from "node:fs/promises";
12	import { parseArgs } from "node:util";
13	import { globalAgent } from 'node:http';
14	
15	import fs from "fs";
16	import path from "path";
17	
18	const { values } = parseArgs({
19	  options: {
20	    mcpServerConfigDir: { type: "string" },
21	    serverPath: {type: "string"},
22	    pythonPath: {type: "string"}
23	  }
24	});
25	
26	if (!values.mcpServerConfigDir || !values.serverPath || !values.pythonPath) {
27	  console.error("ERROR: Missing some required arguments. --mcpServerConfigDir --serverPath --pythonPath");
28	  process.exit(1);
29	}
30	
31	
32	try {
33	  global.cwd = values.serverPath;
34	  global.pythonPath = values.pythonPath;
35	  global.configDir = values.mcpServerConfigDir;
36	  if (!existsSync(values.mcpServerConfigDir)) {
37	    await mkdir(values.mcpServerConfigDir, { recursive: true });
38	  }
39	} catch (error) {
40	  console.error(error);
41	  process.exit(1);
42	}
43	
44	// Store messages to defer until after initialization
45	const deferredMessages: Array<{level: string, message: string}> = [];
46	function deferLog(level: string, message: string) {
47	    deferredMessages.push({level, message});
48	}
49	
50	async function runServer(configDir: string) {
51	  try {
52	      try {
53	          deferLog('info', 'Loading configuration...');
54	          await configManager.loadConfig();
55	          deferLog('info', 'Configuration loaded successfully');
56	      } catch (configError) {
57	          deferLog('error', `Failed to load configuration: ${configError instanceof Error ? configError.message : String(configError)}`);
58	          if (configError instanceof Error && configError.stack) {
59	              deferLog('debug', `Stack trace: ${configError.stack}`);
60	          }
61	          deferLog('warning', 'Continuing with in-memory configuration only');
62	          // Continue anyway - we'll use an in-memory config
63	      }
64	
65	    const transport = new FilteredStdioServerTransport();
66	    
67	    // Export transport for use throughout the application
68	    global.mcpTransport = transport;
69	    // Handle uncaught exceptions
70	    process.on('uncaughtException', async (error) => {
71	      const errorMessage = error instanceof Error ? error.message : String(error);
72	
73	      // If this is a JSON parsing error, log it to stderr but don't crash
74	      if (errorMessage.includes('JSON') && errorMessage.includes('Unexpected token')) {
75	        logger.error(`JSON parsing error: ${errorMessage}`);
76	        return; // Don't exit on JSON parsing errors
77	      }
78	
79	      logger.error(`Uncaught exception: ${errorMessage}`);
80	      process.exit(1);
81	    });
82	
83	    // Handle unhandled rejections
84	    process.on('unhandledRejection', async (reason) => {
85	      const errorMessage = reason instanceof Error ? reason.message : String(reason);
86	
87	      // If this is a JSON parsing error, log it to stderr but don't crash
88	      if (errorMessage.includes('JSON') && errorMessage.includes('Unexpected token')) {
89	        logger.error(`JSON parsing rejection: ${errorMessage}`);
90	        return; // Don't exit on JSON parsing errors
91	      }
92	
93	      logger.error(`Unhandled rejection: ${errorMessage}`);
94	      process.exit(1);
95	    });
96	
97	    deferLog('info', 'Connecting server...');
98	
99	    // Set up event-driven initialization completion handler
100	    server.oninitialized = () => {
101	      // This callback is triggered after the client sends the "initialized" notification
102	      // At this point, the MCP protocol handshake is fully complete
103	      transport.enableNotifications();
104	      
105	      // Flush all deferred messages from both index.ts and server.ts
106	      while (deferredMessages.length > 0) {
107	        const msg = deferredMessages.shift()!;
108	        transport.sendLog('info', msg.message);
109	      }
110	      flushDeferredMessages();
111	      
112	      // Now we can send regular logging messages
113	      transport.sendLog('info', 'Server connected successfully');
114	      transport.sendLog('info', 'MCP fully initialized, all startup messages sent');
115	    };
116	
117	    await server.connect(transport);
118	  } catch (error) {
119	    const errorMessage = error instanceof Error ? error.message : String(error);
120	    logger.error(`FATAL ERROR: ${errorMessage}`);
121	    if (error instanceof Error && error.stack) {
122	      logger.debug(error.stack);
123	    }
124	    
125	    // Send a structured error notification
126	    const errorNotification = {
127	      jsonrpc: "2.0" as const,
128	      method: "notifications/message",
129	      params: {
130	        level: "error",
131	        logger: "mcp-auto",
132	        data: `Failed to start server: ${errorMessage} (${new Date().toISOString()})`
133	      }
134	    };
135	    process.stdout.write(JSON.stringify(errorNotification) + '\n');
136	
137	    process.exit(1);
138	  }
139	}
140	
141	runServer(values.mcpServerConfigDir).catch(async (error) => {
142	  const errorMessage = error instanceof Error ? error.message : String(error);
143	  console.error(`RUNTIME ERROR: ${errorMessage}`);
144	  console.error(error instanceof Error && error.stack ? error.stack : 'No stack trace available');
145	  process.stderr.write(JSON.stringify({
146	    type: 'error',
147	    timestamp: new Date().toISOString(),
148	    message: `Fatal error running server: ${errorMessage}`
149	  }) + '\n');
150	
151	  process.exit(1);
152	});

