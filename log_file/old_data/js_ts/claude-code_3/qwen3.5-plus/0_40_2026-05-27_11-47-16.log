1	#!/usr/bin/env node
2	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
3	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
4	import { ListToolsRequestSchema, CallToolRequestSchema, ErrorCode, McpError } from "@modelcontextprotocol/sdk/types.js";
5	import dotenv from "dotenv";
6	import { isValidImageGenerationArgs } from "./types.js";
7	import { ImageGenerator } from "./image-generator.js";
8	import { FileSaver } from "./file-saver.js";
9	dotenv.config();
10	const imageSaver = FileSaver.CreateDesktopFileSaver('generated-images');
11	class ImageGeneratorServer {
12	    server;
13	    constructor() {
14	        this.server = new Server({
15	            name: "image-generator",
16	            version: "0.1.0"
17	        }, {
18	            capabilities: {
19	                resources: {},
20	                tools: {}
21	            }
22	        });
23	        this.setupToolHandlers();
24	        this.setupErrorHandling();
25	    }
26	    setupErrorHandling() {
27	        this.server.onerror = (error) => {
28	            console.error("[MCP Error]", error);
29	        };
30	        process.on('SIGINT', async () => {
31	            await this.server.close();
32	            process.exit(0);
33	        });
34	    }
35	    setupToolHandlers() {
36	        this.server.setRequestHandler(ListToolsRequestSchema, async () => ({
37	            tools: [{
38	                    name: "generate_image",
39	                    description: "Generate an image from a prompt.",
40	                    inputSchema: {
41	                        type: "object",
42	                        properties: {
43	                            prompt: {
44	                                type: "string",
45	                                description: "A prompt detailing what image to generate."
46	                            },
47	                            imageName: {
48	                                type: "string",
49	                                description: "The filename for the image excluding any extensions."
50	                            }
51	                        },
52	                        required: ["prompt", "imageName"]
53	                    }
54	                }]
55	        }));
56	        this.server.setRequestHandler(CallToolRequestSchema, async (request) => {
57	            if (request.params.name !== "generate_image") {
58	                throw new McpError(ErrorCode.MethodNotFound, `Unknown tool: ${request.params.name}`);
59	            }
60	            if (!isValidImageGenerationArgs(request.params.arguments)) {
61	                throw new McpError(ErrorCode.InvalidParams, "Invalid image generation arguments");
62	            }
63	            ;
64	            const { prompt, imageName } = request.params.arguments;
65	            const base64 = await new ImageGenerator().generateImage(prompt);
66	            const fileName = `${imageName.replace(/\..*$/, '')}.png`;
67	            const filepath = await imageSaver.saveBase64(fileName, base64);
68	            return {
69	                toolResult: {
70	                    uri: `file://${filepath}`,
71	                    type: 'image',
72	                    mimeType: 'image/png'
73	                }
74	            };
75	        });
76	    }
77	    async run() {
78	        const transport = new StdioServerTransport();
79	        await this.server.connect(transport);
80	        // Although this is just an informative message, we must log to stderr,
81	        // to avoid interfering with MCP communication that happens on stdout
82	        console.error("Weather MCP server running on stdio");
83	    }
84	}
85	const server = new ImageGeneratorServer();
86	server.run().catch(console.error);
