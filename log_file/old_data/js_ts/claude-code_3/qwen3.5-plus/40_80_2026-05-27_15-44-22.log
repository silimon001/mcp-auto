133	// Handle DELETE requests for session termination
134	app.delete('/mcp', async (req: express.Request, res: express.Response) => {
135	    const sessionId = req.headers['mcp-session-id'] as string | undefined;
136	
137	    if (!sessionId || !transports[sessionId]) {
138	        res.status(400).send('Invalid or missing session ID for DELETE');
139	        return;
140	    }
141	
142	    const transport = transports[sessionId];
143	    const mcpServer = mcpServers[sessionId];
144	
145	    try {
146	        await transport.handleRequest(req, res);
147	    } catch (error) {
148	        console.error(`[DELETE /mcp] Error during DELETE handling:`, error);
149	        if (!res.headersSent) {
150	            res.status(500).send('Internal server error during session termination.');
151	        }
152	    } finally {
153	        if (mcpServer) {
154	            mcpServer.close();
155	        }
156	        if (transport) {
157	            transport.close();
158	        }
159	        if (sessionId) {
160	            delete transports[sessionId];
161	            delete mcpServers[sessionId];
162	        }
163	        if (!res.headersSent) {
164	            res.status(204).send();
165	        } else if (!res.writableEnded) {
166	            res.end();
167	        }
168	    }
169	});
