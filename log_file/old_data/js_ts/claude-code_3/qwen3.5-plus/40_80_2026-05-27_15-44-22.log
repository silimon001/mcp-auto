388	export async function requireApiToken(c: Context, next: () => Promise<void>) {
389	  const authHeader = c.req.header("Authorization");
390	  if (!authHeader || !authHeader.startsWith("Bearer ")) {
391	    return c.json({ error: "API token required" }, 401);
392	  }
393	
394	  const token = authHeader.substring(7);
395	  const auth = new Auth(c.env as Env);
396	  const validation = await auth.validateApiToken(token);
397	
398	  if (!validation.valid) {
399	    return c.json({ error: "Invalid API token" }, 401);
400	  }
401	
402	  if (validation.tokenId) {
403	    await auth.updateTokenLastUsed(validation.tokenId);
404	  }
405	
406	  (c as any).set("tokenUser", { email: validation.userEmail });
407	  return next();
408	}
