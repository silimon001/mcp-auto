150	
151	    private async findWindow(id: string, pid: number): Promise<Window> {
152	        let window: Window | null = null
153	        let attempts = 0
154	        while (!window && attempts < 10) {
155	            await new Promise(resolve => setTimeout(resolve, 500))
156	            window = await this.windowsApi.findWindowByProcessId(pid, { initialCreation: true })
157	            attempts++
158	        }
