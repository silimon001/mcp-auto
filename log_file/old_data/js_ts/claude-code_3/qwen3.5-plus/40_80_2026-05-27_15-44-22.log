3	import { Request, Response, NextFunction } from 'express';
4	import { MCP_TOKEN } from './config.js';
5	
6	// Mandatory API key check for MCP requests
7	export const mcpAuthMiddleware = (req: Request, res: Response, next: NextFunction) => {
8	    if (!MCP_TOKEN) {
9	        console.error(`[Auth] CRITICAL: MCP_TOKEN not set`);
10	        return res.status(500).json({
11	            error: 'Server misconfiguration: Authentication token not configured',
12	        });
13	    }
14	
15	    // Check for token in Authorization header (Bearer token)
16	    const authHeader = req.headers['authorization'];
17	    const headerToken = authHeader?.startsWith('Bearer ')
18	        ? authHeader.substring(7)
19	        : null;
20	
21	    // Check for token in query parameter
22	    const queryToken = req.query.token as string;
23	
24	    // Check for token in request body
25	    const bodyToken = req.body?.token as string;
26	
27	    const providedToken = headerToken || queryToken || bodyToken;
28	
29	    if (!providedToken || providedToken !== MCP_TOKEN) {
30	        console.log(`[Auth] Authentication failed for ${req.method} ${req.path}`);
31	        return res.status(401).json({
32	            error: 'Unauthorized - Invalid or missing authentication token',
33	            hint: 'Provide token via Authorization header (Bearer <token>), query parameter (?token=<token>), or request body ({"token": "<token>"})',
34	        });
35	    }
36	
37	    next();
38	};
39	
