34	// Handle POST requests for client-to-server communication
35	app.post('/mcp', async (req, res) => {
36	    const sessionId = req.headers['mcp-session-id'] as string | undefined;
37	    
38	    let transport: StreamableHTTPServerTransport;
39	    let mcpServer: McpServer;
40	
41	    if (sessionId && transports[sessionId] && mcpServers[sessionId]) {
42	        transport = transports[sessionId];
43	        mcpServer = mcpServers[sessionId];
44	    } else {
45	        // Create new session
46	        const newSessionId = randomUUID();
47	
48	        transport = new StreamableHTTPServerTransport({
49	            sessionIdGenerator: () => newSessionId,
50	            onsessioninitialized: (sId) => {
51	                transports[sId] = transport;
52	                mcpServers[sId] = mcpServer;
53	            },
54	        });
55	
56	        mcpServer = new McpServer({
57	            name: 'SilverBullet MCP',
58	            version: '0.1.0',
59	        });
60	        configureMcpServerInstance(mcpServer);
61	
62	        transport.onclose = () => {
63	            if (transport.sessionId) {
64	                delete transports[transport.sessionId];
65	                delete mcpServers[transport.sessionId];
66	                mcpServer.close();
67	            }
68	        };
69	
70	        await mcpServer.connect(transport);
71	    }
72	
73	    try {
74	        await transport.handleRequest(req, res, req.body);
75	    } catch (error) {
76	        console.error(`[POST /mcp] Error handling MCP request:`, error);
77	        if (!res.headersSent) {
78	            res.status(500).json({
79	                jsonrpc: '2.0',
80	                error: {
81	                    code: -32603,
82	                    message: 'Internal server error during request handling.',
83	                },
84	                id: req.body?.id || null,
85	            });
86	        }
87	    }
88	});
89	
90	// Reusable handler for GET and DELETE requests
91	const handleSessionRequest = async (
92	    req: express.Request,
93	    res: express.Response
94	) => {
95	    const sessionId = req.headers['mcp-session-id'] as string | undefined;
96	
97	    if (!sessionId || !transports[sessionId]) {
98	        res.status(400).send('Invalid or missing session ID');
