3	// Use ES modules since package.json has "type": "module"
4	import { fileURLToPath } from 'url';
5	import { dirname, join } from 'path';
6	import { spawn } from 'child_process';
7	
8	// Get the directory of the current module
9	const __filename = fileURLToPath(import.meta.url);
10	const __dirname = dirname(__filename);
11	
12	// Path to the built main.js file
13	const mainPath = join(__dirname, '../build/src/main.js');
14	
15	// Log startup information
16	console.log('Starting Sensei MCP server...');
17	console.log(`Executing: ${mainPath}`);
18	
19	// Run the main application
20	const child = spawn('node', [mainPath], { 
21	  stdio: 'inherit',
22	  env: {
23	    ...process.env,
24	    // Set log level to info by default
25	    LOG_LEVEL: process.env.LOG_LEVEL || 'INFO'
26	  }
27	});
28	
29	// Handle errors
30	child.on('error', (error) => {
31	  console.error(`Failed to start sensei-mcp: ${error.message}`);
32	  process.exit(1);
33	});
34	
35	// Handle process exit
36	child.on('close', (code) => {
37	  if (code !== 0) {
38	    console.error(`sensei-mcp exited with code ${code}`);
39	  }
40	  process.exit(code || 0);
41	}); 

