262	export const mcpOAuthTokenHandler = async (c: Context<{ Bindings: Env }>) => {
263	  try {
264	    const contentType = c.req.header("Content-Type");
265	    let grantType: string,
266	      code: string,
267	      redirectUri: string,
268	      clientId: string,
269	      clientSecret: string,
270	      codeVerifier: string;
271	
272	    if (contentType?.includes("application/x-www-form-urlencoded")) {
273	      const formData = await c.req.formData();
274	      grantType = formData.get("grant_type") as string;
275	      code = formData.get("code") as string;
276	      redirectUri = formData.get("redirect_uri") as string;
277	      clientId = formData.get("client_id") as string;
278	      clientSecret = formData.get("client_secret") as string;
279	      codeVerifier = formData.get("code_verifier") as string;
280	    } else {
281	      const body = await c.req.json();
282	      ({
283	        grant_type: grantType,
284	        code,
285	        redirect_uri: redirectUri,
286	        client_id: clientId,
287	        client_secret: clientSecret,
288	        code_verifier: codeVerifier,
289	      } = body);
290	    }
291	
292	    if (!clientId || !clientSecret) {
293	      const authHeader = c.req.header("Authorization");
294	      if (authHeader && authHeader.startsWith("Basic ")) {
295	        try {
296	          const base64Credentials = authHeader.slice(6); // Remove "Basic " prefix
297	          const credentials = atob(base64Credentials);
298	          const [headerClientId, headerClientSecret] = credentials.split(
299	            ":",
300	            2,
301	          );
302	
303	          if (headerClientId && headerClientSecret) {
304	            clientId = clientId || headerClientId;
305	            clientSecret = clientSecret || headerClientSecret;
306	          }
307	        } catch (error) {
308	          Logger.warn("Failed to parse Authorization header", {
309	            error: (error as Error).message,
310	          });
311	        }
312	      }
313	    }
314	
315	    Logger.lazyDebug(
316	      () =>
317	        `MCP OAuth token request ${JSON.stringify({
318	          grantType,
319	          clientId,
320	          redirectUri,
321	          hasCode: !!code,
322	          hasClientSecret: !!clientSecret,
323	          hasCodeVerifier: !!codeVerifier,
324	        })}`,
325	    );
326	
327	    if (grantType !== "authorization_code") {
328	      Logger.warn("Invalid grant type", { grantType });
329	      return c.json({ error: "unsupported_grant_type" }, 400);
330	    }
331	
332	    if (!code || !redirectUri || !clientId || !clientSecret) {
333	      Logger.warn("Missing required parameters", {
334	        hasCode: !!code,
335	        hasRedirectUri: !!redirectUri,
336	        hasClientId: !!clientId,
337	        hasClientSecret: !!clientSecret,
338	      });
339	      return c.json({ error: "invalid_request" }, 400);
340	    }
341	
342	    const mcpOAuth = new MCPOAuth(c.env);
343	
344	    const client = await mcpOAuth.validateClient(clientId, clientSecret);
345	    if (!client) {
346	      Logger.warn("Client validation failed", { clientId });
347	      return c.json({ error: "invalid_client" }, 401);
348	    }
349	
350	    Logger.lazyDebug(
351	      () =>
352	        `Client validated successfully ${JSON.stringify({
353	          clientId,
354	          clientName: client.clientName,
355	        })}`,
356	    );
357	
358	    const authResult = await mcpOAuth.validateAndConsumeAuthorizationCode(
359	      code,
360	      clientId,
361	      redirectUri,
362	      codeVerifier,
363	    );
364	    if (!authResult) {
365	      Logger.warn("Authorization code validation failed", {
366	        code,
367	        clientId,
368	        redirectUri,
369	        hasCodeVerifier: !!codeVerifier,
370	      });
371	      return c.json({ error: "invalid_grant" }, 400);
372	    }
373	
374	    Logger.lazyDebug(
375	      () =>
376	        `Authorization code validated successfully ${JSON.stringify({
377	          userEmail: authResult.userEmail,
378	          scopes: authResult.scopes,
379	        })}`,
380	    );
381	
382	    const accessToken = await mcpOAuth.generateMCPAccessToken(
383	      authResult.userEmail,
384	      clientId,
385	      authResult.scopes,
386	    );
387	
388	    Logger.info("MCP OAuth token generated successfully", {
389	      clientId,
390	      userEmail: authResult.userEmail,
391	    });
392	
393	    return c.json({
394	      access_token: accessToken,
395	      token_type: "Bearer",
396	      expires_in: 30 * 24 * 60 * 60,
397	      scope: authResult.scopes.join(" "),
398	    });
399	  } catch (error) {
400	    Logger.error("MCP OAuth token error", {
401	      error: (error as Error).message,
402	      stack: (error as Error).stack,
403	    });
404	    return c.json({ error: "server_error" }, 500);
405	  }
406	};
