1	// Main entry point for the OpenAI SDK Knowledge MCP Server
2	// This Cloudflare Worker provides an MCP server with RAG capabilities for OpenAI SDK knowledge
3	// Documentation: https://developers.cloudflare.com/workers/runtime-apis/handlers/
4	
5	import {
6	  getGlobalTraceProvider,
7	  setDefaultOpenAITracingExporter,
8	} from "@openai/agents";
9	import type { MessageBatch } from "@cloudflare/workers-types";
10	
11	import { Env } from "@/env";
12	import { JobProcessor } from "@/pipeline/job-processor";
13	import { Logger } from "@/logger";
14	import { app } from "@/server";
15	
16	// Default export required by Cloudflare Workers
17	export default {
18	  // HTTP request handler - processes all incoming HTTP requests
19	  // https://developers.cloudflare.com/workers/runtime-apis/handlers/fetch/
20	  async fetch(
21	    request: Request,
22	    env: Env,
23	    ctx: ExecutionContext,
24	  ): Promise<Response> {
25	    setDefaultOpenAITracingExporter();
26	    try {
27	      // Delegate to Hono app for request handling
28	      return await app.fetch(request, env, ctx);
29	    } finally {
30	      // Flush OpenAI Agents SDK traces before response completes
31	      // This ensures telemetry data is properly sent to OpenAI
32	      // https://openai.github.io/openai-agents-js/guides/tracing
33	      ctx.waitUntil(
34	        (async () => {
35	          await getGlobalTraceProvider().forceFlush();
36	          Logger.lazyDebug(() => "OpenAI Agents SDK traces flushed");
37	        })(),
38	      );
39	    }
40	  },
41	
42	  // Queue handler - processes background jobs via Cloudflare Queues
43	  // https://developers.cloudflare.com/queues/
44	  async queue(
45	    batch: MessageBatch<{ jobId: number }>,
46	    env: Env,
47	    ctx: ExecutionContext,
48	  ) {
49	    setDefaultOpenAITracingExporter();
50	    try {
51	      Logger.info(`Processing job queue`, {
52	        batch: batch.messages.map((msg) => msg.body.jobId),
53	      });
54	
55	      // Process each job in the batch sequentially
56	      // Jobs handle data collection from GitHub API and OpenAI forum
57	      const processor = new JobProcessor(env);
58	      for (const msg of batch.messages) {
59	        await processor.processJob(msg.body.jobId);
60	      }
61	    } finally {
62	      // Flush OpenAI Agents SDK traces before response completes
63	      // This ensures telemetry data is properly sent to OpenAI
64	      // https://openai.github.io/openai-agents-js/guides/tracing
65	      ctx.waitUntil(
66	        (async () => {
67	          await getGlobalTraceProvider().forceFlush();
68	          Logger.lazyDebug(() => "OpenAI Agents SDK traces flushed");
69	        })(),
70	      );
71	    }
72	  },
73	};
74	

