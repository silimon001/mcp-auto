87	            cursorProcess.on('exit', (code: number | null) => {
88	                console.log('Process exited for instance', id, 'with code:', code)
89	                instance.isActive = false
90	                this.instances.delete(id)
91	
92	                // Provide more helpful error message based on exit code
93	                if (code === 0) {
