11	
12	const app = express();
13	app.use(express.json());
14	
15	// Map to store transports by session ID
16	const transports: { [sessionId: string]: StreamableHTTPServerTransport } = {};
17	// Map to store MCP server instances by session ID
18	const mcpServers: { [sessionId: string]: McpServer } = {};
19	
20	// Default route - no authentication required
21	app.get('/', (req, res) => {
22	    res.json({
23	        service: 'SilverBullet MCP Server',
24	        version: '0.1.0',
25	        status: 'running',
26	        authentication: 'required for /mcp routes',
27	        timestamp: new Date().toISOString(),
28	    });
29	});
30	
31	// Apply auth middleware to all /mcp routes only
32	app.use('/mcp', mcpAuthMiddleware);
