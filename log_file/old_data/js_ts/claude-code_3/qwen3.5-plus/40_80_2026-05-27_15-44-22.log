1	// SilverBullet API interaction functions
2	
3	import { SB_API_BASE_URL, SB_AUTH_TOKEN } from './config.js';
4	import type { SBFile, NoteInfo } from './types.js';
5	
6	const createFetchHeaders = (): HeadersInit => {
7	    const headers: HeadersInit = {
8	        'X-Sync-Mode': 'true',
9	    };
10	    if (SB_AUTH_TOKEN) {
11	        headers['Authorization'] = `Bearer ${SB_AUTH_TOKEN}`;
12	    }
13	    return headers;
14	};
15	
16	const handleFetchError = (url: string, error: unknown): never => {
17	    console.error(`[API] Fetch failed for ${url}:`, error);
18	    throw new Error(
19	        `Failed to connect to SilverBullet API at ${url}: ${
20	            error instanceof Error ? error.message : String(error)
21	        }`
22	    );
23	};
24	
25	const handleResponseError = async (url: string, response: Response, context: string): Promise<never> => {
26	    const responseText = await response.text();
27	    console.error(`[API] Error response body for ${context} (first 500 chars): ${responseText.substring(0, 500)}`);
28	    throw new Error(`Failed ${context} from SilverBullet API (${url}): ${response.status} ${response.statusText}`);
29	};
30	
31	export async function listNotesAPI(): Promise<NoteInfo[]> {
32	    const url = `${SB_API_BASE_URL}/.fs`;
33	    const fetchHeaders = createFetchHeaders();
34	
35	    let response: Response;
36	    try {
37	        response = await fetch(url, { headers: fetchHeaders });
38	    } catch (error) {
39	        handleFetchError(url, error);
40	    }
41	
42	    if (!response!.ok) {
43	        await handleResponseError(url, response!, 'to list notes');
44	    }
45	
46	    const responseClone = response!.clone();
47	
48	    try {
49	        const files: SBFile[] = await response!.json();
50	        return files
51	            .filter((f) => f.name.endsWith('.md') && !f.name.startsWith('Library'))
52	            .map((f) => ({ name: f.name, perm: f.perm }));
53	    } catch (error) {
54	        console.error(`[listNotesAPI] Failed to parse JSON response:`, error);
55	
56	        try {
57	            const responseText = await responseClone.text();
58	            console.error(`[listNotesAPI] Response body (first 500 chars): ${responseText.substring(0, 500)}`);
59	        } catch (textError) {
60	            console.error(`[listNotesAPI] Could not read response body as text:`, textError);
61	        }
62	
63	        throw new Error(
64	            `Failed to parse JSON response from SilverBullet API: ${
65	                error instanceof Error ? error.message : String(error)
66	            }`
67	        );
68	    }
69	}
70	
71	export async function getFullFileListingAPI(): Promise<SBFile[]> {
72	    const url = `${SB_API_BASE_URL}/.fs`;
73	    const fetchHeaders = createFetchHeaders();
74	
