49	        }
50	
51	        this.instances.set(id, instance)
52	
53	        // Create a promise that resolves when the window is found or rejects on error
54	        const windowPromise = new Promise<Window>((resolve, reject) => {
55	            let errorOutput = ''
56	            let attempts = 0
57	            const maxAttempts = 10
58	            const checkInterval = 500 // ms
59	
60	            // Handle process events
61	            cursorProcess.on('error', (error: Error) => {
62	                console.error('Process error:', error)
63	                instance.isActive = false
64	                reject(new Error(`Failed to start Cursor process: ${error.message}`))
65	            })
66	
67	            // Log stdout and stderr
68	            cursorProcess.stdout?.on('data', (data: Buffer) => {
69	                const output = data.toString()
70	                console.log('Process stdout for instance', id + ':', output)
71	            })
72	
73	            cursorProcess.stderr?.on('data', (data: Buffer) => {
74	                const error = data.toString()
75	                console.error('Process stderr for instance', id + ':', error)
76	                errorOutput += error
77	
78	                // Check for specific error conditions
79	                if (error.includes('Cannot find module')) {
80	                    const moduleName = error.match(/Cannot find module '([^']+)'/)?.[1]
81	                    if (moduleName) {
82	                        reject(new Error(`Cursor is missing required module: ${moduleName}. Please ensure Cursor is installed correctly with all dependencies.`))
83	                    }
