10	export const mcpWellKnownHandler = async (c: Context<{ Bindings: Env }>) => {
11	  try {
12	    console.log("mcpWellKnownHandler", c.req.url);
13	    const baseUrl = new URL(c.req.url).origin;
14	    const mcpOAuth = new MCPOAuth(c.env);
15	    const metadata = await mcpOAuth.getServerMetadata(baseUrl);
16	    return c.json(metadata);
17	  } catch (error) {
18	    Logger.error("OAuth metadata error", { error: (error as Error).message });
19	    return c.json({ error: "server_error" }, 500);
20	  }
21	};
22	
23	export const mcpOtherMethodsHandler = async (c: Context<{ Bindings: Env }>) => {
24	  return c.json({ jsonrpc: "2.0" }, 200);
25	};
26	
27	export const mcpServerHandler = async (c: Context<{ Bindings: Env }>) => {
28	  const contentType = c.req.header("Content-Type");
29	  if (!contentType || !contentType.includes("application/json")) {
30	    return c.json(
31	      {
32	        jsonrpc: "2.0",
33	        error: {
34	          code: -32600,
35	          message: "Invalid Request",
36	          data: "Content-Type must be application/json",
37	        },
38	        id: null,
39	      },
40	      400,
41	    );
42	  }
43	  const request = (await c.req.json()) as JsonRpcRequest;
44	  const requestId = request.id ?? null;
