117	                if (attempts >= maxAttempts) {
118	                    reject(new Error('Failed to find Cursor window after maximum attempts. The process may have failed to start properly.'))
119	                } else {
120	                    setTimeout(checkWindow, checkInterval)
121	                }
122	            }
123	
124	            // Start checking for window
125	            checkWindow()
126	        })
