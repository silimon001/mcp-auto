324	    const result = await this.db
325	      .select({
326	        id: apiTokens.id,
327	        user_email: apiTokens.userEmail,
328	        name: apiTokens.name,
329	        created_at: apiTokens.createdAt,
330	        expires_at: apiTokens.expiresAt,
331	        last_used_at: apiTokens.lastUsedAt,
332	        is_revoked: apiTokens.isRevoked,
333	      })
334	      .from(apiTokens)
335	      .where(
336	        and(
337	          eq(apiTokens.userEmail, userEmail),
338	          eq(apiTokens.name, tokenName),
339	          eq(apiTokens.isRevoked, false),
340	        ),
341	      )
342	      .orderBy(desc(apiTokens.createdAt))
343	      .limit(1)
344	      .get();
345	    if (!result) return null;
346	
347	    if (
348	      result.expires_at &&
349	      new Date(result.expires_at as string) < new Date()
350	    ) {
351	      return null;
352	    }
353	
354	    return result as unknown as ApiToken;
355	  }
356	}
