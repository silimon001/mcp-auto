180	        }
181	        await this.windowsApi.sendKeyToWindow(instance.window, virtualKey)
182	    }
183	
184	    async openCommandPalette(id: string): Promise<void> {
185	        const instance = this.getRequired(id)
186	        if (!instance.window) {
187	            throw new Error('Window reference lost')
188	        }
189	        await this.windowsApi.openCommandPalette(instance.window)
190	    }
191	
192	    async openClineTab(id: string): Promise<void> {
193	        const instance = this.getRequired(id)
194	        if (!instance.window) {
