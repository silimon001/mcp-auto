492	  // --------------------------------------------------------------------------
493	
494	  async respondToEvent(params: RespondToEventParams): Promise<CalendarEvent> {
495	    const calendarId = params.calendarId || 'primary';
496	    const normalizedId = this.normalizeEventId(params.eventId);
497	
498	    // First, get the current event to find our attendee entry
499	    const event = await this.getEvent(calendarId, normalizedId);
500	
501	    if (!event.attendees || event.attendees.length === 0) {
502	      throw new Error(
503	        'This event has no attendees. You can only respond to events you were invited to.',
504	      );
505	    }
506	
507	    // Find the self attendee
508	    const selfAttendee = event.attendees.find((a) => a.self);
509	    if (!selfAttendee) {
510	      throw new Error(
511	        'You are not an attendee of this event. Cannot update response status.',
512	      );
513	    }
514	
515	    // Update the attendee's response status
516	    const updatedAttendees = event.attendees.map((a) => {
517	      if (a.self) {
518	        return { ...a, responseStatus: params.response };
519	      }
520	      return a;
521	    });
522	
523	    // PATCH the event with updated attendees
524	    const queryParams = new URLSearchParams();
525	    if (params.sendUpdates) queryParams.set('sendUpdates', params.sendUpdates);
526	
527	    const query = queryParams.toString();
528	    const path = `/calendars/${encodeURIComponent(calendarId)}/events/${encodeURIComponent(normalizedId)}${query ? `?${query}` : ''}`;
529	
530	    return this.request(path, {
531	      method: 'PATCH',
532	      body: JSON.stringify({ attendees: updatedAttendees }),
533	    });
534	  }
