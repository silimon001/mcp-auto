1	import { APIGatewayProxyEvent, APIGatewayProxyResult } from 'aws-lambda';
2	import express from 'express';
3	import serverless from 'serverless-http';
4	import bodyParser from 'body-parser';
5	import cors from 'cors';
6	import { createServer } from 'http';
7	import { ReadwiseMCPServer } from './server.js';
8	import { getConfig } from './utils/config.js';
9	import { SafeLogger } from './utils/safe-logger.js';
10	import { LogLevel } from './utils/logger-interface.js';
11	
12	// Create an Express app
13	const app = express();
14	
15	// Configure middleware
16	app.use(bodyParser.json());
17	app.use(cors());
18	
19	// Get config
20	const config = getConfig();
21	
22	// Create logger instance
23	const logger = new SafeLogger({
24	  level: LogLevel.INFO,
25	  transport: console.error,
26	  timestamps: true,
27	  colors: true
28	});
29	
30	// Create HTTP server
31	const server = createServer(app);
32	
33	// Create MCP server
34	const mcpServer = new ReadwiseMCPServer(
35	  process.env.READWISE_API_KEY || '',
36	  Number(process.env.PORT) || 3000,
37	  logger,
38	  'sse'
39	);
40	
41	// Setup routes
42	app.get('/health', (_req, res) => {
43	  res.json({
44	    status: 'ok',
45	    uptime: process.uptime()
46	  });
47	});
48	
49	app.post('/mcp', (req, res) => {
50	  const requestId = req.body.request_id;
51	  
52	  if (!requestId) {
53	    res.status(400).json({
54	      error: 'Missing request_id'
55	    });
56	    return;
57	  }
58	  
59	  // Handle the request
60	  mcpServer.handleMCPRequest(req.body, (response) => {
61	    // Send the response back
62	    res.json(response);
63	  });
64	});
65	
66	// Start the server
67	mcpServer.start().catch(err => logger.error('Failed to start server:', err as any));
68	
69	// Create a serverless handler
70	const handler = serverless(app);
71	
72	// Export the serverless handler
73	export const lambdaHandler = async (
74	  event: APIGatewayProxyEvent
75	): Promise<APIGatewayProxyResult> => {
76	  logger.debug('Received event', event as any);
77	  
78	  try {
79	    // Process the event using serverless-http
80	    const result = await handler(event, {} as any);
81	    
82	    if (typeof result === 'object' && result !== null && 'statusCode' in result) {
83	      logger.debug('Processed event', { statusCode: (result as any).statusCode } as any);
84	      return result as APIGatewayProxyResult;
85	    }
86	    
87	    return {
88	      statusCode: 500,
89	      body: JSON.stringify({
90	        error: 'Invalid handler response'
91	      })
92	    };
93	  } catch (error) {
94	    logger.error('Error handling event', error as any);
95	    
96	    return {
97	      statusCode: 500,
98	      body: JSON.stringify({
99	        error: 'Internal Server Error'
100	      })
101	    };
102	  }
103	};
104	
105	// Export the Express app as default
106	export default app; 

