395	  private setupRoutes(): void {
396	    this.logger.debug('Setting up routes');
397	    
398	    // Root endpoint for basic connectivity check
399	    this.app.get('/', (_req: Request, res: Response) => {
400	      res.json({
401	        name: packageJson.name,
402	        version: packageJson.version,
403	        status: 'running',
404	        transport: this.transportType,
405	        endpoints: {
406	          health: '/health',
407	          capabilities: '/capabilities',
408	          sse: '/sse',
409	          mcp: '/mcp'
410	        }
411	      });
412	    });
413	    
414	    // Health check endpoint - must be accessible without authentication
415	    // This is critical for Smithery deployment - must respond immediately
416	    this.app.get('/health', (_req: Request, res: Response) => {
417	      try {
418	        const health = {
419	          status: this.isReady ? 'ok' : 'starting',
420	          ready: this.isReady,
421	          uptime: process.uptime(),
422	          transport: this.transportType,
