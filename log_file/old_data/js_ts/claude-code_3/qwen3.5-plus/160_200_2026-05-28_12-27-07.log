277	 */
278	export async function getValidAccessToken() {
279	    try {
280	        const expired = await isTokenExpired();
281	        if (expired) {
282	            log('Token is expired. Please authenticate again using `npx @auth0/auth0-mcp-server init`');
283	            return null;
284	        }
285	        return await keychain.getToken();
286	    }
287	    catch (error) {
288	        log('Error getting valid access token:', error);
289	        return null;
290	    }
291	}
