1	import { Logger, LogLevel, LogContext } from './logger-interface.js';
2	
3	/**
4	 * Logger options
5	 */
6	export interface LoggerOptions {
7	  /**
8	   * Minimum log level to display
9	   */
10	  level: LogLevel;
11	  
12	  /**
13	   * Whether to show the log level in the output
14	   */
15	  showLevel: boolean;
16	  
17	  /**
18	   * Whether to include timestamps in the output
19	   */
20	  timestamps: boolean;
21	  
22	  /**
23	   * Whether to use colors in output
24	   */
25	  colors?: boolean;
26	}
27	
28	const COLORS = {
29	  [LogLevel.DEBUG]: '\x1b[36m', // Cyan
30	  [LogLevel.INFO]: '\x1b[32m',  // Green
31	  [LogLevel.WARN]: '\x1b[33m',  // Yellow
32	  [LogLevel.ERROR]: '\x1b[31m', // Red
33	  reset: '\x1b[0m'
34	} as const;
35	
36	/**
37	 * Safe logger that ensures logs don't interfere with MCP protocol
38	 */
39	export class SafeLogger implements Logger {
40	  level: LogLevel;
41	  transport: (message: string) => void;
42	  timestamps: boolean;
43	  colors: boolean;
44	  
45	  /**
46	   * Create a new SafeLogger
47	   * @param options - Logger options
48	   */
49	  constructor(options: {
50	    level?: LogLevel;
51	    transport?: (message: string) => void;
52	    timestamps?: boolean;
53	    colors?: boolean;
54	  } = {}) {
55	    this.level = options.level ?? LogLevel.INFO;
56	    this.transport = options.transport ?? console.error;
57	    this.timestamps = options.timestamps ?? true;
58	    this.colors = options.colors ?? true;
59	  }
60	  
61	  private shouldLog(level: LogLevel): boolean {
62	    const levels = Object.values(LogLevel);
63	    return levels.indexOf(level) >= levels.indexOf(this.level);
64	  }
65	  
66	  private formatMessage(level: LogLevel, message: string, context?: unknown): string {
67	    const parts: string[] = [];
68	
69	    // Add timestamp
70	    if (this.timestamps) {
71	      parts.push(new Date().toISOString());
72	    }
73	
74	    // Add log level
75	    const levelStr = level.toUpperCase().padEnd(5);
76	    if (this.colors) {
77	      parts.push(`${COLORS[level]}${levelStr}${COLORS.reset}`);
78	    } else {
79	      parts.push(levelStr);
80	    }
81	
82	    // Add message
83	    parts.push(message);
84	
85	    // Add context
86	    if (context !== undefined) {
87	      if (context instanceof Error) {
88	        parts.push(context.stack || context.message);
89	      } else {
90	        try {
91	          parts.push(typeof context === 'string' ? context : JSON.stringify(context, null, 2));
92	        } catch {
93	          parts.push(String(context));
94	        }
95	      }
96	    }
97	
98	    return parts.join(' ');
99	  }
100	  
101	  private logMessage(level: LogLevel, message: string, context?: unknown): void {
102	    if (this.shouldLog(level)) {
103	      const formattedMessage = this.formatMessage(level, message, context);
104	      this.transport(formattedMessage);
105	    }
106	  }
107	  
108	  /**
109	   * Log a debug message
110	   */
111	  public debug(message: string, context?: unknown): void {
112	    this.logMessage(LogLevel.DEBUG, message, context);
113	  }
114	  
115	  /**
116	   * Log an info message
117	   */
118	  public info(message: string, context?: unknown): void {
119	    this.logMessage(LogLevel.INFO, message, context);
120	  }
121	  
122	  /**
123	   * Log a warning message
124	   */
125	  public warn(message: string, context?: unknown): void {
126	    this.logMessage(LogLevel.WARN, message, context);
127	  }
128	  
129	  /**
130	   * Log an error message
131	   */
132	  public error(message: string, context?: unknown): void {
133	    this.logMessage(LogLevel.ERROR, message, context);
134	  }
135	}
136	

