1	// Unified MCP server entry point (Node.js/Hono) using shared modules
2	// From Spotify MCP
3	
4	import type { HttpBindings } from '@hono/node-server';
5	import { Hono } from 'hono';
6	import { createMcpSecurityMiddleware } from '../adapters/http-hono/middleware.security.js';
7	import { buildDiscoveryRoutes } from '../adapters/http-hono/routes.discovery.js';
8	import { config } from '../config/env.js';
9	import { serverMetadata } from '../config/metadata.js';
10	import { buildServer } from '../core/mcp.js';
11	import { parseConfig } from '../shared/config/env.js';
12	import { createAuthHeaderMiddleware } from './middlewares/auth.js';
13	import { corsMiddleware } from './middlewares/cors.js';
14	import { healthRoutes } from './routes/health.js';
15	import { buildMcpRoutes } from './routes/mcp.js';
16	
17	export function buildHttpApp(): Hono<{ Bindings: HttpBindings }> {
18	  const app = new Hono<{ Bindings: HttpBindings }>();
19	
20	  // Parse unified config
21	  const unifiedConfig = parseConfig(process.env as Record<string, unknown>);
22	
23	  // Build MCP server
24	  const server = buildServer({
25	    name: config.MCP_TITLE || serverMetadata.title,
26	    version: config.MCP_VERSION,
27	    instructions: config.MCP_INSTRUCTIONS || serverMetadata.instructions,
28	  });
29	
30	  const transports = new Map();
31	
32	  // Global middleware
33	  app.use('*', corsMiddleware());
34	  app.use('*', createAuthHeaderMiddleware());
35	
36	  // Routes
37	  app.route('/', healthRoutes());
38	  app.route('/', buildDiscoveryRoutes(unifiedConfig));
39	
40	  // MCP endpoint with security
41	  app.use('/mcp', createMcpSecurityMiddleware(unifiedConfig));
42	  app.route('/mcp', buildMcpRoutes({ server, transports }));
43	
44	  return app;
45	}
