314	  /**
315	   * Validates that timestamp has a timezone suffix (required by Google Calendar API).
316	   * Throws if timezone is missing — caller must provide RFC3339 format.
317	   */
318	  private requireTimezone(timestamp: string): string {
319	    // Valid: ends with Z or has +/- offset like +01:00 or -07:00
320	    if (/Z$|[+-]\d{2}:\d{2}$/.test(timestamp)) {
321	      return timestamp;
322	    }
323	    throw new Error(
324	      `Invalid timestamp format: "${timestamp}". Must be RFC3339 with timezone (e.g., 2025-12-06T19:00:00Z or 2025-12-06T19:00:00+01:00)`,
325	    );
326	  }
