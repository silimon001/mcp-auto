478	    this.app.options('/mcp', (_req: Request, res: Response) => {
479	      this.logger.debug('OPTIONS preflight request for /mcp');
480	      // CORS middleware should handle this, but ensure headers are set
481	      res.status(204).end();
482	    });
483	
484	    // Store active Streamable HTTP transports by session ID
485	    const streamableTransports = new Map<string, StreamableHTTPServerTransport>();
486	
487	    // MCP HTTP endpoint for Smithery and other HTTP-based clients
488	    // Uses Streamable HTTP transport from MCP SDK for proper protocol compliance
489	    this.app.all('/mcp', async (req: Request, res: Response) => {
490	      try {
491	        this.logger.debug('MCP Streamable HTTP request received', {
492	          method: req.method,
493	          path: req.path,
494	          headers: Object.keys(req.headers)
495	        });
496	        
497	        // Ensure MCP server is initialized
498	        if (!this.mcpServer) {
499	          this.logger.error('MCP server not initialized');
500	          res.status(503).json({
501	            error: {
502	              type: 'transport',
503	              details: {
504	                code: 'server_not_ready',
505	                message: 'MCP server is not initialized yet'
506	              }
507	            }
508	          });
509	          return;
510	        }
511	        
512	        const sessionId = req.headers['mcp-session-id'] as string | undefined;
513	        let transport: StreamableHTTPServerTransport;
514	
515	        if (sessionId && streamableTransports.has(sessionId)) {
516	          // Reuse existing transport for the session
517	          const existingTransport = streamableTransports.get(sessionId);
518	          if (!existingTransport) {
519	            throw new Error(`Transport not found for session: ${sessionId}`);
520	          }
521	          transport = existingTransport;
522	          this.logger.debug(`Reusing transport for session: ${sessionId}`);
523	        } else {
524	          // Create a new transport for a new session
525	          this.logger.debug('Creating new Streamable HTTP transport');
526	          const { randomUUID } = await import('crypto');
527	          transport = new StreamableHTTPServerTransport({
528	            sessionIdGenerator: () => randomUUID()
529	          });
530	          
531	          // Connect transport to MCP server
532	          // SDK handles all JSON-RPC messages including initialize and list_tools
533	          this.logger.debug('Connecting transport to MCP server');
534	          await this.mcpServer.connect(transport);
535	          this.logger.debug('Transport connected successfully');
536	          
537	          // Store transport by session ID after connection
538	          const newSessionId = (transport as any).sessionId;
539	          if (newSessionId) {
540	            streamableTransports.set(newSessionId, transport);
541	            this.logger.info(`Created new Streamable HTTP transport (session: ${newSessionId})`);
542	            // Set session ID header for client
543	            res.setHeader('mcp-session-id', newSessionId);
544	          } else {
545	            this.logger.warn('Streamable HTTP transport created but sessionId not available');
546	          }
547	        }
548	
549	        // Handle the request through the transport
550	        this.logger.debug('Handling request through transport');
551	        await transport.handleRequest(req, res, req.body);
552	        this.logger.debug('Request handled successfully');
553	      } catch (error) {
554	        this.logger.error('Error handling MCP Streamable HTTP request:', error as any);
555	        if (error instanceof Error) {
556	          this.logger.error('Error stack:', error.stack);
557	        }
558	        if (!res.headersSent) {
559	          res.status(500).json({
560	            error: {
561	              type: 'transport',
562	              details: {
563	                code: 'server_error',
564	                message: error instanceof Error ? error.message : 'Unknown error'
565	              }
566	            }
567	          });
568	        }
569	      }
