376	   * Stop the server
377	   */
378	  async stop(): Promise<void> {
379	    return new Promise<void>((resolve, reject) => {
380	      this.server.close((err) => {
381	        if (err) {
382	          this.logger.error('Error stopping server', err);
383	          reject(err);
384	        } else {
385	          this.logger.info('Server stopped');
386	          resolve();
387	        }
388	      });
389	    });
390	  }
