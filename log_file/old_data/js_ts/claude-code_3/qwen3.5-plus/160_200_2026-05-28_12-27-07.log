7	import { buildFailureMessage, buildLabel, formatLogs, formatThrownError } from "./errors.ts"
8	import { usage } from "./help.ts"
9	
10	const ENTRYPOINT = "./src/main.ts"
11	const DIST_DIR = "./dist"
12	const TARGET_LABEL_WIDTH = 18
13	const HELP_FLAGS = new Set([
14		"--help",
15		"-h"
16	])
17	const LIST_FLAGS = new Set([
18		"list",
19		"--list"
20	])
21	const ALL_TARGET = "all"
22	const HOST_TARGET = "host"
23	type BuildTarget = {
24		id: string
25		label: string
26		outfile: string
27		target?: Bun.Build.CompileTarget
28	}
29	
30	const TARGETS: readonly BuildTarget[] = [
31		{
32			id: HOST_TARGET,
33			label: "current platform",
34			outfile: join(DIST_DIR, APP_NAME)
35		},
36		{
37			id: "linux-x64",
38			label: "Linux x64",
39			outfile: join(DIST_DIR, `${APP_NAME}-linux-x64`),
40			target: "bun-linux-x64"
41		},
42		{
43			id: "linux-arm64",
44			label: "Linux arm64",
45			outfile: join(DIST_DIR, `${APP_NAME}-linux-arm64`),
46			target: "bun-linux-arm64"
47		},
48		{
49			id: "darwin-x64",
50			label: "macOS x64",
51			outfile: join(DIST_DIR, `${APP_NAME}-darwin-x64`),
52			target: "bun-darwin-x64"
53		},
54		{
55			id: "darwin-arm64",
56			label: "macOS arm64",
57			outfile: join(DIST_DIR, `${APP_NAME}-darwin-arm64`),
58			target: "bun-darwin-arm64"
59		},
60		{
61			id: "windows-x64",
62			label: "Windows x64",
63			outfile: join(DIST_DIR, `${APP_NAME}-windows-x64.exe`),
64			target: "bun-windows-x64"
65		}
66	]
67	
68	const TARGET_LOOKUP = new Map(
69		TARGETS.flatMap((build) => [
70			[
71				build.id,
72				build
73			],
74			...(build.target
75				? [
76						[
77							build.target,
78							build
79						] as const
80					]
81				: [])
82		])
83	)
84	
85	const readArgValue = (args: string[], name: string) => {
86		for (const arg of args) {
87			if (arg.startsWith(`${name}=`)) {
88				return arg.slice(name.length + 1)
89			}
90		}
91	
92		const index = args.indexOf(name)
93		if (index < 0) {
94			return
95		}
96	
97		return args[index + 1]
98	}
99	
100	const parseArgs = (args: string[]) => {
101		const positional = args.filter((arg) => !arg.startsWith("--"))
102		const targetArg = readArgValue(args, "--target")
103		const targetName = targetArg ?? positional[0] ?? HOST_TARGET
104	
105		return {
106			clean: args.includes("--clean"),
107			showHelp: args.some((arg) => HELP_FLAGS.has(arg)),
108			showList: args.some((arg) => LIST_FLAGS.has(arg)),
109			targetName
110		}
111	}
112	
113	const resolveTarget = (name: string) => {
114		if (name === ALL_TARGET) {
115			return TARGETS.filter((build) => build.id !== HOST_TARGET)
116		}
117	
118		if (name === HOST_TARGET) {
119			return [
120				TARGETS[0]
121			]
122		}
123	
124		const build = TARGET_LOOKUP.get(name)
125		if (!build) {
126			throw new Error(
127				`Unknown build target '${name}'. Run 'bun run build -- list' for valid targets.`
128			)
129		}
130	
131		return [
132			build
133		]
134	}
135	
136	const buildPaths = (outfile: string) => {
137		if (extname(outfile) === ".exe") {
138			return [
139				outfile
140			]
141		}
142	
143		return [
144			outfile,
145			`${outfile}.exe`
146		]
147	}
148	
149	const removeOutputs = async (outfile: string) => {
150		await Promise.all(
151			buildPaths(outfile).map((file) =>
152				rm(file, {
153					force: true
154				})
155			)
156		)
157	}
158	
159	const findOutputPath = async (outfile: string) => {
160		const files = buildPaths(outfile)
161		const existing = await Promise.all(
162			files.map(async (file) => ({
163				exists: await Bun.file(file).exists(),
164				file
165			}))
166		)
167	
168		const match = existing.find((entry) => entry.exists)
169		if (match) {
170			return match.file
171		}
172	
173		throw new Error(`Build completed without producing '${outfile}'.`)
174	}
175	
176	const formatSize = (size: number) => new Intl.NumberFormat("en-US").format(size)
177	
178	const writeLine = (message: string) => {
179		process.stdout.write(`${message}\n`)
180	}
181	
182	const writeError = (message: string) => {
183		process.stderr.write(`${message}\n`)
184	}
185	
186	const APP_VERSION = resolveBuildVersion(
187		import.meta.dir,
188		normalizeVersion(Bun.env.APP_VERSION ?? "")
189	)
190	
191	const buildTarget = async (build: BuildTarget, clean: boolean) => {
192		if (clean) {
193			await removeOutputs(build.outfile)
194		}
195	
196		writeLine(`Building ${buildLabel(build, APP_NAME)}...`)
197	
198		try {
199			const result = await Bun.build({
200				bytecode: true,
201				compile: build.target
202					? {
203							outfile: build.outfile,
204							target: build.target
205						}
206					: {
207							outfile: build.outfile
208						},
209				define: {
210					// biome-ignore lint/style/useNamingConvention: important global constant
211					BUILD_VERSION: JSON.stringify(APP_VERSION)
212				},
213				entrypoints: [
214					ENTRYPOINT
215				],
216				minify: true
217			})
218	
219			if (!result.success) {
220				throw new Error(buildFailureMessage(build, formatLogs(result.logs)))
221			}
222	
223			const outputPath = await findOutputPath(build.outfile)
224			const info = await stat(outputPath)
225			writeLine(
226				`Built ${buildLabel(build, APP_NAME)} -> ${outputPath} (${formatSize(info.size)} bytes)`
227			)
228		} catch (error) {
229			const message = formatThrownError(error)
230			if (message.startsWith(`Build failed for '${build.id}'.`)) {
231				throw error
232			}
233			throw new Error(buildFailureMessage(build, message))
234		}
235	}
236	
237	const printTargets = () => {
238		for (const build of TARGETS) {
239			const target = build.target ? ` (${build.target})` : ""
240			writeLine(`${build.id.padEnd(TARGET_LABEL_WIDTH)} ${build.label}${target}`)
241		}
242	}
243	
244	const runBuilds = (targets: readonly BuildTarget[], clean: boolean) =>
245		targets.reduce(
246			(previous, build) => previous.then(() => buildTarget(build, clean)),
247			Promise.resolve()
248		)
249	
250	const run = async () => {
251		const args = Bun.argv.slice(2)
252		const options = parseArgs(args)
253	
254		if (options.showHelp) {
255			writeLine(usage())
256			return
257		}
258	
259		if (options.showList) {
260			printTargets()
261			return
262		}
263	
264		await mkdir(DIST_DIR, {
265			recursive: true
266		})
267		const targets = resolveTarget(options.targetName)
268		await runBuilds(targets, options.clean)
269	}
270	
271	run().catch((error) => {
272		const message = formatThrownError(error)
273		writeError(message)
274		process.exit(1)
275	})
