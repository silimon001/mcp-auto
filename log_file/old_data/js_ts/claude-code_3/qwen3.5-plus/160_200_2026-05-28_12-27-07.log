877	  /**
878	   * Set up SSE transport routes
879	   * Uses SDK's SSE transport for proper MCP protocol compliance
880	   */
881	  private setupSSERoutes(): void {
882	    this.logger.debug('Setting up SSE routes');
883	
884	    // Store active SSE transports by session ID
885	    const sseTransports = new Map<string, SSEServerTransport>();
886	
887	    // SSE endpoint for server-to-client streaming
888	    this.app.get('/sse', async (req: Request, res: Response) => {
889	      try {
890	        this.logger.debug('New SSE connection request', {
891	          query: req.query,
892	          headers: req.headers
893	        });
894	
895	        // Set SSE headers
896	        res.setHeader('Content-Type', 'text/event-stream');
897	        res.setHeader('Cache-Control', 'no-cache');
898	        res.setHeader('Connection', 'keep-alive');
899	        res.setHeader('Access-Control-Allow-Origin', '*');
900	        res.flushHeaders();
901	
902	        // Create SSE transport instance
903	        // The first parameter is the message endpoint path for POST requests
904	        const transport = new SSEServerTransport('/messages', res);
905	
906	        // Generate session ID and store transport
907	        const sessionId = `sse-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
908	        sseTransports.set(sessionId, transport);
909	
910	        // Connect transport to MCP server
911	        // SDK handles all JSON-RPC messages including initialize and list_tools
912	        await transport.start();
913	        await this.mcpServer.connect(transport);
914	        
915	        this.logger.info(`SSE transport connected to MCP server (session: ${sessionId})`);
916	
917	        // Handle client disconnect
918	        req.on('close', () => {
919	          this.logger.debug(`Client disconnected (session: ${sessionId})`);
920	          sseTransports.delete(sessionId);
921	          transport.close().catch(err => {
922	            this.logger.error('Error closing transport:', err);
923	          });
924	        });
925	
926	        // Handle transport errors
927	        transport.onerror = (error) => {
928	          this.logger.error('Transport error:', error);
929	          sseTransports.delete(sessionId);
930	        };
931	
932	        transport.onclose = () => {
933	          this.logger.debug(`Transport closed (session: ${sessionId})`);
934	          sseTransports.delete(sessionId);
935	        };
936	
937	      } catch (error) {
938	        this.logger.error('Error in SSE endpoint:', error);
939	        // Only send error response if headers haven't been sent
940	        if (!res.headersSent) {
941	          res.status(500).json({
942	            jsonrpc: '2.0',
943	            error: {
944	              code: -32603,
945	              message: 'Internal server error',
946	              data: error instanceof Error ? error.message : String(error)
947	            }
948	          });
949	        }
950	      }
951	    });
952	
953	    // Message endpoint for SSE clients to send POST requests
954	    // This is required by SSEServerTransport for client-to-server communication
955	    this.app.post('/messages', async (req: Request, res: Response) => {
956	      try {
957	        const sessionId = req.query.sessionId as string;
958	        
959	        if (!sessionId) {
960	          this.logger.warn('POST /messages request missing sessionId');
961	          res.status(400).json({
962	            error: {
963	              type: 'validation',
964	              details: {
965	                code: 'missing_session_id',
966	                message: 'Missing required query parameter: sessionId'
967	              }
968	            }
969	          });
970	          return;
971	        }
972	
973	        const transport = sseTransports.get(sessionId);
974	        if (!transport) {
975	          this.logger.warn(`No transport found for sessionId: ${sessionId}`);
976	          res.status(404).json({
977	            error: {
978	              type: 'transport',
979	              details: {
980	                code: 'session_not_found',
981	                message: `No active SSE connection found for sessionId: ${sessionId}`
982	              }
983	            }
984	          });
985	          return;
986	        }
987	
988	        // Handle the POST message through the transport
989	        // The SDK's SSEServerTransport should handle JSON-RPC messages automatically
990	        // If handlePostMessage exists, use it; otherwise, the SDK handles it via the connected transport
991	        if (typeof (transport as any).handlePostMessage === 'function') {
992	          await (transport as any).handlePostMessage(req, res, req.body);
993	        } else {
994	          // The SDK should handle messages automatically through the connected transport
995	          // For now, acknowledge receipt - the SDK will process it
996	          this.logger.debug('Message received for SSE session, SDK will handle via connected transport');
997	          res.json({ jsonrpc: '2.0', id: req.body?.id || null, result: {} });
998	        }
999	      } catch (error) {
1000	        this.logger.error('Error handling POST /messages:', error as any);
1001	        if (!res.headersSent) {
1002	          res.status(500).json({
1003	            error: {
1004	              type: 'transport',
1005	              details: {
1006	                code: 'server_error',
1007	                message: error instanceof Error ? error.message : 'Unknown error'
1008	              }
1009	            }
1010	          });
1011	        }
1012	      }
1013	    });
1014	  }
1015	} 

