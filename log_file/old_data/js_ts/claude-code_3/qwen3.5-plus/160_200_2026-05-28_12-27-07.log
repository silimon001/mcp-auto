1	// Hono adapter for MCP security middleware
2	// Provider-agnostic version from Spotify MCP
3	
4	import { randomUUID } from 'node:crypto';
5	import type { HttpBindings } from '@hono/node-server';
6	import type { MiddlewareHandler } from 'hono';
7	import type { UnifiedConfig } from '../../shared/config/env.js';
8	import {
9	  buildUnauthorizedChallenge,
10	  validateOrigin,
11	  validateProtocolVersion,
12	} from '../../shared/mcp/security.js';
13	import {
14	  buildProviderRefreshConfig,
15	  ensureFreshToken,
16	} from '../../shared/oauth/refresh.js';
17	import { getTokenStore } from '../../shared/storage/singleton.js';
18	import { sharedLogger as logger } from '../../shared/utils/logger.js';
19	
20	export function createMcpSecurityMiddleware(config: UnifiedConfig): MiddlewareHandler<{
21	  Bindings: HttpBindings;
22	}> {
23	  return async (c, next) => {
24	    try {
25	      validateOrigin(c.req.raw.headers, config.NODE_ENV === 'development');
26	      validateProtocolVersion(c.req.raw.headers, config.MCP_PROTOCOL_VERSION);
27	
28	      if (config.AUTH_ENABLED) {
29	        const auth = c.req.header('Authorization') ?? undefined;
30	
31	        // Challenge clients without Authorization and bind a session id
32	        if (!auth) {
33	          let sid = c.req.header('Mcp-Session-Id') ?? undefined;
34	          if (!sid) {
35	            sid = randomUUID();
36	            logger.debug('mcp_security', { message: 'Generated session ID', sid });
37	          }
38	
39	          const origin = new URL(c.req.url).origin;
40	          const challenge = buildUnauthorizedChallenge({ origin, sid });
41	
42	          c.header('Mcp-Session-Id', sid);
43	          c.header('WWW-Authenticate', challenge.headers['WWW-Authenticate']);
44	
45	          return c.json(challenge.body, challenge.status);
46	        }
47	
48	        // Extract Bearer token and look up provider credentials
49	        const [scheme, rsToken] = auth.split(' ', 2);
50	        const bearer =
51	          scheme && scheme.toLowerCase() === 'bearer' ? (rsToken || '').trim() : '';
52	
53	        if (bearer) {
54	          try {
55	            const store = getTokenStore();
56	
57	            // Proactively refresh token if near expiry
58	            const providerConfig = buildProviderRefreshConfig(config);
59	            const { accessToken, wasRefreshed } = await ensureFreshToken(
60	              bearer,
61	              store,
62	              providerConfig,
63	            );
64	
65	            if (wasRefreshed) {
66	              logger.info('mcp_security', {
67	                message: 'Provider token refreshed proactively',
68	              });
69	            }
70	
71	            // Re-fetch record to get updated provider info (may have been refreshed)
72	            const record = await store.getByRsAccess(bearer);
73	            const provider = record?.provider;
74	
75	            if (provider && accessToken) {
76	              // Inject auth context into Hono context for MCP routes to use
77	              // This will be passed to tool handlers via AsyncLocalStorage
78	              const authContext = {
79	                strategy: config.AUTH_STRATEGY as
80	                  | 'oauth'
81	                  | 'bearer'
82	                  | 'api_key'
83	                  | 'custom'
84	                  | 'none',
85	                authHeaders: { authorization: auth },
86	                resolvedHeaders: { authorization: `Bearer ${accessToken}` },
87	                providerToken: accessToken,
88	                provider: {
89	                  access_token: provider.access_token,
90	                  refresh_token: provider.refresh_token,
91	                  expires_at: provider.expires_at,
92	                  scopes: provider.scopes,
93	                },
94	                rsToken: bearer,
95	              };
96	              (c as unknown as { authContext: typeof authContext }).authContext =
97	                authContext;
98	            } else if (config.AUTH_REQUIRE_RS && !config.AUTH_ALLOW_DIRECT_BEARER) {
99	              // RS token not found and RS is required - challenge
100	              const sid = c.req.header('Mcp-Session-Id') ?? randomUUID();
101	
102	              const origin = new URL(c.req.url).origin;
103	              const challenge = buildUnauthorizedChallenge({ origin, sid });
104	
105	              c.header('Mcp-Session-Id', sid);
106	              c.header('WWW-Authenticate', challenge.headers['WWW-Authenticate']);
107	
108	              logger.debug('mcp_security', {
109	                message: 'RS token not found, challenging',
110	              });
111	              return c.json(challenge.body, challenge.status);
112	            }
113	          } catch (error) {
114	            logger.error('mcp_security', {
115	              message: 'Token lookup failed',
116	              error: (error as Error).message,
117	            });
118	          }
119	        }
120	      }
121	
122	      return next();
123	    } catch (error) {
124	      logger.error('mcp_security', {
125	        message: 'Security check failed',
126	        error: (error as Error).message,
127	      });
128	
129	      return c.json(
130	        {
131	          jsonrpc: '2.0',
132	          error: {
133	            code: -32603,
134	            message: (error as Error).message || 'Internal server error',
135	          },
136	          id: null,
137	        },
138	        500,
139	      );
140	    }
141	  };
142	}
143	

