2559	    filters: z.string().optional().describe("Additional Shodan filters to apply")
2560	  },
2561	  (args) => {
2562	    const base_query = args.search_type === "custom" ? 
2563	      args.query :
2564	      args.search_type === "service" ?
2565	        `port:"${args.query}"` :
