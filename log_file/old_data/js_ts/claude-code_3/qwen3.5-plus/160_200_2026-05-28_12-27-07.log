362	        this.isReady = true;
363	        this.logger.info('✓ Server initialization complete - ready to accept connections');
364	        resolve();
365	      });
366	      
367	      // Also log when server is listening (additional confirmation)
368	      this.server.on('listening', () => {
369	        const address = this.server.address();
370	        this.logger.debug('Server listening event fired', { address });
371	      });
372	    });
373	  }
