452	    // Capabilities endpoint
453	    this.app.get('/capabilities', (_req: Request, res: Response) => {
454	      res.json({
455	        version: packageJson.version,
456	        transports: ['sse'],
457	        tools: this.toolRegistry.getNames().map(name => {
458	          const tool = this.toolRegistry.get(name);
459	          return {
460	            name,
461	            description: tool?.description || '',
462	            parameters: tool?.parameters || {}
