444	    this.app.get('/.well-known/oauth-authorization-server', (_req: Request, res: Response) => {
445	      this.logger.debug('OAuth metadata requested - not supported (using API key auth)');
446	      res.status(404).json({
447	        error: 'oauth_not_supported',
448	        message: 'This server uses API key authentication, not OAuth'
449	      });
