1	import { ErrorLogger, StartupError, trySync } from "@mcp-docsrs/errors"
2	import { errAsync, okAsync } from "neverthrow"
3	import {
4		parseCliFlags,
5		readEnvConfig,
6		renderHelp,
7		resolveConfig,
8		validateConfig
9	} from "./config/index.ts"
10	import { APP_VERSION } from "./meta.ts"
11	import { createServer } from "./server/server.ts"
12	
13	type CliDeps = {
14		createServer: typeof createServer
15		installShutdown: typeof installShutdown
16		readEnvConfig: typeof readEnvConfig
17		write: (message: string) => unknown
18	}
19	
20	const createExitOnFailure =
21		(exit: (code: number) => unknown, log = ErrorLogger.log) =>
22		(error: unknown) => {
23			log(error)
24			exit(1)
25			return undefined as never
26		}
27	
28	const createShutdownHandlers = (
29		close: ReturnType<typeof createServer>["close"],
30		exit: (code: number) => unknown,
31		log = ErrorLogger.log
32	) => {
33		let shuttingDown = false
34		const fail = createExitOnFailure(exit, log)
35	
36		const shutdown = async (exitCode: number) => {
37			if (shuttingDown) {
38				return
39			}
40	
41			shuttingDown = true
42			const result = await close()
43			result.match(() => exit(exitCode), fail)
44		}
45	
46		return {
47			sigint: () => shutdown(0).catch(fail),
48			sigterm: () => shutdown(0).catch(fail),
49			uncaughtException: (error: unknown) => {
50				log(error)
51				return shutdown(1).catch(fail)
52			},
53			unhandledRejection: (error: unknown) => {
54				log(error)
55				return shutdown(1).catch(fail)
56			}
57		}
58	}
59	
60	const installShutdown = (close: ReturnType<typeof createServer>["close"]) => {
61		const handlers = createShutdownHandlers(close, (code) => process.exit(code))
62	
63		process.on("SIGINT", handlers.sigint)
64		process.on("SIGTERM", handlers.sigterm)
65		process.on("uncaughtException", handlers.uncaughtException)
66		process.on("unhandledRejection", handlers.unhandledRejection)
67	}
68	
69	const defaultDeps: CliDeps = {
70		createServer,
71		installShutdown,
72		readEnvConfig,
73		write: (message: string) => process.stdout.write(message)
74	}
75	
76	const run = (args?: string[], deps: CliDeps = defaultDeps) => {
77		const flags = parseCliFlags(args)
78		if (flags.showHelp) {
79			deps.write(`${renderHelp()}\n`)
80			return okAsync(undefined)
81		}
82		if (flags.showVersion) {
83			deps.write(`${APP_VERSION}\n`)
84			return okAsync(undefined)
85		}
86	
87		const configResult = trySync(
88			() =>
89				validateConfig(
90					resolveConfig({
91						...deps.readEnvConfig(),
92						...flags.overrides
93					})
94				),
95			(error) => new StartupError("resolve CLI configuration", error)
96		)
97		if (configResult.isErr()) {
98			return errAsync(configResult.error)
99		}
100	
101		const app = deps.createServer(configResult.value)
102		deps.installShutdown(app.close)
103	
104		return app.start()
105	}
106	
107	export { createShutdownHandlers, installShutdown, run }
108	

