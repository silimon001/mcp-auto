717	  /**
718	   * Handle a tool call
719	   * @param request - The tool call request
720	   * @param callback - Callback function to receive the response
721	   */
722	  private handleToolCall(
723	    request: MCPRequest & { type: 'tool_call' },
724	    callback: (response: MCPResponse | ErrorResponse) => void
725	  ): void {
726	    const { name, parameters, request_id } = request;
727	    
728	    // Get the tool
729	    const tool = this.toolRegistry.get(name);
730	    
731	    if (!tool) {
732	      this.logger.warn(`Tool not found: ${name}`);
733	      
734	      // Return error
735	      callback({
736	        error: {
737	          type: 'transport',
738	          details: {
739	            code: 'tool_not_found',
740	            message: `Tool not found: ${name}`
741	          }
742	        },
743	        request_id
744	      });
745	      return;
746	    }
747	    
748	    // Validate parameters
749	    const validationResult = tool.validate ? tool.validate(parameters) : { valid: true, success: true, errors: [] };
750	    
751	    if (!validationResult.valid) {
752	      this.logger.warn(`Invalid parameters for tool ${name}`, { errors: validationResult.errors } as any);
753	      const errorResponse: ErrorResponse = {
754	        error: {
755	          type: 'validation' as ErrorType,
756	          details: {
757	            code: 'invalid_parameters',
758	            message: 'Invalid parameters',
759	            errors: validationResult.errors.map(e => `${e.field}: ${e.message}`)
760	          }
761	        },
762	        request_id: request.request_id
763	      };
764	      callback(errorResponse);
765	      return;
766	    }
767	    
768	    // Execute the tool
769	    (typeof (tool as any).executeAsMCP === 'function' ? (tool as any).executeAsMCP(parameters) : tool.execute(parameters))
770	      .then((result: any) => {
771	        this.logger.debug(`Tool ${name} execution successful`);
772	        
773	        const response: MCPResponse = (result as any).content ? (result as any) : { content: [{ type: 'text', text: JSON.stringify(result) }] };
774	        callback({ ...response, request_id: request.request_id });
775	      })
776	      .catch((error: unknown) => {
777	        this.logger.error(`Tool ${name} execution error`, error as any);
778	        
779	        // Check if it's an authentication error
780	        const isAuthError = error && typeof error === 'object' && 'type' in error && error.type === 'authentication';
781	        const errorDetails = error && typeof error === 'object' && 'details' in error ? error.details : null;
782	        
783	        const errorResponse: ErrorResponse = {
784	          error: {
785	            type: (isAuthError ? 'validation' : 'execution') as ErrorType,
786	            details: {
787	              code: errorDetails && typeof errorDetails === 'object' && 'code' in errorDetails 
788	                ? String(errorDetails.code)
789	                : 'tool_error',
790	              message: errorDetails && typeof errorDetails === 'object' && 'message' in errorDetails
791	                ? String(errorDetails.message)
792	                : error instanceof Error 
793	                  ? error.message 
794	                  : 'Unknown error'
795	            }
796	          },
797	          request_id: request.request_id
798	        };
799	        callback(errorResponse);
800	      });
801	  }
