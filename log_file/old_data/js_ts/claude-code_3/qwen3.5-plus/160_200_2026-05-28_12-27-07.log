1	import { SSEServerTransport } from '@modelcontextprotocol/sdk/server/sse.js';
2	import { log } from 'crawlee';
3	import express, { type Request, type Response } from 'express';
4	
5	import { Routes } from './const.js';
6	import { RagWebBrowserServer } from './mcp/server.js';
7	import { handleSearchRequest } from './search.js';
8	
9	export function createServer(): express.Express {
10	    const app = express();
11	    const mcpServer = new RagWebBrowserServer();
12	    let transport: SSEServerTransport;
13	
14	    const HELP_MESSAGE = `Send a GET request to ${process.env.ACTOR_STANDBY_URL}/search?query=hello+world`
15	        + ` or to ${process.env.ACTOR_STANDBY_URL}/messages to use Model context protocol.`;
16	
17	    app.get('/', async (req, res) => {
18	        log.info(`Received GET message at: ${req.url}`);
19	        res.status(200).json({ message: `Actor is running in Standby mode. ${HELP_MESSAGE}` });
20	    });
21	
22	    app.get(Routes.SEARCH, async (req: Request, res: Response) => {
23	        log.info(`Received GET message at: ${req.url}`);
24	        await handleSearchRequest(req, res);
25	    });
26	
27	    app.head(Routes.SEARCH, async (req: Request, res: Response) => {
28	        log.info(`Received HEAD message at: ${req.url}`);
29	        res.writeHead(200, { 'Content-Type': 'application/json' });
30	        res.end();
31	    });
32	
33	    app.get(Routes.SSE, async (req: Request, res: Response) => {
34	        log.info(`Received GET message at: ${req.url}`);
35	        transport = new SSEServerTransport(Routes.MESSAGE, res);
36	        await mcpServer.connect(transport);
37	    });
38	
39	    app.post(Routes.MESSAGE, async (req: Request, res: Response) => {
40	        log.info(`Received POST message at: ${req.url}`);
41	        await transport.handlePostMessage(req, res);
42	    });
43	
44	    // Catch-all for undefined routes
45	    app.use((req, res) => {
46	        res.status(404).json({ message: `There is nothing at route ${req.method} ${req.originalUrl}. ${HELP_MESSAGE}` });
47	    });
48	
49	    return app;
50	}
51	

