334	        this.logger.error('Error message:', error.message);
335	        if (error.code === 'EADDRINUSE') {
336	          reject(new Error(`Port ${this.port} is already in use`));
337	        } else {
338	          reject(error);
339	        }
340	      });
341	      
342	      // Log when server starts listening
343	      this.server.listen(this.port, '0.0.0.0', () => {
344	        const address = this.server.address();
345	        this.logger.info(`✓ Server started successfully on port ${this.port}`);
346	        this.logger.info(`✓ Listening on ${typeof address === 'string' ? address : `${address?.address}:${address?.port}`}`);
347	        this.logger.info(`✓ Transport type: ${this.transportType}`);
348	        this.logger.info(`✓ Startup time: ${Date.now() - this.startTime}ms`);
349	        this.logger.info(`✓ Health check: http://0.0.0.0:${this.port}/health`);
350	        this.logger.info(`✓ Tools registered: ${this.toolRegistry.getNames().length}`);
351	        this.logger.info(`✓ Prompts registered: ${this.promptRegistry.getNames().length}`);
352	        
353	        // If using stdio transport, set up stdin handler
354	        if (this.transportType === 'stdio') {
355	          this.logger.debug('Setting up stdio transport...');
