592	        });
593	      } catch (error) {
594	        this.logger.error('Error handling stdin data', error);
595	        
596	        // Write error response to stdout
597	        const errorResponse: ErrorResponse = {
598	          error: {
599	            type: 'transport' as ErrorType,
600	            details: {
601	              code: 'invalid_request',
602	              message: error instanceof Error ? error.message : 'Invalid request'
603	            }
604	          },
605	          request_id: 'unknown'  // Unknown request_id for parsing errors
606	        };
607	        
608	        process.stdout.write(JSON.stringify(errorResponse) + '\n');
609	      }
610	    });
611	    
612	    this.logger.info('Listening for requests on stdin');
