218	export class GoogleCalendarClient {
219	  private accessToken: string;
220	
221	  constructor(accessToken: string) {
222	    this.accessToken = accessToken;
223	  }
224	
225	  /**
226	   * Normalize event ID by removing the calendar email suffix if present.
227	   * 
228	   * Google Calendar returns composite IDs like "baseEventId calendarEmail" (base64 encoded)
229	   * for shared/imported events. The update/delete APIs expect only the base event ID.
230	   * 
231	   * Examples of composite IDs (decoded):
232	   * - "bbmpmmmickpmipbanqoosctntc adam@overment.com" → "bbmpmmmickpmipbanqoosctntc"
233	   * - "abc123 someone@example.com" → "abc123"
234	   */
235	  private normalizeEventId(eventId: string): string {
236	    // Try to decode as base64 to check for email suffix
237	    try {
238	      const decoded = atob(eventId);
239	      // Check if decoded string contains " email@domain" pattern
240	      const emailSuffixMatch = decoded.match(/^(.+?)\s+[\w.+-]+@[\w.-]+$/);
241	      if (emailSuffixMatch && emailSuffixMatch[1]) {
242	        // Re-encode just the base ID part
243	        const baseId = emailSuffixMatch[1];
244	        return btoa(baseId);
245	      }
246	    } catch {
247	      // Not valid base64, use as-is
248	    }
249	    return eventId;
250	  }
251	
252	  private async request<T>(path: string, options: RequestInit = {}): Promise<T> {
253	    const url = `${GOOGLE_CALENDAR_API_BASE}${path}`;
254	    const headers = {
255	      Authorization: `Bearer ${this.accessToken}`,
256	      'Content-Type': 'application/json',
257	      ...options.headers,
258	    };
259	
260	    try {
261	      const response = await fetch(url, { ...options, headers });
262	
263	      if (!response.ok) {
264	        let errorMessage = `Google Calendar API error: ${response.status} ${response.statusText}`;
265	        try {
266	          const errorData = (await response.json()) as { error?: { message?: string } };
267	          if (errorData.error?.message) {
268	            errorMessage += ` - ${errorData.error.message}`;
269	          }
270	        } catch {
271	          // Ignore JSON parse error
272	        }
273	        throw new CalendarApiError(errorMessage, response.status, response.statusText);
274	      }
275	
276	      // Handle 204 No Content
277	      if (response.status === 204) {
278	        return {} as T;
279	      }
280	
281	      return (await response.json()) as T;
282	    } catch (error) {
283	      logger.error('google-calendar-client', {
284	        message: 'Request failed',
285	        url,
286	        error: (error as Error).message,
287	      });
288	      throw error;
289	    }
290	  }
