8	/**
9	 * Extract the shape from a Zod schema, handling ZodEffects (refined schemas).
10	 * ZodEffects wraps the inner schema when using .refine(), .transform(), etc.
11	 */
12	function getSchemaShape(schema: ZodTypeAny): ZodRawShape | undefined {
13	  // If it's a ZodObject, return its shape directly
14	  if ('shape' in schema && typeof schema.shape === 'object') {
15	    return (schema as ZodObject<ZodRawShape>).shape;
16	  }
17	
18	  // If it's a ZodEffects (from .refine(), .transform(), etc.), unwrap to get inner schema
19	  if ('_def' in schema && schema._def && typeof schema._def === 'object') {
20	    const def = schema._def as { schema?: ZodTypeAny; innerType?: ZodTypeAny };
21	    // ZodEffects stores the inner schema in _def.schema
22	    if (def.schema) {
23	      return getSchemaShape(def.schema);
24	    }
25	    // Some Zod versions use _def.innerType
26	    if (def.innerType) {
27	      return getSchemaShape(def.innerType);
28	    }
29	  }
30	
31	  return undefined;
32	}
