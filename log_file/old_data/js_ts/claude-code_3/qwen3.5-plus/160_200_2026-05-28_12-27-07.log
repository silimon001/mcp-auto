93	/**
94	 * Create a wrapped handler for shared tools.
95	 * Adapts the shared ToolContext to the SDK's RequestHandlerExtra.
96	 *
97	 * SDK provides `extra.requestId` which we use to look up auth context from registry.
98	 */
99	function createWrappedHandler(
100	  _server: McpServer,
101	  handler: (args: Record<string, unknown>, context: ToolContext) => Promise<unknown>,
102	) {
103	  return async (
104	    args: Record<string, unknown>,
105	    extra?: {
106	      requestId?: string | number;
107	      _meta?: { progressToken?: string | number };
108	      signal?: AbortSignal;
109	    },
110	  ) => {
111	    // SDK provides requestId at top level of extra
112	    const requestId = extra?.requestId;
113	
114	    // Look up auth context from registry (stored by MCP routes with auth info)
115	    let existingContext = requestId ? contextRegistry.get(requestId) : undefined;
116	
117	    // Fallback to AsyncLocalStorage if requestId not available
118	    // This is the primary method since MCP SDK doesn't pass requestId to tool handlers
119	    if (!existingContext) {
120	      existingContext = getCurrentAuthContext();
121	    }
122	
123	    // Build shared ToolContext
124	    const context: ToolContext = {
125	      sessionId: String(requestId || crypto.randomUUID()),
126	      signal: extra?.signal,
127	      meta: {
128	        progressToken: extra?._meta?.progressToken,
129	        requestId: requestId ? String(requestId) : undefined,
130	      },
131	      // Auth from context registry
132	      authStrategy: existingContext?.authStrategy,
133	      providerToken: existingContext?.providerToken,
134	      provider: existingContext?.provider
135	        ? {
136	            accessToken: existingContext.provider.access_token,
137	            refreshToken: existingContext.provider.refresh_token,
138	            expiresAt: existingContext.provider.expires_at,
139	            scopes: existingContext.provider.scopes,
140	          }
141	        : undefined,
142	      resolvedHeaders: existingContext?.resolvedHeaders,
143	      authHeaders: existingContext?.authHeaders as Record<string, string> | undefined,
144	    };
145	
146	    try {
147	      const result = await handler(args, context);
148	      return result;
149	    } finally {
150	      if (requestId) {
151	        contextRegistry.delete(requestId);
152	      }
153	    }
154	  };
155	}
