803	  /**
804	   * Handle a prompt call
805	   * @param request - The prompt call request
806	   * @param callback - Callback function to receive the response
807	   */
808	  private handlePromptCall(
809	    request: MCPRequest & { type: 'prompt_call' },
810	    callback: (response: MCPResponse | ErrorResponse) => void
811	  ): void {
812	    const { name, parameters, request_id } = request;
813	    
814	    // Get the prompt
815	    const prompt = this.promptRegistry.get(name);
816	    
817	    if (!prompt) {
818	      this.logger.warn(`Prompt not found: ${name}`);
819	      
820	      // Return error
821	      callback({
822	        error: {
823	          type: 'transport',
824	          details: {
825	            code: 'prompt_not_found',
826	            message: `Prompt not found: ${name}`
827	          }
828	        },
829	        request_id
830	      });
831	      return;
832	    }
833	    
834	    // Validate parameters
835	    const validationResult = prompt.validate ? prompt.validate(parameters) : { valid: true, success: true, errors: [] };
836	    
837	    if (!validationResult.valid) {
838	      this.logger.warn(`Invalid parameters for prompt ${name}`, { errors: validationResult.errors } as any);
839	      const errorResponse: ErrorResponse = {
840	        error: {
841	          type: 'validation' as ErrorType,
842	          details: {
843	            code: 'invalid_parameters',
844	            message: 'Invalid parameters',
845	            errors: validationResult.errors.map(e => `${e.field}: ${e.message}`)
846	          }
847	        },
848	        request_id: request.request_id
849	      };
850	      callback(errorResponse);
851	      return;
852	    }
853	    
854	    // Execute the prompt
855	    prompt.execute(parameters)
856	      .then((result: any) => {
857	        this.logger.debug(`Prompt ${name} execution successful`);
858	        const response: MCPResponse = (result as any).content ? (result as any) : { content: [{ type: 'text', text: JSON.stringify(result) }] };
859	        callback({ ...response, request_id: request.request_id });
860	      })
861	      .catch((error: unknown) => {
862	        this.logger.error(`Prompt ${name} execution error`, error as any);
863	        const errorResponse: ErrorResponse = {
864	          error: {
865	            type: 'execution' as ErrorType,
866	            details: {
867	              code: 'prompt_error',
868	              message: error instanceof Error ? error.message : 'Unknown error'
869	            }
870	          },
871	          request_id: request.request_id
872	        };
873	        callback(errorResponse);
874	      });
875	  }
