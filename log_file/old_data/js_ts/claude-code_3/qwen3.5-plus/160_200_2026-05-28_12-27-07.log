1	import { resolveConfig } from "@mcp-docsrs/config/index.ts"
2	import type { ServerConfigInput } from "@mcp-docsrs/config/types.ts"
3	import { createDocsFetcher } from "@mcp-docsrs/docs/index.ts"
4	import { ErrorLogger, ShutdownError, StartupError, tryAsync } from "@mcp-docsrs/errors"
5	import { APP_NAME, APP_VERSION } from "@mcp-docsrs/meta.ts"
6	import { registerPrompts } from "@mcp-docsrs/prompts/register.ts"
7	import { registerTools } from "@mcp-docsrs/tools/register.ts"
8	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js"
9	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js"
10	import type { RustDocsServer } from "./types.ts"
11	
12	type ServerDeps = {
13		createFetcher?: typeof createDocsFetcher
14		fetcher?: ReturnType<typeof createDocsFetcher>
15	}
16	
17	const closeServer = async (
18		server: McpServer,
19		fetcher: {
20			close: () => void
21		},
22		state: {
23			isClosed: boolean
24		}
25	) => {
26		if (state.isClosed) {
27			return
28		}
29	
30		state.isClosed = true
31		try {
32			await server.close()
33		} catch {
34			ErrorLogger.logInfo("Server close skipped because transport was not connected")
35		}
36		fetcher.close()
37	}
38	
39	const startServer = async (server: McpServer, config: ReturnType<typeof resolveConfig>) => {
40		await server.connect(new StdioServerTransport())
41		ErrorLogger.logInfo("MCP Rust Docs Server is running", {
42			config
43		})
44	}
45	
46	const createServer = (
47		configInput: ServerConfigInput = {},
48		deps: ServerDeps = {}
49	): RustDocsServer => {
50		const config = resolveConfig(configInput)
51		const server = new McpServer({
52			name: APP_NAME,
53			version: APP_VERSION
54		})
55		const fetcher = deps.fetcher ?? (deps.createFetcher ?? createDocsFetcher)(config)
56		const state = {
57			isClosed: false
58		}
59	
60		registerTools(server, fetcher)
61		registerPrompts(server)
62	
63		return {
64			close: () =>
65				tryAsync(
66					() => closeServer(server, fetcher, state),
67					(error) => new ShutdownError("close the server", error)
68				),
69			config,
70			server,
71			start: () =>
72				tryAsync(
73					() => startServer(server, config),
74					(error) => new StartupError("start the server", error)
75				)
76		}
77	}
78	
