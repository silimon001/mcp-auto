615	  /**
616	   * Validate that a request follows the MCP protocol format
617	   * @param request - The request to validate
618	   * @returns True if the request is valid, false otherwise
619	   */
620	  private validateMCPRequest(request: any): { valid: boolean; error?: string } {
621	    // Check if request is an object
622	    if (!request || typeof request !== 'object') {
623	      return { valid: false, error: 'Request must be a JSON object' };
624	    }
625	
626	    // Check if request has required fields
627	    if (!('type' in request)) {
628	      return { valid: false, error: 'Missing required field: type' };
629	    }
630	
631	    if (!('name' in request)) {
632	      return { valid: false, error: 'Missing required field: name' };
633	    }
634	
635	    if (!('request_id' in request)) {
636	      return { valid: false, error: 'Missing required field: request_id' };
637	    }
638	
639	    // Validate request type
640	    if (request.type !== 'tool_call' && request.type !== 'prompt_call') {
641	      return { valid: false, error: `Invalid request type: ${request.type}. Must be 'tool_call' or 'prompt_call'` };
642	    }
643	
644	    // Validate request name
645	    if (typeof request.name !== 'string' || request.name.trim() === '') {
646	      return { valid: false, error: 'Invalid request name: must be a non-empty string' };
647	    }
648	
649	    // Validate request_id
650	    if (typeof request.request_id !== 'string' || request.request_id.trim() === '') {
651	      return { valid: false, error: 'Invalid request_id: must be a non-empty string' };
652	    }
653	
654	    // Validate parameters
655	    if (!('parameters' in request) || typeof request.parameters !== 'object') {
656	      return { valid: false, error: 'Missing or invalid parameters: must be an object' };
657	    }
658	
659	    return { valid: true };
660	  }
661	
662	  /**
663	   * Handle an MCP request
664	   * @param request - The MCP request
665	   * @param callback - Callback function to receive the response
666	   */
667	  public handleMCPRequest(request: MCPRequest, callback: (response: MCPResponse | ErrorResponse) => void): void {
668	    // Validate the request format
669	    const validation = this.validateMCPRequest(request);
670	    if (!validation.valid) {
671	      this.logger.warn('Invalid MCP request format', { error: validation.error, request });
672	      callback({
673	        error: {
674	          type: 'transport',
675	          details: {
676	            code: 'invalid_request',
677	            message: validation.error || 'Invalid request format'
678	          }
679	        },
680	        request_id: (request as any)?.request_id || 'unknown'
681	      });
682	      return;
683	    }
684	
685	    const requestType = (request as any).type;
686	    const requestName = (request as any).name;
687	    const requestId = (request as any).request_id;
688	    
689	    this.logger.debug('Handling MCP request', {
690	      type: requestType,
691	      name: requestName,
692	      request_id: requestId
693	    });
694	    
695	    // Handle different request types
696	    if (requestType === 'tool_call') {
697	      this.handleToolCall(request as MCPRequest & { type: 'tool_call' }, callback);
698	    } else if (requestType === 'prompt_call') {
699	      this.handlePromptCall(request as MCPRequest & { type: 'prompt_call' }, callback);
700	    } else {
701	      this.logger.warn(`Unknown request type: ${requestType}`);
702	      
703	      // Return error
704	      callback({
705	        error: {
706	          type: 'transport',
707	          details: {
708	            code: 'invalid_request_type',
709	            message: `Unknown request type: ${requestType}`
710	          }
711	        },
712	        request_id: requestId
713	      });
714	    }
715	  }
