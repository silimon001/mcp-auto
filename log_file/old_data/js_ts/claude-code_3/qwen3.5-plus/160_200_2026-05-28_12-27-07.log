1	// Auth header middleware for Hono
2	// Supports multiple auth strategies: OAuth, API Key, Bearer, Custom Headers
3	
4	import type { HttpBindings } from '@hono/node-server';
5	import type { MiddlewareHandler } from 'hono';
6	import { config } from '../../config/env.js';
7	import type { AuthStrategyType } from '../../shared/auth/strategy.js';
8	import type { ProviderTokens } from '../../shared/storage/interface.js';
9	import { getTokenStore } from '../../shared/storage/singleton.js';
10	import { logger } from '../../utils/logger.js';
11	
12	/**
13	 * Auth context attached to Hono context.
14	 */
15	export interface AuthContext {
16	  /** Auth strategy in use */
17	  strategy: AuthStrategyType;
18	  /** Raw authorization headers from request */
19	  authHeaders: Record<string, string>;
20	  /** Resolved headers for API calls (includes static config headers) */
21	  resolvedHeaders: Record<string, string>;
22	  /** Provider access token (OAuth: mapped from RS token, Bearer: from config) */
23	  providerToken?: string;
24	  /** Full provider token info (OAuth only) */
25	  provider?: ProviderTokens;
26	  /** Original RS token (OAuth only) */
27	  rsToken?: string;
28	}
29	
30	/**
31	 * Parse custom headers from config string.
32	 * Format: "X-Header-1:value1,X-Header-2:value2"
33	 */
34	function parseCustomHeaders(value: string | undefined): Record<string, string> {
35	  if (!value) return {};
36	
37	  const headers: Record<string, string> = {};
38	  const pairs = value.split(',');
39	
40	  for (const pair of pairs) {
41	    const colonIndex = pair.indexOf(':');
42	    if (colonIndex === -1) continue;
43	
44	    const key = pair.slice(0, colonIndex).trim();
45	    const val = pair.slice(colonIndex + 1).trim();
46	
47	    if (key && val) {
48	      headers[key.toLowerCase()] = val;
49	    }
50	  }
51	
52	  return headers;
53	}
54	
55	/**
56	 * Build static headers from non-OAuth auth config.
57	 */
58	function buildStaticAuthHeaders(): Record<string, string> {
59	  const headers: Record<string, string> = {};
60	
61	  switch (config.AUTH_STRATEGY) {
62	    case 'api_key':
63	      if (config.API_KEY) {
64	        headers[config.API_KEY_HEADER.toLowerCase()] = config.API_KEY;
65	      }
66	      break;
67	
68	    case 'bearer':
69	      if (config.BEARER_TOKEN) {
70	        headers['authorization'] = `Bearer ${config.BEARER_TOKEN}`;
71	      }
72	      break;
73	
74	    case 'custom':
75	      Object.assign(headers, parseCustomHeaders(config.CUSTOM_HEADERS));
76	      break;
77	  }
78	
79	  return headers;
80	}
81	
82	/**
83	 * Auth middleware that handles multiple strategies.
84	 *
85	 * Strategies:
86	 * - 'oauth': Map RS token → Provider token (full OAuth flow)
87	 * - 'bearer': Use static BEARER_TOKEN from config
88	 * - 'api_key': Use static API_KEY in API_KEY_HEADER
89	 * - 'custom': Use static CUSTOM_HEADERS
90	 * - 'none': No auth, pass through
91	 *
92	 * After this middleware:
93	 * - c.authContext.resolvedHeaders: Headers ready for API calls
94	 * - c.authContext.providerToken: Access token (if available)
95	 * - c.authContext.provider: Full token info (OAuth only)
96	 */
97	export function createAuthHeaderMiddleware(): MiddlewareHandler<{
98	  Bindings: HttpBindings;
99	}> {
100	  const accept = new Set(
101	    (config.MCP_ACCEPT_HEADERS as string[]).map((h) => h.toLowerCase()),
102	  );
103	  // Always include standard auth headers
104	  ['authorization', 'x-api-key', 'x-auth-token'].forEach((h) => accept.add(h));
105	
106	  // Pre-compute static headers for non-OAuth strategies
107	  const staticHeaders = buildStaticAuthHeaders();
108	  const strategy = config.AUTH_STRATEGY;
109	
110	  return async (c, next) => {
111	    const incoming = c.req.raw.headers;
112	    const forwarded: Record<string, string> = {};
113	
114	    for (const [k, v] of incoming as unknown as Iterable<[string, string]>) {
115	      const lower = k.toLowerCase();
116	      if (accept.has(lower)) {
117	        forwarded[lower] = v;
118	      }
119	    }
120	
121	    // Initialize auth context
122	    const authContext: AuthContext = {
123	      strategy,
124	      authHeaders: forwarded,
125	      resolvedHeaders: { ...forwarded },
126	    };
127	
128	    // Handle based on strategy
129	    switch (strategy) {
130	      case 'oauth':
131	        await handleOAuthStrategy(authContext, forwarded);
132	        break;
133	
134	      case 'bearer':
135	        // Use static bearer token from config
136	        authContext.resolvedHeaders = { ...forwarded, ...staticHeaders };
137	        authContext.providerToken = config.BEARER_TOKEN;
138	        break;
139	
140	      case 'api_key':
141	        // Use static API key from config
142	        authContext.resolvedHeaders = { ...forwarded, ...staticHeaders };
143	        authContext.providerToken = config.API_KEY;
144	        break;
145	
146	      case 'custom':
147	        // Merge custom headers
148	        authContext.resolvedHeaders = { ...forwarded, ...staticHeaders };
149	        break;
150	
151	      case 'none':
152	      default:
153	        // Pass through as-is
154	        break;
155	    }
156	
157	    // Attach to context for downstream handlers
158	    (c as unknown as { authContext: AuthContext }).authContext = authContext;
159	
160	    // Legacy: attach authHeaders for backward compatibility
161	    (c as unknown as { authHeaders?: Record<string, string> }).authHeaders =
162	      authContext.resolvedHeaders;
163	
164	    await next();
165	  };
166	}
167	
168	/**
169	 * Handle OAuth strategy: map RS token to provider token.
170	 */
171	async function handleOAuthStrategy(
172	  authContext: AuthContext,
173	  forwarded: Record<string, string>,
174	): Promise<void> {
175	  const auth = forwarded.authorization;
176	  const bearerMatch = auth?.match(/^\s*Bearer\s+(.+)$/i);
177	  const rsToken = bearerMatch?.[1];
178	
179	  if (!rsToken) return;
180	
181	  authContext.rsToken = rsToken;
182	
183	  try {
184	    const store = getTokenStore();
185	    const record = await store.getByRsAccess(rsToken);
186	
187	    if (record?.provider?.access_token) {
188	      const now = Date.now();
189	      const expiresAt = record.provider.expires_at ?? 0;
190	
191	      if (expiresAt && now >= expiresAt - 60_000) {
192	        logger.warning('auth_middleware', {
193	          message: 'Provider token expired or expiring soon',
194	          expiresAt,
195	          now,
196	        });
197	      }
198	
199	      authContext.providerToken = record.provider.access_token;
200	      authContext.provider = record.provider;
201	
202	      // Replace RS token with provider token in resolved headers
203	      authContext.resolvedHeaders.authorization = `Bearer ${record.provider.access_token}`;
204	
205	      logger.debug('auth_middleware', {
206	        message: 'Mapped RS token to provider token',
207	        hasRefreshToken: Boolean(record.provider.refresh_token),
208	        expiresAt: record.provider.expires_at,
209	      });
210	    } else if (config.AUTH_REQUIRE_RS && !config.AUTH_ALLOW_DIRECT_BEARER) {
211	      delete authContext.resolvedHeaders.authorization;
212	      logger.warning('auth_middleware', {
213	        message: 'RS token not found in store',
214	      });
215	    }
216	  } catch (error) {
217	    logger.error('auth_middleware', {
218	      message: 'Failed to look up RS token',
219	      error: (error as Error).message,
220	    });
221	  }
222	}
223	

