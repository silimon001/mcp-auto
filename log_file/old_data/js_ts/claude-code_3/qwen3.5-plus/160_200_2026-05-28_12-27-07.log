574	   * Set up stdio transport
575	   */
576	  private setupStdioTransport(): void {
577	    this.logger.debug('Setting up stdio transport');
578	    
579	    process.stdin.setEncoding('utf8');
580	    process.stdin.on('data', (data: Buffer) => {
581	      try {
582	        const input = data.toString().trim();
583	        if (!input) return;
584	        
585	        // Parse the request
586	        const request = JSON.parse(input) as MCPRequest;
587	        
588	        // Handle the request
589	        this.handleMCPRequest(request, (response) => {
