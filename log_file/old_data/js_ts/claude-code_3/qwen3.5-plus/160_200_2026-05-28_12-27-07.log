34	/**
35	 * Register all tools with the MCP server.
36	 * Combines shared tools (cross-runtime) with Node-specific tools.
37	 */
38	export function registerTools(server: McpServer): void {
39	  const registeredNames: string[] = [];
40	
41	  // Register shared tools (work in both Node and Workers)
42	  for (const tool of sharedTools) {
43	    try {
44	      // Extract shape from schema, handling ZodEffects (refined schemas)
45	      const inputSchemaShape = getSchemaShape(tool.inputSchema);
46	      if (!inputSchemaShape) {
47	        logger.error('tools', {
48	          message: 'Failed to extract schema shape',
49	          toolName: tool.name,
50	        });
51	        throw new Error(`Failed to extract schema shape for tool: ${tool.name}`);
52	      }
53	
54	      const wrappedHandler = createWrappedHandler(server, tool.handler);
55	
56	      // Shared tools use Zod schemas - pass extracted shape for SDK compatibility
57	      server.registerTool(
58	        tool.name,
59	        {
60	          description: tool.description,
61	          inputSchema: inputSchemaShape,
62	          ...(tool.outputSchema && { outputSchema: tool.outputSchema }),
63	          ...(tool.annotations && { annotations: tool.annotations }),
64	        },
65	        wrappedHandler as Parameters<typeof server.registerTool>[2],
66	      );
67	
68	      registeredNames.push(tool.name);
69	      logger.debug('tools', { message: 'Registered shared tool', toolName: tool.name });
70	    } catch (error) {
71	      logger.error('tools', {
72	        message: 'Failed to register shared tool',
73	        toolName: tool.name,
74	        error: (error as Error).message,
75	      });
76	      throw error;
77	    }
78	  }
79	
80	  // Register Node-specific tools
81	  const nodeTools: any[] = [
82	    // Add Node-specific tools here if needed
83	  ];
84	
85	  logger.info('tools', {
86	    message: `Registered ${registeredNames.length} tools`,
87	    toolNames: registeredNames,
88	    sharedCount: sharedTools.length,
89	    nodeSpecificCount: nodeTools.length,
90	  });
91	}
