1	import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
2	import { SetLevelRequestSchema } from '@modelcontextprotocol/sdk/types.js';
3	import { config } from '../config/env.js';
4	import { registerTools } from '../tools/index.js';
5	import { logger } from '../utils/logger.js';
6	import { buildCapabilities } from './capabilities.js';
7	
8	export interface ServerOptions {
9	  name: string;
10	  version: string;
11	  instructions?: string;
12	  /**
13	   * Called when initialization is complete (after client sends notifications/initialized).
14	   */
15	  oninitialized?: () => void;
16	}
17	
18	export function buildServer(options: ServerOptions): McpServer {
19	  const { name, version, instructions, oninitialized } = options;
20	
21	  const server = new McpServer(
22	    { name, version },
23	    {
24	      capabilities: buildCapabilities(),
25	      instructions: instructions ?? config.MCP_INSTRUCTIONS,
26	    },
27	  );
28	
29	  // Set up logging
30	  logger.setServer(server);
31	
32	  // Register oninitialized callback
33	  const lowLevel = (server as any).server;
34	  if (lowLevel && oninitialized) {
35	    lowLevel.oninitialized = () => {
36	      logger.info('mcp', {
37	        message: 'Client initialization complete (notifications/initialized received)',
38	        clientVersion: lowLevel.getClientVersion?.(),
39	      });
40	      oninitialized();
41	    };
42	  }
43	
44	  // Register tools (no prompts/resources for Google Calendar MCP)
45	  registerTools(server);
46	
47	  // Register logging/setLevel handler (required when logging capability is advertised)
48	  server.server.setRequestHandler(SetLevelRequestSchema, async (request) => {
49	    const level = request.params.level;
50	    logger.info('mcp', { message: 'Log level changed', level });
51	    return {};
52	  });
53	
54	  return server;
55	}
