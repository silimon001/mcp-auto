304	  async getEvent(calendarId: string, eventId: string): Promise<CalendarEvent> {
305	    const normalizedId = this.normalizeEventId(eventId);
306	    const path = `/calendars/${encodeURIComponent(calendarId)}/events/${encodeURIComponent(normalizedId)}`;
307	    return this.request(path);
