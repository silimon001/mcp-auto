324	  async start(): Promise<void> {
325	    return new Promise<void>((resolve, reject) => {
326	      this.logger.info('Starting HTTP server...');
327	      this.logger.info(`Binding to 0.0.0.0:${this.port}`);
328	      this.logger.debug('Routes are already set up in constructor');
329	      
