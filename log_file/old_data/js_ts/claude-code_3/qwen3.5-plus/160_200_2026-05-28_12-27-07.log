1	#!/usr/bin/env node
2	
3	// Runtime imports - need .js extension
4	import { ReadwiseMCPServer } from './server.js';
5	
6	// Type-only imports - no .js extension
7	import type { TransportType } from './types/index.js';
8	
9	// Local imports with implementation - need .js extension
10	import { ReadwiseClient } from './api/client.js';
11	import { ReadwiseAPI } from './api/readwise-api.js';
12	import { SafeLogger } from './utils/safe-logger.js';
13	import { LogLevel } from './utils/logger-interface.js';
14	import { getConfig, saveConfig } from './utils/config.js';
15	import yargs from 'yargs';
16	import { hideBin } from 'yargs/helpers';
17	import readline from 'readline';
18	
19	/**
20	 * Main entry point for the Readwise MCP server
21	 */
22	async function main() {
23	  try {
24	    const argv = yargs(hideBin(process.argv))
25	      .option('port', {
26	        alias: 'p',
27	        description: 'Port to listen on',
28	        type: 'number',
29	        default: process.env.PORT ? parseInt(process.env.PORT, 10) : 8081
30	      })
31	      .option('transport', {
32	        alias: 't',
33	        description: 'Transport type (stdio or sse)',
34	        choices: ['stdio', 'sse'] as TransportType[],
35	        default: 'stdio' as TransportType
36	      })
37	      .option('debug', {
38	        alias: 'd',
39	        description: 'Enable debug logging',
40	        type: 'boolean',
41	        default: false
42	      })
43	      .option('api-key', {
44	        alias: 'k',
45	        description: 'Readwise API key',
46	        type: 'string'
47	      })
48	      .option('setup', {
49	        alias: 's',
50	        description: 'Run setup wizard',
51	        type: 'boolean',
52	        default: false
53	      })
54	      .help()
55	      .argv as {
56	        port: number;
57	        transport: TransportType;
58	        debug: boolean;
59	        'api-key'?: string;
60	        setup: boolean;
61	      };
62	
63	    // Create logger
64	    const logger = new SafeLogger({
65	      level: argv.debug ? LogLevel.DEBUG : LogLevel.INFO,
66	      transport: argv.transport === 'sse' ? console.log : console.error,
67	      timestamps: true,
68	      colors: true,
69	    });
70	
71	    logger.info('Starting Readwise MCP server');
72	    logger.debug('Command line arguments:', argv as any);
73	
74	    try {
75	    // Run setup wizard if requested
76	    if (argv.setup) {
77	      const apiKey = await runSetupWizard();
78	      logger.info('Setup complete');
79	      return;
80	    }
81	
82	    // Load config
83	    logger.debug('Loading configuration...');
84	    const config = getConfig();
85	    logger.debug('Configuration loaded');
86	    
87	    // Get API key from command-line args, config, or environment
88	    const apiKey = argv['api-key'] || config.readwiseApiKey || process.env.READWISE_API_KEY || '';
89	    
90	    // Allow server to start without API key for Smithery scanning (lazy loading)
91	    // API key will be validated when tools are actually called
92	    if (!apiKey) {
93	      logger.warn('No API key provided. Server will start but tools will require authentication.');
94	    } else {
95	      logger.debug('API key provided');
96	    }
97	
98	    logger.info('Initializing server...');
99	    logger.info(`Port: ${argv.port}, Transport: ${argv.transport}`);
100	    
101	    // Start the server
102	    let server: ReadwiseMCPServer;
103	    try {
104	      server = new ReadwiseMCPServer(
105	        apiKey,
106	        argv.port,
107	        logger,
108	        argv.transport
109	      );
110	      logger.info('Server instance created successfully');
111	    } catch (error) {
112	      logger.error('Failed to create server instance:', error as any);
113	      throw error;
114	    }
115	
116	    logger.info('Starting server...');
117	    try {
118	      await server.start();
119	      logger.info('✓ Server started successfully');
120	      logger.info(`✓ Server is running and ready to accept connections on port ${argv.port}`);
121	      
122	      // Keep the process alive - important for containerized deployments
123	      // The server will continue running until explicitly stopped
124	      setInterval(() => {
125	        // Periodic heartbeat to ensure process stays alive
126	        // This helps detect if the process is still responsive
127	        if (process.uptime() % 60 === 0) {
128	          logger.debug(`Server heartbeat: uptime ${Math.floor(process.uptime())}s`);
129	        }
130	      }, 10000); // Every 10 seconds
131	      
132	    } catch (error) {
133	      logger.error('Failed to start server:', error as any);
134	      process.exit(1);
135	    }
136	    
137	    // Handle shutdown gracefully
138	    const shutdown = async () => {
139	      logger.info('Shutting down...');
140	      try {
141	        await server.stop();
142	        logger.info('Server stopped successfully');
143	      } catch (error) {
144	        logger.error('Error stopping server:', error as any);
145	      }
146	      process.exit(0);
147	    };
148	    
149	    process.on('SIGINT', shutdown);
150	    process.on('SIGTERM', shutdown);
151	    
152	    // Handle unhandled errors - log but don't exit immediately to allow health checks
153	    process.on('uncaughtException', (error) => {
154	      logger.error('Uncaught exception', error);
155	      // Log but don't exit - allow health checks to still work
156	      // In production, you might want to exit here, but for Smithery we want to stay alive
157	    });
158	    
159	    process.on('unhandledRejection', (reason, promise) => {
160	      logger.error('Unhandled promise rejection', { reason, promise } as any);
161	      // Log but don't exit - allow server to continue serving health checks
162	    });
163	    
164	    } catch (error) {
165	      logger.error('Failed to start server:', error as any);
166	      process.exit(1);
167	    }
168	  } catch (error) {
169	    // Top-level error handler - log and exit if we can't even create logger
170	    console.error('Fatal error starting server:', error);
171	    if (error instanceof Error) {
172	      console.error('Error details:', {
173	        message: error.message,
174	        stack: error.stack,
175	        name: error.name
176	      });
177	    }
178	    process.exit(1);
179	  }
180	}
181	
182	/**
183	 * Run the setup wizard to configure the API key
184	 */
185	async function runSetupWizard(): Promise<string> {
186	  const rl = readline.createInterface({
187	    input: process.stdin,
188	    output: process.stdout
189	  });
190	
191	  const question = (prompt: string): Promise<string> => {
192	    return new Promise((resolve) => {
193	      rl.question(prompt, (answer) => {
194	        resolve(answer);
195	      });
196	    });
197	  };
198	
199	  console.log('Readwise MCP Server Setup Wizard');
200	  console.log('-------------------------------');
201	  console.log('');
202	  console.log('This wizard will help you set up your Readwise MCP server.');
203	  console.log('You will need your Readwise API key to continue.');
204	  console.log('');
205	  console.log('You can find your API key at https://readwise.io/access_token');
206	  console.log('');
207	
208	  let apiKey = await question('Enter your Readwise API key: ');
209	  
210	  while (!apiKey) {
211	    console.log('API key is required.');
212	    apiKey = await question('Enter your Readwise API key: ');
213	  }
214	
215	  try {
216	    // Test the API key by making a request to the Readwise API
217	    console.log('Validating API key...');
218	    
219	    const client = new ReadwiseClient({ apiKey });
220	    const api = new ReadwiseAPI(client);
221	    
222	    try {
223	      // Attempt to fetch a single book to verify API key works
224	      await api.getBooks({ page: 1, page_size: 1 });
225	      console.log('API key validated successfully.');
226	    } catch (error) {
227	      if (error instanceof Error && error.message.includes('401')) {
228	        console.error('Error: Invalid API key. Please check your API key and try again.');
229	        rl.close();
230	        return runSetupWizard(); // Restart the setup wizard
231	      }
232	      
233	      console.warn('Warning: Could not validate API key due to API connection issue.');
234	      const proceed = await question('Do you want to save this API key anyway? (y/n): ');
235	      
236	      if (proceed.toLowerCase() !== 'y') {
237	        rl.close();
238	        return runSetupWizard(); // Restart the setup wizard
239	      }
240	    }
241	    
242	    // Save the API key to the config with secure permissions
243	    saveConfig({ readwiseApiKey: apiKey });
244	    
245	    console.log('');
246	    console.log('Configuration saved successfully.');
247	    console.log('You can now start the server using:');
248	    console.log('  readwise-mcp');
249	    console.log('');
250	  } catch (error) {
