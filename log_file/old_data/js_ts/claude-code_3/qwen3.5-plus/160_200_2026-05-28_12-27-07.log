70	function parseBoolean(value: unknown): boolean {
71	  return String(value || 'false').toLowerCase() === 'true';
72	}
73	
74	function parseNumber(value: unknown, defaultValue: number): number {
75	  const num = Number(value);
76	  return Number.isFinite(num) ? num : defaultValue;
77	}
78	
79	function parseStringArray(value: unknown): string[] {
80	  return String(value || '')
81	    .split(',')
82	    .map((s) => s.trim())
83	    .filter(Boolean);
84	}
85	
86	/**
87	 * Determine auth strategy from env.
88	 * Priority: AUTH_STRATEGY > AUTH_ENABLED > default
89	 */
90	function parseAuthStrategy(env: Record<string, unknown>): AuthStrategyType {
91	  const explicit = (env.AUTH_STRATEGY as string)?.toLowerCase();
92	  if (explicit && ['oauth', 'bearer', 'api_key', 'custom', 'none'].includes(explicit)) {
93	    return explicit as AuthStrategyType;
94	  }
95	
96	  // Fallback: if AUTH_ENABLED is true, default to OAuth
97	  if (parseBoolean(env.AUTH_ENABLED)) {
98	    return 'oauth';
99	  }
100	
101	  // Check if API_KEY is set → default to api_key
102	  if (env.API_KEY) {
103	    return 'api_key';
104	  }
105	
106	  // Check if BEARER_TOKEN is set → default to bearer
107	  if (env.BEARER_TOKEN) {
108	    return 'bearer';
109	  }
110	
111	  return 'none';
112	}
113	
114	/**
115	 * Parse environment variables into a unified config object
116	 * Works for both process.env (Node.js) and Workers env bindings
117	 */
118	export function parseConfig(env: Record<string, unknown>): UnifiedConfig {
119	  const authStrategy = parseAuthStrategy(env);
120	
121	  return {
122	    HOST: String(env.HOST || '127.0.0.1'),
123	    PORT: parseNumber(env.PORT, 3000),
124	    NODE_ENV: (env.NODE_ENV as UnifiedConfig['NODE_ENV']) || 'development',
125	
126	    MCP_TITLE: String(env.MCP_TITLE || 'MCP Server Template'),
127	    MCP_INSTRUCTIONS: String(
128	      env.MCP_INSTRUCTIONS ||
129	        'Use these tools responsibly. Prefer minimal scopes and small page sizes.',
130	    ),
131	    MCP_VERSION: String(env.MCP_VERSION || '0.1.0'),
132	    MCP_PROTOCOL_VERSION: String(env.MCP_PROTOCOL_VERSION || '2025-06-18'),
133	    MCP_ACCEPT_HEADERS: parseStringArray(env.MCP_ACCEPT_HEADERS),
134	
135	    // Auth Strategy
136	    AUTH_STRATEGY: authStrategy,
137	    AUTH_ENABLED: authStrategy === 'oauth' || parseBoolean(env.AUTH_ENABLED),
138	    AUTH_REQUIRE_RS: parseBoolean(env.AUTH_REQUIRE_RS),
139	    AUTH_ALLOW_DIRECT_BEARER: parseBoolean(env.AUTH_ALLOW_DIRECT_BEARER),
140	    AUTH_RESOURCE_URI: env.AUTH_RESOURCE_URI as string | undefined,
141	    AUTH_DISCOVERY_URL: env.AUTH_DISCOVERY_URL as string | undefined,
142	
143	    // API Key auth
144	    API_KEY: env.API_KEY as string | undefined,
145	    API_KEY_HEADER: String(env.API_KEY_HEADER || 'x-api-key'),
146	
