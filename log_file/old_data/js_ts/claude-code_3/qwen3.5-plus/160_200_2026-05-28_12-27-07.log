309	/**
310	 * Create and configure the Readwise MCP server
311	 * This is the default export that Smithery will call
312	 */
313	export default function ({ config }: { config: z.infer<typeof configSchema> }) {
314	  try {
315	    const apiKey = config.readwiseApiKey || '';
316	    
317	    if (config.debug) {
318	      console.log('Starting Readwise MCP Server in debug mode');
319	      console.log(`API key provided: ${apiKey ? 'Yes' : 'No (lazy loading enabled)'}`);
320	    }
321	
322	    // Create API client (allow empty API key for lazy loading)
323	    // Use FetchClient for Cloudflare Workers compatibility
324	    const apiClient = new FetchClient({
325	      apiKey: apiKey || '',
326	    });
327	    
328	    const api = new ReadwiseAPI(apiClient);
329	
330	    // Create MCP server
331	    const server = new McpServer({
332	      name: "readwise-mcp",
333	      title: "Readwise",
334	      version: "1.0.0",
335	    });
336	
337	    // Register all tools
338	    const tools = [
339	      // Core tools
340	      new GetHighlightsTool(api, consoleLogger),
341	      new GetBooksTool(api, consoleLogger),
342	      new GetDocumentsTool(api, consoleLogger),
343	      new SearchHighlightsTool(api, consoleLogger),
344	      new GetTagsTool(api, consoleLogger),
345	      new DocumentTagsTool(api, consoleLogger),
346	      new BulkTagsTool(api, consoleLogger),
347	      new GetReadingProgressTool(api, consoleLogger),
348	      new UpdateReadingProgressTool(api, consoleLogger),
349	      new GetReadingListTool(api, consoleLogger),
350	      // Highlight management
351	      new CreateHighlightTool(api, consoleLogger),
352	      new UpdateHighlightTool(api, consoleLogger),
353	      new DeleteHighlightTool(api, consoleLogger),
354	      new CreateNoteTool(api, consoleLogger),
355	      // Search tools
356	      new AdvancedSearchTool(api, consoleLogger),
357	      new SearchByTagTool(api, consoleLogger),
358	      new SearchByDateTool(api, consoleLogger),
359	      // Video tools
360	      new GetVideosTool(api, consoleLogger),
361	      new GetVideoTool(api, consoleLogger),
362	      new CreateVideoHighlightTool(api, consoleLogger),
363	      new GetVideoHighlightsTool(api, consoleLogger),
364	      new UpdateVideoPositionTool(api, consoleLogger),
365	      new GetVideoPositionTool(api, consoleLogger),
366	      // Document management tools
367	      new SaveDocumentTool(api, consoleLogger),
368	      new UpdateDocumentTool(api, consoleLogger),
369	      new DeleteDocumentTool(api, consoleLogger),
370	      new GetRecentContentTool(api, consoleLogger),
371	      // Bulk document operation tools
372	      new BulkSaveDocumentsTool(api, consoleLogger),
373	      new BulkUpdateDocumentsTool(api, consoleLogger),
374	      new BulkDeleteDocumentsTool(api, consoleLogger),
375	    ];
376	
377	    // Tool annotations based on operation type
378	    const getToolAnnotations = (toolName: string) => {
379	      // Delete operations - destructive but idempotent (deleting twice = same result)
380	      const deleteTools = ['delete_highlight', 'delete_document', 'bulk_delete_documents'];
381	      if (deleteTools.includes(toolName)) {
382	        return { readOnlyHint: false, destructiveHint: true, idempotentHint: true };
383	      }
384	
385	      // Create operations - not idempotent (creating twice = two resources)
386	      const createTools = [
387	        'create_highlight', 'create_note', 'create_video_highlight',
388	        'save_document', 'bulk_save_documents'
389	      ];
390	      if (createTools.includes(toolName)) {
391	        return { readOnlyHint: false, destructiveHint: false, idempotentHint: false };
392	      }
393	
394	      // Update operations - idempotent (updating twice with same data = same result)
395	      const updateTools = [
396	        'update_highlight', 'update_reading_progress', 'update_video_position',
397	        'update_document', 'bulk_update_documents', 'document_tags', 'bulk_tags'
398	      ];
399	      if (updateTools.includes(toolName)) {
