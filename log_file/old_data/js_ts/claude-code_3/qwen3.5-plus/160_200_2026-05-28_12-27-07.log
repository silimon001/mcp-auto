1	import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
2	import type { ZodObject, ZodRawShape, ZodTypeAny } from 'zod';
3	import { contextRegistry, getCurrentAuthContext } from '../core/context.js';
4	import { sharedTools, type ToolContext } from '../shared/tools/registry.js';
5	import type { RequestContext } from '../types/context.js';
