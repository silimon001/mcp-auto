1	#!/usr/bin/env node
2	
3	import { Command } from 'commander';
4	import { startServer } from '../src/server';
5	import fs from 'fs';
6	import path from 'path';
7	
8	// Get package version from package.json
9	let version = '1.0.0';
10	try {
11	  const packageJsonPath = path.join(__dirname, '../package.json');
12	  const packageJson = JSON.parse(fs.readFileSync(packageJsonPath, 'utf8'));
13	  version = packageJson.version || version;
14	} catch (error) {
15	  console.error('Warning: Could not read package.json version');
16	}
17	
18	// Setup CLI program
19	const program = new Command();
20	program
21	  .name('readwise-mcp')
22	  .description('Readwise MCP server for accessing your Readwise library')
23	  .version(version);
24	
25	// Add options
26	program
27	  .option('-p, --port <number>', 'Port to listen on (for SSE transport)', '3000')
28	  .option('-t, --transport <type>', 'Transport type (stdio or sse)', 'stdio')
29	  .option('-d, --debug', 'Enable debug mode')
30	  .option('-c, --config <path>', 'Path to config file')
31	  .option('-k, --api-key <key>', 'Readwise API key (overrides config file and environment)')
32	  .option('-b, --base-url <url>', 'Readwise API base URL (overrides config file and environment)');
33	
34	// Define action
35	program.action((options) => {
36	  // Start the server with the provided options
37	  startServer({
38	    port: parseInt(options.port, 10),
39	    transport: options.transport as 'stdio' | 'sse',
40	    debug: !!options.debug,
41	    configPath: options.config,
42	    readwiseApiKey: options.apiKey,
43	    readwiseApiBaseUrl: options.baseUrl
44	  });
45	});
46	
47	// Parse command line arguments
48	program.parse(process.argv); 

