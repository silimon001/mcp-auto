3	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
4	import { createServer } from "./mcp/server.js";
5	import "./mcp/logging.js";
6	import { createWebServer } from "./excalidraw/index.js";
7	
8	async function main() {
9	  const userServerInfo = await createWebServer("/user/index.html");
10	  const userTargetUrl = `http://localhost:${userServerInfo.port}`;
11	  
12	  // Set the port as environment variable for the MCP server to use
13	  process.env.USER_APP_PORT = userServerInfo.port.toString();
14	  
15	  console.log(`✅ User Excalidraw app started on ${userTargetUrl}`);
16	  console.log(`📊 Open the app to view diagrams: ${userTargetUrl}/user/`);
17	
18	  const transport = new StdioServerTransport();
19	  const server = createServer();
20	  await server.connect(transport);
21	
22	  // Simple cleanup on exit
23	  process.on('SIGINT', () => {
24	    userServerInfo.server.close();
25	    server.close();
26	    process.exit(0);
27	  });
28	}
29	
30	main().catch((error) => {
31	  console.error("Fatal error in main():", error);
32	  process.exit(1);
