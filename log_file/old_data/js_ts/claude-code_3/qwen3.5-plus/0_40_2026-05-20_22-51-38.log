1	#!/usr/bin/env node
2	import { Server } from '@modelcontextprotocol/sdk/server/index.js';
3	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
4	import {
5	  CallToolRequestSchema,
6	  CallToolRequest,
7	  ErrorCode,
8	  ListToolsRequestSchema,
9	  ListResourcesRequestSchema,
10	  ReadResourceRequestSchema,
11	  McpError,
12	} from '@modelcontextprotocol/sdk/types.js';
13	import * as fs from 'fs';
14	import * as path from 'path';
15	import { NReplClient } from './nrepl-client.js';
16	
17	class NReplMcpServer {
18	  private server: Server;
19	  private nreplClient: NReplClient | null = null;
20	  private host: string | null = null;
21	  private port: number | null = null;
22	
23	  constructor() {
24	    this.server = new Server(
25	      {
26	        name: 'nrepl-mcp',
27	        version: '0.1.0',
28	      },
29	      {
30	        capabilities: {
31	          tools: {},
32	          resources: {
33	            'nrepl://status': {
34	              name: 'nREPL Connection Status',
35	              description: 'Returns the current nREPL connection status including port and session information',
36	            },
37	            'nrepl://namespaces': {
38	              name: 'Project Namespaces',
39	              description: 'Returns a list of all namespaces in the current project',
40	            },
41	          },
42	        },
43	      }
44	    );
45	
46	    this.setupRequestHandlers();
47	    
48	    // Error handling
49	    this.server.onerror = (error: Error) => console.error('[MCP Error]:', error);
50	    process.on('SIGINT', async () => {
51	      await this.cleanup();
52	      process.exit(0);
53	    });
54	  }
55	
56	  private setupRequestHandlers() {
57	    // Add handler for listing resources
58	    this.server.setRequestHandler(ListResourcesRequestSchema, async () => ({
59	      resources: [
60	        {
61	          uri: 'nrepl://status',
62	          name: 'nREPL Connection Status',
63	          description: 'Returns the current nREPL connection status including port and session information',
64	          mimeType: 'application/json'
65	        },
66	        {
67	          uri: 'nrepl://namespaces',
68	          name: 'Project Namespaces',
69	          description: 'Returns a list of all namespaces in the current project',
70	          mimeType: 'application/json'
71	        }
72	      ]
73	    }));
74	
75	    // Add handler for reading resources
76	    this.server.setRequestHandler(ReadResourceRequestSchema, async (request) => {
77	      if (request.params.uri === 'nrepl://namespaces') {
78	        await this.ensureNReplClient();
79	        
80	        // Add tools.namespace dependency and set up namespace finding
81	        const setupCode = `
82	          (require '[clojure.repl.deps :refer [add-lib]])
83	          (add-lib 'org.clojure/tools.namespace {:mvn/version "1.4.4"})
84	          (require '[clojure.tools.namespace.find :as ns-find])
85	        `;
86	        await this.nreplClient!.eval(setupCode);
87	        
88	        // Find all namespaces in the current directory
89	        const findNamespacesCode = `
90	          (pr-str 
91	            (into []
92	              (map str)
93	              (ns-find/find-namespaces-in-dir 
94	                (clojure.java.io/file "./"))))
95	        `;
96	        const namespaces = await this.nreplClient!.eval(findNamespacesCode);
97	        
98	        // Parse the Clojure vector string into a JavaScript array
99	        const namespacesArray = JSON.parse(
100	          namespaces
101	            .replace(/^"(.+)"$/, '$1') // Remove outer quotes from pr-str
102	            .replace(/\\/g, '') // Remove escaping
103	            .replace(/\s+/g, ',') // Replace whitespace with commas
104	            .replace(/,+/g, ',') // Remove multiple commas
105	            .replace(/,\]/g, ']') // Remove trailing comma
106	        );
107	        
108	        return {
109	          contents: [{
110	            uri: request.params.uri,
111	            mimeType: 'application/json',
112	            text: JSON.stringify({ namespaces: namespacesArray }, null, 2)
113	          }]
114	        };
115	      } else if (request.params.uri === 'nrepl://status') {
116	        const status = {
117	          host: this.host,
118	          port: this.port,
119	          connected: this.nreplClient !== null,
120	          sessionId: this.nreplClient?.sessionId || null,
121	          lastError: this.nreplClient?.lastError || null
122	        };
123	        return {
124	          contents: [{
125	            uri: request.params.uri,
126	            mimeType: 'application/json',
127	            text: JSON.stringify(status, null, 2)
128	          }]
129	        };
130	      }
131	      throw new McpError(
132	        ErrorCode.InvalidRequest,
133	        `Unknown resource: ${request.params.uri}`
134	      );
135	    });
136	
137	    this.server.setRequestHandler(ListToolsRequestSchema, async () => ({
138	      tools: [
139	        {
140	          name: 'connect',
141	          description: 'Connect to an nREPL server.\n' +
142	            'Example: (connect {:host "localhost" :port 1234})',
143	          inputSchema: {
144	            type: 'object',
145	            properties: {
146	              host: { type: 'string', description: 'nREPL server host' },
147	              port: { type: 'number', description: 'nREPL server port' }
148	            },
149	            required: ['host', 'port']
150	          }
151	        },
152	        {
153	          name: 'eval_form',
154	          description: 'Evaluate Clojure code in a specific namespace or the current one. Examples:\n' +
155	            '- Define and call a function: {"code": "(defn greet [name] (str \\"Hello, \\" name \\"!\\"))(greet \\"World\\"))"}\n' +
156	            '- Reload code: {"code": "(clj-reload.core/reload)"}\n' +
157	            '- Evaluate in a specific namespace: {"code": "(clojure.repl.deps/sync-deps)", "ns": "user"}',
158	          inputSchema: {
159	            type: 'object',
160	            properties: {
161	              code: { type: 'string', description: 'Clojure code to evaluate' },
162	              ns: { type: 'string', description: 'Optional namespace to evaluate in. Changes persist for subsequent evaluations.' },
163	            },
164	            required: ['code'],
165	          },
166	        },
167	        {
168	          name: 'get_ns_vars',
169	          description: 'Get all public vars (functions, values) in a namespace with their metadata and current values. Example:\n' +
170	            '- List main namespace vars: (get_ns_vars {:ns "main"})\n' +
171	            'Returns a map where keys are var names and values contain:\n' +
172	            '- :meta - Metadata including :doc string, :line number, :file path\n' +
173	            '- :value - Current value of the var',
174	          inputSchema: {
175	            type: 'object',
176	            properties: {
177	              ns: { type: 'string', description: 'Namespace to inspect' },
178	            },
179	            required: ['ns'],
180	          },
181	        },
182	      ],
183	    }));
184	
185	    this.server.setRequestHandler(CallToolRequestSchema, async (request: CallToolRequest) => {
186	      try {
187	        switch (request.params.name) {
188	          case 'connect': {
189	            const args = request.params.arguments;
190	            if (!args || typeof args.host !== 'string' || typeof args.port !== 'number') {
191	              throw new McpError(
192	                ErrorCode.InvalidParams,
193	                'host and port parameters are required'
194	              );
195	            }
196	
197	            // Close existing connection if any
198	            if (this.nreplClient) {
199	              await this.nreplClient.close();
200	              this.nreplClient = null;
201	            }
202	
203	            this.host = args.host;
204	            this.port = args.port;
205	            this.nreplClient = new NReplClient(this.port);
206	            await this.nreplClient.clone(); // Create initial session
207	
208	            return {
209	              content: [{ type: 'text', text: `Connected to nREPL server at ${this.host}:${this.port}` }],
210	            };
211	          }
212	
213	          case 'eval_form': {
214	            await this.ensureNReplClient();
215	            const args = request.params.arguments;
216	            if (!args || typeof args.code !== 'string') {
217	              throw new McpError(
218	                ErrorCode.InvalidParams,
219	                'code parameter must be a string'
220	              );
221	            }
222	
223	            let result: string;
224	            if (args.ns) {
225	              // If namespace is provided, change to it first
226	              await this.nreplClient!.eval(`(in-ns '${args.ns})`);
227	              result = await this.nreplClient!.eval(args.code);
228	            } else {
229	              result = await this.nreplClient!.eval(args.code);
230	            }
231	
232	            return {
233	              content: [{ type: 'text', text: result }],
234	            };
235	          }
236	
237	          case 'get_ns_vars': {
238	            await this.ensureNReplClient();
239	            const args = request.params.arguments;
240	            if (!args || typeof args.ns !== 'string') {
241	              throw new McpError(
242	                ErrorCode.InvalidParams,
243	                'ns parameter must be a string'
244	              );
245	            }
246	            const result = await this.nreplClient!.eval(
247	              `(into {} (for [[sym v] (ns-publics '${args.ns})] [sym {:meta (meta v) :value (deref v)}]))`
248	            );
249	            return {
250	              content: [{ type: 'text', text: result }],
251	            };
252	          }
253	
254	          default:
255	            throw new McpError(
256	              ErrorCode.MethodNotFound,
257	              `Unknown tool: ${request.params.name}`
258	            );
259	        }
260	      } catch (error) {
261	        if (error instanceof McpError) {
262	          throw error;
263	        }
264	        throw new McpError(
265	          ErrorCode.InternalError,
266	          `nREPL error: ${error instanceof Error ? error.message : String(error)}`
267	        );
268	      }
269	    });
270	  }
271	
272	  private async ensureNReplClient() {
273	    if (!this.host || !this.port) {
274	      throw new McpError(
275	        ErrorCode.InternalError,
276	        'Not connected to nREPL server - use connect tool first'
277	      );
278	    }
279	
280	    if (!this.nreplClient) {
281	      this.nreplClient = new NReplClient(this.port);
282	      await this.nreplClient.clone(); // Create initial session
283	    }
284	  }
285	
286	  private async cleanup() {
287	    if (this.nreplClient) {
288	      await this.nreplClient.close();
289	    }
290	    await this.server.close();
291	  }
292	
293	  async run() {
294	    const transport = new StdioServerTransport();
295	    await this.server.connect(transport);
296	    console.error('nREPL MCP server running on stdio');
297	  }
298	}
299	
300	// Start the server
301	const server = new NReplMcpServer();
302	server.run().catch((error: Error) => {
303	  console.error('Fatal error:', error);
304	  process.exit(1);
305	});
306	

