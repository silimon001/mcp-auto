1	/**
2	 * HeyBeauty API Client
3	 * request apis from heybeauty.ai
4	 */
5	export class HeyBeautyClient {
6	  private readonly apiBaseUrl: string = "https://heybeauty.ai/api";
7	  private readonly apiKey: string;
8	
9	  /**
10	   * constructor
11	   * @param apiKey - api key applied from heybeauty.ai
12	   * @param apiBaseUrl - api base url
13	   */
14	  constructor({ apiKey, apiBaseUrl }: { apiKey: string; apiBaseUrl?: string }) {
15	    this.apiKey = apiKey;
16	    this.apiBaseUrl = apiBaseUrl || this.apiBaseUrl;
17	  }
18	
19	  /**
20	   * get clothes for try on
21	   * @returns clothes
22	   */
23	  async getClothes() {
24	    try {
25	      const req = {
26	        page: 1,
27	        limit: 10,
28	      };
29	      const resp = await fetch(`${this.apiBaseUrl}/get-clothes`, {
30	        method: "POST",
31	        headers: {
32	          Authorization: `Bearer ${this.apiKey}`,
33	        },
34	        body: JSON.stringify(req),
35	      });
36	
37	      if (!resp.ok) {
38	        throw new Error("request failed with status " + resp.status);
39	      }
40	
41	      const { code, message, data } = await resp.json();
42	      if (code !== 0) {
43	        throw new Error(message);
44	      }
45	
46	      return data;
47	    } catch (error) {
48	      throw error;
49	    }
50	  }
51	
52	  async submitTask({
53	    user_img_url,
54	    cloth_img_url,
55	    cloth_id,
56	    cloth_description,
57	  }: {
58	    user_img_url: string;
59	    cloth_img_url: string;
60	    cloth_id?: string;
61	    cloth_description?: string;
62	  }) {
63	    try {
64	      if (!user_img_url || !cloth_img_url) {
65	        throw new Error("user_img_url and cloth_img_url are required");
66	      }
67	
68	      const req: any = {
69	        user_img_url,
70	        cloth_img_url,
71	        category: "1",
72	        is_sync: "0",
73	      };
74	      if (cloth_id) {
75	        req.cloth_id = cloth_id;
76	      }
77	      if (cloth_description) {
78	        req.caption = cloth_description;
79	      }
80	
81	      console.log(req);
82	
83	      const resp = await fetch(`${this.apiBaseUrl}/mcp-vton`, {
84	        method: "POST",
85	        headers: {
86	          Authorization: `Bearer ${this.apiKey}`,
87	        },
88	        body: JSON.stringify(req),
89	      });
90	
91	      if (!resp.ok) {
92	        throw new Error("request failed with status " + resp.status);
93	      }
94	
95	      const { code, message, data } = await resp.json();
96	      if (code !== 0) {
97	        throw new Error(message);
98	      }
99	
100	      return {
101	        task_id: data.uuid,
102	        created_at: data.created_at,
103	        updated_at: data.updated_at,
104	        status: data.status,
105	        tryon_img_url: data.tryon_img_url || "",
106	      };
107	    } catch (error) {
108	      throw error;
109	    }
110	  }
111	
112	  async queryTask({ task_id }: { task_id: string }) {
113	    try {
114	      const uri = `${this.apiBaseUrl}/get-task-info`;
115	      const req = {
116	        task_uuid: task_id,
117	      };
118	
119	      const resp = await fetch(uri, {
120	        method: "POST",
121	        headers: {
122	          "Content-Type": "application/json",
123	          Authorization: `Bearer ${this.apiKey}`,
124	        },
125	        body: JSON.stringify(req),
126	      });
127	
128	      if (!resp.ok) {
129	        throw new Error("request failed with status: " + resp.status);
130	      }
131	
132	      const { code, message, data } = await resp.json();
133	
134	      if (code !== 0) {
135	        throw new Error(message);
136	      }
137	
138	      return {
139	        task_id: task_id,
140	        created_at: data.created_at,
141	        updated_at: data.updated_at,
142	        status: data.status,
143	        tryon_img_url: data.tryon_img_url || "",
144	      };
145	    } catch (err) {
