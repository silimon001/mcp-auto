113	    try {
114	      const image = await api(apiPort, "/get_diagram_image_by_id", {
115	        diagramId,
116	      });
117	      return response.image("image/png", image);
118	    } catch (error) {
119	      console.error(error);
120	      return response.error(
121	        JsonRpcErrorCode.InternalError,
122	        `Failed to get diagram image by id: ${error instanceof Error ? error.message : String(error)}`
123	      );
124	    }
125	  }
126	);
127	
128	async function main() {
