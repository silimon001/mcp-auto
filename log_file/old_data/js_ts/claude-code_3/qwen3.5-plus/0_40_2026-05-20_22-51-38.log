1	#!/usr/bin/env node
2	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
3	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
4	import { CallToolRequestSchema, ListToolsRequestSchema, } from "@modelcontextprotocol/sdk/types.js";
5	import axios from 'axios';
6	import dotenv from 'dotenv';
7	import crypto from 'crypto';
8	// Redirect all console output to stderr
9	const originalConsole = { ...console };
10	console.log = (...args) => originalConsole.error(...args);
11	console.info = (...args) => originalConsole.error(...args);
12	console.warn = (...args) => originalConsole.error(...args);
13	dotenv.config();
14	const GONG_API_URL = 'https://api.gong.io/v2';
15	const GONG_ACCESS_KEY = process.env.GONG_ACCESS_KEY;
16	const GONG_ACCESS_SECRET = process.env.GONG_ACCESS_SECRET;
17	// Check for required environment variables
18	if (!GONG_ACCESS_KEY || !GONG_ACCESS_SECRET) {
19	    console.error("Error: GONG_ACCESS_KEY and GONG_ACCESS_SECRET environment variables are required");
20	    process.exit(1);
21	}
22	// Gong API Client
23	class GongClient {
24	    constructor(accessKey, accessSecret) {
25	        this.accessKey = accessKey;
26	        this.accessSecret = accessSecret;
27	    }
28	    async generateSignature(method, path, timestamp, params) {
29	        const stringToSign = `${method}\n${path}\n${timestamp}\n${params ? JSON.stringify(params) : ''}`;
30	        const encoder = new TextEncoder();
31	        const keyData = encoder.encode(this.accessSecret);
32	        const messageData = encoder.encode(stringToSign);
33	        const cryptoKey = await crypto.subtle.importKey('raw', keyData, { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
34	        const signature = await crypto.subtle.sign('HMAC', cryptoKey, messageData);
35	        return btoa(String.fromCharCode(...new Uint8Array(signature)));
36	    }
37	    async request(method, path, params, data) {
38	        const timestamp = new Date().toISOString();
39	        const url = `${GONG_API_URL}${path}`;
40	        const response = await axios({
41	            method,
42	            url,
43	            params,
44	            data,
45	            headers: {
46	                'Content-Type': 'application/json',
47	                'Authorization': `Basic ${Buffer.from(`${this.accessKey}:${this.accessSecret}`).toString('base64')}`,
48	                'X-Gong-AccessKey': this.accessKey,
49	                'X-Gong-Timestamp': timestamp,
50	                'X-Gong-Signature': await this.generateSignature(method, path, timestamp, data || params)
51	            }
52	        });
53	        return response.data;
54	    }
55	    async listCalls(fromDateTime, toDateTime) {
56	        const params = {};
57	        if (fromDateTime)
58	            params.fromDateTime = fromDateTime;
59	        if (toDateTime)
60	            params.toDateTime = toDateTime;
61	        return this.request('GET', '/calls', params);
62	    }
63	    async retrieveTranscripts(callIds) {
64	        return this.request('POST', '/calls/transcript', undefined, {
65	            filter: {
66	                callIds,
67	                includeEntities: true,
68	                includeInteractionsSummary: true,
69	                includeTrackers: true
70	            }
71	        });
72	    }
73	}
74	const gongClient = new GongClient(GONG_ACCESS_KEY, GONG_ACCESS_SECRET);
75	// Tool definitions
76	const LIST_CALLS_TOOL = {
77	    name: "list_calls",
78	    description: "List Gong calls with optional date range filtering. Returns call details including ID, title, start/end times, participants, and duration.",
79	    inputSchema: {
80	        type: "object",
81	        properties: {
82	            fromDateTime: {
83	                type: "string",
84	                description: "Start date/time in ISO format (e.g. 2024-03-01T00:00:00Z)"
85	            },
86	            toDateTime: {
87	                type: "string",
88	                description: "End date/time in ISO format (e.g. 2024-03-31T23:59:59Z)"
89	            }
90	        }
91	    }
92	};
93	const RETRIEVE_TRANSCRIPTS_TOOL = {
94	    name: "retrieve_transcripts",
95	    description: "Retrieve transcripts for specified call IDs. Returns detailed transcripts including speaker IDs, topics, and timestamped sentences.",
96	    inputSchema: {
97	        type: "object",
98	        properties: {
99	            callIds: {
100	                type: "array",
101	                items: { type: "string" },
102	                description: "Array of Gong call IDs to retrieve transcripts for"
103	            }
104	        },
105	        required: ["callIds"]
106	    }
107	};
108	// Server implementation
109	const server = new Server({
110	    name: "example-servers/gong",
111	    version: "0.1.0",
112	}, {
113	    capabilities: {
114	        tools: {},
115	    },
116	});
117	// Type guards
118	function isGongListCallsArgs(args) {
119	    return (typeof args === "object" &&
120	        args !== null &&
121	        (!("fromDateTime" in args) || typeof args.fromDateTime === "string") &&
122	        (!("toDateTime" in args) || typeof args.toDateTime === "string"));
123	}
124	function isGongRetrieveTranscriptsArgs(args) {
125	    return (typeof args === "object" &&
126	        args !== null &&
127	        "callIds" in args &&
128	        Array.isArray(args.callIds) &&
129	        args.callIds.every(id => typeof id === "string"));
130	}
131	// Tool handlers
132	server.setRequestHandler(ListToolsRequestSchema, async () => ({
133	    tools: [LIST_CALLS_TOOL, RETRIEVE_TRANSCRIPTS_TOOL],
134	}));
135	server.setRequestHandler(CallToolRequestSchema, async (request) => {
136	    try {
137	        const { name, arguments: args } = request.params;
138	        if (!args) {
139	            throw new Error("No arguments provided");
140	        }
141	        switch (name) {
142	            case "list_calls": {
143	                if (!isGongListCallsArgs(args)) {
144	                    throw new Error("Invalid arguments for list_calls");
145	                }
146	                const { fromDateTime, toDateTime } = args;
147	                const response = await gongClient.listCalls(fromDateTime, toDateTime);
148	                return {
149	                    content: [{
150	                            type: "text",
151	                            text: JSON.stringify(response, null, 2)
152	                        }],
153	                    isError: false,
154	                };
155	            }
156	            case "retrieve_transcripts": {
157	                if (!isGongRetrieveTranscriptsArgs(args)) {
158	                    throw new Error("Invalid arguments for retrieve_transcripts");
159	                }
160	                const { callIds } = args;
161	                const response = await gongClient.retrieveTranscripts(callIds);
162	                return {
163	                    content: [{
164	                            type: "text",
165	                            text: JSON.stringify(response, null, 2)
166	                        }],
167	                    isError: false,
168	                };
169	            }
170	            default:
171	                return {
172	                    content: [{ type: "text", text: `Unknown tool: ${name}` }],
173	                    isError: true,
174	                };
175	        }
176	    }
177	    catch (error) {
178	        return {
179	            content: [
180	                {
181	                    type: "text",
182	                    text: `Error: ${error instanceof Error ? error.message : String(error)}`,
183	                },
184	            ],
185	            isError: true,
186	        };
187	    }
188	});
189	async function runServer() {
190	    const transport = new StdioServerTransport();
191	    await server.connect(transport);
192	}
193	runServer().catch((error) => {
194	    console.error("Fatal error running server:", error);
195	    process.exit(1);
196	});
