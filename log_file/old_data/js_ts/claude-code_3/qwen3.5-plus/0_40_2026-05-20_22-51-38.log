12	
13	// port number for the StarUML's API server (default: 58321)
14	let apiPort: number = 58321;
15	
16	// command line argument parsing
17	const args = process.argv.slice(2);
18	const apiPortArg = args.find((arg) => arg.startsWith("--api-port="));
19	if (apiPortArg) {
20	  const port = apiPortArg.split("=")[1];
21	  try {
22	    apiPort = parseInt(port, 10);
23	    if (isNaN(apiPort) || apiPort < 0 || apiPort > 65535) {
24	      throw new Error(`Invalid port number: ${port}`);
25	    }
26	  } catch (error) {
27	    console.error(`Invalid port number: ${port}`);
28	    process.exit(1);
29	  }
30	}
31	
32	// Create an MCP server
33	const server = new McpServer({
34	  name: NAME,
35	  version: VERSION,
36	});
37	
38	server.tool(
39	  "generate_diagram",
40	  "Generate a diagram in StarUML.",
41	  {
42	    code: z
43	      .string()
44	      .describe(
45	        "Mermaid code to generate the diagram. Supported diagrams are classDiagram, sequenceDiagram, flowchart, erDiagram, mindmap, requirementDiagram and stateDiagram. Other diagrams are not supported."
46	      ),
47	  },
48	  async ({ code }) => {
49	    try {
50	      await api(apiPort, "/generate_diagram", { code });
51	      return response.text("Diagram is successfully generated.");
52	    } catch (error) {
53	      console.error(error);
54	      return response.error(
55	        JsonRpcErrorCode.InternalError,
56	        `Failed to generate diagram: ${error instanceof Error ? error.message : String(error)}`
57	      );
58	    }
59	  }
60	);
61	
62	server.tool(
63	  "get_all_diagrams_info",
64	  "Get information for all diagrams in StarUML.",
65	  {},
66	  async ({}) => {
67	    try {
68	      const data = await api(apiPort, "/get_all_diagrams_info", {});
69	      return response.text(`All diagrams: ${JSON.stringify(data)}`);
70	    } catch (error) {
71	      console.error(error);
72	      return response.error(
73	        JsonRpcErrorCode.InternalError,
74	        `Failed to get all diagrams info: ${error instanceof Error ? error.message : String(error)}`
75	      );
76	    }
77	  }
78	);
79	
80	server.tool(
81	  "get_current_diagram_info",
82	  "Get information for the current diagram in StarUML.",
83	  {},
84	  async ({}) => {
85	    try {
86	      const data = await api(apiPort, "/get_current_diagram_info", {});
87	      if (data) {
88	        return response.text(`Current diagram: ${JSON.stringify(data)}`);
89	      } else {
90	        return response.text("No current diagram found.");
91	      }
92	    } catch (error) {
93	      console.error(error);
94	      return response.error(
95	        JsonRpcErrorCode.InternalError,
96	        `Failed to get current diagram info: ${error instanceof Error ? error.message : String(error)}`
97	      );
98	    }
99	  }
100	);
101	
102	server.tool(
103	  "get_diagram_image_by_id",
104	  "Get the image of a diagram by its ID in StarUML.",
105	  {
106	    diagramId: z
107	      .string()
