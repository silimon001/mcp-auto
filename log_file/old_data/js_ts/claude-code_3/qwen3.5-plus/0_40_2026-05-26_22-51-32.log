1	#!/usr/bin/env node
2	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
3	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
4	import {
5	  ListToolsRequestSchema,
6	  CallToolRequestSchema,
7	  ErrorCode,
8	  McpError
9	} from "@modelcontextprotocol/sdk/types.js";
10	
11	import dotenv from "dotenv";
12	import { isValidImageGenerationArgs } from "./types.js";
13	import { ImageGenerator } from "./image-generator.js";
14	import { FileSaver } from "./file-saver.js";
15	
16	dotenv.config();
17	
18	const imageSaver = FileSaver.CreateDesktopFileSaver('generated-images');
19	
20	class ImageGeneratorServer {
21	  private server: Server;
22	
23	  constructor() {
24	    this.server = new Server({
25	      name: "image-generator",
26	      version: "0.1.0"
27	    }, {
28	      capabilities: {
29	        resources: {},
30	        tools: {}
31	      }
32	    });
33	
34	    this.setupToolHandlers();
35	    this.setupErrorHandling();
36	  }
37	
38	  private setupErrorHandling(): void {
39	    this.server.onerror = (error) => {
40	      console.error("[MCP Error]", error);
41	    };
42	
43	    process.on('SIGINT', async () => {
44	      await this.server.close();
45	      process.exit(0);
46	    });
47	  }
48	
49	  private setupToolHandlers(): void {
50	    this.server.setRequestHandler(
51	      ListToolsRequestSchema,
52	      async () => ({
53	        tools: [{
54	          name: "generate_image",
55	          description: "Generate an image from a prompt.",
56	          inputSchema: {
57	            type: "object",
58	            properties: {
59	              prompt: {
60	                type: "string",
61	                description: "A prompt detailing what image to generate."
62	              },
63	              imageName: {
64	                type: "string",
65	                description: "The filename for the image excluding any extensions."
66	              }
67	            },
68	            required: ["prompt", "imageName"]
69	          }
70	        }]
71	      })
72	    );
73	
74	    this.server.setRequestHandler(
75	      CallToolRequestSchema,
76	      async (request) => {
77	        if (request.params.name !== "generate_image") {
78	          throw new McpError(
79	            ErrorCode.MethodNotFound,
80	            `Unknown tool: ${request.params.name}`
81	          );
82	        }
83	
84	        if (!isValidImageGenerationArgs(request.params.arguments)) {
85	          throw new McpError(
86	            ErrorCode.InvalidParams,
87	            "Invalid image generation arguments"
88	          )
89	        };
90	        
91	        const { prompt, imageName } = request.params.arguments;
92	        const base64 = await new ImageGenerator().generateImage(prompt);
93	        const fileName = `${imageName.replace(/\..*$/, '')}.png`;
94	        const filepath = await imageSaver.saveBase64(fileName, base64!);
95	
96	        return {
97	          toolResult: {
98	            uri: `file://${filepath}`,
99	            type: 'image',
100	            mimeType: 'image/png'
101	          }
102	        }
103	      }
104	    )
105	  }
106	
107	  async run(): Promise<void> {
108	    const transport = new StdioServerTransport();
109	    await this.server.connect(transport);
110	    
111	    // Although this is just an informative message, we must log to stderr,
112	    // to avoid interfering with MCP communication that happens on stdout
113	    console.error("Weather MCP server running on stdio");
114	  }
115	}
116	
117	const server = new ImageGeneratorServer();
118	server.run().catch(console.error);
