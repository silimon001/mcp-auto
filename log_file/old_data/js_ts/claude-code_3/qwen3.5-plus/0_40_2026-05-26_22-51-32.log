28	    async generateSignature(method, path, timestamp, params) {
29	        const stringToSign = `${method}\n${path}\n${timestamp}\n${params ? JSON.stringify(params) : ''}`;
30	        const encoder = new TextEncoder();
31	        const keyData = encoder.encode(this.accessSecret);
32	        const messageData = encoder.encode(stringToSign);
33	        const cryptoKey = await crypto.subtle.importKey('raw', keyData, { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
34	        const signature = await crypto.subtle.sign('HMAC', cryptoKey, messageData);
35	        return btoa(String.fromCharCode(...new Uint8Array(signature)));
36	    }
37	    async request(method, path, params, data) {
38	        const timestamp = new Date().toISOString();
39	        const url = `${GONG_API_URL}${path}`;
40	        const response = await axios({
41	            method,
42	            url,
43	            params,
44	            data,
45	            headers: {
46	                'Content-Type': 'application/json',
47	                'Authorization': `Basic ${Buffer.from(`${this.accessKey}:${this.accessSecret}`).toString('base64')}`,
48	                'X-Gong-AccessKey': this.accessKey,
49	                'X-Gong-Timestamp': timestamp,
50	                'X-Gong-Signature': await this.generateSignature(method, path, timestamp, data || params)
51	            }
52	        });
53	        return response.data;
54	    }
55	    async listCalls(fromDateTime, toDateTime) {
56	        const params = {};
