113	  RECALL_LOG_PREFIX: process.env.RECALL_LOG_PREFIX || 'sequential-',
114	  RECALL_NETWORK: process.env.RECALL_NETWORK || 'testnet',
115	};
116	
117	// Secure private key access
118	export function getPrivateKey(): string {
119	  if (!secretBuffer) {
120	    throw new Error('RECALL_PRIVATE_KEY is required but not available.');
121	  }
122	
123	  const key: string = secretBuffer.toString('utf8');
124	  sodium.sodium_memzero(secretBuffer); // Zero out immediately after use
125	  sodium.sodium_munlock(secretBuffer); // Unlock and zero memory
126	  secretBuffer = null;
127	  secretLoaded = false; // Force reload if needed again
128	  return key;
129	}
