8		/**
9		 * Schwab OAuth client ID for API access
10		 */
11		SCHWAB_CLIENT_ID: string
12	
13		/**
14		 * Schwab OAuth client secret for API access
15		 */
16		SCHWAB_CLIENT_SECRET: string
17	
18		/**
19		 * Secret key used for cookie encryption
20		 */
21		COOKIE_ENCRYPTION_KEY: string
22	
23		/**
24		 * OAuth redirect URI for callback after authentication
25		 * This should be a fixed, configured value to ensure consistency
26		 * across different environments and proxies
27		 */
28		SCHWAB_REDIRECT_URI: string
29	
30		/**
31		 * KV namespace for storing tokens (required)
32		 */
33		OAUTH_KV: KVNamespace
34	
35		/**
36		 * Optional log level for application logging
37		 */
38		LOG_LEVEL?: string
39	
40		/**
41		 * Environment type (development, staging, production)
42		 * Defaults to production if not specified
43		 */
44		ENVIRONMENT?: string
45	
46		/**
47		 * Optional comma-separated list of additional redirect URI regex patterns
48		 */
49		ALLOWED_REDIRECT_REGEXPS?: string
50	}
51	
