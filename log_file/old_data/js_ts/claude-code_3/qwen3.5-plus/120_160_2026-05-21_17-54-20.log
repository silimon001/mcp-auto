1	#!/usr/bin/env node
2	
3	/**
4	 * ClaudePoint Entry Point
5	 * Detects if running via Claude Code MCP or as CLI
6	 * Windows-compatible MCP server startup
7	 */
8	
9	// Check if this is running as an MCP server
10	// MCP servers communicate via stdin/stdout, so we check for TTY
11	// CLI mode: both stdin and stdout are TTY
12	// MCP mode: neither stdin nor stdout are TTY (pipes)
13	// Also check for CLI arguments to force CLI mode
14	const hasCliArgs = process.argv.length > 2;
15	
16	// Enhanced MCP detection for Windows compatibility
17	// Windows PowerShell and Command Prompt handle pipes differently than Unix shells
18	// Also account for Git Bash on Windows which may have different TTY behavior
19	const stdinPiped = !process.stdin.isTTY;
20	const stdoutPiped = !process.stdout.isTTY;
21	const isWindows = process.platform === 'win32';
22	
23	// MCP detection logic with Windows compatibility:
24	// 1. If we have CLI arguments, it's definitely CLI mode
25	// 2. For MCP mode: stdin is piped (most reliable indicator)
26	// 3. Special handling for Windows PowerShell and Git Bash
27	let isMCPServer = false;
28	if (!hasCliArgs) {
29	  // Primary MCP indicator: stdin is piped (data is coming from somewhere)
30	  // This is the most reliable cross-platform method
31	  isMCPServer = stdinPiped;
32	  
33	  // Windows-specific adjustments
34	  if (isWindows) {
35	    // On Windows, some shells (like PowerShell) may report TTY differently
36	    // Also check if we're in a non-interactive environment
37	    const nonInteractive = !process.stdout.isTTY && !process.stderr.isTTY;
38	    if (nonInteractive && !hasCliArgs) {
39	      isMCPServer = true;
40	    }
41	  }
42	  
43	  // However, if both stdin and stdout are not TTY but we have no input,
44	  // we might be in a test environment - wait briefly for input
45	  if (isMCPServer && process.stdin.readable === false) {
46	    // stdin is piped but no data available - might be interactive
47	    // Let the MCP server start anyway, it will handle no input gracefully
48	    isMCPServer = true;
49	  }
50	}
51	
52	// Enhanced debug info for troubleshooting (especially useful for Windows issues)
53	if (process.env.DEBUG) {
54	  console.error('ClaudePoint Debug Info:');
55	  console.error('process.stdin.isTTY:', process.stdin.isTTY);
56	  console.error('process.stdout.isTTY:', process.stdout.isTTY);
57	  console.error('process.stderr.isTTY:', process.stderr.isTTY);
58	  console.error('process.stdin.readable:', process.stdin.readable);
59	  console.error('stdinPiped:', stdinPiped);
60	  console.error('stdoutPiped:', stdoutPiped);
61	  console.error('hasCliArgs:', hasCliArgs);
62	  console.error('isMCPServer:', isMCPServer);
63	  console.error('process.argv:', process.argv);
64	  console.error('process.platform:', process.platform);
65	  console.error('isWindows:', isWindows);
66	  console.error('NODE_ENV:', process.env.NODE_ENV);
67	  console.error('process.execPath:', process.execPath);
68	  console.error('__dirname equivalent:', import.meta.url);
69	}
70	
71	async function main() {
72	  try {
73	    if (isMCPServer) {
74	      // Running as MCP server via Claude Code
75	      console.error('[claudepoint] Starting MCP server mode');
76	      await import('../src/mcp-server.js');
77	    } else {
78	      // Running as CLI
79	      console.error('[claudepoint] Starting CLI mode');
80	      await import('../src/cli.js');
81	    }
82	  } catch (error) {
83	    // Enhanced error reporting for Windows troubleshooting
84	    console.error('Failed to start ClaudePoint:', error.message);
85	    
86	    if (isWindows && error.message.includes('bash')) {
87	      console.error('');
88	      console.error('Windows-specific troubleshooting:');
89	      console.error('1. Make sure Node.js is properly installed and in your PATH');
90	      console.error('2. Try running from Command Prompt instead of Git Bash');
91	      console.error('3. Check that the MCP server configuration uses the correct Node.js path');
92	      console.error('4. Run with DEBUG=1 for more detailed information');
93	    }
94	    
95	    if (process.env.DEBUG) {
96	      console.error('Full error stack:', error.stack);
97	    }
98	    
99	    process.exit(1);
100	  }
101	}
102	
103	main().catch(error => {
104	  console.error('Unhandled error in main():', error);
105	  if (process.env.DEBUG) {
106	    console.error('Error stack:', error.stack);
107	  }
108	  process.exit(1);
109	});

