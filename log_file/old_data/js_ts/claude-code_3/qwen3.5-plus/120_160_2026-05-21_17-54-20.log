10	    constructor() {
11	        console.log('CommandExecutor constructor called');
12	        this.updateAllowedCommands();
13	        this.updateAsyncConfig();
14	        console.log('Creating BackgroundTaskExecutor...');
15	        this.backgroundExecutor = new BackgroundTaskExecutor();
