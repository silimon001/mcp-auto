5	//#region src/server.ts
6	let apiToken = process.env.SHORTCUT_API_TKN || process.env.SHORTCUT_API_TOKEN;
7	let isReadonly = process.env.SHORTCUT_READONLY === "true";
8	let enabledTools = (process.env.SHORTCUT_TOOLS || "").split(",").map((tool) => tool.trim()).filter(Boolean);
9	if (process.argv.length >= 3) process.argv.slice(2).map((arg) => arg.split("=")).forEach(([name, value]) => {
10		if (name === "SHORTCUT_API_TKN") apiToken = value;
11		if (name === "SHORTCUT_API_TOKEN") apiToken = value;
12		if (name === "SHORTCUT_READONLY") isReadonly = value === "true";
13		if (name === "SHORTCUT_TOOLS") enabledTools = value.split(",").map((tool) => tool.trim()).filter(Boolean);
14	});
15	if (!apiToken) {
16		console.error("A Shortcut api token is required.");
17		process.exit(1);
18	}
19	const server = new CustomMcpServer({
20		readonly: isReadonly,
21		tools: enabledTools
22	});
23	const client = new ShortcutClientWrapper(new ShortcutClient(apiToken));
24	UserTools.create(client, server);
25	StoryTools.create(client, server);
26	IterationTools.create(client, server);
27	EpicTools.create(client, server);
28	ObjectiveTools.create(client, server);
29	TeamTools.create(client, server);
30	WorkflowTools.create(client, server);
31	DocumentTools.create(client, server);
32	LabelTools.create(client, server);
33	ProjectTools.create(client, server);
34	CustomFieldTools.create(client, server);
35	async function startServer() {
36		try {
37			const transport = new StdioServerTransport();
38			await server.connect(transport);
39		} catch (error) {
40			console.error("Fatal:", error);
41			process.exit(1);
42		}
43	}
44	startServer();
45	
