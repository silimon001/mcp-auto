173	 */
174	export class TestFormManager {
175	  constructor(apiClient, config = testConfig) {
176	    this.client = apiClient;
177	    this.config = config;
178	    this.trackedForms = new Set();
179	  }
180	  
181	  /**
182	   * Create a test form with automatic tracking
183	   */
184	  async createTestForm(name, fields = []) {
185	    const testName = this.config.createTestFormName(name);
186	    
187	    const form = await this.client.createForm({
188	      title: testName,
189	      fields,
190	      is_active: true,
191	      description: `Automated test form created at ${new Date().toISOString()}`
192	    });
193	    
194	    this.trackForm(form.form.id);
195	    return form.form;
196	  }
197	  
198	  /**
199	   * Delete a test form
200	   */
201	  async deleteTestForm(formId) {
202	    try {
203	      await this.client.deleteForm({ 
204	        id: formId, 
205	        force: true 
206	      });
207	      this.untrackForm(formId);
208	      return true;
209	    } catch (error) {
210	      console.error(`Failed to delete test form ${formId}:`, error.message);
211	      return false;
212	    }
213	  }
214	  
215	  /**
216	   * Clean up all tracked test forms
217	   */
218	  async cleanupTrackedForms() {
219	    const cleanupPromises = Array.from(this.trackedForms).map(formId => 
220	      this.deleteTestForm(formId)
221	    );
222	    
223	    const results = await Promise.allSettled(cleanupPromises);
224	    const succeeded = results.filter(r => r.status === 'fulfilled' && r.value).length;
225	    const failed = results.filter(r => r.status === 'rejected' || !r.value).length;
226	    
227	    return {
228	      succeeded,
229	      failed,
230	      total: this.trackedForms.size
231	    };
232	  }
233	  
234	  /**
235	   * Clean up all test forms (not just tracked)
236	   */
237	  async cleanupAllTestForms() {
238	    const cleanupConfig = this.config.getCleanupConfig();
239	    
240	    if (!cleanupConfig.enabled) {
241	      logger.info('Test form cleanup is disabled');
242	      return { succeeded: 0, failed: 0, total: 0 };
243	    }
244	    
245	    // Get all forms
246	    const forms = await this.client.listForms();
247	    
248	    // Filter test forms
249	    const testForms = forms.forms.filter(form => 
250	      this.config.isTestForm(form.title)
251	    );
252	    
253	    // Sort by date created (oldest first)
254	    testForms.sort((a, b) => 
255	      new Date(a.date_created) - new Date(b.date_created)
256	    );
257	    
258	    // Keep latest N forms
259	    const formsToDelete = testForms.slice(0, -cleanupConfig.keepLatest);
260	    
261	    // Delete old test forms
262	    let succeeded = 0;
263	    let failed = 0;
264	    
265	    for (const form of formsToDelete) {
266	      const deleted = await this.deleteTestForm(form.id);
267	      if (deleted) {
268	        succeeded++;
269	      } else {
270	        failed++;
271	      }
272	    }
273	    
274	    return {
275	      succeeded,
276	      failed,
277	      total: formsToDelete.length,
278	      kept: cleanupConfig.keepLatest
279	    };
280	  }
