301	export async function validateRestApiAccess(httpClient, authManager) {
302	  try {
303	    // Test basic connectivity
304	    const connectionResult = await authManager.testConnection(httpClient);
305	    if (!connectionResult.success) {
306	      return {
307	        available: false,
308	        error: 'Authentication failed',
309	        details: connectionResult
310	      };
311	    }
312	
313	    // Test specific endpoints to verify full API access
314	    const endpoints = [
315	      { path: '/forms', name: 'Forms' },
316	      { path: '/entries', name: 'Entries' },
317	      { path: '/feeds', name: 'Feeds' }
318	    ];
319	
320	    // Get baseURL from httpClient for OAuth signature generation
321	    const baseURL = httpClient?.defaults?.baseURL;
322	
323	    if (!baseURL) {
324	      throw new Error('httpClient baseURL is not configured');
325	    }
326	
327	    const results = [];
328	    for (const endpoint of endpoints) {
329	      try {
330	        // Generate proper OAuth headers with full URL for signature
331	        const fullUrl = `${baseURL}${endpoint.path}`;
332	        const headers = authManager.getAuthHeaders('GET', fullUrl, { per_page: 1 });
333	        await httpClient.get(endpoint.path, {
334	          headers,
335	          params: { per_page: 1 }
336	        });
337	        results.push({ ...endpoint, available: true });
338	      } catch (error) {
339	        results.push({
340	          ...endpoint,
341	          available: false,
342	          error: error.response?.status || 'Unknown error'
343	        });
344	      }
345	    }
346	
347	    const availableEndpoints = results.filter(r => r.available).length;
348	    const totalEndpoints = results.length;
349	
350	    return {
351	      available: availableEndpoints > 0,
352	      authMethod: authManager.getAuthInfo().method,
353	      endpoints: results,
354	      coverage: `${availableEndpoints}/${totalEndpoints}`,
355	      fullAccess: availableEndpoints === totalEndpoints,
356	      message: availableEndpoints === totalEndpoints
357	        ? 'Full REST API access confirmed'
358	        : `Partial access: ${availableEndpoints}/${totalEndpoints} endpoints available`
359	    };
360	
361	  } catch (error) {
362	    return {
363	      available: false,
364	      error: 'REST API validation failed',
365	      details: error.message
366	    };
367	  }
