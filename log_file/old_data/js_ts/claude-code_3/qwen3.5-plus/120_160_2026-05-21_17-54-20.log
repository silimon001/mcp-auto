3	 * Handles logging in both MCP mode (JSON-RPC) and test mode (console)
4	 */
5	
6	// Detect if running as MCP server or in test mode
7	const isMCPMode = !process.env.NODE_ENV || process.env.NODE_ENV === 'production';
8	
9	/**
10	 * Send a log message that works in both MCP and test modes
11	 * In MCP mode: sends JSON-RPC notification to stderr to avoid stdout conflicts
12	 * In test mode: uses console.log
13	 */
14	export function sendLogMessage(message, level = 'info') {
15	  if (isMCPMode) {
16	    // In MCP mode, use stderr to avoid conflicting with JSON-RPC on stdout
17	    // Claude Desktop will still see these in the logs
18	    if (level === 'error') {
19	      console.error(message);
20	    } else {
21	      // Use stderr for all logs in MCP mode to keep stdout clean for JSON-RPC
22	      console.error(`[${level}] ${message}`);
23	    }
24	  } else {
25	    // In test mode, use regular console.log
26	    if (level === 'error') {
27	      console.error(message);
28	    } else {
29	      console.log(message);
30	    }
31	  }
32	}
33	
34	export default {
35	  info: (message) => sendLogMessage(message, 'info'),
36	  error: (message) => sendLogMessage(message, 'error'),
37	  warn: (message) => sendLogMessage(message, 'warn'),
38	  debug: (message) => sendLogMessage(message, 'debug')
39	};

