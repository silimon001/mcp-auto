105	    private isCommandAllowed(command: string): boolean {
106	        if (this.allowedCommands.length === 0) {
107	            return true;
108	        }
109	
110	        return this.allowedCommands.some(allowed => {
111	            if (allowed.endsWith('*')) {
112	                const prefix = allowed.slice(0, -1);
113	                return command.startsWith(prefix);
114	            }
115	            return command === allowed;
116	        });
117	    }
