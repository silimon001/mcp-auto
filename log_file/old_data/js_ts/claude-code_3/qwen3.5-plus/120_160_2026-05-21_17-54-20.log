4	// Create a plugin that handles GraphQL files
5	const graphqlPlugin = {
6		name: "graphql-files",
7		setup(build) {
8			// Handle .graphql file imports
9			build.onLoad({ filter: /\.graphql$/ }, async (args) => {
10				const contents = await fs.promises.readFile(args.path, "utf8");
11				return {
12					contents: `export default ${JSON.stringify(contents)};`,
13					loader: "js",
14				};
15			});
16		},
17	};
18	
19	await build({
20		entryPoints: ["./src/index.ts"],
