32	  /**
33	   * Get configuration for specified mode
34	   * @param {boolean} testMode - Use test configuration if true
35	   * @returns {object} Configuration object
36	   */
37	  getConfig(testMode = false) {
38	    const envName = testMode ? 'test' : 'live';
39	    const config = this.environments[envName];
40	    
41	    // Validate required fields
42	    if (!config.url) {
43	      throw new Error(`Missing ${envName} URL configuration. Set ${testMode ? 'TEST_GF_URL' : 'GF_URL'} environment variable.`);
44	    }
45	    
46	    if (!config.consumer_key || !config.consumer_secret) {
47	      throw new Error(`Missing ${envName} authentication. Set consumer key and secret environment variables.`);
48	    }
49	    
50	    return config;
51	  },
52	  
53	  /**
54	   * Check if test mode is enabled
55	   */
56	  isTestMode() {
57	    return process.env.GRAVITYKIT_MCP_TEST_MODE === 'true' ||
58	           process.env.GRAVITYMCP_TEST_MODE === 'true' ||
59	           process.env.NODE_ENV === 'test';
60	  },
61	
62	  /**
63	   * Resolve environment config for the active mode.
64	   *
65	   * When test mode is active, remaps GRAVITY_FORMS_TEST_* env vars to
66	   * their primary equivalents (GRAVITY_FORMS_BASE_URL, etc.) so the
67	   * GravityFormsClient and AuthManager work unchanged against the test site.
68	   *
69	   * Returns a shallow clone — never mutates the original config.
70	   *
71	   * @param {object} config - Raw environment config (typically process.env).
72	   * @returns {object} Config with test overrides applied when in test mode.
73	   */
74	  resolveEnv(config) {
75	    const isTest = config.GRAVITYKIT_MCP_TEST_MODE === 'true' || config.GRAVITYMCP_TEST_MODE === 'true' || config.NODE_ENV === 'test';
76	
77	    if (!isTest) {
78	      return config;
79	    }
80	
81	    const resolved = { ...config };
82	
83	    const mappings = {
84	      GRAVITY_FORMS_TEST_BASE_URL: 'GRAVITY_FORMS_BASE_URL',
85	      GRAVITY_FORMS_TEST_URL: 'GRAVITY_FORMS_BASE_URL',
86	      GRAVITY_FORMS_TEST_CONSUMER_KEY: 'GRAVITY_FORMS_CONSUMER_KEY',
87	      GRAVITY_FORMS_TEST_CONSUMER_SECRET: 'GRAVITY_FORMS_CONSUMER_SECRET',
88	      GRAVITY_FORMS_TEST_AUTH_METHOD: 'GRAVITY_FORMS_AUTH_METHOD',
89	      GRAVITY_FORMS_TEST_TIMEOUT: 'GRAVITY_FORMS_TIMEOUT',
90	    };
91	
92	    for (const [testKey, primaryKey] of Object.entries(mappings)) {
93	      if (resolved[testKey]) {
94	        resolved[primaryKey] = resolved[testKey];
95	      }
96	    }
97	
98	    return resolved;
99	  },
