465	        // Match each value to a choice and assign to the correct sub-input.
466	        // GF HTML-encodes choice text (& → &amp;, etc.), so also compare
467	        // against decoded text for natural-language input from AI agents.
468	        const decodeHtml = (s) => s.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#039;/g, "'");
469	        for (const val of values) {
470	          const choiceIndex = field.choices.findIndex(
471	            c => c.value === val || c.text === val || decodeHtml(c.text) === val
472	          );
473	
474	          if (choiceIndex !== -1 && visibleInputs[choiceIndex]) {
475	            expanded[String(visibleInputs[choiceIndex].id)] = field.choices[choiceIndex].value;
476	          }
477	        }
478	        continue;
479	      }
480	
481	      // Fields with choices but no inputs: either single-value or multi-value
482	      if (field.choices) {
483	        if (singleValueTypes.has(fieldType)) {
484	          // Radio/dropdown: take first element
485	          expanded[key] = expanded[key][0] || '';
486	        } else {
487	          // Multiselect, entry_tags, or any other multi-value field:
488	          // REST API v2 accepts comma-separated strings for multi-value fields
489	          expanded[key] = expanded[key].join(',');
490	        }
491	      }
492	    }
493	
494	    return expanded;
495	  }
