126	        const oldAsyncExecution = this.asyncExecution;
127	        const oldExecutionDelay = this.executionDelay;
128	
129	        // 检查配置值
130	        const rawAsyncExecution = config.get('asyncExecution');
131	        const rawExecutionDelay = config.get('executionDelay');
132	
