131	// Validate environment
132	export function validateEnv(): void {
133	  if (!secretLoaded && !secretBuffer) {
134	    throw new Error('Missing required RECALL_PRIVATE_KEY. Provide it via environment variables or .env.');
135	  }
136	  const recommendedVars: (keyof Config)[] = ['RECALL_NETWORK', 'RECALL_BUCKET_ALIAS', 'RECALL_LOG_PREFIX'];
137	  const missing: string[] = recommendedVars.filter((v) => !process.env[v]);
138	  if (missing.length > 0) {
139	    logger.warn(`Missing recommended variables: ${missing.join(', ')}. Using defaults.`);
140	  }
141	}
142	
143	// Setup logging and status
144	export function logConfigStatus(): void {
145	  validateEnv();
146	  logger.info('Configuration loaded:');
