72	/**
73	 * OAuth 1.0a Authentication Handler (SECONDARY METHOD)
74	 * More complex but provides additional security features
75	 * Included for environments requiring OAuth workflow
76	 */
77	export class OAuth1Handler {
78	  constructor(consumerKey, consumerSecret, baseUrl) {
79	    this.consumerKey = consumerKey;
80	    this.consumerSecret = consumerSecret;
81	    this.baseUrl = baseUrl;
82	  }
83	
84	  /**
85	   * Generate OAuth 1.0a signature for Gravity Forms API
86	   * Implements RFC 5849 OAuth 1.0a specification
87	   */
88	  generateOAuthSignature(method, url, params, timestamp, nonce) {
89	    // Validate required parameters
90	    if (!method || !url || !timestamp || !nonce) {
91	      throw new Error('Invalid OAuth parameters: method, url, timestamp, and nonce are required');
92	    }
93	
94	    // Combine all parameters
95	    const allParams = {
96	      ...params,
97	      oauth_consumer_key: this.consumerKey,
98	      oauth_timestamp: timestamp,
99	      oauth_nonce: nonce,
100	      oauth_signature_method: 'HMAC-SHA1',
101	      oauth_version: '1.0'
102	    };
103	
104	    // Create parameter string
105	    const paramString = Object.keys(allParams)
106	      .sort()
107	      .map(key => `${encodeURIComponent(key)}=${encodeURIComponent(allParams[key])}`)
108	      .join('&');
109	
110	    // Create signature base string
111	    const baseString = [
112	      method.toUpperCase(),
113	      encodeURIComponent(url),
114	      encodeURIComponent(paramString)
115	    ].join('&');
116	
117	    // Create signing key
118	    const signingKey = `${encodeURIComponent(this.consumerSecret)}&`;
119	
120	    // Generate signature
121	    const signature = crypto
122	      .createHmac('sha1', signingKey)
123	      .update(baseString)
124	      .digest('base64');
125	
126	    return signature;
127	  }
128	
129	  /**
130	   * Generate OAuth 1.0a headers for API request
131	   */
132	  getAuthHeaders(method = 'GET', url, params = {}) {
133	    const timestamp = Math.floor(Date.now() / 1000).toString();
134	    const nonce = crypto.randomBytes(16).toString('hex');
135	
136	    const signature = this.generateOAuthSignature(method, url, params, timestamp, nonce);
137	
138	    const authHeader = [
139	      `oauth_consumer_key="${encodeURIComponent(this.consumerKey)}"`,
140	      `oauth_timestamp="${timestamp}"`,
141	      `oauth_nonce="${nonce}"`,
142	      `oauth_signature_method="HMAC-SHA1"`,
143	      `oauth_version="1.0"`,
144	      `oauth_signature="${encodeURIComponent(signature)}"`
145	    ].join(', ');
146	
147	    return {
148	      'Authorization': `OAuth ${authHeader}`,
149	      'Content-Type': 'application/json',
150	      'User-Agent': 'Gravity MCP v1.0.0'
151	    };
152	  }
153	
154	  /**
155	   * Test OAuth authentication
156	   */
157	  async testConnection(httpClient) {
158	    try {
159	      const fullUrl = `${this.baseUrl}/wp-json/gf/v2/forms`;
160	      const headers = this.getAuthHeaders('GET', fullUrl, { per_page: 1 });
161	
162	      const response = await httpClient.get('/forms', {
163	        headers,
164	        params: { per_page: 1 }
165	      });
166	
167	      return {
168	        success: true,
169	        method: 'OAuth 1.0a',
170	        message: 'Successfully connected to Gravity Forms REST API v2',
171	        version: response.data.version || 'Unknown'
172	      };
173	    } catch (error) {
174	      return {
175	        success: false,
176	        method: 'OAuth 1.0a',
177	        error: error.response?.status === 401 ? 'Invalid OAuth signature or credentials' : error.message,
178	        details: error.response?.data || error.message
179	      };
180	    }
181	  }
