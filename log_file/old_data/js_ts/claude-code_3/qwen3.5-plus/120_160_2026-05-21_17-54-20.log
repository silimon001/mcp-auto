49	// Secure secret storage
50	let secretBuffer: sodium.SecureBuffer | null = null;
51	let secretLoaded: boolean = false;
52	const __filename = fileURLToPath(import.meta.url);
53	const __dirname = dirname(__filename);
54	const ENV_FILE_PATH: string = resolve(__dirname, '..', '.env');
55	const EXPECTED_ENV_HASH: string | null = process.env.ENV_FILE_HASH || null; // Optional integrity hash
56	
57	// Load secrets with priority: external env > .env file
58	const loadSecrets = (): void => {
59	  if (secretLoaded) return;
60	
61	  // Check external environment first
62	  const externalKey: string | undefined = process.env.RECALL_PRIVATE_KEY;
63	  if (externalKey) {
64	    secretBuffer = sodium.sodium_malloc(externalKey.length) as sodium.SecureBuffer;
65	    secretBuffer.write(externalKey);
66	    sodium.sodium_mlock(secretBuffer); // Lock memory to prevent swapping
67	    process.env.RECALL_PRIVATE_KEY = '[REDACTED]'; // Redact immediately
68	    logger.info('Using RECALL_PRIVATE_KEY from external environment variables.');
69	    secretLoaded = true;
70	    return;
71	  }
72	
73	  // Fall back to .env file
74	  try {
75	    const envContent: string = readFileSync(ENV_FILE_PATH, 'utf8');
76	    // Optional: Verify integrity with a precomputed hash
77	    if (EXPECTED_ENV_HASH) {
78	      const computedHash: string = createHash('sha256').update(envContent).digest('hex');
79	      if (computedHash !== EXPECTED_ENV_HASH) {
80	        throw new Error('Integrity check failed: .env file hash does not match expected value.');
81	      }
82	    }
83	
84	    const envVars: Record<string, string> = envContent.split('\n').reduce((acc, line) => {
85	      const [key, value] = line.split('=');
86	      if (key && value) acc[key.trim()] = value.trim();
87	      return acc;
88	    }, {} as Record<string, string>);
89	
90	    const envKey: string | undefined = envVars.RECALL_PRIVATE_KEY;
91	    if (!envKey) {
92	      throw new Error('RECALL_PRIVATE_KEY not found in .env file.');
93	    }
94	
95	    secretBuffer = sodium.sodium_malloc(envKey.length) as sodium.SecureBuffer;
96	    secretBuffer.write(envKey);
97	    sodium.sodium_mlock(secretBuffer); // Lock memory to prevent swapping
98	    process.env.RECALL_PRIVATE_KEY = '[REDACTED]';
99	    logger.info(`Loaded RECALL_PRIVATE_KEY from .env file at: ${ENV_FILE_PATH}`);
100	    secretLoaded = true;
101	  } catch (error: unknown) {
102	    const message: string = error instanceof Error ? error.message : String(error);
103	    logger.warn(`No valid .env file found or RECALL_PRIVATE_KEY missing: ${message}. Will fail if required.`);
104	  }
105	};
106	
107	// Initialize secrets
108	loadSecrets();
109	
110	// Export configuration object using Config interface
111	export const config: Config = {
