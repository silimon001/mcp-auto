148	  logger.info(`  • Bucket Alias: ${config.RECALL_BUCKET_ALIAS}`);
149	  logger.info(`  • Log Prefix: ${config.RECALL_LOG_PREFIX}`);
150	  logger.info(`  • Network: ${config.RECALL_NETWORK}`);
151	  logger.info(`  • Private Key: ${secretBuffer ? '[PROVIDED]' : '[MISSING]'}`);
152	}

