22	// Redaction function with type safety
23	const redactSensitive = (input: any): any => {
24	  if (typeof input === 'string') {
25	    return input
26	      .replace(/[0-9a-fA-F]{64}/g, '[REDACTED_KEY]') // Hex keys
27	      .replace(/[^=&\s]{32,}/g, '[REDACTED_LONG_VALUE]') // Long strings
28	      .replace(/(private_key|secret|key|token|password)=([^&\s]+)/gi, '$1=[REDACTED]');
29	  }
30	  if (input && typeof input === 'object') {
31	    const sanitized: Record<string, any> = {};
32	    for (const [key, value] of Object.entries(input)) {
33	      sanitized[key] = key.toLowerCase().includes('key') || key.toLowerCase().includes('secret')
34	        ? '[REDACTED]'
35	        : redactSensitive(value);
36	    }
37	    return sanitized;
38	  }
39	  return input;
40	};
41	
42	// Custom logger implementation
43	export const logger: Logger = {
44	  error: (...args: any[]) => process.stderr.write(`${chalk.red('[ERROR]')} ${args.map(redactSensitive).join(' ')}\n`),
45	  warn: (...args: any[]) => process.stderr.write(`${chalk.yellow('[WARN]')} ${args.map(redactSensitive).join(' ')}\n`),
46	  info: (...args: any[]) => process.stderr.write(`${chalk.blue('[INFO]')} ${args.map(redactSensitive).join(' ')}\n`),
47	};
