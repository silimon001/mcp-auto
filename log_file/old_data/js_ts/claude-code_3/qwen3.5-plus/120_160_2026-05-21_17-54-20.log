9	import crypto from 'crypto';
10	import logger from '../utils/logger.js';
11	
12	/**
13	 * Basic Authentication Handler (PRIMARY METHOD)
14	 * Simple and secure authentication using Consumer Key/Secret over HTTPS
15	 * Recommended for Gravity Forms v2 REST API
16	 */
17	export class BasicAuthHandler {
18	  constructor(consumerKey, consumerSecret, baseUrl) {
19	    this.consumerKey = consumerKey;
20	    this.consumerSecret = consumerSecret;
21	    this.baseUrl = baseUrl;
22	
23	    // Validate HTTPS for Basic Auth security
24	    if (!this.baseUrl.startsWith('https://')) {
25	      throw new Error('Basic Authentication requires HTTPS connection for security');
26	    }
27	  }
28	
29	  /**
30	   * Generate Basic Auth headers for Gravity Forms v2
31	   * Uses standard HTTP Basic Authentication with Consumer Key/Secret
32	   */
33	  getAuthHeaders() {
34	    const credentials = `${this.consumerKey}:${this.consumerSecret}`;
35	    const encodedCredentials = Buffer.from(credentials).toString('base64');
36	
37	    return {
38	      'Authorization': `Basic ${encodedCredentials}`,
39	      'Content-Type': 'application/json',
40	      'User-Agent': 'Gravity MCP v1.0.0'
41	    };
42	  }
43	
44	  /**
45	   * Test authentication by making a simple API call
46	   * Validates both credentials and REST API availability
47	   */
48	  async testConnection(httpClient) {
49	    try {
50	      const response = await httpClient.get('/forms', {
51	        headers: this.getAuthHeaders(),
52	        params: { per_page: 1 }
53	      });
54	
55	      return {
56	        success: true,
57	        method: 'Basic Authentication',
58	        message: 'Successfully connected to Gravity Forms REST API v2',
59	        version: response.data.version || 'Unknown'
60	      };
61	    } catch (error) {
62	      return {
63	        success: false,
64	        method: 'Basic Authentication',
65	        error: error.response?.status === 401 ? 'Invalid credentials' : error.message,
66	        details: error.response?.data || error.message
67	      };
68	    }
69	  }
70	}
