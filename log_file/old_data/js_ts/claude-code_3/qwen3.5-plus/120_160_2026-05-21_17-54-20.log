135	            executionDelay: rawExecutionDelay,
136	            configSection: 'vscode-internal-command-mcp-server',
137	        });
138	
139	        this.asyncExecution = config.get<boolean>('asyncExecution', true);
140	        this.executionDelay = config.get<number>('executionDelay', 0);
141	
142	        console.log(
143	            `Async config updated: asyncExecution=${oldAsyncExecution}->${this.asyncExecution}, executionDelay=${oldExecutionDelay}->${this.executionDelay}`,
144	        );
145	
146	        // 如果异步执行被禁用，清理待处理的任务
147	        if (!this.asyncExecution && this.backgroundExecutor) {
