19	        });
20	    }
21	
22	    public async executeCommand(command: string, args?: any[]): Promise<any> {
23	        if (!this.isCommandAllowed(command)) {
24	            throw new Error(`Command '${command}' is not allowed`);
25	        }
26	
27	        if (this.asyncExecution) {
28	            // 异步模式：立即返回成功，提交到后台执行器
29	            const taskId = this.backgroundExecutor.submitTask(command, args, this.executionDelay);
30	            const stats = this.backgroundExecutor.getTaskStats();
31	
32	            return {
33	                success: true,
34	                async: true,
35	                taskId: taskId,
36	                message: `命令 '${command}' 已提交到后台执行${this.executionDelay > 0 ? `，将在 ${this.executionDelay}ms 后执行` : ''}`,
37	                command: command,
38	                arguments: args,
39	                executionDelay: this.executionDelay,
40	                queueLength: stats.pending + stats.running,
41	                taskStats: stats,
42	            };
43	        } else {
44	            // 同步模式：等待执行完成
45	            try {
46	                const result = await vscode.commands.executeCommand(command, ...(args || []));
47	                return {
48	                    success: true,
49	                    async: false,
50	                    result: result,
51	                    command: command,
52	                    arguments: args,
53	                };
54	            } catch (error) {
55	                return {
56	                    success: false,
57	                    async: false,
58	                    error: error instanceof Error ? error.message : String(error),
59	                    command: command,
60	                    arguments: args,
61	                };
62	            }
63	        }
64	    }
