1	/**
2	 * Input Validation Module for Gravity MCP
3	 * Complete rewrite using composable validation architecture
4	 */
5	
6	import { FieldAwareValidator } from './field-validation.js';
7	import { validate, ValidationSchema } from './validation-chain.js';
8	import { VALIDATION_CONFIG, getEnumValues } from './validation-config.js';
9	import {
10	  FormsValidator as ChainFormsValidator,
11	  FeedsValidator as ChainFeedsValidator,
12	  NotificationsValidator as ChainNotificationsValidator,
13	  SubmissionsValidator as ChainSubmissionsValidator,
14	} from './validators.js';
15	
16	/**
17	 * Base validation utilities. FormsValidator and EntriesValidator below extend this
18	 * with domain-specific logic. Feeds, Notifications, and Submissions use the chain-based
19	 * validators from validators.js (imported as Chain* above).
20	 */
21	export class BaseValidator {
22	  static validateRequired(data, requiredFields) {
23	    if (!data || typeof data !== 'object') {
24	      throw new Error('Input must be an object');
25	    }
26	
27	    const missing = requiredFields.filter(field => {
28	      const value = data[field];
29	      return value === undefined || value === null;
30	    });
31	
32	    if (missing.length > 0) {
33	      if (missing.length === 1) {
34	        throw new Error(`${missing[0]} is required`);
35	      } else {
36	        throw new Error(`Missing required fields: ${missing.join(', ')}`);
37	      }
38	    }
39	  }
40	
41	  static validateId(id, fieldName = 'id') {
42	    const schema = new ValidationSchema();
43	    schema.field('value', validate('value')
44	      .required()
45	      .positiveInteger()
46	    );
47	
48	    try {
49	      const result = schema.validate({ value: id });
50	      return result.value;
51	    } catch (error) {
52	      // Map to legacy error format
53	      if (error.errors && error.errors[0]) {
54	        const msg = error.errors[0].message
55	          .replace('value', fieldName);
56	        throw new Error(msg);
57	      }
58	      throw error;
59	    }
60	  }
61	
62	  static validateIds(ids, fieldName = 'IDs') {
63	    if (!Array.isArray(ids)) {
64	      throw new Error(`${fieldName} must be an array`);
65	    }
66	    return ids.map((id, index) =>
67	      this.validateId(id, `${fieldName}[${index}]`)
68	    );
69	  }
70	
71	  static validatePagination(params) {
72	    const validated = {};
73	
74	    if (params.page !== undefined) {
75	      validated.page = this.validateId(params.page, 'page');
76	    }
77	
78	    if (params.per_page !== undefined) {
79	      const perPage = this.validateId(params.per_page, 'per_page');
80	      if (perPage > 100) {
81	        throw new Error('per_page cannot exceed 100');
82	      }
83	      validated.per_page = perPage;
84	    }
85	
86	    return validated;
87	  }
88	
89	  static validateFieldFilter(filter) {
90	    if (!filter || typeof filter !== 'object') {
91	      throw new Error('Field filter must be an object');
92	    }
93	
94	    const { key, value, operator } = filter;
95	
96	    if (!key) {
97	      throw new Error('Field filter must have a key');
98	    }
99	
100	    if (value === undefined) {
101	      throw new Error('Field filter must have a value');
102	    }
103	
104	    if (operator && !getEnumValues('fieldOperators').includes(operator)) {
105	      throw new Error(`Invalid operator: ${operator}. Valid operators: ${getEnumValues('fieldOperators').join(', ')}`);
106	    }
107	
108	    return {
109	      key: String(key),
110	      value: String(value),
111	      operator: operator || 'IS'
112	    };
113	  }
114	
115	  static validateSearch(searchParams) {
