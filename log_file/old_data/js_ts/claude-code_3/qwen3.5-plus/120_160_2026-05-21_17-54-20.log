1	import { z } from 'zod'
2	import { type Env, type ValidatedEnv } from '../../types/env'
3	import { logger } from '../shared/log'
4	
5	const envSchema = z.object({
6		SCHWAB_CLIENT_ID: z
7			.string({
8				required_error: 'SCHWAB_CLIENT_ID is required for OAuth authentication',
9			})
10			.min(1, 'SCHWAB_CLIENT_ID cannot be empty'),
11	
12		SCHWAB_CLIENT_SECRET: z
13			.string({
14				required_error:
15					'SCHWAB_CLIENT_SECRET is required for OAuth authentication',
16			})
17			.min(1, 'SCHWAB_CLIENT_SECRET cannot be empty'),
18	
19		COOKIE_ENCRYPTION_KEY: z
20			.string({
21				required_error:
22					'COOKIE_ENCRYPTION_KEY is required for secure cookie storage',
23			})
24			.min(1, 'COOKIE_ENCRYPTION_KEY cannot be empty'),
25	
26		SCHWAB_REDIRECT_URI: z
27			.string({
28				required_error: 'SCHWAB_REDIRECT_URI is required for OAuth callback',
29			})
30			.url('SCHWAB_REDIRECT_URI must be a valid URL'),
31	
32		OAUTH_KV: z.any().refine((v) => !!v, {
33			message: 'OAUTH_KV binding is required for token storage',
34		}),
35	
36		LOG_LEVEL: z
37			.enum(['trace', 'debug', 'info', 'warn', 'error', 'fatal'])
38			.optional()
39			.default('info'),
40	
41		ENVIRONMENT: z
42			.enum(['development', 'staging', 'production'])
43			.optional()
44			.default('production'),
45	})
46	
47	function buildConfigInternal(env: Env): ValidatedEnv {
48		try {
49			const validated = envSchema.parse(env)
50			return Object.freeze(validated) as ValidatedEnv
51		} catch (error) {
52			if (error instanceof z.ZodError) {
53				const issues = error.issues
54					.map((issue) => {
55						const path = issue.path.join('.')
56						return `  - ${path}: ${issue.message}`
57					})
58					.join('\n')
59	
60				const msg = `Environment validation failed:\n${issues}`
61				logger.error(msg)
62				throw new Error(msg)
63			}
64			throw error
65		}
66	}
67	
68	// Memoized singleton config getter
69	export const getConfig = (() => {
70		let cachedConfig: ValidatedEnv | null = null
71		let cachedEnvHash: string | null = null
72	
73		return (env: Env): ValidatedEnv => {
74			// Create a simple hash of the env object for memoization
75			// Exclude OAUTH_PROVIDER to avoid circular reference issues
76			const envHash = JSON.stringify(
77				Object.keys(env)
78					.filter((key) => key !== 'OAUTH_PROVIDER') // Exclude circular reference
79					.sort()
80					.map((key) => [key, (env as any)[key]]),
81			)
82	
83			if (cachedConfig && cachedEnvHash === envHash) {
84				return cachedConfig
85			}
86	
87			cachedConfig = buildConfigInternal(env)
88			cachedEnvHash = envHash
89			return cachedConfig
90		}
91	})()
92	

