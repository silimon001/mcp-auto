1	/**
2	 * Validation Chain
3	 * Composable validation system that chains multiple rules together
4	 */
5	
6	import {
7	  RequiredRule,
8	  TypeRule,
9	  StringLengthRule,
10	  NumberRangeRule,
11	  PatternRule,
12	  EmailRule,
13	  URLRule,
14	  DateRule,
15	  EnumRule,
16	  PositiveIntegerRule,
17	  CustomRule,
18	  TrimRule,
19	  LowercaseRule
20	} from './validation-rules.js';
21	
22	/**
23	 * ValidationChain class for composing validation rules
24	 */
25	export class ValidationChain {
26	  constructor(fieldName) {
27	    this.fieldName = fieldName;
28	    this.rules = [];
29	  }
30	  
31	  /**
32	   * Add a validation rule to the chain
33	   */
34	  addRule(rule) {
35	    this.rules.push(rule);
36	    return this;
37	  }
38	  
39	  /**
40	   * Field is required
41	   */
42	  required() {
43	    return this.addRule(new RequiredRule());
44	  }
45	  
46	  /**
47	   * Field must be a string
48	   */
49	  string() {
50	    return this.addRule(new TypeRule('string'));
51	  }
52	  
53	  /**
54	   * Field must be a number
55	   */
56	  number() {
57	    return this.addRule(new TypeRule('number'));
58	  }
59	  
60	  /**
61	   * Field must be a boolean
62	   */
63	  boolean() {
64	    return this.addRule(new TypeRule('boolean'));
65	  }
66	  
67	  /**
68	   * Field must be an array
69	   */
70	  array() {
71	    return this.addRule(new TypeRule('array'));
72	  }
73	  
74	  /**
75	   * Field must be an object
76	   */
77	  object() {
78	    return this.addRule(new TypeRule('object'));
79	  }
80	  
81	  /**
82	   * String length validation
83	   */
84	  length(minLength = null, maxLength = null) {
85	    return this.addRule(new StringLengthRule(minLength, maxLength));
86	  }
87	  
88	  /**
89	   * Minimum length
90	   */
91	  minLength(min) {
92	    return this.addRule(new StringLengthRule(min, null));
93	  }
94	  
95	  /**
96	   * Maximum length
97	   */
98	  maxLength(max) {
99	    return this.addRule(new StringLengthRule(null, max));
100	  }
101	  
102	  /**
103	   * Number range validation
104	   */
105	  range(min = null, max = null) {
106	    return this.addRule(new NumberRangeRule(min, max));
107	  }
108	  
109	  /**
110	   * Minimum value
111	   */
112	  min(min) {
113	    return this.addRule(new NumberRangeRule(min, null));
114	  }
115	  
116	  /**
117	   * Maximum value
118	   */
119	  max(max) {
120	    return this.addRule(new NumberRangeRule(null, max));
121	  }
122	  
123	  /**
124	   * Pattern validation
125	   */
126	  pattern(regex, errorMessage) {
127	    return this.addRule(new PatternRule(regex, errorMessage));
128	  }
129	  
130	  /**
131	   * Email validation
132	   */
133	  email() {
134	    return this.addRule(new EmailRule());
135	  }
136	  
137	  /**
138	   * URL validation
139	   */
140	  url() {
141	    return this.addRule(new URLRule());
142	  }
143	  
144	  /**
145	   * Date validation (ISO 8601)
146	   */
147	  date() {
148	    return this.addRule(new DateRule());
149	  }
150	  
151	  /**
152	   * Enum validation
153	   */
154	  enum(allowedValues) {
155	    return this.addRule(new EnumRule(allowedValues));
156	  }
157	  
158	  /**
159	   * Positive integer validation
160	   */
161	  positiveInteger() {
162	    return this.addRule(new PositiveIntegerRule());
163	  }
164	  
165	  /**
166	   * Custom validation
167	   */
168	  custom(validateFn, errorMessage = 'Validation failed') {
169	    return this.addRule(new CustomRule(validateFn, errorMessage));
170	  }
171	  
172	  /**
173	   * Trim whitespace
174	   */
175	  trim() {
176	    return this.addRule(new TrimRule());
177	  }
178	  
179	  /**
180	   * Convert to lowercase
181	   */
182	  lowercase() {
183	    return this.addRule(new LowercaseRule());
184	  }
185	  
186	  /**
187	   * Validate the value
188	   */
189	  validate(value) {
190	    let result = value;
191	    
192	    for (const rule of this.rules) {
193	      result = rule.validate(result, this.fieldName);
194	    }
195	    
196	    return result;
197	  }
198	  
199	  /**
200	   * Validate with error context
201	   */
202	  validateWithContext(value, context = {}) {
203	    try {
204	      return {
205	        valid: true,
206	        value: this.validate(value),
207	        field: this.fieldName,
208	        context
209	      };
210	    } catch (error) {
211	      return {
212	        valid: false,
213	        error: error.message,
214	        field: this.fieldName,
215	        value,
216	        context
217	      };
218	    }
219	  }
220	}
221	
222	/**
223	 * Factory function for creating validation chains
224	 */
225	export function validate(fieldName) {
226	  return new ValidationChain(fieldName);
227	}
228	
229	/**
230	 * Validate multiple fields
231	 */
232	export class ValidationSchema {
233	  constructor() {
234	    this.fields = {};
235	  }
236	  
237	  /**
238	   * Add field validation
239	   */
240	  field(name, chain) {
241	    this.fields[name] = chain;
242	    return this;
243	  }
244	  
245	  /**
246	   * Validate an object
247	   */
248	  validate(data) {
249	    const errors = [];
250	    const validated = {};
251	    
252	    for (const [fieldName, chain] of Object.entries(this.fields)) {
253	      try {
254	        const value = data[fieldName];
255	        validated[fieldName] = chain.validate(value);
256	      } catch (error) {
257	        errors.push({
258	          field: fieldName,
259	          message: error.message,
260	          value: data[fieldName]
261	        });
262	      }
263	    }
264	    
265	    if (errors.length > 0) {
266	      const error = new ValidationError('Validation failed', errors);
267	      throw error;
268	    }
269	    
270	    return validated;
271	  }
272	  
273	  /**
274	   * Validate with detailed results
275	   */
276	  validateWithDetails(data) {
277	    const errors = [];
278	    const validated = {};
279	    const details = {};
280	    
281	    for (const [fieldName, chain] of Object.entries(this.fields)) {
282	      const result = chain.validateWithContext(data[fieldName]);
283	      details[fieldName] = result;
284	      
285	      if (result.valid) {
286	        validated[fieldName] = result.value;
287	      } else {
288	        errors.push({
289	          field: fieldName,
290	          message: result.error,
291	          value: result.value
292	        });
293	      }
294	    }
295	    
296	    return {
297	      valid: errors.length === 0,
298	      data: validated,
299	      errors,
300	      details
301	    };
302	  }
303	}
304	
305	/**
306	 * Validation error with context
307	 */
308	export class ValidationError extends Error {
309	  constructor(message, errors = []) {
310	    super(message);
311	    this.name = 'ValidationError';
312	    this.errors = errors;
313	  }
314	  
315	  /**
316	   * Get formatted error message
317	   */
318	  getFormattedMessage() {
319	    if (this.errors.length === 0) {
320	      return this.message;
321	    }
322	    
323	    if (this.errors.length === 1) {
324	      return this.errors[0].message;
325	    }
326	    
327	    const errorList = this.errors
328	      .map(e => `  - ${e.field}: ${e.message}`)
329	      .join('\n');
330	    
331	    return `${this.message}:\n${errorList}`;
332	  }
333	  
334	  /**
335	   * Get errors for a specific field
336	   */
337	  getFieldErrors(fieldName) {
338	    return this.errors.filter(e => e.field === fieldName);
339	  }
340	  
341	  /**
342	   * Check if a specific field has errors
343	   */
344	  hasFieldError(fieldName) {
345	    return this.errors.some(e => e.field === fieldName);
346	  }
347	}

