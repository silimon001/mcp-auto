553	server.setRequestHandler(CallToolRequestSchema, async (request) => {
554	  const { name, arguments: params } = request.params;
555	
556	  // Ensure client is initialized
557	  if (!gravityFormsClient) {
558	    await initializeClient();
559	  }
560	
561	  // Route to appropriate handler
562	  // The client already validates internally, just pass params directly
563	  switch (name) {
564	    // Forms Management
565	    case 'gf_list_forms':
566	      return wrapHandler(() => gravityFormsClient.listForms(params), params)();
567	    case 'gf_get_form':
568	      return wrapHandler(() => gravityFormsClient.getForm(params), params)();
569	    case 'gf_create_form':
570	      return wrapHandler(() => gravityFormsClient.createForm(params), params)();
571	    case 'gf_update_form':
572	      return wrapHandler(() => gravityFormsClient.updateForm(params), params)();
573	    case 'gf_delete_form':
574	      return wrapHandler(() => gravityFormsClient.deleteForm(params), params)();
575	    case 'gf_validate_form':
576	      return wrapHandler(() => gravityFormsClient.validateForm(params), params)();
577	
578	    // Entries Management
579	    case 'gf_list_entries':
580	      return wrapHandler(async () => {
581	        const result = await gravityFormsClient.listEntries(params);
582	        return params.compact !== false ? stripEntryMetaFromResponse(result) : result;
583	      }, params)();
584	    case 'gf_get_entry':
585	      return wrapHandler(async () => {
586	        const result = await gravityFormsClient.getEntry(params);
587	        return params.compact !== false ? stripEntryMetaFromResponse(result) : result;
588	      }, params)();
589	    case 'gf_create_entry':
590	      return wrapHandler(async () => {
591	        const result = await gravityFormsClient.createEntry(params);
592	        return params.compact !== false ? stripEntryMetaFromResponse(result) : result;
593	      }, params)();
594	    case 'gf_update_entry':
595	      return wrapHandler(async () => {
596	        const result = await gravityFormsClient.updateEntry(params);
597	        return params.compact !== false ? stripEntryMetaFromResponse(result) : result;
598	      }, params)();
599	    case 'gf_delete_entry':
