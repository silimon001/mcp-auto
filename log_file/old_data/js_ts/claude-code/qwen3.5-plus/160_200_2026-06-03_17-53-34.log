 \"Typo-tolerant search for addresses, points of interest, and geographies\"\n43\t    },\n44\t    {\n45\t      \"name\": \"tomtom-poi-search\",\n46\t      \"description\": \"Find specific business categories\"\n47\t    },\n48\t    {\n49\t      \"name\": \"tomtom-nearby\",\n50\t      \"description\": \"Discover services within a radius\"\n51\t    },\n52\t    {\n53\t      \"name\": \"tomtom-routing\",\n54\t      \"description\": \"Calculate optimal routes between locations\"\n55\t    },\n56\t    {\n57\t      \"name\": \"tomtom-waypoint-routing\",\n58\t      \"description\": \"Multi-stop route planning Routing API\"\n59\t    },\n60\t    {\n61\t      \"name\": \"tomtom-reachable-range\",\n62\t      \"description\": \"Determine the area reachable within a specified time or driving distance\"\n63\t    },\n64\t    {\n65\t      \"name\": \"tomtom-traffic\",\n66\t      \"description\": \"Look up traffic incidents in an area (incidents, dangerous conditions, closures, etc.)\"\n67\t    },\n68\t    {\n69\t      \"name\": \"tomtom-static-map\",\n70\t      \"description\": \"Generate custom map images\"\n71\t    },\n72\t    {\n73\t      \"name\": \"tomtom-dynamic-map\",\n74\t      \"description\": \"Advanced map rendering with custom markers, routes, and traffic visualization (requires MapLibre dependencies unless using Docker)\"\n75\t    }\n76\t  ],\n77\t  \"tools_generated\": true,\n78\t  \"user_config\": {\n79\t    \"tomtom_api_key\": {\n80\t      \"type\": \"string\",\n81\t      \"title\": \"TomTom API Key\",\n82\t      \"description\": \"Your TomTom API key used to authenticate with TomTom services.\",\n83\t      \"sensitive\": true,\n84\t      \"required\": true\n85\t    },\n86\t    \"tomtom_maps_backend\": {\n87\t      \"type\": \"string\",\n88\t      \"title\": \"Maps Backend\",\n89\t      \"description\": \"TomTom maps backend to use: 'genesis' (default) or 'orbis'. Note: Orbis is currently in Public Preview and requires explicit enablement for developer accounts.\",\n90