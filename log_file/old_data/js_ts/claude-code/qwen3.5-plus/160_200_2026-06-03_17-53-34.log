1	// Unified config reader for both Node.js and Cloudflare Workers
2	// Generalized from Spotify MCP implementation
3	
4	import type { AuthStrategyType } from '../auth/strategy.js';
5	
6	export type UnifiedConfig = {
7	  // Server
8	  HOST: string;
9	  PORT: number;
10	  NODE_ENV: 'development' | 'production' | 'test';
11	
12	  // MCP
13	  MCP_TITLE: string;
14	  MCP_INSTRUCTIONS: string;
15	  MCP_VERSION: string;
16	  MCP_PROTOCOL_VERSION: string;
17	  MCP_ACCEPT_HEADERS: string[];
18	
19	  // Auth Strategy
20	  AUTH_STRATEGY: AuthStrategyType;
21	  AUTH_ENABLED: boolean;
22	  AUTH_REQUIRE_RS: boolean;
23	  AUTH_ALLOW_DIRECT_BEARER: boolean;
24	  AUTH_RESOURCE_URI?: string;
25	  AUTH_DISCOVERY_URL?: string;
26	
27	  // API Key auth (AUTH_STRATEGY=api_key)
28	  API_KEY?: string;
29	  API_KEY_HEADER: string;
30	
31	  // Bearer token auth (AUTH_STRATEGY=bearer)
32	  BEARER_TOKEN?: string;
33	
34	  // Custom headers (AUTH_STRATEGY=custom)
35	  // Format: "X-Header-1:value1,X-Header-2:value2"
36	  CUSTOM_HEADERS?: string;
37	
38	  // OAuth (AUTH_STRATEGY=oauth)
39	  OAUTH_CLIENT_ID?: string;
40	  OAUTH_CLIENT_SECRET?: string;
41	  OAUTH_SCOPES: string;
42	  OAUTH_AUTHORIZATION_URL?: string;
43	  OAUTH_TOKEN_URL?: string;
44	  OAUTH_REVOCATION_URL?: string;
45	  OAUTH_REDIRECT_URI: string;
46	  OAUTH_REDIRECT_ALLOWLIST: string[];
47	  OAUTH_REDIRECT_ALLOW_ALL: boolean;
48	  // Extra params for authorization URL (e.g., "access_type=offline&prompt=consent" for Google)
49	  OAUTH_EXTRA_AUTH_PARAMS?: string;
50	
51	  // Provider-specific (example: add your own like GITHUB_CLIENT_ID, LINEAR_API_KEY, etc.)
52	  PROVIDER_CLIENT_ID?: string;
53	  PROVIDER_CLIENT_SECRET?: string;
54	  PROVIDER_API_URL?: string;
55	  PROVIDER_ACCOUNTS_URL?: string;
56	
57	  // Storage
58	  RS_TOKENS_FILE?: string;
59	  /** Base64url-encoded 32-byte key for encrypting tokens at rest */
60	  RS_TOKENS_ENC_KEY?: string;
61	
62	  // Rate limiting
63	  RPS_LIMIT: number;
64	  CONCURRENCY_LIMIT: number;
65	
66	  // Logging
67	  LOG_LEVEL: 'debug' | 'info' | 'warning' | 'error';
68	};
69	
70	function parseBoolean(value: unknown): boolean {
71	  return String(value || 'false').toLowerCase() === 'true';
72	}
73	
74	function parseNumber(value: unknown, defaultValue: number): number {
75	  const num = Number(value);
76	  return Number.isFinite(num) ? num : defaultValue;
77	}
78	
79	function parseStringArray(value: unknown): string[] {
80	  return String(value || '')
81	    .split(',')
82	    .map((s) => s.trim())
83	    .filter(Boolean);
84	}
85	
86	/**
87	 * Determine auth strategy from env.
88	 * Priority: AUTH_STRATEGY > AUTH_ENABLED > default
89	 */
90	function parseAuthStrategy(env: Record<string, unknown>): AuthStrategyType {
91	  const explicit = (env.AUTH_STRATEGY as string)?.toLowerCase();
92	  if (explicit && ['oauth', 'bearer', 'api_key', 'custom', 'none'].includes(explicit)) {
93	    return explicit as AuthStrategyType;
94	  }
95	
96	  // Fallback: if AUTH_ENABLED is true, default to OAuth
97	  if (parseBoolean(env.AUTH_ENABLED)) {
98	    return 'oauth';
99	  }
100	
101	  // Check if API_KEY is set → default to api_key
102	  if (env.API_KEY) {
103	    return 'api_key';
104	  }
105	
106	  // Check if BEARER_TOKEN is set → default to bearer
107	  if (env.BEARER_TOKEN) {
108	    return 'bearer';
109	  }
110	
111	  return 'none';
112	}
113	
114	/**
115	 * Parse environment variables into a unified config object
116	 * Works for both process.env (Node.js) and Workers env bindings
117	 */
118	export function parseConfig(env: Record<string, unknown>): UnifiedConfig {
119	  const authStrategy = parseAuthStrategy(env);
120	
121	  return {
122	    HOST: String(env.HOST || '127.0.0.1'),
123	    PORT: parseNumber(env.PORT, 3000),
124	    NODE_ENV: (env.NODE_ENV as UnifiedConfig['NODE_ENV']) || 'development',
125	
126	    MCP_TITLE: String(env.MCP_TITLE || 'MCP Server Template'),
127	    MCP_INSTRUCTIONS: String(
128	      env.MCP_INSTRUCTIONS ||
129	        'Use these tools responsibly. Prefer minimal scopes and small page sizes.',
130	    ),
131	    MCP_VERSION: String(env.MCP_VERSION || '0.1.0'),
132	    MCP_PROTOCOL_VERSION: String(env.MCP_PROTOCOL_VERSION || '2025-06-18'),
133	    MCP_ACCEPT_HEADERS: parseStringArray(env.MCP_ACCEPT_HEADERS),
134	
135	    // Auth Strategy
136	    AUTH_STRATEGY: authStrategy,
137	    AUTH_ENABLED: authStrategy === 'oauth' || parseBoolean(env.AUTH_ENABLED),
138	    AUTH_REQUIRE_RS: parseBoolean(env.AUTH_REQUIRE_RS),
139	    AUTH_ALLOW_DIRECT_BEARER: parseBoolean(env.AUTH_ALLOW_DIRECT_BEARER),
140	    AUTH_RESOURCE_URI: env.AUTH_RESOURCE_URI as string | undefined,
141	    AUTH_DISCOVERY_URL: env.AUTH_DISCOVERY_URL as string | undefined,
142	
143	    // API Key auth
144	    API_KEY: env.API_KEY as string | undefined,
145	    API_KEY_HEADER: String(env.API_KEY_HEADER || 'x-api-key'),
146	
147	    // Bearer token auth
148	    BEARER_TOKEN: env.BEARER_TOKEN as string | undefined,
149	
150	    // Custom headers
151	    CUSTOM_HEADERS: env.CUSTOM_HEADERS as string | undefined,
152	
153	    // OAuth
154	    OAUTH_CLIENT_ID: env.OAUTH_CLIENT_ID as string | undefined,
155	    OAUTH_CLIENT_SECRET: env.OAUTH_CLIENT_SECRET as string | undefined,
156	    OAUTH_SCOPES: String(env.OAUTH_SCOPES || ''),
157	    OAUTH_AUTHORIZATION_URL: env.OAUTH_AUTHORIZATION_URL as string | undefined,
158	    OAUTH_TOKEN_URL: env.OAUTH_TOKEN_URL as string | undefined,
159	    OAUTH_REVOCATION_URL: env.OAUTH_REVOCATION_URL as string | undefined,
160	    OAUTH_REDIRECT_URI: String(
161	      env.OAUTH_REDIRECT_URI || 'http://localhost:3000/callback',
162	    ),
163	    OAUTH_REDIRECT_ALLOWLIST: parseStringArray(env.OAUTH_REDIRECT_ALLOWLIST),
164	    OAUTH_REDIRECT_ALLOW_ALL: parseBoolean(env.OAUTH_REDIRECT_ALLOW_ALL),
165	    OAUTH_EXTRA_AUTH_PARAMS: env.OAUTH_EXTRA_AUTH_PARAMS as string | undefined,
166	
167	    PROVIDER_CLIENT_ID: (env.PROVIDER_CLIENT_ID as string | undefined)?.trim(),
168	    PROVIDER_CLIENT_SECRET: (env.PROVIDER_CLIENT_SECRET as string | undefined)?.trim(),
169	    PROVIDER_API_URL: env.PROVIDER_API_URL as string | undefined,
170	    PROVIDER_ACCOUNTS_URL: env.PROVIDER_ACCOUNTS_URL as string | undefined,
171	
172	    RS_TOKENS_FILE: env.RS_TOKENS_FILE as string | undefined,
173	    RS_TOKENS_ENC_KEY: env.RS_TOKENS_ENC_KEY as string | undefined,
174	
175	    RPS_LIMIT: parseNumber(env.RPS_LIMIT, 10),
176	    CONCURRENCY_LIMIT: parseNumber(env.CONCURRENCY_LIMIT, 5),
177	
178	    LOG_LEVEL: (env.LOG_LEVEL as UnifiedConfig['LOG_LEVEL']) || 'info',
179	  };
180	}
181	
182	export function resolveConfig(): UnifiedConfig {
183	  return parseConfig(process.env as Record<string, unknown>);
184	}
