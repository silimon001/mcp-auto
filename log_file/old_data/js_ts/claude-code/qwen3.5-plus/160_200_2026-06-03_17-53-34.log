21	export default class McpProvider {
22	  constructor(protected app: ApplicationService) {}
23	
24	  register() {
25	    this.app.container.singleton('jrmc.mcp', async () => {
26	      const config = this.app.config.get<McpConfig>('mcp', {})
27	      const logger = await this.app.container.make('logger')
28	      const emitter = await this.app.container.make('emitter')
29	
30	      return new McpServer(config, { logger, emitter })
