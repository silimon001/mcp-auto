176	    console.log('');
177	    let apiKey = await question('Enter your Readwise API key: ');
178	    while (!apiKey) {
179	        console.log('API key is required.');
180	        apiKey = await question('Enter your Readwise API key: ');
181	    }
182	    try {
183	        // Test the API key by making a request to the Readwise API
184	        console.log('Validating API key...');
185	        const client = new ReadwiseClient({ apiKey });
186	        const api = new ReadwiseAPI(client);
187	        try {
188	            // Attempt to fetch a single book to verify API key works
189	            await api.getBooks({ page: 1, page_size: 1 });
190	            console.log('API key validated successfully.');
191	        }
192	        catch (error) {
193	            if (error instanceof Error && error.message.includes('401')) {
194	                console.error('Error: Invalid API key. Please check your API key and try again.');
195	                rl.close();
196	                return runSetupWizard(); // Restart the setup wizard
197	            }
