1	import { parse } from 'node:querystring';
2	
3	import { Actor } from 'apify';
4	import type { ProxyConfiguration, RequestOptions } from 'crawlee';
5	import { log } from 'crawlee';
6	
7	import inputSchema from '../.actor/input_schema.json' with { type: 'json' };
8	import type { ContentCrawlerUserData,
9	    ContentScraperSettings,
10	    CreateSearchRequestUserData,
11	    Input,
12	    OrganicResult, OutputFormats,
13	    SearchCrawlerUserData,
14	    TimeMeasure } from './types.js';
15	
16	export function isActorStandby(): boolean {
17	    return Actor.getEnv().metaOrigin === 'STANDBY';
18	}
19	
20	/**
21	 * Parse the query parameters from the URL
22	 */
23	export function parseParameters(url: string): Partial<Input> {
24	    const params = parse(url.slice(1));
25	
26	    type SchemaKey = keyof typeof inputSchema.properties;
27	
28	    const parsedInput: Partial<Input> = {};
29	    for (const [key, value] of Object.entries(params)) {
30	        // If the value is undefined skip it
31	        if (value === undefined) continue;
32	
33	        // If the key is not supported by schema or is not Apify API token, skip it
34	        if (key !== 'token' && !Object.keys(inputSchema.properties).includes(key)) {
35	            log.warning(`Unknown parameter: ${key}. Supported parameters: ${Object.keys(inputSchema.properties).join(', ')}`);
36	            continue;
37	        }
38	
39	        const typedKey = key as SchemaKey;
40	
41	        // Parse outputFormats parameter as an array of OutputFormats
42	        if (typedKey === 'outputFormats' && typeof value === 'string') {
43	            parsedInput[typedKey] = value.split(',').map((format) => format.trim()) as OutputFormats[];
44	        }
45	
46	        // Parse non-primitive parameters following input schema because querystring doesn't parse objects
47	        if (
48	            !!inputSchema.properties[typedKey]
49	            && ['object', 'array'].includes(inputSchema.properties[typedKey].type)
50	            && typeof value === 'string'
51	        ) {
52	            try {
53	                parsedInput[typedKey] = JSON.parse(value);
54	                log.debug(`Parsed parameter ${key} from string: ${value} to object`, parsedInput[typedKey] as object);
55	            } catch (e) {
56	                log.warning(`Failed to parse parameter ${key}, it must be valid JSON. Skipping it: ${e}`);
57	            }
58	        } else {
59	            // eslint-disable-next-line @typescript-eslint/ban-ts-comment
60	            // @ts-expect-error
61	            parsedInput[typedKey] = value;
62	        }
63	    }
64	
65	    return parsedInput;
66	}
67	
68	export function randomId() {
69	    let result = '';
70	    const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
71	    for (let counter = 0; counter < 10; counter++) {
72	        result += characters.charAt(Math.floor(Math.random() * characters.length));
73	    }
74	    return result;
75	}
76	
77	/**
78	 * Create a search request with the provided query and maxResults.
79	 * The maxResults parameter is passed to the UserData object, when the request is handled it is used to limit
80	 * the number of search results retrieved through pagination.
81	 *
82	 * Also add the contentCrawlerKey to the UserData object to be able to identify which content crawler should
83	 * handle the crawling.
84	 *
85	 * Supports pagination via startOffset parameter for fetching additional pages.
86	 * Note: Google ignores the ?num parameter and returns at most 10 results per page.
87	 * We use the ?start parameter for pagination to retrieve results across multiple pages.
88	 * We add +1 to the calculated totalPages to account for pages that return fewer than 10 results.
89	 */
90	export function createSearchRequest(
91	    userData: CreateSearchRequestUserData,
92	    proxyConfiguration: ProxyConfiguration | undefined,
93	    startOffset = 0,
94	): RequestOptions<SearchCrawlerUserData> {
95	    // Initialize or update pagination fields
96	    const collectedResults = userData.collectedResults || [];
97	    const currentPage = userData.currentPage ?? 0;
98	    const totalPages = userData.totalPages ?? Math.ceil(userData.maxResults / 10) + 1;
99	
100	    // @ts-expect-error is there a better way to get group information?
101	    // (e.g. to  create extended CheerioCrawlOptions and pass it there?)
102	    const groups = proxyConfiguration?.groups || [];
103	    const protocol = groups.includes('GOOGLE_SERP') ? 'http' : 'https';
104	    const urlSearch = startOffset > 0
105	        ? `${protocol}://www.google.com/search?q=${encodeURI(userData.query)}&start=${startOffset}`
106	        : `${protocol}://www.google.com/search?q=${encodeURI(userData.query)}`;
107	    return {
108	        url: urlSearch,
109	        uniqueKey: randomId(),
110	        userData: {
111	            maxResults: userData.maxResults,
112	            timeMeasures: userData.timeMeasures || [],
113	            query: userData.query,
114	            contentCrawlerKey: userData.contentCrawlerKey,
115	            contentScraperSettings: userData.contentScraperSettings,
116	            responseId: userData.responseId,
117	            collectedResults,
118	            currentPage,
119	            totalPages,
120	        },
121	    };
122	}
123	
124	/**
125	 * Create a request for content crawler with the provided query, result, responseId and timeMeasures.
126	 */
127	export function createRequest(
128	    query: string,
129	    result: OrganicResult,
130	    responseId: string,
131	    contentScraperSettings: ContentScraperSettings,
132	    timeMeasures: TimeMeasure[] | null = null,
133	): RequestOptions<ContentCrawlerUserData> {
134	    return {
135	        url: result.url!,
136	        uniqueKey: randomId(),
137	        userData: {
138	            query,
139	            responseId,
140	            searchResult: result.url && result.title ? result : undefined,
141	            timeMeasures: timeMeasures ? [...timeMeasures] : [],
142	            contentScraperSettings,
143	        },
144	    };
145	}
146	
147	export function addTimeMeasureEvent(userData: ContentCrawlerUserData, event: TimeMeasure['event'], time: number | null = null) {
148	    /* eslint-disable no-param-reassign */
149	    let timePrev = 0;
150	    if (!userData.timeMeasures?.length) {
151	        userData.timeMeasures = [];
152	    } else {
153	        timePrev = userData.timeMeasures[userData.timeMeasures.length - 1].timeMs;
154	    }
155	    time = time ?? Date.now();
156	    userData.timeMeasures.push({ event, timeMs: time, timeDeltaPrevMs: timePrev ? time - timePrev : 0 });
157	    /* eslint-enable no-param-reassign */
158	}
159	
160	export function transformTimeMeasuresToRelative(timeMeasures: TimeMeasure[]): TimeMeasure[] {
161	    const firstMeasure = timeMeasures[0].timeMs;
162	    return timeMeasures
163	        .map((measure) => {
164	            return {
165	                event: measure.event,
166	                timeMs: measure.timeMs - firstMeasure,
167	                timeDeltaPrevMs: measure.timeDeltaPrevMs,
168	            };
169	        })
170	        .sort((a, b) => a.timeMs - b.timeMs);
171	}
172	
173	/**
174	 * Interpret the input as a URL (valid URL starts with http:// or https://).
175	 * If the input is a URL, return it; otherwise, try to decode it and check if it's a valid URL.
176	 * Attempt to decode the input string up to 3 times, as users may encode the URL multiple times.
177	 * @param input - The input string to interpret as a URL.
178	 * @returns The valid URL string or null if invalid.
179	 */
180	export function interpretAsUrl(input: string): string | null {
181	    if (!input) return null;
182	
183	    function tryValid(s: string): string | null {
184	        try {
185	            const url = new URL(s);
186	            return /^https?:/i.test(url.protocol) ? url.href : null;
187	        } catch {
188	            return null;
189	        }
190	    }
191	
192	    let candidate = input;
193	    for (let i = 0; i < 3; i++) {
194	        const result = tryValid(candidate);
195	        if (result) return result;
196	        try {
197	            candidate = decodeURIComponent(candidate);
198	        } catch {
199	            break;
200	        }
201	    }
202	    return null;
203	}
