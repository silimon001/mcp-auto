  "content": "const http = require('http');\n\nconst MOCK_PORT = 34891;\n\nconst server = http.createServer((req, res) => {\n  const url = req.url;\n\n  res.setHeader('Content-Type', 'application/json');\n\n  // Token endpoint\n  if (url === '/umbraco/management/api/v1/security/back-office/token' && req.method === 'POST') {\n    let body = '';\n    req.on('data', chunk => body += chunk);\n    req.on('end', () => {\n      res.writeHead(200);\n      res.end(JSON.stringify({\n        access_token: 'mock-access-token',\n        expires_in: 3600,\n        token_type: 'Bearer'\n      }));\n    });\n    return;\n  }\n\n  // Current user endpoint\n  if (url === '/umbraco/management/api/v1/user/current' && req.method === 'GET') {\n    res.writeHead(200);\n    res.end(JSON.stringify({\n      id: '1',\n      userName: 'mock-admin',\n      email: 'admin@localhost',\n      isLockedOut: false,\n      createDate: '2024-01-01T00:00:00Z',\n      lastLoginDate: '2024-01-01T00:00:00Z',\n      lastPasswordChangeDate: '2024-01-01T00:00:00Z',\n      culture: 'en-US',\n      startStructure: 'content',\n      startMediaId: null,\n      avatar: null,\n      defaultAvatar: null,\n      tourData: {},\n      allTenantIds: [],\n      userDataEntryCulture: null\n    }));\n    return;\n  }\n\n  // Default: return 404\n  res.writeHead(404);\n  res.end(JSON.stringify({ error: 'Not found' }));\n});\n\nserver.listen(MOCK_PORT, () => {\n  console.error(`Mock Umbraco API server running on port ${MOCK_PORT}`);\n});\n"
}
