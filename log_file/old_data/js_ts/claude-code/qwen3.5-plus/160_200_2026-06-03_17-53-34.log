1	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
2	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
3	import { z } from "zod";
4	import fetch from "node-fetch";
5	import dotenv from "dotenv";
6	dotenv.config();
7	
8	const GAMMA_API_URL = "https://api.gamma.app/public-api/v0.1/generate";
9	const GAMMA_API_KEY = process.env.GAMMA_API_KEY;
10	
11	// Helper function for making Gamma API requests
12	async function generatePresentation(
13	  params: Record<string, any>
14	): Promise<{ url: string | null; error: string | null }> {
15	  try {
16	    const response = await fetch(GAMMA_API_URL, {
17	      method: "POST",
18	      headers: {
19	        "Content-Type": "application/json",
20	        "X-API-KEY": GAMMA_API_KEY || "",
21	      },
22	      body: JSON.stringify(params),
23	    });
24	    if (!response.ok) {
25	      const errorText = await response.text();
26	      throw new Error(
27	        `HTTP error! status: ${response.status}, body: ${errorText}`
28	      );
29	    }
30	    const data = (await response.json()) as { url?: string };
31	    return { url: data.url || null, error: null };
32	  } catch (error: any) {
33	    console.error("Error making Gamma API request:", error);
34	    return { url: null, error: error.message || String(error) };
35	  }
36	}
37	
38	// Create server instance
39	const server = new McpServer({
40	  name: "gamma-presentation",
41	  version: "1.0.0",
42	  capabilities: {
43	    resources: {},
44	    tools: {},
45	  },
46	});
47	
48	// Register Gamma generation tool
49	server.tool(
50	  "generate-presentation",
51	  "Generate a presentation using the Gamma API. The response will include a link to the generated presentation in the 'text' field. Always include the link in the response when it's available. Do your best to show a preview or a link preview or some sense of the content to the user in the response.",
52	  {
53	    inputText: z.string().describe("The topic or prompt for the presentation."),
54	    tone: z
55	      .string()
56	      .optional()
57	      .describe(
58	        "The tone of the presentation (e.g. 'humorous and sarcastic')."
59	      ),
60	    audience: z
61	      .string()
62	      .optional()
63	      .describe("The intended audience (e.g. 'students')."),
64	    textAmount: z
65	      .enum(["short", "medium", "long"])
66	      .optional()
67	      .describe("How much text to generate."),
68	    textMode: z
69	      .enum(["generate", "summarize"])
70	      .optional()
71	      .describe("Text mode for Gamma API."),
72	    numCards: z
73	      .number()
74	      .min(1)
75	      .max(20)
76	      .optional()
77	      .describe("Number of slides/cards to generate."),
78	    imageModel: z
79	      .string()
80	      .optional()
81	      .describe("Image model to use (e.g. 'dall-e-3')."),
82	    imageStyle: z
83	      .string()
84	      .optional()
85	      .describe("Image style (e.g. 'line drawings')."),
86	    editorMode: z
87	      .string()
88	      .optional()
89	      .describe("Editor mode (e.g. 'freeform')."),
90	    additionalInstructions: z
91	      .string()
92	      .optional()
93	      .describe("Any extra instructions for Gamma."),
94	  },
95	  async (params) => {
96	    const { url, error } = await generatePresentation(params);
97	    if (!url) {
98	      return {
99	        content: [
100	          {
101	            type: "text",
102	            text: `Failed to generate presentation using Gamma API. Error: ${
103	              error || "Unknown error."
104	            }`,
105	          },
106	        ],
107	      };
108	    }
109	    return {
110	      content: [
111	        {
112	          type: "text",
113	          text: `Presentation generated! View it here: ${url}`,
114	        },
115	      ],
116	    };
117	  }
118	);
119	
120	async function main() {
121	  const transport = new StdioServerTransport();
122	  await server.connect(transport);
123	  console.error("Gamma MCP Server running on stdio");
124	
125	  // logt the  api key
126	  console.log("Gamma API Key:", GAMMA_API_KEY);
127	}
128	
129	main().catch((error) => {
130	  console.error("Fatal error in main():", error);
131	  process.exit(1);
132	});
