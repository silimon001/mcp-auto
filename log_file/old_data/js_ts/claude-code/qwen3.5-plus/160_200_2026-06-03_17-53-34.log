61	  async registerMethods(type: 'tool' | 'resource' | 'prompt') {
62	    const server = await this.app.container.make('jrmc.mcp')
63	    const mcpPath = this.app.makePath(
64	      this.app.rcFile.directories['mcp'] || 'app/mcp/',
65	      `${string.plural(type)}/`
66	    )
67	    try {
68	      await stat(mcpPath)
69	    } catch {
70	      return
71	    }
72	
73	    const files = await fsReadAll(mcpPath, {
74	      filter: (filePath) =>
75	        !filePath.endsWith('.map') &&
76	        (filePath.includes(`_${type}.ts`) || filePath.includes(`_${type}.js`)),
77	    })
78	
79	    await Promise.all(
80	      files.map(async (file) => {
81	        const path = pathToFileURL(join(mcpPath, file)).href
82	        const { default: Method } = await import(path)
83	        const instance = new Method()
84	        const entry = { path, json: instance.toJson() }
85	
86	        switch (type) {
