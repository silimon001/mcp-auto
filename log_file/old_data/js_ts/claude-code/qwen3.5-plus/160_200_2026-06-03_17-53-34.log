1388	/**
1389	 * List All Protocols Tool
1390	 * Returns a list of protocols that can be used when performing Internet scans
1391	 */
1392	server.tool(
1393	  "list-protocols",
1394	  "List all protocols that can be used for scanning",
1395	  {},
1396	  async () => {
1397	    try {
1398	      const data = await shodanApiRequest<ShodanProtocols>("/shodan/protocols");
1399	      
1400	      let formattedText = "## Available Scanning Protocols\n\n";
1401	      formattedText += "The following protocols can be used for Internet scanning:\n\n";
1402	      
1403	      // Group protocols by category based on common prefixes or purposes
1404	      const categories: { [key: string]: { [protocol: string]: string } } = {
1405	        "Web Protocols": {},
1406	        "Database Protocols": {},
1407	        "Industrial Protocols": {},
1408	        "Remote Access": {},
1409	        "Other": {}
1410	      };
1411	
1412	      for (const [protocol, description] of Object.entries(data)) {
1413	        if (protocol.includes("http") || protocol.includes("ssl")) {
1414	          categories["Web Protocols"][protocol] = description;
1415	        } else if (protocol.includes("sql") || protocol.includes("db")) {
1416	          categories["Database Protocols"][protocol] = description;
1417	        } else if (protocol.includes("ics") || protocol.includes("scada")) {
1418	          categories["Industrial Protocols"][protocol] = description;
1419	        } else if (protocol.includes("ssh") || protocol.includes("telnet") || protocol.includes("rdp")) {
1420	          categories["Remote Access"][protocol] = description;
1421	        } else {
1422	          categories["Other"][protocol] = description;
1423	        }
1424	      }
1425	
1426	      for (const [category, protocols] of Object.entries(categories)) {
1427	        if (Object.keys(protocols).length > 0) {
1428	          formattedText += `### ${category}\n\n`;
1429	          for (const [protocol, description] of Object.entries(protocols)) {
1430	            formattedText += `- **${protocol}**: ${description}\n`;
1431	          }
1432	          formattedText += "\n";
1433	        }
1434	      }
1435	
1436	      return {
1437	        content: [
1438	          {
1439	            type: "text",
1440	            text: formattedText
1441	          }
1442	        ]
1443	      };
1444	    } catch (error) {
1445	      const err = error as Error;
1446	      return {
1447	        content: [
1448	          {
1449	            type: "text",
1450	            text: `Error getting protocols list: ${err.message}`
1451	          }
1452	        ],
1453	        isError: true
1454	      };
1455	    }
1456	  }
1457	);
