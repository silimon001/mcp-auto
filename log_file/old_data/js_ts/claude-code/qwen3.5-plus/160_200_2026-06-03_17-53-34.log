143	        res.status(400).send('Missing required fields');
144	        return;
145	      }
146	      await oauthProvider.handleAuthCallback(pending_id, secret, res);
147	    });
148	
149	    authMiddleware = requireBearerAuth({
150	      verifier: oauthProvider,
151	      requiredScopes: [],
152	      resourceMetadataUrl: getOAuthProtectedResourceMetadataUrl(mcpServerUrl),
153	    });
154	
155	    console.error(`OAuth enabled. Issuer: ${mcpServerUrl}`);
156	  } else {
157	    console.error('Auth disabled (MCP_AUTH=false). WARNING: Server is unprotected.');
158	  }
159	
160	  // Per-session Server+Transport pairs
161	  const sessions = {};
162	
163	  const mcpHandler = async (req, res) => {
164	    const sessionId = req.headers['mcp-session-id'];
165	
166	    try {
167	      if (sessionId && sessions[sessionId]) {
168	        await sessions[sessionId].transport.handleRequest(req, res, req.body);
169	        return;
170	      }
171	
172	      if (!sessionId && isInitializeRequest(req.body)) {
173	        const sid = randomUUID();
174	        const sessionServer = createServer(sid.slice(0, 8));
175	        const sessionTransport = new StreamableHTTPServerTransport({
176	          sessionIdGenerator: () => sid,
177	          onsessioninitialized: (id) => {
178	            sessions[id] = { transport: sessionTransport, server: sessionServer };
179	          },
180	        });
181	        sessionTransport.onclose = () => {
182	          const id = sessionTransport.sessionId;
183	          if (id) delete sessions[id];
184	        };
185	        await sessionServer.connect(sessionTransport);
186	        await sessionTransport.handleRequest(req, res, req.body);
187	        return;
188	      }
189	
190	      res.status(400).json({ error: 'Bad request: missing session ID or not an init request' });
191	    } catch (error) {
192	      console.error('MCP handler error:', error);
193	      if (!res.headersSent) {
194	        res.status(500).json({ error: 'Internal server error' });
195	      }
196	    }
197	  };
198	
199	  if (authMiddleware) {
200	    app.post('/mcp', authMiddleware, mcpHandler);
201	    app.get('/mcp', authMiddleware, mcpHandler);
202	    app.delete('/mcp', authMiddleware, mcpHandler);
203	  } else {
204	    app.post('/mcp', mcpHandler);
205	    app.get('/mcp', mcpHandler);
206	    app.delete('/mcp', mcpHandler);
207	  }
208	
209	  // Log active session count periodically
210	  setInterval(() => {
211	    const count = Object.keys(sessions).length;
212	    if (count > 0) console.error(`Active MCP sessions: ${count}`);
213	  }, 60000);
214	
215	  app.listen(port, () => {
216	    console.error(`JW MCP server listening on http://0.0.0.0:${port}`);
217	    console.error(`Health: http://0.0.0.0:${port}/health`);
218	    console.error(`MCP: ${baseUrl}/mcp`);
219	    if (useAuth) {
220	      console.error(`OAuth metadata: ${baseUrl}/.well-known/oauth-authorization-server`);
221	    }
222	  });
223	
224	  const shutdown = () => {
225	    for (const s of Object.values(sessions)) {
226	      s.transport.close();
227	    }
228	    process.exit(0);
229	  };
230	  process.on('SIGINT', shutdown);
231	  process.on('SIGTERM', shutdown);
232	
233	} else {
234	  // Default: stdio transport
235	  const { StdioServerTransport } = await import(
236	    '@modelcontextprotocol/sdk/server/stdio.js'
237	  );
238	
239	  const server = createServer();
240	  const stdioTransport = new StdioServerTransport();
241	  await server.connect(stdioTransport);
242	  console.error('JW MCP Server running on stdio');
243	
244	  const shutdown = async () => {
245	    await server.close();
246	    process.exit(0);
247	  };
248	  process.on('SIGINT', shutdown);
249	  process.on('SIGTERM', shutdown);
250	}
