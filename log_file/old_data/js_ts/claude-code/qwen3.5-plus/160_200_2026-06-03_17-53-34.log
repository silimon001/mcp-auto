51	  constructor(serviceName: string = KEYCHAIN_SERVICE_NAME) {
52	    this.serviceName = serviceName;
53	  }
54	
55	  /**
56	   * Store the Auth0 access token in the keychain
57	   * @param token - The access token to store
58	   * @returns A promise that resolves to true if successful, false otherwise
59	   */
60	  async setToken(token: string): Promise<boolean> {
61	    return this.set(KeychainItem.TOKEN, token);
