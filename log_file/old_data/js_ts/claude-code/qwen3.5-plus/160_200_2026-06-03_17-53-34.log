210	        console.log('  readwise-mcp');
211	        console.log('');
212	    }
213	    catch (error) {
214	        console.error('Error saving configuration:', error instanceof Error ? error.message : String(error));
215	    }
216	    finally {
217	        rl.close();
218	    }
219	    return apiKey;
