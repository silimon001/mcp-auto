28	export const composeWwwAuthenticate = (resourceMetadataUrl: string) =>
29	  `Bearer realm="mcp", resource_metadata="${resourceMetadataUrl}"`;
30	
31	export const validateBearer = (headers: Headers): string | null => {
32	  const auth = headers.get('Authorization') || headers.get('authorization');
33	  if (!auth || !auth.startsWith('Bearer ')) return null;
34	  return auth.slice('Bearer '.length).trim();
35	};
36	
37	export const requireBearerOr401 = (
38	  c: Context,
39	  resourceMetadataUrl: string,
40	): string | Response => {
41	  const token = validateBearer(c.req.raw.headers);
42	  if (!token) {
43	    c.header('WWW-Authenticate', composeWwwAuthenticate(resourceMetadataUrl));
44	    return c.json(
45	      {
46	        jsonrpc: '2.0',
47	        error: { code: -32000, message: 'Unauthorized' },
48	        id: null,
49	      },
50	      401,
51	    );
52	  }
53	  return token;
54	};
