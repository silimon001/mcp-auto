1	// MCP routes for Hono
2	// Simplified provider-agnostic version from Spotify MCP
3	
4	import { randomUUID } from 'node:crypto';
5	import type { HttpBindings } from '@hono/node-server';
6	import type { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
7	import { StreamableHTTPServerTransport } from '@modelcontextprotocol/sdk/server/streamableHttp.js';
8	import { toFetchResponse, toReqRes } from 'fetch-to-node';
9	import { Hono } from 'hono';
10	import { authContextStorage, contextRegistry } from '../../core/context.js';
11	import type { RequestContext } from '../../types/context.js';
12	import { createCancellationToken } from '../../utils/cancellation.js';
13	import { logger } from '../../utils/logger.js';
14	
15	export function buildMcpRoutes(params: {
16	  server: McpServer;
17	  transports: Map<string, StreamableHTTPServerTransport>;
18	}) {
19	  const { server, transports } = params;
20	  const app = new Hono<{ Bindings: HttpBindings }>();
21	
22	  // Track which transports have been connected to avoid duplicate connect() calls
23	  const connectedTransports = new WeakSet<StreamableHTTPServerTransport>();
24	
25	  const MCP_SESSION_HEADER = 'Mcp-Session-Id';
26	
27	  /**
28	   * Connect transport to server only if not already connected.
29	   * McpServer.connect() should be called once per transport lifecycle.
30	   */
31	  async function ensureConnected(
32	    transport: StreamableHTTPServerTransport,
33	  ): Promise<void> {
34	    if (!connectedTransports.has(transport)) {
35	      await server.connect(transport);
36	      connectedTransports.add(transport);
37	    }
38	  }
39	
40	  app.post('/', async (c) => {
41	    const { req, res } = toReqRes(c.req.raw);
42	
43	    try {
44	      const sessionIdHeader = c.req.header(MCP_SESSION_HEADER) ?? undefined;
45	      let body: unknown;
46	      try {
47	        body = await c.req.json();
48	      } catch {
49	        body = undefined;
50	      }
51	
52	      const isInitialize = Boolean(
53	        body && (body as { method?: string }).method === 'initialize',
54	      );
55	
56	      const plannedSid = isInitialize ? sessionIdHeader || randomUUID() : undefined;
57	
58	      void logger.info('mcp_request', {
59	        message: 'Processing MCP request',
60	        sessionId: plannedSid || sessionIdHeader,
61	        isInitialize,
62	        hasSessionIdHeader: !!sessionIdHeader,
