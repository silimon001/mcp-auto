36	import { SearchByTagTool } from './tools/search-by-tag.js';
37	import { SearchByDateTool } from './tools/search-by-date.js';
38	import { GetVideosTool } from './tools/get-videos.js';
39	import { GetVideoTool } from './tools/get-video.js';
40	import { CreateVideoHighlightTool } from './tools/create-video-highlight.js';
41	import { GetVideoHighlightsTool } from './tools/get-video-highlights.js';
42	import { UpdateVideoPositionTool } from './tools/update-video-position.js';
43	import { GetVideoPositionTool } from './tools/get-video-position.js';
44	import { SaveDocumentTool } from './tools/save-document.js';
45	import { UpdateDocumentTool } from './tools/update-document.js';
46	import { DeleteDocumentTool } from './tools/delete-document.js';
47	import { GetRecentContentTool } from './tools/get-recent-content.js';
48	import { BulkSaveDocumentsTool } from './tools/bulk-save-documents.js';
49	import { BulkUpdateDocumentsTool } from './tools/bulk-update-documents.js';
50	import { BulkDeleteDocumentsTool } from './tools/bulk-delete-documents.js';
51	// Prompt imports - need .js extension
52	import { ReadwiseHighlightPrompt } from './prompts/highlight-prompt.js';
53	import { ReadwiseSearchPrompt } from './prompts/search-prompt.js';
54	/**
55	 * Readwise MCP Server implementation
56	 */
57	export class ReadwiseMCPServer {
58	    app;
59	    server;
60	    mcpServer;
61	    port;
62	    apiClient;
63	    api;
64	    toolRegistry;
65	    promptRegistry;
66	    logger;
67	    transportType;
68	    startTime;
69	    isReady = false;
70	    /**
71	     * Create a new Readwise MCP server
72	     * @param apiKey - Readwise API key
73	     * @param port - Port to listen on (default: 3000)
74	     * @param logger - Logger instance
75	     * @param transport - Transport type (default: stdio)
76	     */
77	    constructor(apiKey = '', port = 3000, logger, transport = 'stdio', baseUrl) {
78	        // Assign logger first so it's available in error handling
79	        this.logger = logger;
80	        try {
81	            // Check if running under MCP Inspector
82	            const isMCPInspector = process.env.MCP_INSPECTOR === 'true' ||
83	                process.argv.includes('--mcp-inspector') ||
84	                process.env.NODE_ENV === 'mcp-inspector';
85	            // When running under inspector:
86	            // - Use port 3000 (required for inspector's proxy)
87	            // - Force SSE transport
88	            this.port = isMCPInspector ? 3000 : port;
89	            this.transportType = isMCPInspector ? 'sse' : transport;
90	            this.startTime = Date.now();
91	            // Initialize API client (allow empty API key for lazy loading)
92	            // API key will be validated when tools are actually called
93	            this.apiClient = new ReadwiseClient({
94	                apiKey: apiKey || '',
95	                baseUrl
96	            });
97	            this.api = new ReadwiseAPI(this.apiClient);
98	            // Initialize registries
99	            this.toolRegistry = new ToolRegistry(this.logger);
100	            this.promptRegistry = new PromptRegistry(this.logger);
101	            // Initialize Express app
102	            this.app = express();
103	            this.app.use(bodyParser.json());
104	            // Configure CORS - allow all origins for Smithery and other hosted deployments
105	            // In production, you can restrict this via CORS_ALLOWED_ORIGINS environment variable
106	            const corsEnabled = process.env.CORS_ENABLED !== 'false';
107	            const allowedOrigins = process.env.CORS_ALLOWED_ORIGINS
108	                ? process.env.CORS_ALLOWED_ORIGINS.split(',').map(o => o.trim())
109	                : null; // null means allow all origins
110	            if (corsEnabled) {
111	                // Configure CORS according to Smithery requirements
112	                // See: https://smithery.ai/docs/build/deployments/containers#how-do-i-set-up-cors-handling
113	                this.app.use(cors({
114	                    origin: (origin, callback) => {
115	                        // Allow requests with no origin (like mobile apps, curl, or health checks)
116	                        if (!origin)
117	                            return callback(null, true);
118	                        // If no specific origins configured, allow all (for Smithery and hosted deployments)
119	                        if (!allowedOrigins) {
120	                            return callback(null, true);
121	                        }
122	                        if (allowedOrigins.includes(origin) || allowedOrigins.includes('*')) {
123	                            callback(null, true);
124	                        }
125	                        else {
126	                            callback(new Error('Not allowed by CORS'));
127	                        }
128	                    },
129	                    methods: ['GET', 'POST', 'OPTIONS'],
130	                    allowedHeaders: ['Content-Type', 'Authorization', '*'], // Allow all headers as per Smithery docs
131	                    exposedHeaders: ['mcp-session-id', 'mcp-protocol-version'], // Expose MCP-specific headers
132	                    credentials: true
133	                }));
134	            }
135	            this.server = createServer(this.app);
136	            // Register tools and prompts BEFORE creating MCP Server
137	            // so capabilities can be properly initialized
138	            this.registerTools();
139	            this.registerPrompts();
140	            // Initialize MCP Server with actual capabilities
141	            this.mcpServer = new MCPServer({
142	                name: packageJson.name,
143	                version: packageJson.version
144	            }, {
145	                capabilities: {
146	                    tools: this.toolRegistry.getNames().reduce((acc, name) => ({ ...acc, [name]: true }), {}),
147	                    prompts: this.promptRegistry.getNames().reduce((acc, name) => ({ ...acc, [name]: true }), {})
148	                }
149	            });
150	            // Register tools with SDK ServerTools plugin so they are properly exposed
151	            this.registerToolsWithSDK();
152	            // Set up routes BEFORE starting the server
153	            this.setupRoutes();
154	            // Set up SSE transport routes BEFORE starting the server
155	            // (SSE endpoint setup happens here, actual transport connection happens on /sse request)
156	            this.setupSSERoutes();
157	            this.logger.debug('Server constructor completed successfully');
158	        }
159	        catch (error) {
160	            this.logger.error('Error in server constructor:', error);
161	            // Re-throw to prevent server from starting in an invalid state
162	            throw error;
163	        }
164	    }
165	    /**
166	     * Register MCP tools
167	     */
168	    registerTools() {
169	        this.logger.debug('Registering tools');
170	        // All tool classes - instantiate and register in one pass
171	        const toolClasses = [
172	            // Core tools
173	            GetHighlightsTool,
174	            GetBooksTool,
175	            GetDocumentsTool,
176	            SearchHighlightsTool,
177	            GetTagsTool,
178	            DocumentTagsTool,
179	            BulkTagsTool,
180	            GetReadingProgressTool,
181	            UpdateReadingProgressTool,
182	            GetReadingListTool,
183	            // Highlight management
184	            CreateHighlightTool,
185	            UpdateHighlightTool,
186	            DeleteHighlightTool,
187	            CreateNoteTool,
188	            // Search tools
189	            AdvancedSearchTool,
190	            SearchByTagTool,
191	            SearchByDateTool,
192	            // Video tools
193	            GetVideosTool,
194	            GetVideoTool,
195	            CreateVideoHighlightTool,
196	            GetVideoHighlightsTool,
197	            UpdateVideoPositionTool,
198	            GetVideoPositionTool,
199	            // Document management tools
200	            SaveDocumentTool,
201	            UpdateDocumentTool,
202	            DeleteDocumentTool,
203	            GetRecentContentTool,
204	            // Bulk document operation tools
205	            BulkSaveDocumentsTool,
206	            BulkUpdateDocumentsTool,
207	            BulkDeleteDocumentsTool,
208	        ];
209	        // Instantiate and register all tools
210	        for (const ToolClass of toolClasses) {
211	            this.toolRegistry.register(new ToolClass(this.api, this.logger));
212	        }
213	        this.logger.info(`Registered ${this.toolRegistry.getNames().length} tools`);
214	    }
215	    /**
216	     * Register MCP prompts
217	     */
218	    registerPrompts() {
219	        this.logger.debug('Registering prompts');
220	        // Create prompts
221	        const highlightPrompt = new ReadwiseHighlightPrompt(this.api, this.logger);
222	        const searchPrompt = new ReadwiseSearchPrompt(this.api, this.logger);
223	        // Register prompts
224	        this.promptRegistry.register(highlightPrompt);
225	        this.promptRegistry.register(searchPrompt);
226	        this.logger.info(`Registered ${this.promptRegistry.getNames().length} prompts`);
227	    }
228	    /**
229	     * Set up SDK request handlers for tool execution
230	     * Tools are discovered via capabilities, SDK routes calls to our handlers
231	     */
232	    registerToolsWithSDK() {
233	        try {
234	            this.logger.debug('Setting up SDK request handlers for tools');
235	            // Set up request handler for tools/list
236	            this.mcpServer.setRequestHandler(ListToolsRequestSchema, async () => {
237	                const tools = this.toolRegistry.getNames().map(toolName => {
238	                    const tool = this.toolRegistry.get(toolName);
239	                    return {
240	                        name: tool?.name || toolName,
241	                        description: tool?.description || '',
242	                        inputSchema: tool?.parameters || {}
243	                    };
244	                });
245	                return { tools };
246	            });
247	            // Set up request handler for tools/call
248	            this.mcpServer.setRequestHandler(CallToolRequestSchema, async (request) => {
249	                const { name, arguments: args } = request.params;
250	                this.logger.debug(`SDK tool call received: ${name}`, { args });
251	                // Get the tool from our registry
252	                const tool = this.toolRegistry.get(name);
253	                if (!tool) {
254	                    throw new Error(`Tool not found: ${name}`);
255	                }
256	                // Execute the tool using our existing implementation
257	                const result = await tool.execute(args || {});
258	                return result;
259	            });
260	            this.logger.info(`Set up SDK request handlers for ${this.toolRegistry.getNames().length} tools`);
261	        }
262	        catch (error) {
263	            this.logger.error('Error setting up SDK request handlers:', error);
264	            // Don't throw - allow server to continue even if handler setup fails
265	            // Tools will still work through our custom handleMCPRequest method
266	        }
267	    }
268	    /**
269	     * Start the server
270	     */
271	    async start() {
272	        return new Promise((resolve, reject) => {
273	            this.logger.info('Starting HTTP server...');
274	            this.logger.info(`Binding to 0.0.0.0:${this.port}`);
275	            this.logger.debug('Routes are already set up in constructor');
276	            // Handle server errors BEFORE listening
277	            this.server.on('error', (error) => {
278	                this.logger.error('Server error event:', error);
279	                this.logger.error('Error code:', error.code);
280	                this.logger.error('Error message:', error.message);
281	                if (error.code === 'EADDRINUSE') {
282	                    reject(new Error(`Port ${this.port} is already in use`));
283	                }
284	                else {
285	                    reject(error);
286	                }
287	            });
288	            // Log when server starts listening
289	            this.server.listen(this.port, '0.0.0.0', () => {
290	                const address = this.server.address();
291	                this.logger.info(`✓ Server started successfully on port ${this.port}`);
292	                this.logger.info(`✓ Listening on ${typeof address === 'string' ? address : `${address?.address}:${address?.port}`}`);
293	                this.logger.info(`✓ Transport type: ${this.transportType}`);
294	                this.logger.info(`✓ Startup time: ${Date.now() - this.startTime}ms`);
295	                this.logger.info(`✓ Health check: http://0.0.0.0:${this.port}/health`);
296	                this.logger.info(`✓ Tools registered: ${this.toolRegistry.getNames().length}`);
297	                this.logger.info(`✓ Prompts registered: ${this.promptRegistry.getNames().length}`);
298	                // If using stdio transport, set up stdin handler
299	                if (this.transportType === 'stdio') {
300	                    this.logger.debug('Setting up stdio transport...');
301	                    this.setupStdioTransport();
302	                    this.logger.debug('Stdio transport configured');
303	                }
304	                // SSE routes are already set up in constructor via setupSSERoutes()
305	                // Mark server as ready
306	                this.isReady = true;
307	                this.logger.info('✓ Server initialization complete - ready to accept connections');
308	                resolve();
309	            });
310	            // Also log when server is listening (additional confirmation)
311	            this.server.on('listening', () => {
312	                const address = this.server.address();
313	                this.logger.debug('Server listening event fired', { address });
314	            });
315	        });
316	    }
317	    /**
318	     * Stop the server
319	     */
320	    async stop() {
321	        return new Promise((resolve, reject) => {
322	            this.server.close((err) => {
323	                if (err) {
324	                    this.logger.error('Error stopping server', err);
325	                    reject(err);
326	                }
327	                else {
328	                    this.logger.info('Server stopped');
329	                    resolve();
330	                }
331	            });
332	        });
333	    }
334	    /**
335	     * Set up routes for the server
336	     */
337	    setupRoutes() {
338	        this.logger.debug('Setting up routes');
339	        // Root endpoint for basic connectivity check
340	        this.app.get('/', (_req, res) => {
341	            res.json({
342	                name: packageJson.name,
343	                version: packageJson.version,
344	                status: 'running',
345	                transport: this.transportType,
346	                endpoints: {
347	                    health: '/health',
348	                    capabilities: '/capabilities',
349	                    sse: '/sse',
350	                    mcp: '/mcp'
351	                }
352	            });
353	        });
354	        // Health check endpoint - must be accessible without authentication
355	        // This is critical for Smithery deployment - must respond immediately
356	        this.app.get('/health', (_req, res) => {
357	            try {
358	                const health = {
359	                    status: this.isReady ? 'ok' : 'starting',
360	                    ready: this.isReady,
361	                    uptime: process.uptime(),
362	                    transport: this.transportType,
363	                    tools: this.toolRegistry.getNames().length,
364	                    prompts: this.promptRegistry.getNames().length,
365	                    timestamp: new Date().toISOString(),
366	                    port: this.port
367	                };
368	                // Always return 200, but indicate readiness status
369	                const statusCode = this.isReady ? 200 : 503;
370	                this.logger.debug('Health check requested', { ...health, statusCode });
371	                res.status(statusCode).json(health);
372	            }
373	            catch (error) {
374	                this.logger.error('Error in health check:', error);
375	                res.status(500).json({
376	                    status: 'error',
377	                    ready: false,
378	                    message: error instanceof Error ? error.message : 'Unknown error'
379	                });
380	            }
381	        });
382	        // OAuth metadata endpoint - Smithery checks this during deployment
383	        // We use API key auth, not OAuth, so return 404 to indicate OAuth not supported
384	        this.app.get('/.well-known/oauth-authorization-server', (_req, res) => {
385	            this.logger.debug('OAuth metadata requested - not supported (using API key auth)');
386	            res.status(404).json({
387	                error: 'oauth_not_supported',
388	                message: 'This server uses API key authentication, not OAuth'
389	            });
390	        });
391	        // Capabilities endpoint
392	        this.app.get('/capabilities', (_req, res) => {
393	            res.json({
394	                version: packageJson.version,
395	                transports: ['sse'],
396	                tools: this.toolRegistry.getNames().map(name => {
397	                    const tool = this.toolRegistry.get(name);
398	                    return {
399	                        name,
400	                        description: tool?.description || '',
401	                        parameters: tool?.parameters || {}
402	                    };
403	                }),
404	                prompts: this.promptRegistry.getNames().map(name => {
405	                    const prompt = this.promptRegistry.get(name);
406	                    return {
407	                        name,
408	                        description: prompt?.description || '',
409	                        parameters: prompt?.parameters || {}
410	                    };
411	                })
412	            });
413	        });
414	        // Handle OPTIONS preflight requests for /mcp endpoint
415	        // Required for CORS preflight checks from Smithery
416	        this.app.options('/mcp', (_req, res) => {
417	            this.logger.debug('OPTIONS preflight request for /mcp');
418	            // CORS middleware should handle this, but ensure headers are set
419	            res.status(204).end();
420	        });
421	        // Store active Streamable HTTP transports by session ID
422	        const streamableTransports = new Map();
423	        // MCP HTTP endpoint for Smithery and other HTTP-based clients
424	        // Uses Streamable HTTP transport from MCP SDK for proper protocol compliance
425	        this.app.all('/mcp', async (req, res) => {
426	            try {
427	                this.logger.debug('MCP Streamable HTTP request received', {
428	                    method: req.method,
429	                    path: req.path,
430	                    headers: Object.keys(req.headers)
431	                });
432	                // Ensure MCP server is initialized
433	                if (!this.mcpServer) {
434	                    this.logger.error('MCP server not initialized');
435	                    res.status(503).json({
436	                        error: {
437	                            type: 'transport',
438	                            details: {
439	                                code: 'server_not_ready',
440	                                message: 'MCP server is not initialized yet'
441	                            }
442	                        }
443	                    });
444	                    return;
445	                }
446	                const sessionId = req.headers['mcp-session-id'];
447	                let transport;
448	                if (sessionId && streamableTransports.has(sessionId)) {
449	                    // Reuse existing transport for the session
450	                    const existingTransport = streamableTransports.get(sessionId);
451	                    if (!existingTransport) {
452	                        throw new Error(`Transport not found for session: ${sessionId}`);
453	                    }
454	                    transport = existingTransport;
455	                    this.logger.debug(`Reusing transport for session: ${sessionId}`);
456	                }
457	                else {
458	                    // Create a new transport for a new session
459	                    this.logger.debug('Creating new Streamable HTTP transport');
460	                    const { randomUUID } = await import('crypto');
461	                    transport = new StreamableHTTPServerTransport({
462	                        sessionIdGenerator: () => randomUUID()
463	                    });
464	                    // Connect transport to MCP server
465	                    // SDK handles all JSON-RPC messages including initialize and list_tools
466	                    this.logger.debug('Connecting transport to MCP server');
467	                    await this.mcpServer.connect(transport);
468	                    this.logger.debug('Transport connected successfully');
469	                    // Store transport by session ID after connection
470	                    const newSessionId = transport.sessionId;
471	                    if (newSessionId) {
472	                        streamableTransports.set(newSessionId, transport);
473	                        this.logger.info(`Created new Streamable HTTP transport (session: ${newSessionId})`);
474	                        // Set session ID header for client
475	                        res.setHeader('mcp-session-id', newSessionId);
476	                    }
477	                    else {
478	                        this.logger.warn('Streamable HTTP transport created but sessionId not available');
479	                    }
480	                }
481	                // Handle the request through the transport
482	                this.logger.debug('Handling request through transport');
483	                await transport.handleRequest(req, res, req.body);
484	                this.logger.debug('Request handled successfully');
485	            }
486	            catch (error) {
487	                this.logger.error('Error handling MCP Streamable HTTP request:', error);
488	                if (error instanceof Error) {
489	                    this.logger.error('Error stack:', error.stack);
490	                }
491	                if (!res.headersSent) {
492	                    res.status(500).json({
493	                        error: {
494	                            type: 'transport',
495	                            details: {
496	                                code: 'server_error',
497	                                message: error instanceof Error ? error.message : 'Unknown error'
498	                            }
499	                        }
500	                    });
501	                }
502	            }
503	        });
504	    }
505	    /**
506	     * Set up stdio transport
507	     */
508	    setupStdioTransport() {
509	        this.logger.debug('Setting up stdio transport');
510	        process.stdin.setEncoding('utf8');
511	        process.stdin.on('data', (data) => {
512	            try {
513	                const input = data.toString().trim();
514	                if (!input)
515	                    return;
516	                // Parse the request
517	                const request = JSON.parse(input);
518	                // Handle the request
519	                this.handleMCPRequest(request, (response) => {
520	                    // Write the response to stdout
521	                    process.stdout.write(JSON.stringify(response) + '\n');
522	                });
523	            }
524	            catch (error) {
525	                this.logger.error('Error handling stdin data', error);
526	                // Write error response to stdout
527	                const errorResponse = {
528	                    error: {
529	                        type: 'transport',
530	                        details: {
531	                            code: 'invalid_request',
532	                            message: error instanceof Error ? error.message : 'Invalid request'
533	                        }
534	                    },
535	                    request_id: 'unknown' // Unknown request_id for parsing errors
536	                };
537	                process.stdout.write(JSON.stringify(errorResponse) + '\n');
538	            }
539	        });
540	        this.logger.info('Listening for requests on stdin');
541	    }
542	    /**
543	     * Validate that a request follows the MCP protocol format
544	     * @param request - The request to validate
545	     * @returns True if the request is valid, false otherwise
546	     */
547	    validateMCPRequest(request) {
548	        // Check if request is an object
549	        if (!request || typeof request !== 'object') {
550	            return { valid: false, error: 'Request must be a JSON object' };
551	        }
552	        // Check if request has required fields
553	        if (!('type' in request)) {
554	            return { valid: false, error: 'Missing required field: type' };
555	        }
556	        if (!('name' in request)) {
557	            return { valid: false, error: 'Missing required field: name' };
558	        }
559	        if (!('request_id' in request)) {
560	            return { valid: false, error: 'Missing required field: request_id' };
561	        }
562	        // Validate request type
563	        if (request.type !== 'tool_call' && request.type !== 'prompt_call') {
564	            return { valid: false, error: `Invalid request type: ${request.type}. Must be 'tool_call' or 'prompt_call'` };
565	        }
566	        // Validate request name
567	        if (typeof request.name !== 'string' || request.name.trim() === '') {
568	            return { valid: false, error: 'Invalid request name: must be a non-empty string' };
569	        }
570	        // Validate request_id
571	        if (typeof request.request_id !== 'string' || request.request_id.trim() === '') {
572	            return { valid: false, error: 'Invalid request_id: must be a non-empty string' };
573	        }
574	        // Validate parameters
575	        if (!('parameters' in request) || typeof request.parameters !== 'object') {
576	            return { valid: false, error: 'Missing or invalid parameters: must be an object' };
577	        }
578	        return { valid: true };
579	    }
580	    /**
581	     * Handle an MCP request
582	     * @param request - The MCP request
583	     * @param callback - Callback function to receive the response
584	     */
585	    handleMCPRequest(request, callback) {
586	        // Validate the request format
587	        const validation = this.validateMCPRequest(request);
588	        if (!validation.valid) {
589	            this.logger.warn('Invalid MCP request format', { error: validation.error, request });
590	            callback({
591	                error: {
592	                    type: 'transport',
593	                    details: {
594	                        code: 'invalid_request',
595	                        message: validation.error || 'Invalid request format'
596	                    }
597	                },
598	                request_id: request?.request_id || 'unknown'
599	            });
600	            return;
601	        }
602	        const requestType = request.type;
603	        const requestName = request.name;
604	        const requestId = request.request_id;
605	        this.logger.debug('Handling MCP request', {
606	            type: requestType,
607	            name: requestName,
608	            request_id: requestId
609	        });
610	        // Handle different request types
611	        if (requestType === 'tool_call') {
612	            this.handleToolCall(request, callback);
613	        }
614	        else if (requestType === 'prompt_call') {
615	            this.handlePromptCall(request, callback);
616	        }
617	        else {
618	            this.logger.warn(`Unknown request type: ${requestType}`);
619	            // Return error
620	            callback({
621	                error: {
622	                    type: 'transport',
623	                    details: {
624	                        code: 'invalid_request_type',
625	                        message: `Unknown request type: ${requestType}`
626	                    }
627	                },
628	                request_id: requestId
629	            });
630	        }
631	    }
632	    /**
633	     * Handle a tool call
634	     * @param request - The tool call request
635	     * @param callback - Callback function to receive the response
636	     */
637	    handleToolCall(request, callback) {
638	        const { name, parameters, request_id } = request;
639	        // Get the tool
640	        const tool = this.toolRegistry.get(name);
641	        if (!tool) {
642	            this.logger.warn(`Tool not found: ${name}`);
643	            // Return error
644	            callback({
645	                error: {
646	                    type: 'transport',
647	                    details: {
648	                        code: 'tool_not_found',
649	                        message: `Tool not found: ${name}`
650	                    }
651	                },
652	                request_id
653	            });
654	            return;
