13	import McpServer from '../src/server.js'
14	import StdioTransport from '../src/server/transports/stdio_transport.js'
15	
16	export default class MakeTool extends BaseCommand {
17	  static commandName = 'mcp:start'
18	  static description = 'Start the MCP server stdio transport'
19	
20	  static options: CommandOptions = {
21	    startApp: true,
22	    // stayAlive: true,
23	  }
24	
25	  #server: McpServer | null = null
26	
27	  async run() {
28	    try {
29	      this.#server = await this.app.container.make('jrmc.mcp')
30	
31	      const transport = new StdioTransport()
32	      await this.#server.connect(transport)
33	      transport.on('mcp:stdio:transport:message', async (message: JsonRpcRequest) => {
34	        await this.#server?.handle(message)
35	      })
36	    } catch (error: any) {
37	      throw error
38	    }
39	  }
40	}
