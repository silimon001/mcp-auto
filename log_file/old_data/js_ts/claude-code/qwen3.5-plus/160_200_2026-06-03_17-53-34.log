83	 * @returns {Promise<void>}
84	 */
85	const run = async (options: RunOptions): Promise<void> => {
86	  try {
87	    if (!process.env.HOME) {
88	      process.env.HOME = os.homedir();
89	      log(`Set HOME environment variable to ${process.env.HOME}`);
90	    }
91	
92	    // Honor env vars for MCPB-style installs where CLI args are not passed through
93	    if (!options.readOnly && process.env.AUTH0_MCP_READ_ONLY === 'true') {
94	      options.readOnly = true;
95	    }
96	    const defaultTools = options.tools.length === 1 && options.tools[0] === '*';
97	    if (defaultTools && process.env.AUTH0_MCP_TOOLS) {
98	      options.tools = process.env.AUTH0_MCP_TOOLS.split(',')
99	        .map((t) => t.trim())
100	        .filter(Boolean);
101	      if (options.tools.length === 0) {
102	        options.tools = ['*'];
103	      }
104	    }
105	
106	    trackEvent.trackServerRun();
107	
108	    // Skip keychain-based validation when credentials are provided via env (MCPB-style launch).
109	    // Startup validation in server.ts and per-tool validation still enforce correctness.
110	    const envAuth = Boolean(process.env.AUTH0_TOKEN && process.env.AUTH0_DOMAIN);
111	    if (!envAuth) {
112	      const isAuthorized = await validateAuthorization();
113	      if (!isAuthorized) {
114	        // Exit with code 1 (standard error code)
115	        process.exit(1);
116	      }
117	    }
118	
119	    if (options.readOnly && options.tools.length === 1 && options.tools[0] === '*') {
120	      logInfo('Starting server in read-only mode');
121	    } else if (options.readOnly) {
122	      logInfo(
123	        `Starting server in read-only mode with tools matching the following pattern(s): ${options.tools.join(', ')} (--read-only has priority)`
124	      );
125	    } else {
126	      logInfo(
