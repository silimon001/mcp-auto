36	    const McpController = () => import('../src/server/controllers/mcp_controller.js')
37	
38	    router.mcp = (pattern: string = '/mcp') => {
39	      return router.group(() => {
40	        router.post(pattern, [McpController, 'post'])
41	      })
42	    }
43	
44	    await this.registerTools()
45	    await this.registerResources()
46	    await this.registerPrompts()
47	  }
