8	import type { CommandOptions } from '@adonisjs/core/types/ace'
9	
10	import { $ } from 'execa'
11	import { args, BaseCommand } from '@adonisjs/core/ace'
12	
13	export default class Inspector extends BaseCommand {
14	  static commandName = 'mcp:inspector'
15	  static description = 'Open the MCP Inspector tool to debug and test MCP Servers.'
16	  static aliases = ['mcp:inspect']
17	
18	  static options: CommandOptions = {
19	    startApp: true,
20	  }
21	
22	  @args.string({ description: 'Transport type', default: 'http' })
23	  declare transport: string
24	
25	  async run() {
26	    if (this.app.inProduction) {
27	      this.logger.error('Cannot open MCP inspector in production environment')
28	      return
29	    }
30	
31	    if (this.transport !== 'http' && this.transport !== 'stdio') {
32	      this.logger.error('Invalid transport type')
33	      return
34	    }
35	
36	    if (this.transport === 'http') {
37	      const router = await this.app.container.make('router')
38	
39	      const serverUrl = router
40	        .builder()
41	        .prefixUrl(`http://${process.env.HOST}:${process.env.PORT}`)
42	        .disableRouteLookup()
43	        .make('/mcp')
44	
45	      const inspectorProcess = $({
46	        stdio: 'inherit',
47	      })`npx @modelcontextprotocol/inspector --transport http --server-url ${serverUrl}`
48	
49	      await inspectorProcess
50	    } else {
51	      const nodeBinary = process.execPath
52	      const acePath = this.app.makePath('ace.js')
53	
54	      const inspectorProcess = $({
55	        stdio: 'inherit',
56	      })`npx @modelcontextprotocol/inspector --transport stdio ${nodeBinary} ${acePath} mcp:start`
57	
58	      await inspectorProcess
59	    }
60	  }
61	}
