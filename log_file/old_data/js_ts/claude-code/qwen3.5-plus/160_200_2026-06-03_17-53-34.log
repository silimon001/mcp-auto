35	        for tool in self.mcp_client.tools:
36	            print(f"- {tool.name}")
37	
38	    def build_openai_tools(self):
39	        tools = []
40	
41	        for tool in self.mcp_client.tools:
42	
43	            tools.append({
44	                "type": "function",
45	                "function": {
46	                    "name": tool.name,
47	                    "description": tool.description or "",
48	                    "parameters": tool.inputSchema
49	                }
50	            })
51	
52	        return tools
53	
54	    async def call_tool(self, tool_name: str, arguments: dict):
55	
56	        print(f"\n[TOOL CALL] {tool_name}")
57	        print(arguments)
58	
59	        result = await self.mcp_client.session.call_tool(
60	            tool_name,
61	            arguments
62	        )
63	
64	        if hasattr(result, "content"):
65	            texts = []
66	
67	            for item in result.content:
68	                if hasattr(item, "text"):
69	                    texts.append(item.text)
70	
71	            return "\n".join(texts)
72	
73	        return str(result)
74	
75	    async def chat(self):
76	
77	        tools = self.build_openai_tools()
78	
79	        print("\n=== MCP Host Started ===\n")
80	
81	        while True:
82	            from openai import OpenAI
83	
84	            user_input = input("\nYou > ")
85	
86	            if user_input.strip().lower() in ["exit", "quit"]:
87	                break
88	
89	            self.messages.append({
90	                "role": "user",
91	                "content": user_input
92	            })
93	
94	            while True:
95	
96	                session = OpenAI(
97	                    api_key=API_KEY,
98	                    base_url='https://dashscope.aliyuncs.com/compatible-mode/v1',
99	                )
100	                response = session.chat.completions.create(
101	                    model='qwen3.5-plus',
102	                    messages=self.messages,
103	                    tools=tools,
104	                    stream=False,
105	                    temperature=0.1, # (0, 2]
106	                    tool_choice="auto",
107	                    extra_body={"enable_thinking": True}
108	                )
109	
110	                msg = response.choices[0].message
111	
112	                # tool call
113	                if msg.tool_calls:
114	
115	                    self.messages.append(msg)
116	
117	                    for tool_call in msg.tool_calls:
118	
119	                        tool_name = tool_call.function.name
120	
121	                        arguments = json.loads(
122	                            tool_call.function.arguments
123	                        )
124	
125	                        result = await self.call_tool(
