loop 18 | Tool=Bash, Args={"command":"cat > local-graphql-server.js << 'EOF'\nconst { ApolloServer, gql } = require('apollo-server');\n\n// Define a simple schema with queries and mutations\nconst typeDefs = gql`\n  type User {\n    id: ID!\n    name: String!\n    email: String!\n  }\n\n  type Query {\n    users: [User!]!\n    user(id: ID!): User\n  }\n\n  type Mutation {\n    createUser(name: String!, email: String!): User!\n    updateUser(id: ID!, name: String, email: String): User\n  }\n`;\n\n// Simple in-memory data\nlet users = [\n  { id: '1', name: 'John Doe', email: 'john@example.com' },\n  { id: '2', name: 'Jane Smith', email: 'jane@example.com' }\n];\n\nconst resolvers = {\n  Query: {\n    users: () => users,\n    user: (_, { id }) => users.find(u => u.id === id)\n  },\n  Mutation: {\n    createUser: (_, { name, email }) => {\n      const newUser = { id: String(users.length + 1), name, email };\n      users.push(newUser);\n      return newUser;\n    },\n    updateUser: (_, { id, name, email }) => {\n      const user = users.find(u => u.id === id);\n      if (user) {\n        if (name) user.name = name;\n        if (email) user.email = email;\n      }\n      return user;\n    }\n  }\n};\n\nconst server = new ApolloServer({ typeDefs, resolvers });\n\nserver.listen({ port: 4000 }).then(({ url }) => {\n  console.log(`Local GraphQL server ready at ${url}`);\n});\nEOF\necho \"Created local GraphQL server\""}
loop 19 | Tool=Bash, Args={"command":"npm install apollo-server graphql 2>&1 | tail -10","timeout":60000}
