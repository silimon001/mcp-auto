)',\n                },\n            ],\n        };\n    },\n});\n\n// Get workspace info tool\nserver.addTool({\n    name: 'get_workspace_info',\n    description: 'Get workspace information',\n    parameters: z.object({}),\n    execute: async () => {\n        return {\n            content: [\n                {\n                    type: 'text',\n                    text: JSON.stringify({\n                        name: 'Standalone MCP Server',\n                        folders: [],\n                        activeEditor: 'No active editor (standalone mode)',\n                    }, null, 2),\n                },\n            ],\n        };\n    },\n});\n\n// Start the server\nserver.start({\n    transportType: 'httpStream',\n    httpStream: {\n        port: 8080,\n        host: 'localhost',\n        endpoint: '/mcp',\n    },\n}).then(() => {\n    console.log('MCP Server running on http://localhost:8080/mcp');\n}).catch((err) => {\n    console.error('Failed to start MCP server:', err);\n    process.exit(1);\n});\n"}
