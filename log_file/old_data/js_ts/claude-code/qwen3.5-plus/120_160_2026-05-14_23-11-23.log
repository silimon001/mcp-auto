102	/**
103	 * Wrap async handler with error handling and response compaction.
104	 * @param {Function} handler - async function returning result object
105	 * @param {object} params - tool params; if compact !== false, strips null/empty/false values
106	 */
107	function wrapHandler(handler, params = {}) {
108	  return async () => {
109	    if (!gravityFormsClient) {
110	      return createErrorResponse('Gravity Forms client not initialized');
111	    }
112	
113	    try {
114	      const result = await handler();
115	      const output = params.compact !== false ? stripEmpty(result) : result;
116	
117	      return {
118	        content: [
119	          {
120	            type: "text",
121	            text: JSON.stringify(output)
122	          }
123	        ]
124	      };
125	    } catch (error) {
126	      const safeDetails = error.details ? sanitize(error.details) : undefined;
127	      logger.error(`Tool error: ${error.message}`);
128	      return createErrorResponse(error.message, safeDetails);
129	    }
130	  };
131	}
