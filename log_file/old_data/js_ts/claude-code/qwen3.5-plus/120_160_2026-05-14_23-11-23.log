270	// Call tool handler for SQL operations
271	server.setRequestHandler(CallToolRequestSchema, async (request) => {
272	  if (request.params.name === "query") {
273	    const sql = request.params.arguments?.sql as string;
274	
275	    const client = await pool.connect();
276	    try {
277	      await client.query("BEGIN TRANSACTION READ ONLY");
278	      const result = await client.query(sql);
279	
280	      return {
281	        content: [{ type: "text", text: JSON.stringify(result.rows, null, 2) }],
282	        isError: false,
283	      };
284	    } catch (error) {
285	      throw error;
286	    } finally {
287	      await client.query("ROLLBACK");
288	      client.release();
289	    }
290	  }
291	
292	  if (request.params.name === "create_table") {
293	    const { tableName, columns } = request.params.arguments as {
294	      tableName: string;
295	      columns: { name: string; type: string }[];
296	    };
297	
298	    const columnDefinitions = columns
299	      .map((col) => `${col.name} ${col.type}`)
300	      .join(", ");
301	
302	    const client = await pool.connect();
303	    try {
304	      const createTableQuery = `CREATE TABLE ${tableName} (${columnDefinitions})`;
305	      await client.query(createTableQuery);
306	
307	      return {
308	        content: [
309	          {
310	            type: "text",
311	            text: `Table "${tableName}" created successfully with columns: ${columns
312	              .map((col) => `${col.name} (${col.type})`)
313	              .join(", ")}`,
314	          },
315	        ],
316	        isError: false,
317	      };
318	    } catch (error) {
319	      throw error;
320	    } finally {
321	      client.release();
322	    }
323	  }
324	
325	  if (request.params.name === "insert_entry") {
326	    const { tableName, values } = request.params.arguments as {
327	      tableName: string;
328	      values: Record<string, string>;
329	    };
330	
331	    const columns = Object.keys(values).join(", ");
332	    const placeholders = Object.keys(values)
333	      .map((_, index) => `$${index + 1}`)
334	      .join(", ");
335	    const valuesArray = Object.values(values);
336	
337	    const client = await pool.connect();
338	    try {
339	      const insertQuery = `INSERT INTO ${tableName} (${columns}) VALUES (${placeholders}) RETURNING *`;
340	      const result = await client.query(insertQuery, valuesArray);
341	
342	      return {
343	        content: [
344	          {
345	            type: "text",
346	            text: `Inserted into table "${tableName}": ${JSON.stringify(
