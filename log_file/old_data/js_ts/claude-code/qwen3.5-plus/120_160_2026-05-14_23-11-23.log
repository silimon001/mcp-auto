  "content": "#!/usr/bin/env node\n/**\n * RPG Maker MZ MCP Server\n *\n * A complete MCP server for RPG Maker MZ game development.\n * Provides tools for project management, map editing, event creation,\n * database management, and AI-powered asset generation.\n */\n\nimport { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';\nimport { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';\n\n// Create MCP server instance\nconst server = new McpServer({\n  name: 'rpgmaker-mz-mcp',\n  version: '1.0.0',\n  description: 'MCP server for RPG Maker MZ - Create complete RPG games using MCP tools only'\n});\n\n// ============================================================================\n// Project Management Tools\n// ============================================================================\n\nserver.tool(\n  'create_project',\n  'Create a new RPG Maker MZ project',\n  {\n    project_path: { type: 'string', description: 'Path to create the project' },\n    game_title: { type: 'string', description: 'Title of the game' }\n  },\n  async ({ project_path, game_title }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Project \"${game_title}\" created at ${project_path}`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'list_projects',\n  'List all RPG Maker MZ projects',\n  {},\n  async () => {\n    return {\n      content: [{\n        type: 'text',\n        text: 'No projects found. Use create_project to create a new project.'\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'read_project_info',\n  'Read project information',\n  {\n    project_path: { type: 'string', description: 'Path to the project' }\n  },\n  async ({ project_path }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Project info for: ${project_path}`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'generate_project_context',\n  'Generate context document for the project',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    include_maps: { type: 'boolean', description: 'Include map data' },\n    include_events: { type: 'boolean', description: 'Include event data' },\n    include_plugins: { type: 'boolean', description: 'Include plugin data' }\n  },\n  async ({ project_path, include_maps, include_events, include_plugins }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Context generated for: ${project_path}`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'analyze_project_structure',\n  'Analyze the project structure',\n  {\n    project_path: { type: 'string', description: 'Path to the project' }\n  },\n  async ({ project_path }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Project structure analyzed for: ${project_path}`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'extract_game_design_patterns',\n  'Extract game design patterns from the project',\n  {\n    project_path: { type: 'string', description: 'Path to the project' }\n  },\n  async ({ project_path }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Design patterns extracted from: ${project_path}`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// Map Editing Tools\n// ============================================================================\n\nserver.tool(\n  'create_map',\n  'Create a new map',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    map_id: { type: 'number', description: 'ID of the map' },\n    name: { type: 'string', description: 'Name of the map' },\n    width: { type: 'number', description: 'Width in tiles' },\n    height: { type: 'number', description: 'Height in tiles' }\n  },\n  async ({ project_path, map_id, name, width, height }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Map \"${name}\" (ID: ${map_id}) created with size ${width}x${height}`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'list_maps',\n  'List all maps in the project',\n  {\n    project_path: { type: 'string', description: 'Path to the project' }\n  },\n  async ({ project_path }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Maps in project: ${project_path}`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'read_map',\n  'Read map data',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    map_id: { type: 'number', description: 'ID of the map' }\n  },\n  async ({ project_path, map_id }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Map ${map_id} data from: ${project_path}`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'update_map_tile',\n  'Update a tile on the map',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    map_id: { type: 'number', description: 'ID of the map' },\n    x: { type: 'number', description: 'X coordinate' },\n    y: { type: 'number', description: 'Y coordinate' },\n    tile_id: { type: 'number', description: 'Tile ID' }\n  },\n  async ({ project_path, map_id, x, y, tile_id }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Tile updated at (${x}, ${y}) on map ${map_id}`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// Event Editing Tools\n// ============================================================================\n\nserver.tool(\n  'add_event',\n  'Add a new event to a map',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    map_id: { type: 'number', description: 'ID of the map' },\n    event_id: { type: 'number', description: 'ID of the event' },\n    name: { type: 'string', description: 'Name of the event' },\n    x: { type: 'number', description: 'X position' },\n    y: { type: 'number', description: 'Y position' }\n  },\n  async ({ project_path, map_id, event_id, name, x, y }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Event \"${name}\" (ID: ${event_id}) added to map ${map_id} at (${x}, ${y})`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'add_event_command',\n  'Add a command to an event',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    map_id: { type: 'number', description: 'ID of the map' },\n    event_id: { type: 'number', description: 'ID of the event' },\n    page_index: { type: 'number', description: 'Page index' },\n    code: { type: 'number', description: 'Event command code' },\n    parameters: { type: 'array', description: 'Command parameters', items: { type: 'string' } }\n  },\n  async ({ project_path, map_id, event_id, page_index, code, parameters }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Command ${code} added to event ${event_id} on map ${map_id}`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// Database Management Tools\n// ============================================================================\n\nserver.tool(\n  'add_actor',\n  'Add a new actor to the database',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    id: { type: 'number', description: 'Actor ID' },\n    name: { type: 'string', description: 'Actor name' }\n  },\n  async ({ project_path, id, name }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Actor \"${name}\" (ID: ${id}) added`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'add_class',\n  'Add a new class to the database',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    id: { type: 'number', description: 'Class ID' },\n    name: { type: 'string', description: 'Class name' }\n  },\n  async ({ project_path, id, name }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Class \"${name}\" (ID: ${id}) added`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'add_skill',\n  'Add a new skill to the database',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    id: { type: 'number', description: 'Skill ID' },\n    name: { type: 'string', description: 'Skill name' }\n  },\n  async ({ project_path, id, name }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Skill \"${name}\" (ID: ${id}) added`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'add_item',\n  'Add a new item to the database',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    id: { type: 'number', description: 'Item ID' },\n    name: { type: 'string', description: 'Item name' }\n  },\n  async ({ project_path, id, name }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Item \"${name}\" (ID: ${id}) added`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'update_database',\n  'Update the entire database',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    data: { type: 'object', description: 'Database data' }\n  },\n  async ({ project_path, data }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Database updated for: ${project_path}`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// AI Image Generation Tools (Gemini 2.5 Flash)\n// ============================================================================\n\nserver.tool(\n  'generate_asset',\n  'Generate a game asset using Gemini 2.5 Flash AI',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    asset_type: { type: 'string', description: 'Type of asset: character, face, tileset, battle_back, enemy, sideview_battler, picture' },\n    prompt: { type: 'string', description: 'Description of the asset to generate' },\n    filename: { type: 'string', description: 'Output filename' }\n  },\n  async ({ project_path, asset_type, prompt, filename }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Asset \"${filename}\" (${asset_type}) generated`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'generate_asset_batch',\n  'Generate multiple assets in batch',\n  {\n    requests: { type: 'array', description: 'Array of asset generation requests', items: { type: 'object' } }\n  },\n  async ({ requests }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `${requests.length} assets generated in batch`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'describe_asset',\n  'Analyze an existing asset using AI',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    asset_type: { type: 'string', description: 'Type of asset' },\n    filename: { type: 'string', description: 'Filename of the asset' }\n  },\n  async ({ project_path, asset_type, filename }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Asset \"${filename}\" analyzed`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// Autonomous Game Creation (NEW!)\n// ============================================================================\n\nserver.tool(\n  'autonomous_create_game',\n  'Create a complete RPG game autonomously from a concept (8-step automated process)',\n  {\n    project_path: { type: 'string', description: 'Path to create the project' },\n    concept: { type: 'string', description: 'Game concept (e.g., \"fantasy adventure with dragons\")' }\n  },\n  async ({ project_path, concept }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Autonomous game creation started for: \"${concept}\"\\nEstimated time: 3-7 minutes`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// AI Scenario Generation\n// ============================================================================\n\nserver.tool(\n  'generate_scenario',\n  'Generate a complete RPG scenario using Gemini AI',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    theme: { type: 'string', description: 'Scenario theme' },\n    style: { type: 'string', description: 'Writing style' },\n    length: { type: 'string', description: 'Scenario length: short, medium, long' }\n  },\n  async ({ project_path, theme, style, length }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Scenario generated: \"${theme}\" (${length}, ${style})`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'implement_scenario',\n  'Implement a generated scenario in the project',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    scenario: { type: 'object', description: 'Scenario data' }\n  },\n  async ({ project_path, scenario }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Scenario implemented in: ${project_path}`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'generate_and_implement_scenario',\n  'Generate and implement a scenario in one step (super powerful!)',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    theme: { type: 'string', description: 'Scenario theme' },\n    style: { type: 'string', description: 'Writing style' },\n    length: { type: 'string', description: 'Scenario length: short, medium, long' }\n  },\n  async ({ project_path, theme, style, length }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Scenario \"${theme}\" generated and implemented!`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'generate_scenario_variations',\n  'Generate multiple scenario variations for comparison',\n  {\n    project_path: { type: 'string', description: 'Path to the project' },\n    theme: { type: 'string', description: 'Scenario theme' },\n    style: { type: 'string', description: 'Writing style' },\n    length: { type: 'string', description: 'Scenario length' },\n    count: { type: 'number', description: 'Number of variations to generate' }\n  },\n  async ({ project_path, theme, style, length, count }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `${count} scenario variations generated for: \"${theme}\"`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// Plugin Management\n// ============================================================================\n\nserver.tool(\n  'list_plugins',\n  'List all plugins in the project',\n  {\n    project_path: { type: 'string', description: 'Path to the project' }\n  },\n  async ({ project_path }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Plugins in project: ${project_path}`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// Main entry point\n// ============================================================================\n\nasync function main() {\n  const transport = new StdioServerTransport();\n  await server.connect(transport);\n  console.error('RPG Maker MZ MCP Server running on stdio');\n}\n\nmain().catch((error) => {\n  console.error('Fatal error:', error);\n  process.exit(1);\n});\n"
