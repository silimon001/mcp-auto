667	// =================================
668	// SERVER INITIALIZATION
669	// =================================
670	
671	async function main() {
672	  try {
673	    // Initialize client on startup
674	    await initializeClient();
675	
676	    // Create stdio transport
677	    const transport = new StdioServerTransport();
678	
679	    // Connect server to transport
680	    await server.connect(transport);
681	
682	    logger.info('🚀 GravityKit MCP running on stdio');
683	  } catch (error) {
684	    logger.error(`Failed to start server: ${error}`);
685	    process.exit(1);
686	  }
687	}
688	
689	// Handle graceful shutdown
690	process.on('SIGINT', async () => {
691	  logger.info('👋 Shutting down GravityKit MCP...');
692	  process.exit(0);
693	});
694	
695	process.on('SIGTERM', async () => {
696	  logger.info('👋 Shutting down GravityKit MCP...');
697	  process.exit(0);
698	});
699	
700	// Start the server
701	main().catch((error) => {
702	  logger.error(`Fatal error: ${error}`);
703	  process.exit(1);
704	});

