83	/**
84	 * Recursively strip null, empty string, and false values from objects/arrays.
85	 * Reduces token usage by removing noise like empty field values and absent meta keys.
86	 */
87	/**
88	 * Create standard error response
89	 */
90	function createErrorResponse(message, details = null) {
91	  return {
92	    content: [
93	      {
94	        type: "text",
95	        text: `Error: ${message}${details ? `\nDetails: ${JSON.stringify(details)}` : ''}`
96	      }
97	    ],
98	    isError: true
99	  };
100	}
