1	// 📦 Importar las dependencias necesarias
2	import * as dotenv from "dotenv";
3	dotenv.config(); // 🔐 Cargar las variables de entorno desde el archivo .env
4	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
5	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
6	import { z } from "zod"; // 📝 Librería para validación de esquemas
7	import { google } from "googleapis"; // 🎥 Cliente oficial de APIs de Google
8	// 🚀 Crear una instancia del servidor MCP (Model Context Protocol)
9	const server = new McpServer({
10	    name: "mcp-stdio-server",
11	    version: "1.0.0",
12	});
13	// 🎬 Configurar el cliente de YouTube API v3 con la clave de autenticación
14	const youtube = google.youtube({
15	    version: "v3",
16	    auth: process.env.YOUTUBE_API_KEY, // 🔑 API Key obtenida de las variables de entorno
17	});
18	// 🛠️ Definir las herramientas (Tools) del servidor
19	// 📚 Documentación: https://modelcontextprotocol.io/docs/concepts/tools#tool-definition-structure
20	server.registerTool(
21	// 📌 Nombre de la herramienta (se usa para invocarla desde el cliente)
22	"get_youtube_channel", 
23	// 📋 Esquema de la herramienta (define cómo se valida la entrada)
24	{
25	    title: "Get YouTube Channel",
26	    description: "Search for a YouTube channel by its name.",
27	    inputSchema: {
28	        query: z.string().describe("The name of the YouTube channel to search for")
29	    },
30	}, 
31	// ⚡ Handler: función que se ejecuta cuando se llama a la herramienta
32	async ({ query }) => {
33	    console.log("Calling get_youtube_channel with query:", query);
34	    // 🔍 Llamar a la API de YouTube para buscar canales por handle
35	    const res = await youtube.channels.list({
36	        part: ["snippet"], // 📄 Solicitar solo la información básica (snippet)
37	        forHandle: query, // 🎯 Buscar por el handle del canal
38	        maxResults: 5, // 🔢 Limitar a 5 resultados máximo
39	    }, {});
40	    // 📊 Mostrar los resultados en la consola en formato de tabla
41	    console.table(res.data.items?.map((item) => ({
42	        Title: item.snippet?.title,
43	        Description: item.snippet?.description,
44	        Thumbnail: item.snippet?.thumbnails?.default?.url,
45	        Language: item.snippet?.defaultLanguage,
46	        Country: item.snippet?.country,
47	        PublishedAt: item.snippet?.publishedAt,
48	    })));
49	    // 📝 Formatear los resultados para devolverlos al cliente en Markdown
50	    let formattedResults = "";
51	    res.data.items?.forEach((item) => {
52	        formattedResults += `\n\n**Title:** ${item.snippet?.title}\n\n`;
53	        formattedResults += `**Description:** ${item.snippet?.description}\n\n`;
54	        formattedResults += `**Thumbnail:** ![Thumbnail](${item.snippet?.thumbnails?.default?.url})\n\n`;
55	        formattedResults += `**Published At:** ${item.snippet?.publishedAt}\n\n`;
56	        formattedResults += `**URL:** http://youtube.com/${item.snippet?.customUrl}\n\n`;
57	    });
58	    // ✅ Devolver la respuesta formateada al cliente
59	    return {
60	        content: [
61	            {
62	                type: "text",
63	                text: formattedResults.length > 0
64	                    ? `# Search results for "${query}"\n\n${formattedResults}`
65	                    : `No results found for "${query}"`, // ❌ Mensaje si no hay resultados
66	            },
67	        ],
68	    };
69	});
70	// 🎯 Función principal para iniciar el servidor
71	async function main() {
72	    // 🔌 Iniciar el servidor con transporte Stdio (entrada/salida estándar)
73	    const transport = new StdioServerTransport();
74	    // 🤝 Conectar el servidor al transporte
75	    await server.connect(transport);
76	    console.error("This MCP Server is running on stdio 🖥️");
77	}
78	// 🏁 Ejecutar la función principal y manejar errores
79	main().catch((error) => {
80	    console.error("👎🏻 Fatal error in main():", error);
81	    process.exit(1); // 🛑 Salir del proceso con código de error
82	});
