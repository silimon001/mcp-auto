 database',\n  {\n    project_path: z.string().describe('Path to the project'),\n    id: z.number().describe('Item ID'),\n    name: z.string().describe('Item name')\n  },\n  async ({ project_path, id, name }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Item \"${name}\" (ID: ${id}) added`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'update_database',\n  'Update the entire database',\n  {\n    project_path: z.string().describe('Path to the project'),\n    data: z.object({}).describe('Database data')\n  },\n  async ({ project_path }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Database updated for: ${project_path}`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// AI Image Generation Tools (Gemini 2.5 Flash)\n// ============================================================================\n\nserver.tool(\n  'generate_asset',\n  'Generate a game asset using Gemini 2.5 Flash AI',\n  {\n    project_path: z.string().describe('Path to the project'),\n    asset_type: z.string().describe('Type of asset: character, face, tileset, battle_back, enemy, sideview_battler, picture'),\n    prompt: z.string().describe('Description of the asset to generate'),\n    filename: z.string().describe('Output filename')\n  },\n  async ({ project_path, asset_type, prompt, filename }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Asset \"${filename}\" (${asset_type}) generated`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'generate_asset_batch',\n  'Generate multiple assets in batch',\n  {\n    requests: z.array(z.object({})).describe('Array of asset generation requests')\n  },\n  async ({ requests }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `${requests.length} assets generated in batch`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'describe_asset',\n  'Analyze an existing asset using AI',\n  {\n    project_path: z.string().describe('Path to the project'),\n    asset_type: z.string().describe('Type of asset'),\n    filename: z.string().describe('Filename of the asset')\n  },\n  async ({ project_path, asset_type, filename }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Asset \"${filename}\" analyzed`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// Autonomous Game Creation (NEW!)\n// ============================================================================\n\nserver.tool(\n  'autonomous_create_game',\n  'Create a complete RPG game autonomously from a concept (8-step automated process)',\n  {\n    project_path: z.string().describe('Path to create the project'),\n    concept: z.string().describe('Game concept (e.g., \"fantasy adventure with dragons\")')\n  },\n  async ({ project_path, concept }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Autonomous game creation started for: \"${concept}\"\\nEstimated time: 3-7 minutes`\n      }]\n    };\n  }\n);\n\n// ============================================================================\n// AI Scenario Generation\n// ============================================================================\n\nserver.tool(\n  'generate_scenario',\n  'Generate a complete RPG scenario using Gemini AI',\n  {\n    project_path: z.string().describe('Path to the project'),\n    theme: z.string().describe('Scenario theme'),\n    style: z.string().describe('Writing style'),\n    length: z.string().describe('Scenario length: short, medium, long')\n  },\n  async ({ project_path, theme, style, length }) => {\n    return {\n      content: [{\n        type: 'text',\n        text: `Scenario generated: \"${theme}\" (${length}, ${style})`\n      }]\n    };\n  }\n);\n\nserver.tool(\n  'implement_scenario',\n  'Implement a generated scenario in the project',\n  {\n    project_path: z.string().describe('Path to the project')