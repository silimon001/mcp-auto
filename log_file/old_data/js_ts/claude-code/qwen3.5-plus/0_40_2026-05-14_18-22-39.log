1	import { z } from "zod";
2	import { MCPTool } from "mcp-framework";
3	class GetDailyTreasuryStatement extends MCPTool {
4	    name = "get_daily_treasury_statement";
5	    description = "Get the daily treasury statement for a specific day";
6	    schema = {
7	        date: {
8	            type: z
9	                .string()
10	                .regex(/^\d{4}-\d{2}-\d{2}$/, "Invalid date format. Use YYYY-MM-DD"),
11	            description: "Date of the statement in YYYY-MM-DD format",
12	        },
13	    };
14	    async execute({ date }) {
15	        const url = `https://api.fiscaldata.treasury.gov/services/api/fiscal_service/v1/accounting/dts/operating_cash_balance?filter=record_date:eq:${date}`;
16	        const response = await this.fetch(url);
17	        return response.data;
18	    }
19	}
20	export default GetDailyTreasuryStatement;
21	

