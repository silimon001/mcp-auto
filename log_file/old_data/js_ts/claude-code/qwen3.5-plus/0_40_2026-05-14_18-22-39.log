75	        // Validate required parameters
76	        if (!params.robotUuid) {
77	            throw new Error(i18n.t('rpaService.error.robotUuidRequired'));
78	        }
79	        // Validate mutually exclusive parameters
80	        if (params.accountName && params.robotClientGroupUuid) {
81	            throw new Error(i18n.t('rpaService.error.accountNameAndGroupConflict'));
82	        }
83	        // Validate timeout range
