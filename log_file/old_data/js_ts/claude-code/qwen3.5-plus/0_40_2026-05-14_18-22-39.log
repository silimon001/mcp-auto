7	    tokenManager;
8	    constructor(accessKeyId, accessKeySecret) {
9	        this.tokenManager = new TokenManager(accessKeyId, accessKeySecret);
10	        this.client = axios.create({
11	            baseURL: this.baseURL,
12	            timeout: 10000,
13	        });
14	        // Add request interceptor to automatically add token
15	        this.client.interceptors.request.use(async (config) => {
16	            const token = await this.tokenManager.getToken();
17	            config.headers.Authorization = `Bearer ${token}`;
18	            return config;
19	        });
20	    }
21	    async queryAppList(params) {
22	        try {
23	            const response = await this.client.post('/app/open/query/list', params);
24	            return response.data.code === 200
25	                ? response.data.data
26	                : response.data.msg;
27	        }
28	        catch (error) {
29	            throw new Error(`Failed to fetch app list: ${error.message}`);
30	        }
31	    }
32	    async queryRobotParam(params) {
33	        try {
34	            const response = await this.client.post('/robot/v2/queryRobotParam', params);
35	            return response.data.code === 200
36	                ? response.data.data
37	                : response.data.msg;
38	        }
39	        catch (error) {
40	            throw new Error(`Failed to fetch robot parameters: ${error.message}`);
41	        }
42	    }
43	    async uploadFile(file, fileName) {
44	        // Validate filename length
45	        if (fileName.length > 100) {
46	            throw new Error(i18n.t('rpaService.error.fileNameTooLong'));
47	        }
48	        // Validate file type
49	        const allowedExtensions = ['txt', 'csv', 'xlsx'];
50	        const fileExtension = fileName.split('.').pop()?.toLowerCase();
51	        if (!fileExtension || !allowedExtensions.includes(fileExtension)) {
52	            throw new Error(i18n.t('rpaService.error.unsupportedFileType'));
53	        }
54	        // Create FormData and convert file to Blob
55	        const formData = new FormData();
56	        const blob = typeof file === 'string' ? new Blob([file]) : new Blob([file]);
57	        formData.append('file', blob, fileName);
58	        try {
59	            const response = await this.client.post('/dispatch/v2/file/upload', formData, {
60	                headers: {
61	                    'Content-Type': 'multipart/form-data'
62	                },
63	                maxBodyLength: 10 * 1024 * 1024 // 10MB limit
64	            });
65	            if (response.data.code !== 200) {
66	                throw new Error(response.data.msg || i18n.t('rpaService.error.uploadFailed'));
67	            }
68	            return response.data;
69	        }
70	        catch (error) {
71	            throw new Error(`${i18n.t('rpaService.error.uploadFailed')}: ${error.message}`);
72	        }
73	    }
