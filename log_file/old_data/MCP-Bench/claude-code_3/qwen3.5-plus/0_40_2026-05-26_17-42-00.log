316	# ---------------------- DONKI (Space Weather Database Of Notifications, Knowledge, Information) ----------------------
317	# Helper function to format DONKI results consistently
318	def format_donki_results(data: list, title_prefix: str, id_key: str) -> str:
319	    if not data: 
320	        return f"No {title_prefix.lower()} data for the specified period."
321	    
322	    result = [f"{title_prefix} found: {len(data)}"]
323	    display_limit = 10
324	    count = 0
325	
326	    for item in data:
327	        if count >= display_limit:
328	            result.append(f"\n... and {len(data) - display_limit} more entries.")
329	            break
330	        
331	        result.append(f"\nID: {item.get(id_key, 'Unknown')}")
332	        # Add common fields if they exist
333	        if 'startTime' in item: result.append(f"Start Time: {item.get('startTime', 'Unknown')}")
334	        if 'eventTime' in item: result.append(f"Event Time: {item.get('eventTime', 'Unknown')}")
335	        if 'sourceLocation' in item: result.append(f"Source Location: {item.get('sourceLocation', 'Unknown')}")
336	        if 'note' in item: result.append(f"Note: {item.get('note', 'N/A')}")
337	        if 'link' in item: result.append(f"Link: {item.get('link', 'N/A')}")
338	        
339	        # Specific fields for different DONKI types can be added here if needed
340	        # Example for CME:
341	        if id_key == 'activityID' and 'cmeAnalyses' in item:
342	            analyses = item.get('cmeAnalyses', [])
343	            if analyses:
344	                result.append("  Analyses:")
345	                for analysis in analyses[:2]: # Limit analyses shown
346	                    result.append(f"    - Time: {analysis.get('time21_5', 'N/A')}, Speed: {analysis.get('speed', 'N/A')} km/s, Type: {analysis.get('type', 'N/A')}")
347	        
348	        # Example for GST:
349	        if id_key == 'gstID' and 'allKpIndex' in item:
350	             kp_indices = item.get('allKpIndex', [])
351	             if kp_indices:
352	                 result.append("  Kp Indices (first 2):")
353	                 for kp in kp_indices[:2]:
354	                     result.append(f"    - Time: {kp.get('observedTime', 'N/A')}, Index: {kp.get('kpIndex', 'N/A')}")
355	
356	        # Linked Events
357	        linked_events = item.get('linkedEvents', [])
358	        if linked_events:
359	            result.append("  Related event IDs (first 5):")
360	            result.append("    " + ", ".join([le.get('activityID', 'N/A') for le in linked_events[:5]]))
361	
362	        result.append("-" * 40)
363	        count += 1
364	        
365	    return "\n".join(result)
