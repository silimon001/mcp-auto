154	// ==================== OPENAPI SEARCH ====================
155	
156	async function searchOpenapi(providerId: string) {
157	  const urlResponse = await fetch(
158	    `https://openapisearch.com/redirect/${providerId}`,
159	    { redirect: "follow" }
160	  );
161	  if (!urlResponse.ok) {
162	    console.log("Not ok", providerId);
163	    return;
164	  }
165	  const openapiUrl = urlResponse.url;
166	
167	  const res = await fetch(openapiUrl);
168	  if (!res.ok) {
169	    console.log("Not ok", openapiUrl);
170	    return;
171	  }
172	
173	  const text = await res.text();
174	  let json = undefined;
175	
176	  try {
177	    json = JSON.parse(text);
178	  } catch (e) {
179	    try {
180	      json = load(text);
181	    } catch (e) {
182	      return;
183	    }
184	  }
185	
186	  const basePath = json.servers?.[0]?.url || new URL(openapiUrl).hostname;
187	  return { openapiUrl, openapiJson: json, basePath };
188	}
189	
190	// ==================== OVERVIEW GENERATOR ====================
191	
192	function generateOverview(hostname: string, openapi: OpenapiDocument): string {
193	  const output: string[] = [];
194	
195	  const getServerOrigin = (operation: any, rootServers: any[]): string => {
196	    const servers = operation?.servers || rootServers || [];
197	    if (servers.length === 0) return "";
198	    try {
199	      const url = new URL(servers[0].url);
200	      return url.origin;
201	    } catch (e) {
202	      return servers[0].url.split("/")[0];
203	    }
204	  };
205	
206	  if (openapi.info) {
207	    const { title, version, description } = openapi.info;
208	    const serverOrigin = getServerOrigin(undefined, openapi.servers || []);
209	    output.push(`${title} v${version} - ${serverOrigin}`);
210	    if (description) output.push(description);
211	    output.push("");
212	  }
213	
214	  const items: {
215	    operationId: string;
216	    pathPart: string;
217	    summaryPart: string;
218	    openapiUrl: string;
219	  }[] = [];
220	
221	  if (openapi.paths) {
222	    for (const [path, pathItem] of Object.entries(openapi.paths)) {
223	      const methods = ["get", "post", "put", "patch", "delete"];
224	
225	      for (const method of methods) {
226	        const operation = pathItem[method as keyof typeof pathItem];
227	        if (!operation) continue;
228	
229	        const serverOrigin = getServerOrigin(operation, openapi.servers || []);
230	        const operationId = operation.operationId
231	          ? `${operation.operationId}`
232	          : "";
233	
234	        const queryParams = operation.parameters
235	          ?.filter((p) => p.in === "query")
236	          ?.map((p) => `${p.name}=${p.schema?.type || p.name}`)
237	          ?.join("&");
238	
239	        const queryString = queryParams ? `?${queryParams}` : "";
240	        const summaryPart = operation.summary ? ` - ${operation.summary}` : "";
241	        const pathPart = `${method.toUpperCase()} ${serverOrigin}${path}${queryString}`;
242	        const openapiUrl = `https://oapis.org/openapi/${hostname}${
243	          operationId ? `/` + operationId : path
244	        }`;
245	
246	        items.push({ operationId, pathPart, summaryPart, openapiUrl });
247	      }
248	    }
249	  }
250	
251	  const isLong = JSON.stringify(items).length > 50000;
252	
253	  output.push(
254	    ...items.map(
255	      (item) =>
256	        `- ${item.operationId}${isLong ? " " : " " + item.pathPart}${
257	          item.summaryPart
258	        } ( Spec: ${item.openapiUrl} )`
259	    )
260	  );
261	
262	  const endpointCount = output.length - 3;
263	  output.unshift("");
264	  output.unshift(
265	    `Below is an overview of the ${hostname} openapi in simple language. This API contains ${endpointCount} endpoints. For more detailed information of an endpoint, visit https://oapis.org/summary/${hostname}/[idOrRoute]`
266	  );
267	
268	  return output.join("\n");
269	}
270	
271	// ==================== OPENAPI OPERATIONS ====================
272	
273	function matchOperation(openapi: OpenapiDocument, pathname: string) {
274	  if (!openapi.paths) {
275	    return;
276	  }
277	
278	  // First try direct path match
279	  const directMatch = openapi.paths[pathname]?.get;
280	  if (directMatch) {
281	    return {
282	      operation: directMatch,
283	      originalPath: pathname,
284	      method: "GET",
285	    };
286	  }
287	
288	  const normalizedPathname = pathname.slice(1);
289	
290	  // Then try operationId match
291	  for (const [path, pathItem] of Object.entries(openapi.paths)) {
292	    const matchingMethod = ["get", "post", "put", "patch", "delete"].find(
293	      (httpMethod) => {
294	        const operation = pathItem?.[httpMethod as keyof typeof pathItem];
295	        return operation?.operationId === normalizedPathname;
296	      }
297	    );
298	
299	    if (matchingMethod) {
300	      return {
301	        operation: pathItem[matchingMethod as keyof typeof pathItem],
302	        originalPath: path,
303	        method: matchingMethod.toUpperCase(),
304	      };
305	    }
306	  }
307	
308	  return undefined;
309	}
310	
311	// ==================== MCP HANDLERS ====================
312	
313	function getInitializeResult() {
314	  return {
315	    protocolVersion: "2025-06-18",
316	    capabilities: { tools: {} },
317	    serverInfo: {
318	      name: "openapi-mcp-server",
319	      version: "2.2.0",
320	      title: "OpenAPI MCP Server",
321	      websiteUrl: "https://openapisearch.com",
322	      description:
323	        "Explore and interact with OpenAPI specifications through MCP. Discover APIs from openapisearch.com or provide your own OpenAPI spec URL.",
324	      icons: [
325	        {
326	          src: "https://www.google.com/s2/favicons?domain=openapisearch.com&sz=48",
327	          sizes: ["32x32", "16x16", "48x48"],
328	        },
329	        {
330	          src: "https://www.google.com/s2/favicons?domain=openapisearch.com&sz=256",
331	          sizes: ["any"],
332	        },
333	      ],
334	    },
335	    instructions:
336	      "This MCP server provides access to OpenAPI specifications. Use 'getApiOverview' first to understand an API's structure, then use 'getApiOperation' to get details about specific endpoints.",
337	  };
338	}
339	
340	async function handleGetApiOverview(args: { id: string }) {
341	  const { id } = args;
342	
343	  if (!id) {
344	    return {
345	      content: [
346	        {
347	          type: "text",
348	          text: "Error: 'id' parameter is required",
349	        },
350	      ],
351	      isError: true,
352	    };
353	  }
354	
355	  try {
356	    const openapi = await searchOpenapi(id);
357	
358	    if (!openapi) {
359	      throw new Error("OpenAPI not found");
360	    }
361	
362	    const { openapiUrl, openapiJson } = openapi;
363	
364	    if (!openapiJson) {
365	      throw new Error("Could not parse OpenAPI JSON");
366	    }
367	
368	    const isSwagger =
369	      (openapiJson as any)?.swagger ||
370	      !openapiJson?.openapi ||
371	      !openapiJson?.openapi.startsWith("3.");
372	
373	    const convertedOpenapi = isSwagger
374	      ? await convertSwaggerToOpenapi(openapiUrl)
375	      : (openapiJson as OpenapiDocument);
376	
377	    if (!convertedOpenapi?.openapi) {
378	      throw new Error("Conversion failed");
379	    }
380	
381	    const overview = generateOverview(id, convertedOpenapi);
382	
383	    if (overview.length > 250000) {
384	      throw new Error(
385	        "The OpenAPI specification is too large to process with this MCP. Please try a different OpenAPI."
386	      );
387	    }
388	
389	    return {
390	      content: [{ type: "text", text: overview }],
391	      isError: false,
392	    };
393	  } catch (error: any) {
394	    return {
395	      content: [
396	        {
397	          type: "text",
398	          text: `Error: ${error.message}`,
399	        },
400	      ],
401	      isError: true,
402	    };
403	  }
404	}
405	
406	async function handleGetApiOperation(args: {
407	  id: string;
408	  operationIdOrRoute: string;
409	}) {
410	  const { id, operationIdOrRoute } = args;
411	
412	  if (!id || !operationIdOrRoute) {
413	    return {
414	      content: [
415	        {
416	          type: "text",
417	          text: "Error: Both 'id' and 'operationIdOrRoute' parameters are required",
418	        },
419	      ],
420	      isError: true,
421	    };
422	  }
423	
424	  try {
425	    const openapi = await searchOpenapi(id);
426	
427	    if (!openapi) {
428	      throw new Error("OpenAPI not found");
429	    }
430	
431	    const { openapiUrl, openapiJson } = openapi;
432	
433	    if (!openapiJson) {
434	      throw new Error("Could not parse OpenAPI JSON");
435	    }
436	
437	    const isSwagger =
438	      (openapiJson as any)?.swagger ||
439	      !openapiJson?.openapi ||
440	      !openapiJson?.openapi.startsWith("3.");
441	
442	    const convertedOpenapi = isSwagger
443	      ? await convertSwaggerToOpenapi(openapiUrl)
444	      : (openapiJson as OpenapiDocument);
445	
446	    if (!convertedOpenapi?.openapi) {
447	      throw new Error("Conversion failed");
448	    }
449	
450	    // Match the operation
451	    const op = matchOperation(convertedOpenapi, `/${operationIdOrRoute}`);
452	
453	    if (!op?.operation) {
454	      const operationIds = Object.values(convertedOpenapi.paths)
455	        .map((item) =>
456	          [
457	            item.get?.operationId,
458	            item.post?.operationId,
459	            item.delete?.operationId,
460	            item.put?.operationId,
461	            item.patch?.operationId,
462	          ]
463	            .filter(Boolean)
464	            .map((x) => x!)
465	        )
466	        .flat();
467	      const routes = Object.keys(convertedOpenapi.paths);
468	
469	      throw new Error(
470	        `Operation wasn't found. Available IDs: ${operationIds.join(
471	          ", "
472	        )}. Routes: ${routes.join(", ")}`
473	      );
474	    }
475	
476	    // Get the subset for this operation
477	    const subset = {
478	      ...convertedOpenapi,
479	      paths: {
480	        [op.originalPath]: {
481	          [op.method.toLowerCase()]: op.operation,
482	        },
483	      },
484	    };
485	
486	    try {
487	      const { tags, webhooks, components, ...dereferenced } = dereferenceSync(
488	        subset
489	      ) as OpenapiDocument;
490	
491	      return {
492	        content: [{ type: "text", text: dump(dereferenced) }],
493	        isError: false,
494	      };
495	    } catch {
496	      return {
497	        content: [{ type: "text", text: dump(subset) }],
498	        isError: false,
499	      };
500	    }
501	  } catch (error: any) {
502	    return {
503	      content: [
504	        {
505	          type: "text",
506	          text: `Error: ${error.message}`,
507	        },
508	      ],
509	      isError: true,
510	    };
511	  }
512	}
513	
514	// ==================== MCP HANDLER ====================
515	
516	async function handleMcp(request: Request) {
517	  // Handle SSE rejection
518	  if (
519	    request.method === "GET" &&
520	    request.headers.get("accept")?.includes("text/event-stream")
521	  ) {
522	    return new Response("Only Streamable HTTP is supported", {
523	      status: 405,
524	      headers: corsHeaders,
525	    });
526	  }
527	
528	  if (request.method === "GET") {
529	    const initializeResult = getInitializeResult();
530	    return new Response(JSON.stringify(initializeResult, null, 2), {
531	      headers: {
532	        "Content-Type": "application/json",
533	        ...corsHeaders,
534	      },
535	    });
536	  }
537	
538	  if (request.method !== "POST") {
539	    return new Response("Method not allowed", {
540	      status: 405,
541	      headers: corsHeaders,
542	    });
543	  }
544	
545	  try {
546	    const message = await request.json();
547	
548	    // Handle ping
549	    if (message.method === "ping") {
550	      return jsonRpcResponse(message.id, {});
551	    }
552	
553	    // Handle initialize
554	    if (message.method === "initialize") {
555	      return jsonRpcResponse(message.id, getInitializeResult());
556	    }
557	
558	    // Handle initialized notification
559	    if (message.method === "notifications/initialized") {
560	      return new Response(null, {
561	        status: 202,
562	        headers: corsHeaders,
563	      });
564	    }
565	
566	    // Handle prompts/list
567	    if (message.method === "prompts/list") {
568	      return jsonRpcResponse(message.id, { prompts: [] });
569	    }
570	
571	    // Handle resources/list
572	    if (message.method === "resources/list") {
573	      return jsonRpcResponse(message.id, { resources: [] });
574	    }
575	
576	    // Handle resources/read
577	    if (message.method === "resources/read") {
578	      const { uri } = message.params;
579	      return jsonRpcError(message.id, -32602, `Resource not found: ${uri}`);
580	    }
581	
582	    // Handle tools/list
583	    if (message.method === "tools/list") {
584	      const openapiIds = await fetch("https://openapisearch.com/").then((res) =>
585	        res.text()
586	      );
587	
588	      const tools = [
589	        {
590	          name: "getApiOverview",
591	          title: "Get API Overview",
592	          description: `Get an overview of an OpenAPI specification. This should be the first step when working with any API.\n\n${openapiIds}`,
593	          inputSchema: {
594	            type: "object",
595	            properties: {
596	              id: {
597	                type: "string",
598	                description:
599	                  "API identifier, can be a known ID from openapisearch.com or a URL leading to a raw OpenAPI file",
600	              },
601	            },
602	            required: ["id"],
603	          },
604	        },
605	        {
606	          name: "getApiOperation",
607	          title: "Get API Operation",
608	          description: `Get details about a specific operation from an OpenAPI specification. Use this after getting an overview.\n\n${openapiIds}`,
609	          inputSchema: {
610	            type: "object",
611	            properties: {
612	              id: {
613	                type: "string",
614	                description:
615	                  "API identifier, can be a known ID from openapisearch.com or a URL leading to a raw OpenAPI file",
616	              },
617	              operationIdOrRoute: {
618	                type: "string",
619	                description: "Operation ID or route path to retrieve",
620	              },
621	            },
622	            required: ["id", "operationIdOrRoute"],
623	          },
624	        },
625	      ];
626	
627	      return jsonRpcResponse(message.id, { tools });
628	    }
629	
630	    // Handle tools/call
631	    if (message.method === "tools/call") {
632	      const { name, arguments: args } = message.params;
633	
634	      try {
635	        let result;
636	
637	        if (name === "getApiOverview") {
638	          result = await handleGetApiOverview(args);
639	        } else if (name === "getApiOperation") {
640	          result = await handleGetApiOperation(args);
641	        } else {
642	          return jsonRpcResponse(message.id, {
643	            content: [
644	              {
645	                type: "text",
646	                text: `Error: Unknown tool: ${name}`,
647	              },
648	            ],
649	            isError: true,
650	          });
651	        }
652	
653	        return jsonRpcResponse(message.id, result);
654	      } catch (error: any) {
655	        return jsonRpcResponse(message.id, {
656	          content: [
657	            {
658	              type: "text",
659	              text: `Error executing tool: ${error.message}`,
660	            },
661	          ],
662	          isError: true,
663	        });
664	      }
665	    }
666	
667	    // Method not found
668	    return jsonRpcError(
669	      message.id,
670	      -32601,
671	      `Method not found: ${message.method}`
672	    );
673	  } catch (error) {
674	    return jsonRpcError(null, -32700, "Parse error");
675	  }
676	}
677	
678	function jsonRpcResponse(id: any, result: any) {
679	  return new Response(
680	    JSON.stringify(
681	      {
682	        jsonrpc: "2.0",
683	        id,
684	        result,
685	      },
686	      null,
687	      2
688	    ),
689	    {
690	      headers: {
691	        "Content-Type": "application/json",
692	        ...corsHeaders,
693	      },
694	    }
695	  );
696	}
697	
698	function jsonRpcError(id: any, code: number, message: string) {
699	  return new Response(
700	    JSON.stringify({ jsonrpc: "2.0", id, error: { code, message } }, null, 2),
701	    {
702	      headers: {
703	        "Content-Type": "application/json",
704	        ...corsHeaders,
705	      },
706	    }
707	  );
708	}
709	
710	// ==================== MAIN EXPORT ====================
711	
712	export default {
713	  async fetch(request: Request) {
714	    // Handle CORS preflight
715	    if (request.method === "OPTIONS") {
716	      return new Response(null, {
717	        status: 204,
718	        headers: corsHeaders,
719	      });
720	    }
721	
722	    const url = new URL(request.url);
723	    const path = url.pathname;
724	
725	    // Root redirect
726	    if (path === "/") {
727	      return new Response(null, { status: 302, headers: { Location: "/mcp" } });
728	    }
729	
730	    // Only handle /mcp endpoint
731	    if (path !== "/mcp") {
732	      return new Response("Not found", { status: 404, headers: corsHeaders });
733	    }
734	
735	    return handleMcp(request);
736	  },
737	};
