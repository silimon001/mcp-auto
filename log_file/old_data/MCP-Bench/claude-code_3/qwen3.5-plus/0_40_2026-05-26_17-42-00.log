712	        return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
713	    if isinstance(data, dict) and data.get("binary_content"):
714	        return f"Received unexpected binary content from Notifications API. URL: {data.get('url')}"
715	
716	    try:
717	        # Ensure data is a list
718	        if not isinstance(data, list):
719	            logger.error(f"Unexpected non-list response from Notifications API: {data}")
720	            return "Received unexpected data format from Notifications API."
721	            
722	        # Format notifications results
723	        if not data: 
724	            return "No notifications for the specified period and type."
725	            
726	        result = [f"Notifications found: {len(data)}"]
727	        display_limit = 10
728	        count = 0
729	        for notification in data:
730	            if count >= display_limit: 
731	                result.append(f"\n... and {len(data) - display_limit} more notifications.")
732	                break
733	            result.append(f"\nID: {notification.get('messageID', 'Unknown')}")
734	            result.append(f"Type: {notification.get('messageType', 'Unknown')}")
735	            result.append(f"Issue Time: {notification.get('messageIssueTime', 'Unknown')}")
736	            result.append(f"Header: {notification.get('messageHeader', 'N/A')}")
737	            # Body can be long, maybe truncate
738	            body = notification.get('messageBody', 'N/A')
739	            result.append(f"Body: {body[:200]}{'...' if len(body) > 200 else ''}") 
740	            result.append("-" * 40)
741	            count += 1
742	        return "\n".join(result)
743	    except Exception as e:
744	        logger.error(f"Error processing Notifications data: {str(e)}")
745	        return f"Error processing notifications: {str(e)}"
