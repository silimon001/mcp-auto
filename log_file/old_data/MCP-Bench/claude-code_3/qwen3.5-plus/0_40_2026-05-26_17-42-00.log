1199	# ---------------------- Mars Rover Photos ----------------------
1200	
1201	# Define valid rovers and their cameras
1202	ROVER_CAMERAS = {
1203	    "curiosity": ["FHAZ", "RHAZ", "MAST", "CHEMCAM", "MAHLI", "MARDI", "NAVCAM"],
1204	    "opportunity": ["FHAZ", "RHAZ", "NAVCAM", "PANCAM", "MINITES"],
1205	    "spirit": ["FHAZ", "RHAZ", "NAVCAM", "PANCAM", "MINITES"]
1206	}
1207	
1208	@mcp.tool()
1209	async def get_mars_rover_photos(rover_name: str, sol: int = None, earth_date: str = None, camera: str = None, page: int = 1) -> str:
1210	    """Get photos from a Mars rover (Curiosity, Opportunity, Spirit).
1211	    Specify either sol (Martian day) or earth_date (YYYY-MM-DD), but not both.
1212	    
1213	    Args:
1214	        rover_name: Name of the rover (curiosity, opportunity, spirit).
1215	        sol: Martian sol (day number, starting from landing). Use if not using earth_date.
1216	        earth_date: Earth date in YYYY-MM-DD format. Use if not using sol.
1217	        camera: Filter by camera abbreviation (e.g., FHAZ, RHAZ, MAST, NAVCAM, PANCAM). See documentation for full list per rover.
1218	        page: Page number for results (25 photos per page).
1219	    """
1220	    rover_name = rover_name.lower()
1221	    if rover_name not in ROVER_CAMERAS:
1222	        return f"Invalid rover name. Available rovers: {', '.join(ROVER_CAMERAS.keys())}"
1223	    
1224	    if sol is not None and earth_date is not None:
1225	        return "Error: Specify either sol or earth_date, but not both."
1226	    if sol is None and earth_date is None:
1227	        return "Error: Specify either sol or earth_date."
1228	        
1229	    params = {"page": page}
1230	    if sol is not None:
1231	        params["sol"] = sol
1232	    if earth_date is not None:
1233	        params["earth_date"] = earth_date
1234	        
1235	    if camera:
1236	        camera = camera.upper()
1237	        if camera not in ROVER_CAMERAS[rover_name]:
1238	            return f"Invalid camera '{camera}' for rover '{rover_name}'. Available cameras: {', '.join(ROVER_CAMERAS[rover_name])}"
1239	        params["camera"] = camera
1240	        
1241	    url = f"{NASA_API_BASE}/mars-photos/api/v1/rovers/{rover_name}/photos"
1242	    data = await make_nasa_request(url, params)
1243	    
1244	    if not data:
