719	    async def get_free_games(self) -> List[Dict[str, Any]]:
720	        # SSL doğrulamasını devre dışı bırak
721	        ssl_context = ssl.create_default_context()
722	        ssl_context.check_hostname = False
723	        ssl_context.verify_mode = ssl.CERT_NONE
724	        
725	        connector = aiohttp.TCPConnector(ssl=ssl_context)
726	        async with aiohttp.ClientSession(connector=connector) as session:
727	            url = f"{self.base_url}?locale=en-US&country=US&allowCountries=US"
728	            headers = {
729	                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
730	                "Accept": "application/json",
731	            }
732	            try:
733	                async with session.get(
734	                    url, headers=headers, timeout=15
735	                ) as response:
736	                    response.raise_for_status()
737	                    data = await response.json()
738	            except Exception as e:
739	                print(
740	                    f"[{datetime.now()}] EpicGamesService: Failed to fetch Epic free games: {e}"
741	                )
742	                return []
743	
744	            games_data = (
745	                data.get("data", {})
746	                .get("Catalog", {})
747	                .get("searchStore", {})
748	                .get("elements", [])
749	            )
750	            if not games_data:
751	                print(
752	                    f"[{datetime.now()}] EpicGamesService: No games found in Epic Games free games API response"
753	                )
754	                return []
755	
756	            filtered_games = []
757	            for game in games_data:
758	                try:
759	                    promotions = game.get("promotions", {})
760	                    current_promos = promotions.get("promotionalOffers", [])
761	                    upcoming_promos = promotions.get(
762	                        "upcomingPromotionalOffers", []
763	                    )
764	
765	                    is_free_now, promotion_details = False, None
766	                    if current_promos and current_promos[0].get(
767	                        "promotionalOffers"
768	                    ):
769	                        offer = current_promos[0]["promotionalOffers"][0]
770	                        if (
771	                            offer.get("discountSetting", {}).get(
772	                                "discountPercentage"
773	                            )
774	                            == 0
775	                            and offer.get("endDate")
776	                        ):
777	                            is_free_now = True
778	                            promotion_details = {
779	                                "startDate": offer.get("startDate"),
780	                                "endDate": offer.get("endDate"),
781	                                "type": "current",
782	                            }
783	
784	                    is_upcoming_free, upcoming_promotion_details = False, None
785	                    if not is_free_now and upcoming_promos and upcoming_promos[0].get("promotionalOffers"):
786	                        offer = upcoming_promos[0]["promotionalOffers"][0]
787	                        if (
788	                            offer.get("discountSetting", {}).get(
789	                                "discountPercentage"
790	                            )
791	                            == 0
792	                            and offer.get("endDate")
793	                        ):
794	                            is_upcoming_free = True
795	                            upcoming_promotion_details = {
796	                                "startDate": offer.get("startDate"),
797	                                "endDate": offer.get("endDate"),
798	                                "type": "upcoming",
799	                            }
800	                    
801	                    if not is_free_now and not is_upcoming_free:
802	                        continue
803	
804	                    price_info = game.get("price", {}).get("totalPrice", {})
805	                    discount_price = price_info.get("discountPrice", 0)
806	                    if not (discount_price == 0 and (is_free_now or is_upcoming_free)):
807	                        continue
808	
809	
810	                    product_slug = game.get("productSlug") or (game.get("offerMappings", [{}])[0].get("pageSlug") if game.get("offerMappings") else None)
811	                    game_url = f"https://store.epicgames.com/en-US/p/{product_slug}" if product_slug else None
812	                    if not game_url and game.get('catalogNs',{}).get('mappings'): # Fallback for URL from mappings
813	                        for mapping in game['catalogNs']['mappings']:
814	                            if mapping.get('pageType') == 'productHome':
815	                                game_url = f"https://store.epicgames.com/en-US/p/{mapping.get('pageSlug')}"
816	                                if not product_slug: product_slug = mapping.get('pageSlug')
817	                                break
818	
819	
820	                    filtered_games.append(
821	                        {
822	                            "id": game.get("id"),
823	                            "namespace": game.get("namespace"),
824	                            "name": game.get("title"),
825	                            "description": game.get("description"),
826	                            "originalPrice": price_info.get("fmtPrice", {}).get(
827	                                "originalPrice", "N/A"
828	                            ),
829	                            "discountPrice": price_info.get("fmtPrice", {}).get(
830	                                "discountPrice", "Free"
831	                            ),
832	                            "platform": "Epic Games",
833	                            "developer": game.get("developerDisplayName"),
834	                            "publisher": game.get("publisherDisplayName"),
835	                            "releaseDate": game.get("releaseDate")
836	                            or game.get("effectiveDate"),
837	                            "tags": [
838	                                tag.get("name")
839	                                for tag in game.get("tags", [])
840	                                if tag.get("name")
841	                            ],
842	                            "images": [
843	                                {"type": img.get("type"), "url": img.get("url")}
844	                                for img in game.get("keyImages", [])
845	                                if img.get("url")
846	                            ],
847	                            "isFreeNow": is_free_now,
848	                            "isUpcomingFree": is_upcoming_free,
849	                            "promotionDetails": promotion_details
850	                            if is_free_now
851	                            else upcoming_promotion_details,
852	                            "productSlug": product_slug,
853	                            "url": game_url,
854	                            "source": "epic_free_games_api"
855	                        }
856	                    )
857	                except Exception as e:
858	                    print(
859	                        f"[{datetime.now()}] EpicGamesService: Error processing one Epic free game: {e} - Game: {game.get('title')}"
860	                    )
861	                    continue
862	            if not filtered_games:
863	                print(
864	                    f"[{datetime.now()}] EpicGamesService: No free games with active/upcoming promotions found after filtering."
865	                )
866	            return filtered_games[:15]
