678	function jsonRpcResponse(id: any, result: any) {
679	  return new Response(
680	    JSON.stringify(
681	      {
682	        jsonrpc: "2.0",
683	        id,
684	        result,
685	      },
686	      null,
687	      2
688	    ),
689	    {
690	      headers: {
691	        "Content-Type": "application/json",
692	        ...corsHeaders,
693	      },
694	    }
695	  );
696	}
697	
698	function jsonRpcError(id: any, code: number, message: string) {
699	  return new Response(
700	    JSON.stringify({ jsonrpc: "2.0", id, error: { code, message } }, null, 2),
701	    {
702	      headers: {
703	        "Content-Type": "application/json",
704	        ...corsHeaders,
705	      },
706	    }
707	  );
708	}
709	
710	// ==================== MAIN EXPORT ====================
711	
712	export default {
713	  async fetch(request: Request) {
714	    // Handle CORS preflight
715	    if (request.method === "OPTIONS") {
716	      return new Response(null, {
717	        status: 204,
718	        headers: corsHeaders,
719	      });
720	    }
721	
722	    const url = new URL(request.url);
723	    const path = url.pathname;
724	
725	    // Root redirect
726	    if (path === "/") {
727	      return new Response(null, { status: 302, headers: { Location: "/mcp" } });
728	    }
729	
730	    // Only handle /mcp endpoint
731	    if (path !== "/mcp") {
732	      return new Response("Not found", { status: 404, headers: corsHeaders });
733	    }
734	
735	    return handleMcp(request);
736	  },
737	};
