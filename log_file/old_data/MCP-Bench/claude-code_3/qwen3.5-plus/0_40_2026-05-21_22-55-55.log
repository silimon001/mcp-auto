516	async function handleMcp(request: Request) {
517	  // Handle SSE rejection
518	  if (
519	    request.method === "GET" &&
520	    request.headers.get("accept")?.includes("text/event-stream")
521	  ) {
522	    return new Response("Only Streamable HTTP is supported", {
523	      status: 405,
