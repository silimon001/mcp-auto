157	            'caminhao': 'caminhoes',
158	            'caminhoes': 'caminhoes'
159	        }
160	        
161	        api_type = type_mapping.get(vehicle_type.lower(), 'carros')
162	        
163	        url = f"https://parallelum.com.br/fipe/api/v1/{api_type}/marcas"
164	        response = requests.get(url, timeout=10)
165	        
166	        if response.status_code != 200:
167	            return f"Error: Could not fetch {vehicle_type} brands (Status: {response.status_code})"
168	        
169	        brands = response.json()
170	        
171	        if not brands:
172	            return f"No {vehicle_type} brands found"
173	        
174	        # Format vehicle type info
175	        type_emoji = "🚗" if api_type == "carros" else "🏍️" if api_type == "motos" else "🚛"
176	        vehicles_info = f"{type_emoji} **{vehicle_type.title()} Brands** {type_emoji}\n\n"
177	        
178	        # Show first 15 brands
179	        for i, brand in enumerate(brands[:15], 1):
180	            vehicles_info += f"**{i}. {brand['nome']}** (Code: {brand['codigo']})\n"
181	        
182	        if len(brands) > 15:
183	            vehicles_info += f"\n*...and {len(brands)-15} more brands*\n"
184	        
185	        vehicles_info += f"\n**Total Brands:** {len(brands)}\n"
186	        vehicles_info += f"*Use searchCarPrice with brand name to get specific models and prices*"
187	        
188	        return vehicles_info
189	        
190	    except Exception as e:
191	        return f"Error fetching {vehicle_type} brands: {str(e)}"
