66	        # Search for brand by name (case insensitive)
67	        query_lower = query.lower()
68	        found_brand = None
69	        
70	        for brand in brands:
71	            if query_lower in brand['nome'].lower():
72	                found_brand = brand
73	                break
74	        
75	        if not found_brand:
76	            # If no brand found, show available brands
77	            brand_names = [brand['nome'] for brand in brands[:10]]
78	            return f"Brand '{query}' not found. Available brands include: {', '.join(brand_names)}..."
79	        
80	        # Get models for the found brand
81	        models_url = f"https://parallelum.com.br/fipe/api/v1/carros/marcas/{found_brand['codigo']}/modelos"
82	        response = requests.get(models_url, timeout=10)
83	        
84	        if response.status_code != 200:
85	            return f"Error: Could not fetch models for {found_brand['nome']} (Status: {response.status_code})"
86	        
87	        models_data = response.json()
88	        models = models_data.get("modelos", [])
89	        
90	        if not models:
91	            return f"No models found for {found_brand['nome']}"
92	        
93	        # Get price for first 3 models
94	        car_info = f"🚗 **{found_brand['nome']} Models & Prices** 🚗\n\n"
95	        
96	        for i, model in enumerate(models[:3]):  # Show first 3 models
97	            try:
98	                # Get years for this model
99	                years_url = f"https://parallelum.com.br/fipe/api/v1/carros/marcas/{found_brand['codigo']}/modelos/{model['codigo']}/anos"
100	                years_response = requests.get(years_url, timeout=10)
101	                
102	                if years_response.status_code == 200:
103	                    years = years_response.json()
104	                    if years:
105	                        # Get price for most recent year
106	                        latest_year = years[0]
107	                        price_url = f"https://parallelum.com.br/fipe/api/v1/carros/marcas/{found_brand['codigo']}/modelos/{model['codigo']}/anos/{latest_year['codigo']}"
108	                        price_response = requests.get(price_url, timeout=10)
109	                        
110	                        if price_response.status_code == 200:
111	                            price_data = price_response.json()
112	                            
113	                            car_info += f"**{i+1}. {model['nome']}**\n"
114	                            car_info += f"📅 **Year:** {price_data.get('AnoModelo', 'N/A')}\n"
115	                            car_info += f"⛽ **Fuel:** {price_data.get('Combustivel', 'N/A')}\n"
116	                            car_info += f"💰 **Price:** {price_data.get('Valor', 'N/A')}\n"
117	                            car_info += f"📊 **Reference:** {price_data.get('MesReferencia', 'N/A')}\n"
118	                            car_info += f"🔢 **FIPE Code:** {price_data.get('CodigoFipe', 'N/A')}\n\n"
119	                        else:
120	                            car_info += f"**{i+1}. {model['nome']}** - Price not available\n\n"
121	                    else:
122	                        car_info += f"**{i+1}. {model['nome']}** - No years available\n\n"
123	                else:
124	                    car_info += f"**{i+1}. {model['nome']}** - Years not available\n\n"
125	                    
126	            except Exception as model_error:
127	                car_info += f"**{i+1}. {model['nome']}** - Error: {str(model_error)}\n\n"
128	        
129	        if len(models) > 3:
130	            car_info += f"*...and {len(models)-3} more models available*\n"
131	        
132	        car_info += f"\n**Total Models:** {len(models)}\n"
133	        car_info += "*Prices are from FIPE (Brazilian vehicle price reference)*"
134	        
135	        return car_info
