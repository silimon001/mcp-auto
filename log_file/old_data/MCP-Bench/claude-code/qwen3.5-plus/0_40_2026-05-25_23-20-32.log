408	   * @param parkCode The park code (e.g., 'yose' for Yosemite)
409	   * @returns Promise with the park's alerts
410	   */
411	  async getAlertsByParkCode(parkCode: string): Promise<NPSResponse<AlertData>> {
412	    try {
