221	def collect_messages(events):
222	    """聚合事件，记录时间戳，并捕获 result 事件用于总结"""
223	    messages = {}
224	    order = []      # dict(system/user/result) 或 str(assistant msg_id)
225	
226	    for event in events:
227	        etype = event.get("type")
228	        ts = event.get("timestamp") or event.get("_received_at", datetime.now(timezone.utc).isoformat())
229	
230	        # -------- system --------
231	        if etype == "system":
232	            order.append({
233	                "type": "system",
234	                "content": f"[SYSTEM] {event.get('subtype', '')}",
235	                "timestamp": ts
236	            })
237	            continue
238	
239	        # -------- user --------
240	        if etype == "user":
241	            contents = event.get("message", {}).get("content", [])
242	            text = render_content(contents)
243	            order.append({
244	                "type": "user",
245	                "content": text,
246	                "timestamp": ts
247	            })
248	            continue
249	
250	        # -------- result (最终总结) --------
251	        if etype == "result":
252	            order.append({
253	                "type": "result",
254	                "timestamp": ts,
255	                "data": {
256	                    "subtype": event.get("subtype"),
257	                    "is_error": event.get("is_error"),
258	                    "num_turns": event.get("num_turns"),
259	                    "stop_reason": event.get("stop_reason"),
260	                    "total_cost_usd": event.get("total_cost_usd"),
261	                    "duration_ms": event.get("duration_ms"),
262	                    "duration_api_ms": event.get("duration_api_ms"),
263	                    "usage": event.get("usage", {}),
264	                    "errors": event.get("errors", []),
265	                    "terminal_reason": event.get("terminal_reason")
266	                }
267	            })
268	            continue
269	
270	        # -------- assistant --------
271	        if etype == "assistant":
272	            msg = event.get("message", {})
273	            msg_id = msg.get("id")
274	
275	            if msg_id not in messages:
276	                messages[msg_id] = {
277	                    "type": "assistant",
278	                    "texts": [],
279	                    "tools": [],
280	                    "tokens": None,
281	                    "timestamp": ts
282	                }
283	                order.append(msg_id)     # 保证顺序
284	
285	            entry = messages[msg_id]
286	
287	            for c in msg.get("content", []):
288	                ctype = c.get("type")
289	                if ctype == "text":
290	                    entry["texts"].append(c.get("text", ""))
291	                elif ctype == "tool_use":
292	                    entry["tools"].append({
293	                        "name": c.get("name"),
294	                        "input": c.get("input")
295	                    })
296	
297	            if msg.get("usage"):
298	                entry["tokens"] = {
299	                    "input": msg["usage"].get("input_tokens"),
300	                    "output": msg["usage"].get("output_tokens")
301	                }
302	
303	    return messages, order
304	
305	def write_log(messages, order, log_file):
306	    """按轮次和时间戳输出，末尾附加任务结果总结"""
307	    turn = 0
308	    with open(log_file, "a", encoding="utf-8") as f:
309	        for item in order:
310	            # -------- 结果总结（直接输出，不改变轮次）--------
311	            if isinstance(item, dict) and item.get("type") == "result":
312	                ts = item.get("timestamp", "")
313	                data = item["data"]
314	
315	                f.write(f"\n{'=' * 60}\n")
316	                f.write(f"[RESULT] [TIMESTAMP {ts}]\n")
317	                f.write(f"  状态: {'❌ 失败' if data['is_error'] else '✅ 成功'}\n")
318	                f.write(f"  子类型: {data['subtype']}\n")
319	                f.write(f"  实际轮次: {data['num_turns']}\n")
320	                f.write(f"  停止原因: {data['stop_reason']}\n")
321	                f.write(f"  终端原因: {data['terminal_reason']}\n")
322	                f.write(f"  耗时: {data['duration_ms']} ms (API: {data['duration_api_ms']} ms)\n")
323	                f.write(f"  成本: ${data['total_cost_usd']:.6f}\n")
324	
325	                usage = data.get("usage", {})
326	                if usage:
327	                    f.write(f"  Token 使用:\n")
328	                    f.write(f"    - 输入: {usage.get('input_tokens', '?')}\n")
329	                    f.write(f"    - 输出: {usage.get('output_tokens', '?')}\n")
330	                    f.write(f"    - 缓存创建: {usage.get('cache_creation_input_tokens', '?')}\n")
331	                    f.write(f"    - 缓存读取: {usage.get('cache_read_input_tokens', '?')}\n")
332	
333	                errors = data.get("errors", [])
334	                if errors:
335	                    f.write(f"  错误信息:\n")
336	                    for err in errors:
337	                        f.write(f"    - {err}\n")
338	                f.write(f"{'=' * 60}\n")
339	                continue   # result 块输出完毕，跳过后续普通处理
340	
341	            # -------- system / user --------
342	            if isinstance(item, dict):
343	                role = item["type"].upper()
344	                ts = item.get("timestamp", "")
345	                f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
346	                f.write(f"[{role}]:\n{item['content']}\n")
347	                f.write("\n" + "-" * 60 + "\n")
348	                continue
349	
350	            # -------- assistant --------
351	            turn += 1
352	            msg = messages[item]
353	            ts = msg.get("timestamp", "")
354	            f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
355	
356	            text = "\n".join(msg["texts"]).strip()
357	            if text:
358	                f.write(f"[ASSISTANT]:\n{text}\n")
359	
360	            for tool in msg["tools"]:
361	                f.write(f"[ASSISTANT][TOOL]: {tool['name']}\n")
362	                f.write("[TOOL INPUT]:\n")
363	                f.write(json.dumps(tool["input"], indent=2, ensure_ascii=False))
364	                f.write("\n")
365	
366	            if msg["tokens"]:
367	                t = msg["tokens"]
368	                f.write(f"[TOKENS] input={t['input']} output={t['output']}\n")
369	
370	            f.write("\n" + "-" * 60 + "\n")
371	
