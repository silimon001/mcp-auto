19	def run_claude_stream(prompt_text: str, json_log_path: str):
20	
21	    import threading
22	    import queue
23	
24	    process = subprocess.Popen(
25	        [
26	            "claude-tap",
27	            "--tap-no-live",
28	            "--",
29	            "--print",
30	            "--verbose",
31	            "--max-turns", "20",
32	            "--output-format", "stream-json",
33	            "--permission-mode", "bypassPermissions"
34	        ],
35	        stdin=subprocess.PIPE,
36	        stdout=subprocess.PIPE,
37	        stderr=subprocess.PIPE,
38	        text=True,
39	        encoding="utf-8",
40	        bufsize=1
41	    )
42	
43	    # =========================
44	    # 输入 prompt
45	    # =========================
46	    process.stdin.write(prompt_text)
47	    process.stdin.close()
48	
49	    events = []
50	    stderr_lines = []
51	
52	    # 用 queue 做线程安全通信
53	    stdout_queue = queue.Queue()
54	    stderr_queue = queue.Queue()
55	
56	    # =========================
57	    # 后台消费 stdout
58	    # =========================
59	    def read_stdout():
60	        try:
61	            for line in iter(process.stdout.readline, ''):
62	                stdout_queue.put(line)
63	        except Exception as e:
64	            stdout_queue.put(f"__ERROR__:{e}")
65	        finally:
66	            stdout_queue.put(None)
67	
68	    # =========================
69	    # 后台消费 stderr
70	    # =========================
71	    def read_stderr():
72	        try:
73	            for line in iter(process.stderr.readline, ''):
74	                stderr_queue.put(line)
75	                stderr_lines.append(line)
76	        except Exception as e:
77	            stderr_queue.put(f"__ERROR__:{e}")
78	        finally:
79	            stderr_queue.put(None)
80	
81	    stdout_thread = threading.Thread(target=read_stdout, daemon=True)
82	    stderr_thread = threading.Thread(target=read_stderr, daemon=True)
83	
84	    stdout_thread.start()
85	    stderr_thread.start()
86	
87	    got_result = False
88	
89	    # =========================
90	    # 主事件循环
91	    # =========================
92	    with open(json_log_path, "a", encoding="utf-8") as jf:
93	
94	        while True:
95	
96	            try:
97	                line = stdout_queue.get(timeout=1)
98	
99	            except queue.Empty:
100	
101	                # 已收到 result，则不再继续等待
102	                if got_result:
103	                    break
104	
105	                # 子进程退出
106	                if process.poll() is not None:
107	                    break
108	
109	                continue
110	
111	            # stdout EOF
112	            if line is None:
113	                break
114	
115	            line = line.strip()
116	
117	            if not line:
118	                continue
119	
120	            try:
121	                obj = json.loads(line)
122	
123	                obj["_received_at"] = datetime.now(
124	                    timezone.utc
125	                ).isoformat()
126	
127	                events.append(obj)
128	
129	                jf.write(
130	                    json.dumps(
131	                        obj,
132	                        ensure_ascii=False
133	                    ) + "\n"
134	                )
135	
136	                # 减少 flush 开销
137	                jf.flush()
138	
139	                # =========================
140	                # 收到最终 result
141	                # =========================
142	                if obj.get("type") == "result":
143	
144	                    got_result = True
145	
146	                    # 非常关键：
147	                    # 不再等待 Claude 主进程自然退出
148	                    try:
149	                        process.terminate()
150	                    except Exception:
151	                        pass
152	
153	                    break
154	
155	            except json.JSONDecodeError:
156	                continue
157	
158	            except Exception as e:
159	                print(f"⚠️ JSON parse error: {e}")
160	
161	    # =========================
162	    # 等待退出
163	    # =========================
164	    try:
165	        process.wait(timeout=5)
166	
167	    except subprocess.TimeoutExpired:
168	
169	        print("⚠️ Claude process timeout, killing...")
170	
171	        try:
172	            process.kill()
173	        except Exception:
174	            pass
175	
176	    # =========================
177	    # 确保线程结束
178	    # =========================
179	    stdout_thread.join(timeout=1)
180	    stderr_thread.join(timeout=1)
181	
182	    stderr = "".join(stderr_lines)
183	
184	    return events, stderr
