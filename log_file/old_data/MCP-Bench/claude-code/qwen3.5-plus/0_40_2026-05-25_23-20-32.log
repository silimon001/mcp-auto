186	def render_content(obj):
187	    """
188	    把 Claude stream-json content 递归展开成纯 string
189	    """
190	    if obj is None:
191	        return ""
192	
193	    # str
194	    if isinstance(obj, str):
195	        return obj
196	
197	    # dict（核心：Claude node）
198	    if isinstance(obj, dict):
199	        t = obj.get("type")
200	
201	        # tool result wrapper
202	        if t == "text":
203	            return render_content(obj.get("text"))
204	
205	        if t == "tool_result":
206	            return render_content(obj.get("content"))
207	
208	        # fallback：尽量抽取 text
209	        if "text" in obj:
210	            return render_content(obj["text"])
211	
212	        return json.dumps(obj, ensure_ascii=False)
213	
214	    # list（递归 flatten）
215	    if isinstance(obj, list):
216	        return "\n".join(render_content(x) for x in obj)
217	
218	    # fallback
219	    return str(obj)
