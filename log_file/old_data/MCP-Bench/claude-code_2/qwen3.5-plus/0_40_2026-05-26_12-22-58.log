12	MAIN_CWD = Path(os.path.dirname(os.getcwd()))
13	
14	LOG_DIR = MAIN_CWD / "log_file" / dataset_name / (framework_name) / model_name
15	LOG_DIR.mkdir(parents=True, exist_ok=True)
16	
17	timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
