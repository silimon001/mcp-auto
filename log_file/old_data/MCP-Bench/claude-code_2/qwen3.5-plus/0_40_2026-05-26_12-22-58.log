1	from __future__ import annotations
2	
3	import json
4	import re
5	from collections import OrderedDict
6	from dataclasses import dataclass, field
7	from pathlib import Path
8	from typing import List
9	
10	
11	# ============================================================
12	# 1. 正则
13	# ============================================================
14	
15	# RESULT block
16	RESULT_RE = re.compile(
17	    r"=+\s*\n\[RESULT\].*?(?=\n=+|\Z)",
18	    re.MULTILINE | re.DOTALL
19	)
20	
21	# TURN
22	TURN_RE = re.compile(
23	    r"\[TURN\s+(\d+)\]"
24	)
25	
26	# TOOL
27	TOOL_RE = re.compile(
28	    r"\[ASSISTANT\]\[TOOL\]:\s*(.+)"
29	)
30	
31	# assistant 普通输出
32	ASSISTANT_RE = re.compile(
33	    r"\[ASSISTANT\](?!\[TOOL\])\s*:?(.*)",
34	)
35	
36	# RESULT 状态
37	RESULT_FAIL_RE = re.compile(
38	    r"状态:\s*❌\s*失败"
39	)
40	
41	RESULT_SUCCESS_RE = re.compile(
42	    r"状态:\s*✅\s*成功"
43	)
44	
45	# DONE / FAILED FLAG
46	DONE_LINE_RE = re.compile(
47	    r"^\s*✅\s*@@Task Done@@\s*$"
48	)
49	
50	FAILED_LINE_RE = re.compile(
51	    r"^\s*❌\s*@@Task Failed@@\s*$"
52	)
53	
54	SERVER_OK_RE = re.compile(
55	    r"^\[OK\]\s+The server\s+.+?\s+started successfully,\s+tools:\s+.+$",
56	    re.MULTILINE
57	)
58	
59	# ============================================================
60	# 2. 数据结构
61	# ============================================================
62	
63	@dataclass
64	class ToolCall:
65	    tool_name: str
66	    tool_args: str
67	
68	
69	@dataclass
70	class LoopRecord:
71	    loop_id: int
72	    tool_calls: list[ToolCall] = field(default_factory=list)
73	
74	
75	@dataclass
76	class SegmentRecord:
77	    serial_number: int
78	    status: str
79	    loops: List[LoopRecord] = field(default_factory=list)
80	
81	
82	# ============================================================
83	# 3. Segment 切分
84	# ============================================================
85	
86	def split_segments(text: str) -> list[str]:
87	    """
88	    基于 [RESULT] 切分任务段
89	    """
90	
91	    matches = list(RESULT_RE.finditer(text))
92	
93	    if not matches:
94	        return [text]
95	
96	    segments = []
97	
98	    start = 0
99	
100	    for m in matches:
101	        end = m.end()
102	
103	        seg = text[start:end].strip()
104	
105	        if seg:
106	            segments.append(seg)
107	
108	        start = end
109	
110	    tail = text[start:].strip()
111	
112	    if tail:
113	        segments.append(tail)
114	
115	    return segments
116	
117	
118	# ============================================================
119	# 4. assistant 输出提取
120	# ============================================================
121	
122	def extract_last_assistant_message(segment: str) -> str:
123	    """
124	    仅提取最后一个 assistant 普通输出
125	    不包含:
126	        [ASSISTANT][TOOL]
127	    """
128	
129	    lines = segment.splitlines()
130	
131	    messages = []
132	
133	    collecting = False
134	    current = []
135	
136	    for line in lines:
137	
138	        # TOOL 行直接结束
139	        if TOOL_RE.search(line):
140	            if collecting and current:
141	                messages.append("\n".join(current).strip())
142	            collecting = False
143	            current = []
144	            continue
145	
146	        # assistant 开始
147	        if line.startswith("[ASSISTANT]") and "[TOOL]" not in line:
148	
149	            if collecting and current:
150	                messages.append("\n".join(current).strip())
151	
152	            collecting = True
153	
154	            content = line.replace("[ASSISTANT]", "").strip(": ")
155	
156	            current = [content]
157	            continue
158	
159	        # 进入其它 block
160	        if line.startswith("[USER]") \
161	                or line.startswith("[SYSTEM]") \
162	                or line.startswith("[TOOL]") \
163	                or TURN_RE.search(line):
164	
165	            if collecting and current:
166	                messages.append("\n".join(current).strip())
167	
168	            collecting = False
169	            current = []
170	            continue
171	
172	        # assistant continuation
173	        if collecting:
174	            current.append(line)
175	
176	    if collecting and current:
177	        messages.append("\n".join(current).strip())
178	
179	    if not messages:
180	        return ""
181	
182	    return messages[-1]
183	
184	
185	# ============================================================
186	# 5. 提取状态（新逻辑）
187	# ============================================================
188	
189	def extract_last_flag(message: str) -> str | None:
190	    """
191	    只识别：
192	        单独占一行的 flag
193	
194	    返回：
195	        DONE
196	        FAILED
197	        None
198	    """
199	
200	    flags = []
201	
202	    for raw_line in message.splitlines():
203	
204	        line = raw_line.strip()
205	
206	        if DONE_LINE_RE.fullmatch(line):
207	            flags.append("DONE")
208	
209	        elif FAILED_LINE_RE.fullmatch(line):
210	            flags.append("FAILED")
211	
212	    if not flags:
213	        return None
214	
215	    return flags[-1]
216	
217	def extract_status(segment: str) -> str:
218	    """
219	    最终可靠判定逻辑：
220	
221	    成功必须同时满足：
222	
223	    1. segment 中存在:
224	       [OK] The server xxx started successfully
225	
226	    2. 最后 assistant message 中
227	       最后一个独立行 flag 是:
228	       ✅ @@Task Done@@
229	
230	    否则失败
231	    """
232	
233	    # --------------------------------------------------------
234	    # 1. 必须存在 server started successfully
235	    # --------------------------------------------------------
236	
237	    server_ok = bool(
238	        SERVER_OK_RE.search(segment)
239	    )
240	
241	    if not server_ok:
242	        return "❌ @@Task Failed@@"
243	
244	    # --------------------------------------------------------
245	    # 2. 提取最后 assistant message
246	    # --------------------------------------------------------
247	
248	    last_msg = extract_last_assistant_message(segment)
249	
250	    if not last_msg:
251	        return "❌ @@Task Failed@@"
252	
253	    # --------------------------------------------------------
254	    # 3. 提取最后 flag
255	    # --------------------------------------------------------
256	
257	    last_flag = extract_last_flag(last_msg)
258	
259	    # --------------------------------------------------------
260	    # 4. 最终判定
261	    # --------------------------------------------------------
262	
263	    if last_flag == "DONE":
264	        return "✅ @@Task Done@@"
265	
266	    return "❌ @@Task Failed@@"
267	
268	# ============================================================
269	# 6. compact json
270	# ============================================================
271	
272	def compact_json(raw: str) -> str:
273	
274	    raw = raw.strip()
275	
276	    if not raw:
277	        return "{}"
278	
279	    try:
280	
281	        data = json.loads(raw)
282	
283	        if isinstance(data, dict):
284	            data.pop("description", None)
285	
286	        return json.dumps(
287	            data,
288	            ensure_ascii=False,
289	            separators=(",", ":"),
290	        )
291	
292	    except Exception:
293	
294	        return " ".join(
295	            raw.split()
296	        )
