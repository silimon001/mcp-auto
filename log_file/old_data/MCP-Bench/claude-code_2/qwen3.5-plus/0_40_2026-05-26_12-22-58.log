331	                continue
332	
333	            current_turn = turn_id
334	
335	            if current_turn not in loop_map:
336	                loop_map[current_turn] = LoopRecord(
337	                    loop_id=current_turn
338	                )
339	
340	            i += 1
341	            continue
342	
343	        # -------------------------------------------------
344	        # TOOL
345	        # -------------------------------------------------
346	
347	        m = TOOL_RE.search(line)
348	
349	        if m and current_turn is not None:
350	
351	            tool_name = m.group(1).strip()
352	
353	            i += 1
354	
355	            # 找 TOOL INPUT
356	            while i < len(lines):
357	
358	                if "[TOOL INPUT]:" in lines[i]:
359	                    break
360	
361	                if TOOL_RE.search(lines[i]):
362	                    break
363	
364	                if TURN_RE.search(lines[i]):
365	                    break
366	
367	                i += 1
368	
369	            raw_args = "{}"
370	
371	            if i < len(lines) and "[TOOL INPUT]:" in lines[i]:
372	
373	                i += 1
374	
375	                arg_lines = []
376	
377	                while i < len(lines):
378	
379	                    nxt = lines[i]
380	
381	                    if TURN_RE.search(nxt):
382	                        break
383	
384	                    if TOOL_RE.search(nxt):
385	                        break
386	
387	                    if nxt.startswith("[TOKENS]"):
388	                        break
389	
390	                    if nxt.startswith("------------------------------------------------------------"):
391	                        break
392	
393	                    arg_lines.append(nxt)
394	
395	                    i += 1
396	
397	                raw_args = "\n".join(arg_lines)
398	
399	            cleaned_args = compact_json(raw_args)
400	
401	            loop_map[current_turn].tool_calls.append(
402	                ToolCall(
403	                    tool_name=tool_name,
404	                    tool_args=cleaned_args,
405	                )
406	            )
407	
408	            continue
409	
410	        i += 1
411	
412	    # turn 连续重编号
413	    final_loops = []
414	
415	    for new_idx, (_, loop) in enumerate(
416	        loop_map.items(),
417	        start=1
418	    ):
419	        loop.loop_id = new_idx
420	        final_loops.append(loop)
421	
422	    return final_loops
423	
424	
425	# ============================================================
426	# 8. 解析整个日志
427	# ============================================================
428	
429	def simplify_log_text(text: str) -> list[SegmentRecord]:
430	
431	    segments = split_segments(text)
432	
433	    results: list[SegmentRecord] = []
434	
435	    for idx, seg in enumerate(segments, start=1):
436	
437	        status = extract_status(seg)
438	
439	        loops = parse_loops(seg)
440	
441	        results.append(
442	            SegmentRecord(
443	                serial_number=idx,
444	                status=status,
445	                loops=loops,
446	            )
447	        )
448	
449	    return results
450	
451	
452	# ============================================================
453	# 9. 输出
454	# ============================================================
455	
456	def write_simplified_log(
457	    records: list[SegmentRecord],
458	    output_path: Path,
459	):
460	
461	    lines: list[str] = []
462	
463	    for seg in records:
464	
465	        lines.append(
466	            f"{seg.serial_number} | {seg.status}"
467	        )
468	
469	        for loop in seg.loops:
470	
471	            if not loop.tool_calls:
472	
473	                lines.append(
474	                    f"loop {loop.loop_id} | 无 tool_calls"
475	                )
476	
477	                continue
478	
479	            tool_parts = []
480	
481	            for tc in loop.tool_calls:
482	
483	                tool_parts.append(
484	                    f"Tool={tc.tool_name}, Args={tc.tool_args}"
485	                )
486	
487	            merged = " ; ".join(tool_parts)
488	
489	            lines.append(
490	                f"loop {loop.loop_id} | {merged}"
491	            )
492	
493	        lines.append("")
494	
495	    output_path.write_text(
496	        "\n".join(lines).rstrip() + "\n",
497	        encoding="utf-8",
498	    )
499	
500	
501	# ============================================================
502	# 10. 主入口
503	# ============================================================
504	
505	def simplify_logs(log_paths: list[str]) -> list[Path]:
506	
507	    outputs = []
508	
509	    for path_str in log_paths:
510	
511	        path = Path(path_str)
512	
513	        text = path.read_text(
514	            encoding="utf-8",
515	            errors="replace",
516	        )
517	
518	        records = simplify_log_text(text)
519	
520	        output_path = path.with_name(
521	            f"s_{path.stem}.log"
522	        )
523	
524	        write_simplified_log(
525	            records,
526	            output_path,
527	        )
528	
529	        outputs.append(output_path)
530	
531	    return outputs
532	
533	
534	# ============================================================
535	# 11. CLI
536	# ============================================================
537	
538	if __name__ == "__main__":
539	
540	    from dataset_setting import (
541	        dataset_name,
542	        framework_name,
543	        model_name
544	    )
545	    HOME = Path.home()
546	    log_sources: list[str] = [
547	        str(HOME) + f"/mcp-auto/log_file/{dataset_name}/{framework_name + '_3'}/{model_name}/" + x
548	        for x in [
549	            '20_21_2026-05-25_17-27-05.log'
550	        ]
551	    ]
552	
553	    outputs = simplify_logs(log_sources)
554	
555	    for p in outputs:
