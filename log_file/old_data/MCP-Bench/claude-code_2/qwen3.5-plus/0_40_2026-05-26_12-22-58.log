303	def parse_loops(segment: str) -> list[LoopRecord]:
304	
305	    lines = segment.splitlines()
306	
307	    loop_map: OrderedDict[int, LoopRecord] = OrderedDict()
308	
309	    current_turn = None
310	
311	    i = 0
312	
313	    while i < len(lines):
314	
315	        line = lines[i]
316	
317	        # -------------------------------------------------
318	        # TURN
319	        # -------------------------------------------------
320	
321	        m = TURN_RE.search(line)
322	
323	        if m:
324	
325	            turn_id = int(m.group(1))
326	
327	            # 跳过 turn0
328	            if turn_id == 0:
329	                current_turn = None
