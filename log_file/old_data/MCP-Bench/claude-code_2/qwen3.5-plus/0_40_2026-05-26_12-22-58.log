19	def run_claude_stream(prompt_text: str, json_log_path: str):
20	
21	    import threading
22	    import queue
23	
24	    process = subprocess.Popen(
25	        [
26	            "claude-tap",
27	            "--tap-no-live",
28	            "--",
29	            "--print",
30	            "--verbose",
31	            "--max-turns", "20",
32	            "--output-format", "stream-json",
33	            "--permission-mode", "bypassPermissions"
34	        ],
35	        stdin=subprocess.PIPE,
36	        stdout=subprocess.PIPE,
37	        stderr=subprocess.PIPE,
38	        text=True,
39	        encoding="utf-8",
40	        bufsize=1
41	    )
42	
43	    # =========================
44	    # 输入 prompt
45	    # =========================
46	    process.stdin.write(prompt_text)
47	    process.stdin.close()
48	
49	    events = []
50	    stderr_lines = []
51	
52	    # 用 queue 做线程安全通信
53	    stdout_queue = queue.Queue()
54	    stderr_queue = queue.Queue()
55	
56	    # =========================
57	    # 后台消费 stdout
58	    # =========================
59	    def read_stdout():
60	        try:
61	            for line in iter(process.stdout.readline, ''):
62	                stdout_queue.put(line)
63	        except Exception as e:
64	            stdout_queue.put(f"__ERROR__:{e}")
65	        finally:
66	            stdout_queue.put(None)
67	
68	    # =========================
69	    # 后台消费 stderr
70	    # =========================
71	    def read_stderr():
72	        try:
73	            for line in iter(process.stderr.readline, ''):
74	                stderr_queue.put(line)
75	                stderr_lines.append(line)
76	        except Exception as e:
77	            stderr_queue.put(f"__ERROR__:{e}")
78	        finally:
79	            stderr_queue.put(None)
80	
81	    stdout_thread = threading.Thread(target=read_stdout, daemon=True)
82	    stderr_thread = threading.Thread(target=read_stderr, daemon=True)
83	
84	    stdout_thread.start()
85	    stderr_thread.start()
86	
87	    got_result = False
88	
89	    # =========================
90	    # 主事件循环
91	    # =========================
92	    with open(json_log_path, "a", encoding="utf-8") as jf:
93	
94	        while True:
95	
96	            try:
97	                line = stdout_queue.get(timeout=1)
98	
99	            except queue.Empty:
100	
101	                # 已收到 result，则不再继续等待
102	                if got_result:
103	                    break
104	
105	                # 子进程退出
106	                if process.poll() is not None:
107	                    break
108	
109	                continue
110	
111	            # stdout EOF
112	            if line is None:
113	                break
114	
115	            line = line.strip()
116	
117	            if not line:
118	                continue
119	
120	            try:
121	                obj = json.loads(line)
122	
123	                obj["_received_at"] = datetime.now(
124	                    timezone.utc
125	                ).isoformat()
126	
127	                events.append(obj)
128	
129	                jf.write(
130	                    json.dumps(
131	                        obj,
132	                        ensure_ascii=False
133	                    ) + "\n"
134	                )
135	
136	                # 减少 flush 开销
137	                jf.flush()
138	
139	                # =========================
140	                # 收到最终 result
141	                # =========================
142	                if obj.get("type") == "result":
143	
144	                    got_result = True
145	
146	                    # 非常关键：
147	                    # 不再等待 Claude 主进程自然退出
148	                    try:
149	                        process.terminate()
150	                    except Exception:
151	                        pass
152	
153	                    break
154	
155	            except json.JSONDecodeError:
156	                continue
157	
158	            except Exception as e:
159	                print(f"⚠️ JSON parse error: {e}")
160	
161	    # =========================
162	    # 等待退出
163	    # =========================
164	    try:
165	        process.wait(timeout=5)
166	
167	    except subprocess.TimeoutExpired:
168	
169	        print("⚠️ Claude process timeout, killing...")
170	
171	        try:
172	            process.kill()
173	        except Exception:
174	            pass
175	
176	    # =========================
177	    # 确保线程结束
178	    # =========================
179	    stdout_thread.join(timeout=1)
180	    stderr_thread.join(timeout=1)
181	
182	    stderr = "".join(stderr_lines)
183	
184	    return events, stderr
185	
186	def render_content(obj):
187	    """
188	    把 Claude stream-json content 递归展开成纯 string
189	    """
190	    if obj is None:
191	        return ""
192	
193	    # str
194	    if isinstance(obj, str):
195	        return obj
196	
197	    # dict（核心：Claude node）
198	    if isinstance(obj, dict):
199	        t = obj.get("type")
200	
201	        # tool result wrapper
202	        if t == "text":
203	            return render_content(obj.get("text"))
204	
205	        if t == "tool_result":
206	            return render_content(obj.get("content"))
207	
208	        # fallback：尽量抽取 text
209	        if "text" in obj:
210	            return render_content(obj["text"])
211	
212	        return json.dumps(obj, ensure_ascii=False)
213	
214	    # list（递归 flatten）
215	    if isinstance(obj, list):
216	        return "\n".join(render_content(x) for x in obj)
217	
218	    # fallback
219	    return str(obj)
220	
221	def collect_messages(events):
222	    """聚合事件，记录时间戳，并捕获 result 事件用于总结"""
223	    messages = {}
224	    order = []      # dict(system/user/result) 或 str(assistant msg_id)
225	
226	    for event in events:
227	        etype = event.get("type")
228	        ts = event.get("timestamp") or event.get("_received_at", datetime.now(timezone.utc).isoformat())
229	
230	        # -------- system --------
231	        if etype == "system":
232	            order.append({
233	                "type": "system",
234	                "content": f"[SYSTEM] {event.get('subtype', '')}",
235	                "timestamp": ts
236	            })
237	            continue
238	
239	        # -------- user --------
240	        if etype == "user":
241	            contents = event.get("message", {}).get("content", [])
242	            text = render_content(contents)
243	            order.append({
244	                "type": "user",
245	                "content": text,
246	                "timestamp": ts
247	            })
248	            continue
249	
250	        # -------- result (最终总结) --------
251	        if etype == "result":
252	            order.append({
253	                "type": "result",
254	                "timestamp": ts,
255	                "data": {
256	                    "subtype": event.get("subtype"),
257	                    "is_error": event.get("is_error"),
258	                    "num_turns": event.get("num_turns"),
259	                    "stop_reason": event.get("stop_reason"),
260	                    "total_cost_usd": event.get("total_cost_usd"),
261	                    "duration_ms": event.get("duration_ms"),
262	                    "duration_api_ms": event.get("duration_api_ms"),
263	                    "usage": event.get("usage", {}),
264	                    "errors": event.get("errors", []),
265	                    "terminal_reason": event.get("terminal_reason")
266	                }
267	            })
268	            continue
269	
270	        # -------- assistant --------
271	        if etype == "assistant":
272	            msg = event.get("message", {})
273	            msg_id = msg.get("id")
274	
275	            if msg_id not in messages:
276	                messages[msg_id] = {
277	                    "type": "assistant",
278	                    "texts": [],
279	                    "tools": [],
280	                    "tokens": None,
281	                    "timestamp": ts
282	                }
283	                order.append(msg_id)     # 保证顺序
284	
285	            entry = messages[msg_id]
286	
287	            for c in msg.get("content", []):
288	                ctype = c.get("type")
289	                if ctype == "text":
290	                    entry["texts"].append(c.get("text", ""))
291	                elif ctype == "tool_use":
292	                    entry["tools"].append({
293	                        "name": c.get("name"),
294	                        "input": c.get("input")
295	                    })
296	
297	            if msg.get("usage"):
298	                entry["tokens"] = {
299	                    "input": msg["usage"].get("input_tokens"),
300	                    "output": msg["usage"].get("output_tokens")
301	                }
302	
303	    return messages, order
304	
305	def write_log(messages, order, log_file):
306	    """按轮次和时间戳输出，末尾附加任务结果总结"""
307	    turn = 0
308	    with open(log_file, "a", encoding="utf-8") as f:
309	        for item in order:
310	            # -------- 结果总结（直接输出，不改变轮次）--------
311	            if isinstance(item, dict) and item.get("type") == "result":
312	                ts = item.get("timestamp", "")
313	                data = item["data"]
314	
315	                f.write(f"\n{'=' * 60}\n")
316	                f.write(f"[RESULT] [TIMESTAMP {ts}]\n")
317	                f.write(f"  状态: {'❌ 失败' if data['is_error'] else '✅ 成功'}\n")
318	                f.write(f"  子类型: {data['subtype']}\n")
319	                f.write(f"  实际轮次: {data['num_turns']}\n")
320	                f.write(f"  停止原因: {data['stop_reason']}\n")
321	                f.write(f"  终端原因: {data['terminal_reason']}\n")
322	                f.write(f"  耗时: {data['duration_ms']} ms (API: {data['duration_api_ms']} ms)\n")
323	                f.write(f"  成本: ${data['total_cost_usd']:.6f}\n")
324	
325	                usage = data.get("usage", {})
326	                if usage:
327	                    f.write(f"  Token 使用:\n")
328	                    f.write(f"    - 输入: {usage.get('input_tokens', '?')}\n")
329	                    f.write(f"    - 输出: {usage.get('output_tokens', '?')}\n")
330	                    f.write(f"    - 缓存创建: {usage.get('cache_creation_input_tokens', '?')}\n")
331	                    f.write(f"    - 缓存读取: {usage.get('cache_read_input_tokens', '?')}\n")
332	
333	                errors = data.get("errors", [])
334	                if errors:
335	                    f.write(f"  错误信息:\n")
336	                    for err in errors:
337	                        f.write(f"    - {err}\n")
338	                f.write(f"{'=' * 60}\n")
339	                continue   # result 块输出完毕，跳过后续普通处理
340	
341	            # -------- system / user --------
342	            if isinstance(item, dict):
343	                role = item["type"].upper()
344	                ts = item.get("timestamp", "")
345	                f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
346	                f.write(f"[{role}]:\n{item['content']}\n")
347	                f.write("\n" + "-" * 60 + "\n")
348	                continue
349	
350	            # -------- assistant --------
351	            turn += 1
352	            msg = messages[item]
353	            ts = msg.get("timestamp", "")
354	            f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
355	
356	            text = "\n".join(msg["texts"]).strip()
357	            if text:
358	                f.write(f"[ASSISTANT]:\n{text}\n")
359	
360	            for tool in msg["tools"]:
361	                f.write(f"[ASSISTANT][TOOL]: {tool['name']}\n")
362	                f.write("[TOOL INPUT]:\n")
363	                f.write(json.dumps(tool["input"], indent=2, ensure_ascii=False))
364	                f.write("\n")
365	
366	            if msg["tokens"]:
367	                t = msg["tokens"]
368	                f.write(f"[TOKENS] input={t['input']} output={t['output']}\n")
369	
370	            f.write("\n" + "-" * 60 + "\n")
371	
372	def run_task(prompt_text: str, task_name, pos, count):
373	
374	    json_log_path = f"{LOG_DIR}/tmp_{task_name}.jsonl"
375	
376	    events, stderr = run_claude_stream(
377	        prompt_text,
378	        json_log_path
379	    )
380	
381	    messages, order = collect_messages(events)
382	    log_file = f"{LOG_DIR}/{pos}_{pos+count}_{timestamp}.log"
383	    write_log(messages, order, log_file)
384	
385	    if stderr:
386	        with open(log_file, "a") as f:
387	            f.write("\n[STDERR]\n")
388	            f.write(stderr)
389	
390	    print(f"✅ Done: {log_file}")
391	
