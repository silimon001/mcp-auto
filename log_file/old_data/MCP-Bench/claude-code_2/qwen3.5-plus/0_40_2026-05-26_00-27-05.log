868	    async def get_trending_games(self) -> List[Dict[str, Any]]:
869	        # SSL doğrulamasını devre dışı bırak
870	        ssl_context = ssl.create_default_context()
871	        ssl_context.check_hostname = False
872	        ssl_context.verify_mode = ssl.CERT_NONE
873	        
874	        connector = aiohttp.TCPConnector(ssl=ssl_context)
875	        async with aiohttp.ClientSession(connector=connector) as session:
876	            headers = {
877	                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
878	                "Accept-Language": "en-US,en;q=0.9",
879	            }
880	            html = None
881	            try:
882	                async with session.get(
883	                    f"{self.store_browse_url}?sortBy=trending&sortDir=DESC&count=20",
884	                    headers=headers,
885	                    timeout=20,
886	                ) as response:
887	                    response.raise_for_status()
888	                    html = await response.text()
889	            except Exception as e:
890	                print(
891	                    f"[{datetime.now()}] EpicGamesService: Failed to fetch Epic trending browse page: {e}. Falling back to main page."
892	                )
893	                try:
894	                    async with session.get(
895	                        "https://store.epicgames.com/en-US/",
896	                        headers=headers,
897	                        timeout=15,
898	                    ) as response_main:
899	                        response_main.raise_for_status()
900	                        html = await response_main.text()
901	                except Exception as e_main:
902	                    print(
903	                        f"[{datetime.now()}] EpicGamesService: Failed to fetch Epic main page for trending: {e_main}"
904	                    )
905	                    return []
906	            
907	            if not html: return []
908	
909	            soup = BeautifulSoup(html, "lxml")
910	            games = []
911	            seen_names_or_urls = set()
912	
913	            # Common selectors for game cards on Epic Store
914	            # These might need frequent updates due to website changes
915	            card_selectors = [
916	                'div[data-testid^="offer-card-"]',
917	                'article[data-testid^="offer-card-"]',
918	                '.css-1myhtyb', # Generic card class often used
919	                '.css-1jx3eyg', # Another generic card class
920	                'div[role="group"] > div[data-component="DiscoverCard"]', # For discover sections
921	                'section[data-testid="section-wrapper"] li[data-testid="list-item"]' # For list items in sections
922	            ]
923	
924	            game_cards = []
925	            for selector in card_selectors:
926	                game_cards.extend(soup.select(selector))
927	                if len(game_cards) > 20 : break # Stop if we have enough candidates
928	
929	            for index, card in enumerate(game_cards[:25]): # Process up to 25 candidates
930	                try:
931	                    name, price, game_url, image = None, "N/A", None, None
932	
933	                    # Try to find a link first, as it's a good anchor
934	                    link_elem = card.find("a", href=True)
935	                    if link_elem:
936	                        href_val = link_elem["href"]
937	                        if href_val.startswith("/"):
938	                            game_url = f"https://store.epicgames.com{href_val}"
939	                        elif href_val.startswith("http"):
940	                            game_url = href_val
941	                        
942	                        # Extract name from link's inner text or aria-label
943	                        name_candidate_elems = link_elem.select('span[data-testid="offer-title-info-title"], div[data-testid="truncate-text-title"], .css-2ucwu, .css-uahz85, span[aria-label]')
944	                        for elem in name_candidate_elems:
945	                            if elem.text.strip(): name = elem.text.strip(); break
946	                        if not name and link_elem.get('aria-label'): name = link_elem.get('aria-label')
947	                        if not name and link_elem.text.strip(): name = link_elem.text.strip()
948	
949	
950	                    # If name not found via link, try broader card search
951	                    if not name:
952	                        name_elems = card.select('span[data-testid="offer-title-info-title"], div[data-testid="truncate-text-title"], .css-2ucwu, .css-uahz85, h3')
953	                        for elem in name_elems:
954	                            if elem.text.strip(): name = elem.text.strip(); break
955	                    
956	                    # Image alt text as fallback for name
957	                    if not name:
958	                        img_alt_elem = card.select_one("img[alt]")
959	                        if img_alt_elem and img_alt_elem["alt"].strip():
960	                            name = img_alt_elem["alt"].strip().replace("Cover art for ", "").replace("Box art for ", "")
961	
962	                    if not name: continue # Skip if no name found
963	
964	                    # Deduplication based on name or URL
965	                    dedup_key = game_url if game_url else name.lower()
966	                    if dedup_key in seen_names_or_urls: continue
967	                    seen_names_or_urls.add(dedup_key)
968	
969	                    price_elems = card.select('span[data-testid="offer-price"], .css-119zqif, .css-4f2d21, div[data-testid="purchase-price-items"] span')
970	                    for elem in price_elems:
971	                        if elem.text.strip(): price = elem.text.strip(); break
972	                    
973	                    img_elem = card.select_one("img[src]")
974	                    if img_elem: image = img_elem["src"]
975	
976	                    game_id = f"epic_trend_{index}"
977	                    if game_url:
978	                        match = re.search(r"/(?:p|store)/([^/?]+)", game_url)
979	                        if match: game_id = match.group(1)
980	                    elif name:
981	                        game_id = f"epic_trend_{name.lower().replace(' ', '_').replace(':','')}"
982	
983	
984	                    games.append(
985	                        {
986	                            "id": game_id,
987	                            "name": name,
988	                            "price": price,
989	                            "platform": "Epic Games",
990	                            "url": game_url,
991	                            "headerImage": image,
992	                            "category": "Trending/Featured",
993	                            "isTrending": True,
994	                            "source": "epic_store_scrape"
995	                        }
996	                    )
997	                    if len(games) >= 10: break # Limit to 10 distinct games
998	                except Exception as e:
999	                    print(
1000	                        f"[{datetime.now()}] EpicGamesService: Error parsing Epic game card: {e}"
1001	                    )
1002	                    continue
1003	            if not games:
1004	                print(
1005	                    f"[{datetime.now()}] EpicGamesService: No trending games found on Epic Games Store via scraping."
1006	                )
1007	            return games
