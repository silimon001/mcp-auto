749	@mcp.tool()
750	async def get_earth_imagery(lat: float, lon: float, date: str = None, dim: float = 0.025, cloud_score: bool = False) -> str:
751	    """Get Earth imagery from Landsat 8 satellite.
752	    
753	    Args:
754	        lat: Latitude.
755	        lon: Longitude.
756	        date: Image date in YYYY-MM-DD format. If not specified, the most recent image is used.
757	        dim: Width and height of the image in degrees (0.025 degrees is approximately 2.7 km).
758	        cloud_score: Calculate the percentage of the image covered by clouds (currently not available).
759	    """
760	    params = {
761	        "lat": lat,
762	        "lon": lon,
763	        "dim": dim
764	    }
765	    
766	    if date:
767	        params["date"] = date
768	    # cloud_score parameter seems deprecated or unavailable based on docs
769	    # if cloud_score:
770	    #     params["cloud_score"] = "True"
771	    
772	    url = f"{NASA_API_BASE}/planetary/earth/imagery"
773	    data = await make_nasa_request(url, params)
774	    
775	    if not data:
776	        return "Could not retrieve Earth imagery due to a connection error."
777	    
778	    # Check for error response (must be a dictionary)
779	    if isinstance(data, dict) and "error" in data:
780	        # Handle specific case where API returns error message instead of image/JSON
781	        if isinstance(data.get("details"), str) and "No Landsat 8 imagery available" in data["details"]:
782	             return f"No Landsat 8 imagery available for the specified location and date (Lat: {lat}, Lon: {lon}, Date: {date or 'latest'})."
783	        return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
784	    
785	    # Handle binary content
786	    if isinstance(data, dict) and data.get("binary_content"):
787	        # The API returned the image directly
788	        return f"Received image data directly ({data.get('content_type')}). Cannot display image content, but the image is available at the requested URL: {data.get('url')}"
789	
790	    # If it's not binary, it should be JSON containing the URL
791	    try:
792	        result = [
793	            f"Earth image metadata for coordinates: Lat {lat}, Lon {lon}",
794	            f"Date: {data.get('date', 'Unknown')}",
795	            f"ID: {data.get('id', 'Unknown')}",
796	            f"Image URL: {data.get('url', 'Not available')}" # This URL should point to the image
797	        ]
798	        
799	        # Cloud score might be present in JSON even if binary isn't returned
800	        if 'cloud_score' in data and data['cloud_score'] is not None: # Check for None explicitly
801	            result.append(f"Cloud score: {data.get('cloud_score')}")
802	        else:
803	            result.append("Cloud score: Not available")
804	
805	        return "\n".join(result)
806	    except Exception as e:
807	        logger.error(f"Error processing Earth Imagery JSON data: {str(e)}")
808	        return f"Error processing Earth imagery data: {str(e)}"
