84	# ---------------------- APOD (Astronomy Picture of the Day) ----------------------
85	
86	@mcp.tool()
87	async def get_astronomy_picture_of_day(date: str = None, count: int = None, thumbs: bool = False) -> str:
88	    """Get NASA's astronomy picture of the day.
89	    
90	    Args:
91	        date: Date of the image in YYYY-MM-DD format. If not specified, the current date is used.
92	        count: If specified, returns 'count' random images. Cannot be used with 'date'.
93	        thumbs: If True, returns the thumbnail URL for videos. If APOD is not a video, this parameter is ignored.
94	    """
95	    params = {}
96	    
97	    if date:
98	        params["date"] = date
99	    if count:
100	        params["count"] = count
101	    if thumbs:
102	        params["thumbs"] = "true"
103	    
104	    url = f"{NASA_API_BASE}/planetary/apod"
105	    data = await make_nasa_request(url, params)
106	    
107	    if not data:
108	        return "Could not retrieve astronomy picture of the day data due to a connection error."
109	    
110	    # Check for error response (must be a dictionary)
111	    if isinstance(data, dict) and "error" in data:
112	        return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
113	    if isinstance(data, dict) and data.get("binary_content"):
114	         # APOD URL itself might point to an image, but the API response should be JSON
115	        return f"Received unexpected binary content from APOD API. URL: {data.get('url')}"
116	
117	    try:
118	        # If count is specified, data will be a list
119	        if isinstance(data, list):
120	            result = []
121	            for item in data:
122	                result.append(f"Date: {item.get('date', 'Unknown')}")
123	                result.append(f"Title: {item.get('title', 'No title')}")
124	                result.append(f"Explanation: {item.get('explanation', 'No explanation')}")
125	                result.append(f"URL: {item.get('url', 'Not available')}")
126	                if 'copyright' in item:
127	                    result.append(f"Copyright: {item.get('copyright', 'Unknown')}")
128	                if thumbs and 'thumbnail_url' in item:
129	                    result.append(f"Thumbnail URL: {item.get('thumbnail_url', 'Not available')}")
130	                result.append("-" * 40)
131	            
132	            return "\n".join(result)
133	        else:
134	            # If it's a single image
135	            result = f"""
136	Date: {data.get('date', 'Unknown')}
137	Title: {data.get('title', 'No title')}
138	Explanation: {data.get('explanation', 'No explanation')}
139	URL: {data.get('url', 'Not available')}
140	"""
141	            if 'copyright' in data:
142	                result += f"Copyright: {data.get('copyright', 'Unknown')}\n"
143	            if thumbs and 'thumbnail_url' in data:
144	                result += f"Thumbnail URL: {data.get('thumbnail_url', 'Not available')}n"
145	            
146	            return result
147	    except Exception as e:
148	        logger.error(f"Error processing APOD data: {str(e)}")
149	        return f"Error processing astronomy picture data: {str(e)}"
