1155	    async def get_all_trending_games(self) -> dict:
1156	        print(
1157	            f"[{datetime.now()}] GameAnalyticsApp: Calling get_all_trending_games"
1158	        )
1159	        results_template = {
1160	            "success": False, "data": [], "error": None, "message": None, "count": 0, "platform": None, "type": None
1161	        }
1162	        
1163	        steam_trending_res, steam_top_sellers_res, steam_most_played_res, epic_free_res, epic_trending_res = await asyncio.gather(
1164	            self.get_steam_trending_games(),
1165	            self.get_steam_top_sellers(),
1166	            self.get_steam_most_played(),
1167	            self.get_epic_free_games(),
1168	            self.get_epic_trending_games(),
1169	            return_exceptions=True,
1170	        )
1171	        
1172	        all_data = {}
1173	        partial_failures = False
1174	
1175	        def process_result(result, platform, type_name):
1176	            nonlocal partial_failures
1177	            if isinstance(result, Exception):
1178	                partial_failures = True
1179	                entry = {**results_template, "platform": platform, "type": type_name}
1180	                entry["error"] = f"Task for {platform} {type_name} failed with exception"
1181	                entry["message"] = str(result)
1182	                return entry
1183	            if not result.get('success'):
1184	                partial_failures = True
1185	            return result
1186	
1187	        all_data['steam_trending'] = process_result(steam_trending_res, "Steam", "Trending Games")
1188	        all_data['steam_top_sellers'] = process_result(steam_top_sellers_res, "Steam", "Top Sellers")
1189	        all_data['steam_most_played'] = process_result(steam_most_played_res, "Steam", "Most Played Games")
1190	        all_data['epic_free_games'] = process_result(epic_free_res, "Epic Games", "Free Games")
1191	        all_data['epic_trending_games'] = process_result(epic_trending_res, "Epic Games", "Trending Games")
1192	
1193	        overall_success = not partial_failures
1194	        
1195	        if partial_failures:
1196	            print(
1197	                f"[{datetime.now()}] GameAnalyticsApp: get_all_trending_games completed with partial failures."
1198	            )
1199	        else:
1200	            print(
1201	                f"[{datetime.now()}] GameAnalyticsApp: get_all_trending_games completed successfully."
1202	            )
1203	
1204	        return {
1205	            "success": overall_success,
1206	            "timestamp": datetime.now().isoformat(),
1207	            "data": all_data,
1208	            "partial_failures_occurred": partial_failures
1209	        }
