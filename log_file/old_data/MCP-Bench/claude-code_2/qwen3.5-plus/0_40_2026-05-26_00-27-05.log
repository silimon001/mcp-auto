1201	# Define valid rovers and their cameras
1202	ROVER_CAMERAS = {
1203	    "curiosity": ["FHAZ", "RHAZ", "MAST", "CHEMCAM", "MAHLI", "MARDI", "NAVCAM"],
1204	    "opportunity": ["FHAZ", "RHAZ", "NAVCAM", "PANCAM", "MINITES"],
1205	    "spirit": ["FHAZ", "RHAZ", "NAVCAM", "PANCAM", "MINITES"]
1206	}
1207	
1208	@mcp.tool()
1209	async def get_mars_rover_photos(rover_name: str, sol: int = None, earth_date: str = None, camera: str = None, page: int = 1) -> str:
1210	    """Get photos from a Mars rover (Curiosity, Opportunity, Spirit).
1211	    Specify either sol (Martian day) or earth_date (YYYY-MM-DD), but not both.
1212	    
1213	    Args:
1214	        rover_name: Name of the rover (curiosity, opportunity, spirit).
1215	        sol: Martian sol (day number, starting from landing). Use if not using earth_date.
1216	        earth_date: Earth date in YYYY-MM-DD format. Use if not using sol.
1217	        camera: Filter by camera abbreviation (e.g., FHAZ, RHAZ, MAST, NAVCAM, PANCAM). See documentation for full list per rover.
1218	        page: Page number for results (25 photos per page).
1219	    """
1220	    rover_name = rover_name.lower()
1221	    if rover_name not in ROVER_CAMERAS:
1222	        return f"Invalid rover name. Available rovers: {', '.join(ROVER_CAMERAS.keys())}"
1223	    
1224	    if sol is not None and earth_date is not None:
1225	        return "Error: Specify either sol or earth_date, but not both."
1226	    if sol is None and earth_date is None:
1227	        return "Error: Specify either sol or earth_date."
1228	        
1229	    params = {"page": page}
1230	    if sol is not None:
1231	        params["sol"] = sol
1232	    if earth_date is not None:
1233	        params["earth_date"] = earth_date
1234	        
1235	    if camera:
1236	        camera = camera.upper()
1237	        if camera not in ROVER_CAMERAS[rover_name]:
1238	            return f"Invalid camera '{camera}' for rover '{rover_name}'. Available cameras: {', '.join(ROVER_CAMERAS[rover_name])}"
1239	        params["camera"] = camera
1240	        
1241	    url = f"{NASA_API_BASE}/mars-photos/api/v1/rovers/{rover_name}/photos"
1242	    data = await make_nasa_request(url, params)
1243	    
1244	    if not data:
1245	        return f"Could not retrieve Mars Rover photos for {rover_name} due to a connection error."
1246	    
1247	    # Check for error response (must be a dictionary)
1248	    if isinstance(data, dict) and "error" in data:
1249	        return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
1250	    if isinstance(data, dict) and data.get("binary_content"):
1251	        return f"Received unexpected binary content from Mars Rover Photos API. URL: {data.get('url')}"
1252	    
1253	    # The response should be a dictionary containing a 'photos' list
1254	    if not isinstance(data, dict) or "photos" not in data:
1255	        logger.error(f"Unexpected response format from Mars Rover Photos API: {data}")
1256	        return "Received unexpected data format from Mars Rover Photos API."
1257	
1258	    try:
1259	        photos = data.get("photos", [])
1260	        if not photos:
1261	            query_details = f"sol={sol}" if sol is not None else f"earth_date={earth_date}"
1262	            if camera: query_details += f", camera={camera}"
1263	            return f"No photos found for rover '{rover_name}' with criteria: {query_details}, page {page}."
1264	        
1265	        result = [f"Mars Rover Photos for '{rover_name}' (Page {page}): {len(photos)} found on this page."]
1266	        display_limit = 10 # Limit display per page in the result string
1267	        count = 0
1268	        
1269	        for photo in photos:
1270	            if count >= display_limit:
1271	                result.append(f"\n... and {len(photos) - display_limit} more photos on this page.")
1272	                break
1273	                
1274	            result.append(f"\nPhoto ID: {photo.get('id', 'Unknown')}")
1275	            result.append(f"Sol: {photo.get('sol', 'Unknown')}")
1276	            result.append(f"Earth Date: {photo.get('earth_date', 'Unknown')}")
1277	            result.append(f"Camera: {photo.get('camera', {}).get('name', 'Unknown')} ({photo.get('camera', {}).get('full_name', 'N/A')})")
1278	            result.append(f"Image URL: {photo.get('img_src', 'Not available')}")
1279	            result.append(f"Rover: {photo.get('rover', {}).get('name', 'Unknown')} (Status: {photo.get('rover', {}).get('status', 'N/A')}) ")
1280	            result.append("-" * 40)
1281	            count += 1
1282	            
1283	        return "\n".join(result)
1284	    except Exception as e:
1285	        logger.error(f"Error processing Mars Rover Photos data: {str(e)}")
1286	        return f"Error processing Mars Rover Photos data: {str(e)}"
