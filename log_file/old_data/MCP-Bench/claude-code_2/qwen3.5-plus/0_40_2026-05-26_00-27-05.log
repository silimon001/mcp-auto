66	        ssl_context.check_hostname = False
67	        ssl_context.verify_mode = ssl.CERT_NONE
68	        
69	        connector = aiohttp.TCPConnector(ssl=ssl_context)
70	        async with aiohttp.ClientSession(connector=connector) as session:
71	            games = []
72	            sources_attempted = []
73	
74	            try:
75	                sources_attempted.append("featured_home")
76	                featured_games = await self._get_featured_games(session)
77	                games.extend(featured_games)
78	            except Exception as e:
79	                print(
80	                    f"[{datetime.now()}] SteamService: Featured games error: {e}"
81	                )
82	
83	            try:
84	                sources_attempted.append("new_trending_api")
85	                trending_games = await self._get_new_trending_games(session)
86	                games.extend(trending_games)
87	            except Exception as e:
88	                print(
89	                    f"[{datetime.now()}] SteamService: New trending games error: {e}"
90	                )
91	
92	            try:
93	                sources_attempted.append("popular_new_releases_api")
94	                new_releases = await self._get_popular_new_releases(session)
95	                games.extend(new_releases)
96	            except Exception as e:
97	                print(
98	                    f"[{datetime.now()}] SteamService: New releases error: {e}"
99	                )
100	
101	            if len(games) < 5: # Try more sources if initial results are sparse
102	                try:
103	                    sources_attempted.append("steamcharts_top")
104	                    popular_games = await self._get_steam_charts_popular(
105	                        session
106	                    )
107	                    games.extend(popular_games)
108	                except Exception as e:
109	                    print(
110	                        f"[{datetime.now()}] SteamService: Steam charts popular error: {e}"
111	                    )
112	
113	            if len(games) < 3: # One last attempt if still very few games
114	                try:
115	                    sources_attempted.append("steam_global_stats_page")
116	                    stats_games = await self._get_steam_global_stats(session)
117	                    games.extend(stats_games)
118	                except Exception as e:
119	                    print(
120	                        f"[{datetime.now()}] SteamService: Steam global stats error: {e}"
121	                    )
122	
123	            seen_ids = set()
124	            unique_games = []
125	            for game in games:
126	                game_id = game.get("id")
127	                # Ensure game_id is a string for the set
128	                if game_id and str(game_id) not in seen_ids and len(unique_games) < 25 :
129	                    seen_ids.add(str(game_id))
130	                    unique_games.append(game)
131	
132	            if not unique_games:
133	                print(
134	                    f"[{datetime.now()}] SteamService: No trending games data could be retrieved from any source. Sources attempted: {sources_attempted}"
135	                )
136	            return unique_games
