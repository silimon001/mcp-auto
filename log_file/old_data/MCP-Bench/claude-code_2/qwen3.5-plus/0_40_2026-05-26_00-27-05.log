138	    async def _get_featured_games(
139	        self, session: aiohttp.ClientSession
140	    ) -> List[Dict[str, Any]]:
141	        response_text = await self.make_request(
142	            f"{self.store_url}/?l=english&cc=US", session
143	        )
144	        soup = BeautifulSoup(response_text, "lxml")
145	        games = []
146	        carousel_items = soup.select(
147	            ".carousel_items .store_capsule, .featuredcapsule, .main_cluster_capsule, .home_area_spotlight, .discovery_queue_spotlight"
148	        )
149	
150	        for item in carousel_items[:10]:
151	            try:
152	                link = item.find("a", href=True)
153	                if not link:
154	                    continue
155	
156	                href = link["href"]
157	                app_id_match = re.search(r"/app/(\d+)/", href)
158	                app_id = None
159	                if app_id_match:
160	                    app_id = app_id_match.group(1)
161	                else:
162	                    data_appid = item.get("data-ds-appid") or item.get(
163	                        "data-ds-bundleid"
164	                    )
165	                    if data_appid and data_appid.isdigit():
166	                        app_id = data_appid
167	                    else: # Try to get from URL if it's a bundle or sub
168	                        id_match_alt = re.search(r'/(bundle|sub)/(\d+)', href)
169	                        if id_match_alt:
170	                            app_id = f"{id_match_alt.group(1)}_{id_match_alt.group(2)}"
171	
172	
173	                if not app_id:
174	                    continue
175	
176	                title_elem = item.select_one(
177	                    ".store_capsule_name, .featuredcapsule_title, .focus_title, .home_area_spotlight_name, .dq_title"
178	                )
179	                name = title_elem.text.strip() if title_elem else None
180	
181	                if not name:
182	                    img = item.find("img", alt=True)
183	                    if img:
184	                        name = img["alt"].strip()
185	
186	                price_elem = item.select_one(
187	                    ".discount_final_price, .store_capsule_price .price, .focus_price, .home_area_spotlight_price, .dq_price .discount_final_price"
188	                )
189	                price = price_elem.text.strip() if price_elem else "N/A"
190	
191	                discount_elem = item.select_one(".discount_pct, .discount_percent")
192	                discount = 0
193	                if discount_elem:
194	                    discount_text = (
195	                        discount_elem.text.strip().replace("-", "").replace("%", "")
196	                    )
197	                    try:
198	                        discount = int(discount_text)
199	                    except ValueError:
200	                        discount = 0
201	
202	                img_elem = item.find("img", src=True)
203	                image = img_elem["src"] if img_elem else None
204	
205	                if name and app_id:
206	                    games.append(
207	                        {
208	                            "id": app_id,
209	                            "name": name,
210	                            "price": price,
211	                            "discount": discount,
212	                            "headerImage": image,
213	                            "platform": "Steam",
214	                            "category": "Featured",
215	                            "isTrending": True,
216	                            "source": "featured_home",
217	                            "url": href
218	                        }
219	                    )
220	            except Exception as e:
221	                print(
222	                    f"[{datetime.now()}] SteamService: Error parsing featured game: {e}"
223	                )
224	                continue
225	        return games
