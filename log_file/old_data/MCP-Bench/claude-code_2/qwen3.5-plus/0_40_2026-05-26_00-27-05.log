680	                if match: app_id = match.group(1)
681	                if not app_id: app_id = f"stats_alt_{name.replace(' ', '_').lower()}"
682	
683	                current_players_cell = row.select_one("span.currentServers")
684	                current_players = (
685	                    int(current_players_cell.text.strip().replace(",", ""))
686	                    if current_players_cell
687	                    else 0
688	                )
689	                if name and current_players > 0:
690	                    games.append(
691	                        {
692	                            "id": app_id,
693	                            "name": name,
694	                            "currentPlayers": current_players,
695	                            "rank": index + 1,
696	                            "platform": "Steam",
697	                            "isPopular": True,
698	                            "source": "steam_stats_page_alt",
699	                            "lastUpdated": datetime.now().isoformat(),
700	                            "url": name_link['href'] if name_link else None
701	                        }
702	                    )
703	            except Exception as e:
704	                print(
705	                    f"[{datetime.now()}] SteamService: Error parsing Steam stats alternative row: {e}"
706	                )
707	                continue
708	        return games
