1	from typing import Any, List, Union
2	import httpx
3	import json
4	import logging
5	from mcp.server.fastmcp import FastMCP
6	from dotenv import load_dotenv
7	import os
8	from datetime import datetime
9	
10	# Load data from .env file
11	load_dotenv()
12	
13	# Initialize logging
14	logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')
15	logger = logging.getLogger("NasaMCPServer")
16	
17	# Initialize FastMCP server
18	mcp = FastMCP(
19	    "nasa-mcp",
20	    description="MCP server for querying NASA (National Aeronautics and Space Administration) APIs"
21	)
22	
23	# Constants
24	NASA_API_BASE = "https://api.nasa.gov"
25	# Get API key from https://api.nasa.gov/
26	API_KEY = os.getenv("NASA_API_KEY", "DEMO_KEY")
27	
28	async def make_nasa_request(url: str, params: dict = None) -> Union[dict[str, Any], List[Any], None]:
29	    """Make a request to the NASA API with proper error handling.
30	    Handles both JSON and binary (image) responses.
31	    """
32	    
33	    logger.info(f"Making request to: {url} with params: {params}")
34	    
35	    if params is None:
36	        params = {}
37	    
38	    # Ensure API key is included in parameters
39	    if "api_key" not in params:
40	        params["api_key"] = API_KEY
41	    
42	    async with httpx.AsyncClient() as client:
43	        try:
44	            response = await client.get(url, params=params, timeout=30.0, follow_redirects=True)
45	            response.raise_for_status() # Raise an exception for bad status codes (4xx or 5xx)
46	
47	            content_type = response.headers.get("Content-Type", "").lower()
48	            
49	            if "application/json" in content_type:
50	                try:
51	                    return response.json()
52	                except json.JSONDecodeError as json_err:
53	                    logger.error(f"JSON decode error for URL {response.url}: {json_err}")
54	                    logger.error(f"Response text: {response.text[:500]}") # Log beginning of text
55	                    return {"error": "Failed to decode JSON response", "details": str(json_err)}
56	            elif content_type.startswith("image/"):
57	                logger.info(f"Received binary image content ({content_type}) from {response.url}")
58	                # Return a dictionary indicating binary content was received
59	                return {
60	                    "binary_content": True, 
61	                    "content_type": content_type,
62	                    "url": str(response.url) # Return the final URL after redirects
63	                }
64	            else:
65	                # Handle other unexpected content types
66	                logger.warning(f"Unexpected content type '{content_type}' received from {response.url}")
67	                return {"error": f"Unexpected content type: {content_type}", "content": response.text[:500]}
68	
69	        except httpx.HTTPStatusError as http_err:
70	            logger.error(f"HTTP error occurred: {http_err} - {http_err.response.status_code} for URL {http_err.request.url}")
71	            try:
72	                # Try to get more details from response body if possible
73	                error_details = http_err.response.json()
74	            except Exception:
75	                error_details = http_err.response.text[:500]
76	            return {"error": f"HTTP error: {http_err.response.status_code}", "details": error_details}
77	        except httpx.RequestError as req_err:
78	            logger.error(f"Request error occurred: {req_err} for URL {req_err.request.url}")
79	            return {"error": "Request failed", "details": str(req_err)}
80	        except Exception as e:
81	            logger.error(f"An unexpected error occurred: {str(e)}")
82	            return {"error": "An unexpected error occurred", "details": str(e)}
83	
84	# ---------------------- APOD (Astronomy Picture of the Day) ----------------------
85	
86	@mcp.tool()
87	async def get_astronomy_picture_of_day(date: str = None, count: int = None, thumbs: bool = False) -> str:
88	    """Get NASA's astronomy picture of the day.
89	    
90	    Args:
91	        date: Date of the image in YYYY-MM-DD format. If not specified, the current date is used.
92	        count: If specified, returns 'count' random images. Cannot be used with 'date'.
93	        thumbs: If True, returns the thumbnail URL for videos. If APOD is not a video, this parameter is ignored.
94	    """
95	    params = {}
96	    
97	    if date:
98	        params["date"] = date
99	    if count:
100	        params["count"] = count
101	    if thumbs:
102	        params["thumbs"] = "true"
103	    
104	    url = f"{NASA_API_BASE}/planetary/apod"
105	    data = await make_nasa_request(url, params)
106	    
107	    if not data:
108	        return "Could not retrieve astronomy picture of the day data due to a connection error."
109	    
110	    # Check for error response (must be a dictionary)
111	    if isinstance(data, dict) and "error" in data:
112	        return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
113	    if isinstance(data, dict) and data.get("binary_content"):
114	         # APOD URL itself might point to an image, but the API response should be JSON
115	        return f"Received unexpected binary content from APOD API. URL: {data.get('url')}"
116	
117	    try:
118	        # If count is specified, data will be a list
119	        if isinstance(data, list):
120	            result = []
121	            for item in data:
122	                result.append(f"Date: {item.get('date', 'Unknown')}")
123	                result.append(f"Title: {item.get('title', 'No title')}")
124	                result.append(f"Explanation: {item.get('explanation', 'No explanation')}")
125	                result.append(f"URL: {item.get('url', 'Not available')}")
126	                if 'copyright' in item:
127	                    result.append(f"Copyright: {item.get('copyright', 'Unknown')}")
128	                if thumbs and 'thumbnail_url' in item:
129	                    result.append(f"Thumbnail URL: {item.get('thumbnail_url', 'Not available')}")
130	                result.append("-" * 40)
131	            
132	            return "\n".join(result)
133	        else:
134	            # If it's a single image
135	            result = f"""
136	Date: {data.get('date', 'Unknown')}
137	Title: {data.get('title', 'No title')}
138	Explanation: {data.get('explanation', 'No explanation')}
139	URL: {data.get('url', 'Not available')}
140	"""
141	            if 'copyright' in data:
142	                result += f"Copyright: {data.get('copyright', 'Unknown')}\n"
143	            if thumbs and 'thumbnail_url' in data:
144	                result += f"Thumbnail URL: {data.get('thumbnail_url', 'Not available')}n"
145	            
146	            return result
147	    except Exception as e:
148	        logger.error(f"Error processing APOD data: {str(e)}")
149	        return f"Error processing astronomy picture data: {str(e)}"
150	
151	# ---------------------- Asteroids NeoWs (Near Earth Object Web Service) ----------------------
152	
153	@mcp.tool()
154	async def get_asteroids_feed(start_date: str, end_date: str = None) -> str:
155	    """Get a list of asteroids based on their closest approach date to Earth.
156	    
157	    Args:
158	        start_date: Start date for asteroid search in YYYY-MM-DD format.
159	        end_date: End date for asteroid search in YYYY-MM-DD format. 
160	        The Feed date limit is only 7 Days. If not specified, 7 days after start_date is used.
161	    """
162	    params = {
163	        "start_date": start_date
164	    }
165	    
166	    if end_date:
167	        params["end_date"] = end_date
168	    
169	    url = f"{NASA_API_BASE}/neo/rest/v1/feed"
170	    data = await make_nasa_request(url, params)
171	    
172	    if not data:
173	        return "Could not retrieve asteroid data due to a connection error."
174	    
175	    # Check for error response (must be a dictionary)
176	    if isinstance(data, dict) and "error" in data:
177	        return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
178	    if isinstance(data, dict) and data.get("binary_content"):
179	        return f"Received unexpected binary content from Asteroids Feed API. URL: {data.get('url')}"
180	
181	    try:
182	        element_count = data.get('element_count', 0)
183	        near_earth_objects = data.get('near_earth_objects', {})
184	        
185	        result = [f"Total asteroids found: {element_count}"]
186	        
187	        for date_str, asteroids in near_earth_objects.items():
188	            result.append(f"\nDate: {date_str}")
189	            result.append(f"Number of asteroids: {len(asteroids)}")
190	            
191	            for asteroid in asteroids:
192	                result.append(f"\n  ID: {asteroid.get('id', 'Unknown')}")
193	                result.append(f"  Name: {asteroid.get('name', 'Unknown')}")
194	                result.append(f"  Estimated diameter (min): {asteroid.get('estimated_diameter', {}).get('kilometers', {}).get('estimated_diameter_min', 'Unknown')} km")
195	                result.append(f"  Estimated diameter (max): {asteroid.get('estimated_diameter', {}).get('kilometers', {}).get('estimated_diameter_max', 'Unknown')} km")
196	                result.append(f"  Potentially hazardous: {'Yes' if asteroid.get('is_potentially_hazardous_asteroid', False) else 'No'}")
197	                
198	                # Information about closest approach
199	                close_approaches = asteroid.get('close_approach_data', [])
200	                if close_approaches:
201	                    approach = close_approaches[0]
202	                    result.append(f"  Approach date: {approach.get('close_approach_date_full', 'Unknown')}")
203	                    result.append(f"  Distance (km): {approach.get('miss_distance', {}).get('kilometers', 'Unknown')}")
204	                    result.append(f"  Relative velocity (km/h): {approach.get('relative_velocity', {}).get('kilometers_per_hour', 'Unknown')}")
205	        
206	        return "\n".join(result)
207	    except Exception as e:
208	        logger.error(f"Error processing Asteroids Feed data: {str(e)}")
209	        return f"Error processing asteroid data: {str(e)}"
210	
211	@mcp.tool()
212	async def get_asteroid_lookup(asteroid_id: str) -> str:
213	    """Look up a specific asteroid based on its NASA JPL ID.
214	    
215	    Args:
216	        asteroid_id: Asteroid ID in the NASA JPL small body (SPK-ID) system.
217	    """
218	    url = f"{NASA_API_BASE}/neo/rest/v1/neo/{asteroid_id}"
219	    data = await make_nasa_request(url)
220	    
221	    if not data:
222	        return f"Could not retrieve data for asteroid ID {asteroid_id} due to a connection error."
223	    
224	    # Check for error response (must be a dictionary)
225	    if isinstance(data, dict) and "error" in data:
226	        return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
227	    if isinstance(data, dict) and data.get("binary_content"):
228	        return f"Received unexpected binary content from Asteroid Lookup API. URL: {data.get('url')}"
229	
230	    try:
231	        result = [
232	            f"ID: {data.get('id', 'Unknown')}",
233	            f"Name: {data.get('name', 'Unknown')}",
234	            f"Designation: {data.get('designation', 'Unknown')}",
235	            f"NASA JPL URL: {data.get('nasa_jpl_url', 'Not available')}",
236	            f"Absolute magnitude: {data.get('absolute_magnitude_h', 'Unknown')}",
237	            f"\nEstimated diameter:",
238	            f"  Minimum (km): {data.get('estimated_diameter', {}).get('kilometers', {}).get('estimated_diameter_min', 'Unknown')}",
239	            f"  Maximum (km): {data.get('estimated_diameter', {}).get('kilometers', {}).get('estimated_diameter_max', 'Unknown')}",
240	            f"\nPotentially hazardous: {'Yes' if data.get('is_potentially_hazardous_asteroid', False) else 'No'}",
241	            f"Sentry Object: {'Yes' if data.get('is_sentry_object', False) else 'No'}" # Corrected field name based on common API patterns
242	        ]
243	        
244	        # Approach information
245	        close_approaches = data.get('close_approach_data', [])
246	        if close_approaches:
247	            result.append("\nClose approaches:")
248	            for i, approach in enumerate(close_approaches[:5], 1):  # Limit to first 5 to avoid overload
249	                result.append(f"\n  Approach {i}:")
250	                result.append(f"  Date: {approach.get('close_approach_date_full', 'Unknown')}")
251	                result.append(f"  Orbiting body: {approach.get('orbiting_body', 'Unknown')}")
252	                result.append(f"  Distance (km): {approach.get('miss_distance', {}).get('kilometers', 'Unknown')}")
253	                result.append(f"  Relative velocity (km/h): {approach.get('relative_velocity', {}).get('kilometers_per_hour', 'Unknown')}")
254	            
255	            if len(close_approaches) > 5:
256	                result.append(f"\n  ... and {len(close_approaches) - 5} more approaches.")
257	        
258	        # Orbital data
259	        orbital_data = data.get('orbital_data', {})
260	        if orbital_data:
261	            result.append("\nOrbital data:")
262	            result.append(f"  Orbit determination date: {orbital_data.get('orbit_determination_date', 'Unknown')}") # Corrected field name
263	            result.append(f"  Semi-major axis: {orbital_data.get('semi_major_axis', 'Unknown')} AU")
264	            result.append(f"  Eccentricity: {orbital_data.get('eccentricity', 'Unknown')}")
265	            result.append(f"  Inclination: {orbital_data.get('inclination', 'Unknown')} degrees")
266	            result.append(f"  Orbital period: {orbital_data.get('orbital_period', 'Unknown')} days")
267	        
268	        return "\n".join(result)
269	    except Exception as e:
270	        logger.error(f"Error processing Asteroid Lookup data: {str(e)}")
271	        return f"Error processing asteroid data: {str(e)}"
272	
273	@mcp.tool()
274	async def browse_asteroids() -> str:
275	    """Browse the asteroid dataset."""
276	    url = f"{NASA_API_BASE}/neo/rest/v1/neo/browse"
277	    data = await make_nasa_request(url)
278	    
279	    if not data:
280	        return "Could not retrieve asteroid dataset due to a connection error."
281	    
282	    # Check for error response (must be a dictionary)
283	    if isinstance(data, dict) and "error" in data:
284	        return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
285	    if isinstance(data, dict) and data.get("binary_content"):
286	        return f"Received unexpected binary content from Browse Asteroids API. URL: {data.get('url')}"
287	
288	    try:
289	        near_earth_objects = data.get('near_earth_objects', [])
290	        page_info = f"Page {data.get('page', {}).get('number', 'Unknown')} of {data.get('page', {}).get('total_pages', 'Unknown')}"
291	        total_elements = f"Total elements: {data.get('page', {}).get('total_elements', 'Unknown')}"
292	        
293	        result = [page_info, total_elements, ""]
294	        
295	        # Limit the number of asteroids displayed to avoid excessive output
296	        display_limit = 10 
297	        count = 0
298	        for asteroid in near_earth_objects:
299	            if count >= display_limit:
300	                result.append(f"\n... and {len(near_earth_objects) - display_limit} more asteroids on this page.")
301	                break
302	            result.append(f"ID: {asteroid.get('id', 'Unknown')}")
303	            result.append(f"Name: {asteroid.get('name', 'Unknown')}")
304	            result.append(f"Absolute magnitude: {asteroid.get('absolute_magnitude_h', 'Unknown')}")
305	            result.append(f"Estimated diameter (min): {asteroid.get('estimated_diameter', {}).get('kilometers', {}).get('estimated_diameter_min', 'Unknown')} km")
306	            result.append(f"Estimated diameter (max): {asteroid.get('estimated_diameter', {}).get('kilometers', {}).get('estimated_diameter_max', 'Unknown')} km")
307	            result.append(f"Potentially hazardous: {'Yes' if asteroid.get('is_potentially_hazardous_asteroid', False) else 'No'}")
308	            result.append("-" * 40)
309	            count += 1
310	        
311	        return "\n".join(result)
312	    except Exception as e:
313	        logger.error(f"Error processing Browse Asteroids data: {str(e)}")
314	        return f"Error processing asteroid data: {str(e)}"
