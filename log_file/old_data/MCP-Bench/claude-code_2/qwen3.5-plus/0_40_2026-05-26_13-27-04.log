1096	@mcp.tool()
1097	async def get_exoplanet_data(query: str = None, table: str = "exoplanets", format: str = "json") -> str:
1098	    """Get data from NASA's Exoplanet Archive.
1099	    
1100	    Args:
1101	        query: Specific query to filter results using Exoplanet Archive syntax. Example: "pl_orbper > 300 and pl_rade < 2"
1102	        table: Table to query. Common options: exoplanets (confirmed planets), cumulative (Kepler Objects of Interest), koi (subset of cumulative), tce (Threshold Crossing Events).
1103	        format: Output format. Options: json, csv, xml, ipac. Default: json.
1104	    """
1105	    base_url = "https://exoplanetarchive.ipac.caltech.edu/cgi-bin/nstedAPI/nph-nstedAPI"
1106	    
1107	    params = {
1108	        "table": table,
1109	        "format": format
1110	    }
1111	    
1112	    if query:
1113	        # Basic validation/sanitization could be added here if needed
1114	        params["where"] = query
1115	    
1116	    # The exoplanet API doesn't use api.nasa.gov, so no NASA API key needed
1117	    # It also might return non-JSON formats directly
1118	    async with httpx.AsyncClient() as client:
1119	        try:
1120	            logger.info(f"Requesting Exoplanet data: {base_url} with params: {params}")
1121	            response = await client.get(base_url, params=params, timeout=60.0) # Increased timeout for potentially large queries
1122	            response.raise_for_status()
1123	            
1124	            content_type = response.headers.get("Content-Type", "").lower()
1125	
1126	            # Handle different formats
1127	            if format == "json" and "application/json" in content_type:
1128	                try:
1129	                    data = response.json()
1130	                except json.JSONDecodeError as json_err:
1131	                    logger.error(f"Exoplanet JSON decode error: {json_err}")
1132	                    return f"Error: Failed to decode JSON response from Exoplanet Archive. Response text: {response.text[:500]}"
1133	            elif format != "json" and ("text/" in content_type or "application/xml" in content_type or "application/csv" in content_type):
1134	                 # Return raw text for non-JSON formats, limited length
1135	                 text_response = response.text
1136	                 limit = 2000 # Limit output size
1137	                 if len(text_response) > limit:
1138	                     return f"Received {format.upper()} data (truncated):n{text_response[:limit]}n... (response truncated)"
1139	                 else:
1140	                     return f"Received {format.upper()} data:n{text_response}"
1141	            else:
1142	                # Unexpected content type for the requested format
1143	                logger.warning(f"Exoplanet API returned unexpected content type '{content_type}' for format '{format}'. URL: {response.url}")
1144	                return f"Error: Exoplanet Archive returned unexpected content type '{content_type}'. Response text: {response.text[:500]}"
1145	
1146	            # Process JSON data
1147	            if not isinstance(data, list):
1148	                 logger.error(f"Unexpected non-list JSON response from Exoplanet Archive: {data}")
1149	                 return "Received unexpected JSON data format from Exoplanet Archive."
1150	            
1151	            if not data:
1152	                return "No exoplanet data found for the specified query."
1153	            
1154	            result = []
1155	            total_found = len(data)
1156	            display_limit = 10 
1157	            
1158	            if total_found > display_limit:
1159	                result.append(f"Found {total_found} entries. Showing the first {display_limit}:")
1160	                data_to_display = data[:display_limit]
1161	            else:
1162	                result.append(f"Found {total_found} entries:")
1163	                data_to_display = data
1164	            
1165	            for entry in data_to_display:
1166	                # Dynamically display available fields (up to a limit)
1167	                entry_details = []
1168	                max_fields = 8
1169	                fields_shown = 0
1170	                for key, value in entry.items():
1171	                    if fields_shown >= max_fields:
1172	                        entry_details.append("  ... (more fields exist)")
1173	                        break
1174	                    # Simple display, skip null/empty values if desired
1175	                    if value is not None and value != "": 
1176	                        entry_details.append(f"  {key}: {value}")
1177	                        fields_shown += 1
1178	                
1179	                if entry_details:
1180	                    result.append("\n" + "\n".join(entry_details))
1181	                    result.append("-" * 40)
1182	                else:
1183	                    # Handle case where entry might be empty or only has nulls
1184	                    result.append(f"\nEntry found, but no displayable data (ID might be {entry.get('id', 'N/A')}).")
1185	                    result.append("-" * 40)
1186	
1187	            return "\n".join(result)
1188	        
1189	        except httpx.HTTPStatusError as http_err:
1190	            logger.error(f"Exoplanet API HTTP error: {http_err} - {http_err.response.status_code}")
1191	            return f"Error: Exoplanet Archive returned HTTP status {http_err.response.status_code}. Response: {http_err.response.text[:500]}"
1192	        except httpx.RequestError as req_err:
