1299	        
1300	    url = f"{NASA_API_BASE}/mars-photos/api/v1/manifests/{rover_name}"
1301	    data = await make_nasa_request(url)
1302	    
1303	    if not data:
1304	        return f"Could not retrieve mission manifest for {rover_name} due to a connection error."
1305	    
1306	    # Check for error response (must be a dictionary)
