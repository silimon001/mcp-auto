274	                    'gamma4': -0.00079,
275	                    'sigma': 10.9573
276	                }
277	            }
278	        }
279	        
280	        # 키의 z-score 계산
281	        height_zscore = find_height_zscore(age, height, sex)
282	        
283	        # 수축기 혈압 센타일 계산
284	        sys_mu = calc_mu(age, height_zscore, bp_regression[sex]['systolic'])
285	        sys_zscore = (systolic - sys_mu) / bp_regression[sex]['systolic']['sigma']
286	        sys_percentile = stats.norm.cdf(sys_zscore) * 100
287	        
288	        # 이완기 혈압 센타일 계산
289	        dia_mu = calc_mu(age, height_zscore, bp_regression[sex]['diastolic'])
290	        dia_zscore = (diastolic - dia_mu) / bp_regression[sex]['diastolic']['sigma']
291	        dia_percentile = stats.norm.cdf(dia_zscore) * 100
292	        
293	        # 결과 반환
294	        return {
295	            'systolic': round(sys_percentile, 1),
296	            'diastolic': round(dia_percentile, 1)
297	        }
298	    except Exception as e:
299	        return {'error': str(e)}
300	
301	def calc_mu(age, zht, params):
302	    """
303	    혈압의 평균(mu)을 계산
304	    
305	    Parameters:
306	    -----------
307	    age : float
308	        나이(년)
309	    zht : float
310	        키의 z-score
311	    params : dict
312	        BP 회귀 파라미터
313	        
314	    Returns:
315	    --------
316	    float
317	        혈압의 평균값
318	    """
319	    return (params['alpha'] +
320	            params['beta1'] * (age - 10) +
321	            params['beta2'] * (age - 10)**2 +
322	            params['beta3'] * (age - 10)**3 +
323	            params['beta4'] * (age - 10)**4 +
324	            params['gamma1'] * zht +
325	            params['gamma2'] * zht**2 +
326	            params['gamma3'] * zht**3 +
327	            params['gamma4'] * zht**4)
328	
329	
330	def find_height_zscore(age, height, sex):
331	    """
332	    성별과 연령에 따른 키의 z-score 계산
333	    
334	    Parameters:
335	    -----------
336	    age : float
337	        나이(년)
338	    height : float
339	        키(미터)
340	    sex : str
341	        성별('male' 또는 'female')
342	        
343	    Returns:
344	    --------
345	    float
346	        키의 z-score
347	    """
348	    # 연령을 개월로 변환
349	    age_months = age * 12
350	    
351	    # 키를 센티미터로 변환
352	    height_cm = height * 100
353	    
354	    # CDC 데이터에서 해당 연령대의 파라미터를 찾기
355	    params = find_height_parameters(age_months, sex)
356	    
357	    if params is None:
358	        # 파라미터를 찾을 수 없는 경우 기본값 0 반환
359	        return 0
360	    
361	    # 키의 z-score 계산
362	    if params['l'] == 0:
363	        return math.log(height_cm / params['m']) / params['s']
364	    else:
365	        return (math.pow(height_cm / params['m'], params['l']) - 1) / (params['l'] * params['s'])
366	
367	
368	def find_height_parameters(age_months, sex):
369	    """
370	    특정 연령대에 대한 CDC 신장 파라미터 찾기
371	    
372	    Parameters:
373	    -----------
374	    age_months : float
375	        개월 단위 나이
376	    sex : str
377	        성별('male' 또는 'female')
378	        
379	    Returns:
380	    --------
381	    dict 또는 None
382	        해당 연령대의 LMS 파라미터 (없으면 None)
383	    """
384	    # CDC 신장 데이터
385	    if age_months <= 36:
386	        ref_data = CDC_LENGTH_DATA[sex]
387	    else:
388	        ref_data = CDC_STATURE_DATA[sex]
389	    
390	    # 정확한 연령 또는 연령 범위 찾기
391	    for i in range(len(ref_data) - 1):
392	        if age_months == ref_data[i]['age']:
393	            return ref_data[i]
394	        elif age_months > ref_data[i]['age'] and age_months < ref_data[i+1]['age']:
395	            # 선형 보간
396	            weight = (age_months - ref_data[i]['age']) / (ref_data[i+1]['age'] - ref_data[i]['age'])
397	            
398	            exact = {
399	                'sex': sex,
400	                'age': age_months,
401	                'l': mean(ref_data[i]['l'], ref_data[i+1]['l'], weight),
402	                'm': mean(ref_data[i]['m'], ref_data[i+1]['m'], weight),
403	                's': mean(ref_data[i]['s'], ref_data[i+1]['s'], weight)
404	            }
405	            return exact
406	    
407	    # 찾지 못한 경우 None 반환
408	    return None
409	
410	
411	def mean(a, b, weight):
412	    """
413	    두 값의 가중 평균 계산
414	    
415	    Parameters:
416	    -----------
417	    a : float
418	        첫 번째 값
419	    b : float
420	        두 번째 값
421	    weight : float
422	        가중치(0~1)
423	        
424	    Returns:
425	    --------
426	    float
427	        가중 평균
428	    """
429	    return b * weight + a * (1 - weight)
430	
431	
