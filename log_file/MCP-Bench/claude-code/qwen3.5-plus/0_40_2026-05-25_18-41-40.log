956	@mcp.tool()
957	def bmi_calculator(weight: float, height: float) -> float:
958	    """
959	    Calculates Body Mass Index (BMI) and Body Surface Area (BSA)
960	    
961	    Parameters:
962	    -----------
963	    weight : float
964	        Weight in kilograms
965	    height : float
966	        Height in centimeters (default) or meters
967	    height_unit : str
968	        Unit of height measurement ('cm' or 'm', default is 'cm')
969	    
970	    Returns:
971	    --------
972	    bmi: float
973	        Body Mass Index (kg/m²)
974	    """
975	    # Normalize height to meters for calculations
976	    try:
977	        height_unit = "cm"
978	        if height_unit.lower() == "cm":
979	            height_m = height / 100
980	        elif height_unit.lower() == "m":
981	            height_m = height
982	        else:
983	            raise ValueError("Height unit must be 'cm' or 'm'")
984	        
985	        # Calculate BMI: weight(kg) / height(m)²
986	        bmi = weight / (height_m * height_m)
987	        
988	        # Calculate BSA using Mosteller formula: √(height(cm) × weight(kg) / 3600)
989	        height_cm = height_m * 100
990	        bsa = math.sqrt((height_cm * weight) / 3600)
991	        
992	        # Determine BMI classification
993	        bmi_classification = ""
994	        if bmi < 18.5:
995	            bmi_classification = "Underweight"
996	        elif bmi < 25:
997	            bmi_classification = "Normal weight"
998	        elif bmi < 30:
999	            bmi_classification = "Overweight"
1000	        elif bmi < 35:
1001	            bmi_classification = "Obesity class I"
1002	        elif bmi < 40:
1003	            bmi_classification = "Obesity class II"
1004	        else:
1005	            bmi_classification = "Obesity class III"
1006	        
1007	        # Return results
1008	        return bmi
1009	    except Exception as e:
1010	        return {
1011	            "error": str(e)
1012	        }
