3	export class ApiKeyManager {
4	  private static instance: ApiKeyManager;
5	  private defaultApiKey: string | undefined;
6	
7	  private constructor() {
8	    // Initialize with environment variable or command-line provided key
9	    this.defaultApiKey = process.env.GOOGLE_MAPS_API_KEY;
10	  }
11	
12	  public static getInstance(): ApiKeyManager {
13	    if (!ApiKeyManager.instance) {
14	      ApiKeyManager.instance = new ApiKeyManager();
15	    }
16	    return ApiKeyManager.instance;
17	  }
