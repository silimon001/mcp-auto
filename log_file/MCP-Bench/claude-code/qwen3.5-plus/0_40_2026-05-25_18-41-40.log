146	def mdrd_gfr(scr: float, age: int, is_black: bool, is_female: bool) -> float:
147	    """
148	    MDRD GFR Equation
149	    Estimates GFR in CKD patients using creatinine and patient characteristics.
150	    
151	    Parameters:
152	    -----------
153	    scr : float
154	        Serum creatinine level in mg/dL
155	    age : int
156	        Age in years
157	    is_black : bool
158	        True if patient is Black
159	    is_female : bool
160	        True if patient is female
161	    
162	    Returns:
163	    --------
164	    float
165	        Estimated GFR in mL/min/1.73m^2
166	    """
167	    try:
168	        # Base calculation
169	        gfr = 175 * (scr ** -1.154) * (age ** -0.203)
170	        
171	        # Apply race factor if patient is Black
172	        if is_black:
173	            gfr *= 1.212
174	        
175	        # Apply gender factor if patient is female
176	        if is_female:
177	            gfr *= 0.742
178	            
179	        return gfr
180	    except Exception as e:
181	        return {'error': str(e)}
