19	  /**
20	   * Set the default API key (from command line or environment)
21	   */
22	  public setDefaultApiKey(key: string): void {
23	    this.defaultApiKey = key;
24	    process.env.GOOGLE_MAPS_API_KEY = key;
25	  }
26	
27	  /**
28	   * Get API key with priority:
29	   * 1. HTTP Header (X-Google-Maps-API-Key or Authorization: Bearer)
30	   * 2. Session-specific API key
31	   * 3. Default API key (command line or environment)
32	   */
33	  public getApiKey(req?: Request, sessionApiKey?: string): string | undefined {
34	    if (req) {
35	      // Check for API key in headers
36	      const headerApiKey = req.headers["x-google-maps-api-key"] as string;
37	      if (headerApiKey) {
38	        return headerApiKey;
39	      }
40	
41	      // Check for Bearer token in Authorization header
42	      const authHeader = req.headers["authorization"] as string;
43	      if (authHeader && authHeader.startsWith("Bearer ")) {
44	        return authHeader.substring(7);
45	      }
46	    }
47	
48	    // Use session-specific API key if available
49	    if (sessionApiKey) {
50	      return sessionApiKey;
51	    }
52	
53	    // Fall back to default API key
54	    return this.defaultApiKey;
55	  }
56	
57	  /**
58	   * Check if any API key is available
59	   */
60	  public hasApiKey(req?: Request, sessionApiKey?: string): boolean {
61	    return !!this.getApiKey(req, sessionApiKey);
62	  }
63	
64	  /**
65	   * Validate API key format (basic validation)
66	   */
67	  public isValidApiKeyFormat(key: string): boolean {
68	    // Google Maps API keys are typically 39 characters long
69	    // and contain alphanumeric characters, hyphens, and underscores
70	    return /^[A-Za-z0-9_-]{20,50}$/.test(key);
