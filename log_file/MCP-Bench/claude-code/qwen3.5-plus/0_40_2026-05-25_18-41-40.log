51	@mcp.tool()
52	def egfr_epi(scr: float, age: int, male: bool) -> float:
53	    """
54	    Estimated Glomerular Filtration Rate (eGFR) using the EPI formula (version 2021)
55	    Reference: N Engl J Med. 2021 Nov 4;385(19):1737-1749
56	    
57	    Parameters:
58	    -----------
59	    scr : float
60	        serum creatinine level in mg/dL
61	    age : int
62	        Age in years
63	    male : bool
64	        true if Male
65	    
66	    Returns:
67	    --------
68	    float
69	        Estimated GFR in mL/min/1.73m^2
70	    """
71	    try:
72	        # 성별에 따른 κ와 α 값 설정
73	        k = 0.9 if male else 0.7
74	        a = -0.302 if male else -0.241
75	        return 142 * (0.9938 ** age) * (min(scr / k, 1) ** a) * (max(scr / k, 1) ** -1.2) * (1 if male else 1.012)
76	    except Exception as e:
77	        return {'error': str(e)}
78	
79	
80	
81	
82	@mcp.tool()
83	def egfr_epi_cr_cys(scr: float, scys: float, age: int, male: bool) -> float:
84	    """
85	    Estimated Glomerular Filtration Rate (eGFR) using the 2021 CKD-EPI Creatinine-Cystatin C equation
86	    Reference: N Engl J Med. 2021 Nov 4;385(19):1737-1749
87	    
88	    Parameters:
89	    -----------
90	    scr : float
91	        Serum creatinine level in mg/dL
92	    scys : float
93	        Serum cystatin C level in mg/L
94	    age : int
95	        Age in years
96	    male : bool
97	        True if patient is male, False if female
98	    
99	    Returns:
100	    --------
101	    efgr : float
102	        Estimated GFR in mL/min/1.73m^2
103	    """
104	    try:
105	        # Set parameters based on sex, creatinine level, and cystatin C level
106	        if male:
107	            k_cr = 0.9  # Parameter A
108	            k_cys = 0.8  # Parameter C
109	            
110	            if scr <= k_cr:
111	                alpha = -0.144  # Parameter B
112	            else:
113	                alpha = -0.544  # Parameter B
114	                
115	            if scys <= k_cys:
116	                beta = -0.323  # Parameter D
117	            else:
118	                beta = -0.778  # Parameter D
119	                
120	            sex_factor = 1.0
121	        else:  # female
122	            k_cr = 0.7  # Parameter A
123	            k_cys = 0.8  # Parameter C
124	            
125	            if scr <= k_cr:
126	                alpha = -0.219  # Parameter B
127	            else:
128	                alpha = -0.544  # Parameter B
129	                
130	            if scys <= k_cys:
131	                beta = -0.323  # Parameter D
132	            else:
133	                beta = -0.778  # Parameter D
134	                
135	            sex_factor = 0.963
136	        
137	        # Calculate eGFR using the 2021 CKD-EPI Creatinine-Cystatin C equation
138	        egfr = 135 * (scr / k_cr) ** alpha * (scys / k_cys) ** beta * (0.9961 ** age) * sex_factor
139	        
140	        # Return results
141	        return egfr
142	    except Exception as e:
143	        return {'error': str(e)}
