1	from mcp.server.fastmcp import FastMCP
2	import requests
3	from typing import Dict, Any
4	
5	# WeatherAPI configuration
6	API_KEY = "366fd563131a4af1bd962603252105"
7	BASE_URL = "http://api.weatherapi.com/v1"
8	
9	# Initialize MCP server
10	mcp = FastMCP("weather-api-mcp")
11	
12	def get_current_weather(city: str) -> Dict[str, Any]:
13	    """Get current weather for a city using WeatherAPI"""
14	    url = f"{BASE_URL}/current.json?key={API_KEY}&q={city}&lang=tr"
15	    try:
16	        response = requests.get(url, timeout=10)
17	        response.raise_for_status()
18	        data = response.json()
19	
20	        return {
21	            "city": data.get("location", {}).get("name"),
22	            "country": data.get("location", {}).get("country"),
23	            "region": data.get("location", {}).get("region"),
24	            "weather": data.get("current", {}).get("condition", {}).get("text"),
25	            "temperature_c": data.get("current", {}).get("temp_c"),
26	            "temperature_f": data.get("current", {}).get("temp_f"),
27	            "feelslike_c": data.get("current", {}).get("feelslike_c"),
28	            "feelslike_f": data.get("current", {}).get("feelslike_f"),
29	            "humidity": data.get("current", {}).get("humidity"),
30	            "wind_kph": data.get("current", {}).get("wind_kph"),
31	            "wind_mph": data.get("current", {}).get("wind_mph"),
32	            "wind_dir": data.get("current", {}).get("wind_dir"),
33	            "pressure_mb": data.get("current", {}).get("pressure_mb"),
34	            "visibility_km": data.get("current", {}).get("vis_km"),
35	            "uv_index": data.get("current", {}).get("uv"),
36	            "icon": data.get("current", {}).get("condition", {}).get("icon"),
37	            "last_updated": data.get("current", {}).get("last_updated")
38	        }
39	    except requests.exceptions.RequestException as e:
40	        return {"error": f"API request failed: {str(e)}"}
41	    except Exception as e:
42	        return {"error": f"Unexpected error: {str(e)}"}
43	
44	def get_weather_forecast(city: str, days: int = 3) -> Dict[str, Any]:
45	    """Get weather forecast for a city using WeatherAPI"""
46	    url = f"{BASE_URL}/forecast.json?key={API_KEY}&q={city}&days={days}&lang=tr"
47	    try:
48	        response = requests.get(url, timeout=10)
49	        response.raise_for_status()
50	        data = response.json()
51	
52	        forecast_days = []
53	        for day in data.get("forecast", {}).get("forecastday", []):
54	            forecast_days.append({
55	                "date": day.get("date"),
56	                "max_temp_c": day.get("day", {}).get("maxtemp_c"),
57	                "min_temp_c": day.get("day", {}).get("mintemp_c"),
58	                "max_temp_f": day.get("day", {}).get("maxtemp_f"),
59	                "min_temp_f": day.get("day", {}).get("mintemp_f"),
60	                "condition": day.get("day", {}).get("condition", {}).get("text"),
61	                "icon": day.get("day", {}).get("condition", {}).get("icon"),
62	                "chance_of_rain": day.get("day", {}).get("daily_chance_of_rain"),
63	                "chance_of_snow": day.get("day", {}).get("daily_chance_of_snow"),
64	                "max_wind_kph": day.get("day", {}).get("maxwind_kph"),
65	                "avg_humidity": day.get("day", {}).get("avghumidity"),
66	                "uv_index": day.get("day", {}).get("uv")
67	            })
68	
69	        return {
70	            "city": data.get("location", {}).get("name"),
71	            "country": data.get("location", {}).get("country"),
72	            "region": data.get("location", {}).get("region"),
73	            "forecast": forecast_days
74	        }
75	    except requests.exceptions.RequestException as e:
76	        return {"error": f"API request failed: {str(e)}"}
77	    except Exception as e:
78	        return {"error": f"Unexpected error: {str(e)}"}
79	
80	def search_locations(query: str) -> Dict[str, Any]:
81	    """Search for locations using WeatherAPI"""
82	    url = f"{BASE_URL}/search.json?key={API_KEY}&q={query}"
83	    try:
84	        response = requests.get(url, timeout=10)
85	        response.raise_for_status()
86	        data = response.json()
87	
88	        locations = []
89	        for location in data:
90	            locations.append({
91	                "name": location.get("name"),
92	                "region": location.get("region"),
93	                "country": location.get("country"),
94	                "lat": location.get("lat"),
95	                "lon": location.get("lon"),
96	                "url": location.get("url")
97	            })
98	
99	        return {"locations": locations}
100	    except requests.exceptions.RequestException as e:
101	        return {"error": f"API request failed: {str(e)}"}
102	    except Exception as e:
103	        return {"error": f"Unexpected error: {str(e)}"}
104	
105	@mcp.tool()
106	async def get_current_weather_tool(city: str) -> dict:
107	    """
108	    Get current weather information for a specific city.
109	
110	    Args:
111	        city: Name of the city to get weather for
112	
113	    Returns:
114	        Current weather data including temperature, conditions, humidity, wind, etc.
115	    """
116	    return get_current_weather(city)
117	
118	@mcp.tool()
119	async def get_weather_forecast_tool(city: str, days: int = 3) -> dict:
120	    """
121	    Get weather forecast for a specific city.
122	
123	    Args:
124	        city: Name of the city to get forecast for
125	        days: Number of days to forecast (1-10, default: 3)
126	
127	    Returns:
128	        Weather forecast data for the specified number of days
129	    """
130	    if days < 1 or days > 10:
131	        return {"error": "Days must be between 1 and 10"}
132	    return get_weather_forecast(city, days)
133	
134	@mcp.tool()
135	async def search_locations_tool(query: str) -> dict:
136	    """
137	    Search for locations by name.
138	
139	    Args:
140	        query: Location name or partial name to search for
141	
142	    Returns:
143	        List of matching locations with their details
144	    """
145	    return search_locations(query)
146	
147	# Legacy tool for backward compatibility
148	@mcp.tool()
149	async def get_live_temp(city: str) -> dict:
150	    """
151	    Legacy tool: Get current temperature for a city (for backward compatibility).
152	    Use get_current_weather_tool for more detailed information.
153	    """
154	    result = get_current_weather(city)
155	    return result
156	
157	if __name__ == "__main__":
158	    print("Starting WeatherAPI MCP Server...")
159	    print(f"Using API Key: {API_KEY[:10]}...")
160	    print("Starting server...")
161	    mcp.run()

