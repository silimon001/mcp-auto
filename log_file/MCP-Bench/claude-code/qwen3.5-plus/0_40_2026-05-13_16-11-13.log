437	                info['owner'] = repo_info.get('full_name').split('/')[0]
438	                info['name'] = repo_info.get('full_name').split('/')[1]
439	                final_text += f'\n=== REPO INFO START ===\n{info}\n=== REPO INFO END ===\n'
440	                break
441	    return final_text
