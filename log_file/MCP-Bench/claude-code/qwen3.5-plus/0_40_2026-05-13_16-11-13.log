125	    this.server.setRequestHandler(CallToolRequestSchema, async (request) => {
126	      try {
127	        if (!['get_price', 'get_candlesticks'].includes(request.params.name)) {
128	          throw new McpError(
129	            ErrorCode.MethodNotFound,
130	            `Unknown tool: ${request.params.name}`
131	          );
132	        }
133	
134	        const args = request.params.arguments as {
135	          instrument: string;
136	          bar?: string;
137	          limit?: number;
138	        };
139	
140	        if (!args.instrument) {
141	          throw new McpError(
142	            ErrorCode.InvalidParams,
143	            'Missing required parameter: instrument'
144	          );
145	        }
146	
147	        if (request.params.name === 'get_price') {
148	          console.error(`[API] Fetching price for instrument: ${args.instrument}`);
149	          const response = await this.axiosInstance.get<OKXTickerResponse>(
150	            '/market/ticker',
151	            {
152	              params: { instId: args.instrument },
153	            }
154	          );
155	
156	          if (response.data.code !== '0') {
157	            throw new Error(`OKX API error: ${response.data.msg}`);
158	          }
159	
160	          if (!response.data.data || response.data.data.length === 0) {
161	            throw new Error('No data returned from OKX API');
162	          }
163	
164	          const ticker = response.data.data[0];
165	          return {
166	            content: [
167	              {
168	                type: 'text',
169	                text: JSON.stringify({
170	                  instrument: ticker.instId,
171	                  lastPrice: ticker.last,
172	                  bid: ticker.bidPx,
173	                  ask: ticker.askPx,
174	                  high24h: ticker.high24h,
175	                  low24h: ticker.low24h,
176	                  volume24h: ticker.vol24h,
177	                  timestamp: new Date(parseInt(ticker.ts)).toISOString(),
178	                }, null, 2),
179	              },
180	            ],
181	          };
182	        } else {
183	          // get_candlesticks
184	          console.error(`[API] Fetching candlesticks for instrument: ${args.instrument}, bar: ${args.bar || '1m'}, limit: ${args.limit || 100}`);
185	          const response = await this.axiosInstance.get<OKXCandlesticksResponse>(
186	            '/market/candles',
