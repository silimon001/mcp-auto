1	import numpy as np
2	import uvicorn
3	from mcp.server.fastmcp import FastMCP
4	from pydantic import Field
5	from typing import Annotated
6	from starlette.applications import Starlette
7	from starlette.middleware.cors import CORSMiddleware
8	from starlette.routing import Mount
9	
10	import linear_algebra
11	import vector_calculus
12	import visualization
13	
14	# Initialize tensor store
15	tensor_store = {}
16	
17	# Initialize MCP server with HTTP transport
18	mcp = FastMCP("scientific_computations", stateless_http=False)
19	
20	
21	# Matrix creation, deletion, and modification
22	@mcp.tool()
23	def create_tensor(shape: Annotated[list[int], Field(min_items=1, description="Tensor shape as list of integers")],
24	                  values: Annotated[
25	                      list[float], Field(min_items=1, description="Flat list of floats to fill the tensor")],
26	                  name: str) -> np.ndarray:
27	    """
28	    Creates a NumPy array (matrix) with a specified shape and values.
29	
30	    Args:
31	        shape (list[int]): The shape of the resulting array as a tuple(e.g., (2, 3)).
32	        values (list[float]): A flat list of values to populate the array.
33	        name (str): The name of the tensor to be stored.
34	
35	    Returns:
36	        np.ndarray: A NumPy array with the specified shape.
37	
38	    Raises:
39	        ValueError: If the number of values does not match the product of the shape.
40	    """
41	    shape = [int(x) for x in shape]
42	    values = [float(x) for x in values]
43	
44	    if len(values) != np.prod(shape):
45	        raise ValueError("Shape does not match number of values.")
46	    a = np.array(values).reshape(shape)
47	
48	    tensor_store[name] = a
49	    return a
50	
51	
52	@mcp.tool()
53	def view_tensor(name: str) -> dict:
54	    """
55	    Returns an immutable view of a previously stored NumPy tensor from the in-memory tensor store.
56	
57	    Args:
58	        name (str): The name of the tensor as stored in the in-store dictionary
59	    Returns:
60	        dict: The in-store dictionary for tensors
61	
62	    """
63	    return tensor_store[name]
64	
65	
66	@mcp.resource("data://tensor_store")
67	def list_tensor_names() -> str:
68	    """
69	    Lists the names of all tensors currently stored in the tensor store.
70	
71	    Returns:
72	        str: A newline-separated list of tensor names.
73	    """
74	    return "\n".join(tensor_store.keys())
75	
76	
77	@mcp.tool()
78	def delete_tensor(name: str):
79	    """
80	    Deletes a tensor from the in-memory tensor store.
81	
82	    Args:
83	        name (str): The name of the tensor to delete.
84	
85	    Raises:
86	        ValueError: If the tensor name is not found in the store or if an error occurs during deletion.
87	    """
88	    if name not in tensor_store:
89	        raise ValueError("One or both tensor names not found in the store.")
90	
91	    try:
92	        tensor_store.pop(name)
93	    except ValueError as e:
94	        raise ValueError(f"Error removing tensor:{e}")
95	
96	
97	# Register additional tools from modules
98	linear_algebra.register_tools(mcp, tensor_store)
99	vector_calculus.register_tools(mcp, tensor_store)
100	visualization.register_tools(mcp)
101	
102	
103	def main():
104	    # Run with streamable HTTP transport
105	    app = mcp.streamable_http_app()
106	
107	    app = CORSMiddleware(
108	        app,
109	        allow_origins=["*"],  # Configure appropriately for production
110	        allow_methods=["GET", "POST", "DELETE", "OPTIONS"],  # MCP streamable HTTP methods
111	        allow_headers=["*"],
112	        expose_headers=["mcp-session-id", "mcp-protocol-version"],
113	    )
114	
115	    uvicorn.run(app, host='0.0.0.0', port=8081, log_level='debug')
116	
117	
118	if __name__ == "__main__":
119	    main()
120	

