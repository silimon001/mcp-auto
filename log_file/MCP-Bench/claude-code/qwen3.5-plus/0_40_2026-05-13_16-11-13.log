217	def render_content(obj):
218	    """
219	    把 Claude stream-json content 递归展开成纯 string
220	    """
221	    if obj is None:
222	        return ""
223	
224	    # str
225	    if isinstance(obj, str):
226	        return obj
227	
228	    # dict（核心：Claude node）
229	    if isinstance(obj, dict):
230	        t = obj.get("type")
231	
232	        # tool result wrapper
233	        if t == "text":
234	            return render_content(obj.get("text"))
235	
236	        if t == "tool_result":
237	            return render_content(obj.get("content"))
238	
239	        # fallback：尽量抽取 text
240	        if "text" in obj:
241	            return render_content(obj["text"])
242	
243	        return json.dumps(obj, ensure_ascii=False)
244	
245	    # list（递归 flatten）
246	    if isinstance(obj, list):
247	        return "\n".join(render_content(x) for x in obj)
248	
249	    # fallback
250	    return str(obj)
251	
252	
253	def collect_messages(events):
254	    """聚合事件，记录时间戳，并捕获 result 事件用于总结"""
255	    messages = {}
256	    order = []      # dict(system/user/result) 或 str(assistant msg_id)
257	
258	    for event in events:
259	        etype = event.get("type")
260	        ts = event.get("timestamp") or event.get("_received_at", datetime.now(timezone.utc).isoformat())
261	
262	        # -------- system --------
263	        if etype == "system":
264	            order.append({
265	                "type": "system",
266	                "content": f"[SYSTEM] {event.get('subtype', '')}",
267	                "timestamp": ts
268	            })
269	            continue
270	
271	        # -------- user --------
272	        if etype == "user":
273	            contents = event.get("message", {}).get("content", [])
274	            text = render_content(contents)
275	            order.append({
276	                "type": "user",
277	                "content": text,
278	                "timestamp": ts
279	            })
280	            continue
281	
282	        # -------- result (最终总结) --------
283	        if etype == "result":
284	            order.append({
285	                "type": "result",
286	                "timestamp": ts,
287	                "data": {
288	                    "subtype": event.get("subtype"),
289	                    "is_error": event.get("is_error"),
290	                    "num_turns": event.get("num_turns"),
291	                    "stop_reason": event.get("stop_reason"),
292	                    "total_cost_usd": event.get("total_cost_usd"),
293	                    "duration_ms": event.get("duration_ms"),
294	                    "duration_api_ms": event.get("duration_api_ms"),
295	                    "usage": event.get("usage", {}),
296	                    "errors": event.get("errors", []),
297	                    "terminal_reason": event.get("terminal_reason")
298	                }
299	            })
300	            continue
301	
302	        # -------- assistant --------
303	        if etype == "assistant":
304	            msg = event.get("message", {})
305	            msg_id = msg.get("id")
306	
307	            if msg_id not in messages:
308	                messages[msg_id] = {
309	                    "type": "assistant",
310	                    "texts": [],
311	                    "tools": [],
312	                    "tokens": None,
313	                    "timestamp": ts
314	                }
315	                order.append(msg_id)     # 保证顺序
316	
317	            entry = messages[msg_id]
318	
319	            for c in msg.get("content", []):
320	                ctype = c.get("type")
321	                if ctype == "text":
322	                    entry["texts"].append(c.get("text", ""))
323	                elif ctype == "tool_use":
324	                    entry["tools"].append({
325	                        "name": c.get("name"),
326	                        "input": c.get("input")
327	                    })
328	
329	            if msg.get("usage"):
330	                entry["tokens"] = {
331	                    "input": msg["usage"].get("input_tokens"),
332	                    "output": msg["usage"].get("output_tokens")
333	                }
334	
335	    return messages, order
336	
337	
338	def write_log(messages, order, log_file):
339	    """按轮次和时间戳输出，末尾附加任务结果总结"""
340	    turn = 0
341	    with open(log_file, "a", encoding="utf-8") as f:
342	        for item in order:
343	            # -------- 结果总结（直接输出，不改变轮次）--------
344	            if isinstance(item, dict) and item.get("type") == "result":
345	                ts = item.get("timestamp", "")
346	                data = item["data"]
347	
348	                f.write(f"\n{'=' * 60}\n")
349	                f.write(f"[RESULT] [TIMESTAMP {ts}]\n")
350	                f.write(f"  状态: {'❌ 失败' if data['is_error'] else '✅ 成功'}\n")
351	                f.write(f"  子类型: {data['subtype']}\n")
352	                f.write(f"  实际轮次: {data['num_turns']}\n")
353	                f.write(f"  停止原因: {data['stop_reason']}\n")
354	                f.write(f"  终端原因: {data['terminal_reason']}\n")
355	                f.write(f"  耗时: {data['duration_ms']} ms (API: {data['duration_api_ms']} ms)\n")
356	                f.write(f"  成本: ${data['total_cost_usd']:.6f}\n")
357	
358	                usage = data.get("usage", {})
359	                if usage:
360	                    f.write(f"  Token 使用:\n")
361	                    f.write(f"    - 输入: {usage.get('input_tokens', '?')}\n")
362	                    f.write(f"    - 输出: {usage.get('output_tokens', '?')}\n")
363	                    f.write(f"    - 缓存创建: {usage.get('cache_creation_input_tokens', '?')}\n")
364	                    f.write(f"    - 缓存读取: {usage.get('cache_read_input_tokens', '?')}\n")
365	
366	                errors = data.get("errors", [])
367	                if errors:
368	                    f.write(f"  错误信息:\n")
369	                    for err in errors:
370	                        f.write(f"    - {err}\n")
371	                f.write(f"{'=' * 60}\n")
372	                continue   # result 块输出完毕，跳过后续普通处理
373	
374	            # -------- system / user --------
375	            if isinstance(item, dict):
376	                role = item["type"].upper()
377	                ts = item.get("timestamp", "")
378	                f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
379	                f.write(f"[{role}]:\n{item['content']}\n")
380	                f.write("\n" + "-" * 60 + "\n")
381	                continue
382	
383	            # -------- assistant --------
384	            turn += 1
385	            msg = messages[item]
386	            ts = msg.get("timestamp", "")
387	            f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
388	
389	            text = "\n".join(msg["texts"]).strip()
390	            if text:
391	                f.write(f"[ASSISTANT]:\n{text}\n")
392	
393	            for tool in msg["tools"]:
394	                f.write(f"[ASSISTANT][TOOL]: {tool['name']}\n")
395	                f.write("[TOOL INPUT]:\n")
396	                f.write(json.dumps(tool["input"], indent=2, ensure_ascii=False))
397	                f.write("\n")
398	
399	            if msg["tokens"]:
400	                t = msg["tokens"]
401	                f.write(f"[TOKENS] input={t['input']} output={t['output']}\n")
402	
403	            f.write("\n" + "-" * 60 + "\n")
404	
405	def run_task(prompt_text: str, task_name, pos, count):
406	
407	    json_log_path = f"{LOG_DIR}/tmp_{task_name}.jsonl"
408	
409	    events, stderr = run_claude_stream(
410	        prompt_text,
411	        json_log_path
412	    )
413	
414	    messages, order = collect_messages(events)
415	    log_file = f"{LOG_DIR}/{pos}_{pos+count}_{timestamp}.log"
416	    write_log(messages, order, log_file)
417	
418	    if stderr:
419	        with open(log_file, "a") as f:
420	            f.write("\n[STDERR]\n")
421	            f.write(stderr)
422	
423	    print(f"✅ Done: {log_file}")
