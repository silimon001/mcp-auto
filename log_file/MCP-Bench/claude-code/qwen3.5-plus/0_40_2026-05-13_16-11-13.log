136	async function convertSwaggerToOpenapi(
137	  swaggerUrl: string
138	): Promise<OpenapiDocument | undefined> {
139	  const abortController = new AbortController();
140	  const timeoutId = setTimeout(() => abortController.abort(), 10000);
141	  const result = await fetch(
142	    `https://converter.swagger.io/api/convert?url=${swaggerUrl}`,
143	    { signal: abortController.signal }
144	  )
145	    .then((res) => res.json() as Promise<OpenapiDocument>)
146	    .catch((e) => {
147	      return undefined;
148	    });
149	
150	  clearTimeout(timeoutId);
151	  return result;
152	}
