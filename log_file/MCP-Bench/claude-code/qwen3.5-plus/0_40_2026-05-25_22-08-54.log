797	        ]
798	        
799	        # Cloud score might be present in JSON even if binary isn't returned
800	        if 'cloud_score' in data and data['cloud_score'] is not None: # Check for None explicitly
801	            result.append(f"Cloud score: {data.get('cloud_score')}")
802	        else:
803	            result.append("Cloud score: Not available")
804	
805	        return "\n".join(result)
806	    except Exception as e:
807	        logger.error(f"Error processing Earth Imagery JSON data: {str(e)}")
808	        return f"Error processing Earth imagery data: {str(e)}"
