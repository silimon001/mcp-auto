1	import requests
2	import uuid
3	import json
4	
5	# MCP server URL
6	MCP_URL = "http://localhost:8081/mcp"
7	
8	# Generate a unique session ID
9	SESSION_ID = str(uuid.uuid4())
10	
11	# Headers required by FastMCP
12	HEADERS = {
13	    "Content-Type": "application/json",
14	    "Accept": "application/json,text/event-stream",
15	    "X-MCP-Session": SESSION_ID
16	}
17	
18	
19	# Helper to send a JSON-RPC request
20	def send_rpc(method, params=None, request_id=None):
21	    if params is None:
22	        params = {}
23	    if request_id is None:
24	        request_id = str(uuid.uuid4())
25	
26	    payload = {
27	        "jsonrpc": "2.0",
28	        "method": method,
29	        "id": request_id,
30	        "params": params
31	    }
32	
33	    response = requests.post(MCP_URL, headers=HEADERS, data=json.dumps(payload))
34	    response.raise_for_status()
35	    return response.json()
36	
37	
38	# List all tools
39	tools_response = send_rpc("list_tools")
40	print("Available tools:", tools_response["result"])
41	
42	# Example: call create_tensor
43	tensor_params = {
44	    "shape": [2, 3],
45	    "values": [1, 2, 3, 4, 5, 6],
46	    "name": "my_tensor"
47	}
48	create_response = send_rpc("create_tensor", tensor_params)
49	print("Created tensor:", create_response["result"])

