880	@mcp.tool()
881	async def get_epic_imagery(collection: str = "natural") -> str:
882	    """Get images from the EPIC (Earth Polychromatic Imaging Camera).
883	    
884	    Args:
885	        collection: Collection type. Options: natural, enhanced.
886	    """
887	    if collection not in ["natural", "enhanced"]:
888	        return "Invalid collection. Available options: natural, enhanced."
889	    
890	    # Use the 'images' endpoint to get the latest images
891	    api_path = f"/EPIC/api/{collection}/images"
892	    
893	    url = f"{NASA_API_BASE}{api_path}"
894	    data = await make_nasa_request(url)
895	    
896	    if not data: 
897	        return f"Could not retrieve EPIC images for latest date due to a connection error."
898	    
899	    # Check for error response (must be a dictionary)
900	    if isinstance(data, dict):
901	        if "error" in data:
902	            return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
903	        if data.get("binary_content"):
904	            return f"Received unexpected binary content from EPIC API. URL: {data.get('url')}"
905	    
906	    # Ensure data is a list
907	    if not isinstance(data, list):
908	        logger.error(f"Unexpected non-list response from EPIC API: {data}")
909	        return "Received unexpected data format from EPIC API."
910	
911	    try:
912	        if not data:  # Empty list
913	            return f"No EPIC images available for the most recent date."
914	        
915	        result = [f"EPIC images found: {len(data)}"]
916	        display_limit = 10
917	        count = 0
918	        
919	        for image_meta in data:
920	            if count >= display_limit:
921	                result.append(f"\n... and {len(data) - display_limit} more images.")
922	                break
923	
924	            image_date_time = image_meta.get('date', 'Unknown')
925	            image_identifier = image_meta.get('identifier', 'Unknown') # Use identifier if available
926	            image_name = image_meta.get('image', 'Unknown') # Base name like epic_1b_... 
927	            
928	            # Build image URL
929	            if image_date_time != 'Unknown' and image_name != 'Unknown':
930	                try:
931	                    # Extract date parts for URL path
932	                    dt_obj = datetime.strptime(image_date_time, '%Y-%m-%d %H:%M:%S')
933	                    year, month, day = dt_obj.strftime('%Y'), dt_obj.strftime('%m'), dt_obj.strftime('%d')
934	                    # Construct archive URL
935	                    archive_url = f"https://api.nasa.gov/EPIC/archive/{collection}/{year}/{month}/{day}/png/{image_name}.png"
936	                    # Add API key for direct access
937	                    image_url_with_key = f"{archive_url}?api_key={API_KEY}"
938	                except ValueError:
939	                    logger.warning(f"Could not parse date {image_date_time} for EPIC image URL construction.")
940	                    image_url_with_key = "URL construction failed"
941	            else:
942	                image_url_with_key = "URL not available"
943	
944	            result.append(f"\nIdentifier: {image_identifier}")
945	            result.append(f"Date/Time: {image_date_time}")
946	            result.append(f"Caption: {image_meta.get('caption', 'No caption')}")
947	            result.append(f"Image Name: {image_name}")
948	            result.append(f"Archive URL: {image_url_with_key}")
949	            
950	            # Coordinates
951	            coords = image_meta.get('centroid_coordinates', {})
952	            if coords:
953	                result.append(f"Centroid Coordinates: Lat {coords.get('lat', 'N/A')}, Lon {coords.get('lon', 'N/A')}")
954	            
955	            result.append("-" * 40)
956	            count += 1
957	            
958	        return "\n".join(result)
959	    except Exception as e:
960	        logger.error(f"Error processing EPIC image data: {str(e)}")
961	        return f"Error processing EPIC image data: {str(e)}"
