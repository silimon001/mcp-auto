92	      false,
93	      "Check that all required parameters are provided with correct formats",
94	      undefined,
95	      { endpoint, status }
96	    );
97	  }
98	
99	  return buildErrorResponse(
100	    `DP${status}_ERROR`,
101	    `API request failed: ${status} ${statusText}`,
102	    false,
103	    "Check API documentation or try again later",
104	    undefined,
105	    { endpoint, status }
106	  );
107	}
