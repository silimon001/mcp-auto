113	// Helper function to fetch data from DexPaprika API with structured error handling
114	async function fetchFromAPI(endpoint) {
115	  const startTime = Date.now();
116	  const response = await fetch(`${API_BASE_URL}${endpoint}`);
117	
118	  if (!response.ok) {
119	    const structuredError = parseAPIError(response.status, response.statusText, endpoint);
120	    throw structuredError;
121	  }
122	
123	  const data = await response.json();
124	  requestCount++;
125	  const responseTime = Date.now() - startTime;
126	
127	  const resetTime = new Date();
128	  resetTime.setHours(24, 0, 0, 0);
129	
130	  return {
131	    data,
132	    meta: {
133	      rate_limit: {
134	        limit: RATE_LIMIT,
135	        remaining: RATE_LIMIT - requestCount,
136	        used: requestCount,
137	        percentage_used: (requestCount / RATE_LIMIT) * 100,
138	        reset_at: resetTime.toISOString()
139	      },
140	      response_time_ms: responseTime,
