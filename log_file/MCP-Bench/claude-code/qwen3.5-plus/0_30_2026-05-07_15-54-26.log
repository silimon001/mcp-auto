6	@mcp.tool()
7	async def get_movies(keyword: str) -> str:
8	    """
9	    Get movie suggestions based on keyword.
10	    """
11	    result = getMovieSuggestions(keyword)
12	    return result or "Film bulunamadı."
13	
14	if __name__ == "__main__":
15	    mcp.run(transport="stdio")
