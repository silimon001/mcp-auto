22	// Structured error response builder
23	function buildErrorResponse(code, message, retryable, suggestion, correctedExample, metadata) {
24	  const error = {
25	    error: {
26	      code,
27	      message,
28	      retryable,
29	      suggestion,
30	    }
31	  };
32	  if (correctedExample) {
33	    error.error.corrected_example = correctedExample;
34	  }
35	  if (metadata) {
36	    error.error.metadata = metadata;
37	  }
38	  return error;
39	}
