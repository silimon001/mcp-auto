2	 * Math MCP Server
3	 *
4	 * This file implements a Model Context Protocol (MCP) server that provides
5	 * various mathematical operations as tools. Each tool accepts numeric inputs
6	 * and returns the calculated result.
7	 */
8	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
9	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
10	import { z } from "zod";
11	import { Arithmetic } from "./Classes/Arithmetic.js";
12	import { Statistics } from "./Classes/Statistics.js";
13	import { Trigonometric } from "./Classes/Trigonometric.js";
14	export default function createServer() {
15	    const mathServer = new McpServer({
16	        name: "math",
17	        version: "0.1.1"
18	    });
19	    /**
20	 * Addition operation
21	 * Adds two numbers and returns their sum
22	 */
23	    mathServer.tool("add", "Adds two numbers together", {
24	        firstNumber: z.number().describe("The first addend"),
25	        secondNumber: z.number().describe("The second addend")
26	    }, async ({ firstNumber, secondNumber }) => {
27	        const value = Arithmetic.add(firstNumber, secondNumber);
28	        return {
29	            content: [{
30	                    type: "text",
31	                    text: `${value}`
32	                }]
33	        };
34	    });
35	    /**
36	     * Subtraction operation
37	     * Subtracts the second number from the first number
38	     */
39	    mathServer.tool("subtract", "Subtracts the second number from the first number", {
40	        minuend: z.number().describe("The number to subtract from (minuend)"),
41	        subtrahend: z.number().describe("The number being subtracted (subtrahend)")
42	    }, async ({ minuend, subtrahend }) => {
43	        const value = Arithmetic.subtract(minuend, subtrahend);
44	        return {
45	            content: [{
46	                    type: "text",
47	                    text: `${value}`
48	                }]
49	        };
50	    });

