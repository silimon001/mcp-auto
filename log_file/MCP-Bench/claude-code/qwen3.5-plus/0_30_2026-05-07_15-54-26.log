41	// Parse API error response and convert to structured format
42	function parseAPIError(status, statusText, endpoint) {
43	  if (status === 404 && endpoint.includes('/networks/')) {
44	    const networkMatch = endpoint.match(/\/networks\/([^\/\?]+)/);
45	    const providedNetwork = networkMatch ? networkMatch[1] : 'unknown';
46	    return buildErrorResponse(
47	      ErrorCodes.DP400_INVALID_NETWORK,
48	      `Network ID '${providedNetwork}' not recognized`,
49	      true,
50	      "Use normalized network ID from getNetworks. Call getCapabilities for network_synonyms.",
51	      `getNetworkPools('ethereum', 10)`,
52	      {
53	        provided: providedNetwork,
54	        suggested: "ethereum",
55	        valid_networks: ["ethereum", "bsc", "polygon", "base", "arbitrum", "optimism", "solana", "avalanche", "fantom"]
56	      }
57	    );
58	  }
59	
60	  if (status === 404) {
61	    return buildErrorResponse(
62	      ErrorCodes.DP404_NOT_FOUND,
63	      "Resource not found",
64	      false,
65	      "Verify the resource exists. Use search or list endpoints to find correct identifiers.",
66	      undefined,
67	      { endpoint }
68	    );
69	  }
70	
71	  if (status === 429) {
72	    const resetTime = new Date();
73	    resetTime.setHours(24, 0, 0, 0);
74	    return buildErrorResponse(
75	      ErrorCodes.DP429_RATE_LIMIT,
76	      "Daily rate limit of 10,000 requests exceeded",
77	      true,
78	      "Wait until rate limit resets or use cached data",
79	      undefined,
80	      {
81	        limit: 10000,
82	        reset_at: resetTime.toISOString(),
83	        retry_after_seconds: Math.floor((resetTime.getTime() - Date.now()) / 1000)
84	      }
85	    );
86	  }
87	
88	  if (status === 400) {
89	    return buildErrorResponse(
