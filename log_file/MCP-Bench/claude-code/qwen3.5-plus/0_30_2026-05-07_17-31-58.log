1	#!/usr/bin/env node
2	import { Server } from '@modelcontextprotocol/sdk/server/index.js';
3	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
4	import {
5	  CallToolRequestSchema,
6	  ErrorCode,
7	  ListToolsRequestSchema,
8	  McpError,
9	} from '@modelcontextprotocol/sdk/types.js';
10	import axios from 'axios';
11	
12	// Types for OKX API responses
13	interface OKXTickerResponse {
14	  code: string;
15	  msg: string;
16	  data: Array<{
17	    instId: string;
18	    last: string;
19	    askPx: string;
20	    bidPx: string;
21	    open24h: string;
22	    high24h: string;
23	    low24h: string;
24	    volCcy24h: string;
25	    vol24h: string;
26	    ts: string;
27	  }>;
28	}
29	
30	interface OKXCandlesticksResponse {
31	  code: string;
32	  msg: string;
33	  data: Array<[
34	    time: string,    // Open time
35	    open: string,    // Open price
36	    high: string,    // Highest price
37	    low: string,     // Lowest price
38	    close: string,   // Close price
39	    vol: string,     // Trading volume
40	    volCcy: string   // Trading volume in currency
41	  ]>;
42	}
43	
44	class OKXServer {
45	  private server: Server;
46	  private axiosInstance;
47	
48	  constructor() {
49	    console.error('[Setup] Initializing OKX MCP server...');
50	    
51	    this.server = new Server(
52	      {
53	        name: 'okx-mcp-server',
54	        version: '0.1.0',
55	      },
56	      {
57	        capabilities: {
58	          tools: {},
59	        },
60	      }
61	    );
62	
63	    this.axiosInstance = axios.create({
64	      baseURL: 'https://www.okx.com/api/v5',
65	      timeout: 5000,
66	      headers: {
67	        'Accept': 'application/json',
68	        'Content-Type': 'application/json'
69	      }
70	    });
71	
72	    this.setupToolHandlers();
73	    
74	    this.server.onerror = (error) => console.error('[Error]', error);
75	    process.on('SIGINT', async () => {
76	      await this.server.close();
77	      process.exit(0);
78	    });
79	  }
80	
81	  private setupToolHandlers() {
82	    this.server.setRequestHandler(ListToolsRequestSchema, async () => ({
83	      tools: [
84	        {
85	          name: 'get_price',
86	          description: 'Get latest price for an OKX instrument',
87	          inputSchema: {
88	            type: 'object',
89	            properties: {
90	              instrument: {
91	                type: 'string',
92	                description: 'Instrument ID (e.g. BTC-USDT)',
93	              },
94	            },
95	            required: ['instrument'],
96	          },
97	        },
98	        {
99	          name: 'get_candlesticks',
100	          description: 'Get candlestick data for an OKX instrument',
101	          inputSchema: {
102	            type: 'object',
103	            properties: {
104	              instrument: {
105	                type: 'string',
106	                description: 'Instrument ID (e.g. BTC-USDT)',
107	              },
108	              bar: {
109	                type: 'string',
110	                description: 'Time interval (e.g. 1m, 5m, 1H, 1D)',
111	                default: '1m'
112	              },
113	              limit: {
114	                type: 'number',
115	                description: 'Number of candlesticks (max 100)',
116	                default: 100
117	              }
118	            },
119	            required: ['instrument'],
120	          },
121	        },
122	      ],
123	    }));
124	
125	    this.server.setRequestHandler(CallToolRequestSchema, async (request) => {
126	      try {
127	        if (!['get_price', 'get_candlesticks'].includes(request.params.name)) {
128	          throw new McpError(
129	            ErrorCode.MethodNotFound,
130	            `Unknown tool: ${request.params.name}`
131	          );
132	        }
133	
134	        const args = request.params.arguments as {
135	          instrument: string;
136	          bar?: string;
137	          limit?: number;
138	        };
139	
140	        if (!args.instrument) {
141	          throw new McpError(
142	            ErrorCode.InvalidParams,
143	            'Missing required parameter: instrument'
144	          );
145	        }
146	
147	        if (request.params.name === 'get_price') {
148	          console.error(`[API] Fetching price for instrument: ${args.instrument}`);
149	          const response = await this.axiosInstance.get<OKXTickerResponse>(
150	            '/market/ticker',
151	            {
152	              params: { instId: args.instrument },
153	            }
154	          );
155	
156	          if (response.data.code !== '0') {
157	            throw new Error(`OKX API error: ${response.data.msg}`);
158	          }
159	
160	          if (!response.data.data || response.data.data.length === 0) {
161	            throw new Error('No data returned from OKX API');
162	          }
163	
164	          const ticker = response.data.data[0];
165	          return {
166	            content: [
167	              {
168	                type: 'text',
169	                text: JSON.stringify({
170	                  instrument: ticker.instId,
171	                  lastPrice: ticker.last,
172	                  bid: ticker.bidPx,
173	                  ask: ticker.askPx,
174	                  high24h: ticker.high24h,
175	                  low24h: ticker.low24h,
176	                  volume24h: ticker.vol24h,
177	                  timestamp: new Date(parseInt(ticker.ts)).toISOString(),
178	                }, null, 2),
179	              },
180	            ],
181	          };
182	        } else {
183	          // get_candlesticks
184	          console.error(`[API] Fetching candlesticks for instrument: ${args.instrument}, bar: ${args.bar || '1m'}, limit: ${args.limit || 100}`);
185	          const response = await this.axiosInstance.get<OKXCandlesticksResponse>(
186	            '/market/candles',
187	            {
188	              params: {
189	                instId: args.instrument,
190	                bar: args.bar || '1m',
191	                limit: args.limit || 100
192	              },
193	            }
194	          );
195	
196	          if (response.data.code !== '0') {
197	            throw new Error(`OKX API error: ${response.data.msg}`);
198	          }
199	
200	          if (!response.data.data || response.data.data.length === 0) {
201	            throw new Error('No data returned from OKX API');
202	          }
203	
204	          return {
205	            content: [
206	              {
207	                type: 'text',
208	                text: JSON.stringify(
209	                  response.data.data.map(([time, open, high, low, close, vol, volCcy]) => ({
210	                    timestamp: new Date(parseInt(time)).toISOString(),
211	                    open,
212	                    high,
213	                    low,
214	                    close,
215	                    volume: vol,
216	                    volumeCurrency: volCcy
217	                  })),
218	                  null,
219	                  2
220	                ),
221	              },
222	            ],
223	          };
224	        }
225	      } catch (error: unknown) {
226	        if (error instanceof Error) {
227	          console.error('[Error] Failed to fetch data:', error);
228	          throw new McpError(
229	            ErrorCode.InternalError,
230	            `Failed to fetch data: ${error.message}`
231	          );
232	        }
233	        throw error;
234	      }
235	    });
236	  }
237	
238	  async run() {
239	    const transport = new StdioServerTransport();
240	    await this.server.connect(transport);
241	    console.error('OKX MCP server running on stdio');
242	  }
243	}
244	
245	const server = new OKXServer();
246	server.run().catch(console.error);
247	

