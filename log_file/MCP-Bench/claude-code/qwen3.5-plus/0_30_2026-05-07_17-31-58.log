1	from typing import Optional
2	from redditwarp.ASYNC import Client
3	from redditwarp.models.submission_ASYNC import LinkPost, TextPost, GalleryPost
4	from fastmcp import FastMCP
5	import logging
6	
7	mcp = FastMCP("Reddit MCP")
8	client = Client()
9	logging.getLogger().setLevel(logging.WARNING)
10	
11	@mcp.tool()
12	async def fetch_reddit_hot_threads(subreddit: str, limit: int = 10) -> str:
13	    """
14	    Fetch hot threads from a subreddit
15	    
16	    Args:
17	        subreddit: Name of the subreddit
18	        limit: Number of posts to fetch (default: 10)
19	        
20	    Returns:
21	        Human readable string containing list of post information
22	    """
23	    try:
24	        posts = []
25	        async for submission in client.p.subreddit.pull.hot(subreddit, limit):
26	            post_info = (
27	                f"Title: {submission.title}\n"
28	                f"Score: {submission.score}\n"
29	                f"Comments: {submission.comment_count}\n"
30	                f"Author: {submission.author_display_name or '[deleted]'}\n"
31	                f"Type: {_get_post_type(submission)}\n"
32	                f"Content: {_get_content(submission)}\n"
33	                f"Link: https://reddit.com{submission.permalink}\n"
34	                f"---"
35	            )
36	            posts.append(post_info)
37	            
38	        return "\n\n".join(posts)
39	
40	    except Exception as e:
41	        logging.error(f"An error occurred: {str(e)}")
42	        return f"An error occurred: {str(e)}"
43	
44	def _format_comment_tree(comment_node, depth: int = 0) -> str:
45	    """Helper method to recursively format comment tree with proper indentation"""
46	    comment = comment_node.value
47	    indent = "-- " * depth
48	    content = (
49	        f"{indent}* Author: {comment.author_display_name or '[deleted]'}\n"
50	        f"{indent}  Score: {comment.score}\n"
51	        f"{indent}  {comment.body}\n"
52	    )
53	
54	    for child in comment_node.children:
55	        content += "\n" + _format_comment_tree(child, depth + 1)
56	
57	    return content
58	
59	@mcp.tool()
60	async def fetch_reddit_post_content(post_id: str, comment_limit: int = 20, comment_depth: int = 3) -> str:
61	    """
62	    Fetch detailed content of a specific post
63	    
64	    Args:
65	        post_id: Reddit post ID
66	        comment_limit: Number of top level comments to fetch
67	        comment_depth: Maximum depth of comment tree to traverse
68	
69	    Returns:
70	        Human readable string containing post content and comments tree
71	    """
72	    try:
73	        submission = await client.p.submission.fetch(post_id)
74	        
75	        content = (
76	            f"Title: {submission.title}\n"
77	            f"Score: {submission.score}\n"
78	            f"Author: {submission.author_display_name or '[deleted]'}\n"
79	            f"Type: {_get_post_type(submission)}\n"
80	            f"Content: {_get_content(submission)}\n"
81	        )
82	
83	        comments = await client.p.comment_tree.fetch(post_id, sort='top', limit=comment_limit, depth=comment_depth)
84	        if comments.children:
85	            content += "\nComments:\n"
86	            for comment in comments.children:
87	                content += "\n" + _format_comment_tree(comment)
88	        else:
89	            content += "\nNo comments found."
90	
91	        return content
92	
93	    except Exception as e:
94	        return f"An error occurred: {str(e)}"
95	
96	def _get_post_type(submission) -> str:
97	    """Helper method to determine post type"""
98	    if isinstance(submission, LinkPost):
99	        return 'link'
100	    elif isinstance(submission, TextPost):
101	        return 'text'
102	    elif isinstance(submission, GalleryPost):
103	        return 'gallery'
104	    return 'unknown'
105	
106	def _get_content(submission) -> Optional[str]:
107	    """Helper method to extract post content based on type"""
108	    if isinstance(submission, LinkPost):
109	        return submission.permalink
110	    elif isinstance(submission, TextPost):
111	        return submission.body
112	    elif isinstance(submission, GalleryPost):
113	        return str(submission.gallery_link)
114	    return None
115	
116	
117	if __name__ == "__main__":
118	    # Run the FastMCP server when module is executed directly
119	    mcp.run()

