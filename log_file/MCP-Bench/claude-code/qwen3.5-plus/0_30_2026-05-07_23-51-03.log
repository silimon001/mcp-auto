1	#!/usr/bin/env node
2	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
3	import dotenv from 'dotenv';
4	import { createServer } from './server.js';
5	// Load environment variables
6	dotenv.config();
7	// Check for API key
8	if (!process.env.NPS_API_KEY) {
9	    console.warn('Warning: NPS_API_KEY is not set in environment variables.');
10	    console.warn('Get your API key at: https://www.nps.gov/subjects/developer/get-started.htm');
11	}
12	// Start the server
13	async function runServer() {
14	    const server = createServer();
15	    const transport = new StdioServerTransport();
16	    await server.connect(transport);
17	    console.error("National Parks MCP Server running on stdio");
18	}
19	runServer().catch((error) => {
20	    console.error("Fatal error in main():", error);
21	    process.exit(1);
22	});
23	

