1	from mcp.server.fastmcp import FastMCP
2	from app import getCarBrands, searchCarPrice, getCarsByType
3	
4	# Initialize MCP server
5	mcp = FastMCP("car-price-mcp")
6	
7	@mcp.tool()
8	async def get_car_brands() -> str:
9	    """
10	    Get all available car brands from FIPE API.
11	    
12	    Returns:
13	        List of car brands with their codes and names
14	    """
15	    # Get car brands from the app
16	    brands_info = getCarBrands()
17	    if not brands_info:
18	        return "No car brands information found."
19	
20	    return brands_info
21	
22	@mcp.tool()
23	async def search_car_price(brand_name: str) -> str:
24	    """
25	    Search for car models and prices by brand name.
26	    
27	    Args:
28	        brand_name: The car brand name to search for (e.g., "Toyota", "Honda", "Ford")
29	    
30	    Returns:
31	        Car models with current market prices from FIPE database
32	    """
33	    if not brand_name or not brand_name.strip():
34	        return "Please provide a car brand name to search for."
35	    
36	    # Search for car prices
37	    car_info = searchCarPrice(brand_name.strip())
38	    if not car_info:
39	        return f"No car information found for '{brand_name}'."
40	
41	    return car_info
42	
43	@mcp.tool()
44	async def get_vehicles_by_type(vehicle_type: str = "carros") -> str:
45	    """
46	    Get vehicles by type (cars, motorcycles, trucks).
47	    
48	    Args:
49	        vehicle_type: Type of vehicles to fetch ("carros"/"cars", "motos"/"motorcycles", "caminhoes"/"trucks")
50	    
51	    Returns:
52	        List of vehicle brands for the specified type
53	    """
54	    if not vehicle_type or not vehicle_type.strip():
55	        vehicle_type = "carros"
56	    
57	    # Get vehicles by type
58	    vehicles_info = getCarsByType(vehicle_type.strip())
59	    if not vehicles_info:
60	        return f"No {vehicle_type} information found."
61	
62	    return vehicles_info
63	
64	if __name__ == "__main__":
65	    mcp.run(transport="stdio")
