1	import numpy as np
2	import sympy as sp
3	from sympy.parsing.sympy_parser import standard_transformations, implicit_multiplication_application
4	from sympy import parse_expr
5	from sympy.vector import Del, CoordSys3D, directional_derivative
6	
7	C = CoordSys3D('C')
8	
9	
10	def parse_field(f_str: str):
11	    """
12	    Parse a vector field string into a Sympy Vector.
13	
14	    Args:
15	        f_str (str): e.g. "[z, -y, x]".
16	        x_coord, y_coord, z_coord: optional sympy symbols (e.g., x, C.x).
17	          If None, defaults to bare symbols (x, y, z).
18	
19	    Returns:
20	        sympy.vector.Vector: symbolic vector in CoordSys3D C.
21	    """
22	
23	    raw = f_str.strip().strip("[]")
24	    comps_str = [c.strip() for c in raw.split(",")]
25	
26	    transformations = standard_transformations + (implicit_multiplication_application,)
27	    local_ns = {
28	        "x": C.x, "y": C.y, "z": C.z,
29	        "sin": sp.sin, "cos": sp.cos
30	    }
31	
32	    comp_syms = [
33	        parse_expr(expr, local_dict=local_ns, transformations=transformations)
34	        for expr in comps_str
35	    ]
36	
37	    return comp_syms[0] * C.i + comp_syms[1] * C.j + comp_syms[2] * C.k
38	
