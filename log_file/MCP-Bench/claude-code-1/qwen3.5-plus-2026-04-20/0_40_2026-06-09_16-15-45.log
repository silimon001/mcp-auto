119	    @mcp.tool()
120	    def gradient(f_str: str) -> str:
121	        """
122	        Computes the symbolic gradient of a scalar function.
123	
124	        Args:
125	            f_str (str): A string representing a scalar function (e.g., "x**2 + y*z").
126	
127	        Returns:
128	            str: A string representation of the symbolic gradient as a vector.
129	        """
130	        f_sym = sp.sympify(f_str)
131	        variable = sorted(list(f_sym.free_symbols), key=lambda s: s.name)
132	        grad = sp.Matrix([f_sym]).jacobian(variable)
133	        return grad
134	
135	    @mcp.tool()
136	    def curl(f_str: str, point: list[float] = None) -> dict:
137	        """
138	        Computes the symbolic curl of a vector field, optionally evaluated at a point.
139	
140	        Args:
141	            f_str (str): A string representing the vector field in list format (e.g., "[x+y, x, 2*z]").
142	            point (list[float], optional): A list of coordinates [x, y, z] to evaluate the curl numerically.
143	
144	        Returns:
145	            dict: A dictionary with the symbolic curl as a string, and optionally the evaluated vector.
146	        """
147	
148	        F = parse_field(f_str)
149	
150	        curl_sym = Del().cross(F).doit()
151	
152	        result = {"curl_sym": str(curl_sym)}
153	
154	        if point:
155	            variables = [C.x, C.y, C.z]
156	            comps = [curl_sym.dot(dir_) for dir_ in (C.i, C.j, C.k)]
157	            lamb = sp.lambdify(variables, sp.Matrix(comps), 'numpy')
158	            result['curl_val'] = [float(v) for v in lamb(*point)]
159	        return result
160	
161	    @mcp.tool()
162	    def divergence(f_str: str, point: list[float] = None) -> dict:
163	        """
164	        Computes the symbolic divergence of a vector field, optionally evaluated at a point.
165	
166	        Args:
167	            f_str (str): A string representing the vector field in list format (e.g., "[x+y, x, 2*z]").
168	            point (list[float], optional): A list of coordinates [x, y, z] to evaluate the divergence numerically.
169	
170	        Returns:
171	            dict: A dictionary with the symbolic divergence as a string, and optionally the evaluated scalar.
172	        """
173	
174	        F = parse_field(f_str)
175	
176	        div_sym = Del().dot(F, doit=True)
177	        result = {'divergence_sym': str(div_sym)}
178	
179	        if point:
180	            variables = [C.x, C.y, C.z]
181	            lamb = sp.lambdify(variables, div_sym, 'numpy')
182	            result['divergence_val'] = float(lamb(*point))
183	        return result
184	
185	    @mcp.tool()
186	    def laplacian(f_str: str, is_vector: bool = False) -> str:
187	        """
188	        Computes the Laplacian of a scalar or vector field symbolically.
189	
190	        Args:
191	            f_str (str): Scalar function as "x**2 + y*z" or vector "[Fx, Fy, Fz]".
192	            is_vector (bool): Set True to compute vector Laplacian.
193	
194	        Returns:
195	            str: Symbolic result of the Laplacian—scalar or list of 3 components.
196	        """
197	        if not is_vector:
198	            f = parse_expr(f_str, local_dict={"x": C.x, "y": C.y, "z": C.z})
199	            lap = Del().dot(Del()(f)).doit()
200	            return str(lap)
201	        else:
202	            F = parse_field(f_str)
203	            # Extract components
204	            comps = F.to_matrix(C).tolist()
205	            lap_comps = [Del().dot(Del()(comp)).doit() for comp in comps]
206	            return str(lap_comps)  # list form
207	
208	    @mcp.tool()
209	    def directional_deriv(f_str: str, u: list[float], unit: bool = True) -> str:
210	        """
211	        Computes symbolic directional derivative of scalar field along a vector direction.
212	
213	        Args: f_str (str): Expression like "x*y*z". u (list[float]): Direction vector [vx, vy, vz]. unit (bool): True
214	        if u should be normalized before calculating directional derivative. Set to True by default.
215	
216	        Returns:
217	            str: Symbolic result as string.
218	        """
219	        f = parse_expr(f_str, local_dict={"x": C.x, "y": C.y, "z": C.z})
220	        v = u[0] * C.i + u[1] * C.j + u[2] * C.k
221	
222	        if unit:
223	            v = v.normalize()
224	
225	        expr = directional_derivative(f, v).doit()
226	        return str(expr)
