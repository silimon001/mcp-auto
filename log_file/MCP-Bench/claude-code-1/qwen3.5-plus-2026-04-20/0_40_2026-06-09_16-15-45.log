222	    # Matrix decompositions
223	    @mcp.tool()
224	    def qr_decompose(name: str) -> dict:
225	        """
226	        Computes the QR decomposition of a stored matrix.
227	
228	        Decomposes the matrix A into A = Q @ R, where Q is an orthogonal matrix
229	        and R is an upper triangular matrix.
230	
231	        Args:
232	            name (str): The name of the matrix to decompose.
233	
234	        Returns:
235	            dict: A dictionary with keys:
236	                - 'q': np.ndarray, the orthogonal matrix Q
237	                - 'r': np.ndarray, the upper triangular matrix R
238	
239	        Raises:
240	            ValueError: If the matrix is not found or decomposition fails.
241	        """
242	        if name not in tensor_store:
243	            raise ValueError("The tensor name is not found in the store.")
244	
245	        try:
246	            q, r = np.linalg.qr(tensor_store[name])
247	        except ValueError as e:
248	            raise ValueError(f"Error computing QR decomposition: {e}")
249	
250	        return {'q': q, 'r': r}
251	
252	    @mcp.tool()
253	    def svd_decompose(name: str) -> dict:
254	        """
255	        Computes the Singular Value Decomposition (SVD) of a stored matrix.
256	
257	        Decomposes the matrix A into A = U @ S @ V^T, where U and V^T are orthogonal
258	        matrices, and S is a diagonal matrix of singular values.
259	
260	        Args:
261	            name (str): The name of the matrix to decompose.
262	
263	        Returns:
264	            dict: A dictionary with keys:
265	                - 'u': np.ndarray, the left singular vectors
266	                - 's': np.ndarray, the singular values
267	                - 'v_t': np.ndarray, the right singular vectors transposed
268	
269	        Raises:
270	            ValueError: If the matrix is not found or decomposition fails.
271	        """
272	        if name not in tensor_store:
273	            raise ValueError("The tensor name is not found in the store.")
274	
275	        try:
276	            u, s, v_t = np.linalg.svd(tensor_store[name])
277	        except ValueError as e:
278	            raise ValueError(f"Error computing SVD decomposition: {e}")
279	
280	        return {'u': u, 's': s, 'v_t': v_t}
281	
282	    # Bases
283	    @mcp.tool()
284	    async def find_orthonormal_basis(name: str) -> list[list[float]]:
285	        """
286	        Finds an orthonormal basis for the column space of a stored matrix using QR decomposition.
287	
288	        Args:
289	            name (str): The name of the matrix.
290	
291	        Returns:
292	            list[list[float]]: A list of orthonormal basis vectors.
293	
294	        Raises:
295	            ValueError: If the matrix is not found or decomposition fails.
296	        """
297	
298	        try:
299	            result = await mcp.call_tool("qr_decompose", arguments={'name': name})
300	            d = ast.literal_eval(result[-1].text)
301	
302	        except ValueError as e:
303	            raise ValueError(f"Error computing orthonormal basis: {e}")
304	
305	        return d['q']
306	
307	    @mcp.tool()
308	    def change_basis(name: str, new_basis: list[list[float]]) -> np.ndarray:
309	        """
310	        Changes the basis of a stored square matrix.
311	
312	        Args:
313	            name (str): Name of the matrix in the tensor store.
314	            new_basis (list[list[float]]): Columns are new basis vectors.
315	
316	        Returns:
317	            np.ndarray: Representation of the matrix in the new basis.
318	
319	        Raises:
320	            ValueError: If the matrix name is not found or non-invertible.
321	        """
322	
323	        if name not in tensor_store:
324	            raise ValueError("The tensor name is not found in the store.")
325	
326	        new_basis = np.asarray(new_basis)
327	        return np.linalg.inv(new_basis) @ tensor_store[name] @ new_basis
