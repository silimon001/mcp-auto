40	def register_tools(mcp, tensor_store):
41	    # Basic vector operations
42	
43	    @mcp.tool()
44	    def vector_project(name: str, new_vector: list[float]) -> np.ndarray:
45	        """
46	        Projects a stored vector onto another vector.
47	
48	        Args:
49	            name (str): Name of the stored vector to project.
50	            new_vector (list[float]): The vector to project onto.
51	
52	        Returns:
53	            np.ndarray: The projection result vector.
54	
55	        Raises:
56	            ValueError: If the vector name is not found or projection fails.
57	        """
58	        if name not in tensor_store:
59	            raise ValueError("The tensor name is not found in the store.")
60	
61	        try:
62	            new_vector = np.asarray(new_vector)
63	            result = np.dot(tensor_store[name], new_vector) / np.linalg.norm(new_vector) * new_vector
64	        except ValueError as e:
65	            raise ValueError(f"Error computing projection:{e}")
66	
67	        return result
