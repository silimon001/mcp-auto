16	def register_tools(mcp):
17	    @mcp.tool()
18	    def plot_vector_field(f_str: str, bounds=(-1, 1, -1, 1, -1, 1), n: int = 10) -> Image:
19	        """
20	        Plots a 3D vector field from a string "[u(x,y,z), v(x,y,z), w(x,y,z)]"
21	
22	        Args:
23	            f_str: string representation of 3D field, e.g. "[z, -y, x]".
24	            bounds: (xmin, xmax, ymin, ymax, zmin, zmax)
25	            n: grid resolution per axis
26	
27	        Returns: Displayed Matplotlib 3D quiver plot (no image return needed)
28	        """
29	        # 1. Extract component strings
30	        raw = f_str.strip().lstrip("[").rstrip("]")
31	        u_s, v_s, w_s = [s.strip() for s in raw.split(",")]
32	
33	        # 2. Parse each component with bare symbols
34	        u_expr = parse_expr(u_s, local_dict=local_ns, transformations=transforms)
35	        v_expr = parse_expr(v_s, local_dict=local_ns, transformations=transforms)
36	        w_expr = parse_expr(w_s, local_dict=local_ns, transformations=transforms)
37	
38	        # 3. Convert to numpy functions
39	        u_fn = sp.lambdify((x, y, z), u_expr, "numpy")
40	        v_fn = sp.lambdify((x, y, z), v_expr, "numpy")
41	        w_fn = sp.lambdify((x, y, z), w_expr, "numpy")
42	
43	        # 4. Prepare grid
44	        xmin, xmax, ymin, ymax, zmin, zmax = bounds
45	        X, Y, Z = np.meshgrid(
46	            np.linspace(xmin, xmax, n),
47	            np.linspace(ymin, ymax, n),
48	            np.linspace(zmin, zmax, n),
49	            indexing="ij"
50	        )
51	        U = u_fn(X, Y, Z)
52	        V = v_fn(X, Y, Z)
53	        W = w_fn(X, Y, Z)
54	
55	        try:
56	            fig = Figure(figsize=(8, 6))
57	            canvas = FigureCanvas(fig)
58	            ax = fig.add_subplot(projection="3d")
59	            ax.quiver(X, Y, Z, U, V, W, length=0.1, normalize=True, color="blue")
60	            ax.set_xlabel("X")
61	            ax.set_ylabel("Y")
62	            ax.set_zlabel("Z")
63	            ax.set_title(f"3D Vector Field: {f_str}")
64	            # Save to buffer and return
65	            buf = BytesIO()
66	            canvas.print_png(buf)
67	            img_bytes = buf.getvalue()
68	        except ValueError as e:
69	            raise ValueError(f'Error plotting vector field: {e}')
70	
71	        buf.close()
72	        return Image(data=img_bytes, format="png")
73	
74	    @mcp.tool()
75	    def plot_function(expr_str: str, xlim: tuple[int, int] = (-5, 5), ylim: tuple[int, int] = (-5, 5), grid=200) \
76	            -> Image:
77	
78	        """
79	        Plots a 2D or 3D mathematical function from a symbolic expression string.
80	
81	        Args:
82	            expr_str: string representation of a function in x or x and y,
83	                      e.g. "x**2" or "sin(sqrt(x**2 + y**2))"
84	            xlim: (xmin, xmax) range for x-axis
85	            ylim: (ymin, ymax) range for y-axis (used in 2D or 3D)
86	            grid: resolution of the plot grid
87	
88	        Returns:
89	            A rendered Image of the function using Matplotlib.
90	            - 2D plot if the expression contains only x
91	            - 3D surface plot if the expression contains both x and y
92	        """
93	        expr = parse_expr(expr_str, transformations=transforms, local_dict=local_ns)
94	        vars_used = expr.free_symbols
95	
96	        # 2. Determine 2D or 3D
97	        if vars_used == {sp.symbols('x')} or vars_used == set():
98	            # 2D: f(x)
99	            f_num = sp.lambdify(x, expr, modules=['numpy'])
100	            xs = np.linspace(xlim[0], xlim[1], grid)
101	            ys = f_num(xs)
102	
103	            fig = Figure()
104	            ax = fig.add_subplot()
105	            ax.plot(xs, ys)
106	            ax.axhline(0, color='black', linewidth=0.8)
107	            ax.axvline(0, color='black', linewidth=0.8)
108	            ax.set_xlabel('x')
109	            ax.set_ylabel(expr_str)
110	            ax.set_title(f'f(x) = {expr_str}')
111	
112	        elif vars_used >= {sp.symbols('x'), sp.symbols('y')}:
113	            # 3D: f(x, y)
114	            f_num = sp.lambdify((x, y), expr, modules=['numpy'])
115	            xs = np.linspace(xlim[0], xlim[1], grid)
116	            ys = np.linspace(ylim[0], ylim[1], grid) if ylim is not None else xs
117	            X, Y = np.meshgrid(xs, ys)
118	            Z = f_num(X, Y)
119	
120	            fig = Figure()
121	            ax = fig.add_subplot(projection='3d')
122	            surf = ax.plot_surface(X, Y, Z, cmap='viridis')
123	            fig.colorbar(surf, ax=ax, shrink=0.6)
124	            ax.set_title(f'f(x, y) = {expr_str}')
125	            ax.set_xlabel('x')
126	            ax.set_ylabel('y')
127	            ax.set_zlabel(expr_str)
128	
129	        else:
130	            raise ValueError("Plot only supports functions in x (2D) or x and y (3D).")
131	
132	        # 3. Render as PNG
133	        buf = BytesIO()
134	        canvas = FigureCanvas(fig)
135	        canvas.print_png(buf)
136	        img_bytes = buf.getvalue()
137	        buf.close()
138	        return Image(data=img_bytes, format='png')
