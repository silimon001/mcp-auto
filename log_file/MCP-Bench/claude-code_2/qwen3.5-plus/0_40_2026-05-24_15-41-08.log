93	def search_locations(query: str) -> Dict[str, Any]:
94	    """Search for locations using WeatherAPI"""
95	    url = f"{BASE_URL}/search.json?key={API_KEY}&q={query}"
96	    try:
97	        response = requests.get(url, timeout=10)
98	        response.raise_for_status()
99	        data = response.json()
100	
