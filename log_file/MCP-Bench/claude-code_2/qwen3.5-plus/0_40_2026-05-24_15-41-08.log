25	def get_current_weather(city: str) -> Dict[str, Any]:
26	    """Get current weather for a city using WeatherAPI"""
27	    url = f"{BASE_URL}/current.json?key={API_KEY}&q={city}&lang=tr"
28	    try:
29	        response = requests.get(url, timeout=10)
30	        response.raise_for_status()
31	        data = response.json()
32	        
33	        return {
34	            "city": data.get("location", {}).get("name"),
35	            "country": data.get("location", {}).get("country"),
36	            "region": data.get("location", {}).get("region"),
37	            "weather": data.get("current", {}).get("condition", {}).get("text"),
38	            "temperature_c": data.get("current", {}).get("temp_c"),
39	            "temperature_f": data.get("current", {}).get("temp_f"),
40	            "feelslike_c": data.get("current", {}).get("feelslike_c"),
41	            "feelslike_f": data.get("current", {}).get("feelslike_f"),
42	            "humidity": data.get("current", {}).get("humidity"),
43	            "wind_kph": data.get("current", {}).get("wind_kph"),
44	            "wind_mph": data.get("current", {}).get("wind_mph"),
45	            "wind_dir": data.get("current", {}).get("wind_dir"),
46	            "pressure_mb": data.get("current", {}).get("pressure_mb"),
47	            "visibility_km": data.get("current", {}).get("vis_km"),
48	            "uv_index": data.get("current", {}).get("uv"),
49	            "icon": data.get("current", {}).get("condition", {}).get("icon"),
50	            "last_updated": data.get("current", {}).get("last_updated")
51	        }
52	    except requests.exceptions.RequestException as e:
53	        return {"error": f"API request failed: {str(e)}"}
54	    except Exception as e:
55	        return {"error": f"Unexpected error: {str(e)}"}
56	
57	def get_weather_forecast(city: str, days: int = 3) -> Dict[str, Any]:
58	    """Get weather forecast for a city using WeatherAPI"""
59	    url = f"{BASE_URL}/forecast.json?key={API_KEY}&q={city}&days={days}&lang=tr"
60	    try:
61	        response = requests.get(url, timeout=10)
62	        response.raise_for_status()
63	        data = response.json()
64	        
65	        forecast_days = []
66	        for day in data.get("forecast", {}).get("forecastday", []):
67	            forecast_days.append({
68	                "date": day.get("date"),
69	                "max_temp_c": day.get("day", {}).get("maxtemp_c"),
70	                "min_temp_c": day.get("day", {}).get("mintemp_c"),
71	                "max_temp_f": day.get("day", {}).get("maxtemp_f"),
72	                "min_temp_f": day.get("day", {}).get("mintemp_f"),
73	                "condition": day.get("day", {}).get("condition", {}).get("text"),
74	                "icon": day.get("day", {}).get("condition", {}).get("icon"),
75	                "chance_of_rain": day.get("day", {}).get("daily_chance_of_rain"),
76	                "chance_of_snow": day.get("day", {}).get("daily_chance_of_snow"),
77	                "max_wind_kph": day.get("day", {}).get("maxwind_kph"),
78	                "avg_humidity": day.get("day", {}).get("avghumidity"),
79	                "uv_index": day.get("day", {}).get("uv")
80	            })
81	        
82	        return {
83	            "city": data.get("location", {}).get("name"),
84	            "country": data.get("location", {}).get("country"),
85	            "region": data.get("location", {}).get("region"),
86	            "forecast": forecast_days
87	        }
88	    except requests.exceptions.RequestException as e:
89	        return {"error": f"API request failed: {str(e)}"}
90	    except Exception as e:
91	        return {"error": f"Unexpected error: {str(e)}"}
