656	    async def _get_steam_stats_alternative(
657	        self, session: aiohttp.ClientSession
658	    ) -> List[Dict[str, Any]]:
659	        try:
660	            response_text = await self.make_request(
661	                f"{self.store_url}/stats/Steam-Game-and-Player-Statistics?l=english",
662	                session,
663	            )
664	        except Exception as e:
665	            print(
666	                f"[{datetime.now()}] SteamService: Failed to fetch Steam stats alternative page: {e}"
667	            )
668	            return []
669	
670	        soup = BeautifulSoup(response_text, "lxml")
671	        games = []
672	        for index, row in enumerate(soup.select(".player_count_row")[:15]):
673	            try:
674	                name_link = row.select_one("a.gameLink")
675	                if not name_link:
676	                    continue
677	                name = name_link.text.strip()
678	                app_id = None
679	                match = re.search(r"/app/(\d+)", name_link["href"])
680	                if match: app_id = match.group(1)
681	                if not app_id: app_id = f"stats_alt_{name.replace(' ', '_').lower()}"
682	
683	                current_players_cell = row.select_one("span.currentServers")
684	                current_players = (
685	                    int(current_players_cell.text.strip().replace(",", ""))
686	                    if current_players_cell
687	                    else 0
688	                )
689	                if name and current_players > 0:
690	                    games.append(
691	                        {
692	                            "id": app_id,
693	                            "name": name,
694	                            "currentPlayers": current_players,
695	                            "rank": index + 1,
696	                            "platform": "Steam",
697	                            "isPopular": True,
698	                            "source": "steam_stats_page_alt",
699	                            "lastUpdated": datetime.now().isoformat(),
700	                            "url": name_link['href'] if name_link else None
701	                        }
702	                    )
703	            except Exception as e:
704	                print(
705	                    f"[{datetime.now()}] SteamService: Error parsing Steam stats alternative row: {e}"
706	                )
707	                continue
708	        return games
