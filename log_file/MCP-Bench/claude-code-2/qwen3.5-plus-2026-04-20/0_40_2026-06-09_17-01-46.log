1	def get_fruit_info(fruit_name):
2	    """
3	    Get nutritional information for a given fruit.
4	    """
5	    import requests
6	
7	    # Define the API endpoint
8	    api_url = f"https://www.fruityvice.com/api/fruit/{fruit_name}"
9	
10	    try:
11	        # Make the API request
12	        response = requests.get(api_url)
13	
14	        # Check if the request was successful
15	        if response.status_code == 200:
16	            # Parse the JSON response
17	            data = response.json()
18	            return {
19	                "name": data.get("name", "Unknown"),
20	                "family": data.get("family", "Unknown"),
21	                "genus": data.get("genus", "Unknown"),
22	                "order": data.get("order", "Unknown"),
23	                "nutritions": data.get("nutritions", {}),
24	                "id": data.get("id", "Unknown")
25	            }
26	        elif response.status_code == 404:
27	            return {"error": f"Fruit '{fruit_name}' not found"}
28	        else:
29	            return {"error": f"Failed to retrieve data from API. Status code: {response.status_code}"}
30	    except requests.exceptions.RequestException as e:
31	        return {"error": f"Network error: {str(e)}"}
