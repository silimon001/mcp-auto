44	    "shape": [2, 3],
45	    "values": [1, 2, 3, 4, 5, 6],
46	    "name": "my_tensor"
47	}
48	create_response = send_rpc("create_tensor", tensor_params)
49	print("Created tensor:", create_response["result"])

