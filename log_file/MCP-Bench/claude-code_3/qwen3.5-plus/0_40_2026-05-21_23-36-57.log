30	    async def make_request(
31	        self, url: str, session: aiohttp.ClientSession, is_json: bool = False
32	    ) -> Any:
33	        now = time.time()
34	        time_since_last = now - self.last_request
35	
36	        if time_since_last < self.request_delay:
37	            await asyncio.sleep(self.request_delay - time_since_last)
38	
39	        self.last_request = time.time()
