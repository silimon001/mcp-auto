17	const CONFIG_FILE_NAME = "config.json";
18	
19	async function getOrCreateConfig(configDir: string): Promise<any> {
20	  const configPath = path.join(configDir, CONFIG_FILE_NAME);
21	  
22	  if (existsSync(configPath)) {
23	    const data = await fs.readFile(configPath, "utf-8").then(d => d.trim());
24	    if (data === "") {
25	      return { Servers: {} };
26	    }
27	    return JSON.parse(data);
28	  } else {
29	    return { Servers: {} };
30	  }
31	}
