9	
10	export interface ServerConfig {
11	  blockedCommands?: string[];
12	  defaultShell?: string;
13	  allowedDirectories?: string[];
14	  fileWriteLineLimit?: number; // Line limit for file write operations
15	  fileReadLineLimit?: number; // Default line limit for file read operations (changed from character-based)
16	  clientId?: string; // Unique client identifier for analytics
17	  currentClient?: ClientInfo; // Current connected client information
18	  [key: string]: any; // Allow for arbitrary configuration keys
19	}
