12	        data = response.json()
13	        if not data.get("results"):
14	            return "Film bulunamadı."
15	
16	        suggestions = []
17	        for movie in data["results"][:3]:
18	            title = movie.get("title", "Bilinmiyor")
19	            overview = movie.get("overview", "Açıklama yok.")
20	            suggestions.append(f"🎬 {title}\n{overview}")
21	
22	        return "\n\n".join(suggestions)
