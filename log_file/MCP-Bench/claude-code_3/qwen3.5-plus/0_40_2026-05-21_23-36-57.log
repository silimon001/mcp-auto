6	/**
7	 * Get the entire config including system information
8	 */
9	export async function getConfig() {
10	  console.error('getConfig called');
11	  try {
12	    const config = await configManager.getConfig();
13	    
14	    // Add system information and current client to the config response
15	    const systemInfo = getSystemInfo();
16	    
17	    // Get memory usage
18	    const memoryUsage = process.memoryUsage();
19	    const memory = {
20	      rss: `${(memoryUsage.rss / 1024 / 1024).toFixed(2)} MB`,
21	      heapTotal: `${(memoryUsage.heapTotal / 1024 / 1024).toFixed(2)} MB`,
22	      heapUsed: `${(memoryUsage.heapUsed / 1024 / 1024).toFixed(2)} MB`,
23	      external: `${(memoryUsage.external / 1024 / 1024).toFixed(2)} MB`,
24	      arrayBuffers: `${(memoryUsage.arrayBuffers / 1024 / 1024).toFixed(2)} MB`
25	    };
26	    
27	    const configWithSystemInfo = {
28	      ...config,
29	      currentClient,
30	      systemInfo: {
31	        ...systemInfo,
32	        memory
33	      }
34	    };
35	    
36	    console.error(`getConfig result: ${JSON.stringify(configWithSystemInfo, null, 2)}`);
37	    return {
38	      content: [{
39	        type: "text",
40	        text: `Current configuration:\n${JSON.stringify(configWithSystemInfo, null, 2)}`
41	      }],
42	    };
43	  } catch (error) {
44	    console.error(`Error in getConfig: ${error instanceof Error ? error.message : String(error)}`);
45	    console.error(error instanceof Error && error.stack ? error.stack : 'No stack trace available');
46	    // Return empty config rather than crashing
47	    return {
48	      content: [{
49	        type: "text",
50	        text: `Error getting configuration: ${error instanceof Error ? error.message : String(error)}\nUsing empty configuration.`
51	      }],
52	    };
53	  }
54	}
55	
56	/**
57	 * Set a specific config value
58	 */
59	export async function setConfigValue(args: unknown) {
60	  console.error(`setConfigValue called with args: ${JSON.stringify(args)}`);
61	  try {
62	    const parsed = SetConfigValueArgsSchema.safeParse(args);
63	    if (!parsed.success) {
64	      console.error(`Invalid arguments for set_config_value: ${parsed.error}`);
65	      return {
66	        content: [{
67	          type: "text",
68	          text: `Invalid arguments: ${parsed.error}`
69	        }],
70	        isError: true
71	      };
72	    }
73	
74	    try {
75	      // Parse string values that should be arrays or objects
76	      let valueToStore = parsed.data.value;
77	      
78	      // If the value is a string that looks like an array or object, try to parse it
79	      if (typeof valueToStore === 'string' && 
80	          (valueToStore.startsWith('[') || valueToStore.startsWith('{'))) {
81	        try {
82	          valueToStore = JSON.parse(valueToStore);
83	          console.error(`Parsed string value to object/array: ${JSON.stringify(valueToStore)}`);
84	        } catch (parseError) {
85	          console.error(`Failed to parse string as JSON, using as-is: ${parseError}`);
86	        }
87	      }
88	
89	      // Special handling for known array configuration keys
90	      if ((parsed.data.key === 'allowedDirectories' || parsed.data.key === 'blockedCommands') && 
91	          !Array.isArray(valueToStore)) {
92	        if (typeof valueToStore === 'string') {
93	          const originalString = valueToStore;
94	          try {
95	            const parsedValue = JSON.parse(originalString);
96	            valueToStore = parsedValue;
97	          } catch (parseError) {
98	            console.error(`Failed to parse string as array for ${parsed.data.key}: ${parseError}`);
99	            // If parsing failed and it's a single value, convert to an array with one item
100	            if (!originalString.includes('[')) {
101	              valueToStore = [originalString];
102	            }
103	          }
104	        } else if (valueToStore !== null) {
105	          // If not a string or array (and not null), convert to an array with one item
106	          valueToStore = [String(valueToStore)];
107	        }
108	        
109	        // Ensure the value is an array after all our conversions
110	        if (!Array.isArray(valueToStore)) {
111	          console.error(`Value for ${parsed.data.key} is still not an array, converting to array`);
112	          valueToStore = [String(valueToStore)];
113	        }
114	      }
115	
116	      await configManager.setValue(parsed.data.key, valueToStore);
117	      // Get the updated configuration to show the user
118	      const updatedConfig = await configManager.getConfig();
119	      console.error(`setConfigValue: Successfully set ${parsed.data.key} to ${JSON.stringify(valueToStore)}`);
120	      return {
121	        content: [{
122	          type: "text",
123	          text: `Successfully set ${parsed.data.key} to ${JSON.stringify(valueToStore, null, 2)}\n\nUpdated configuration:\n${JSON.stringify(updatedConfig, null, 2)}`
124	        }],
125	      };
126	    } catch (saveError: any) {
127	      console.error(`Error saving config: ${saveError.message}`);
128	      // Continue with in-memory change but report error
129	      return {
130	        content: [{
131	          type: "text", 
132	          text: `Value changed in memory but couldn't be saved to disk: ${saveError.message}`
133	        }],
134	        isError: true
135	      };
136	    }
137	  } catch (error) {
138	    console.error(`Error in setConfigValue: ${error instanceof Error ? error.message : String(error)}`);
139	    console.error(error instanceof Error && error.stack ? error.stack : 'No stack trace available');
140	    return {
141	      content: [{
142	        type: "text",
143	        text: `Error setting value: ${error instanceof Error ? error.message : String(error)}`
144	      }],
145	      isError: true
146	    };
147	  }
148	}

