1	import requests
2	from bs4 import BeautifulSoup
3	import json
4	from typing import List, Dict, Any, Optional
5	
6	class WikiCFPScraper:
7	    """WikiCFP tool.search scraper for conference information"""
8	    
9	    def __init__(self):
10	        self.base_url = "http://www.wikicfp.com"
11	        self.search_url = "http://www.wikicfp.com/cfp/servlet/tool.search"
12	        self.headers = {
13	            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
14	        }
15	        
16	    def search_conferences(self, query: str, year: str = 't') -> List[Dict]:
17	        """
18	        Search for conferences on WikiCFP
19	        
20	        Args:
21	            query: Search term
22	            year: Year filter ('t' = this year, 'n' = next year, 'a' = all)
23	            
24	        Returns:
25	            Conference list
26	        """
27	        conferences = []
28	        
29	        try:
30	            params = {
31	                'q': query,
32	                'year': year
33	            }
34	            
35	            print(f"Searching for: {query}")
36	            response = requests.get(self.search_url, params=params, headers=self.headers)
37	            
38	            if response.status_code != 200:
39	                print(f"Could not connect to WikiCFP! (status code: {response.status_code})")
40	                return conferences
41	            
42	            soup = BeautifulSoup(response.text, 'html.parser')
43	            
44	            # Find the main conference table
45	            tables = soup.find_all('table', attrs={'cellpadding': '2', 'cellspacing': '1'})
46	            
47	            for table in tables:
48	                # Check for header row
49	                header_row = table.find('tr', attrs={'bgcolor': '#bbbbbb'})
50	                if header_row:
51	                    # This is a conference table, process it
52	                    conferences.extend(self._parse_conference_table(table))
53	            
54	        except Exception as e:
55	            print(f"Error occurred: {e}")
56	        
57	        return conferences
58	    
59	    def _parse_conference_table(self, table) -> List[Dict]:
60	        """Parse the conference table"""
61	        conferences = []
62	        
63	        # Get all rows (excluding header)
64	        rows = table.find_all('tr')[1:]  # First row is header
65	        
66	        i = 0
67	        while i < len(rows):
68	            # Each conference spans two rows
69	            if i + 1 < len(rows):
70	                first_row = rows[i]
71	                second_row = rows[i + 1]
72	                
73	                conference = self._parse_conference_pair(first_row, second_row)
74	                if conference:
75	                    conferences.append(conference)
76	                
77	                i += 2
78	            else:
79	                i += 1
80	        
81	        return conferences
82	    
83	    def _parse_conference_pair(self, first_row, second_row) -> Dict:
84	        """Parse the two rows containing conference information"""
85	        try:
86	            # From first row: conference name and link
87	            first_cells = first_row.find_all('td')
88	            if not first_cells:
89	                return None
90	            
91	            # First cell (with rowspan=2) contains conference name and link
92	            name_cell = first_cells[0]
93	            link = name_cell.find('a')
94	            
95	            if link:
96	                event_name = link.text.strip()
97	                event_link = self.base_url + link.get('href', '')
98	            else:
99	                event_name = name_cell.text.strip()
100	                event_link = ''
101	            
102	            # Second cell of first row usually contains conference description
103	            conference_description = ""
104	            if len(first_cells) > 1:
105	                conference_description = first_cells[1].text.strip()
106	            
107	            # From second row: date, location and deadline
108	            second_cells = second_row.find_all('td')
109	            
110	            event_time = ""
111	            event_location = ""
112	            deadline = ""
113	            
114	            if len(second_cells) >= 3:
115	                event_time = second_cells[0].text.strip()
116	                event_location = second_cells[1].text.strip()
117	                deadline = second_cells[2].text.strip()
118	            
119	            # Create description
120	            description = conference_description
121	            if not description:
122	                description_parts = []
123	                if event_location:
124	                    description_parts.append(f"Location: {event_location}")
125	                if deadline:
126	                    description_parts.append(f"Deadline: {deadline}")
127	                description = " | ".join(description_parts) if description_parts else "Conference"
128	            
129	            return {
130	                "event_name": event_name,
131	                "event_description": conference_description,
132	                "event_time": event_time,
133	                "event_location": event_location,
134	                "deadline": deadline,
135	                "description": description,
136	                "event_link": event_link
137	            }
138	            
139	        except Exception as e:
140	            print(f"Parse error: {e}")
141	            return None
142	
143	def getEvents(keywords: str, limit: Optional[int] = None) -> Dict[str, Any]:
144	    """
145	    Get conference events matching the given keywords
146	    
147	    Args:
148	        keywords: Search terms for conferences
149	        limit: Maximum number of events to return (None for all)
150	        
151	    Returns:
152	        Dictionary with status and results
153	    """
154	    try:
155	        scraper = WikiCFPScraper()
156	        
157	        # Perform search
158	        conferences = scraper.search_conferences(keywords, year='t')
159	        
160	        # Limit results if specified
161	        if limit is not None and limit > 0:
162	            conferences = conferences[:limit]
163	        
164	        return {
165	            "status": "success",
166	            "count": len(conferences),
167	            "events": conferences
168	        }
169	    except Exception as e:
170	        return {
171	            "status": "error",
172	            "message": str(e),
173	            "events": []
174	        }
175	
176	# The following code only runs when directly executed, not when imported
177	if __name__ == "__main__":
178	    # Simple CLI test for the getEvents function
179	    import sys
180	    
181	    keywords = "ai agent"
182	    limit = 5
183	    
184	    if len(sys.argv) > 1:
185	        keywords = sys.argv[1]
186	    if len(sys.argv) > 2:
187	        try:
188	            limit = int(sys.argv[2])
189	        except ValueError:
190	            print(f"Invalid limit: {sys.argv[2]}. Using default: {limit}")
191	    
192	    result = getEvents(keywords, limit)
