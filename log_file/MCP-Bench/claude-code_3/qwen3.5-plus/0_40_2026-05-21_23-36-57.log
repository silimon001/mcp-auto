172	export async function ExecuteCommand(args: unknown): Promise<ServerResult> {
173	  const parsed = ExecuteCommandArgsSchema.safeParse(args);
174	  if (!parsed.success) {
175	    return {
176	      content: [{ type: "text", text: `Error: Invalid arguments for execute_command: ${parsed.error}` }],
177	      isError: true,
178	    };
179	  }
180	
181	  const isAllowed = await commandManager.validateCommand(parsed.data.command);
182	  if (!isAllowed) {
183	    return {
184	      content: [{ type: "text", text: `Error: Command not allowed: ${parsed.data.command}` }],
185	      isError: true,
186	    };
187	  }
188	
189	  let shellUsed: string | undefined = parsed.data.shell;
190	
191	  if (!shellUsed) {
192	    const config = await configManager.getConfig();
193	    if (config.defaultShell) {
194	      shellUsed = config.defaultShell;
195	    } else {
196	      const isWindows = os.platform() === 'win32';
197	      if (isWindows && process.env.COMSPEC) {
198	        shellUsed = process.env.COMSPEC;
199	      } else if (!isWindows && process.env.SHELL) {
200	        shellUsed = process.env.SHELL;
201	      } else {
202	        shellUsed = isWindows ? 'cmd.exe' : '/bin/sh';
203	      }
204	    }
205	  }
206	
207	  const result = await terminalManager.executeCommand(
208	    parsed.data.command,
209	    parsed.data.timeout_ms,
210	    shellUsed,
211	    false
212	  );
213	
214	  if (result.pid === -1) {
215	    return {
216	      content: [{ type: "text", text: result.output }],
217	      isError: true,
218	    };
219	  }
220	
221	  killProcess(result.pid)
222	  let output = terminalManager.getNewOutput(result.pid);
223	
224	  if (output !== null && !output.includes("Process completed with exit code")) {
225	      output += `\nOperation timed out. The process has been forcibly terminated. Please try a different command or increase the timeout period and retry.\nRuntime: ${Math.round(parsed.data.timeout_ms / 1000)} s`
226	  }
227	
228	  return {
229	    content: [{
230	      type: "text",
231	      text: `Process started with PID ${result.pid} (shell: ${shellUsed})\nInitial output:\n${output}`
232	    }],
233	  };
234	}
