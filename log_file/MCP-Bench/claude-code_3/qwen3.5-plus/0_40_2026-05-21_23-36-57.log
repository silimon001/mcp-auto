65	def wait_for_port(host: str, port: int, timeout: int = 30, interval: float = 0.5) -> bool:
66	    """
67	    等待某个 TCP 端口可连接，最多等待 timeout 秒
68	    :param host: 主机
69	    :param port: 端口
70	    :param timeout: 最大等待时间（秒）
71	    :param interval: 每次重试间隔（秒）
72	    :return: True if port is ready, False if timeout
73	    """
74	    start_time = time.time()
75	    while time.time() - start_time < timeout:
76	        try:
77	            with socket.create_connection((host, port), timeout=1):
78	                return True
79	        except (ConnectionRefusedError, OSError):
80	            time.sleep(interval)
81	    return False
