83	def start_process(command: str, args: List[str] = None, env: dict = None, cwd: str = None,
84	                  wait_url: str = None, wait_timeout: int = 30):
85	    """
86	    启动一个长期运行的进程（如服务器），等待服务可用后继续执行
87	    :param command: 可执行文件
88	    :param args: 参数列表
89	    :param env: 环境变量字典
90	    :param cwd: 工作目录
91	    :param wait_url: 等待服务的 URL，例如 "http://localhost:5173/mcp"
92	    :param wait_timeout: 最多等待服务启动的秒数
93	    :return: Popen 对象
94	    """
95	    if isinstance(command, tuple):
96	        command = command[0]
97	
98	    cmd_list = [command] + (args or [])
99	
100	    process = subprocess.Popen(
101	        cmd_list,
102	        env=({**get_default_environment(), **env} if env is not None else get_default_environment()),
103	        cwd=cwd,
104	        stdout=subprocess.PIPE,
105	        stderr=subprocess.PIPE,
106	        text=True
107	    )
108	    
109	    import fcntl
110	    def make_non_blocking(file):
111	        """将文件描述符设置为非阻塞"""
112	        fd = file.fileno()
113	        flags = fcntl.fcntl(fd, fcntl.F_GETFL)
114	        fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)
115	
116	    # 将 stdout 和 stderr 设置为非阻塞
117	    make_non_blocking(process.stdout)
118	    make_non_blocking(process.stderr)
119	
120	    # 等待服务器端口就绪
121	    if wait_url:
122	        from urllib.parse import urlparse
123	        parsed = urlparse(wait_url)
124	        host = parsed.hostname or "localhost"
125	        port = parsed.port or 8000
126	        print(f"Waiting for server {host}:{port} to be ready...")
127	        if wait_for_port(host, port, timeout=wait_timeout):
128	            print("Server is ready!")
129	        else:
130	            print("Timeout waiting for server to start")
131	
132	    # 非阻塞读取缓冲区中已有的 stdout/stderr
133	    try:
134	        stdout = process.stdout.read() or ""
135	    except Exception:
136	        stdout = ""
137	    try:
138	        stderr = process.stderr.read() or ""
139	    except Exception:
140	        stderr = ""
141	
142	    if stdout:
143	        print("=== STDOUT ===")
144	        print(stdout, end="")
145	    if stderr:
146	        print("=== STDERR ===")
147	        print(stderr, end="")
148	
149	    return process
