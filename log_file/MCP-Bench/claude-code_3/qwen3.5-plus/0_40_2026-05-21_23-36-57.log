21	export interface ClientInfo {
22	  name: string;
23	  version: string;
24	}
25	
26	/**
27	 * Singleton config manager for the server
28	 */
29	class ConfigManager {
30	  private configPath: string;
31	  private config: ServerConfig = {};
32	  private initialized = false;
33	
34	  constructor() {
35	    // Get user's home directory
36	    // Define config directory and file paths
37	    this.configPath = CONFIG_FILE;
38	  }
39	
40	  /**
41	   * Initialize configuration - load from disk or create default
42	   */
43	  async init() {
44	    if (this.initialized) return;
45	
46	    try {
47	      // Ensure config directory exists
48	      const configDir = path.dirname(this.configPath);
49	      if (!existsSync(configDir)) {
50	        await mkdir(configDir, { recursive: true });
51	      }
52	
53	      // Check if config file exists
54	      try {
55	        await fs.access(this.configPath);
56	        // Load existing config
57	        const configData = await fs.readFile(this.configPath, 'utf8');
58	        this.config = JSON.parse(configData);
59	      } catch (error) {
60	        // Config file doesn't exist, create default
61	        this.config = this.getDefaultConfig();
62	        await this.saveConfig();
63	      }
64	      this.config['version'] = VERSION;
65	
66	      this.initialized = true;
67	    } catch (error) {
68	      console.error('Failed to initialize config:', error);
69	      // Fall back to default config in memory
70	      this.config = this.getDefaultConfig();
71	      this.initialized = true;
72	    }
73	  }
74	
75	  /**
76	   * Alias for init() to maintain backward compatibility
77	   */
78	  async loadConfig() {
79	    return this.init();
80	  }
81	
82	  /**
83	   * Create default configuration
84	   */
85	  private getDefaultConfig(): ServerConfig {
86	    return {
87	      blockedCommands: [
88	
89	        // Disk and partition management
90	        "mkfs",      // Create a filesystem on a device
