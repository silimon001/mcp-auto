33	export async function AddConfig(
34	  name: string,
35	  type: string,
36	  url: string,
37	  headers: Record<string, string>,
38	  command: string,
39	  args: Array<string>,
40	  env: Record<string, string>,
41	  cwd: string
42	): Promise<ServerResult> {
43	  try {
44	    const configDir = global.configDir;
45	    
46	    if (!existsSync(configDir)) {
47	      await fs.mkdir(configDir, { recursive: true });
48	    }
49	
50	    const configs = await getOrCreateConfig(configDir);
51	    if (!configs.Servers) {
52	      configs.Servers = {};
53	    }
54	
55	    // 检查配置是否已存在，禁止覆盖
56	    if (configs.Servers.hasOwnProperty(name)) {
57	      return {
58	        content: [
59	          {
60	            type: "text",
61	            text: `Config with name "${name}" already exists. Overwriting is not allowed.`
62	          }
63	        ],
64	        isError: true
65	      };
66	    }
67	
68	    // 添加新配置
69	    configs.Servers[name] = {
70	      type,
71	      url,
72	      headers,
73	      command,
74	      args,
75	      env,
76	      cwd
77	    };
78	
79	    const configPath = path.join(configDir, CONFIG_FILE_NAME);
80	    await fs.writeFile(configPath, JSON.stringify(configs, null, 2), "utf-8");
81	
82	    return {
83	      content: [
84	        {
85	          type: "text",
86	          text: `Successfully added ${name} config.`
87	        }
88	      ]
89	    };
90	  } catch (error) {
91	    return {
92	      content: [
93	        {
94	          type: "text",
95	          text: `Failed to add ${name} config!\nError: ${error}`
96	        }
97	      ],
98	      isError: true
99	    };
100	  }
101	}
102	
103	export async function UpdateAndValidateConfig(
104	  name: string,
105	  type: string,
106	  url: string,
107	  headers: Record<string, string>,
108	  command: string,
109	  args: Array<string>,
110	  env: Record<string, string>,
111	  cwd: string,
112	  timeout_ms: number
113	): Promise<ServerResult> {
114	  const configDir = global.configDir;
115	
116	  // --- 第一部分：修改配置，捕获并返回明确错误 ---
117	  try {
118	    if (!existsSync(configDir)) {
119	      await fs.mkdir(configDir, { recursive: true });
120	    }
121	
122	    // 读取现有配置
123	    const configs = await getOrCreateConfig(configDir);
124	    if (!configs.Servers || !configs.Servers[name]) {
125	      return {
126	        content: [{ type: "text", text: `Config '${name}' does not exist.` }],
127	        isError: true
128	      };
129	    }
130	
131	    // 更新配置内容
132	    configs.Servers[name] = {
133	      type,
134	      url,
135	      headers,
136	      command,
137	      args,
138	      env,
139	      cwd
140	    };
141	
142	    // 写入配置文件
143	    const configPath = path.join(configDir, CONFIG_FILE_NAME);
144	    await fs.writeFile(configPath, JSON.stringify(configs, null, 2), "utf-8");
145	
146	  } catch (error) {
147	    return {
148	      content: [{ type: "text", text: `Failed to update config '${name}': ${error}` }],
149	      isError: true
150	    };
151	  }
152	
153	  // --- 第二部分：验证配置，捕获并返回明确错误 ---
154	  try {
155	    const python = global.pythonPath;
156	    const workdir = global.cwd;
157	    const configPath = path.join(configDir, CONFIG_FILE_NAME);
158	    const validationCmd = `${python} ${workdir}/dist/config_validation.py ${configPath} ${name}`;
159	
160	    // 执行验证命令（假设 ExecuteCommand 已定义）
161	    return await ExecuteCommand({ command: validationCmd, timeout_ms });
162	
163	  } catch (error) {
164	    return {
165	      content: [{ type: "text", text: `Config updated, but validation failed: ${error}` }],
166	      isError: true
167	    };
168	  }
169	}
