3	def getMovieSuggestions(keyword: str) -> str:
4	    """
5	    Get movie suggestions from TMDb API based on keyword.
6	    """
7	    API_KEY = "c6fae702c36224d5f01778d394772520"  # Gerçek key ile değiştirilebilir
8	    url = f"https://api.themoviedb.org/3/search/movie?api_key={API_KEY}&query={keyword}"
9	
10	    response = requests.get(url)
11	    if response.status_code == 200:
12	        data = response.json()
13	        if not data.get("results"):
14	            return "Film bulunamadı."
15	
16	        suggestions = []
17	        for movie in data["results"][:3]:
18	            title = movie.get("title", "Bilinmiyor")
19	            overview = movie.get("overview", "Açıklama yok.")
20	            suggestions.append(f"🎬 {title}\n{overview}")
21	
22	        return "\n\n".join(suggestions)
23	    else:
24	        return "API isteği başarısız oldu."
