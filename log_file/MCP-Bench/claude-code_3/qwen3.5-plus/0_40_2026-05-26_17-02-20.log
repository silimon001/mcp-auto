30	    async def make_request(
31	        self, url: str, session: aiohttp.ClientSession, is_json: bool = False
32	    ) -> Any:
33	        now = time.time()
34	        time_since_last = now - self.last_request
35	
36	        if time_since_last < self.request_delay:
37	            await asyncio.sleep(self.request_delay - time_since_last)
38	
39	        self.last_request = time.time()
40	
41	        headers = {
42	            "User-Agent": self.get_random_user_agent(),
43	            "Accept": "application/json, text/plain, */*"
44	            if is_json
45	            else "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
46	            "Accept-Language": "en-US,en;q=0.9",
47	            "Accept-Encoding": "gzip, deflate, br",
48	            "DNT": "1",
49	            "Connection": "keep-alive",
50	            "Upgrade-Insecure-Requests": "1" if not is_json else "0",
51	        }
52	
53	        if is_json:
54	            headers["X-Requested-With"] = "XMLHttpRequest"
55	
56	        # print(f"[{datetime.now()}] Making request to: {url}")
57	        async with session.get(url, headers=headers, timeout=20) as response:
58	            response.raise_for_status()  # Raise an exception for HTTP errors
59	            if is_json:
60	                return await response.json()
61	            return await response.text()
