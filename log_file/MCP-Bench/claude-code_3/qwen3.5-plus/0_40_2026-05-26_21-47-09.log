116	// ==================== HELPER FUNCTIONS ====================
117	
118	function notEmpty<TValue>(value: TValue | null | undefined): value is TValue {
119	  return value !== null && value !== undefined;
120	}
121	
122	function tryParseJson<T extends unknown>(text: string): T | null {
123	  try {
124	    const removeCommentsRegex =
125	      /\\"|"(?:\\"|[^"])*"|(\/\/.*|\/\*[\s\S]*?\*\/)/g;
126	    const jsonStringWithoutComments = text.replace(
127	      removeCommentsRegex,
128	      (m, g) => (g ? "" : m)
129	    );
130	    return JSON.parse(jsonStringWithoutComments) as T;
131	  } catch (parseError) {
132	    return null;
133	  }
134	}
