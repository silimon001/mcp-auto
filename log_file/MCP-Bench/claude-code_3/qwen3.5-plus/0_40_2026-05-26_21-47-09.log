1288	@mcp.tool()
1289	async def get_mars_rover_manifest(rover_name: str) -> str:
1290	    """Get the mission manifest for a Mars rover (Curiosity, Opportunity, Spirit).
1291	    Provides mission details like landing/launch dates, status, max sol/date, total photos, and photo counts per sol.
1292	    
1293	    Args:
1294	        rover_name: Name of the rover (curiosity, opportunity, spirit).
1295	    """
1296	    rover_name = rover_name.lower()
1297	    if rover_name not in ROVER_CAMERAS:
1298	        return f"Invalid rover name. Available rovers: {', '.join(ROVER_CAMERAS.keys())}"
1299	        
1300	    url = f"{NASA_API_BASE}/mars-photos/api/v1/manifests/{rover_name}"
1301	    data = await make_nasa_request(url)
1302	    
1303	    if not data:
1304	        return f"Could not retrieve mission manifest for {rover_name} due to a connection error."
1305	    
1306	    # Check for error response (must be a dictionary)
1307	    if isinstance(data, dict) and "error" in data:
1308	        return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
1309	    if isinstance(data, dict) and data.get("binary_content"):
1310	        return f"Received unexpected binary content from Mars Rover Manifest API. URL: {data.get('url')}"
1311	    
1312	    # Response should be a dictionary containing 'photo_manifest'
1313	    if not isinstance(data, dict) or "photo_manifest" not in data:
1314	        logger.error(f"Unexpected response format from Mars Rover Manifest API: {data}")
1315	        return "Received unexpected data format from Mars Rover Manifest API."
1316	
1317	    try:
1318	        manifest = data.get("photo_manifest", {})
1319	        result = [
1320	            f"Mission Manifest for Rover: {manifest.get('name', 'Unknown')}",
1321	            f"Status: {manifest.get('status', 'Unknown')}",
1322	            f"Launch Date: {manifest.get('launch_date', 'Unknown')}",
1323	            f"Landing Date: {manifest.get('landing_date', 'Unknown')}",
1324	            f"Max Sol: {manifest.get('max_sol', 'Unknown')}",
1325	            f"Max Earth Date: {manifest.get('max_date', 'Unknown')}",
1326	            f"Total Photos: {manifest.get('total_photos', 'Unknown')}",
1327	            "
1328	Photo Summary per Sol (showing latest 5 sols with photos):"
1329	        ]
1330	        
1331	        photos_per_sol = manifest.get('photos', [])
1332	        # Sort by sol descending to show latest first
1333	        photos_per_sol_sorted = sorted(photos_per_sol, key=lambda x: x.get('sol', -1), reverse=True)
1334	        
1335	        display_limit = 5
1336	        count = 0
1337	        for sol_info in photos_per_sol_sorted:
1338	            if count >= display_limit:
1339	                result.append(f"\n... and {len(photos_per_sol) - display_limit} more sols with photos.")
1340	                break
1341	            result.append(f"  Sol {sol_info.get('sol', 'N/A')}: {sol_info.get('total_photos', 0)} photos")
1342	            result.append(f"    Cameras: {', '.join(sol_info.get('cameras', []))}")
1343	            count += 1
1344	            
1345	        return "\n".join(result)
1346	    except Exception as e:
1347	        logger.error(f"Error processing Mars Rover Manifest data: {str(e)}")
1348	        return f"Error processing Mars Rover Manifest data: {str(e)}"
