1047	@mcp.tool()
1048	async def get_epic_dates(collection: str = "natural") -> str:
1049	    """Get available dates for EPIC images.
1050	    
1051	    Args:
1052	        collection: Collection type. Options: natural, enhanced.
1053	    """
1054	    if collection not in ["natural", "enhanced"]:
1055	        return "Invalid collection. Available options: natural, enhanced."
1056	    
1057	    url = f"{NASA_API_BASE}/EPIC/api/{collection}/all"
1058	    data = await make_nasa_request(url)
1059	    
1060	    if not data: 
1061	        return f"Could not retrieve available dates for EPIC {collection} collection due to a connection error."
1062	    
1063	    # Check for error response (must be a dictionary)
1064	    if isinstance(data, dict):
1065	        if "error" in data:
1066	            return f"API Error: {data.get('error')} - Details: {data.get('details', 'N/A')}"
1067	        if data.get("binary_content"):
1068	            return f"Received unexpected binary content from EPIC Dates API. URL: {data.get('url')}"
1069	    
1070	    # Ensure data is a list
1071	    if not isinstance(data, list):
1072	        logger.error(f"Unexpected non-list response from EPIC Dates API: {data}")
1073	        return "Received unexpected data format from EPIC Dates API."
1074	
1075	    try:
1076	        if not data:  # Empty list
1077	            return f"No dates available for EPIC images from the {collection} collection."
1078	        
1079	        # Data is a list of objects like {'date': 'YYYY-MM-DD HH:MM:SS'}
1080	        # Extract unique dates (YYYY-MM-DD part)
1081	        unique_dates = sorted(list(set(item.get('date', '').split(' ')[0] for item in data if item.get('date'))))
1082	        
1083	        result = [f"Available dates for EPIC {collection} images: {len(unique_dates)}"]
1084	        
1085	        # Show dates in groups of 10 per line
1086	        for i in range(0, len(unique_dates), 10):
1087	            result.append(", ".join(unique_dates[i:i+10]))
1088	        
1089	        return "\n".join(result)
1090	    except Exception as e:
1091	        logger.error(f"Error processing available dates for EPIC images: {str(e)}")
1092	        return f"Error processing available dates for EPIC images: {str(e)}"
