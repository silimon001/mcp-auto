842	        return f"Received unexpected binary content from Earth Assets API. URL: {data.get('url')}"
843	
844	    try:
845	        # The structure might have changed, docs mention 'results' array now?
846	        # Let's assume the old structure for now based on previous code
847	        # If 'results' is the key for a list: assets = data.get('results', [])
848	        # If it's a single result: assets = [data] if data else []
849	        
850	        # Based on the docs example, it seems to return a single object with 'id' and 'dataset'
851	        # Let's refine based on the example query structure
852	        
853	        asset_id = data.get('id')
854	        asset_dataset = data.get('dataset')
855	        asset_date = data.get('date', 'Unknown').split('T')[0] # Extract date part
856	        
857	        if not asset_id:
858	             # Check if response is like {'count': 0, 'results': []}
859	             if data.get('count') == 0 and isinstance(data.get('results'), list):
860	                 return f"No Landsat 8 assets found for the specified location and date range (Lat: {lat}, Lon: {lon}, Date: {date})."
861	             else:
862	                 logger.warning(f"Unexpected JSON structure from Earth Assets API: {data}")
863	                 return "No asset ID found in the response."
864	
865	        result = [
866	            f"Asset found for coordinates: Lat {lat}, Lon {lon}",
867	            f"Date (closest): {asset_date}",
868	            f"ID: {asset_id}",
869	            f"Dataset: {asset_dataset}"
870	            # The API doesn't seem to return a direct URL here anymore based on docs
871	        ]
872	        
873	        return "\n".join(result)
874	    except Exception as e:
875	        logger.error(f"Error processing Earth Assets data: {str(e)}")
876	        return f"Error processing asset data: {str(e)}"
