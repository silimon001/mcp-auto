828	    # This endpoint is expected to return JSON based on docs
829	    data = await make_nasa_request(url, params)
830	    
831	    if not data:
832	        return "Could not retrieve Earth asset data due to a connection error."
833	    
834	    # Check for error response (must be a dictionary)
835	    if isinstance(data, dict) and "error" in data:
836	         # Handle specific case where API returns error message
