360	    }
361	
362	    const { openapiUrl, openapiJson } = openapi;
363	
364	    if (!openapiJson) {
365	      throw new Error("Could not parse OpenAPI JSON");
366	    }
367	
368	    const isSwagger =
369	      (openapiJson as any)?.swagger ||
370	      !openapiJson?.openapi ||
371	      !openapiJson?.openapi.startsWith("3.");
372	
373	    const convertedOpenapi = isSwagger
