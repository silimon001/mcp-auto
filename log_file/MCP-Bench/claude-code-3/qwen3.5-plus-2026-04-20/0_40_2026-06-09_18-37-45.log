1	#!/usr/bin/env python3
2	"""
3	Enhanced Bibliomantic MCP Server
4	
5	A Model Context Protocol server that integrates enhanced I Ching divination with AI responses,
6	exploring the bibliomantic approach described in Philip K. Dick's "The Man in the High Castle"
7	with full traditional Chinese I Ching elements.
8	
9	This is the main entry point for the enhanced server when invoked directly by Claude Desktop.
10	Maintains backward compatibility with existing configurations.
11	"""
12	
13	import sys
14	import logging
15	
16	# Configure logging to stderr (MCP uses stdout for protocol)
17	logging.basicConfig(
18	    level=logging.INFO,
19	    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
20	    stream=sys.stderr
21	)
22	logger = logging.getLogger(__name__)
23	
24	# Try to import enhanced server first, fall back to original
25	try:
26	    from enhanced_bibliomantic_server import mcp
27	    logger.info("Loaded Enhanced Bibliomantic MCP Server with traditional I Ching content")
28	except ImportError as e:
29	    logger.warning(f"Enhanced server not available ({e}), falling back to original server")
30	    try:
31	        from bibliomantic_fastmcp_ethical import mcp
32	        logger.info("Loaded original Bibliomantic MCP Server in compatibility mode")
33	    except ImportError as fallback_error:
34	        logger.error(f"Failed to load any server: {fallback_error}")
35	        # Create a minimal error server to prevent import failure
36	        from mcp.server.fastmcp import FastMCP
37	        mcp = FastMCP(name="Bibliomantic Oracle - Error State")
38	        
39	        @mcp.tool()
40	        def server_error() -> str:
41	            return "Server failed to initialize properly. Please check the logs and ensure all dependencies are installed."
42	
43	def main():
44	    """Main entry point for the bibliomantic server."""
45	    try:
46	        mcp.run()
47	    except Exception as e:
48	        logger.error(f"Server failed to start: {e}")
49	        sys.exit(1)
50	
51	if __name__ == "__main__":
52	    main()
53	
