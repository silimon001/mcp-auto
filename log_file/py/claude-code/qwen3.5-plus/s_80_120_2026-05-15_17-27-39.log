ist_ok=True) 453 with open('mcp_server_config/config.json', 'w', encoding='utf-8') as f: 454 f.write('{\n\n}') 455 456 with open('claude_code/prompt_workflow.md', 'r', encoding='utf-8') as f: 457 task_prompt = f.read() 458 459 task_prompt = task_prompt.replace("{WORKSPACE}", os.getcwd()) 460 print(task_prompt) 461 462 from glob import glob 463 # 获取待处理的 README 文件列表 464 readme_dir = Path.cwd() / "data" / "dataset" / dataset_name / "sampled_validated_readme" 465 readme_files = sorted(glob(str(readme_dir / "*.md")), key=os.path.getsize) 466 467 pos = 80 468 count = 40 469 470 for readme_path in readme_files[pos:pos+count]: 471 readme_path = Path(readme_path) 472 filename_parts = readme_path.stem.split('_') 473 repo_id = filename_parts[0] 474 repo_name = '_'.join(filename_parts[1:]).replace('_README', '') 475 476 with open(readme_path, 'r', encoding='utf-8') as f: 477 readme_content = f.read() 478 479 extra_info = add_extra_info(dataset_name, repo_id) 480 481 query = f'''\n=== README.md START ===\n{readme_content}\n=== README.md END ===\n{extra_info}''' 482 483 all_prompt = task_prompt + query 484 485 print(all_prompt) 486 487 run_task(all_prompt, "claude_code", pos, count)
