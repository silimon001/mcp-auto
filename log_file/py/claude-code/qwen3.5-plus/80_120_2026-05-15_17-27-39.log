45	    new_by_name = {item.get("name", i): item for i, item in enumerate(new) if isinstance(item, dict)}
46	    
47	    for name in set(old_by_name.keys()) | set(new_by_name.keys()):
48	        item_path = f"{path}[{name}]"
49	        if name not in old_by_name:
50	            changes.append(f"  + {item_path}: добавлено")
51	        elif name not in new_by_name:
52	            changes.append(f"  - {item_path}: удалено")
53	        elif old_by_name[name] != new_by_name[name]:
54	            changes.extend(_diff_dicts(old_by_name[name], new_by_name[name], item_path))
55	    
56	    return changes
57	
58	
59	@dataclass
60	class IBConfig:
61	    """Конфигурация одной информационной базы."""
62	    name: str  # Уникальный идентификатор (slug)
63	    title: str = ""
64	    source_dir: str = ""
65	    index_dir: str = ""
66	    embedding_model: str = "cointegrated/rubert-tiny2"
67	    embedding_device: str = "cpu"  # cpu, gpu, dml
68	    embedding_mode: str = "full"  # full | methods | signatures
69	    vector_db: str = "qdrant"
70	
71	    def __post_init__(self):
72	        if not self.title:
73	            self.title = self.name
74	
75	
76	@dataclass
77	class GlobalConfig:
78	    """Глобальная конфигурация приложения."""
79	    port: int = DEFAULT_PORT
80	    check_interval: int = DEFAULT_CHECK_INTERVAL
81	    log_level: str = "INFO"
82	    scan_workers: int = 8
83	    ibs: list[IBConfig] = field(default_factory=list)
84	
85	
86	class ConfigManager:
87	    """Менеджер загрузки и сохранения конфигурации."""
88	
89	    def __init__(self, config_path: str = DEFAULT_CONFIG_FILE):
90	        self.config_path = Path(config_path)
91	        self.config = GlobalConfig()
92	
93	    def load(self) -> GlobalConfig:
94	        """Загрузить конфигурацию из файла."""
95	        if not self.config_path.exists():
96	            # Use logger if initialized, otherwise print? 
97	            # Actually logger is not init yet when loading config usually.
98	            print(f"Конфиг {self.config_path} не найден, создаю дефолтный.")
99	            self.save()
100	            return self.config
101	
102	        try:
103	            with open(self.config_path, "r", encoding="utf-8") as f:
104	                data = yaml.safe_load(f) or {}
105	
106	            global_data = data.get("global", {})
107	            self.config.port = global_data.get("port", DEFAULT_PORT)
108	            self.config.check_interval = global_data.get("check_interval", DEFAULT_CHECK_INTERVAL)
109	            self.config.log_level = global_data.get("log_level", "INFO")
110	            self.config.scan_workers = global_data.get("scan_workers", 8)
111	
112	            self.config.ibs = []
113	            for ib_data in data.get("ibs", []):
114	                self.config.ibs.append(IBConfig(**ib_data))
115	            
116	            return self.config
117	        except Exception as e:
118	            print(f"Ошибка загрузки конфига: {e}")
119	            return self.config
120	
121	    def save(self):
122	        """Сохранить конфигурацию в файл."""
123	        new_data = {
124	            "global": {
125	                "port": self.config.port,
126	                "check_interval": self.config.check_interval,
127	                "log_level": self.config.log_level,
128	                "scan_workers": self.config.scan_workers
129	            },
130	            "ibs": [asdict(ib) for ib in self.config.ibs]
131	        }
132	        
133	        # Читаем старый конфиг для сравнения
134	        old_data = {}
135	        if self.config_path.exists():
136	            try:
137	                with open(self.config_path, "r", encoding="utf-8") as f:
138	                    old_data = yaml.safe_load(f) or {}
139	            except Exception:
140	                pass
141	        
142	        # Сравниваем и логируем изменения
143	        changes = _diff_dicts(old_data, new_data)
144	        if changes:
145	            logger.info(f"Сохранение конфигурации. Изменения:\n" + "\n".join(changes))
146	        else:
147	            logger.debug("Сохранение конфигурации (без изменений)")
148	        
149	        with open(self.config_path, "w", encoding="utf-8") as f:
150	            yaml.dump(new_data, f, allow_unicode=True, sort_keys=False)
151	
152	    def add_ib(self, ib: IBConfig, overwrite: bool = False):
153	        """Добавить новую ИБ."""
154	        # Проверка дубликатов
155	        for i, existing in enumerate(self.config.ibs):
156	            if existing.name == ib.name:
157	                if not overwrite:
158	                    raise ValueError(f"ИБ с именем {ib.name} уже существует")
159	                # Заменяем существующую
160	                self.config.ibs[i] = ib
161	                self.save()
162	                return
163	
164	        self.config.ibs.append(ib)
165	        self.save()
166	
167	    def remove_ib(self, name: str):
168	        """Удалить ИБ."""
169	        self.config.ibs = [ib for ib in self.config.ibs if ib.name != name]
170	        self.save()
171	
172	    def get_ib(self, name: str) -> IBConfig | None:
173	        """Получить конфиг ИБ по имени."""
174	        for ib in self.config.ibs:
175	            if ib.name == name:
176	                return ib
177	        return None
