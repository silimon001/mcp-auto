434	@mcp.tool()
435	async def build_video(
436	    ctx: Context,
437	    video_path: str,
438	    index_path: str,
439	    codec: str = 'h265',
440	    show_progress: bool = True,
441	    auto_build_docker: bool = True,
442	    allow_fallback: bool = True
443	) -> dict[str, Any]:
444	    """Build the video memory from the added chunks.
445	
446	    Args:
447	        video_path: The path to save the video file (relative paths use library directory).
448	        index_path: The path to save the index file (relative paths use library directory).
449	        codec: Video codec to use ('h265' or 'h264', default: 'h265').
450	        show_progress: Whether to show progress during build (default: True).
451	        auto_build_docker: Whether to auto-build docker if needed (default: True).
452	        allow_fallback: Whether to allow fallback options (default: True).
453	
454	    Returns:
455	        Status dictionary with success/error information.
456	    """
457	    try:
458	        encoder = await _ensure_encoder()
459	
460	        # Resolve paths using library directory for relative paths
461	        resolved_video_path = _server_state.resolve_file_path(video_path, "video")
462	        resolved_index_path = _server_state.resolve_file_path(index_path, "index")
463	
464	        # Call build_video with stdout redirected to prevent progress bars
465	        with redirect_stdout(sys.stderr):
466	            build_result = encoder.build_video(
467	                output_file=resolved_video_path,
468	                index_file=resolved_index_path,
469	                codec=codec,
470	                show_progress=show_progress,
471	                auto_build_docker=auto_build_docker,
472	                allow_fallback=allow_fallback
473	            )
474	
475	        # Initialize retriever and chat with stdout redirected
476	        if MemvidRetriever and MemvidChat:
477	            try:
478	                # Check if MemvidRetriever and MemvidChat are available
479	                if MemvidRetriever is None or MemvidChat is None:
480	                    logger.error("MemvidRetriever or MemvidChat is not available")
481	                    return {
482	                        "status": "partial_success",
483	                        "video_path": resolved_video_path,
484	                        "index_path": resolved_index_path,
485	                        "codec": codec,
486	                        "build_result": build_result,
487	                        "warning": "Video built but MemvidRetriever/Chat not available for initialization"
488	                    }
489	
490	                with redirect_stdout(sys.stderr):
491	                    _server_state.retriever = MemvidRetriever(resolved_video_path, resolved_index_path)
492	                    _server_state.chat = MemvidChat(resolved_video_path, resolved_index_path)
493	
494	                # Update state tracking
495	                _server_state.set_active_memory(resolved_video_path, resolved_index_path)
496	
497	                logger.info(f"Successfully built and loaded video memory: {resolved_video_path}")
498	            except Exception as e:
499	                logger.error(f"Failed to initialize retriever/chat after build: {e}")
500	                # Build succeeded but initialization failed
501	                return {
502	                    "status": "partial_success",
503	                    "video_path": resolved_video_path,
504	                    "index_path": resolved_index_path,
505	                    "codec": codec,
506	                    "build_result": build_result,
507	                    "warning": f"Video built but failed to initialize retriever/chat: {str(e)}"
508	                }
509	
510	        return {
511	            "status": "success",
512	            "video_path": resolved_video_path,
513	            "index_path": resolved_index_path,
514	            "codec": codec,
515	            "build_result": build_result,
516	            "message": "Video memory built and loaded successfully"
517	        }
518	    except Exception as e:
519	        logger.error(f"Failed to build video: {e}")
520	        return {"status": "error", "message": str(e)}
