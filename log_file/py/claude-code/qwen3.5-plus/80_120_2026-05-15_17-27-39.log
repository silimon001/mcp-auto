33	# Redirect stdout for the entire process to prevent any library output
34	class StderrRedirect:
35	    def __init__(self):
36	        self.buffer = sys.stderr.buffer if hasattr(sys.stderr, 'buffer') else None
37	
38	    def write(self, s):
39	        sys.stderr.write(s)
40	
41	    def flush(self):
42	        sys.stderr.flush()
43	
44	    def __getattr__(self, name):
45	        # Delegate any other attributes to stderr
46	        return getattr(sys.stderr, name)
47	
48	# Store original stdout for MCP communication
49	_original_stdout = sys.stdout
50	
51	# DON'T redirect stdout globally - this breaks MCP communication!
52	# Instead, we'll redirect only during specific memvid operations
53	
54	# Import Docker lifecycle manager
55	try:
56	    from .docker_lifecycle import DockerLifecycleManager
57	except ImportError:
58	    # Fallback for direct script execution
59	    from docker_lifecycle import DockerLifecycleManager
60	
