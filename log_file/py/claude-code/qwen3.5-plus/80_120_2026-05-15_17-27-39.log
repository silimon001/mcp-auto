184	@mcp.tool()
185	def update_table_records(
186	    ctx: Context,
187	    table_name: str,
188	    updates: Dict[str, Any],
189	    filters: Dict[str, Any]
190	) -> Dict[str, Any]:
191	    """
192	    Update records in a Supabase table that match the specified filters.
193	    
194	    Use this tool to modify existing data in a specific table in the Supabase database.
195	    You provide the new values and filter conditions to identify which records to update.
196	    
197	    Args:
198	        ctx: The MCP context
199	        table_name: Name of the table to update records in
200	        updates: Dictionary of column-value pairs with the new values
201	        filters: Dictionary of column-value pairs to filter which rows to update
202	        
203	    Returns:
204	        Dictionary containing the updated records and metadata
205	        
206	    Example:
207	        To update all active users' status:
208	            update_table_records(
209	                table_name="users",
210	                updates={"status": "premium"},
211	                filters={"is_active": True}
212	            )
213	    """
214	    supabase = ctx.request_context.lifespan_context.client
215	    
216	    # Start building the query
217	    query = supabase.table(table_name).update(updates)
218	    
219	    # Apply filters
220	    for column, value in filters.items():
221	        query = query.eq(column, value)
222	    
223	    # Execute the query
224	    response = query.execute()
225	    
226	    # Return the response
227	    return {
228	        "data": response.data,
229	        "count": len(response.data) if response.data else 0,
230	        "status": "success" if response.data else "error"
231	    }
