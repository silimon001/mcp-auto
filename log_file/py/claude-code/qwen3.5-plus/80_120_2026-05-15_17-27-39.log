  "content": "#!/usr/bin/env python3\n\"\"\"\nMCP Tasks Organizer Server\nConverts Cursor agent plans into structured markdown task lists.\n\"\"\"\n\nimport os\nimport re\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n\nfrom mcp.server import Server\nfrom mcp.server.stdio import stdio_server\nfrom mcp.types import Tool, TextContent\n\n# Create the server instance\nserver = Server(\"tasks-organizer\")\n\n\ndef get_tasks_dir(repo_path: str) -> Path:\n    \"\"\"Get the .tasks directory in the repository.\"\"\"\n    return Path(repo_path) / \".tasks\"\n\n\ndef ensure_tasks_dir(repo_path: str) -> Path:\n    \"\"\"Ensure the .tasks directory exists.\"\"\"\n    tasks_dir = get_tasks_dir(repo_path)\n    tasks_dir.mkdir(parents=True, exist_ok=True)\n    return tasks_dir\n\n\ndef extract_tasks_from_text(text: str) -> list[str]:\n    \"\"\"Extract tasks from text using various patterns.\"\"\"\n    tasks = []\n\n    # Pattern 1: Numbered steps (1. First step)\n    numbered_pattern = r'^\\d+\\.\\s+(.+)$'\n    for match in re.finditer(numbered_pattern, text, re.MULTILINE):\n        tasks.append(match.group(1).strip())\n\n    # Pattern 2: Bullet points (* Item or - Item)\n    bullet_pattern = r'^[\\*\\-]\\s+(.+)$'\n    for match in re.finditer(bullet_pattern, text, re.MULTILINE):\n        tasks.append(match.group(1).strip())\n\n    # Pattern 3: Task-like sentences with keywords\n    task_keywords = r'^(.+?\\b(should|must|need to|ought to|will|shall)\\b.+?)$'\n    for match in re.finditer(task_keywords, text, re.MULTILINE | re.IGNORECASE):\n        task_text = match.group(1).strip()\n        if task_text and task_text not in tasks:\n            tasks.append(task_text)\n\n    return tasks\n\n\ndef format_task_list(title: str, tasks: list[str], include_metadata: bool = True) -> str:\n    \"\"\"Format a task list as markdown.\"\"\"\n    lines = [f\"# {title}\", \"\"]\n\n    if include_metadata:\n        lines.append(f\"**Created:** {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n        lines.append(\"\")\n\n    lines.append(\"## Tasks\")\n    lines.append(\"\")\n\n    for i, task in enumerate(tasks, 1):\n        lines.append(f\"- [ ] {task}\")\n\n    lines.append(\"\")\n    lines.append(\"## Implementation Details\")\n    lines.append(\"\")\n    lines.append(\"Add implementation notes here.\")\n    lines.append(\"\")\n    lines.append(\"## Next Steps\")\n    lines.append(\"\")\n    lines.append(\"Track upcoming tasks and recommendations.\")\n\n    return \"\\n\".join(lines)\n\n\ndef find_task_file(description: str, repo_path: str) -> Path | None:\n    \"\"\"Find a task file by description.\"\"\"\n    tasks_dir = ensure_tasks_dir(repo_path)\n\n    # Try exact match first\n    exact_match = tasks_dir / f\"{description}.md\"\n    if exact_match.exists():\n        return exact_match\n\n    # Try with checkmark prefix\n    checked_match = tasks_dir / f\"✅{description}.md\"\n    if checked_match.exists():\n        return checked_match\n\n    # Search for partial match\n    for f in tasks_dir.glob(\"*.md\"):\n        if description.lower() in f.stem.lower():\n            return f\n\n    return None\n\n\n@server.list_tools()\nasync def list_tools() -> list[Tool]:\n    \"\"\"List available tools.\"\"\"\n    return [\n        Tool(\n            name=\"create_task_list\",\n            description=\"Create a new task list and save it to the .tasks folder.\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"title\": {\"type\": \"string\", \"description\": \"Title for the task list\"},\n                    \"description\": {\"type\": \"string\", \"description\": \"Short 2-3 word description for the filename\"},\n                    \"repo_path\": {\"type\": \"string\", \"description\": \"Path to the repository root\"},\n                    \"include_metadata\": {\"type\": \"boolean\", \"description\": \"Whether to include creation date/time\"}\n                },\n                \"required\": [\"title\", \"description\"]\n            }\n        ),\n        Tool(\n            name=\"convert_plan_to_tasks\",\n            description=\"Convert a Cursor agent's plan text into a formatted Markdown task list.\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"plan_text\": {\"type\": \"string\", \"description\": \"The plan text from the Cursor agent\"},\n                    \"title\": {\"type\": \"string\", \"description\": \"Title for the task list\"},\n                    \"description\": {\"type\": \"string\", \"description\": \"Short 2-3 word description for the filename\"},\n                    \"repo_path\": {\"type\": \"string\", \"description\": \"Path to the repository root\"},\n                    \"include_metadata\": {\"type\": \"boolean\", \"description\": \"Whether to include metadata\"}\n                },\n                \"required\": [\"plan_text\", \"title\", \"description\"]\n            }\n        ),\n        Tool(\n            name=\"add_task\",\n            description=\"Add a new task to an existing task list.\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"description\": {\"type\": \"string\", \"description\": \"The description identifier of the task list file\"},\n                    \"task_text\": {\"type\": \"string\", \"description\": \"Text for the new task\"},\n                    \"repo_path\": {\"type\": \"string\", \"description\": \"Path to the repository root\"},\n                    \"section\": {\"type\": \"string\", \"description\": \"Which section to add the task to\"}\n                },\n                \"required\": [\"description\", \"task_text\"]\n            }\n        ),\n        Tool(\n            name=\"mark_task_complete\",\n            description=\"Mark a specific task as completed.\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"description\": {\"type\": \"string\", \"description\": \"The description identifier of the task list file\"},\n                    \"task_number\": {\"type\": \"integer\", \"description\": \"The number of the task to mark as complete\"},\n                    \"repo_path\": {\"type\": \"string\", \"description\": \"Path to the repository root\"},\n                    \"section\": {\"type\": \"string\", \"description\": \"Which section the task is in\"}\n                },\n                \"required\": [\"description\", \"task_number\"]\n            }\n        ),\n        Tool(\n            name=\"check_all_tasks_complete\",\n            description=\"Check if all tasks are complete and mark the task list as completed.\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"description\": {\"type\": \"string\", \"description\": \"The description identifier of the task list file\"},\n                    \"repo_path\": {\"type\": \"string\", \"description\": \"Path to the repository root\"}\n                },\n                \"required\": [\"description\"]\n            }\n        ),\n        Tool(\n            name=\"list_task_files\",\n            description=\"List all task files in the .tasks directory.\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"repo_path\": {\"type\": \"string\", \"description\": \"Path to the repository root\"},\n                    \"include_completed\": {\"type\": \"boolean\", \"description\": \"Whether to include completed task lists\"}\n                }\n            }\n        )\n    ]\n\n\n@server.call_tool()\nasync def call_tool(name: str, arguments: dict[str, Any]) -> list[TextContent]:\n    \"\"\"Handle tool calls.\"\"\"\n    repo_path = arguments.get(\"repo_path\", os.getcwd())\n\n    if name == \"create_task_list\":\n        title = arguments.get(\"title\", \"Untitled\")\n        description = arguments.get(\"description\", \"untitled\")\n        include_metadata = arguments.get(\"include_metadata\", True)\n\n        tasks_dir = ensure_tasks_dir(repo_path)\n        content = format_task_list(title, [], include_metadata)\n\n        # Sanitize filename\n        filename = re.sub(r'[^a-zA-Z0-9_-]', '-', description.lower())\n        filepath = tasks_dir / f\"{filename}.md\"\n\n        filepath.write_text(content)\n\n        return [TextContent(type=\"text\", text=f\"Created task list: {filepath}\")]\n\n    elif name == \"convert_plan_to_tasks\":\n        plan_text = arguments.get(\"plan_text\", \"\")\n        title = arguments.get(\"title\", \"Untitled\")\n        description = arguments.get(\"description\", \"untitled\")\n        include_metadata = arguments.get(\"include_metadata\", True)\n\n        tasks = extract_tasks_from_text(plan_text)\n\n        if not tasks:\n            # If no tasks found, organize content into sections\n            tasks = [\"Review and understand the plan\", \"Implement changes as described\"]\n\n        tasks_dir = ensure_tasks_dir(repo_path)\n        content = format_task_list(title, tasks, include_metadata)\n\n        # Sanitize filename\n        filename = re.sub(r'[^a-zA-Z0-9_-]', '-', description.lower())\n        filepath = tasks_dir / f\"{filename}.md\"\n\n        filepath.write_text(content)\n\n        return [TextContent(type=\"text\", text=f\"Created task list with {len(tasks)} tasks: {filepath}\")]\n\n    elif name == \"add_task\":\n        description = arguments.get(\"description\", \"\")\n        task_text = arguments.get(\"task_text\", \"\")\n        section = arguments.get(\"section\", \"Tasks\")\n\n        task_file = find_task_file(description, repo_path)\n        if not task_file:\n            return [TextContent(type=\"text\", text=f\"Error: Task file '{description}' not found\")]\n\n        content = task_file.read_text()\n        lines = content.split(\"\\n\")\n\n        # Find the section and add task\n        new_lines = []\n        added = False\n        in_section = False\n\n        for line in lines:\n            new_lines.append(line)\n            if line.strip() == f\"## {section}\":\n                in_section = True\n            elif line.startswith(\"## \") and in_section:\n                # Add task before next section\n                if not added:\n                    new_lines.insert(-1, f\"- [ ] {task_text}\")\n                    added = True\n                in_section = False\n            elif line.startswith(\"## \") and not in_section:\n                pass\n\n        if not added and in_section:\n            new_lines.append(f\"- [ ] {task_text}\")\n\n        task_file.write_text(\"\\n\".join(new_lines))\n\n        return [TextContent(type=\"text\", text=f\"Added task to {task_file}\")]\n\n    elif name == \"mark_task_complete\":\n        description = arguments.get(\"description\", \"\")\n        task_number = arguments.get(\"task_number\", 0)\n        section = arguments.get(\"section\", \"Tasks\")\n\n        task_file = find_task_file(description, repo_path)\n        if not task_file:\n            return [TextContent(type=\"text\", text=f\"Error: Task file '{description}' not found\")]\n\n        content = task_file.read_text()\n        lines = content.split(\"\\n\")\n\n        # Find and mark the task\n        task_count = 0\n        in_section = section == \"Tasks\"\n\n        for i, line in enumerate(lines):\n            if line.strip() == f\"## {section}\":\n                in_section = True\n            elif line.startswith(\"## \"):\n                in_section = False\n\n            if in_section and line.strip().startswith(\"- [ ]\"):\n                task_count += 1\n                if task_count == task_number:\n                    lines[i] = line.replace(\"- [ ]\", \"- [x]\", 1)\n                    break\n\n        task_file.write_text(\"\\n\".join(lines))\n\n        return [TextContent(type=\"text\", text=f\"Marked task {task_number} as complete in {task_file}\")]\n\n    elif name == \"check_all_tasks_complete\":\n        description = arguments.get(\"description\", \"\")\n\n        task_file = find_task_file(description, repo_path)\n        if not task_file:\n            return [TextContent(type=\"text\", text=f\"Error: Task file '{description}' not found\")]\n\n        content = task_file.read_text()\n        lines = content.split(\"\\n\")\n\n        # Check if all tasks are complete\n        all_complete = True\n        has_tasks = False\n\n        for line in lines:\n            if line.strip().startswith(\"- [ ]\"):\n                all_complete = False\n                has_tasks = True\n            elif line.strip().startswith(\"- [x]\"):\n                has_tasks = True\n\n        if all_complete and has_tasks:\n            # Rename with checkmark prefix\n            new_name = task_file.parent / f\"✅{task_file.name}\"\n            if not new_name.exists():\n                task_file.rename(new_name)\n                return [TextContent(type=\"text\", text=f\"All tasks complete! Renamed to {new_name}\")]\n            else:\n                return [TextContent(type=\"text\", text=\"All tasks are already complete!\")]\n        elif not has_tasks:\n            return [TextContent(type=\"text\", text=\"No tasks found in the file\")]\n        else:\n            return [TextContent(type=\"text\", text=\"Not all tasks are complete yet\")]\n\n    elif name == \"list_task_files\":\n        include_completed = arguments.get(\"include_completed\", True)\n\n        tasks_dir = Path(repo_path) / \".tasks\"\n        if not tasks_dir.exists():\n            return [TextContent(type=\"text\", text=\"No .tasks directory found\")]\n\n        files = []\n        for f in tasks_dir.glob(\"*.md\"):\n            if include_completed or not f.stem.startswith(\"✅\"):\n                files.append(f.name)\n\n        if not files:\n            return [TextContent(type=\"text\", text=\"No task files found\")]\n\n        return [TextContent(type=\"text\", text=f\"Task files:\\n\" + \"\\n\".join(f\"- {f}\" for f in files))]\n\n    else:\n        return [TextContent(type=\"text\", text=f\"Error: Unknown tool '{name}'\")]\n\n\nasync def main():\n    \"\"\"Run the MCP server.\"\"\"\n    async with stdio_server() as (read_stream, write_stream):\n        await server.run(\n            read_stream,\n            write_stream,\n            server.create_initialization_options(),\n        )\n\n\nif __name__ == \"__main__\":\n    import asyncio\n    asyncio.run(main())\n"
}
