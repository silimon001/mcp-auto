543	        if not cve_id and len(chunks) > 1:
544	            lines.append(f"📄 Aggregated across {len(chunks)} chunk(s), resultsPerPage={rpp} startIndex={sidx}")
545	
546	        return "\n".join(lines)
547	
548	    except ValueError:
549	        return "❌ Error: changeStartDate and changeEndDate must be valid ISO-8601 timestamps"
550	    except httpx.HTTPStatusError as e:
551	        logger.error(f"HTTP error in cve_change_history: {e.response.status_code}")
552	        return f"❌ API Error: {e.response.status_code}"
553	    except Exception as e:
554	        logger.error("Exception in cve_change_history: " + str(e))
555	        logger.debug(traceback.format_exc())
556	        return f"❌ Error: {str(e)}"
