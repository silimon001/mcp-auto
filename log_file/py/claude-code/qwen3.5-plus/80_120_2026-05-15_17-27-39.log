22	        import mcp.types as types
23	        from mcp.server import NotificationOptions, Server
24	        from mcp.server.models import InitializationOptions
25	    except ImportError as e:
26	        # MCP import failed - exit silently to avoid STDIO corruption
27	        sys.exit(1)
28	
