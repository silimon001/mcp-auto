528	        lines = [f"🕘 CVE Change History - total events: {total}"]
529	        if not changes:
530	            lines.append("⚠️ No change events returned for the given query.")
531	        else:
532	            for ch in changes[:50]:
533	                try:
534	                    change = ch.get("change", {})
535	                    cid = change.get("cveId", "UNKNOWN")
536	                    event = change.get("eventName", "EVENT")
537	                    created = change.get("created", "")
538	                    lines.append(f"- {cid} | event: {event} | at: {created}")
