16	def _diff_dicts(old: dict, new: dict, path: str = "") -> list[str]:
17	    """Рекурсивное сравнение двух словарей, возвращает список изменений."""
18	    changes = []
19	    all_keys = set(old.keys()) | set(new.keys())
20	    
21	    for key in all_keys:
22	        full_path = f"{path}.{key}" if path else key
23	        
24	        if key not in old:
25	            changes.append(f"  + {full_path}: {new[key]}")
26	        elif key not in new:
27	            changes.append(f"  - {full_path}: {old[key]}")
28	        elif old[key] != new[key]:
29	            if isinstance(old[key], dict) and isinstance(new[key], dict):
30	                changes.extend(_diff_dicts(old[key], new[key], full_path))
31	            elif isinstance(old[key], list) and isinstance(new[key], list):
32	                changes.extend(_diff_lists(old[key], new[key], full_path))
33	            else:
34	                changes.append(f"  ~ {full_path}: {old[key]} -> {new[key]}")
35	    
36	    return changes
