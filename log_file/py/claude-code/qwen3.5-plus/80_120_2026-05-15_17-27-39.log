136	        msg_id = messages_list['messages'][0]['id']
137	        message = gmail_service.users().messages().get(userId='me', id=msg_id, format='full').execute()
138	        
139	        email_body = get_email_body(message['payload'])
140	        if not email_body:
141	            email_body = "Could not find the body in the last email."
142	            # raise Exception("Could not find the body in the last email.")
