31	# Utility helpers
32	def _safe_str(s):
33	    """Return safe stripped string"""
34	    try:
35	        return "" if s is None else str(s).strip()
36	    except Exception:
37	        return ""
38	
39	def _int_or_default(s, default=20):
40	    """Convert string to int or default"""
41	    try:
42	        return int(str(s).strip()) if str(s).strip() != "" else default
43	    except Exception:
44	        return default
