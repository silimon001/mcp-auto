1	import os
2	import json
3	from amadeus import Client, ResponseError
4	from dataclasses import dataclass
5	from contextlib import asynccontextmanager
6	from collections.abc import AsyncIterator
7	
8	from mcp.server.fastmcp import FastMCP, Context
9	
10	@dataclass
11	class AppContext:
12	    amadeus_client: Client
13	
14	@asynccontextmanager
15	async def app_lifespan(server: FastMCP) -> AsyncIterator[AppContext]:
16	    """Manage Amadeus client lifecycle"""
17	    api_key = os.environ.get("AMADEUS_API_KEY")
18	    api_secret = os.environ.get("AMADEUS_API_SECRET")
19	
20	    if not api_key or not api_secret:
21	        raise ValueError("AMADEUS_API_KEY and AMADEUS_API_SECRET must be set as environment variables")
22	
23	    amadeus_client = Client(
24	        client_id=api_key,
25	        client_secret=api_secret
26	    )
27	
28	    try:
29	        yield AppContext(amadeus_client=amadeus_client)
30	    finally:
31	        pass
32	
33	mcp = FastMCP("Amadeus API", dependencies=["amadeus"], lifespan=app_lifespan)
34	
35	@mcp.tool()
36	def search_flight_offers(
37	    originLocationCode: str,
38	    destinationLocationCode: str,
39	    departureDate: str,
40	    adults: int,
41	    ctx: Context,
42	    returnDate: str = None,
43	    children: int = None,
44	    infants: int = None,
45	    travelClass: str = None,
46	    includedAirlineCodes: str = None,
47	    excludedAirlineCodes: str = None,
48	    nonStop: bool = None,
49	    currencyCode: str = None,
50	    maxPrice: int = None,
51	    max: int = 250
52	) -> str:
53	    """
54	    Search for flight offers using the Amadeus API
55	
56	    Args:
57	        originLocationCode: IATA code of the departure city/airport (e.g., SYD for Sydney)
58	        destinationLocationCode: IATA code of the destination city/airport (e.g., BKK for Bangkok)
59	        departureDate: Departure date in ISO 8601 format (YYYY-MM-DD, e.g., 2023-05-02)
60	        adults: Number of adult travelers (age 12+), must be 1-9
61	        returnDate: Return date in ISO 8601 format (YYYY-MM-DD), if round-trip is desired
62	        children: Number of child travelers (age 2-11)
63	        infants: Number of infant travelers (age <= 2)
64	        travelClass: Travel class (ECONOMY, PREMIUM_ECONOMY, BUSINESS, FIRST)
65	        includedAirlineCodes: Comma-separated IATA airline codes to include (e.g., '6X,7X')
66	        excludedAirlineCodes: Comma-separated IATA airline codes to exclude (e.g., '6X,7X')
67	        nonStop: If true, only non-stop flights are returned
68	        currencyCode: ISO 4217 currency code (e.g., EUR for Euro)
69	        maxPrice: Maximum price per traveler, positive integer with no decimals
70	        max: Maximum number of flight offers to return
71	    """
72	    if adults and not (1 <= adults <= 9):
73	        return json.dumps({"error": "Adults must be between 1 and 9"})
74	
75	    if children and infants and adults and (adults + children > 9):
76	        return json.dumps({"error": "Total number of seated travelers (adults + children) cannot exceed 9"})
77	
78	    if infants and adults and (infants > adults):
79	        return json.dumps({"error": "Number of infants cannot exceed number of adults"})
80	
81	    amadeus_client = ctx.request_context.lifespan_context.amadeus_client
82	    params = {}
83	    params["originLocationCode"] = originLocationCode
84	    params["destinationLocationCode"] = destinationLocationCode
85	    params["departureDate"] = departureDate
86	    params["adults"] = adults
87	
88	    if returnDate:
89	        params["returnDate"] = returnDate
90	    if children is not None:
91	        params["children"] = children
92	    if infants is not None:
93	        params["infants"] = infants
94	    if travelClass:
95	        params["travelClass"] = travelClass
96	    if includedAirlineCodes:
97	        params["includedAirlineCodes"] = includedAirlineCodes
98	    if excludedAirlineCodes:
99	        params["excludedAirlineCodes"] = excludedAirlineCodes
100	    if nonStop is not None:
101	        params["nonStop"] = nonStop
102	    if currencyCode:
103	        params["currencyCode"] = currencyCode
104	    if maxPrice is not None:
105	        params["maxPrice"] = maxPrice
106	    if max is not None:
107	        params["max"] = max
108	
109	    try:
110	        ctx.info(f"Searching flights from {originLocationCode} to {destinationLocationCode}")
111	        ctx.info(f"API parameters: {json.dumps(params)}")
112	
113	        response = amadeus_client.shopping.flight_offers_search.get(**params)
114	        return json.dumps(response.body)
115	    except ResponseError as error:
116	        error_msg = f"Amadeus API error: {str(error)}"
117	        ctx.info(f"Error: {error_msg}")
118	        return json.dumps({"error": error_msg})
119	    except Exception as e:
120	        error_msg = f"Unexpected error: {str(e)}"
121	        ctx.info(f"Error: {error_msg}")
122	        return json.dumps({"error": error_msg})
123	
124	@mcp.prompt()
125	def flight_search_prompt(origin: str, destination: str, date: str) -> str:
126	    """Create a flight search prompt"""
127	    return f"""
128	    Please search for flights from {origin} to {destination} on {date}.
129	
130	    I'd like to see options sorted by price, with information about the airlines,
131	    departure/arrival times, and any layovers.
132	    """
133	
134	if __name__ == "__main__":
135	    mcp.run()
