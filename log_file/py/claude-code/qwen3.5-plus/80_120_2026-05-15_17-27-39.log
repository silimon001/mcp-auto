46	def _short_desc_from_vuln(v):
47	    """Return a short description for a vuln object"""
48	    try:
49	        cve = v.get("cve", {})
50	        descs = cve.get("descriptions", []) or []
51	        for d in descs:
52	            if d.get("lang") == "en" and d.get("value"):
53	                txt = d.get("value")
54	                return txt if len(txt) <= 240 else txt[:237] + "..."
55	        if descs:
56	            txt = descs[0].get("value", "")
57	            return txt if len(txt) <= 240 else txt[:237] + "..."
58	    except Exception:
59	        pass
60	    return "(no description)"
61	
62	def _format_vuln_entry(v):
63	    """Format a single vulnerability entry for output"""
64	    try:
65	        cve = v.get("cve", {})
66	        cve_id = cve.get("id", "UNKNOWN")
67	        published = _safe_str(cve.get("published"))
68	        desc = _short_desc_from_vuln(v)
69	        return f"- {cve_id} | published: {published} | {desc}"
70	    except Exception:
71	        return "- (malformed entry)"
