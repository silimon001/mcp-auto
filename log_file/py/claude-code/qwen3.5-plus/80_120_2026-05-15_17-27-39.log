1	#!/usr/bin/env python
2	"""
3	Main entry point for the Mem0 MCP Server.
4	This script initializes the server and registers all memory operations.
5	"""
6	import sys
7	import logging
8	from mem0_mcp_server.core.server import setup_server, start_server
9	from mem0_mcp_server.operations.basic import register_basic_operations
10	from mem0_mcp_server.memory_types.short_term import register_short_term_operations
11	from mem0_mcp_server.memory_types.specialized import register_specialized_operations
12	from mem0_mcp_server.advanced.features import register_advanced_features
13	from mem0_mcp_server.advanced.selective import register_selective_operations
14	
15	def main():
16	    """Initialize and start the Mem0 MCP Server."""
17	    # Initialize server
18	    mcp = setup_server()
19	    if not mcp:
20	        logging.critical("Failed to initialize MCP server. Exiting.")
21	        sys.exit(1)
22	    
23	    # Register all operations
24	    if not register_basic_operations():
25	        logging.error("Failed to register basic operations.")
26	    
27	    if not register_short_term_operations():
28	        logging.error("Failed to register short-term memory operations.")
29	    
30	    if not register_specialized_operations():
31	        logging.error("Failed to register specialized memory operations.")
32	    
33	    if not register_advanced_features():
34	        logging.error("Failed to register advanced features.")
35	    
36	    if not register_selective_operations():
37	        logging.error("Failed to register selective memory operations.")
38	    
39	    logging.info("All operations registered. Starting server...")
40	    
41	    # Start the server
42	    start_server()
43	
44	if __name__ == "__main__":
45	    main() 

