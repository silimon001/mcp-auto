335	        ).execute()
336	        
337	        files = results.get('files', [])
338	        if not files:
339	            return []
340	            
341	        return [
342	            ListedDriveFile(
343	                id=file['id'],
344	                name=file['name'],
345	                mime_type=file['mimeType']
346	            ) for file in files
347	        ]
348	    except HttpError as e:
349	        raise Exception(f"API Drive error (HTTP {e.status_code}): {e.reason}")
350	
351	@server.tool()
352	def create_drive_document(ctx: Context, title: str, content: Optional[str] = "") -> Dict[str, str]:
353	    """
354	    Creates a new Google Document in the user's Drive with the given title and content.
355	
356	    Args:
357	        title: The title of the new document.
358	        content: The initial text content for the document.
359	    """
360	    creds = get_creds_from_context(ctx)
361	    try:
362	        drive_service = googleapiclient.discovery.build('drive', 'v3', credentials=creds)
363	        file_metadata = {
364	            'name': title,
365	            'mimeType': 'application/vnd.google-apps.document'
366	        }
367	        
368	        media = MediaIoBaseUpload(io.BytesIO((content or "").encode()), mimetype='text/plain', resumable=True)
369	        file = drive_service.files().create(body=file_metadata, media_body=media, fields='id,name,webViewLink').execute()
370	        return {"status": "Document created", "id": file['id'], "name": file['name'], "link": file['webViewLink']}
371	    except HttpError as e:
372	        raise Exception(f"API Drive error (HTTP {e.status_code}): {e.reason}")
373	
374	@server.tool()
375	def update_drive_document(file_id: str, content: str, ctx: Context) -> Dict[str, str]:
376	    """
377	    Overwrites the content of an existing Google Document.
378	
379	    Args:
380	        file_id: The ID of the document to update.
381	        content: The new text content to write to the document.
382	    """
383	    creds = get_creds_from_context(ctx)
384	    try:
385	        drive_service = googleapiclient.discovery.build('drive', 'v3', credentials=creds)
386	        media = MediaIoBaseUpload(io.BytesIO(content.encode()), mimetype='text/plain', resumable=True)
387	        updated_file = drive_service.files().update(fileId=file_id, media_body=media, fields='id,name').execute()
388	        return {"status": "Document updated", "id": updated_file['id'], "name": updated_file['name']}
389	    except HttpError as e:
390	        raise Exception(f"API Drive error (HTTP {e.status_code}): {e.reason}")
391	
392	# Dangerous. Use with caution.
393	@server.tool()
394	def delete_drive_file(file_id: str, ctx: Context) -> Dict[str, str]:
395	    """
396	    Permanently deletes a file from Google Drive. This action cannot be undone.
397	
398	    Args:
399	        file_id: The ID of the file to delete.
400	    """
401	    creds = get_creds_from_context(ctx)
402	    try:
403	        drive_service = googleapiclient.discovery.build('drive', 'v3', credentials=creds)
404	        drive_service.files().delete(fileId=file_id).execute()
405	        return {"status": f"File with ID '{file_id}' deleted successfully."}
406	    except HttpError as e:
407	        raise Exception(f"API Drive error (HTTP {e.status_code}): {e.reason}")
408	
409	@server.tool()
410	def move_drive_file_to_bin(file_id: str, ctx: Context) -> Dict[str, str]:
411	    """
412	    Moves a file to the Google Drive bin (trash). The file can be restored from the bin later.
413	
414	    Args:
415	        file_id: The ID of the file to move to the bin.
416	    """
417	    creds = get_creds_from_context(ctx)
418	    try:
419	        drive_service = googleapiclient.discovery.build('drive', 'v3', credentials=creds)
420	        
421	        # To move a file to the bin, we update its metadata to set 'trashed' to True.
422	        body = {'trashed': True}
423	        drive_service.files().update(fileId=file_id, body=body).execute()
424	        
425	        return {"status": f"File with ID '{file_id}' moved to bin successfully."}
426	    except HttpError as e:
427	        raise Exception(f"API Drive error (HTTP {e.status_code}): {e.reason}")
428	
429	if __name__ == "__main__":
430	    server.run()

