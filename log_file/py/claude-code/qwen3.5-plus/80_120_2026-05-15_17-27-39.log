14	def load_anthropic_env(env_path: str):
15	    """
16	    加载指定 .env 文件中的 Anthropic 环境变量
17	    """
18	    env_file = Path(env_path)
19	
20	    if not env_file.exists():
21	        raise FileNotFoundError(f".env file not found: {env_file}")
22	
23	    load_dotenv(dotenv_path=env_file, override=True)
24	
25	    required_vars = [
26	        "ANTHROPIC_BASE_URL",
27	        "ANTHROPIC_API_KEY",
28	        "ANTHROPIC_MODEL"
29	    ]
30	
31	    missing = [v for v in required_vars if not os.getenv(v)]
32	
33	    if missing:
34	        raise ValueError(
35	            f"Missing required environment variables: {missing}"
36	        )
37	
38	    print("✅ Anthropic environment loaded")
39	    for var in required_vars:
40	        print(f"{var} = {os.getenv(var)}")
