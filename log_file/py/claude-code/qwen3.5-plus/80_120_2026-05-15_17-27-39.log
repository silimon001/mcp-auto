234	@mcp.tool()
235	def delete_table_records(
236	    ctx: Context,
237	    table_name: str,
238	    filters: Dict[str, Any]
239	) -> Dict[str, Any]:
240	    """
241	    Delete records from a Supabase table that match the specified filters.
242	    
243	    Use this tool to remove data from a specific table in the Supabase database.
244	    You provide filter conditions to identify which records to delete.
245	    
246	    Args:
247	        ctx: The MCP context
248	        table_name: Name of the table to delete records from
249	        filters: Dictionary of column-value pairs to filter which rows to delete
250	        
251	    Returns:
252	        Dictionary containing the deleted records and metadata
253	        
254	    Example:
255	        To delete inactive users:
256	            delete_table_records(
257	                table_name="users",
258	                filters={"is_active": False}
259	            )
260	    """
261	    supabase = ctx.request_context.lifespan_context.client
262	    
263	    # Start building the query
264	    query = supabase.table(table_name).delete()
265	    
266	    # Apply filters
267	    for column, value in filters.items():
268	        query = query.eq(column, value)
269	    
270	    # Execute the query
271	    response = query.execute()
272	    
273	    # Return the response
274	    return {
275	        "data": response.data,
276	        "count": len(response.data) if response.data else 0,
277	        "status": "success" if response.data else "error"
278	    }
