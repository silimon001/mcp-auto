loop 18 | Tool=Edit, Args={"replace_all":false,"file_path":"/home/silimon/MCP-Auto/mcp_server/958964868_arjunprabhulal_mcp-flight-search/mcp_flight_search/utils/logging.py","old_string":"def setup_logging():\n    \"\"\"Configure and set up logging for the application.\"\"\"\n    logging.basicConfig(\n        level=logging.DEBUG,\n        format=\"| %(levelname)-8s | %(name)s | %(message)s\",\n        datefmt=\"[%Y-%m-%d %H:%M:%S]\",\n        handlers=[RichHandler(rich_tracebacks=True)],\n        force=True  # This is the fix that overrides uvicorn & third-party loggers\n    )\n\n    logger = logging.getLogger(\"flight_search\")\n    logging.getLogger(\"uvicorn.access\").setLevel(logging.INFO)\n    logging.getLogger(\"uvicorn.error\").setLevel(logging.INFO)\n    logging.getLogger(\"httpx\").setLevel(logging.WARNING)\n    \n    return logger","new_string":"def setup_logging():\n    \"\"\"Configure and set up logging for the application.\"\"\"\n    logging.basicConfig(\n        level=logging.DEBUG,\n        format=\"| %(levelname)-8s | %(name)s | %(message)s\",\n        datefmt=\"[%Y-%m-%d %H:%M:%S]\",\n        handlers=[RichHandler(rich_tracebacks=True, show_path=False)],\n        force=True  # This is the fix that overrides uvicorn & third-party loggers\n    )\n\n    logger = logging.getLogger(\"flight_search\")\n    logging.getLogger(\"uvicorn.access\").setLevel(logging.INFO)\n    logging.getLogger(\"uvicorn.error\").setLevel(logging.INFO)\n    logging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\n    # Redirect all logging to stderr to avoid interfering with MCP stdio protocol\n    for handler in logging.root.handlers:\n        handler.stream = logging._stderr  # type: ignore\n\n    return logger"}
