gs, **kwargs):\n            return _DummyWindow()\n        def descendants(self, *args, **kwargs):\n            return []\n        def children(self, *args, **kwargs):\n            return []\n        def close(self):\n            pass\n        def wrapper_object(self):\n            return _DummyWrapper()\n        def class_name(self):\n            return \"\"\n        def texts(self):\n            return []\n        def rectangle(self):\n            return type(\"Rect\", (), {\"height\": 0, \"width\": lambda: 0})()\n\n    class _DummyWrapper:\n        def set_edit_text(self, text):\n            pass\n        def click_input(self):\n            pass\n        def is_visible(self):\n            return False\n        def is_editable(self):\n            return False\n        def rectangle(self):\n            return type(\"Rect\", (), {\"height\": 0, \"width\": lambda: 0})()\n        def texts(self):\n            return []\n        def window_text(self):\n            return \"\"\n        def class_name(self):\n            return \"\"\n        def exists(self, timeout=0):\n            return False\n\n    class _Timings:\n        @staticmethod\n        def slow():\n            pass\n\n    class _TimeoutError(Exception):\n        pass\n\n    _pwa.Application = _Application\n    _pwa.timings = types.ModuleType(\"pywinauto.timings\")\n    _pwa.timings.Timings = _Timings\n    _pwa.timings.TimeoutError = _TimeoutError\n    _pwa.base_wrapper = types.ModuleType(\"pywinauto.base_wrapper\")\n    _pwa.base_wrapper.BaseWrapper = object\n\n    _uia = types.ModuleType(\"pywinauto.controls.uia_controls\")\n    _uia.WindowSpecification = object\n\n    sys.modules[\"pywinauto\"] = _pwa\n    sys.modules[\"pywinauto.timings\"] = _pwa.timings\n    sys.modules[\"pywinauto.base_wrapper\"] = _pwa.base_wrapper\n    sys.modules[\"pywinauto.controls\"] = types.ModuleType(\"pywinauto.controls\")\n    sys.modules[\"pywinauto.controls.uia_controls\"] = _uia\n\n# --- Now import and run the actual MCP server ---\nfrom mcp_server import mcp\n\nif __name__ == \"__main__\":\n    mcp.run()\n"}
