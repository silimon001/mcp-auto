714	
715	    Args:
716	        script: The Lua script to execute
717	
718	    Returns:
719	        The result of the script execution
720	    """
721	    if not resolve_api.is_connected():
722	        return "Error: Not connected to DaVinci Resolve."
723	
724	    if not resolve_api.fusion:
725	        return "Fusion is not available."
726	
727	    try:
