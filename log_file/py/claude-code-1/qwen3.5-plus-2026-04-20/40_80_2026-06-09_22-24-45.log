1	from mcp.server.fastmcp import FastMCP
2	from parser import LawLibrary
3	import json
4	from config import settings
5	
6	mcp = FastMCP("deutsche-gesetze-mcp", stateless_http=True, host='0.0.0.0', port=8001, debug=True)
7	
8	LAWS = []
9	
10	library = LawLibrary()
11	
12	# Load multiple laws
13	if settings.load_from_folder:
14	    library.load_laws_from_folder(settings.load_from_folder)
15	elif settings.load_from_github:
16	    library.load_laws_from_github(settings.load_from_github)
17	else:
18	    ValueError('No law source provided')
19	
20	
21	@mcp.tool()
22	def get_lawlibrary(law: str | None = None) -> str:
23	    """Get a list of available german laws. If `law` is provided, list 
24	    all laws with similar names."""
25	    if len(library.laws) > 50:
26	        return 'Es sind mehr als 50 Gesetze in der Datenbank. Um nach einem Gesetz zu suchen' \
27	                'übergebe ein Gesetzeskürzel (EStG, HGB, etc ...) als `law` Parameter.'
28	    
29	    laws = library.get_available_laws_json(law)
30	    laws = json.dumps(laws)
31	    return laws
32	
33	@mcp.tool()
34	def get_paragraph(law: str, paragraph: str) -> str:
35	    """Get the content of a paragraph of a german law. 
36	    Example values:
37	    - law: BGB, HGB, SGB 5, etc ...
38	    - paragraph: 2, 14a, etc ...
39	    """
40	    text = library.get_json(law, paragraph)
41	    return text
42	
43	@mcp.tool()
44	def search_laws(query: str, laws: list[str] | None = None) -> str:
45	    """Fulltext search over all laws or a specific list of laws.
46	    
47	    Args:
48	        query: The search query (e.g. "Schadensersatz", "Kündigung").
49	        laws: Optional list of law codes to filter by (e.g. ["BGB", "HGB"]).
50	    """
51	    normalized_laws = None
52	    if laws:
53	        normalized_laws = []
54	        for law in laws:
55	            law_lower = law.strip().lower()
56	            if law_lower not in library.laws:
57	                available = library.get_available_laws_json(law)
58	                return f"Law '{law}' not available. Available laws: {available}"
59	            normalized_laws.append(law_lower)
60	            
61	    results = library.search(query, normalized_laws)
62	    return json.dumps(results, ensure_ascii=False, indent=2)
63	
64	
65	if __name__ == "__main__":
66	    mcp.run(transport="streamable-http")
