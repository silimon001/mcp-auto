1	import argparse
2	import http.client
3	import json
4	import os
5	import sys
6	
7	from fastmcp import FastMCP
8	
9	# The log_level is necessary for Cline to work: https://github.com/jlowin/fastmcp/issues/81
10	mcp = FastMCP("github.com/flankerhqd/jeb-pro-mcp")
11	
12	jsonrpc_request_id = 1
13	
14	
15	def make_jsonrpc_request(method: str, *params):
16	    """Make a JSON-RPC request to the JEB plugin"""
17	    global jsonrpc_request_id
18	    conn = http.client.HTTPConnection("localhost", 16161)
19	    request = {
20	        "jsonrpc": "2.0",
21	        "method": method,
22	        "params": list(params),
23	        "id": jsonrpc_request_id,
24	    }
25	    jsonrpc_request_id += 1
26	
27	    try:
28	        conn.request(
29	            "POST",
30	            "/mcp",
31	            json.dumps(request),
32	            {"Content-Type": "application/json"},
33	        )
34	        response = conn.getresponse()
35	        data = json.loads(response.read().decode())
36	
37	        if "error" in data:
38	            error = data["error"]
39	            code = error["code"]
40	            message = error["message"]
41	
42	            if code == -1:
43	                raise Exception(message)
44	            else:
45	                pretty = f"JSON-RPC error {code}: {message}"
46	                if "data" in error:
47	                    pretty += "\n" + error["data"]
48	                raise Exception(pretty)
49	
50	        result = data["result"]
51	        return result
52	    except Exception:
53	        raise
54	    finally:
55	        conn.close()
56	
57	
58	@mcp.tool()
59	def check_connection() -> str:
60	    """Check if the JEB plugin is running"""
61	    try:
62	        metadata = make_jsonrpc_request("ping")
63	        return "Successfully connected to JEB Pro"
64	    except Exception:
65	        if sys.platform == "darwin":
66	            shortcut = "Ctrl+Option+M"
67	        else:
68	            shortcut = "Ctrl+Alt+M"
69	        return f"Failed to connect to JEB Pro! Did you run Edit -> Scripts -> MCP ({shortcut}) to start the server?"
70	
71	
72	SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
73	JEB_PLUGIN_PY = os.path.join(SCRIPT_DIR, "MCP.py")
74	GENERATED_PY = os.path.join(SCRIPT_DIR, "server_generated.py")
75	
76	
77	def generate():
78	    with open(GENERATED_PY, "r", encoding="utf8") as f:
79	        code = f.read()
80	        exec(compile(code, GENERATED_PY, "exec"))
81	
82	
83	generate()
84	
85	
86	def main():
87	    argparse.ArgumentParser(description="JEB Pro MCP Server")
88	    mcp.run(transport="stdio")
89	
90	
