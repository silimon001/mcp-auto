214	                        target_dir=str(attachment_dir)
215	                    )
216	                    details['attachments_downloaded'] = True
217	                    details['attachment_dir'] = str(attachment_dir)
218	                emails.append(details)
219	        
220	        return {
221	            "success": True,
222	            "message": f"Retrieved {len(emails)} latest emails",
223	            "emails": emails,
