540	def create_fusion_node(node_type: str, parameters: Dict[str, Any] = None) -> str:
541	    """
542	    Create a Fusion node in the current composition.
543	
544	    Args:
545	        node_type: The type of node to create (e.g., 'Blur', 'ColorCorrector', 'Text')
546	        parameters: Optional dictionary of parameters to set on the node
