122	def get_smtp_info() -> tuple[str, int] | tuple[None, None]:
123	    """Get the SMTP server address and port from the configuration based on the sender's email domain name.
124	
125	    Returns:
126	        tuple[str, int] | tuple[None, None]: Returns the matching SMTP server address and port; if not found, returns (None, None).
127	    """
128	    # Extract the domain name part of the sender's email
129	    domain = f"@{sender.split('@')[1]}"
130	
131	    # Traverse the configuration and find the matching domain name
132	    for config in email_config:
133	        if config.get("domain") == domain:
134	            return config.get("server"), config.get("port")
135	
136	    # No matching configuration found
137	    return None, None
