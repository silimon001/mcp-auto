1	from typing import Any, List, Dict, Optional, Union
2	import asyncio
3	import logging
4	from mcp.server.fastmcp import FastMCP
5	from pubmed_web_search import search_key_words, search_advanced, get_pubmed_metadata, download_full_text_pdf, deep_paper_analysis
6	
7	# Set up logging
8	logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
9	
10	# Initialize FastMCP server
11	mcp = FastMCP("pubmed")
12	
13	@mcp.tool()
14	async def search_pubmed_key_words(key_words: str, num_results: int = 10) -> List[Dict[str, Any]]:
15	    logging.info(f"Searching for articles with key words: {key_words}, num_results: {num_results}")
16	    """
17	    Search for articles on PubMed using key words.
18	
19	    Args:
20	        key_words: Search query string
21	        num_results: Number of results to return (default: 10)
22	
23	    Returns:
24	        List of dictionaries containing article information
25	    """
26	    try:
27	        results = await asyncio.to_thread(search_key_words, key_words, num_results)
28	        return results
29	    except Exception as e:
30	        return [{"error": f"An error occurred while searching: {str(e)}"}]
31	
32	@mcp.tool()
33	async def search_pubmed_advanced(
34	    term: Optional[str] = None,
35	    title: Optional[str] = None,
36	    author: Optional[str] = None,
37	    journal: Optional[str] = None,
38	    start_date: Optional[str] = None,
39	    end_date: Optional[str] = None,
40	    num_results: int = 10
41	) -> List[Dict[str, Any]]:
42	    logging.info(f"Performing advanced search with parameters: {locals()}")
43	    """
44	    Perform an advanced search for articles on PubMed.
45	
46	    Args:
47	        term: General search term
48	        title: Search in title
49	        author: Author name
50	        journal: Journal name
51	        start_date: Start date for search range (format: YYYY/MM/DD)
52	        end_date: End date for search range (format: YYYY/MM/DD)
53	        num_results: Number of results to return (default: 10)
54	
55	    Returns:
56	        List of dictionaries containing article information
57	    """
58	    try:
59	        results = await asyncio.to_thread(
60	            search_advanced,
61	            term, title, author, journal, start_date, end_date, num_results
62	        )
63	        return results
64	    except Exception as e:
65	        return [{"error": f"An error occurred while performing advanced search: {str(e)}"}]
66	
67	@mcp.tool()
68	async def get_pubmed_article_metadata(pmid: Union[str, int]) -> Dict[str, Any]:
69	    logging.info(f"Fetching metadata for PMID: {pmid}")
70	    """
71	    Fetch metadata for a PubMed article using its PMID.
72	
73	    Args:
74	        pmid: PMID of the article (can be string or integer)
75	
76	    Returns:
77	        Dictionary containing article metadata
78	    """
79	    try:
80	        pmid_str = str(pmid)
81	        metadata = await asyncio.to_thread(get_pubmed_metadata, pmid_str)
82	        return metadata if metadata else {"error": f"No metadata found for PMID: {pmid_str}"}
83	    except Exception as e:
84	        return {"error": f"An error occurred while fetching metadata: {str(e)}"}
85	
86	@mcp.tool()
87	async def download_pubmed_pdf(pmid: Union[str, int]) -> str:
88	    logging.info(f"Attempting to download PDF for PMID: {pmid}")
89	    """
90	    Attempt to download the full text PDF for a PubMed article.
91	
92	    Args:
93	        pmid: PMID of the article (can be string or integer)
94	
95	    Returns:
96	        String indicating the result of the download attempt
97	    """
98	    try:
99	        pmid_str = str(pmid)
100	        result = await asyncio.to_thread(download_full_text_pdf, pmid_str)
101	        return result
102	    except Exception as e:
103	        return f"An error occurred while attempting to download the PDF: {str(e)}"
104	
105	@mcp.prompt()
106	async def deep_paper_analysis(pmid: Union[str, int]) -> Dict[str, str]:
107	    logging.info(f"Performing deep paper analysis for PMID: {pmid}")
108	    """
109	    Perform a comprehensive analysis of a PubMed article.
110	
111	    Args:
112	        pmid: PMID of the article
113	
114	    Returns:
115	        Dictionary containing the comprehensive analysis structure
116	    """
117	    try:
118	        pmid_str = str(pmid)
119	        metadata = await asyncio.to_thread(get_pubmed_metadata, pmid_str)
120	        if not metadata:
121	            return {"error": f"No metadata found for PMID: {pmid_str}"}
122	            
123	        # 使用导入的 deep_paper_analysis 函数生成分析提示
124	        # 为避免递归调用，我们需要明确指定导入的函数
125	        from pubmed_web_search import deep_paper_analysis as web_deep_paper_analysis
126	        analysis_prompt = await asyncio.to_thread(web_deep_paper_analysis, metadata)
127	        
128	        # 返回包含分析提示的字典
129	        return {"analysis_prompt": analysis_prompt}
130	    except Exception as e:
131	        return {"error": f"An error occurred while performing the deep paper analysis: {str(e)}"}
132	
133	if __name__ == "__main__":
134	    logging.info("Starting PubMed MCP server")
