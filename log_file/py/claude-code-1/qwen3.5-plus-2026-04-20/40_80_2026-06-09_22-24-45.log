96	            if smtp_port != 465:
97	                server.starttls()  # Enable TLS for non-SSL connections
98	            
99	            # Login and send
100	            server.login(sender, password)
101	            server.send_message(email_message)
102	            
103	        return f"Email sent successfully from {sender}"
104	
105	    except smtplib.SMTPAuthenticationError:
106	        raise ValueError("Authentication failed - check username and password")
107	    
108	    except smtplib.SMTPServerDisconnected:
109	        raise ConnectionError("Server disconnected unexpectedly")
110	    
111	    except smtplib.SMTPException as e:
112	        raise smtplib.SMTPException(f"SMTP error occurred: {str(e)}")
113	    
114	    except TimeoutError:
