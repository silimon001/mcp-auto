1	"""Cinema 4D MCP Server."""
2	
3	import socket
4	import json
5	import math
6	import time
7	from dataclasses import dataclass
8	from typing import Any, Dict, List, Optional
9	from contextlib import asynccontextmanager
10	
11	from mcp.server.fastmcp import FastMCP, Context
12	
13	from .config import C4D_HOST, C4D_PORT
14	from .utils import logger, check_c4d_connection
15	
16	
17	@dataclass
18	class C4DConnection:
19	    sock: Optional[socket.socket] = None
20	    connected: bool = False
21	
22	
23	# Asynchronous context manager for Cinema 4D connection
24	@asynccontextmanager
25	async def c4d_connection_context():
26	    """Asynchronous context manager for Cinema 4D connection."""
27	    connection = C4DConnection()
28	    try:
29	        # Initialize connection to Cinema 4D
30	        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
31	        sock.connect((C4D_HOST, C4D_PORT))
32	        connection.sock = sock
33	        connection.connected = True
34	        logger.info(f"✅ Connected to Cinema 4D at {C4D_HOST}:{C4D_PORT}")
35	        yield connection  # Yield the connection
36	    except Exception as e:
37	        logger.error(f"❌ Failed to connect to Cinema 4D: {str(e)}")
38	        connection.connected = False  # Ensure connection is marked as not connected
39	        yield connection  # Still yield the connection object
40	    finally:
41	        # Clean up on server shutdown
42	        if connection.sock:
43	            connection.sock.close()
44	            logger.info("🔌 Disconnected from Cinema 4D")
45	
46	
47	def send_to_c4d(connection: C4DConnection, command: Dict[str, Any]) -> Dict[str, Any]:
48	    """Send a command to Cinema 4D and get the response with improved timeout handling."""
49	    if not connection.connected or not connection.sock:
50	        return {"error": "Not connected to Cinema 4D"}
51	
52	    # Set appropriate timeout based on command type
53	    command_type = command.get("command", "")
54	
55	    # Long-running operations need longer timeouts
56	    if command_type in [
57	        "render_frame",
58	        "render_preview",
59	        "snapshot_scene",
60	        "apply_mograph_fields",
61	        "execute_python",
62	    ]:
63	        timeout = 120  # 2 minutes for render and heavy script operations
64	        logger.info(f"Using extended timeout ({timeout}s) for {command_type}")
65	    else:
66	        timeout = 20  # Default timeout for regular operations
67	
68	    try:
69	        # Convert command to JSON and send it
70	        command_json = json.dumps(command) + "\n"  # Add newline as message delimiter
71	        logger.debug(f"Sending command: {command_type}")
72	        connection.sock.sendall(command_json.encode("utf-8"))
73	
74	        # Set socket timeout
75	        connection.sock.settimeout(timeout)
76	
77	        # Receive response
78	        response_data = b""
79	        start_time = time.time()
80	        max_time = start_time + timeout
81	
82	        # Log for long-running operations
83	        if command_type in [
84	            "render_frame",
85	            "render_preview",
86	            "snapshot_scene",
87	            "apply_mograph_fields",
88	            "execute_python",
89	        ]:
90	            logger.info(
91	                f"Waiting for response from {command_type} (timeout: {timeout}s)"
92	            )
93	
94	        while time.time() < max_time:
95	            try:
96	                chunk = connection.sock.recv(4096)
97	                if not chunk:
98	                    # If we receive an empty chunk, the connection might be closed
99	                    if not response_data:
100	                        logger.error(
101	                            f"Connection closed by Cinema 4D during {command_type}"
102	                        )
103	                        return {
104	                            "error": f"Connection closed by Cinema 4D during {command_type}"
105	                        }
106	                    break
107	
108	                response_data += chunk
109	
110	                # For long operations, log progress on data receipt
111	                elapsed = time.time() - start_time
112	                if (
113	                    command_type
114	                    in [
115	                        "render_frame",
116	                        "render_preview",
117	                        "snapshot_scene",
118	                        "apply_mograph_fields",
119	                        "execute_python",
120	                    ]
121	                    and elapsed > 5
122	                ):
123	                    logger.debug(
124	                        f"Received partial data for {command_type} ({len(response_data)} bytes, {elapsed:.1f}s elapsed)"
125	                    )
126	
127	                if b"\n" in chunk:  # Message complete when we see a newline
128	                    logger.debug(f"Received complete response for {command_type}")
129	                    break
130	
131	            except socket.timeout:
132	                logger.error(f"Socket timeout while receiving data for {command_type}")
133	                return {
134	                    "error": f"Timeout waiting for response from Cinema 4D ({timeout}s) for {command_type}"
135	                }
136	
137	        # Parse and return response
138	        if not response_data:
139	            logger.error(f"No response received from Cinema 4D for {command_type}")
140	            return {"error": f"No response received from Cinema 4D for {command_type}"}
141	
142	        response_text = response_data.decode("utf-8").strip()
143	
144	        try:
145	            return json.loads(response_text)
146	        except json.JSONDecodeError as e:
147	            # If JSON parsing fails, log the exact response for debugging
148	            logger.error(f"Failed to parse JSON response: {str(e)}")
149	            logger.error(f"Raw response (first 200 chars): {response_text[:200]}...")
150	            return {"error": f"Invalid response from Cinema 4D: {str(e)}"}
151	
152	    except socket.timeout:
153	        logger.error(f"Socket timeout during {command_type} ({timeout}s)")
154	        return {
155	            "error": f"Timeout communicating with Cinema 4D ({timeout}s) for {command_type}"
156	        }
157	    except Exception as e:
158	        logger.error(f"Communication error during {command_type}: {str(e)}")
159	        return {"error": f"Communication error: {str(e)}"}
160	
