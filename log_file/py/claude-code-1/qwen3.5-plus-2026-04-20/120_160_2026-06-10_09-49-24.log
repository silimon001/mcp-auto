30	        "private_key_path": str(config_dir / "AuthKey_XXXXXXXX.p8"),
31	    }
32	
33	    with open(config_file, "w") as f:
34	        json.dump(sample_config, f, indent=2)
35	
36	    print(f"Created config file: {config_file}")
