736	async def main():
737	    """Main entry point for the MCP server."""
738	    try:
739	        # Load configuration
740	        config = ServerConfig.from_env()
741	        
742	        # Set log level
743	        logger.setLevel(getattr(logging, config.log_level.upper()))
744	        
745	        logger.info("Starting Payload MCP Server")
746	        
747	        # Initialize client and test connection during server startup
748	        try:
749	            await initialize_client(config)
750	        except Exception as e:
751	            logger.error(f"Failed to initialize client during server startup: {str(e)}")
752	            # Continue with server startup even if client initialization fails
753	        
754	        # Run the server
755	        async with stdio_server() as (read_stream, write_stream):
756	            await server.run(
757	                read_stream,
758	                write_stream,
759	                InitializationOptions(
760	                    server_name="payload-mcp-server",
761	                    server_version="0.1.0",
762	                    capabilities=server.get_capabilities(
763	                        notification_options=NotificationOptions(),
764	                        experimental_capabilities={},
765	                    )
766	                )
767	            )
768	    except ConfigurationError as e:
769	        logger.error(f"Configuration error: {e.message}")
770	        sys.exit(1)
771	    except KeyboardInterrupt:
772	        logger.info("Server stopped by user")
773	    except Exception as e:
774	        logger.exception(f"Server error: {str(e)}")
775	        sys.exit(1)
776	
777	
778	if __name__ == "__main__":
779	    asyncio.run(main())
