1073	def start_sse_server(port: int, debug: bool) -> int:
1074	    """
1075	    Start the server with SSE transport for web/Claude Desktop usage.
1076	    
1077	    Args:
1078	        port: Port number to listen on
1079	        debug: Enable debug mode
1080	        
1081	    Returns:
