51	    CATALOG_ID = "catalog_id"  # All digits, 9+ chars: "1440783617"
52	    LIBRARY_ID = "library_id"  # Starts with "i.": "i.ABC123"
53	    PLAYLIST_ID = "playlist_id"  # Starts with "p.": "p.ABC123"
54	    ALBUM_ID = "album_id"  # Starts with "l.": "l.ABC123"
55	    PERSISTENT_ID = "persistent_id"  # 12+ hex chars: "ABC123DEF456"
56	    NAME = "name"  # Plain name to search for
57	    JSON_OBJECT = "json_object"  # From JSON array
58	
59	
60	@dataclass
61	class ResolvedInput:
62	    """Result of resolving a user input to an entity reference."""
63	
64	    input_type: InputType
65	    value: str  # The ID or name
66	    artist: str = ""  # Artist hint for disambiguation
67	    raw: str = ""  # Original input string
