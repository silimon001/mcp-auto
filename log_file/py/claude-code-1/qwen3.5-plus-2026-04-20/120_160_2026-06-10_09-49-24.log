1084	    import uvicorn
1085	    from mcp.server.sse import SseServerTransport
1086	    from starlette.applications import Starlette
1087	    from starlette.routing import Mount, Route
1088	
1089	    # Create SSE transport handler
1090	    sse_transport = SseServerTransport("/messages/")
1091	
1092	    async def handle_sse_connection(request):
1093	        """Handle incoming SSE connections."""
1094	        async with sse_transport.connect_sse(
1095	            request.scope, request.receive, request._send
1096	        ) as streams:
1097	            await kali_server.run(
1098	                streams[0], streams[1], kali_server.create_initialization_options()
1099	            )
1100	
1101	    # Configure Starlette routes
1102	    starlette_app = Starlette(
1103	        debug=debug,
1104	        routes=[
1105	            Route("/sse", endpoint=handle_sse_connection),
1106	            Mount("/messages/", app=sse_transport.handle_post_message),
1107	        ],
1108	    )
1109	
1110	    # Run the server
1111	    print(f"Starting Kali MCP Server with SSE transport on port {port}")
1112	    print(f"Connect to this server using: http://localhost:{port}/sse")
1113	    uvicorn.run(starlette_app, host="0.0.0.0", port=port)
