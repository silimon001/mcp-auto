104	def to_pretty_json(data: Any) -> str:
105	    """Render resource content as stable, readable JSON."""
106	    return json.dumps(data, indent=2, sort_keys=True, default=str)
107	
108	
109	def json_resource(data: Any, meta: Optional[Dict[str, Any]] = None) -> List[ResourceContent]:
110	    """Build JSON-typed resource contents for the MCP low-level server."""
111	    return [ResourceContent(content=to_pretty_json(data), mime_type="application/json", meta=meta)]
112	
113	
114	def get_query_value(query: Dict[str, List[str]], key: str, alias: Optional[str] = None) -> Optional[str]:
115	    """Return the last value for a query parameter."""
116	    values = query.get(key)
117	    if not values and alias:
118	        values = query.get(alias)
119	    if not values:
120	        return None
121	    return values[-1]
122	
123	
124	def parse_json_param(query: Dict[str, List[str]], key: str) -> Optional[Dict[str, Any]]:
125	    """Parse a JSON object query parameter."""
126	    raw_value = get_query_value(query, key)
127	    if raw_value is None:
128	        return None
129	
130	    try:
131	        parsed = json.loads(raw_value)
132	    except json.JSONDecodeError as exc:
133	        raise ValueError(f"Query parameter '{key}' must be valid JSON") from exc
134	
135	    if not isinstance(parsed, dict):
136	        raise ValueError(f"Query parameter '{key}' must decode to a JSON object")
137	
138	    return parsed
139	
140	
141	def parse_int_param(query: Dict[str, List[str]], key: str, alias: Optional[str] = None) -> Optional[int]:
142	    """Parse an integer query parameter."""
143	    raw_value = get_query_value(query, key, alias)
144	    if raw_value is None:
145	        return None
146	
147	    try:
148	        return int(raw_value)
149	    except ValueError as exc:
150	        raise ValueError(f"Query parameter '{key}' must be an integer") from exc
151	
152	
153	def parse_bool_param(query: Dict[str, List[str]], key: str) -> Optional[bool]:
154	    """Parse a boolean query parameter."""
155	    raw_value = get_query_value(query, key)
156	    if raw_value is None:
157	        return None
158	
159	    normalized = raw_value.strip().lower()
160	    if normalized in {"true", "1", "yes", "on"}:
161	        return True
162	    if normalized in {"false", "0", "no", "off"}:
163	        return False
164	    raise ValueError(f"Query parameter '{key}' must be a boolean")
165	
166	
167	def parse_json_tool_argument(
168	    value: Any,
169	    *,
170	    field_name: str,
171	    allowed_types: tuple[type, ...],
172	) -> Any:
173	    """Accept native JSON-like values or JSON-encoded strings for tool arguments."""
174	    if isinstance(value, allowed_types):
175	        return value
176	
177	    if isinstance(value, str):
178	        try:
179	            parsed = json.loads(value)
180	        except json.JSONDecodeError as exc:
181	            raise ValueError(f"{field_name} must be valid JSON") from exc
182	
183	        if isinstance(parsed, allowed_types):
184	            return parsed
185	
186	    allowed_type_names = ", ".join(sorted(t.__name__ for t in allowed_types))
187	    raise ValueError(f"{field_name} must decode to one of: {allowed_type_names}")
