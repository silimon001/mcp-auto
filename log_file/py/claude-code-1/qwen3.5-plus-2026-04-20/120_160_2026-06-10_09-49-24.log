1068	@mcp.tool()
1069	async def execute_python_script(script: str, ctx: Context) -> str:
1070	    """
1071	    Execute a Python script in Cinema 4D's Python environment.
1072	
1073	    This is the most reliable tool for non-trivial operations — it gives full access
1074	    to the c4d API and avoids wrapper/schema mismatches that can affect other tools.
1075	
1076	    Args:
1077	        script: Python code to execute in Cinema 4D. Has access to `c4d` and
1078	            `c4d.modules.mograph` modules.
1079	
1080	    Important usage notes:
1081	        - For animated/MoGraph data, always call doc.ExecutePasses() after SetTime():
1082	            doc.SetTime(c4d.BaseTime(frame, fps))
1083	            doc.ExecutePasses(None, True, True, True, c4d.BUILDFLAGS_NONE)
1084	        - For MoGraph/effector data, iterate frames sequentially (0..N) rather than
1085	          jumping directly to a later frame — sequential stepping produces more
1086	          faithful results.
1087	        - Security restrictions block certain keywords: import os, subprocess, exec(, eval(.
1088	          Keep scripts within the c4d API surface.
1089	        - For heavy operations (dense frame loops, complex MoGraph scenes), split work
1090	          into multiple smaller scripts rather than one large monolith.
1091	        - Use print() to return results — output is captured and returned.
1092	    """
1093	    async with c4d_connection_context() as connection:
1094	        if not connection.connected:
1095	            return "❌ Not connected to Cinema 4D"
1096	
1097	        # Send command to Cinema 4D
1098	        response = send_to_c4d(
1099	            connection, {"command": "execute_python", "script": script}
1100	        )
1101	        return format_c4d_response(response, "execute_python")
