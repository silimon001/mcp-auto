300	@server.read_resource()
301	async def handle_read_resource(uri: Any) -> List[ResourceContent]:
302	    """Read a resource identified by a payload:// URI."""
303	    parsed = urlparse(str(uri))
304	    query = parse_qs(parsed.query)
305	
306	    if parsed.scheme != "payload":
307	        raise ValueError(f"Unsupported resource scheme: {parsed.scheme}")
308	
309	    path_parts = [unquote(part) for part in parsed.path.split("/") if part]
310	
311	    if parsed.netloc == "server":
312	        config = ServerConfig.from_env()
313	
314	        if parsed.path == "/info":
315	            return json_resource(
316	                {
317	                    "server_name": "payload-mcp-server",
318	                    "server_version": "0.1.0",
319	                    "payload": {
320	                        "base_url": config.payload.base_url,
321	                        "timeout": config.payload.timeout,
322	                        "verify_ssl": config.payload.verify_ssl,
323	                        "bypass_proxy": config.payload.bypass_proxy,
324	                    },
325	                    "capabilities": {
326	                        "tools": True,
327	                        "resources": True,
328	                        "resource_templates": True,
329	                    },
330	                }
331	            )
332	
333	        if parsed.path == "/auth":
334	            return json_resource(
335	                {
336	                    "base_url": config.payload.base_url,
337	                    "auth_token_configured": bool(config.payload.auth_token),
338	                    "browser_auth_initialized": auth_manager is not None,
339	                    "client_initialized": client is not None,
340	                }
341	            )
342	
343	        if parsed.path == "/resources":
344	            return json_resource(build_resource_guide())
345	
346	        raise ValueError(f"Unknown server resource: {parsed.path}")
347	
348	    payload_client = await get_payload_client()
349	
350	    if parsed.netloc == "collections":
351	        if not path_parts:
352	            return json_resource(build_resource_guide())
353	
354	        collection_name = path_parts[0]
355	
356	        if len(path_parts) == 1:
357	            result = await payload_client.search_objects(
358	                collection_name=collection_name,
359	                where=parse_json_param(query, "where"),
360	                limit=parse_int_param(query, "limit"),
