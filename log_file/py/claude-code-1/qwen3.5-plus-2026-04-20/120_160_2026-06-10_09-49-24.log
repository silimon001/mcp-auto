39	def _launch_schema_warmup_thread(services, tool_registry):
40	    def run_schema_warmup():
41	        try:
42	            schema_warmup = tool_registry.dispatch(services, GET_SCHEMA_CONTEXT_TOOL_NAME, {"force_refresh": True})
43	            if schema_warmup.get("status") == "success":
44	                services.logger.info("Schema context cache warmup succeeded.")
45	            else:
46	                services.logger.warning("Schema context cache warmup skipped: %s", schema_warmup.get("message"))
47	        except Exception as schema_warmup_error:
48	            services.logger.warning("Schema context cache warmup failed: %s", schema_warmup_error)
49	
50	    threading.Thread(target=run_schema_warmup, name="revitmcp-schema-warmup", daemon=True).start()
51	    services.logger.info("Schema context warmup launched in background thread.")
