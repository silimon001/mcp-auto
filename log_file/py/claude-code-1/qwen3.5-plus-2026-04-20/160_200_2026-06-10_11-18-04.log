187	def write_timeline_log(timeline, log_file):
188	    Path(log_file).parent.mkdir(parents=True, exist_ok=True)
189	    with open(log_file, "a", encoding="utf-8") as f:
190	        for event in timeline:
191	            if event.event_type == "SESSION_INIT":
192	                f.write(f"[{event.timestamp}] {event.event_type}\n")
193	            elif event.event_type == "FINAL_RESULT":
194	                f.write(f"status={event.payload.get('subtype')}\n")
195	                f.write(f"turns={event.payload.get('num_turns')}\n")
196	                f.write(f"duration_ms={event.payload.get('duration_ms')}\n")
197	                f.write(f"api_ms={event.payload.get('duration_api_ms')}\n")
198	                f.write(f"cost_usd={event.payload.get('total_cost_usd')}\n")
199	                usage = event.payload.get("usage")
200	                if usage:
201	                    f.write("\nTOKEN USAGE:\n")
202	                    for k, v in usage.items(): f.write(f"  {k}: {v}\n")
203	                f.write("\n")
204	            else:
205	                etype, payload = event.event_type, event.payload
206	                f.write(f"[Turn {event.turn}] [{event.timestamp}] {etype}\n")
207	                if etype == "ASSISTANT_TEXT": f.write(payload.get("text", "") + '\n')
208	                elif etype == "ASSISTANT_THINKING": f.write(payload.get("thinking", "") + "\n")
209	                elif etype == "TOOL_CALL":
210	                    f.write(f"tool={payload.get('tool_name')}, ")
211	                    f.write(f"args={json.dumps(payload.get('input', {}), ensure_ascii=False)}\n")
212	                elif etype == "TOOL_RESULT":
213	                    if payload.get("duration_seconds") is not None: f.write(f"duration={payload['duration_seconds']:.2f}s\n")
214	                    if payload.get("is_error"): f.write("ERROR=True\n")
215	                    result = payload.get("result")
216	                    if result: f.write("\nOUTPUT\n" + str(result) + "\n")
217	            f.write("-" * 80 + "\n")
218	
219	def run_task(prompt_text: str, task_name, pos, count):
220	    events, stderr = run_claude_stream(prompt_text)
221	    parser = ClaudeStreamParser()
222	    timeline = parser.parse_events(events)
223	    log_file = f"{LOG_DIR}/{pos}_{pos+count}_{timestamp}.log"
224	    write_timeline_log(timeline, log_file)
225	    return timeline
