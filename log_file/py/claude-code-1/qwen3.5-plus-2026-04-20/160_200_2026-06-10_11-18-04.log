56	async def oauth_authorization_server(request: Request):
57	    """RFC 8414 — Authorization Server Metadata.
58	
59	    Redmine uses Doorkeeper but does not serve this discovery document itself.
60	    We serve it manually, pointing to Redmine's real Doorkeeper endpoints.
61	
62	    Env vars are read at request time (rather than module-import time) so
63	    that the handler responds to runtime configuration changes and is
64	    cleanly testable without module reloads.
65	    """
66	    redmine_url = (os.environ.get("REDMINE_URL", "") or "").rstrip("/")
67	    # issuer must be byte-identical to the authorization-server identifier the
68	    # protected-resource doc advertises in authorization_servers, which _auth.py
69	    # builds as AnyHttpUrl(REDMINE_URL). Reuse the same normalization so a
70	    # spec-strict client (RFC 8414 §3.3) treats the two as equal, including the
71	    # trailing slash pydantic adds for bare hosts. Sourcing issuer from
72	    # REDMINE_MCP_BASE_URL made split-host deployments advertise the MCP server
73	    # as the AS (#140).
74	    issuer = str(AnyHttpUrl(redmine_url)) if redmine_url else redmine_url
75	    return JSONResponse(
76	        {
77	            "issuer": issuer,
78	            "authorization_endpoint": f"{redmine_url}/oauth/authorize",
79	            "token_endpoint": f"{redmine_url}/oauth/token",
80	            "revocation_endpoint": f"{redmine_url}/oauth/revoke",
81	            "response_types_supported": ["code"],
82	            "grant_types_supported": [
83	                "authorization_code",
84	                "refresh_token",
85	            ],
86	            "code_challenge_methods_supported": ["S256"],
87	            "token_endpoint_auth_methods_supported": [
88	                "client_secret_post",
89	                "client_secret_basic",
90	            ],
91	            "scopes_supported": advertised_scopes(),
92	        }
93	    )
94	
95	
96	async def revoke_token(request: Request):
97	    """RFC 7009 — Revoke an OAuth2 access or refresh token.
98	
99	    Proxies token revocation to Redmine's Doorkeeper /oauth/revoke endpoint.
100	
101	    Accepts token via:
102	    - Authorization header: Bearer <token>
103	    - POST body: {"token": "<token>"} or form-encoded token=<token>
104	
105	    Returns:
106	        200 OK on success (per RFC 7009, even if token was already invalid)
107	        400 Bad Request if no token provided
108	        502 Bad Gateway if Redmine is unreachable
109	    """
110	    token = None
111	
112	    # Try Authorization header first
113	    auth_header = request.headers.get("Authorization", "")
114	    if auth_header.startswith("Bearer "):
115	        token = auth_header.removeprefix("Bearer ").strip()
116	
117	    # Fall back to request body
118	    if not token:
119	        content_type = request.headers.get("Content-Type", "")
120	        if "application/json" in content_type:
121	            try:
122	                body = await request.json()
123	                token = body.get("token")
124	            except Exception:
125	                pass
126	        else:
127	            # form-encoded
128	            try:
129	                form = await request.form()
130	                token = form.get("token")
131	            except Exception:
132	                pass
133	
134	    if not token:
135	        return JSONResponse(
136	            status_code=400,
137	            content={
138	                "error": "invalid_request",
139	                "error_description": "No token provided",
140	            },
141	        )
142	
143	    # Forward revocation to Redmine's Doorkeeper endpoint. Env vars are read
144	    # at request time so runtime overrides (and tests) are honoured.
145	    redmine_url = (os.environ.get("REDMINE_URL", "") or "").rstrip("/")
146	    async with httpx.AsyncClient() as client:
147	        try:
148	            response = await client.post(
149	                f"{redmine_url}/oauth/revoke",
150	                data={"token": token},
151	                timeout=10,
152	            )
153	        except httpx.RequestError as e:
154	            logger.error(f"Failed to reach Redmine for token revocation: {e}")
155	            return JSONResponse(
156	                status_code=502,
157	                content={"error": "upstream_unavailable"},
158	            )
159	
160	    # RFC 7009: return 200 regardless of whether token was valid
161	    # (to prevent token scanning attacks)
162	    if response.status_code in (200, 204):
163	        return JSONResponse(status_code=200, content={"success": True})
164	
165	    # If Redmine returns an error, log but still return success per RFC 7009
166	    logger.warning(
167	        f"Redmine revocation returned {response.status_code}: " f"{response.text}"
168	    )
169	    return JSONResponse(status_code=200, content={"success": True})
170	
