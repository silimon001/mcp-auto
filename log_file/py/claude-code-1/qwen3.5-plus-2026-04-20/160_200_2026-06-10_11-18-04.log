16	def _init_artifact_store() -> bool:
17	    """
18	    Initialize the artifact store from environment variables.
19	
20	    Checks for S3/Tigris configuration and sets up the global artifact store.
21	    This enables cloud storage for videos on Fly.io deployments.
22	
23	    Returns:
24	        True if artifact store was initialized, False otherwise
25	    """
