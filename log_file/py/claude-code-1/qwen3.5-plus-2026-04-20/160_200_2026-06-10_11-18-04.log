40	                "Set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and BUCKET_NAME."
41	            )
42	            return False
43	
44	        logger.info(f"Initializing artifact store with S3 provider (bucket: {bucket})")
