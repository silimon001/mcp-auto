40	 * Parse integer with bounds
41	 */
42	function parseInt10(value, defaultValue, min = null, max = null) {
43	  if (value === undefined || value === null) return defaultValue;
44	  const intValue = parseInt(value, 10);
45	  if (isNaN(intValue)) return defaultValue;
46	  if (min !== null && intValue < min) return min;
47	  if (max !== null && intValue > max) return max;
48	  return intValue;
49	}
50	
51	/**
52	 * Get git branch (for version info)
53	 */
54	function getGitBranch() {
55	  try {
56	    const projectRoot = path.join(__dirname, '..', '..');
57	    return execSync(`cd "${projectRoot}" && git rev-parse --abbrev-ref HEAD`, 
58	                    { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }).trim();
59	  } catch (e) {
60	    return 'unknown';
61	  }
62	}
63	
64	/**
65	 * Create prefixed tool name
66	 */
67	function createPrefixedToolName(serverName, toolName) {
68	  if (!serverName || !toolName) return toolName;
69	  const coreServerName = serverName
70	    .replace(/^lisply-mcp-?/, '')
71	    .replace(/^mcp-?/, '')
72	    .replace(/-+$/, '');
73	  const prefix = coreServerName || serverName;
74	  return `${prefix}__${toolName}`;
75	}
76	
77	/**
78	 * Extract original tool name from prefixed name
79	 */
80	function extractOriginalToolName(prefixedToolName) {
81	  if (!prefixedToolName) return prefixedToolName;
82	  const parts = prefixedToolName.split('__');
83	  if (parts.length >= 2) {
84	    return parts.slice(1).join('__');
85	  }
86	  return prefixedToolName;
87	}
88	
