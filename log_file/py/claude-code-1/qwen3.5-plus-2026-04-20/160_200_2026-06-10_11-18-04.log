14	def run_claude_stream(prompt_text: str):
15	    process = subprocess.Popen(
16	        ["claude-tap", "--", "--print", "--verbose", "--max-turns", "20",
17	         "--output-format", "stream-json", "--permission-mode", "bypassPermissions",
18	         "--exclude-dynamic-system-prompt-sections"],
19	        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
20	        text=True, encoding="utf-8", bufsize=1
21	    )
22	    process.stdin.write(prompt_text)
23	    process.stdin.close()
24	
25	    events, stderr_lines = [], []
26	    stdout_queue, stderr_queue = queue.Queue(), queue.Queue()
27	
28	    def read_stdout():
29	        try:
30	            for line in iter(process.stdout.readline, ''):
31	                stdout_queue.put(line)
32	        except Exception as e:
33	            stdout_queue.put(f"__ERROR__:{e}")
34	        finally:
35	            stdout_queue.put(None)
36	
37	    def read_stderr():
38	        try:
39	            for line in iter(process.stderr.readline, ''):
40	                stderr_queue.put(line)
41	                stderr_lines.append(line)
42	        except Exception as e:
43	            stderr_queue.put(f"__ERROR__:{e}")
44	        finally:
45	            stderr_queue.put(None)
46	
47	    stdout_thread = threading.Thread(target=read_stdout, daemon=True)
48	    stderr_thread = threading.Thread(target=read_stderr, daemon=True)
49	    stdout_thread.start()
50	    stderr_thread.start()
51	
52	    got_result = False
53	
54	    while True:
55	        try:
56	            line = stdout_queue.get(timeout=1)
57	        except queue.Empty:
58	            if got_result or process.poll() is not None:
59	                break
60	            continue
61	
62	        if line is None:
63	            break
64	
65	        line = line.strip()
66	        if not line:
67	            continue
68	
69	        try:
70	            obj = json.loads(line)
71	            obj["_received_at"] = datetime.now(timezone.utc).isoformat()
72	            events.append(obj)
73	
74	            if obj.get("type") == "result":
75	                got_result = True
76	                try:
77	                    process.terminate()
78	                except Exception:
79	                    pass
80	                break
81	
82	        except json.JSONDecodeError:
83	            continue
84	        except Exception as e:
85	            print(f"⚠️ JSON parse error: {e}")
86	
87	    try:
88	        process.wait(timeout=5)
89	    except subprocess.TimeoutExpired:
90	        print("⚠️ Claude process timeout, killing...")
91	        try:
92	            process.kill()
93	        except Exception:
94	            pass
95	
96	    stdout_thread.join(timeout=1)
97	    stderr_thread.join(timeout=1)
98	
99	    return events, "".join(stderr_lines)
