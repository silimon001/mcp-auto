120	
121	    def parse_event(self, obj: Dict[str, Any]):
122	        typ = obj.get("type")
123	        if typ == "system": return self._parse_system(obj)
124	        elif typ == "assistant": return self._parse_assistant(obj)
125	        elif typ == "user": return self._parse_user(obj)
126	        elif typ == "result": return self._parse_result(obj)
127	        return None
128	
129	    def _parse_system(self, obj):
130	        subtype, ts = obj.get("subtype"), obj.get("_received_at")
131	        if subtype == "init":
132	            return NormalizedEvent(0, "SESSION_INIT", ts, {}, obj)
133	        return None
134	
135	    def _parse_assistant(self, obj):
136	        ts = obj.get("_received_at")
137	        content = obj.get("message", {}).get("content", [])
138	        events = []
139	        for block in content:
140	            btype = block.get("type")
141	            if btype == "thinking":
142	                self.turn += 1
143	                events.append(NormalizedEvent(self.turn, "ASSISTANT_THINKING", ts, {"thinking": block.get("thinking", "")}, obj))
144	            elif btype == "text":
145	                events.append(NormalizedEvent(self.turn, "ASSISTANT_TEXT", ts, {"text": block.get("text", "")}, obj))
146	            elif btype == "tool_use":
147	                tool_id = block.get("id")
148	                self.tool_calls[tool_id] = {"tool": block.get("name"), "input": block.get("input"), "start_time": ts, "result": None}
149	                events.append(NormalizedEvent(self.turn, "TOOL_CALL", ts, {"tool_use_id": tool_id, "tool_name": block.get("name"), "input": block.get("input")}, obj))
150	        return events
151	
152	    def _parse_user(self, obj):
153	        ts = obj.get("_received_at"); events = []
154	        for block in obj.get("message", {}).get("content", []):
155	            tool_use_id = block.get("tool_use_id")
156	            if not tool_use_id: continue
157	            result_data = block.get("content"); duration = None
158	            if tool_use_id in self.tool_calls:
159	                call = self.tool_calls[tool_use_id]
160	                call["result"] = result_data; call["end_time"] = ts
161	                try: duration = (datetime.fromisoformat(ts) - datetime.fromisoformat(call["start_time"])).total_seconds()
162	                except Exception: pass
163	            events.append(NormalizedEvent(self.turn, "TOOL_RESULT", ts,
164	                {"tool_use_id": tool_use_id, "result": result_data, "is_error": block.get("is_error", False), "duration_seconds": duration}, obj))
165	        return events
166	
167	    def _parse_result(self, obj):
168	        return NormalizedEvent(self.turn, "FINAL_RESULT", obj.get("_received_at"),
169	            {"subtype": obj.get("subtype"), "duration_ms": obj.get("duration_ms"),
170	             "duration_api_ms": obj.get("duration_api_ms"), "num_turns": obj.get("num_turns"),
171	             "result": obj.get("result"), "total_cost_usd": obj.get("total_cost_usd"),
172	             "usage": obj.get("usage"), "is_error": obj.get("is_error")}, obj)
173	
174	    def get_tool_summary(self):
175	        summary = []
176	        for tool_id, info in self.tool_calls.items():
177	            duration = None
178	            if "start_time" in info and "end_time" in info:
179	                try: duration = (datetime.fromisoformat(info["end_time"]) - datetime.fromisoformat(info["start_time"])).total_seconds()
180	                except Exception: pass
181	            summary.append({"tool_use_id": tool_id, "tool": info["tool"], "duration_seconds": duration, "success": info.get("result") is not None})
182	        return summary
