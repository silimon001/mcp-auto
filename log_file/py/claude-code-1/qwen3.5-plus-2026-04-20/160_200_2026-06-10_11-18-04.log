mcp.tool()(get_company_notes)
mcp.tool()(get_quote)
mcp.tool()(get_quote_change)
mcp.tool()(get_aftermarket_quote)
mcp.tool()(get_price_change)
mcp.tool()(get_income_statement)
mcp.tool()(search_by_symbol)
mcp.tool()(search_by_name)
