1	# Lisply-MCP: Minimal Node.js container for MCP wrapper middleware
2	# This container provides the MCP protocol bridge to Lisp backends (Gendl, Emacs)
3	# It is designed to be a neutral middleware - configuration comes from the orchestrating context
4	FROM node:23-slim
5	
6	# Set working directory inside the container
7	WORKDIR /app
8	
9	# Install minimal system dependencies
10	RUN apt-get update && apt-get install -y \
11	    curl \
12	    procps \
