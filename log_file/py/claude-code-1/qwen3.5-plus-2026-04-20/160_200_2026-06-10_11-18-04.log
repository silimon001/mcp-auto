28	    bucket = os.environ.get("BUCKET_NAME")
29	    redis_url = os.environ.get("REDIS_URL")
30	
31	    # For S3 provider, we need bucket and AWS credentials
32	    if provider == "s3":
33	        aws_key = os.environ.get("AWS_ACCESS_KEY_ID")
34	        aws_secret = os.environ.get("AWS_SECRET_ACCESS_KEY")
35	        aws_endpoint = os.environ.get("AWS_ENDPOINT_URL_S3")
36	
37	        if not all([bucket, aws_key, aws_secret]):
38	            logger.warning(
