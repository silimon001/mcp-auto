75	def execute_query(kb_name: str, query_text: str, rag_manager=None, output_file=None, async_task_runner=None):
76	    """Execute a query against a knowledge base.
77	    
78	    Args:
79	        kb_name: Name of the knowledge base
80	        query_text: Query text to search for
81	        rag_manager: Optional RAG manager instance (if None, will create one)
82	        output_file: Optional file object for output (defaults to sys.stdout)
83	        async_task_runner: Optional function to run async tasks (for shell integration)
84	    
85	    Returns:
86	        Query result string
87	    
88	    Raises:
89	        Exception: If query fails
90	    """
91	    if output_file is None:
92	        output_file = sys.stdout
93	    
94	    # Initialize components if rag_manager not provided
95	    if rag_manager is None:
96	        kb_manager, rag_manager = initialize_components(Config.get_instance())
97	    
98	    print(f"\nQuerying KB '{kb_name}' with: \"{query_text}\"", file=output_file)
99	    print(" [running query] ...", end="", flush=True, file=output_file)
100	    
101	    try:
102	        if async_task_runner:
103	            # For shell - use the provided async task runner
104	            result = async_task_runner(rag_manager.query(kb_name, query_text))
105	        else:
106	            # For CLI - create and manage our own event loop with aggressive cleanup
107	            loop = asyncio.new_event_loop()
108	            asyncio.set_event_loop(loop)
109	            
110	            # Set a custom exception handler to suppress background task warnings
111	            def exception_handler(loop, context):
112	                # Suppress specific LightRAG background task errors
113	                exception = context.get('exception')
114	                if isinstance(exception, RuntimeError) and 'Event loop is closed' in str(exception):
115	                    return  # Ignore these errors
116	                if isinstance(exception, RuntimeError) and 'no running event loop' in str(exception):
117	                    return  # Ignore these errors
118	                # Log other exceptions normally
119	                logger.debug(f"Async exception: {context}")
120	            
121	            loop.set_exception_handler(exception_handler)
122	            
123	            try:
124	                result = loop.run_until_complete(rag_manager.query(kb_name, query_text))
125	                
126	            except Exception as e:
127	                # Force cleanup of RAG instance on error to prevent background tasks
128	                logger.debug("Cleaning up RAG instance after query error")
129	                if hasattr(rag_manager, '_rag_instances') and kb_name in rag_manager._rag_instances:
130	                    del rag_manager._rag_instances[kb_name]
131	                    logger.debug(f"Removed cached RAG instance for {kb_name} due to error")
132	                raise  # Re-raise the exception
133	                
134	            finally:
135	                # Always cleanup RAG instance after query to prevent background tasks
136	                logger.debug("Final cleanup of RAG instance")
137	                if hasattr(rag_manager, '_rag_instances') and kb_name in rag_manager._rag_instances:
138	                    del rag_manager._rag_instances[kb_name]
139	                    logger.debug(f"Final removal of cached RAG instance for {kb_name}")
140	                    
141	                _cleanup_event_loop(loop)
142	        
143	        print(" [done]", file=output_file)
144	        print("\n--- Query Result ---", file=output_file)
145	        print(result, file=output_file)
146	        print("--- End Result ---", file=output_file)
147	        return result
148	        
149	    except Exception as e:
150	        print(" [failed]", file=output_file)
151	        print(f"\nError querying KB '{kb_name}': {e}", file=output_file)
152	        logger.error(f"Query failed for {kb_name}: {e}")
153	        raise
