331	        results = drive_service.files().list(
332	            q=query,
333	            pageSize=20, # Limit results
334	            fields="nextPageToken, files(id, name, mimeType)"
335	        ).execute()
336	        
337	        files = results.get('files', [])
338	        if not files:
339	            return []
340	            
341	        return [
342	            ListedDriveFile(
