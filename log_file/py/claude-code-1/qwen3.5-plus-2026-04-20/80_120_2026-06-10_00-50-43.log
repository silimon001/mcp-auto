211	    async def cleanup(self) -> None:
212	        """Clean up server resources."""
213	        if not self.initialized:
214	            return
215	
216	        logger.info("Cleaning up memvid MCP server")
217	
218	        try:
219	            # Clean up Docker resources first
220	            try:
221	                with redirect_stdout(sys.stderr):
222	                    await self.docker_manager.cleanup()
223	            except Exception as e:
224	                logger.warning(f"Docker cleanup failed: {e}")
225	
226	            # Close connections
227	            for conn_id, conn in self.connections.items():
228	                try:
229	                    if hasattr(conn, 'close'):
230	                        if asyncio.iscoroutinefunction(conn.close):
231	                            await conn.close()
232	                        else:
233	                            conn.close()
234	                except Exception as e:
235	                    logger.warning(f"Connection cleanup failed for {conn_id}: {e}")
236	
237	            # Clear state
238	            self.connections.clear()
239	            self.encoder = None
240	            self.retriever = None
241	            self.chat = None
242	            self.current_video_path = None
243	            self.current_index_path = None
244	            self.available_memories.clear()
245	            self.initialized = False
246	
247	            logger.info("Server cleanup completed")
248	
249	        except Exception as e:
250	            logger.error(f"Error during cleanup: {e}")
