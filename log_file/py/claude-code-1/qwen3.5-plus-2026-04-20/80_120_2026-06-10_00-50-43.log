338	def find_task_file(description: str, repo_path: str) -> Tuple[Optional[str], Optional[str]]:
339	    """Find a task file by its description.
340	    
341	    Args:
342	        description: The description identifier of the task list file
343	        repo_path: Path to the repository root
344	        
345	    Returns:
346	        Tuple of (file_path, content) or (None, None) if not found
347	    """
348	    tasks_dir = os.path.join(repo_path, TASKS_FOLDER)
349	    if not os.path.exists(tasks_dir):
350	        return None, None
351	    
352	    # Normalize description for comparison
353	    safe_description = description.lower().replace(" ", "-")
354	    safe_description = re.sub(r'[^a-z0-9\-]', '', safe_description)
355	    
356	    # Look for files that match the description
357	    for file in os.listdir(tasks_dir):
358	        if file.endswith('.md'):
359	            # Remove completion prefix and extension for comparison
360	            file_desc = file.replace(COMPLETED_PREFIX, "").replace(".md", "")
361	            if file_desc == safe_description:
362	                file_path = os.path.join(tasks_dir, file)
363	                with open(file_path, 'r') as f:
364	                    content = f.read()
365	                return file_path, content
366	    
367	    return None, None
368	
369	def extract_tasks(text: str) -> List[str]:
370	    """Extract tasks from the plan text.
371	    
372	    Looks for common patterns that indicate tasks in the text.
373	    
374	    Args:
375	        text: The plan text to parse
376	        
377	    Returns:
378	        A list of extracted tasks
379	    """
380	    tasks = []
381	    
382	    # Try to find numbered steps (1. Step one, 2. Step two)
383	    numbered_steps = re.findall(r'\b(\d+\.?\s*[A-Z].*?)(?=\b\d+\.|\n\n|$)', text, re.DOTALL)
384	    if numbered_steps:
385	        # Clean up the steps
386	        tasks = [re.sub(r'^\d+\.?\s*', '', step).strip() for step in numbered_steps]
387	        return tasks
388	    
389	    # Try to find bullet points
390	    bullet_points = re.findall(r'(?:^|\n)[*\-•]\s*(.*?)(?=\n[*\-•]|\n\n|$)', text, re.DOTALL)
391	    if bullet_points:
392	        tasks = [point.strip() for point in bullet_points]
393	        return tasks
394	    
395	    # Try to find sentences that contain task-like keywords
396	    task_sentences = re.findall(r'(?:need to|should|must|will|going to|let\'s|we can|I\'ll|can|todo|to-do|task)\s+([^\.]+\.)', text, re.IGNORECASE)
397	    if task_sentences:
398	        tasks = [sentence.strip() for sentence in task_sentences]
399	        return tasks
400	    
401	    # If all else fails, split by paragraphs and treat each as a potential task
402	    paragraphs = re.split(r'\n\s*\n', text)
403	    if paragraphs:
404	        # Filter out very short paragraphs and headers
405	        tasks = [p.strip() for p in paragraphs if len(p.strip()) > 10 and not p.strip().startswith('#')]
406	        return tasks
407	    
408	    return tasks
409	
410	def format_plan_sections(text: str) -> str:
411	    """Format the plan into structured sections if no clear tasks were found.
412	    
413	    Args:
414	        text: The plan text to format
415	        
416	    Returns:
417	        Formatted markdown with sections
418	    """
419	    # Look for markdown headers already in the text
420	    has_headers = bool(re.search(r'^#+\s+', text, re.MULTILINE))
421	    
422	    if has_headers:
423	        # If the text already has headers, preserve them
424	        return text
425	    
426	    # Otherwise try to identify sections
427	    sections = {
428	        "## Overview": [],
429	        "## Implementation Details": [],
430	        "## Next Steps": []
431	    }
432	    
433	    lines = text.split('\n')
434	    current_section = "## Overview"
435	    
436	    for line in lines:
437	        # Simple heuristic: Try to identify section breaks
438	        if re.match(r'^.*(overview|summary|about).*$', line, re.IGNORECASE):
439	            current_section = "## Overview"
440	            continue
441	        elif re.match(r'^.*(implementation|details|how to|approach).*$', line, re.IGNORECASE):
442	            current_section = "## Implementation Details"
443	            continue
444	        elif re.match(r'^.*(next steps|future|todo|to do).*$', line, re.IGNORECASE):
445	            current_section = "## Next Steps"
446	            continue
447	        
448	        # Add the line to the current section
449	        if line.strip():
450	            sections[current_section].append(line)
451	    
452	    # Build the final markdown
453	    result = ""
454	    for section, content in sections.items():
455	        if content:
456	            result += f"{section}\n\n"
457	            # Format as a list if it's the "Next Steps" section
458	            if section == "## Next Steps":
459	                for i, line in enumerate(content):
460	                    result += f"{i+1}. [ ] {line.strip()}\n"
461	            else:
462	                result += "\n".join(content) + "\n\n"
463	    
464	    return result
465	
