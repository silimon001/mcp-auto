181	            else:
182	                # Initialize encoder only when needed to avoid startup errors
183	                logger.info("Memvid available - ready to create encoder on demand")
184	
185	            self.initialized = True
186	            logger.info("Server initialization completed")
187	
188	        except Exception as e:
189	            logger.error(f"Server initialization failed: {e}")
190	            raise
191	
192	    def update_memory_library(self, video_path: str, index_path: str) -> None:
193	        """Update the memory library with a new or loaded memory."""
194	        try:
