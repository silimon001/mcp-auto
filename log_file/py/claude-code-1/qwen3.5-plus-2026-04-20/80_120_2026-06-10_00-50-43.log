281	    @app.post("/api/ib/{name}/reindex/full")
282	    async def reindex_full(name: str, force: bool = False):
283	        ctx = ib_manager.get_context(name)
284	        if not ctx:
285	           raise HTTPException(404, "IB not found")
286	        if ctx.is_error:
287	           return {"error": f"ИБ недоступна: {ctx.error}"}
288	        
289	        if ctx.status.running:
290	            if not force:
291	                return {"error": "Индексация уже запущена", "running": True, "mode": ctx.status.mode}
292	            # Остановка текущей
293	            ctx.stop_event.set()
294	            # Ждём завершения текущей индексации
295	            import time
296	            for _ in range(20):  # до 2 секунд
297	                if not ctx.status.running:
298	                    break
299	                time.sleep(0.1)
300	        
301	        # Сбрасываем stop_event и устанавливаем running ДО запуска потока
302	        ctx.stop_event.clear()
303	        ctx.status.running = True
304	        ctx.status.mode = "full"
305	        threading.Thread(target=ctx.engine.full_reindex, args=(ctx.status, ctx.stop_event), daemon=True).start()
306	        return {"started": True}
