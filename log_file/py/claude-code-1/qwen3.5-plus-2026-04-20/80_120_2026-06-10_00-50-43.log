77	def _detect_and_configure_faiss() -> str:
78	    """Detect and configure the best available FAISS implementation."""
79	    faiss_type = "none"
80	
81	    try:
82	        # Try GPU FAISS first
83	        import faiss
84	        if hasattr(faiss, 'get_num_gpus') and faiss.get_num_gpus() > 0:
85	            # Test if GPU is actually available and working
86	            try:
87	                # Create a small test index to verify GPU functionality
88	                test_index = faiss.IndexFlatL2(128)
89	                gpu_res = faiss.StandardGpuResources()
90	                faiss.index_cpu_to_gpu(gpu_res, 0, test_index)
91	                faiss_type = "gpu"
92	                logger.info(f"✅ GPU FAISS detected and working - {faiss.get_num_gpus()} GPU(s) available")
93	            except Exception as e:
94	                logger.warning(f"GPU FAISS detected but not functional: {e}, falling back to CPU")
95	                faiss_type = "cpu"
96	        else:
97	            faiss_type = "cpu"
98	            logger.info("🖥️ Using CPU FAISS (no GPU detected or GPU FAISS not available)")
99	
100	    except ImportError:
101	        logger.warning("⚠️ FAISS not available - vector search may not work")
102	        faiss_type = "none"
103	
104	    return faiss_type
