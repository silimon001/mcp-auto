262	    async def reindex_stop(name: str):
263	        """Остановить текущую индексацию."""
264	        ctx = ib_manager.get_context(name)
265	        if not ctx:
266	           raise HTTPException(404, "IB not found")
267	        
268	        if not ctx.status.running:
269	            return {"error": "Индексация не запущена"}
