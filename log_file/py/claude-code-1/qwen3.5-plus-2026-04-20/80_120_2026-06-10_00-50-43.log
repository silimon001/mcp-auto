1	"""
2	Supabase MCP Server - A Model Context Protocol server for Supabase database operations.
3	
4	This server provides tools for interacting with a Supabase database, including:
5	- Reading rows from tables
6	- Creating records in tables
7	- Updating records in tables
8	- Deleting records from tables
9	
10	Environment variables:
11	- SUPABASE_URL: The URL of your Supabase project
12	- SUPABASE_SERVICE_KEY: The service role key for your Supabase project
13	"""
14	
15	import os
16	from typing import Dict, List, Any, Optional, Union
17	from contextlib import asynccontextmanager
18	from collections.abc import AsyncIterator
19	from dataclasses import dataclass
20	
21	from dotenv import load_dotenv
22	from supabase import create_client, Client
23	from mcp.server.fastmcp import FastMCP, Context
24	
25	# Load environment variables
26	load_dotenv()
27	
28	# Create a dataclass for our application context
29	@dataclass
30	class SupabaseContext:
31	    """Context for the Supabase MCP server."""
32	    client: Client
33	
34	
35	@asynccontextmanager
36	async def supabase_lifespan(server: FastMCP) -> AsyncIterator[SupabaseContext]:
37	    """
38	    Manages the Supabase client lifecycle.
39	    
40	    Args:
41	        server: The FastMCP server instance
42	        
43	    Yields:
44	        SupabaseContext: The context containing the Supabase client
45	    """
46	    # Get environment variables
47	    supabase_url = os.getenv("SUPABASE_URL")
48	    supabase_key = os.getenv("SUPABASE_SERVICE_KEY")
49	    
50	    if not supabase_url or not supabase_key:
51	        raise ValueError(
52	            "Missing environment variables. Please set SUPABASE_URL and SUPABASE_SERVICE_KEY."
53	        )
54	    
55	    # Initialize Supabase client
56	    supabase_client = create_client(supabase_url, supabase_key)
57	    
58	    try:
59	        yield SupabaseContext(client=supabase_client)
60	    finally:
61	        # No explicit cleanup needed for Supabase client
62	        pass
63	
64	
65	# Create the MCP server
66	mcp = FastMCP(
67	    "Supabase Database",
68	    description="MCP server for interacting with Supabase databases",
69	    lifespan=supabase_lifespan
70	)
71	
72	
73	@mcp.tool()
74	def read_table_rows(
75	    ctx: Context,
76	    table_name: str,
77	    columns: str = "*",
78	    filters: Optional[Dict[str, Any]] = None,
79	    limit: Optional[int] = None,
80	    order_by: Optional[str] = None,
81	    ascending: bool = True
82	) -> List[Dict[str, Any]]:
83	    """
84	    Read rows from a Supabase table with optional filtering, ordering, and limiting.
85	    
86	    Use this tool to query data from a specific table in the Supabase database.
87	    You can select specific columns, filter rows based on conditions, limit the number
88	    of results, and order the results.
89	    
90	    Args:
91	        ctx: The MCP context
92	        table_name: Name of the table to read from
93	        columns: Comma-separated list of columns to select (default: "*" for all columns)
94	        filters: Dictionary of column-value pairs to filter rows (default: None)
95	        limit: Maximum number of rows to return (default: None)
96	        order_by: Column to order results by (default: None)
97	        ascending: Whether to sort in ascending order (default: True)
98	        
99	    Returns:
100	        List of dictionaries, each representing a row from the table
101	        
102	    Example:
103	        To get all users: read_table_rows(table_name="users")
104	        To get specific columns: read_table_rows(table_name="users", columns="id,name,email")
105	        To filter rows: read_table_rows(table_name="users", filters={"is_active": True})
106	        To limit results: read_table_rows(table_name="users", limit=10)
107	        To order results: read_table_rows(table_name="users", order_by="created_at", ascending=False)
108	    """
109	    supabase = ctx.request_context.lifespan_context.client
110	    
111	    # Start building the query
112	    query = supabase.table(table_name).select(columns)
113	    
114	    # Apply filters if provided
115	    if filters:
116	        for column, value in filters.items():
117	            query = query.eq(column, value)
118	    
119	    # Apply ordering if provided
120	    if order_by:
121	        order_method = "order" if ascending else "order"
122	        query = getattr(query, order_method)(order_by, ascending=ascending)
123	    
124	    # Apply limit if provided
125	    if limit:
126	        query = query.limit(limit)
127	    
128	    # Execute the query
129	    response = query.execute()
130	    
131	    # Return the data
132	    return response.data
133	
134	
135	@mcp.tool()
136	def create_table_records(
137	    ctx: Context,
138	    table_name: str,
139	    records: Union[Dict[str, Any], List[Dict[str, Any]]]
140	) -> Dict[str, Any]:
141	    """
142	    Create one or multiple records in a Supabase table.
143	    
144	    Use this tool to insert new data into a specific table in the Supabase database.
145	    You can insert a single record or multiple records at once.
146	    
147	    Args:
148	        ctx: The MCP context
149	        table_name: Name of the table to insert records into
150	        records: A dictionary for a single record or a list of dictionaries for multiple records
151	        
152	    Returns:
153	        Dictionary containing the created records and metadata
154	        
155	    Example:
156	        To create a single record:
157	            create_table_records(
158	                table_name="users",
159	                records={"name": "John Doe", "email": "john@example.com"}
160	            )
161	            
162	        To create multiple records:
163	            create_table_records(
164	                table_name="users",
165	                records=[
166	                    {"name": "John Doe", "email": "john@example.com"},
167	                    {"name": "Jane Smith", "email": "jane@example.com"}
168	                ]
169	            )
170	    """
171	    supabase = ctx.request_context.lifespan_context.client
172	    
173	    # Insert the records
174	    response = supabase.table(table_name).insert(records).execute()
175	    
176	    # Return the response
177	    return {
178	        "data": response.data,
179	        "count": len(response.data) if response.data else 0,
180	        "status": "success" if response.data else "error"
181	    }
182	
183	
184	@mcp.tool()
185	def update_table_records(
186	    ctx: Context,
187	    table_name: str,
188	    updates: Dict[str, Any],
189	    filters: Dict[str, Any]
190	) -> Dict[str, Any]:
191	    """
192	    Update records in a Supabase table that match the specified filters.
193	    
194	    Use this tool to modify existing data in a specific table in the Supabase database.
195	    You provide the new values and filter conditions to identify which records to update.
196	    
197	    Args:
198	        ctx: The MCP context
199	        table_name: Name of the table to update records in
200	        updates: Dictionary of column-value pairs with the new values
201	        filters: Dictionary of column-value pairs to filter which rows to update
202	        
203	    Returns:
204	        Dictionary containing the updated records and metadata
205	        
206	    Example:
207	        To update all active users' status:
208	            update_table_records(
209	                table_name="users",
210	                updates={"status": "premium"},
211	                filters={"is_active": True}
212	            )
213	    """
214	    supabase = ctx.request_context.lifespan_context.client
215	    
216	    # Start building the query
217	    query = supabase.table(table_name).update(updates)
218	    
219	    # Apply filters
220	    for column, value in filters.items():
221	        query = query.eq(column, value)
222	    
223	    # Execute the query
224	    response = query.execute()
225	    
226	    # Return the response
227	    return {
228	        "data": response.data,
229	        "count": len(response.data) if response.data else 0,
230	        "status": "success" if response.data else "error"
231	    }
232	
233	
234	@mcp.tool()
235	def delete_table_records(
236	    ctx: Context,
237	    table_name: str,
238	    filters: Dict[str, Any]
239	) -> Dict[str, Any]:
240	    """
241	    Delete records from a Supabase table that match the specified filters.
242	    
243	    Use this tool to remove data from a specific table in the Supabase database.
244	    You provide filter conditions to identify which records to delete.
245	    
246	    Args:
247	        ctx: The MCP context
248	        table_name: Name of the table to delete records from
249	        filters: Dictionary of column-value pairs to filter which rows to delete
250	        
251	    Returns:
252	        Dictionary containing the deleted records and metadata
253	        
254	    Example:
255	        To delete inactive users:
256	            delete_table_records(
257	                table_name="users",
258	                filters={"is_active": False}
259	            )
260	    """
261	    supabase = ctx.request_context.lifespan_context.client
262	    
263	    # Start building the query
264	    query = supabase.table(table_name).delete()
265	    
266	    # Apply filters
267	    for column, value in filters.items():
268	        query = query.eq(column, value)
269	    
270	    # Execute the query
271	    response = query.execute()
272	    
273	    # Return the response
274	    return {
275	        "data": response.data,
276	        "count": len(response.data) if response.data else 0,
277	        "status": "success" if response.data else "error"
278	    }
279	
280	
281	if __name__ == "__main__":
