261	def _check_memvid_available() -> bool:
262	    """Check if memvid is available."""
263	    return MemvidEncoder is not None
264	
265	
266	async def _ensure_server_initialized() -> None:
267	    """Ensure server is initialized before processing tools."""
268	    if not _server_state.initialized:
269	        try:
270	            await _server_state.initialize()
271	        except Exception as e:
