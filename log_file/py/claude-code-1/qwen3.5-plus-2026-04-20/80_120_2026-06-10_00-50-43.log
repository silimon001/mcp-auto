175	@server.tool()
176	def send_email(email_content: EmailContent, ctx: Context) -> Dict[str, str]:
177	    """
178	    Sends an email from the user's Gmail account.
179	
180	    Args:
181	        email_content: A structured object containing the recipient, subject, and body.
182	    """
183	    creds = get_creds_from_context(ctx)
184	    try:
185	        gmail_service = googleapiclient.discovery.build('gmail', 'v1', credentials=creds)
186	        message = EmailMessage()
187	        message.set_content(email_content.body)
188	        message['To'] = email_content.to
189	        message['Subject'] = email_content.subject
190	
191	        encoded_message = base64.urlsafe_b64encode(message.as_bytes()).decode()
192	        create_message = {'raw': encoded_message}
193	        
194	        send_message = gmail_service.users().messages().send(userId="me", body=create_message).execute()
195	        return {"status": "Email sent successfully", "messageId": send_message['id']}
196	    except HttpError as e:
197	        raise Exception(f"API Gmail error (HTTP {e.status_code}): {e.reason}")
