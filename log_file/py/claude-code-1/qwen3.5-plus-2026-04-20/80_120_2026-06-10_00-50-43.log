256	async def check_all_tasks_complete(
257	    description: str,
258	    repo_path: str = ".",
259	) -> str:
260	    """Check if all tasks are complete and mark the task list as completed.
261	    
262	    Args:
263	        description: The description identifier of the task list file
264	        repo_path: Path to the repository root (defaults to current directory)
265	        
266	    Returns:
267	        Message indicating if the task list was marked as completed
268	    """
269	    # Find the task file
270	    task_file, content = find_task_file(description, repo_path)
271	    if not task_file:
272	        return f"Error: Could not find task list with description '{description}'"
273	    
274	    # Check if all tasks are complete
275	    all_tasks_complete = True
276	    incomplete_task_count = 0
277	    
278	    # Find all task lines
279	    task_matches = re.finditer(r'^\d+\.\s+\[([ x])\]', content, re.MULTILINE)
280	    for match in task_matches:
281	        if match.group(1) == ' ':  # Unchecked box
282	            all_tasks_complete = False
283	            incomplete_task_count += 1
284	    
285	    if not all_tasks_complete:
286	        return f"Task list has {incomplete_task_count} incomplete tasks. Cannot mark as completed."
287	    
288	    # If all tasks are complete, rename the file with the ✅ prefix
289	    filename = os.path.basename(task_file)
290	    if not filename.startswith(COMPLETED_PREFIX):
291	        task_dir = os.path.dirname(task_file)
292	        new_filename = f"{COMPLETED_PREFIX}{filename}"
293	        new_file_path = os.path.join(task_dir, new_filename)
294	        
295	        os.rename(task_file, new_file_path)
296	        return f"All tasks complete! Renamed task list to {new_filename}"
297	    else:
298	        return "All tasks are already complete and the list is marked as completed."
