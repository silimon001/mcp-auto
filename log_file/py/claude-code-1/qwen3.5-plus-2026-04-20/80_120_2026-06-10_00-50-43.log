366	    @app.post("/api/system/fs")
367	    async def list_fs(path: str = Form(".")):
368	        """List directories in path."""
369	        try:
370	            p = Path(path).resolve()
371	            if not p.exists():
372	                p = Path(".").resolve()
373	            
374	            # Windows drives check if parent is same (root)
375	            is_root = p.anchor == str(p)
376	            
377	            dirs = []
378	            
379	            # If windows and we want to list drives? 
380	            # Path("/") on windows goes to current drive root.
381	            # To list drives we need specific logic.
382	            # Simple workaround: if path is empty or special, show drives.
383	            # But python pathlib is tricky with drives.
384	            # Let's just list child directories of current path.
385	            
386	            # Up dir
387	            if not is_root:
388	                dirs.append({"name": "..", "path": str(p.parent)})
389	                
390	            for item in p.iterdir():
391	                try:
392	                    if item.is_dir() and not item.name.startswith("."):
393	                        dirs.append({"name": item.name, "path": str(item)})
394	                except PermissionError:
395	                    continue
396	            
397	            dirs.sort(key=lambda x: x["name"])
398	            
399	            return {"current": str(p), "dirs": dirs}
400	        except Exception as e:
401	            return {"error": str(e)}
