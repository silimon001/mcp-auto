1	"""
2	MCP server to control the robot.
3	"""
4	
5	from __future__ import annotations
6	
7	import io
8	import logging
9	from typing import List, Optional, Union
10	
11	import numpy as np
12	from PIL import Image as PILImage
13	
14	from mcp.server.fastmcp import FastMCP, Image
15	
16	from robot_controller import RobotController
17	from config import robot_config
18	
19	import atexit
20	import traceback
21	import time
22	
23	
24	logging.basicConfig(level=logging.INFO, format="%(asctime)s MCP_Server %(levelname)s: %(message)s")
25	logger = logging.getLogger(__name__) # Use a named logger for MCP server specifics if any
26	
27	# -----------------------------------------------------------------------------
28	# Initialise FastMCP server
29	# -----------------------------------------------------------------------------
30	
31	mcp = FastMCP(
32	    name="SO-ARM100 robot controller",
33	    port = 3001 # can use any other port
34	)
35	
36	# -----------------------------------------------------------------------------
37	# Helper functions
38	# -----------------------------------------------------------------------------
39	
40	_robot: Optional[RobotController] = None
41	
42	
43	def _np_to_mcp_image(arr_rgb: np.ndarray) -> Image:
44	    """Convert a numpy RGB image to MCP image format."""
45	    pil_img = PILImage.fromarray(arr_rgb)
46	    with io.BytesIO() as buf:
47	        pil_img.save(buf, format="JPEG")
48	        raw_data = buf.getvalue()
49	    return Image(data=raw_data, format="jpeg")
50	
51	
52	def get_robot() -> RobotController:
53	    """Lazy-initialise the global RobotController instance.
54	
55	    We avoid creating the controller at import time so the MCP Inspector can
56	    start even if the hardware is not connected. The first tool/resource call
57	    that actually needs the robot will trigger the connection.
58	    """
59	    global _robot
60	    if _robot is None:   
61	        try:
62	            _robot = RobotController()
63	            logger.info(f"RobotController initialized.")
64	
65	        except Exception as e:
66	            logger.error(f"MCP: FATAL - Error initializing robot: {e}", exc_info=True)
67	            raise SystemExit(f"MCP Server cannot start: RobotController failed to initialize ({e})")
68	            
69	    return _robot
70	
71	
72	def get_state_with_images(result_json: dict, is_movement: bool = False) -> List[Union[Image, dict, list]]:
73	    """Combine robot state with camera images into a unified response format.
74	    Returns a list containing:
75	    1. MCP images from all available cameras
76	    2. JSON with robot state and operation results
77	
78	    Args:
79	        result_json: The operation result in JSON format
80	        is_movement: If True, adds a small delay before capturing images to ensure they're current
81	    """
82	    robot = get_robot()
83	    try:
84	        if is_movement:
85	            time.sleep(1.0)  # wait until the robot moved before capturing images
86	        
87	        raw_imgs = robot.get_camera_images()
88	        
89	        if not raw_imgs:
90	            logger.warning("MCP: No camera images returned from robot controller.")
91	            return [result_json, "Warning: No camera images available."]
92	
93	        mcp_images = [_np_to_mcp_image(img) for img in raw_imgs.values()]
94	            
95	        # Keep only human_readable_state inside robot_state for clients
96	        result_json["robot_state"] = result_json["robot_state"]["human_readable_state"]
97	
98	        # Return combined response
99	        # I am not sure if it is the official way to return both json and images in one response
100	        # But it works with most clients I tested
101	        return [result_json] + mcp_images
102	    except Exception as e:
103	        logger.error(f"Error getting camera images: {str(e)}")
104	        logger.error(traceback.format_exc())
105	        # If camera access fails, still return state with empty image list
106	        return [result_json] + ["Error getting camera images"]
107	
108	
109	# -----------------------------------------------------------------------------
110	# Tools – read-only
111	# -----------------------------------------------------------------------------
112	
113	# Can be resource instead but some clients support only tools
114	# @mcp.resource("robot://description")
115	@mcp.tool(description="Get a description of the robot and instructions for the user. Run it before using any other tool.")
116	def get_initial_instructions() -> str:
117	    return robot_config.robot_description
118	
119	
120	@mcp.tool(description="Get current robot state with images from all cameras. Returns list of objects: json with results of the move and current state of the robot and images from all cameras")
121	def get_robot_state():
122	    robot = get_robot()
123	    move_result = robot.get_current_robot_state()
124	    result_json = move_result.to_json()
125	    logger.info(f"MCP: get_robot_state outcome: {result_json.get('status', 'success')}, Msg: {move_result.msg}")
126	    return get_state_with_images(result_json, is_movement=False)
127	
128	
129	# -----------------------------------------------------------------------------
130	# Tools – actuation
131	# -----------------------------------------------------------------------------
132	
133	@mcp.tool(
134	        description="""
135	        Move the robot with intuitive controls.
136	        Args:
137	            move_gripper_up_mm (float, optional): Distance to move gripper up (positive) or down (negative) in mm
138	            move_gripper_forward_mm (float, optional): Distance to move gripper forward (positive) or backward (negative) in mm
139	            tilt_gripper_down_angle (float, optional): Angle to tilt gripper down (positive) or up (negative) in degrees
140	            rotate_gripper_counterclockwise_angle (float, optional): Angle to rotate gripper (only the actual fingers to adjust the gripping angle) counterclockwise (positive) or clockwise (negative) in degrees
141	            rotate_robot_left_angle (float, optional): Angle to rotate entire robot (e.g. if the object is on the side) counterclockwise/left (positive) or counterclockwise/right (negative) in degrees
142	        Expected input format:
143	        {
144	            "move_gripper_up_mm": "10", # Will move up 1 cm
145	            "move_gripper_forward_mm": "-5", # Will move backward 5 mm
146	            "tilt_gripper_down_angle": "10", # Will tilt gripper down 10 degrees
147	            "rotate_gripper_counterclockwise_angle": "-15", # Will rotate gripper clockwise 15 degrees
148	            "rotate_robot_left_angle": "15" # Will rotate robot counterclockwise (to the left) 15 degrees
149	        }
150	        Returns:
151	            list: List containing:
152	                - JSON object with:
153	                    - status: Optional status in case of error
154	                    - message: Optional message
155	                    - warnings: Optional list of any warnings
156	                    - robot_state: Current robot state in human readable format
157	                - Camera images
158	    """
159	        )
160	def move_robot(
161	    move_gripper_up_mm=None, 
162	    move_gripper_forward_mm=None, 
163	    tilt_gripper_down_angle=None, 
164	    rotate_gripper_counterclockwise_angle=None, 
165	    rotate_robot_left_angle=None
166	):
167	    robot = get_robot()
168	    logger.info(f"MCP Tool: move_robot received: up={move_gripper_up_mm}, fwd={move_gripper_forward_mm}, "
169	                f"tilt={tilt_gripper_down_angle}, grip_rot={rotate_gripper_counterclockwise_angle}, "
170	                f"robot_rot={rotate_robot_left_angle}")
171	
172	    # All parameters are optional for execute_intuitive_move
173	    # Convert MCP tool parameters to match the arguments of execute_intuitive_move
174	    move_params = {
175	        "move_gripper_up_mm": float(move_gripper_up_mm) if move_gripper_up_mm is not None else None,
176	        "move_gripper_forward_mm": float(move_gripper_forward_mm) if move_gripper_forward_mm is not None else None,
177	        "tilt_gripper_down_angle": float(tilt_gripper_down_angle) if tilt_gripper_down_angle is not None else None,
178	        "rotate_gripper_counterclockwise_angle": float(rotate_gripper_counterclockwise_angle) if rotate_gripper_counterclockwise_angle is not None else None,
179	        "rotate_robot_left_angle": float(rotate_robot_left_angle) if rotate_robot_left_angle is not None else None,
180	    }
181	    
182	    # Filter out None values to pass only specified arguments to the robot controller method
183	    actual_move_params = {k: v for k, v in move_params.items() if v is not None}
184	    
185	    if not actual_move_params:
186	        current_state_result = robot.get_current_robot_state()
187	        result_json = current_state_result.to_json()
188	        result_json["message"] = "No movement parameters provided to move_robot tool."
189	        logger.info(f"MCP: move_robot outcome: {result_json.get('status', 'success')}, Msg: {result_json.get('message', '')}")
190	        return get_state_with_images(result_json, is_movement=False)
191	
192	    move_execution_result = robot.execute_intuitive_move(**actual_move_params)
193	    result_json = move_execution_result.to_json()
194	    
195	    logger.info(f"MCP: move_robot final outcome: {result_json.get('status', 'success')}, Msg: {result_json.get('message', '')}, Warnings: {len(result_json.get('warnings', []))}")
196	    
197	    return get_state_with_images(result_json, is_movement=True)
198	
199	
200	@mcp.tool(description="Control the robot's gripper openness from 0% (completely closed) to 100% (completely open). Expected input format: {gripper_openness_pct: '50'}. Returns list of objects: json with results of the move and current state of the robot and images from all cameras")
201	def control_gripper(gripper_openness_pct):
202	    robot = get_robot()
203	    
204	    try:
205	        openness = float(gripper_openness_pct)
206	        logger.info(f"MCP Tool: control_gripper called with openness={gripper_openness_pct}%")
207	        
208	        move_result = robot.set_joints_absolute({'gripper': openness})
209	        result_json = move_result.to_json()
210	        logger.info(f"MCP: control_gripper outcome: {result_json.get('status', 'success')}, Msg: {move_result.msg}, Warnings: {len(move_result.warnings)}")
211	        return get_state_with_images(result_json, is_movement=True)
212	        
213	    except (ValueError, TypeError) as e:
214	        logger.error(f"MCP: control_gripper received invalid input: {gripper_openness_pct}, error: {str(e)}")
215	        return {"status": "error", "message": f"Invalid gripper openness value: {str(e)}"}
216	
217	
218	# -----------------------------------------------------------------------------
219	# Graceful shutdown
220	# -----------------------------------------------------------------------------
221	
222	def _cleanup():
223	    """Disconnect from hardware on server shutdown."""
224	    global _robot
225	    if _robot is not None:
226	        try:
227	            _robot.disconnect()
228	        except Exception as e_disc:
229	            logger.error(f"MCP: Exception during _robot.disconnect(): {e_disc}", exc_info=True)
230	
231	atexit.register(_cleanup)
232	
233	# -----------------------------------------------------------------------------
234	# Entry point
235	# -----------------------------------------------------------------------------
236	
237	if __name__ == "__main__":
238	    logger.info("Starting MCP Robot Server...")
239	    try:
240	        mcp.run()
241	    except SystemExit as e:
242	        logger.error(f"MCP Server failed to start: {e}")
243	    except Exception as e_main:
244	        logger.error(f"MCP Server CRITICAL RUNTIME ERROR: {e_main}", exc_info=True) 
