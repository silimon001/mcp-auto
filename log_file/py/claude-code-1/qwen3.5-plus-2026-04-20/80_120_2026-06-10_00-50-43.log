614	@mcp.tool()
615	async def list_video_memories(ctx: Context, directory: Optional[str] = None) -> dict[str, Any]:
616	    """List available video memory files in a directory.
617	
618	    Searches for .mp4/.json pairs that represent complete video memories.
619	    Also updates the server's memory library state.
620	
621	    Args:
622	        directory: Directory to search for video memory files (defaults to server library directory)
623	
624	    Returns:
625	        Dictionary with list of discovered video memory files and their info.
626	    """
627	    try:
628	        # Use library directory as default
629	        if directory is None:
630	            directory = _server_state.library_dir
631	
632	        # Find all .mp4 files in directory
633	        mp4_pattern = os.path.join(directory, "*.mp4")
634	        mp4_files = glob.glob(mp4_pattern)
635	
636	        video_memories = []
637	        for mp4_file in mp4_files:
638	            base_name = os.path.splitext(mp4_file)[0]
639	            json_file = f"{base_name}.json"
640	
641	            if os.path.exists(json_file):
642	                try:
643	                    stat_mp4 = os.stat(mp4_file)
644	                    stat_json = os.stat(json_file)
645	
646	                    memory_info = {
647	                        "name": os.path.basename(base_name),
648	                        "video_path": mp4_file,
649	                        "index_path": json_file,
650	                        "video_size_mb": round(stat_mp4.st_size / (1024*1024), 2),
651	                        "index_size_kb": round(stat_json.st_size / 1024, 2),
652	                        "created": stat_mp4.st_mtime,
653	                        "is_current": mp4_file == _server_state.current_video_path
654	                    }
655	
656	                    video_memories.append(memory_info)
657	
658	                    # Update memory library (but don't mark as loaded unless it's current)
659	                    name = memory_info["name"]
660	                    if name not in _server_state.available_memories:
661	                        _server_state.available_memories[name] = {
662	                            "video_path": mp4_file,
663	                            "index_path": json_file,
664	                            "loaded": memory_info["is_current"]
665	                        }
666	
667	                except Exception as e:
668	                    logger.warning(f"Could not stat files for {base_name}: {e}")
669	
670	        video_memories.sort(key=lambda x: x["created"], reverse=True)
671	
672	        return {
673	            "status": "success",
674	            "directory": directory,
675	            "video_memories": video_memories,
676	            "count": len(video_memories),
677	            "current_memory": _server_state.current_video_path
678	        }
679	
680	    except Exception as e:
681	        logger.error(f"Failed to list video memories in {directory}: {e}")
682	        return {"status": "error", "message": str(e)}
