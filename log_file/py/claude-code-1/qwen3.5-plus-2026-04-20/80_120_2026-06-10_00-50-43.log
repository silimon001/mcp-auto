903	# Signal handling for graceful shutdown
904	def setup_signal_handlers() -> None:
905	    """Set up signal handlers for graceful shutdown."""
906	    def signal_handler(signum: int, frame) -> None:
907	        logger.info(f"Received signal {signum}, initiating shutdown")
908	        _server_state._shutdown_event.set()
909	        sys.exit(0)
910	
911	    signal.signal(signal.SIGTERM, signal_handler)
912	    signal.signal(signal.SIGINT, signal_handler)
913	
914	
915	def cleanup_handler() -> None:
916	    """Cleanup handler for atexit."""
917	    if _server_state.initialized:
918	        logger.info("Running cleanup handler")
919	        try:
920	            # Run cleanup in a new event loop
921	            loop = asyncio.new_event_loop()
922	            asyncio.set_event_loop(loop)
923	            try:
924	                loop.run_until_complete(_server_state.cleanup())
925	            finally:
926	                loop.close()
927	        except Exception as e:
928	            logger.error(f"Cleanup handler error: {e}")
929	
930	
931	# Register cleanup handler
932	atexit.register(cleanup_handler)
933	
934	
935	if __name__ == "__main__":
936	    # Set up signal handlers
937	    setup_signal_handlers()
938	
939	    try:
940	        logger.info("Starting memvid MCP server")
941	        mcp.run()
942	    except KeyboardInterrupt:
