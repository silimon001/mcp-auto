352	@mcp.tool()
353	async def add_chunks(ctx: Context, chunks: list[str]) -> dict[str, Any]:
354	    """Add text chunks to the Memvid encoder.
355	
356	    WORKFLOW REQUIREMENT: After adding all content, you MUST call build_video()
357	    before search_memory() or chat_with_memvid() will work.
358	
359	    Args:
360	        chunks: A list of text chunks to add to the encoder.
361	
362	    Returns:
363	        Status dictionary with success/error information.
364	
365	    Note: This only stages content. Call build_video() to complete the workflow.
366	    """
367	    try:
368	        encoder = await _ensure_encoder()
369	        # Redirect stdout during add_chunks operation
370	        with redirect_stdout(sys.stderr):
371	            encoder.add_chunks(chunks)
372	        logger.info(f"Successfully added {len(chunks)} chunks to encoder")
373	        return {"status": "success", "chunks_added": len(chunks)}
374	    except Exception as e:
375	        logger.error(f"Failed to add chunks: {e}")
376	        return {"status": "error", "message": str(e)}
