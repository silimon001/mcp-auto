300	@mcp.tool()
301	async def list_task_files(
302	    repo_path: str = ".",
303	    include_completed: bool = True
304	) -> str:
305	    """List all task files in the .tasks directory.
306	    
307	    Args:
308	        repo_path: Path to the repository root (defaults to current directory)
309	        include_completed: Whether to include completed task lists
310	        
311	    Returns:
312	        List of task files with their completion status
313	    """
314	    tasks_dir = os.path.join(repo_path, TASKS_FOLDER)
315	    if not os.path.exists(tasks_dir):
316	        return "No .tasks directory exists yet."
317	    
318	    # Get list of markdown files
319	    task_files = []
320	    for file in os.listdir(tasks_dir):
321	        if file.endswith('.md'):
322	            is_completed = file.startswith(COMPLETED_PREFIX)
323	            if include_completed or not is_completed:
324	                task_files.append((file, is_completed))
325	    
326	    if not task_files:
327	        return "No task lists found."
328	    
329	    # Format the output
330	    result = "## Task Lists\n\n"
331	    for filename, is_completed in sorted(task_files):
332	        status = "✅ Complete" if is_completed else "⏳ In Progress"
333	        description = filename.replace(COMPLETED_PREFIX, "").replace(".md", "")
334	        result += f"- **{description}**: {status}\n"
335	    
