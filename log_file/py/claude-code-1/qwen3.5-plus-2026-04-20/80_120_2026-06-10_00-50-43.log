4	from mcp.server import Server
5	import mcp.types as types
6	from .app_context import IBManager
7	
8	def create_mcp_server(ib_manager: IBManager) -> Server:
9	    server = Server("1c-code-search")
10	
11	    @server.list_tools()
12	    async def handle_list_tools() -> list[types.Tool]:
13	        return [
14	            types.Tool(
15	                name="search_code",
16	                description="Поиск кода в информационных базах 1С. Поддерживает семантический поиск.",
17	                inputSchema={
18	                    "type": "object",
19	                    "properties": {
20	                        "query": {
21	                            "type": "string", 
22	                            "description": "Текст запроса для поиска (например: 'как создать справочник' или 'функция расчета НДС')"
23	                        },
24	                        "ib": {
25	                            "type": "string", 
26	                            "description": "Имя информационной базы для поиска (необязательно). Если не указано, поиск идет по всем."
27	                        },
28	                        "limit": {
29	                            "type": "integer",
30	                            "description": "Количество результатов (по умолчанию 5)",
31	                            "default": 5
32	                        }
33	                    },
34	                    "required": ["query"]
35	                }
36	            ),
37	            types.Tool(
38	                name="list_ibs",
39	                description="Получить список доступных информационных баз 1С.",
40	                inputSchema={
41	                    "type": "object",
42	                    "properties": {}
43	                }
44	            )
45	        ]
46	
47	    @server.call_tool()
48	    async def handle_call_tool(name: str, arguments: dict | None) -> list[types.TextContent | types.ImageContent | types.EmbeddedResource]:
49	        if not arguments:
50	            arguments = {}
51	
52	        if name == "list_ibs":
53	            ibs = ib_manager.get_all_contexts()
54	            
55	            # Формируем красиво
56	            lines = ["Доступные базы:"]
57	            for ib in ibs:
58	                lines.append(f"- **{ib['name']}**: {ib['title']} (Статус: {ib['status']['status']})")
59	            
60	            return [types.TextContent(type="text", text="\n".join(lines))]
61	        
62	        if name == "search_code":
63	            query = arguments.get("query")
64	            ib_name = arguments.get("ib")
65	            limit = arguments.get("limit", 5)
66	            
67	            if not query:
68	                return [types.TextContent(type="text", text="Ошибка: Пустой запрос")]
69	
70	            results_text = []
71	            
72	            # Если указана база
73	            if ib_name:
74	                ctx = ib_manager.get_context(ib_name)
75	                if not ctx:
76	                    return [types.TextContent(type="text", text=f"Ошибка: База '{ib_name}' не найдена")]
77	                
78	                res = ctx.searcher.search(query, top_k=limit)
79	                results_text.append(f"Результаты поиска в **{ib_name}**:")
80	                results_text.append(_format_results(res))
81	            else:
82	                # По всем базам
83	                contexts = ib_manager.get_all_contexts()
84	                if not contexts:
85	                    return [types.TextContent(type="text", text="Нет подключенных баз.")]
86	
87	                all_res = []
88	                for ctx_info in contexts:
89	                    # ib_manager.get_all_contexts returns dicts, we need objects
90	                    # But wait, get_all_contexts returns list of dicts with status.
91	                    # We need the actual context object to search.
92	                    # IBManager should have a method to get real contexts or we use get_context in loop.
93	                    name = ctx_info['name']
94	                    ctx = ib_manager.get_context(name)
95	                    if ctx:
96	                        res = ctx.searcher.search(query, top_k=limit) # Search locally top_k
97	                        for r in res:
98	                            r['ib'] = name
99	                            all_res.append(r)
100	                
101	                # Sort by score
102	                all_res.sort(key=lambda x: x['score'], reverse=True)
103	                top_res = all_res[:limit]
104	                
105	                results_text.append(f"Результаты поиска по всем базам:")
106	                results_text.append(_format_results(top_res))
107	
108	            return [types.TextContent(type="text", text="\n".join(results_text))]
109	
110	        raise ValueError(f"Unknown tool: {name}")
111	
112	    return server
113	
114	def _format_results(results: List[Dict[str, Any]]) -> str:
115	    """Helper to format search results."""
116	    if not results:
117	        return "Ничего не найдено."
118	    
119	    out = []
120	    for i, r in enumerate(results, 1):
121	        score = f"{r['score']:.3f}"
122	        ib_info = f"[{r.get('ib', 'IB')}] " if 'ib' in r else ""
123	        file_path = r['payload'].get('file_path', 'unknown')
124	        code_snippet = r['payload'].get('text', '').strip()
125	        
126	        # Truncate code if too long
127	        if len(code_snippet) > 500:
128	             code_snippet = code_snippet[:500] + "..."
129	
130	        out.append(f"\n{i}. {ib_info}**{file_path}** (Score: {score})")
131	        out.append(f"```bsl\n{code_snippet}\n```")
132	    
133	    return "\n".join(out)
