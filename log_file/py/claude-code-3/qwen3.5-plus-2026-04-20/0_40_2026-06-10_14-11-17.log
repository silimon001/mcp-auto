282	@mcp.tool(description="Returns by default information on the Zotero library containing Research Papers collected by the User." \
283	                      "Good to call if you dont have a clear understanding yet what to ask from this tool. " \
284	                      "The returned information can be finetuned by asking for summary, collections, recent items, tags.")
285	async def get_zotero_information(properties: str = Field(default='summary', # pyright: ignore[reportRedeclaration]
286	                                                         description='Properties you are interested in getting. By default returns informational summary on the connected library.' \
287	                                                                     'otherwise provide comma-separated list containing: collections, recent, tags'),
288	                                 limit: Optional[int] = None,
289	                                 itemType: str = Field(default='-attachment', 
290	                                                        description=_zotero_item_type_desc),
291	                                 context: Optional[Context] = None) -> str:
292	    """Returns information of the library such as recent items, tags, or available collections
293	    
294	    Args:
295	        properties: Properties you are interested in getting. Comma-separated list, containing: ' \
296	                    'recent, tags, collections
297	        limit: Optional how many items to return for each property.
298	        itemType: Define item types to include/exclude, by default excludes attachments (-attachment).
299	    """
300	    try:
301	        properties : list[str] = [p.strip() for p in properties.split(',')]
302	
303	        response_data = {}
304	        
305	        if 'summary' in properties:
306	            # FIXME This should give a useful summary to setup the tool.
307	            response_data['library'] = _get_library_info()
308	            response_data['groups'] = _get_groups()
309	
310	            properties = ['recent', 'collections']
311	            limit = 10
312	
313	        if 'recent' in properties:
314	            response_data['recent'] = _get_recent_items(limit=limit, itemType=itemType)
315	        if 'tags' in properties:
316	            response_data['tags'] = _get_tags(limit=limit)
317	        if 'collections' in properties:
318	            response_data['collections'] = _get_collections(limit=limit)
319	        return json.dumps(response_data, indent=2)
320	    
321	    except Exception as e:
322	        if context and hasattr(context, '_fastmcp'):
323	            await context.error(f"Failed to fetch library metadata for: {properties}. Message: {str(e)}")
324	        
325	        return json.dumps({
326	                "error": f"Failed to fetch library metadata for: {properties}. Message: {str(e)}",
327	                "properties": properties,
328	        }, indent=2)
