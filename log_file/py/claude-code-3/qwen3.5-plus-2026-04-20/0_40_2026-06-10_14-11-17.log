153	class Client:
154	    def __init__(self):
155	        self.session: Optional[ClientSession] = None
156	        self.exit_stack = AsyncExitStack()
157	        self.tools = []
158	        self.process = None
159	        self._server_process_started = False  # 标记是否由我们启动了服务器进程
160	
161	    async def init(self, name: str, config: dict):
162	        type = config.get("type", None)
163	        
164	        if type == "stdio":
165	            await self.init_stdio(config)
166	        elif type == "sse":
167	            await self.init_sse(config)
168	        elif type == "streamable_http":
169	            await self.init_streamable_http(config)
170	        else:
171	            raise Exception(f"[FAIL] server {name}: Unknown transport type '{type}'. The available type options are 'stdio', 'sse', and 'streamable_http'.")       
172	
173	    async def init_stdio(self, config: dict):
174	        env = get_safe_value(config, "env")
175	        if env is None:
176	            env = {}
177	        # 强制添加清华源，解决连接超时问题
178	        env['UV_DEFAULT_INDEX'] = 'https://pypi.tuna.tsinghua.edu.cn/simple'
179	        env['UV_INDEX_URL'] = 'https://pypi.tuna.tsinghua.edu.cn/simple'
180	        
181	        server_params = StdioServerParameters(
182	            command=get_safe_value(config, "command"),
183	            args=get_safe_value(config, "args"),
184	            env=env,
185	            cwd=get_safe_value(config, "cwd"))
186	        stdio_transport = await self.exit_stack.enter_async_context(stdio_client(server_params))
187	        read_stream, write_stream = stdio_transport
188	        self.session = await self.exit_stack.enter_async_context(ClientSession(read_stream, write_stream))
189	        
190	        await self.session.initialize()
191	        response = await self.session.list_tools()
192	        self.tools = response.tools if hasattr(response, 'tools') else []
193	            
194	    async def init_sse(self, config: dict):
195	        url = get_safe_value(config, "url")
196	        headers = get_safe_value(config, "headers")
197	        if not url:
198	            raise ValueError("URL is required for SSE transport")
199	
200	        from urllib.parse import urlparse
201	        parsed = urlparse(url)
202	        if not parsed.path or parsed.path == "/":
203	            raise ValueError(
204	                "URL must include an endpoint path (e.g., /mcp, /sse). "
205	                "Got: {url}"
206	            )
207	
208	        if get_safe_value(config, 'command') is not None:
209	            command = get_safe_value(config, "command"),
210	            args = get_safe_value(config, "args")
211	            env = get_safe_value(config, "env")
212	            cwd = get_safe_value(config, "cwd")
213	            self.process = start_process(command,args,env,cwd,url)
214	            self._server_process_started = True
215	
216	        try:
217	            sse_transport = await self.exit_stack.enter_async_context(sse_client(url=url, headers=headers))
218	            read_stream, write_stream = sse_transport
219	            self.session = await self.exit_stack.enter_async_context(ClientSession(read_stream, write_stream))
220	        
221	            await self.session.initialize()
222	            response = await self.session.list_tools()
223	            self.tools = response.tools if hasattr(response, 'tools') else []
224	
225	        except Exception as e:
226	            print(f"[ERROR] Failed to connect the MCP server: {e}")
227	
228	            # ❗ 关键：失败时关闭 server
229	            await self._cleanup_server_process()
230	
231	            raise
232	
233	    async def init_streamable_http(self, config: dict):
234	        url = get_safe_value(config, "url")
235	        headers = get_safe_value(config, "headers")
236	        if not url:
237	            raise ValueError("URL is required for streamable_http transport")
238	        
239	        from urllib.parse import urlparse
240	        parsed = urlparse(url)
241	        if not parsed.path or parsed.path == "/":
242	            raise ValueError(
243	                "URL must include an endpoint path (e.g., /mcp, /sse). "
244	                f"Got: {url}"
245	            )
246	
247	        if get_safe_value(config, 'command') is not None:
248	            command = get_safe_value(config, "command")
249	            args = get_safe_value(config, "args")
250	            env = get_safe_value(config, "env")
251	            cwd = get_safe_value(config, "cwd")
252	
253	            self.process = start_process(command, args, env, cwd, url)
254	            self._server_process_started = True
255	
256	        try:
257	            import httpx
258	
259	            # 1. 创建带 headers 的 httpx 客户端
260	            http_client = httpx.AsyncClient(headers=headers)
261	
262	            # 2. 将客户端推入 exit_stack 以便自动关闭
263	            await self.exit_stack.enter_async_context(http_client)
264	
265	            # 3. 将自定义客户端传给 streamable_http_client
266	            transport = await self.exit_stack.enter_async_context(
267	                streamable_http_client(url=url, http_client=http_client)
268	            )
269	            read_stream, write_stream, _ = transport
270	
271	            self.session = await self.exit_stack.enter_async_context(
272	                ClientSession(read_stream, write_stream)
273	            )
274	
275	            await self.session.initialize()
276	            response = await self.session.list_tools()
277	            self.tools = response.tools if hasattr(response, 'tools') else []
278	
279	        except Exception as e:
280	            print(f"[ERROR] Failed to connect the MCP server: {e}")
281	
282	            # ❗ 关键：失败时关闭 server
283	            await self._cleanup_server_process()
284	
285	            raise
286	
287	    async def _cleanup_server_process(self):
288	        if self.process and self._server_process_started:
289	            print("[CLEANUP] Terminating MCP server process...")
290	
291	            try:
292	                self.process.terminate()
293	
294	                # 等待优雅退出
295	                try:
296	                    self.process.wait(timeout=5)
297	                except subprocess.TimeoutExpired:
298	                    print("[CLEANUP] Force killing MCP server...")
299	                    self.process.kill()
300	
301	            except Exception as e:
302	                print(f"[WARN] Failed to terminate process: {e}")
303	
304	            finally:
305	                self.process = None
306	                self._server_process_started = False
307	
308	    async def cleanup(self):
309	        """清理所有资源，确保正确释放"""
310	        try:
311	            await self.exit_stack.aclose()
312	        except Exception as e:
313	            print(f"[WARN] Cleanup error: {e}")
314	        finally:
315	            await self._cleanup_server_process()
316	            self.session = None
