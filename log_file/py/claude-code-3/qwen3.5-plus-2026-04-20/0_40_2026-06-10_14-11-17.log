391	def _get_tags(query: Optional[str] = None, 
392	              qmode: Optional[Literal["contains"] | Literal["startsWith"]] = Field(default=None, 
393	                                                                                   description='Searching tags that contain query (`contains`), or start with query (`startsWith`)'),
394	              limit: Optional[int] = None) -> list[dict[str, Any]] | dict[str, str]:
395	    """Return tags used in the Zotero library.
396	
397	        Args:
398	        limit: Optionally limit how many tags to return.
399	    """
400	    client = _get_zotero_client()
401	    items = client.tags(limit=limit, sort='dateModified')
402	    if not items:
403	        return {
404	                "error": "No tags found",
405	                "suggestion": "You need to create tags in your library"
406	               }
407	    
408	    return items # pyright: ignore[reportReturnType]
