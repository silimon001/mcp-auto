193	@mcp.tool()
194	def create_form(title: str, description: str = "") -> str:
195	    """
196	    Create a new Google Form
197	
198	    Args:
199	        title: The title of the form
200	        description: Optional description for the form
201	
202	    Returns:
203	        JSON with form ID and URL
204	    """
205	    service = get_forms_service()
206	    form = {
