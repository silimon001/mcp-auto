541	# FIXME: Misses way to provide PDF to Claude
542	# @mcp.tool(description="Retrieve PDF for item in the library")
543	async def get_item_pdf(item_key: str, 
544	                 attachment_index: int = Field(default=0), 
545	                 context: Optional[Context] = None) -> EmbeddedResource | str:
546	    """
547	    Get the PDF content for a specific paper.
548	    This returns the first PDF that is an attachement by default.
549	    
550	    Args:
551	        item_key: The paper's item key/ID
552	        attachement_index: Look at attachement with index (Default 0)
553	    """
554	    try:
555	        client = _get_zotero_client()
556	        children = client.children(item_key)
557	        pdf_attachments = [
558	            {
559	                'key': item['key'],
560	                'title': item['data'].get('title', 'Untitled'),
561	                'filename': item['data'].get('filename', 'Unknown'),
562	                'index': idx
563	            }
564	            for idx, item in enumerate(children)
565	            if item['data']['itemType'] == 'attachment' 
566	            and item['data'].get('contentType') == 'application/pdf'
567	        ]
568	        if len(pdf_attachments) == 0:
569	            return json.dumps({
570	                    "error": f"No PDF attachements found.",
571	                    "item_key": item_key,
572	                    "suggestion": "Check if this item has an attached PDF"
573	            }, indent=2)
574	        elif attachment_index >= len(pdf_attachments):
575	            return json.dumps({
576	                    "error": f"Invalid attachment index {attachment_index}",
577	                    "item_key": item_key,
578	                    "available_attachments": pdf_attachments,
579	                    "suggestion": f"Choose an index between 0 and {len(pdf_attachments)-1}"
580	                    }, indent=2)
581	        
582	        selected_attachment = pdf_attachments[attachment_index]
583	        pdf_uri = urllib.parse.unquote(client.file_url(selected_attachment['key']), encoding='utf-8', errors='replace')
584	        parsed_uri = urllib.parse.urlparse(pdf_uri)
585	        pdf_path = pathlib.Path(parsed_uri.path.lstrip('/'))
586	        try:
587	            with pdf_path.open('rb') as fp:
588	                pdf_content = fp.read()
589	                # pdf_resource = BlobResourceContents(
590	                #     uri=f"zotero://items/{item_key}/pdf", 
591	                #     mimeType="application/pdf", 
592	                #     blob=base64.b64encode(pdf_content).decode())
593	                # return EmbeddedResource(type='resource', resource=pdf_resource)
594	                return json.dumps({
595	                    "type": "resource",
596	                    "resource": {
597	                        "uri": f"zotero://items/{item_key}/pdf",
598	                        "mimeType": "application/pdf",
599	                        "blob": base64.b64encode(pdf_content).decode()
600	                    }
601	                }, indent=2)
602	            
603	        except FileNotFoundError:
604	            if hasattr(context, '_fastmcp'):
605	                await context.error(f"PDF file not found at {pdf_path} for item {item_key}")
606	            return json.dumps({
607	                    "error": "PDF file not found",
608	                    "item_key": item_key,
609	                    "path": str(pdf_path),
610	                    "suggestion": "Check if the PDF file exists in the expected location"
611	            }, indent=2)
612	        
613	    except Exception as e:
614	        if context and hasattr(context, '_fastmcp'):
615	            await context.error(f"Failed to fetch PDF: {str(e)}")
616	        return json.dumps({
617	                "error": f"Failed to fetch PDF. {str(e)}",
618	                "item_key": item_key,
619	        }, indent=2)
