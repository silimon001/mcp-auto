1	"""Configuration management for the Windows RS MCP server."""
2	
3	import os
4	from dataclasses import dataclass
5	
6	
7	@dataclass(frozen=True)
8	class Config:
9	    """Server configuration loaded from environment variables."""
10	
11	    # Playwright settings
12	    skip_playwright_install: bool
13	    playwright_browser: str
14	
15	    # Timeouts (in milliseconds)
16	    search_timeout: int
17	    page_load_timeout: int
18	    element_timeout: int
19	    results_timeout: int
20	
21	    # Cache settings
22	    cache_ttl: int  # seconds
23	    enable_cache: bool
24	
25	    # URLs
26	    windows_docs_base_url: str
27	    features_url: str
28	    search_index_url: str
29	
30	    @classmethod
31	    def from_env(cls) -> "Config":
32	        """Load configuration from environment variables with sensible defaults."""
33	        return cls(
34	            # Playwright settings
35	            skip_playwright_install=os.getenv(
36	                "MCP_SKIP_PLAYWRIGHT_INSTALL", "false"
37	            ).lower()
38	            in ("true", "1", "yes"),
39	            playwright_browser=os.getenv("MCP_PLAYWRIGHT_BROWSER", "chromium"),
40	            # Timeouts
41	            search_timeout=int(os.getenv("MCP_SEARCH_TIMEOUT", "2000")),
42	            page_load_timeout=int(os.getenv("MCP_PAGE_LOAD_TIMEOUT", "10000")),
43	            element_timeout=int(os.getenv("MCP_ELEMENT_TIMEOUT", "5000")),
44	            results_timeout=int(os.getenv("MCP_RESULTS_TIMEOUT", "5000")),
45	            # Cache settings
46	            cache_ttl=int(os.getenv("MCP_CACHE_TTL", "300")),  # 5 minutes default
47	            enable_cache=os.getenv("MCP_ENABLE_CACHE", "true").lower()
48	            in ("true", "1", "yes"),
49	            # URLs
50	            windows_docs_base_url=os.getenv(
51	                "MCP_WINDOWS_DOCS_URL",
52	                "https://microsoft.github.io/windows-docs-rs/doc/windows/index.html",
53	            ),
54	            features_url=os.getenv(
55	                "MCP_FEATURES_URL", "https://microsoft.github.io/windows-rs/features"
56	            ),
57	            search_index_url=os.getenv(
58	                "MCP_SEARCH_INDEX_URL",
59	                "https://microsoft.github.io/windows-docs-rs/doc/search-index.js",
60	            ),
61	        )
