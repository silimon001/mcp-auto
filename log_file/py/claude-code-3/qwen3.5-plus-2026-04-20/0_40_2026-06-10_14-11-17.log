141	@mcp.tool()
142	def append_sheet(spreadsheet_id: str, range_name: str, values: list) -> str:
143	    """
144	    Append data to a Google Sheet
145	
146	    Args:
147	        spreadsheet_id: The ID of the spreadsheet
