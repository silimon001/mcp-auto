loop 15 | Tool=Write, Args={"file_path": "/home/silimon/mcp-auto/mcp_server/961579916_MorDavid_ExternalAttacker-MCP/launcher.py", "content": "#!/usr/bin/env python3\n\"\"\"Launcher script: starts the Flask backend then runs the MCP server via stdio.\"\"\"\nimport subprocess\nimport sys\nimport os\nimport time\nimport signal\nimport urllib.request\n\n# Change to the directory of this script\nos.chdir(os.path.dirname(os.path.abspath(__file__)))\n\n# Start Flask backend\nprint(\"Starting Flask backend on port 6991...\", file=sys.stderr)\nflask_proc = subprocess.Popen(\n    [sys.executable, \"ExternalAttacker-App.py\"],\n    stdout=subprocess.PIPE,\n    stderr=subprocess.PIPE,\n)\n\n# Wait for Flask to be ready\nmax_retries = 30\nfor i in range(max_retries):\n    time.sleep(1)\n    try:\n        req = urllib.request.Request(\"http://localhost:6991/\", method=\"GET\")\n        urllib.request.urlopen(req, timeout=2)\n        print(\"Flask backend is ready.\", file=sys.stderr)\n        break\n    except Exception:\n        if i == max_retries - 1:\n            print(\"Flask backend failed to start.\", file=sys.stderr)\n            flask_proc.terminate()\n            sys.exit(1)\n\n\ndef cleanup(signum, frame):\n    flask_proc.terminate()\n    sys.exit(0)\n\n\nsignal.signal(signal.SIGINT, cleanup)\nsignal.signal(signal.SIGTERM, cleanup)\n\n# Now run the MCP server (which connects via stdio)\nprint(\"Starting MCP server...\", file=sys.stderr)\nimport ExternalAttacker_MCP  # type: ignore  # noqa: F401\n\n# The original file is ExternalAttacker-MCP.py - import won't work with hyphen\n# So we'll exec it instead\n"}
loop 16 | Tool=Write, Args={"file_path": "/home/silimon/mcp-auto/mcp_server/961579916_MorDavid_ExternalAttacker-MCP/run.sh", "content": "#!/bin/bash\n# Launcher script: starts Flask backend, then runs MCP server via stdio\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\ncd \"$SCRIPT_DIR\"\n\necho \"Starting Flask backend on port 6991...\" >&2\n/home/silimon/mcp-auto/mcp_server/961579916_MorDavid_ExternalAttacker-MCP/.venv/bin/python ExternalAttacker-App.py &\nFLASK_PID=$!\n\n# Wait for Flask to be ready\nfor i in $(seq 1 30); do\n    if curl -s http://localhost:6991/ > /dev/null 2>&1; then\n        echo \"Flask backend is ready.\" >&2\n        break\n    fi\n    sleep 1\ndone\n\n# Trap signals to clean up Flask\ncleanup() {\n    kill $FLASK_PID 2>/dev/null\n    exit 0\n}\ntrap cleanup INT TERM\n\n# Run the MCP server\n/home/silimon/mcp-auto/mcp_server/961579916_MorDavid_ExternalAttacker-MCP/.venv/bin/python ExternalAttacker-MCP.py\nFLASK_EXIT=$?\nkill $FLASK_PID 2>/dev/null\nexit $FLASK_EXIT\n"}
