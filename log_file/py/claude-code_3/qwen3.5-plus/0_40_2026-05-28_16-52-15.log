277	async def fuzz_endpoints(target: str, threads: int = 40,
278	                         wordlist: str = "https://raw.githubusercontent.com/danielmiessler/SecLists/refs/heads/master/Discovery/Web-Content/directory-list-2.3-medium.txt"):
279	    """
