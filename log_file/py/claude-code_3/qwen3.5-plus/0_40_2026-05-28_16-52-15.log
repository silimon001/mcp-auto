344	def _get_groups():
345	    client = _get_zotero_client()
346	    groups: list[dict[str, Any]] = client.groups() # pyright: ignore[reportAssignmentType]
347	    data: dict[int, dict] = {}
348	
349	    for group in groups:
350	        id = group['id']
351	        data[id] = {}
352	        data[id]['name']  = group['data']['name']
353	        data[id]['number_of_entries'] = group['meta']['numItems']
354	
355	    return data
