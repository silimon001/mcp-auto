357	def _get_recent_items(limit: Optional[int] = Field(default=10), 
358	                      itemType: str = Field(default='-attachment', 
359	                                            description='Define item types to include, by default excludes attachments'),
360	                     ) -> list[dict[str, Any]] | dict[str, str]:
361	    """Get recently added items (this by default excludes attachements) to your library
362	    
363	    Args:
364	        limit: Number of items to return (default: 10)
365	        itemType: Define item types to include, by default excludes attachments (default: -attachment)
366	    """
367	    try:
368	        client = _get_zotero_client()
369	        # Convert string limit to int and apply constraints
370	        limit_int = min(int(limit or 10), 100)
371	        
372	        items = client.items(limit=limit_int,
373	                             itemType=itemType,
374	                             sort='dateAdded', 
375	                             direction='desc',
376	                             )
377	        if not items:
378	            return {
379	                    "error": "No recent items found",
380	                    "suggestion": "Add some items to your Zotero library first"
381	                   }
382	            
383	        formatted_items = [client.format_item(item, include_abstract=False) for item in items]
384	        return formatted_items
385	    except ValueError:
386	        return {
387	                "error": "Invalid limit parameter",
388	                "suggestion": "Please provide a valid number for limit"
389	               }
