8	import mcp.server.stdio as stdio
9	import logging
10	from docling.document_converter import DocumentConverter, PdfFormatOption
11	from docling.datamodel.pipeline_options import PdfPipelineOptions
12	from pathlib import Path
13	
14	server = Server("docling-mcp")
15	
16	_log = logging.getLogger(__name__)
17	
18	@server.list_tools()
19	async def handle_list_tools() -> list[types.Tool]:
20	    return [
21	        types.Tool(
22	            name="convert",
23	            description=("Converts a document to another format"),
24	            inputSchema={
25	                "type": "object",
26	                "properties": {
27	                    "source": {
28	                        "type": "string",
29	                        "description": "The input file path"
30	                    },
31	                    "destination": {
32	                        "type": "string",
33	                        "description": "The output file path"
34	                    }
35	                },
36	                "required": ["source"]
37	            },
38	        )
39	    ]
40	
41	@server.call_tool()
42	async def handle_call_tool(name: str, params: dict | None) -> list[types.TextContent | types.ImageContent | types.EmbeddedResource]:
43	    if name not in ["convert"]:
44	        raise ValueError(f"Unknown tool: {name}")
45	    
46	    print(params)
47	
48	    if not params:
49	        raise ValueError("No parameters provided")
50	    
51	    input_file = params.get("source")
52	    output_file = params.get("destination")
53	
54	    if not input_file:
55	        raise ValueError("No input file provided")
56	    
57	    try:
58	        pipeline_options = PdfPipelineOptions()
59	        pipeline_options.do_ocr = True
60	        pipeline_options.ocr_options.use_gpu = False  # <-- set this.
61	        pipeline_options.do_table_structure = True
62	        pipeline_options.table_structure_options.do_cell_matching = True
63	
64	        doc_converter = DocumentConverter()   
65	        start_time = time.time()
66	        conv_result = doc_converter.convert(Path(input_file))
67	        end_time = time.time() - start_time
68	        _log.info(f"Document converted in {end_time:.2f} seconds.")
69	        output_dir = Path(output_file)
70	        
71	        if not output_file:
72	            notify = f"Converted Content saved to {conv_result.document.export_to_markdown()}."
73	        else:
74	            with (output_dir).open("w", encoding="utf-8") as fp:
75	                fp.write(conv_result.document.export_to_markdown())
76	            notify = f"Converted Content saved to {output_dir}."
77	        _log.info(f"got this: {notify}")
78	        return [types.TextContent(type="text", text=notify)]
79	    except Exception as e:
80	        raise ValueError(f"Error converting file: {e}")
81	
82	async def main():
83	
84	    logging.basicConfig(level=logging.INFO)
85	
