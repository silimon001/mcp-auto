1	"""Main entry point for the Linux MCP Server."""
2	
3	import logging
4	import sys
5	
6	from linux_mcp_server import __version__
7	from linux_mcp_server.config import CONFIG
8	from linux_mcp_server.logging_config import setup_logging
9	from linux_mcp_server.server import main
10	
11	
12	def cli():
13	    """Console script entry point for the Linux MCP Server."""
14	
15	    if CONFIG.version:
16	        print(__version__)  # noqa: T201
17	        sys.exit(0)
18	
19	    setup_logging()
20	
21	    logger = logging.getLogger("linux-mcp-server")
22	    logger.info(f"Running Linux MCP Server {__version__}. Press Ctrl+C, Enter to stop the server.")
23	
24	    try:
25	        # FastMCP.run() creates its own event loop, don't use asyncio.run()
26	        main()
27	    except KeyboardInterrupt:
28	        logger.info("Linux MCP Server stopped by user")
29	        sys.exit(0)
30	    except Exception as e:
31	        logger.critical(f"Fatal error in Linux MCP Server: {e}", exc_info=True)
32	        sys.exit(1)
33	
34	
35	if __name__ == "__main__":
36	    cli()
37	

