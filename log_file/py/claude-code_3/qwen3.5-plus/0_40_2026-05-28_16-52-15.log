97	    def format_item(self, item: dict[str, Any], 
98	                    include_abstract: bool = True) -> dict[str, Any]:
99	        """Format a Zotero item into a standardized dictionary"""
100	        data = item.get('data', {})
101	
102	        itemType = data.get('itemType', 'Unknown type')
103	        
104	        formatted = {
105	            'title': data.get('title', 'Untitled'),
106	            'key': data.get('key'),
107	            'itemType': itemType,
108	            'date': data.get('date', 'No date'),
109	        }
110	
111	        if itemType == 'note':
112	            formatted.update(self.format_note(item))
113	        else:
114	            formatted.update({
115	                'authors': self.format_creators(data.get('creators', [])),
116	            })
117	            if include_abstract:
118	                formatted['abstractNote'] = data.get('abstractNote', 'No abstract available')
119	        
120	        if 'DOI' in data:
121	            formatted['doi'] = data['DOI']
122	        if 'url' in data:
123	            formatted['url'] = data['url']
124	        if 'publicationTitle' in data:
125	            formatted['publicationTitle'] = data['publicationTitle']
126	        if 'tags' in data:
127	            formatted['tags'] = [t.get('tag') for t in data.get('tags', []) if t.get('tag')]
128	        if 'children' in data:
129	            formatted['numAttachements'] = data.get("meta", {}).get("numChildren", 0)
130	
131	        if 'BBT_key' in item:
132	            formatted['bibtexKey'] = item['BBT_key']
133	
134	        return formatted
135	
136	    def format_creators(self, creators: list[dict[str, str]]) -> str:
137	        """Format creator names into a string"""
138	        names = []
139	        for creator in creators:
140	            name_parts = []
141	            if creator.get('firstName'):
142	                name_parts.append(creator['firstName'])
143	            if creator.get('lastName'):
144	                name_parts.append(creator['lastName'])
145	            if name_parts:
146	                names.append(' '.join(name_parts))
147	        return ', '.join(names) or "No authors listed"
148	
149	    def format_note(self, item: dict[str, Any]) -> dict[str, Any]:
150	        data = item.get('data', {})
151	        formatted = {}
152	
153	        formatted['parent'] = data.get("parentItem", "")
154	        formatted['last_modified'] = data.get("dateModified", "")
155	
156	        note_content = data.get("note", "")
157	
158	        def simple_html_to_md(html):
159	            """Convert simple HTML formatting to Markdown
160	            
161	            Could be replaced with more advanced code in the future.
162	            """
163	            # Handle headings
164	            for i in range(6, 0, -1):
165	                html = html.replace(f"<h{i}>", f"{'#' * i} ").replace(f"</h{i}>", "\n\n")
166	            
167	            # Handle basic formatting
168	            html = html.replace("<strong>", "**").replace("</strong>", "**")
169	            html = html.replace("<b>", "**").replace("</b>", "**")
170	            html = html.replace("<em>", "*").replace("</em>", "*")
171	            html = html.replace("<i>", "*").replace("</i>", "*")
172	            
173	            # Handle lists
174	            html = html.replace("<ul>", "\n").replace("</ul>", "\n")
175	            html = html.replace("<ol>", "\n").replace("</ol>", "\n")
176	            html = html.replace("<li>", "- ").replace("</li>", "\n")
177	            
178	            # Handle paragraphs and line breaks
179	            html = html.replace("<p>", "").replace("</p>", "\n\n")
180	            html = html.replace("<br>", "\n").replace("<br/>", "\n").replace("<br />", "\n")
181	            
182	            # Handle links
183	            html = re.sub(r'<a href="([^"]+)"[^>]*>(.*?)</a>', r'[\2](\1)', html)
184	            
185	            # Remove any remaining HTML tags
186	            html = re.sub(r'<[^>]*>', '', html)
187	            return html.strip()
188	
189	        formatted['note'] = simple_html_to_md(note_content)
190	        
191	        return formatted
