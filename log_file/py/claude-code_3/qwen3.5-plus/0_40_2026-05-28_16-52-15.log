44	    def _check_better_bibtex_endpoint(self) -> bool:
45	        """Check if the Better BibTeX JSON-RPC endpoint exists"""
46	        try:
47	            response = httpx.get("http://localhost:23119/better-bibtex/json-rpc", timeout=1.0)
48	            return response.status_code == 200
49	        except (httpx.RequestError, httpx.TimeoutException):
50	            return False
51	
52	    def _check_bbt_library_ready(self) -> bool:
53	        """Check if the Better BibTeX library is ready via JSON-RPC api.ready() call
54	        
55	           Caches the result, because this is just delay after Zotero is started.
56	        """
57	        if not self.BBT:
58	            return False
59	            
60	        # Return cached result if we've already confirmed it's ready
61	        if self._bbt_ready_cache is True:
62	            return True
63	            
64	        try:
65	            payload = {
66	                "jsonrpc": "2.0",
67	                "method": "api.ready",
68	                "params": [],
69	                "id": 1
70	            }
71	            
72	            response = httpx.post(
73	                "http://localhost:23119/better-bibtex/json-rpc",
74	                json=payload,
75	                headers={
76	                    "Content-Type": "application/json",
77	                    "Accept": "application/json"
78	                },
79	                timeout=2.0
80	            )
81	            
82	            if response.status_code == 200:
83	                result = response.json()
84	                # Check if we got a valid response with both zotero and betterbibtex versions
85	                if "result" in result and isinstance(result["result"], dict):
86	                    ready = "betterbibtex" in result["result"] and "zotero" in result["result"]
87	                    if ready:
88	                        # Cache positive result
89	                        self._bbt_ready_cache = True
90	                    return ready
91	            
92	            return False
93	            
94	        except (httpx.RequestError, httpx.TimeoutException, json.JSONDecodeError):
95	            return False
