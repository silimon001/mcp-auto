8	#   "utcp-http==1.0.1",
9	# ]
10	# ///
11	"""FastMCP stdio server that proxies UTCP client functionalities as tools.
12	
13	This server provides MCP tools that expose the core UTCP client operations:
14	- Registering and deregistering tool providers
15	- Calling tools through providers
16	- Searching for available tools
17	- Loading providers from a JSON configuration file
18	- Getting required variables for tools
19	
20	The server automatically loads providers from a 'providers.json' file in the same directory.
21	"""
22	
23	import asyncio
24	import json
25	from pathlib import Path
26	from typing import Any, Dict, Optional
27	
28	from fastmcp import FastMCP
29	from pydantic import BaseModel, Field
30	
31	# UTCP imports
32	from utcp.utcp_client import UtcpClient
33	from utcp.data.utcp_client_config import UtcpClientConfig
34	from utcp.data.call_template import CallTemplate
35	
36	# Global UTCP client instance
37	utcp_client: Optional[UtcpClient] = None
38	
39	# Initialize FastMCP server
40	mcp = FastMCP("UTCP Client MCP Server")
41	
42	async def initialize_utcp_client():
43	    """Initialize the UTCP client and try to load providers.json from the same directory."""
44	    global utcp_client
45	    
46	    if utcp_client is not None:
47	        return utcp_client
48	    
49	    script_dir = Path(__file__).parent
50	    config_file = script_dir / ".utcp_config.json"
51	    
52	    if config_file.exists():
53	        config = json.loads(config_file.read_text())
54	        config = UtcpClientConfig.model_validate(config)
55	    else:
56	        config = UtcpClientConfig()
57	
58	    # Create UTCP client
59	    utcp_client = await UtcpClient.create(config=config)
60	    
61	    return utcp_client
62	
63	
64	@mcp.tool()
65	async def register_manual(manual_call_template: CallTemplate) -> Dict[str, Any]:
66	    """Register a new tool provider with the UTCP client.
67	    
68	    Args:
69	        manual_call_template: Call template to the endpoint of a UTCP Manual
70	        
71	    Returns:
72	        Dictionary with success status and list of registered tools
73	    """
74	    client = await initialize_utcp_client()
75	    
76	    try:
77	        tools = await client.register_manual(manual_call_template)
78	        
79	        return {
80	            "success": True,
81	            "manual_name": manual_call_template.name,
82	            "tools_registered": len(tools),
83	            "tool_names": [tool.name for tool in tools]
84	        }
85	    except Exception as e:
86	        return {
87	            "success": False,
88	            "error": str(e)
89	        }
90	
91	
92	@mcp.tool()
93	async def deregister_manual(manual_name: str) -> Dict[str, Any]:
94	    """Deregister a tool provider from the UTCP client.
95	    
96	    Args:
97	        manual_name: Name of the manual to deregister
98	        
99	    Returns:
100	        Dictionary with success status
101	    """
102	    client = await initialize_utcp_client()
103	    
104	    try:
105	        await client.deregister_manual(manual_name)
106	        return {
107	            "success": True,
108	            "message": f"Manual '{manual_name}' deregistered successfully"
109	        }
110	    except Exception as e:
111	        return {
112	            "success": False,
113	            "error": str(e)
114	        }
115	
116	
117	@mcp.tool()
118	async def call_tool(tool_name: str, arguments: Dict[str, Any]) -> Dict[str, Any]:
119	    """Call a tool through the UTCP client.
120	    
121	    Args:
122	        tool_name: Name of the tool to call
123	        arguments: Arguments for the tool call
124	        
125	    Returns:
126	        Dictionary with success status and tool result
127	    """
128	    client = await initialize_utcp_client()
129	    
130	    try:
131	        result = await client.call_tool(tool_name, arguments)
132	        return {
133	            "success": True,
134	            "tool_name": tool_name,
135	            "result": result
136	        }
137	    except Exception as e:
138	        return {
139	            "success": False,
140	            "tool_name": tool_name,
141	            "error": str(e)
142	        }
143	
144	
145	@mcp.tool()
146	async def search_tools(task_description: str, limit: int = 10) -> Dict[str, Any]:
147	    """Search for tools using a query string.
148	    
149	    Args:
150	        task_description: Description of the task to search for tools
151	        limit: Optional limit on the number of tools to return
152	        
153	    Returns:
154	        Dictionary with success status and matching tools
155	    """
156	    client = await initialize_utcp_client()
157	    
158	    try:
159	        tools = await client.search_tools(task_description, limit)
160	        return {"tools": [{"name": tool.name, "description": tool.description, "input_schema": tool.inputs.model_dump(exclude_none=True)} for tool in tools]}
161	    except Exception as e:
162	        return {"error": str(e)}
163	
164	
165	@mcp.tool()
166	async def get_required_keys_for_tool(tool_name: str) -> Dict[str, Any]:
167	    """Get required environment variables for a registered tool.
168	    
169	    Args:
170	        tool_name: Name of the tool to get variables for
171	        
172	    Returns:
173	        Dictionary with success status and required variables
174	    """
175	    client = await initialize_utcp_client()
176	    
177	    try:
178	        variables = await client.get_required_variables_for_registered_tool(tool_name)
179	        return {
180	            "success": True,
181	            "tool_name": tool_name,
182	            "required_variables": variables
183	        }
184	    except Exception as e:
185	        return {
186	            "success": False,
187	            "error": str(e)
188	        }
189	
190	
191	@mcp.tool()
192	async def tool_info(tool_name: str) -> Dict[str, Any]:
193	    """Get complete information about a specific tool including all details using model_dump().
194	    
195	    Args:
196	        tool_name: Name of the tool to get complete information for
197	        
198	    Returns:
199	        Dictionary with success status and complete tool information with model_dump()
200	    """
201	    client = await initialize_utcp_client()
202	    
203	    try:
204	        # Search for the specific tool
205	        tool = await client.config.tool_repository.get_tool(tool_name)
206	        
207	        if not tool:
208	            return {
209	                "success": False,
210	                "error": f"Tool '{tool_name}' not found"
211	            }
212	        
213	        # Return complete tool information with model_dump()
214	        return {
215	            "success": True,
216	            "tool": tool.model_dump()
217	        }
218	    except Exception as e:
219	        return {
220	            "success": False,
221	            "error": str(e)
222	        }
223	
224	async def main():
225	    global utcp_client
226	    utcp_client = await initialize_utcp_client()
227	    await mcp.run_async(transport="stdio")
228	
229	if __name__ == "__main__":
230	    # Run the FastMCP server
231	    asyncio.run(main())
232	

