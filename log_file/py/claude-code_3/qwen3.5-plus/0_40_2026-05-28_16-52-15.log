26	    def __init__(self):
27	        try:
28	            user_id = os.getenv('ZOTERO_USER_ID')
29	            if user_id is None:
30	                user_id = 0
31	            super().__init__(1, 'user', '', local=True) #FIXME: Work around a bug #202 in pyzotero.
32	            self.library_id = user_id
33	            
34	            # Check if BetterBibTeX endpoint exists and verify if the library is ready.
35	            self.BBT = self._check_better_bibtex_endpoint()
36	            self._check_bbt_library_ready()
37	            
