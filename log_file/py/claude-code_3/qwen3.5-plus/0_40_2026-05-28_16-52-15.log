284	        threads: Number of concurrent threads to use
285	        wordlist: Path to wordlist to use
286	    """
287	    if "://" in wordlist:
288	        r = requests.get(wordlist)
289	        path = os.path.join(os.getcwd(), wordlist.split("/")[-1])
290	        with open(path, "w") as f:
291	            f.write(r.text)
292	        wordlist = path
293	    else:
294	        if not os.path.exists(wordlist):
295	            raise FileNotFoundError(f"File {wordlist} not found")
296	    command = [
297	        "ffuf",
298	        "-s",
299	        "-w", wordlist,
300	        "-u", target+"/FUZZ",
301	        "-t", str(threads)
302	    ]
303	    return run_command(command)
