1	"""Main indexing engine orchestrating vector and graph stores.
2	
3	Design Decision: Composition Over Inheritance
4	
5	Rationale: IndexingEngine composes VectorStore, GraphStore, and HybridSearcher
6	rather than inheriting functionality. This follows SOLID principles and allows
7	independent testing and evolution of each component.
8	
9	Architecture:
10	- IndexingEngine: Orchestration layer (this file)
11	- VectorStore: ChromaDB semantic search
12	- GraphStore: NetworkX relationship queries
13	- HybridSearcher: Result combination logic
14	
15	Trade-offs:
16	- Maintainability: Clear separation of concerns vs. single monolithic class
17	- Testability: Each component independently testable
18	- Complexity: More files to navigate vs. everything in one place
19	
20	Extension Points:
21	- Swap vector store backend (Qdrant, FAISS)
22	- Swap graph backend (Neo4j)
23	- Adjust hybrid weighting via HybridSearcher configuration
24	"""
25	
26	import logging
27	from dataclasses import dataclass
28	from datetime import datetime
29	from pathlib import Path
30	from typing import TYPE_CHECKING, Any, Optional
31	
32	from mcp_skills.models.config import MCPSkillsConfig
33	from mcp_skills.models.skill import Skill
34	from mcp_skills.services.indexing.graph_store import GraphStore
35	from mcp_skills.services.indexing.hybrid_search import HybridSearcher, ScoredSkill
36	from mcp_skills.services.indexing.vector_store import VectorStore
37	
38	
39	if TYPE_CHECKING:
40	    from mcp_skills.services.skill_manager import SkillManager
41	
42	
43	logger = logging.getLogger(__name__)
44	
45	
46	@dataclass
47	class IndexStats:
48	    """Index statistics.
49	
50	    Attributes:
51	        total_skills: Total number of indexed skills
52	        vector_store_size: Size of vector store in bytes
53	        graph_nodes: Number of nodes in knowledge graph
54	        graph_edges: Number of edges in knowledge graph
55	        last_indexed: Timestamp of last indexing operation
56	    """
57	
58	    total_skills: int
59	    vector_store_size: int
60	    graph_nodes: int
61	    graph_edges: int
62	    last_indexed: str
63	
64	
65	class IndexingEngine:
66	    """Build and maintain vector + KG indices for skill discovery.
67	
68	    Combines vector embeddings for semantic search with knowledge graph
69	    for relationship-based discovery.
70	
71	    Architecture:
72	        - Vector Store: ChromaDB for semantic similarity
73	        - Knowledge Graph: NetworkX for skill relationships
74	        - Embeddings: sentence-transformers/all-MiniLM-L6-v2
75	        - Hybrid Search: 70% vector + 30% graph weighting
76	
77	    Performance Requirements:
78	    - Batch indexing: Index all skills at once when possible
79	    - Cache embeddings: Don't regenerate if skill unchanged
80	    - Graph queries: Use NetworkX shortest_path, neighbors for efficiency
81	    - ChromaDB queries: Use where filters for metadata filtering
82	
83	    Error Handling:
84	    - ChromaDB connection failures → Log error, raise RuntimeError
85	    - Missing skills during indexing → Log warning, skip
86	    - Invalid embeddings → Log error, skip skill
87	    - Graph cycles in dependencies → Allow (use DiGraph, no cycle checking)
88	
89	    Example:
90	        >>> from pathlib import Path
91	        >>> engine = IndexingEngine(
92	        ...     skill_manager=manager,
93	        ...     storage_path=Path.home() / ".mcp-skillset"
94	        ... )
95	        >>> stats = engine.reindex_all(force=True)
96	        >>> results = engine.search("python testing", top_k=5)
97	        >>> results[0].skill.name
98	        'pytest-testing'
99	    """
100	
101	    # Hybrid search weights (delegated to HybridSearcher)
102	    VECTOR_WEIGHT = 0.7
103	    GRAPH_WEIGHT = 0.3
104	
105	    def __init__(
106	        self,
107	        vector_backend: str = "chromadb",
108	        graph_backend: str = "networkx",
109	        skill_manager: Optional["SkillManager"] = None,
110	        storage_path: Path | None = None,
111	        config: MCPSkillsConfig | None = None,
112	    ) -> None:
113	        """Initialize indexing engine with optional configuration.
114	
115	        Args:
116	            vector_backend: Vector store backend (chromadb, qdrant, faiss)
117	            graph_backend: Knowledge graph backend (networkx, neo4j)
118	            skill_manager: SkillManager instance for skill loading
119	            storage_path: Path to store ChromaDB data (defaults to ~/.mcp-skillset/chromadb/)
120	            config: Optional MCPSkillsConfig for hybrid search weights and other settings
121	
122	        Raises:
123	            RuntimeError: If ChromaDB or component initialization fails
124	        """
125	        self.vector_backend = vector_backend
126	        self.graph_backend = graph_backend
127	        self.skill_manager = skill_manager
128	        self.storage_path = storage_path or (Path.home() / ".mcp-skillset" / "chromadb")
129	        self.config = config
130	
131	        # Ensure storage directory exists
132	        self.storage_path.mkdir(parents=True, exist_ok=True)
133	
134	        # Determine graph persistence path
135	        # For test isolation: custom storage paths store graph inside their directory
136	        # For production: use standard ~/.mcp-skillset/indices/ location
137	        if config and config.knowledge_graph.persist_path:
138	            self._graph_path = config.knowledge_graph.persist_path
139	        else:
140	            default_storage = Path.home() / ".mcp-skillset" / "chromadb"
141	            if self.storage_path == default_storage:
142	                # Production: use standard location for backward compatibility
143	                self._graph_path = (
144	                    Path.home() / ".mcp-skillset" / "indices" / "knowledge_graph.pkl"
145	                )
146	            else:
147	                # Custom/test: store graph inside storage_path for isolation
148	                self._graph_path = self.storage_path / "knowledge_graph.pkl"
149	
150	        # Initialize components
151	        try:
152	            self.vector_store = VectorStore(persist_directory=self.storage_path)
153	            self.graph_store = GraphStore()
154	
155	            # Try to load existing graph from disk
156	            if self._graph_path.exists():
157	                loaded = self.graph_store.load(self._graph_path)
158	                if loaded:
159	                    stats = self.graph_store.get_stats()
160	                    logger.info(
161	                        f"Loaded persisted knowledge graph: "
162	                        f"{stats['nodes']} nodes, {stats['edges']} edges"
163	                    )
164	
165	            # Initialize HybridSearcher with weights from config if available
166	            if config:
167	                self.hybrid_searcher = HybridSearcher(
168	                    vector_store=self.vector_store,
169	                    graph_store=self.graph_store,
170	                    skill_manager=skill_manager,
171	                    vector_weight=config.hybrid_search.vector_weight,
172	                    graph_weight=config.hybrid_search.graph_weight,
173	                )
174	                logger.info(
175	                    f"IndexingEngine initialized with hybrid search weights: "
176	                    f"vector={config.hybrid_search.vector_weight:.2f}, "
177	                    f"graph={config.hybrid_search.graph_weight:.2f}"
178	                )
179	            else:
180	                # No config - use defaults
181	                self.hybrid_searcher = HybridSearcher(
182	                    vector_store=self.vector_store,
183	                    graph_store=self.graph_store,
184	                    skill_manager=skill_manager,
185	                )
186	                logger.info(
187	                    "IndexingEngine initialized with default hybrid search weights"
188	                )
189	
190	        except Exception as e:
191	            logger.error(f"Failed to initialize IndexingEngine: {e}")
192	            raise RuntimeError(f"IndexingEngine initialization failed: {e}") from e
193	
194	        # Track last indexing time
195	        self._last_indexed: datetime | None = None
196	
197	    def index_skill(self, skill: Skill) -> None:
198	        """Add skill to vector + KG stores.
199	
200	        Indexing Flow:
201	        1. Index in vector store (embeddings + metadata)
202	        2. Add node to graph store
203	        3. Add edges for dependencies, category, tags
204	
205	        Args:
206	            skill: Skill object to index
207	
208	        Raises:
209	            RuntimeError: If indexing fails critically (but typically logs and continues)
210	        """
211	        try:
212	            # 1. Index in vector store
213	            self.vector_store.index_skill(skill)
214	
215	            # 2. Add node to knowledge graph
216	            self.graph_store.add_skill(skill)
217	
218	            # 3. Add relationships (edges)
219	            self.graph_store.add_relationships(skill)
220	
221	            logger.debug(f"Indexed skill: {skill.id}")
222	
223	        except Exception as e:
224	            logger.error(f"Failed to index skill {skill.id}: {e}")
225	            # Don't raise - allow indexing to continue for other skills
226	
227	    def build_embeddings(self, skill: Skill) -> list[float]:
228	        """Generate embeddings from skill content.
229	
230	        Delegates to VectorStore for embedding generation.
231	
232	        Args:
233	            skill: Skill to generate embeddings for
234	
235	        Returns:
236	            Embedding vector as list of floats
237	
238	        Performance:
239	        - Time Complexity: O(n) where n = text length
240	        - ~15ms per skill on CPU, ~3ms on GPU
241	        - Embeddings cached by ChromaDB (no regeneration needed)
242	
243	        Error Handling:
244	        - Empty text: Returns empty list
245	        - Encoding errors: Logs error and returns empty list
246	        """
247	        return self.vector_store.build_embeddings(skill)
248	
249	    def extract_relationships(self, skill: Skill) -> list[tuple[str, str, str]]:
250	        """Identify skill dependencies and relationships.
251	
252	        Delegates to GraphStore for relationship extraction.
253	
254	        Args:
255	            skill: Skill to extract relationships from
256	
257	        Returns:
258	            List of (source_id, relation_type, target_id) tuples
259	        """
260	        return self.graph_store.extract_relationships(skill)
261	
262	    def reindex_all(self, force: bool = False) -> IndexStats:
263	        """Rebuild indices from scratch.
264	
265	        Reindexing Process:
266	        1. Clear existing indices (if force=True)
267	        2. Discover all skills via SkillManager
268	        3. Generate embeddings for all skills
269	        4. Build knowledge graph relationships
270	        5. Return statistics
271	
272	        Args:
273	            force: Force rebuild even if indices exist
274	
275	        Returns:
276	            Index statistics after rebuild
277	
278	        Performance:
279	        - Time Complexity: O(n * m) where n = skills, m = avg text length
280	        - Expected: ~2-5 seconds for 100 skills on CPU
281	        - Batch processing for efficiency
282	
283	        Error Handling:
284	        - SkillManager not set → Raise RuntimeError
285	        - Skill loading failures → Log warning and skip
286	        - Embedding failures → Log error and skip
287	        """
288	        if not self.skill_manager:
289	            raise RuntimeError(
290	                "SkillManager not set. Pass skill_manager to __init__() "
291	                "or set self.skill_manager before calling reindex_all()"
292	            )
293	
294	        logger.info(f"Starting reindex (force={force})...")
295	
296	        # 1. Clear existing indices if forced
297	        if force:
298	            logger.info("Clearing existing indices...")
299	            self.vector_store.clear()
300	            self.graph_store.clear()
301	
302	        # 2. Discover all skills
303	        skills = self.skill_manager.discover_skills()
304	        logger.info(f"Discovered {len(skills)} skills for indexing")
305	
306	        # 3. Index each skill (embeddings + graph)
307	        indexed_count = 0
308	        failed_count = 0
309	
310	        for skill in skills:
311	            try:
312	                self.index_skill(skill)
313	                indexed_count += 1
314	            except Exception as e:
315	                logger.error(f"Failed to index skill {skill.id}: {e}")
316	                failed_count += 1
317	
318	        # Update last indexed timestamp
319	        self._last_indexed = datetime.now()
320	
321	        # 4. Save graph to disk for persistence
322	        if self.graph_store.save(self._graph_path):
323	            logger.info(f"Knowledge graph saved to {self._graph_path}")
324	        else:
325	            logger.warning("Failed to save knowledge graph to disk")
326	
327	        logger.info(
328	            f"Reindexing complete: {indexed_count} indexed, {failed_count} failed"
329	        )
330	
331	        # 5. Return statistics
332	        return self.get_stats()
333	
334	    def search(
335	        self,
336	        query: str,
337	        toolchain: str | None = None,
338	        category: str | None = None,
339	        top_k: int = 10,
340	    ) -> list[ScoredSkill]:
341	        """Search skills using vector similarity + KG.
342	
343	        Delegates to HybridSearcher for the actual search logic.
344	
345	        Args:
346	            query: Search query (natural language)
347	            toolchain: Optional toolchain filter (Python, TypeScript, etc.)
348	            category: Optional category filter (testing, debugging, etc.)
349	            top_k: Maximum number of results
350	
351	        Returns:
352	            List of ScoredSkill objects sorted by relevance
353	
354	        Performance:
355	        - Vector search: O(n log k) with ChromaDB indexing
356	        - Graph search: O(n + e) for BFS traversal
357	        - Total: ~50-100ms for 1000 skills
358	
359	        Example:
360	            >>> engine = IndexingEngine(skill_manager=manager)
361	            >>> results = engine.search("python testing", category="testing")
362	            >>> results[0].skill.name
363	            'pytest-testing'
364	            >>> results[0].score
365	            0.92
366	            >>> results[0].match_type
367	            'hybrid'
368	        """
369	        return self.hybrid_searcher.search(
370	            query=query,
371	            toolchain=toolchain,
372	            category=category,
373	            top_k=top_k,
374	        )
375	
376	    def get_related_skills(self, skill_id: str, max_depth: int = 2) -> list[Skill]:
377	        """Find related skills via knowledge graph.
378	
379	        Traverses graph to find skills connected via dependencies,
