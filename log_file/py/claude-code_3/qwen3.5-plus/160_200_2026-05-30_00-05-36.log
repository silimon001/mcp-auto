427	@mcp.tool()
428	def set_video_audio_track_codec(input_video_path: str, output_video_path: str, audio_codec: str) -> str:
429	    """Sets the audio codec of a video's audio track, attempting to copy the video stream.
430	    Args:
431	        input_video_path: Path to the source video file.
432	        output_video_path: Path to save the video with the new audio codec.
433	        audio_codec: Target audio codec (e.g., 'aac', 'mp3').
434	    Returns:
435	        A status message indicating success or failure.
436	    """
437	    primary_kwargs = {'acodec': audio_codec, 'vcodec': 'copy'}
438	    fallback_kwargs = {'acodec': audio_codec} # Re-encode video
