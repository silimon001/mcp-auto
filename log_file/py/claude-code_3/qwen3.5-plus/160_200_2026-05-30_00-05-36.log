1826	
1827	    Examples:
1828	        Change color:
1829	            name="work", color="#F18181"
1830	
1831	        Rename tag:
1832	            name="old-name", label="new-name"
1833	
1834	        Rename and change color:
1835	            name="old-name", label="new-name", color="#FF0000"
1836	    """
1837	    try:
1838	        client = get_client(ctx)
1839	
1840	        # Handle rename if label is provided
1841	        if params.label:
1842	            await client.rename_tag(params.name, params.label)
1843	            # After rename, update the name we use for subsequent operations
1844	            tag_name = params.label
1845	        else:
1846	            tag_name = params.name
1847	
1848	        # Handle empty string as None to remove parent
1849	        parent = params.parent
1850	        if parent == "":
1851	            parent = None
1852	
1853	        # Apply other updates if any
1854	        if params.color or parent is not None:
1855	            tag = await client.update_tag(tag_name, color=params.color, parent=parent)
1856	        else:
1857	            # If only renamed, get the tag to return it
1858	            tags = await client.get_all_tags()
1859	            tag = next((t for t in tags if t.name.lower() == tag_name.lower()), None)
1860	            if not tag:
1861	                return success_message(f"Tag renamed to `{tag_name}`")
1862	
1863	        if params.response_format == ResponseFormat.MARKDOWN:
1864	            return f"# Tag Updated\n\n{format_tag_markdown(tag)}"
1865	        else:
1866	            return json.dumps({"success": True, "tag": format_tag_json(tag)}, indent=2)
1867	
1868	    except Exception as e:
1869	        return handle_error(e, "update_tag")
