157	@mcp.tool()
158	def change_aspect_ratio(video_path: str, output_video_path: str, target_aspect_ratio: str, 
159	                          resize_mode: str = 'pad', padding_color: str = 'black') -> str:
160	    """Changes the aspect ratio of a video, using padding or cropping.
161	    Args listed in PRD.
162	    Returns:
163	        A status message indicating success or failure.
164	    """
165	    try:
166	        probe = ffmpeg.probe(video_path)
167	        video_stream_info = next((stream for stream in probe['streams'] if stream['codec_type'] == 'video'), None)
168	        if not video_stream_info:
169	            return "Error: No video stream found in the input file."
170	
171	        original_width = int(video_stream_info['width'])
172	        original_height = int(video_stream_info['height'])
173	
174	        num, den = map(int, target_aspect_ratio.split(':'))
175	        target_ar_val = num / den
176	        original_ar_val = original_width / original_height
177	
178	        vf_filter = ""
179	        # Attempt to copy codecs if the operation doesn't strictly require re-encoding video stream
180	        # This is mostly for padding. Cropping implies re-encoding the video stream.
181	        codec_to_use = None 
182	
183	        if resize_mode == 'pad':
184	            if abs(original_ar_val - target_ar_val) < 1e-4:
185	                try:
186	                    ffmpeg.input(video_path).output(output_video_path, c='copy').run(capture_stdout=True, capture_stderr=True)
187	                    return f"Video aspect ratio already matches. Copied to {output_video_path}."
188	                except ffmpeg.Error:
189	                     # If copy fails, just re-encode
190	                    ffmpeg.input(video_path).output(output_video_path).run(capture_stdout=True, capture_stderr=True)
191	                    return f"Video aspect ratio already matches. Re-encoded to {output_video_path}."
192	            
193	            if original_ar_val > target_ar_val: 
194	                final_w = int(original_height * target_ar_val)
195	                final_h = original_height
196	                vf_filter = f"scale={final_w}:{final_h}:force_original_aspect_ratio=decrease,pad={final_w}:{final_h}:(ow-iw)/2:(oh-ih)/2:{padding_color}"
197	            else: 
198	                final_w = original_width
199	                final_h = int(original_width / target_ar_val)
200	                vf_filter = f"scale={final_w}:{final_h}:force_original_aspect_ratio=decrease,pad={final_w}:{final_h}:(ow-iw)/2:(oh-ih)/2:{padding_color}"
201	            codec_to_use = 'copy' # Try to copy for padding, audio will be copied too
202	
203	        elif resize_mode == 'crop':
204	            if abs(original_ar_val - target_ar_val) < 1e-4:
205	                try:
206	                    ffmpeg.input(video_path).output(output_video_path, c='copy').run(capture_stdout=True, capture_stderr=True)
207	                    return f"Video aspect ratio already matches. Copied to {output_video_path}."
208	                except ffmpeg.Error:
209	                    ffmpeg.input(video_path).output(output_video_path).run(capture_stdout=True, capture_stderr=True)
210	                    return f"Video aspect ratio already matches. Re-encoded to {output_video_path}."
211	            
212	            if original_ar_val > target_ar_val: 
213	                new_width = int(original_height * target_ar_val)
214	                vf_filter = f"crop={new_width}:{original_height}:(iw-{new_width})/2:0"
215	            else: 
216	                new_height = int(original_width / target_ar_val)
217	                vf_filter = f"crop={original_width}:{new_height}:0:(ih-{new_height})/2"
218	        else:
219	            return f"Error: Invalid resize_mode '{resize_mode}'. Must be 'pad' or 'crop'."
220	        
221	        try:
222	            # Try with specified video filter and copying audio codec
223	            ffmpeg.input(video_path).output(output_video_path, vf=vf_filter, acodec='copy').run(capture_stdout=True, capture_stderr=True)
224	            return f"Video aspect ratio changed (audio copy) to {target_aspect_ratio} using {resize_mode}. Saved to {output_video_path}"
225	        except ffmpeg.Error as e_acopy:
226	            # Fallback to re-encoding audio if audio copy failed
227	            try:
228	                ffmpeg.input(video_path).output(output_video_path, vf=vf_filter).run(capture_stdout=True, capture_stderr=True)
229	                return f"Video aspect ratio changed (audio re-encoded) to {target_aspect_ratio} using {resize_mode}. Saved to {output_video_path}"
230	            except ffmpeg.Error as e_recode_all:
231	                err_acopy_msg = e_acopy.stderr.decode('utf8') if e_acopy.stderr else str(e_acopy)
232	                err_recode_msg = e_recode_all.stderr.decode('utf8') if e_recode_all.stderr else str(e_recode_all)
233	                return f"Error changing aspect ratio. Audio copy attempt failed: {err_acopy_msg}. Full re-encode attempt also failed: {err_recode_msg}."
234	
235	    except ffmpeg.Error as e:
236	        error_message = e.stderr.decode('utf8') if e.stderr else str(e)
237	        return f"Error changing aspect ratio: {error_message}"
238	    except FileNotFoundError:
239	        return f"Error: Input video file not found at {video_path}"
240	    except ValueError:
241	        return f"Error: Invalid target_aspect_ratio format. Expected 'num:den' (e.g., '16:9')."
242	    except Exception as e:
243	        return f"An unexpected error occurred: {str(e)}"
