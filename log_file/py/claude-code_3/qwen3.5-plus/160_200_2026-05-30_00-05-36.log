566	@mcp.tool(
567	    name="ticktick_list_tasks",
568	    annotations={
569	        "title": "List Tasks",
570	        "readOnlyHint": True,
571	        "destructiveHint": False,
572	        "idempotentHint": True,
573	        "openWorldHint": True,
574	    },
575	)
576	async def ticktick_list_tasks(params: TaskListInput, ctx: Context) -> str:
577	    """
578	    List tasks with flexible filtering.
579	
580	    This unified tool handles all task listing scenarios:
581	    - Active tasks (default)
582	    - Completed tasks (with date range)
583	    - Abandoned tasks (with date range)
584	    - Deleted/trashed tasks
585	
586	    Args:
587	        params: Filter parameters:
588	            - status (str): 'active' (default), 'completed', 'abandoned', 'deleted'
589	            - project_id (str): Filter by project
590	            - column_id (str): Filter by kanban column (active only, use with project_id)
591	            - tag (str): Filter by tag name
592	            - priority (str): Filter by priority level
593	            - due_today (bool): Only tasks due today (active only)
594	            - overdue (bool): Only overdue tasks (active only)
595	            - from_date (str): Start date for completed/abandoned (YYYY-MM-DD)
596	            - to_date (str): End date for completed/abandoned (YYYY-MM-DD)
597	            - days (int): Days to look back for completed/abandoned (default 7)
598	            - limit (int): Maximum results (default 50)
599	
600	    Returns:
601	        Formatted list of tasks or error message.
602	
603	    Examples:
604	        - Active tasks: status="active" (or just omit status)
605	        - Completed last 7 days: status="completed"
606	        - Completed in range: status="completed", from_date="2026-01-01", to_date="2026-01-15"
607	        - Abandoned tasks: status="abandoned", days=30
608	        - Deleted tasks: status="deleted"
609	        - Active + project: status="active", project_id="..."
610	        - Tasks in column: project_id="...", column_id="..." (kanban workflow)
611	    """
612	    try:
613	        client = get_client(ctx)
614	
615	        # Handle different status types
616	        if params.status == "active":
617	            tasks = await client.get_all_tasks()
618	
619	            # Apply active-only filters
620	            if params.project_id:
621	                tasks = [t for t in tasks if t.project_id == params.project_id]
622	
623	            if params.column_id:
624	                tasks = [t for t in tasks if t.column_id == params.column_id]
625	
626	            if params.tag:
627	                tag_lower = params.tag.lower()
628	                tasks = [t for t in tasks if any(tag.lower() == tag_lower for tag in t.tags)]
629	
630	            if params.priority:
631	                priority_map = {"none": 0, "low": 1, "medium": 3, "high": 5}
632	                target_priority = priority_map.get(params.priority, 0)
633	                tasks = [t for t in tasks if t.priority == target_priority]
634	
635	            if params.due_today:
636	                today = date.today()
637	                tasks = [t for t in tasks if t.due_date and t.due_date.date() == today]
638	
639	            if params.overdue:
640	                today = date.today()
641	                tasks = [t for t in tasks if t.due_date and t.due_date.date() < today and not t.is_completed]
642	
643	        elif params.status == "completed":
644	            # Completed tasks require date range
645	            if params.from_date and params.to_date:
646	                from_dt = datetime.fromisoformat(params.from_date)
647	                to_dt = datetime.fromisoformat(params.to_date)
648	            else:
649	                to_dt = datetime.now()
650	                from_dt = to_dt - timedelta(days=params.days)
651	
652	            tasks = await client.get_completed_tasks(days=params.days, limit=params.limit)
653	
654	        elif params.status == "abandoned":
655	            # Abandoned tasks require date range
656	            tasks = await client.get_abandoned_tasks(days=params.days, limit=params.limit)
657	
658	        elif params.status == "deleted":
659	            tasks = await client.get_deleted_tasks(limit=params.limit)
660	
661	        else:
662	            tasks = await client.get_all_tasks()
663	
664	        # Apply limit
665	        total_count = len(tasks)
666	        tasks = tasks[: params.limit]
667	
668	        if params.response_format == ResponseFormat.MARKDOWN:
669	            title = f"{params.status.capitalize()} Tasks" if params.status else "Tasks"
670	            result = format_tasks_markdown(tasks, title)
671	        else:
672	            result = json.dumps(format_tasks_json(tasks), indent=2)
673	
674	        # Apply truncation if response is too large
675	        return truncate_response(result, total_count, len(tasks))
676	
677	    except Exception as e:
678	        return handle_error(e, "list_tasks")
679	
