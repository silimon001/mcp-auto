1	from typing import Dict, Any, Optional
2	from mcp.server.fastmcp import FastMCP
3	import anthropic
4	
5	# Import from our package
6	from .utils import logger, MCPError, MCPErrorCode
7	from .optimizer import SparkOptimizer
8	
9	# Initialize MCP server
10	mcp = FastMCP("spark-mcp-server")
11	
12	@mcp.tool()
13	async def optimize_spark_code(spark_code: str, optimization_level: Optional[str] = "medium") -> Dict[str, Any]:
14	    """
15	    Optimizes Apache Spark code based on specified optimization level.
16	    
17	    Args:
18	        spark_code: The Spark code to optimize
19	        optimization_level: Level of optimization (low, medium, high)
20	        
21	    Returns:
22	        Dict containing optimization results
23	    """
24	    # Validate inputs
25	    if not spark_code:
26	        raise MCPError(
27	            code=MCPErrorCode.INVALID_ARGUMENT,
28	            message="spark_code cannot be empty"
29	        )
30	        
31	    if optimization_level not in ["low", "medium", "high"]:
32	        raise MCPError(
33	            code=MCPErrorCode.INVALID_ARGUMENT,
34	            message="optimization_level must be one of: low, medium, high"
35	        )
36	    
37	    logger.info(f"Received request to optimize Spark code with level: {optimization_level}")
38	    try:
39	        # Create optimizer instance and optimize the code
40	        optimizer = SparkOptimizer()
41	        optimized_code = optimizer.optimize_code(spark_code, optimization_level)
42	        logger.info("Code optimization completed")
43	        
44	        # Return the optimized code
45	        return {
46	            "status": "success",
47	            "original_code": spark_code,
48	            "optimized_code": optimized_code,
49	            "optimization_level": optimization_level,
50	            "optimizations_applied": [
51	                "Used Claude AI for intelligent Spark code optimization",
52	                "Applied schema optimizations and type hints",
53	                "Added broadcast hints for small tables",
54	                "Optimized partitioning and storage levels"
55	            ]
56	        }
57	    except anthropic.APIError as e:
58	        logger.error(f"Claude API error: {str(e)}")
59	        raise MCPError(
60	            code=MCPErrorCode.EXTERNAL_SERVICE_ERROR,
61	            message=f"Error communicating with optimization service: {str(e)}"
62	        )
63	    except Exception as e:
64	        logger.error(f"Error optimizing code: {str(e)}")
65	        raise MCPError(
66	            code=MCPErrorCode.INTERNAL_ERROR,
67	            message=f"Internal optimization error: {str(e)}"
68	        )
69	
