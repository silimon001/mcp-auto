1	"""Vector store using ChromaDB for semantic similarity search.
2	
3	Design Decision: Persistent ChromaDB Storage
4	
5	Rationale: Use persistent storage to avoid reindexing on every startup.
6	Skills are relatively stable, making persistence valuable.
7	
8	Trade-offs:
9	- Startup Speed: Faster restarts vs. initial indexing overhead
10	- Disk Space: ~100KB per 100 skills (minimal)
11	- Data Freshness: Must detect when reindexing is needed
12	
13	Error Handling:
14	- ChromaDB connection failures → Raise RuntimeError with details
15	- Corrupted database → Delete and reinitialize (future enhancement)
16	- Empty embeddings → Log warning and skip skill
17	"""
18	
19	import logging
20	from pathlib import Path
21	from typing import Any
22	
23	import chromadb
24	from chromadb.config import Settings
25	from chromadb.utils import embedding_functions
26	from sentence_transformers import SentenceTransformer
27	
28	from mcp_skills.models.skill import Skill
29	
30	
31	logger = logging.getLogger(__name__)
32	
33	
34	class VectorStore:
35	    """Vector store using ChromaDB for semantic similarity search.
36	
37	    This class encapsulates all ChromaDB operations including:
38	    - Collection management
39	    - Embedding generation
40	    - Vector similarity search
41	    - Batch operations
42	
43	    Architecture:
44	    - Embeddings: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
45	    - Storage: Persistent ChromaDB on disk
46	    - Indexing: Automatic via ChromaDB
47	
48	    Performance:
49	    - Embedding generation: ~15ms per skill on CPU, ~3ms on GPU
50	    - Search: O(n log k) with ChromaDB indexing
51	    - Storage: ~2KB per skill (embeddings + metadata)
52	    """
53	
54	    def __init__(self, persist_directory: Path | None = None) -> None:
55	        """Initialize ChromaDB vector store.
56	
57	        Args:
58	            persist_directory: Path to store ChromaDB data
59	                             (defaults to ~/.mcp-skillset/chromadb/)
60	
61	        Raises:
62	            RuntimeError: If ChromaDB initialization fails
63	        """
64	        self.persist_directory = persist_directory or (
65	            Path.home() / ".mcp-skillset" / "chromadb"
66	        )
67	
68	        # Ensure storage directory exists
69	        self.persist_directory.mkdir(parents=True, exist_ok=True)
70	
71	        # Initialize ChromaDB client
72	        try:
73	            self._init_chromadb()
74	        except Exception as e:
75	            logger.error(f"Failed to initialize ChromaDB: {e}")
76	            raise RuntimeError(f"ChromaDB initialization failed: {e}") from e
77	
78	        # Initialize sentence-transformers model for embeddings
79	        try:
80	            self._init_embedding_model()
81	        except Exception as e:
82	            logger.error(f"Failed to load embedding model: {e}")
83	            raise RuntimeError(f"Embedding model initialization failed: {e}") from e
84	
85	    def _init_chromadb(self) -> None:
86	        """Initialize ChromaDB persistent client.
87	
88	        Creates or connects to persistent ChromaDB instance with
89	        sentence-transformers embedding function.
90	        """
91	        try:
92	            # Create persistent ChromaDB client
93	            self.chroma_client = chromadb.PersistentClient(
94	                path=str(self.persist_directory),
95	                settings=Settings(
96	                    anonymized_telemetry=False,
97	                    allow_reset=True,
98	                ),
99	            )
100	
101	            # Use sentence-transformers embedding function
102	            # This matches our manual embedding model for consistency
103	            embedding_fn = embedding_functions.SentenceTransformerEmbeddingFunction(
104	                model_name="sentence-transformers/all-MiniLM-L6-v2"
105	            )
106	
107	            # Get or create collection
108	            # Type ignore for ChromaDB's complex embedding function signature
109	            self.collection = self.chroma_client.get_or_create_collection(
110	                name="skills",
111	                embedding_function=embedding_fn,
112	                metadata={"description": "MCP Skills vector embeddings"},
113	            )
114	
115	            logger.info(
116	                f"ChromaDB initialized at {self.persist_directory} "
117	                f"with {self.collection.count()} skills"
118	            )
119	
120	        except Exception as e:
121	            logger.error(f"ChromaDB initialization failed: {e}")
122	            raise
123	
124	    def _init_embedding_model(self) -> None:
125	        """Initialize sentence-transformers embedding model.
126	
127	        Uses all-MiniLM-L6-v2 for fast, high-quality embeddings:
128	        - Embedding size: 384 dimensions
129	        - Speed: ~15ms per skill on CPU
130	        - Quality: Optimized for semantic similarity
131	
132	        Performance Note:
133	        - Model loaded once and cached in memory (~90MB)
134	        - GPU acceleration used if available (CUDA)
135	        """
136	        self.embedding_model = SentenceTransformer(
137	            "sentence-transformers/all-MiniLM-L6-v2"
138	        )
139	        logger.info("Sentence-transformers model loaded successfully")
140	
141	    def index_skill(self, skill: Skill) -> None:
142	        """Add skill to vector store.
143	
144	        Creates embeddings from skill content and stores in ChromaDB
145	        with metadata for filtering.
146	
147	        Args:
148	            skill: Skill object to index
149	
150	        Error Handling:
151	        - Empty embeddable text → Log warning and skip
152	        - Embedding generation failure → Log error and skip
153	        - ChromaDB add failure → Log error (allows batch to continue)
154	        """
155	        try:
156	            # Create embeddable text
157	            embeddable_text = self._create_embeddable_text(skill)
158	
159	            if not embeddable_text.strip():
160	                logger.warning(f"Empty embeddable text for skill: {skill.id}")
161	                return
162	
163	            # Prepare metadata
164	            metadata = {
165	                "skill_id": skill.id,
166	                "name": skill.name,
167	                "category": skill.category,
168	                "tags": ",".join(skill.tags),  # Comma-separated for ChromaDB
169	                "repo_id": skill.repo_id,
170	                "updated_at": (
171	                    skill.updated_at.isoformat() if skill.updated_at else None
172	                ),
173	            }
174	
175	            # Add to ChromaDB (embeddings generated automatically)
176	            self.collection.add(
177	                ids=[skill.id],
178	                documents=[embeddable_text],
179	                metadatas=[metadata],
180	            )
181	
182	            logger.debug(f"Indexed skill in vector store: {skill.id}")
183	
184	        except Exception as e:
185	            logger.error(f"Failed to index skill {skill.id} in vector store: {e}")
186	            # Don't raise - allow indexing to continue for other skills
187	
188	    def _create_embeddable_text(self, skill: Skill) -> str:
189	        """Create text representation for embedding.
190	
191	        Combines skill fields weighted by importance:
192	        - Name (highest weight)
193	        - Description
194	        - First 500 chars of instructions
195	        - Tags
196	
197	        Args:
198	            skill: Skill to create text from
199	
200	        Returns:
201	            Combined text string for embedding
202	        """
203	        # Truncate instructions to avoid overwhelming embedding
204	        instructions_preview = skill.instructions[:500]
205	
206	        # Combine fields with space separation
207	        embeddable_text = (
208	            f"{skill.name} "
209	            f"{skill.description} "
210	            f"{instructions_preview} "
211	            f"{' '.join(skill.tags)}"
212	        )
213	
214	        return embeddable_text
215	
216	    def build_embeddings(self, skill: Skill) -> list[float]:
217	        """Generate embeddings from skill content.
218	
219	        Combines name, description, instructions, and tags
220	        into embeddings using sentence-transformers.
221	
222	        Args:
223	            skill: Skill to generate embeddings for
224	
225	        Returns:
226	            Embedding vector as list of floats
227	
228	        Performance:
229	        - Time Complexity: O(n) where n = text length
230	        - ~15ms per skill on CPU, ~3ms on GPU
231	        - Embeddings cached by ChromaDB (no regeneration needed)
232	
233	        Error Handling:
234	        - Empty text: Returns empty list
235	        - Encoding errors: Logs error and returns empty list
236	        """
237	        try:
238	            # Create embeddable text
239	            embeddable_text = self._create_embeddable_text(skill)
240	
241	            if not embeddable_text.strip():
242	                logger.warning(f"Empty embeddable text for skill: {skill.id}")
243	                return []
244	
245	            # Generate embedding using sentence-transformers
246	            embedding = self.embedding_model.encode(
247	                embeddable_text, convert_to_numpy=True
248	            )
249	
250	            # Convert numpy array to list for JSON serialization
251	            embedding_list: list[float] = embedding.tolist()
252	            return embedding_list
253	
254	        except Exception as e:
255	            logger.error(f"Failed to generate embedding for {skill.id}: {e}")
256	            return []
257	
258	    def search(
259	        self,
260	        query: str,
261	        top_k: int = 20,
262	        filters: dict[str, Any] | None = None,
263	    ) -> list[dict[str, Any]]:
264	        """Search vector store for similar skills.
265	
266	        Performs semantic similarity search using ChromaDB's vector search.
267	
268	        Args:
269	            query: Search query (natural language)
270	            top_k: Maximum number of results
271	            filters: Optional metadata filters (e.g., {"category": "testing"})
272	
273	        Returns:
274	            List of dicts with skill_id, score, and metadata
275	
276	        Performance:
277	        - Time Complexity: O(n log k) with ChromaDB indexing
278	        - Expected: ~20-50ms for 1000 skills
279	
280	        Example:
281	            >>> vector_store = VectorStore()
282	            >>> results = vector_store.search(
283	            ...     "python testing",
284	            ...     filters={"category": "testing"}
285	            ... )
286	            >>> results[0]["skill_id"]
287	            'anthropics/pytest'
288	            >>> results[0]["score"]
289	            0.92
290	        """
291	        try:
292	            # Guard: return early if collection is empty to avoid Rust backend
293	            # panic when n_results=0 (chromadb>=1.5 with RustBindingsAPI).
294	            count = self.collection.count()
295	            if count == 0:
296	                return []
297	
298	            # ChromaDB query with optional filters
299	            results = self.collection.query(
300	                query_texts=[query],
301	                n_results=min(top_k, count),
302	                where=filters if filters else None,
303	            )
304	
305	            # Convert to structured format
306	            vector_results = []
307	            if results["ids"] and results["distances"]:
308	                for i, skill_id in enumerate(results["ids"][0]):
309	                    # Convert distance to similarity score (0-1)
310	                    # ChromaDB uses L2 distance, convert to similarity
311	                    distance = results["distances"][0][i]
312	                    similarity = 1.0 / (1.0 + distance)
313	
314	                    metadata = (
315	                        results["metadatas"][0][i] if results["metadatas"] else {}
316	                    )
317	
318	                    vector_results.append(
319	                        {
320	                            "skill_id": skill_id,
321	                            "score": similarity,
322	                            "metadata": metadata,
323	                        }
324	                    )
325	
326	            return vector_results
327	
328	        except Exception as e:
329	            logger.error(f"Vector search failed: {e}")
330	            return []
331	
332	    def clear(self) -> None:
333	        """Clear all vectors from store.
334	
335	        Deletes all documents from the ChromaDB collection.
336	        Useful for reindexing operations.
337	        """
338	        try:
339	            existing_ids = self.collection.get()["ids"]
340	            if existing_ids:
341	                self.collection.delete(ids=existing_ids)
342	                logger.info(f"Cleared {len(existing_ids)} skills from vector store")
343	        except Exception as e:
344	            logger.error(f"Failed to clear vector store: {e}")
345	            raise
346	
347	    def count(self) -> int:
348	        """Get number of skills in vector store.
349	
350	        Returns:
351	            Number of indexed skills
352	        """
353	        try:
354	            count: int = self.collection.count()
355	            return count
356	        except Exception as e:
357	            logger.error(f"Failed to count vector store: {e}")
358	            return 0
