289	def handle_error(e: Exception, operation: str) -> str:
290	    """
291	    Handle exceptions and return user-friendly, actionable error messages.
292	
293	    Error messages include:
294	    1. What went wrong
295	    2. Why it might have happened
296	    3. Specific steps to resolve the issue
297	    """
298	    logger.exception("Error in %s: %s", operation, e)
299	
300	    error_type = type(e).__name__
301	    error_str = str(e)
302	
303	    if "Authentication" in error_type:
304	        return error_message(
305	            "Authentication failed",
306	            "NEXT STEPS:\n"
307	            "1. Verify environment variables are set:\n"
308	            "   - TICKTICK_CLIENT_ID (OAuth2 client ID)\n"
309	            "   - TICKTICK_CLIENT_SECRET (OAuth2 client secret)\n"
310	            "   - TICKTICK_ACCESS_TOKEN (OAuth2 access token)\n"
311	            "   - TICKTICK_USERNAME (TickTick account email)\n"
312	            "   - TICKTICK_PASSWORD (TickTick account password)\n"
313	            "2. Check that credentials are not expired\n"
314	            "3. Re-run OAuth2 flow if access token is invalid"
315	        )
316	    elif "NotFound" in error_type:
317	        resource_hint = ""
318	        if "task" in error_str.lower():
319	            resource_hint = (
320	                "HINTS:\n"
321	                "- Task may have been permanently deleted (not just trashed)\n"
322	                "- Use ticktick_list_tasks to see available tasks\n"
323	                "- Check if the task ID is correct"
324	            )
325	        elif "project" in error_str.lower():
326	            resource_hint = (
327	                "HINTS:\n"
328	                "- Use ticktick_list_projects to see available projects\n"
329	                "- The inbox project ID can be obtained from ticktick_get_status"
330	            )
331	        elif "tag" in error_str.lower():
332	            resource_hint = (
333	                "HINTS:\n"
334	                "- Use ticktick_list_tags to see available tags\n"
335	                "- Tag names are case-insensitive"
336	            )
337	        elif "folder" in error_str.lower() or "group" in error_str.lower():
338	            resource_hint = (
339	                "HINTS:\n"
340	                "- Use ticktick_list_folders to see available folders"
341	            )
342	        return error_message(
343	            f"Resource not found: {error_str}",
344	            resource_hint or "Verify the ID is correct and the resource exists."
345	        )
346	    elif "Validation" in error_type:
347	        return error_message(
348	            f"Invalid input: {error_str}",
349	            "Check the parameter types and constraints in the tool documentation."
350	        )
351	    elif "Configuration" in error_type:
352	        if "recurrence" in error_str.lower() and "start_date" in error_str.lower():
353	            return error_message(
354	                f"Configuration error: {error_str}",
355	                "TICKTICK REQUIREMENT: Recurring tasks require a start_date.\n"
356	                "Add a start_date parameter when setting recurrence rules."
357	            )
358	        return error_message(
359	            f"Configuration error: {error_str}",
360	            "Check your environment variables and tool parameters."
361	        )
362	    elif "RateLimit" in error_type:
363	        return error_message(
364	            "Rate limit exceeded",
365	            "NEXT STEPS:\n"
366	            "1. Wait 30-60 seconds before retrying\n"
367	            "2. Reduce the frequency of API calls\n"
368	            "3. Batch operations where possible"
369	        )
370	    elif "Quota" in error_type:
371	        return error_message(
372	            "Account quota exceeded",
373	            "HINTS:\n"
374	            "- Free accounts have limited projects/tasks\n"
375	            "- Delete unused projects or upgrade to Pro"
376	        )
377	    elif "Forbidden" in error_type:
378	        return error_message(
379	            f"Access denied: {error_str}",
380	            "You don't have permission to access this resource.\n"
381	            "Check if you're the owner or have appropriate sharing permissions."
382	        )
383	    elif "Server" in error_type:
384	        return error_message(
385	            f"TickTick server error: {error_str}",
386	            "NEXT STEPS:\n"
387	            "1. Wait a moment and retry the operation\n"
388	            "2. Check if TickTick service is operational\n"
