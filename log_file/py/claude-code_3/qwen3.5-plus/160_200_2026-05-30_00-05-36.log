582	async def get_detailed_breakdown_by_day(params: DaysParam) -> str: #Dict[str, Any]:
583	    """
584	    Retrieve daily spend breakdown by region, service, and instance type.
585	    
586	    Args:
587	        params: Parameters specifying the number of days to look back
588	    
589	    Returns:
590	        Dict[str, Any]: A tuple containing:
591	            - A nested dictionary with cost data organized by date, region, and service
592	            - A string containing the formatted output report
