867	    def _normalize_args(self, raw_args, model_class):
868	        """Normalize arguments to handle both direct and wrapped formats."""
869	        if isinstance(raw_args, dict):
870	            # If it has an 'args' key, use that
871	            if "args" in raw_args:
872	                return model_class(**raw_args["args"])
873	            # Otherwise, assume the dict itself contains the arguments
874	            else:
875	                return model_class(**raw_args)
876	        # If it's already a model instance, return as-is
877	        elif hasattr(raw_args, "__dict__"):
878	            return raw_args
879	        else:
880	            # Fallback to empty model
881	            return model_class()
