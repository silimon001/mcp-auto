2631	    """
2632	    try:
2633	        client = get_client(ctx)
2634	
2635	        # Build checkins list for batch operation
2636	        checkin_data = []
2637	        for checkin in params.checkins:
2638	            checkin_data.append({
2639	                "habit_id": checkin.habit_id,
2640	                "value": checkin.value,
2641	                "checkin_date": checkin.checkin_date,
2642	            })
2643	
2644	        # Call batch method
2645	        results = await client.checkin_habits(checkin_data)
2646	
2647	        if params.response_format == ResponseFormat.MARKDOWN:
2648	            lines = [f"# {len(results)} Habit Check-in(s) Recorded", ""]
2649	            today_str = date.today().isoformat()
2650	
2651	            for habit_id, habit in results.items():
