  "content": "#!/usr/bin/env node\n/**\n * Mock Lisply backend for testing MCP wrapper without Docker.\n * Responds to ping, lisp-eval, and http-request endpoints.\n */\nconst http = require('http');\n\nconst PORT = 9081;\n\nconst server = http.createServer((req, res) => {\n  const url = req.url;\n\n  // CORS headers\n  res.setHeader('Content-Type', 'application/json');\n\n  if (req.method === 'GET' && url === '/lisply/ping-lisp') {\n    res.writeHead(200);\n    res.end(JSON.stringify({ status: 'ok', message: 'Lisply backend is alive' }));\n  } else if (req.method === 'POST' && url === '/lisply/lisp-eval') {\n    let body = '';\n    req.on('data', chunk => body += chunk);\n    req.on('end', () => {\n      try {\n        const parsed = JSON.parse(body);\n        const code = parsed.code || '';\n        // Simple mock evaluation - just echo the code\n        res.writeHead(200);\n        res.end(JSON.stringify({\n          success: true,\n          result: `Evaluated: ${code}`,\n          stdout: ''\n        }));\n      } catch (e) {\n        res.writeHead(400);\n        res.end(JSON.stringify({ success: false, error: e.message }));\n      }\n    });\n  } else if (req.method === 'GET' && (url === '/lisply/http-request' || url.startsWith('/lisply/http-request'))) {\n    let body = '';\n    req.on('data', chunk => body += chunk);\n    req.on('end', () => {\n      res.writeHead(200);\n      res.end(JSON.stringify({ success: true, data: {} }));\n    });\n  } else {\n    res.writeHead(404);\n    res.end(JSON.stringify({ error: 'Not found' }));\n  }\n});\n\nserver.listen(PORT, '127.0.0.1', () => {\n  console.error(`Mock Lisply backend running on http://127.0.0.1:${PORT}`);\n});\n"
