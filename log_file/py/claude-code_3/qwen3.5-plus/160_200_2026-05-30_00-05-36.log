485	@mcp.tool()
486	def add_subtitles(video_path: str, srt_file_path: str, output_video_path: str, font_style: dict = None) -> str:
487	    """Burns subtitles from an SRT file onto a video, with optional styling.
488	
489	    Args:
490	        video_path: Path to the input video file.
491	        srt_file_path: Path to the SRT subtitle file.
492	        output_video_path: Path to save the video with subtitles.
493	        font_style (dict, optional): A dictionary for subtitle styling. 
494	            Supported keys and example values:
495	            - 'font_name': 'Arial' (str)
496	            - 'font_size': 24 (int)
497	            - 'font_color': 'white' or '&H00FFFFFF' (str, FFmpeg color syntax)
498	            - 'outline_color': 'black' or '&H00000000' (str)
499	            - 'outline_width': 2 (int)
500	            - 'shadow_color': 'black' (str)
501	            - 'shadow_offset_x': 1 (int)
502	            - 'shadow_offset_y': 1 (int)
503	            - 'alignment': 7 (int, ASS alignment - Numpad layout: 1=bottom-left, 7=top-left etc. Default often 2=bottom-center)
504	            - 'margin_v': 10 (int, vertical margin from edge, depends on alignment)
505	            - 'margin_l': 10 (int, left margin)
506	            - 'margin_r': 10 (int, right margin)
507	            Default is None, which uses FFmpeg's default subtitle styling.
508	
509	    Returns:
510	        A status message indicating success or failure.
511	    """
512	    try:
513	        # Basic validation for file existence
514	        if not os.path.exists(video_path):
515	            return f"Error: Input video file not found at {video_path}"
516	        if not os.path.exists(srt_file_path):
517	            return f"Error: SRT subtitle file not found at {srt_file_path}"
518	
519	        input_stream = ffmpeg.input(video_path)
520	        
521	        style_args = []
522	        if font_style:
523	            if 'font_name' in font_style: style_args.append(f"FontName={font_style['font_name']}")
524	            if 'font_size' in font_style: style_args.append(f"FontSize={font_style['font_size']}")
525	            if 'font_color' in font_style: style_args.append(f"PrimaryColour={font_style['font_color']}")
526	            if 'outline_color' in font_style: style_args.append(f"OutlineColour={font_style['outline_color']}")
527	            if 'outline_width' in font_style: style_args.append(f"Outline={font_style['outline_width']}") # Outline thickness
528	            if 'shadow_color' in font_style: style_args.append(f"ShadowColour={font_style['shadow_color']}")
529	            if 'shadow_offset_x' in font_style or 'shadow_offset_y' in font_style:
530	                # FFmpeg 'Shadow' is more like a distance. Outline might be better for simple shadow.
531	                # For more control, ASS uses ShadowX, ShadowY. Let's use 'Shadow' for simplicity if only one is given.
532	                shadow_val = font_style.get('shadow_offset_x', font_style.get('shadow_offset_y', 1))
533	                style_args.append(f"Shadow={shadow_val}")
534	            if 'alignment' in font_style: style_args.append(f"Alignment={font_style['alignment']}")
535	            if 'margin_v' in font_style: style_args.append(f"MarginV={font_style['margin_v']}")
536	            if 'margin_l' in font_style: style_args.append(f"MarginL={font_style['margin_l']}")
537	            if 'margin_r' in font_style: style_args.append(f"MarginR={font_style['margin_r']}")
538	            # Add more style mappings as needed based on FFmpeg/ASS capabilities
539	
540	        vf_filter_value = f"subtitles='{srt_file_path}'"
541	        if style_args:
542	            vf_filter_value += f":force_style='{','.join(style_args)}'"
543	
544	        # Attempt to copy audio codec to speed up processing if possible
545	        output_stream = input_stream.output(output_video_path, vf=vf_filter_value, acodec='copy')
546	        try:
547	            output_stream.run(capture_stdout=True, capture_stderr=True)
548	            return f"Subtitles added successfully (audio copied) to {output_video_path}"
549	        except ffmpeg.Error as e_acopy:
550	            # Fallback to re-encoding audio if audio copy failed
551	            output_stream_recode_audio = input_stream.output(output_video_path, vf=vf_filter_value)
552	            try:
553	                output_stream_recode_audio.run(capture_stdout=True, capture_stderr=True)
554	                return f"Subtitles added successfully (audio re-encoded) to {output_video_path}"
555	            except ffmpeg.Error as e_recode_all:
556	                err_acopy_msg = e_acopy.stderr.decode('utf8') if e_acopy.stderr else str(e_acopy)
557	                err_recode_msg = e_recode_all.stderr.decode('utf8') if e_recode_all.stderr else str(e_recode_all)
558	                return f"Error adding subtitles. Audio copy attempt: {err_acopy_msg}. Full re-encode attempt: {err_recode_msg}"
559	
560	    except ffmpeg.Error as e:
561	        error_message = e.stderr.decode('utf8') if e.stderr else str(e)
562	        return f"Error adding subtitles: {error_message}"
563	    except FileNotFoundError: # This might be redundant if checked above, but good for safety.
564	        return f"Error: A specified file was not found."
565	    except Exception as e:
566	        return f"An unexpected error occurred: {str(e)}"
