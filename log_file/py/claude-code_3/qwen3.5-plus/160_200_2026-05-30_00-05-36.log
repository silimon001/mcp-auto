46	    async def wrapper(*args, ctx=None, **kwargs):
47	        # Extract token
48	        auth_token = None
49	        if ctx and hasattr(ctx, 'request_context'):
50	            req_ctx = ctx.request_context
51	            if req_ctx and hasattr(req_ctx, 'meta') and req_ctx.meta:
52	                websocket_headers = req_ctx.meta.get('websocket_headers', {})
53	                auth_token = websocket_headers.get('authtoken')
54	
55	        if not auth_token:
56	            return "Error: Authentication required"
57	
58	        # Add token to kwargs for the function to use
59	        kwargs['auth_token'] = auth_token
60	        return await func(*args, **kwargs)
61	
62	    return wrapper
