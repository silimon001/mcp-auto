446	    @staticmethod
447	    def _get_preset(preset: str) -> HybridSearchConfig:
448	        """Get preset configuration by name.
449	
450	        Args:
451	            preset: Preset name (semantic_focused, graph_focused, balanced, current)
452	
453	        Returns:
454	            HybridSearchConfig instance for the preset
455	
456	        Raises:
457	            ValueError: If preset name is invalid
458	        """
459	        presets = {
460	            "semantic_focused": HybridSearchConfig.semantic_focused,
461	            "graph_focused": HybridSearchConfig.graph_focused,
462	            "balanced": HybridSearchConfig.balanced,
463	            "current": HybridSearchConfig.current,
464	        }
465	
466	        if preset not in presets:
467	            raise ValueError(
468	                f"Invalid preset '{preset}'. "
469	                f"Valid options: {', '.join(presets.keys())}"
470	            )
471	
472	        return presets[preset]()
