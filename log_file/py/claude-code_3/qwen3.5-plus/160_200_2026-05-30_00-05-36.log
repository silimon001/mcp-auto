555	
556	            @self.app.tool(
557	                name="GetCollectionResultsTool",
558	                description="Retrieve Velociraptor collection results for a given client, flow ID, and artifact. This tool waits and retries if the flow hasn't finished or if no results are immediately available. Use this after starting a collection with CollectArtifactTool.",
559	            )
560	            async def get_collection_results_tool(args: GetCollectionResultsArgs):
561	                """Retrieve Velociraptor collection results for a given client, flow ID, and artifact.
562	
563	                This tool retrieves results from a previously started collection. It will wait and retry
564	                if the flow hasn't finished or if no results are immediately available. This is typically
565	                used after starting a collection with CollectArtifactTool.
566	
567	                Args:
568	                    args: An object containing:
569	                        - client_id (required): Velociraptor client ID where the collection was run
570	                        - flow_id (required): Flow ID returned from the initial collection
571	                        - artifact (required): Name of the artifact collected (e.g., Windows.NTFS.MFT)
572	                        - fields (optional): Comma-separated string of fields to return (default is '*')
573	                        - max_retries (optional): Number of times to retry if the flow hasn't finished (default: 10)
574	                        - retry_delay (optional): Time in seconds to wait between retries (default: 30)
575	
576	                Example usage:
577	                    {"args": {"client_id": "C.1234567890", "flow_id": "F.ABC123", "artifact": "Windows.System.Users"}}
578	                    {"args": {"client_id": "C.0987654321", "flow_id": "F.DEF456", "artifact": "Linux.System.Uptime", "fields": "Uptime,BootTime"}}
579	
580	                Returns:
581	                    JSON array of collection results or status message if still running/failed.
582	                """
583	                try:
584	                    client = self._get_client()
585	
586	                    # Ensure client is authenticated
587	                    if client.stub is None:
588	                        await client.authenticate()
589	
590	                    # First, get artifact details to check if it has multiple sources
591	                    artifact_details_vql = f"SELECT name,sources.name as source_names FROM artifact_definitions() WHERE name = '{args.artifact}'"
592	                    artifact_details = client.run_vql_query(artifact_details_vql)
593	
594	                    source_names = []
595	                    if artifact_details and len(artifact_details) > 0:
596	                        source_names = artifact_details[0].get("source_names", [])
597	
598	                    # Filter out empty or None source names
599	                    valid_source_names = [name for name in source_names if name and name.strip()]
600	
601	                    # Determine the artifact names to check (with sources if they exist)
602	                    artifacts_to_check = []
603	                    if valid_source_names and len(valid_source_names) > 0:
604	                        # Artifact has multiple sources, check each one
605	                        for source_name in valid_source_names:
606	                            artifacts_to_check.append(f"{args.artifact}/{source_name}")
607	                    else:
608	                        # Artifact has no valid sources, use the artifact name directly
609	                        artifacts_to_check.append(args.artifact)
610	
611	                    logger.info("Checking artifacts: %s", artifacts_to_check)
612	
613	                    # Retry logic to wait for collection completion
614	                    all_results = {}
615	                    incomplete_sources = []
616	
617	                    for attempt in range(args.max_retries):
618	                        logger.info(
619	                            "Checking collection status (attempt %d/%d) for flow %s",
620	                            attempt + 1,
621	                            args.max_retries,
622	                            args.flow_id,
623	                        )
624	
625	                        # Check status for each artifact (with sources)
626	                        all_finished = True
627	                        incomplete_sources = []  # Reset incomplete sources for this attempt
628	
629	                        for artifact_with_source in artifacts_to_check:
630	                            if (
631	                                artifact_with_source not in all_results
632	                            ):  # Only check if we haven't gotten results yet
633	                                status = client.get_flow_status(
634	                                    args.client_id,
635	                                    args.flow_id,
636	                                    artifact_with_source,
637	                                )
638	                                logger.info("Flow status for %s: %s", artifact_with_source, status)
639	
640	                                if status == "FINISHED":
641	                                    # Get the results for this artifact/source
642	                                    results = client.get_flow_results(
643	                                        args.client_id,
644	                                        args.flow_id,
645	                                        artifact_with_source,
646	                                        args.fields,
647	                                    )
648	                                    all_results[artifact_with_source] = results
649	                                    logger.info(
650	                                        "Got results for %s: %d records",
651	                                        artifact_with_source,
652	                                        len(results) if results else 0,
653	                                    )
654	                                else:
655	                                    all_finished = False
656	                                    incomplete_sources.append(artifact_with_source)
657	
658	                        # If all artifacts/sources are finished, return the results
659	                        if all_finished:
660	                            return self._format_collection_results(
661	                                args,
662	                                artifacts_to_check,
663	                                all_results,
664	                                incomplete_sources=[],
665	                            )
666	
667	                        # If this is the last attempt and we have some results, return partial results
668	                        if attempt == args.max_retries - 1 and all_results:
669	                            logger.info(
670	                                "Max retries reached, returning partial results. Incomplete sources: %s",
671	                                incomplete_sources,
672	                            )
673	                            return self._format_collection_results(
674	                                args,
675	                                artifacts_to_check,
676	                                all_results,
677	                                incomplete_sources,
678	                            )
679	
680	                        # If not all finished and not the last attempt, wait before retrying
681	                        if attempt < args.max_retries - 1:
682	                            logger.info(
683	                                "Some artifacts not finished, waiting %d seconds before retry",
684	                                args.retry_delay,
685	                            )
686	                            await asyncio.sleep(args.retry_delay)
687	
688	                    # If we've exhausted retries and have no results
689	                    if all_results:
690	                        # This shouldn't happen due to the check above, but just in case
691	                        return self._format_collection_results(
692	                            args,
693	                            artifacts_to_check,
694	                            all_results,
695	                            incomplete_sources,
696	                        )
697	                    else:
698	                        return [
699	                            {
700	                                "type": "text",
701	                                "text": f"Collection results not available after {args.max_retries} retries. "
702	                                f"Flow {args.flow_id} may still be running or may have failed. "
703	                                f"Try again later or check the Velociraptor UI for flow status. "
704	                                f"Checked artifacts: {artifacts_to_check}",
705	                            },
706	                        ]
707	
708	                except Exception as e:
709	                    logger.error("Failed to get collection results: %s", e)
710	                    return [{"type": "text", "text": f"Error getting collection results: {str(e)}"}]
711	
712	        if "CollectArtifactDetailsTool" not in self.config.server.disabled_tools:
713	
714	            @self.app.tool(
