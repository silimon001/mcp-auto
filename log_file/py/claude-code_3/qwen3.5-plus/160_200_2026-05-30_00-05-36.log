42	@mcp.tool()
43	def trim_video(video_path: str, output_video_path: str, start_time: str, end_time: str) -> str:
44	    """Trims a video to the specified start and end times.
45	
46	    Args:
47	        video_path: The path to the input video file.
48	        output_video_path: The path to save the trimmed video file.
49	        start_time: The start time for trimming (HH:MM:SS or seconds).
50	        end_time: The end time for trimming (HH:MM:SS or seconds).
51	    Returns:
52	        A status message indicating success or failure.
53	    """
54	    try:
55	        input_stream = ffmpeg.input(video_path, ss=start_time, to=end_time)
56	        # Attempt to copy codecs to avoid re-encoding if possible
57	        output_stream = input_stream.output(output_video_path, c='copy') 
58	        output_stream.run(capture_stdout=True, capture_stderr=True)
59	        return f"Video trimmed successfully (codec copy) to {output_video_path}"
60	    except ffmpeg.Error as e:
61	        error_message_copy = e.stderr.decode('utf8') if e.stderr else str(e)
62	        try:
63	            # Fallback to re-encoding if codec copy fails
64	            input_stream_recode = ffmpeg.input(video_path, ss=start_time, to=end_time)
65	            output_stream_recode = input_stream_recode.output(output_video_path)
66	            output_stream_recode.run(capture_stdout=True, capture_stderr=True)
67	            return f"Video trimmed successfully (re-encoded) to {output_video_path}"
68	        except ffmpeg.Error as e_recode:
69	            error_message_recode = e_recode.stderr.decode('utf8') if e_recode.stderr else str(e_recode)
70	            return f"Error trimming video. Copy attempt: {error_message_copy}. Re-encode attempt: {error_message_recode}"
71	    except FileNotFoundError:
72	        return f"Error: Input video file not found at {video_path}"
73	    except Exception as e:
74	        return f"An unexpected error occurred: {str(e)}"
