568	@mcp.tool()
569	def add_text_overlay(video_path: str, output_video_path: str, text_elements: list[dict]) -> str:
570	    """Adds one or more text overlays to a video at specified times and positions.
571	
572	    Args:
573	        video_path: Path to the input main video file.
574	        output_video_path: Path to save the video with text overlays.
575	        text_elements: A list of dictionaries, where each dictionary defines a text overlay.
576	            Required keys for each text_element dict:
577	            - 'text': str - The text to display.
578	            - 'start_time': str or float - Start time (HH:MM:SS, or seconds).
579	            - 'end_time': str or float - End time (HH:MM:SS, or seconds).
580	            Optional keys for each text_element dict:
581	            - 'font_size': int (default: 24)
582	            - 'font_color': str (default: 'white')
583	            - 'x_pos': str or int (default: 'center')
584	            - 'y_pos': str or int (default: 'h-th-10')
585	            - 'box': bool (default: False)
586	            - 'box_color': str (default: 'black@0.5')
587	            - 'box_border_width': int (default: 0)
588	    Returns:
589	        A status message indicating success or failure.
590	    """
591	    try:
592	        if not os.path.exists(video_path):
593	            return f"Error: Input video file not found at {video_path}"
594	        if not text_elements:
595	            return "Error: No text elements provided for overlay."
596	
597	        input_stream = ffmpeg.input(video_path)
598	        drawtext_filters = []
599	
600	        for element in text_elements:
601	            text = element.get('text')
602	            start_time = element.get('start_time')
603	            end_time = element.get('end_time')
604	
605	            if text is None or start_time is None or end_time is None:
606	                return f"Error: Text element is missing required keys (text, start_time, end_time)."
607	            
608	            # Thoroughly escape special characters in text
609	            # Escape single quotes, colons, commas, backslashes, and any other special chars
610	            safe_text = text.replace('\\', '\\\\').replace("'", "\\'").replace(':', '\\:').replace(',', '\\,')
611	            
612	            # Build filter parameters
613	            filter_params = [
614	                f"text='{safe_text}'",
615	                f"fontsize={element.get('font_size', 24)}",
616	                f"fontcolor={element.get('font_color', 'white')}",
617	                f"x={element.get('x_pos', '(w-text_w)/2')}",
618	                f"y={element.get('y_pos', 'h-text_h-10')}",
619	                f"enable=between(t\\,{start_time}\\,{end_time})"
620	            ]
621	
622	            # Add box parameters if box is enabled
623	            if element.get('box', False):
624	                filter_params.append("box=1")
625	                filter_params.append(f"boxcolor={element.get('box_color', 'black@0.5')}")
626	                if 'box_border_width' in element:
627	                    filter_params.append(f"boxborderw={element['box_border_width']}")
628	
629	            # Add font file if specified
630	            if 'font_file' in element:
631	                font_path = element['font_file'].replace('\\', '\\\\').replace("'", "\\'").replace(':', '\\:')
632	                filter_params.append(f"fontfile='{font_path}'")
633	
634	            # Join all parameters with colons
635	            drawtext_filter = f"drawtext={':'.join(filter_params)}"
636	            drawtext_filters.append(drawtext_filter)
637	
638	        # Join all drawtext filters with commas
639	        final_vf_filter = ','.join(drawtext_filters)
640	
641	        try:
642	            # First attempt: try to copy audio codec
643	            stream = input_stream.output(output_video_path, vf=final_vf_filter, acodec='copy')
644	            stream.run(capture_stdout=True, capture_stderr=True)
645	            return f"Text overlays added successfully (audio copied) to {output_video_path}"
646	        except ffmpeg.Error as e_acopy:
647	            try:
648	                # Second attempt: re-encode audio if copying fails
649	                stream_recode = input_stream.output(output_video_path, vf=final_vf_filter)
650	                stream_recode.run(capture_stdout=True, capture_stderr=True)
651	                return f"Text overlays added successfully (audio re-encoded) to {output_video_path}"
652	            except ffmpeg.Error as e_recode_all:
653	                err_acopy_msg = e_acopy.stderr.decode('utf8') if e_acopy.stderr else str(e_acopy)
654	                err_recode_msg = e_recode_all.stderr.decode('utf8') if e_recode_all.stderr else str(e_recode_all)
655	                return f"Error adding text overlays. Audio copy attempt: {err_acopy_msg}. Full re-encode attempt: {err_recode_msg}"
656	
657	    except ffmpeg.Error as e:
658	        error_message = e.stderr.decode('utf8') if e.stderr else str(e)
659	        return f"Error processing text overlays: {error_message}"
660	    except FileNotFoundError:
661	        return f"Error: Input video file not found."
662	    except Exception as e:
663	        return f"An unexpected error occurred: {str(e)}"
664	
665	@mcp.tool()
666	def add_image_overlay(video_path: str, output_video_path: str, image_path: str, 
667	                        position: str = 'top_right', opacity: float = None, 
668	                        start_time: str = None, end_time: str = None, 
669	                        width: str = None, height: str = None) -> str:
670	    """Adds an image overlay (watermark/logo) to a video.
671	
672	    Args:
673	        video_path: Path to the input video file.
674	        output_video_path: Path to save the video with the image overlay.
675	        image_path: Path to the image file for the overlay.
676	        position: Position of the overlay. 
677	            Options: 'top_left', 'top_right', 'bottom_left', 'bottom_right', 'center'. 
678	            Or specify custom coordinates like 'x=10:y=10'.
679	        opacity: Opacity of the overlay (0.0 to 1.0). If None, image's own alpha is used.
680	        start_time: Start time for the overlay (HH:MM:SS or seconds). If None, starts from beginning.
681	        end_time: End time for the overlay (HH:MM:SS or seconds). If None, lasts till end.
682	        width: Width for the overlay image (e.g., '100', 'iw*0.1'). Original if None.
683	        height: Height for the overlay image (e.g., '50', 'ih*0.1'). Original if None.
684	
685	    Returns:
686	        A status message indicating success or failure.
687	    """
688	    try:
689	        if not os.path.exists(video_path):
690	            return f"Error: Input video file not found at {video_path}"
691	        if not os.path.exists(image_path):
692	            return f"Error: Overlay image file not found at {image_path}"
693	
694	        main_input = ffmpeg.input(video_path)
695	        overlay_input = ffmpeg.input(image_path)
696	        
697	        # Process the overlay image (scale, opacity)
698	        processed_overlay = overlay_input
699	        
700	        # Apply scaling if requested
701	        if width or height:
702	            scale_params = {}
703	            if width: scale_params['width'] = width
704	            if height: scale_params['height'] = height
705	            if width and not height: scale_params['height'] = '-1'  # Auto-height maintaining aspect
706	            if height and not width: scale_params['width'] = '-1'  # Auto-width maintaining aspect
707	            processed_overlay = processed_overlay.filter('scale', **scale_params)
708	
709	        # Apply opacity if requested
710	        if opacity is not None and 0.0 <= opacity <= 1.0:
711	            # Ensure image has alpha channel, then apply opacity
712	            processed_overlay = processed_overlay.filter('format', 'rgba')  # Ensure alpha channel exists
713	            processed_overlay = processed_overlay.filter('colorchannelmixer', aa=str(opacity))
714	
715	        # Determine overlay position coordinates
716	        overlay_x_pos = '0'
717	        overlay_y_pos = '0'
718	        if position == 'top_left':
719	            overlay_x_pos, overlay_y_pos = '10', '10'
720	        elif position == 'top_right':
721	            overlay_x_pos, overlay_y_pos = 'main_w-overlay_w-10', '10'
722	        elif position == 'bottom_left':
723	            overlay_x_pos, overlay_y_pos = '10', 'main_h-overlay_h-10'
724	        elif position == 'bottom_right':
725	            overlay_x_pos, overlay_y_pos = 'main_w-overlay_w-10', 'main_h-overlay_h-10'
726	        elif position == 'center':
727	            overlay_x_pos, overlay_y_pos = '(main_w-overlay_w)/2', '(main_h-overlay_h)/2'
728	        elif ':' in position:
729	            pos_parts = position.split(':')
730	            for part in pos_parts:
731	                if part.startswith('x='): overlay_x_pos = part.split('=')[1]
732	                if part.startswith('y='): overlay_y_pos = part.split('=')[1]
733	
734	        # Prepare overlay filter parameters
735	        overlay_filter_kwargs = {'x': overlay_x_pos, 'y': overlay_y_pos}
736	        
737	        # Add time-based enabling condition if specified
738	        if start_time is not None or end_time is not None:
739	            actual_start_time = start_time if start_time is not None else '0'
740	            if end_time is not None:
741	                enable_expr = f"between(t,{actual_start_time},{end_time})"
742	            else:  # Only start_time is provided
743	                enable_expr = f"gte(t,{actual_start_time})"
744	            overlay_filter_kwargs['enable'] = enable_expr
745	
746	        try:
747	            # Attempt 1: Create overlay with audio copying
748	            video_with_overlay = ffmpeg.filter([main_input, processed_overlay], 'overlay', **overlay_filter_kwargs)
749	            output_node = ffmpeg.output(video_with_overlay, main_input.audio, output_video_path, acodec='copy')
750	            output_node.run(capture_stdout=True, capture_stderr=True)
751	            return f"Image overlay added successfully (audio copied) to {output_video_path}"
752	        except ffmpeg.Error as e_acopy:
753	            try:
754	                # Attempt 2: Re-encode audio if copying fails
755	                # We need to reconstruct the filter chain
756	                video_with_overlay_fallback = ffmpeg.filter([main_input, processed_overlay], 'overlay', **overlay_filter_kwargs)
757	                output_node_fallback = ffmpeg.output(video_with_overlay_fallback, main_input.audio, output_video_path)
758	                output_node_fallback.run(capture_stdout=True, capture_stderr=True)
759	                return f"Image overlay added successfully (audio re-encoded) to {output_video_path}"
760	            except ffmpeg.Error as e_recode:
761	                err_acopy_msg = e_acopy.stderr.decode('utf8') if e_acopy.stderr else str(e_acopy)
762	                err_recode_msg = e_recode.stderr.decode('utf8') if e_recode.stderr else str(e_recode)
763	                return f"Error adding image overlay. Audio copy attempt: {err_acopy_msg}. Full re-encode attempt: {err_recode_msg}"
764	
765	    except ffmpeg.Error as e:
766	        error_message = e.stderr.decode('utf8') if e.stderr else str(e)
767	        return f"Error processing image overlay: {error_message}"
768	    except FileNotFoundError:
769	        return f"Error: An input file was not found (video: '{video_path}', image: '{image_path}'). Please check paths."
770	    except Exception as e:
771	        return f"An unexpected error occurred in add_image_overlay: {str(e)}"
