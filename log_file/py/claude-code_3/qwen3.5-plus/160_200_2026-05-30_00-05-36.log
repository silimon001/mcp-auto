332	def _run_ffmpeg_with_fallback(input_path: str, output_path: str, primary_kwargs: dict, fallback_kwargs: dict) -> str:
333	    """Helper to run ffmpeg command with primary kwargs, falling back to other kwargs on ffmpeg.Error."""
334	    try:
335	        ffmpeg.input(input_path).output(output_path, **primary_kwargs).run(capture_stdout=True, capture_stderr=True)
336	        return f"Operation successful (primary method) and saved to {output_path}"
337	    except ffmpeg.Error as e_primary:
338	        try:
339	            ffmpeg.input(input_path).output(output_path, **fallback_kwargs).run(capture_stdout=True, capture_stderr=True)
340	            return f"Operation successful (fallback method) and saved to {output_path}"
341	        except ffmpeg.Error as e_fallback:
342	            err_primary_msg = e_primary.stderr.decode('utf8') if e_primary.stderr else str(e_primary)
343	            err_fallback_msg = e_fallback.stderr.decode('utf8') if e_fallback.stderr else str(e_fallback)
344	            return f"Error. Primary method failed: {err_primary_msg}. Fallback method also failed: {err_fallback_msg}"
345	    except FileNotFoundError:
346	        return f"Error: Input file not found at {input_path}"
347	    except Exception as e:
348	        return f"An unexpected error occurred: {str(e)}"
