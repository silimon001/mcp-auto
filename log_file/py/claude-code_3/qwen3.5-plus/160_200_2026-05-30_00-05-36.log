526	@mcp.tool(
527	    name="ticktick_get_task",
528	    annotations={
529	        "title": "Get Task",
530	        "readOnlyHint": True,
531	        "destructiveHint": False,
532	        "idempotentHint": True,
533	        "openWorldHint": True,
534	    },
535	)
536	async def ticktick_get_task(params: TaskGetInput, ctx: Context) -> str:
537	    """
538	    Get a task by its ID.
539	
540	    Retrieves full details of a specific task including title, content,
541	    kind (TEXT/NOTE/CHECKLIST), due date, priority, tags, subtasks, and status.
542	
543	    Args:
544	        params: Query parameters:
545	            - task_id (str, required): Task identifier
546	            - project_id (str): Project ID (optional, used for V1 fallback)
547	            - response_format (str): 'markdown' (default) or 'json'
548	
549	    Returns:
550	        Task details including: id, project_id, title, content, kind, status,
551	        priority, dates, tags, parent_id, child_ids, and checklist items.
552	    """
553	    try:
554	        client = get_client(ctx)
555	        task = await client.get_task(params.task_id, params.project_id)
556	
557	        if params.response_format == ResponseFormat.MARKDOWN:
558	            return format_task_markdown(task)
559	        else:
560	            return json.dumps(format_task_json(task), indent=2)
