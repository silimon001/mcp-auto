2655	                    None
2656	                )
2657	                date_str = (
2658	                    checkin_info.checkin_date
2659	                    if checkin_info and checkin_info.checkin_date
2660	                    else "today"
2661	                )
2662	
2663	                lines.append(f"## {habit.name}")
2664	                lines.append(f"- **Date**: {date_str}")
2665	                lines.append(f"- **Total Check-ins**: {habit.total_checkins}")
2666	                lines.append(f"- **Current Streak**: {habit.current_streak}")
2667	                lines.append("")
