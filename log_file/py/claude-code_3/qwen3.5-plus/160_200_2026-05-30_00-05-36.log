51	    Raises:
52	        RuntimeError: If service configuration fails
53	
54	    """
55	    global _skill_manager, _indexing_engine, _toolchain_detector, _repo_manager
56	
57	    try:
58	        # Set default paths
59	        base_dir = base_dir or Path.home() / ".mcp-skillset"
60	        storage_path = storage_path or base_dir / "storage"
61	
62	        # Ensure directories exist
63	        base_dir.mkdir(parents=True, exist_ok=True)
