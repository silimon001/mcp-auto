1271	def _prepare_clip_for_concat(source_path: str, start_time_sec: float, end_time_sec: float,
1272	                               target_props: dict, temp_dir: str, segment_index: int) -> str:
1273	    """Prepares a clip segment (trims, scales, sets common properties) for concatenation.
1274	    Returns path to the temporary processed clip.
1275	    """
1276	    try:
1277	        # Create a unique temp file name
1278	        temp_output_path = os.path.join(temp_dir, f"segment_{segment_index}.mp4")
1279	        
1280	        input_stream = ffmpeg.input(source_path, ss=start_time_sec, to=end_time_sec)
1281	        
1282	        processed_video_stream = None
1283	        processed_audio_stream = None
1284	
1285	        # Video processing
1286	        if target_props['has_video']:
1287	            video_s = input_stream.video
1288	            video_s = video_s.filter(
1289	                'scale',
1290	                width=str(target_props['width']), 
1291	                height=str(target_props['height']), 
1292	                force_original_aspect_ratio='decrease'
1293	            )
1294	            video_s = video_s.filter(
1295	                'pad',
1296	                width=str(target_props['width']),
1297	                height=str(target_props['height']),
1298	                x='(ow-iw)/2',
1299	                y='(oh-ih)/2',
1300	                color='black'
1301	            )
1302	            video_s = video_s.filter('setsar', '1/1') # Use ratio e.g. 1/1 for square pixels
1303	            video_s = video_s.filter('setpts', 'PTS-STARTPTS')
1304	            processed_video_stream = video_s
1305	        
1306	        # Audio processing
1307	        if target_props['has_audio']:
1308	            audio_s = input_stream.audio
1309	            audio_s = audio_s.filter('asetpts', 'PTS-STARTPTS')
1310	            audio_s = audio_s.filter(
1311	                'aformat',
1312	                sample_fmts='s16', # Common format for compatibility
1313	                sample_rates=str(target_props['sample_rate']),
1314	                channel_layouts=target_props['channel_layout']
1315	            )
1316	            processed_audio_stream = audio_s
1317	
1318	        output_params = {
1319	            'vcodec': 'libx264',
1320	            'pix_fmt': 'yuv420p',
1321	            'r': target_props['avg_fps'], # Frame rate
1322	            'acodec': 'aac',
1323	            'ar': target_props['sample_rate'], # Audio sample rate
1324	            'ac': target_props['channels'],   # Audio channels
1325	            'strict': '-2' # Needed for some AAC experimental features or if defaults change
1326	        }
1327	
1328	        output_streams_for_ffmpeg = []
1329	        if processed_video_stream:
1330	            output_streams_for_ffmpeg.append(processed_video_stream)
1331	        if processed_audio_stream:
1332	            output_streams_for_ffmpeg.append(processed_audio_stream)
1333	        
1334	        if not output_streams_for_ffmpeg:
1335	            # This can happen if the source has no video/audio or target_props indicates so.
1336	            # For a concatenation tool, we expect valid media.
1337	            raise ValueError(f"No video or audio streams identified to process for segment {segment_index} from {source_path}")
1338	
1339	        ffmpeg.output(*output_streams_for_ffmpeg, temp_output_path, **output_params).run(capture_stdout=True, capture_stderr=True)
1340	        return temp_output_path
1341	
1342	    except ffmpeg.Error as e:
1343	        err_msg = e.stderr.decode('utf8') if e.stderr else str(e)
1344	        raise RuntimeError(f"Error preparing segment {segment_index} from {source_path}: {err_msg}")
1345	    except Exception as e:
1346	        raise RuntimeError(f"Unexpected error preparing segment {segment_index} from {source_path}: {str(e)}")
