717	            )
718	            async def collect_artifact_details_tool(args: CollectArtifactDetailsArgs):
719	                """Get detailed information about a specific Velociraptor artifact.
720	
721	                This tool retrieves comprehensive details about a specific artifact including:
722	                - Full description of what the artifact does
723	                - All available parameters and their descriptions
724	                - Source code/VQL that defines the artifact
725	                - Parameter types and default values
726	
727	                This is useful for understanding an artifact before collecting it, or for
728	                debugging collection issues.
729	
730	                Args:
731	                    args: An object containing:
732	                        - artifact_name (required): Name of the artifact to get details for
733	
734	                Example usage:
735	                    {"args": {"artifact_name": "Windows.System.Users"}}
736	                    {"args": {"artifact_name": "Linux.Network.Netstat"}}
737	                    {"args": {"artifact_name": "Windows.NTFS.MFT"}}
738	
739	                Returns:
740	                    JSON object with detailed artifact information including description, parameters, and source.
741	                """
742	                try:
743	                    client = self._get_client()
744	
745	                    # Ensure client is authenticated
746	                    if client.stub is None:
747	                        await client.authenticate()
748	
749	                    # Execute the VQL query to get artifact details
750	                    vql = f"SELECT name,description,parameters,sources.name as source_names FROM artifact_definitions() WHERE name = '{args.artifact_name}'"
751	                    results = client.run_vql_query(vql)
752	
753	                    if not results:
754	                        return [
755	                            {
756	                                "type": "text",
757	                                "text": f"No artifact found with name: {args.artifact_name}",
758	                            },
759	                        ]
760	
761	                    # Get the first (and should be only) result
762	                    artifact_details = results[0]
763	
764	                    # Get source names - this is already a list of strings
765	                    source_names = artifact_details.get("source_names", [])
766	
767	                    # Format the response for better readability
768	                    formatted_details = {
769	                        "name": artifact_details.get("name", ""),
770	                        "description": artifact_details.get("description", ""),
771	                        "parameters": artifact_details.get("parameters", []),
772	                        "source_names": source_names,
773	                        "source_count": len(source_names) if source_names else 0,
774	                    }
775	
776	                    response_text = json.dumps(formatted_details, indent=2)
777	
778	                    return [
779	                        {
780	                            "type": "text",
