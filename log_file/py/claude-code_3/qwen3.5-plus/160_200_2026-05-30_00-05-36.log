130	                            "ownerName": dp.get("ownerName") or "N/A",
131	                            "source": "semantic_search"
132	                        }
133	                        results.append(formatted_product)
134	                
135	                await ctx.info(f"Search endpoint added {len(search_data_products)} additional data products")
136	            
137	            except Exception as e:
