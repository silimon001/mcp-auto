775	@mcp.tool()
776	def concatenate_videos(video_paths: list[str], output_video_path: str,
777	                       transition_effect: str = None, transition_duration: float = None) -> str:
778	    """Concatenates multiple video files into a single output file.
779	    Supports optional xfade transition when concatenating exactly two videos.
780	
781	    Args:
782	        video_paths: A list of paths to the video files to concatenate.
783	        output_video_path: The path to save the concatenated video file.
784	        transition_effect (str, optional): The xfade transition type. Options:
785	            - 'dissolve': Gradual blend between clips
786	            - 'fade': Simple fade through black
787	            - 'fadeblack': Fade through black
788	            - 'fadewhite': Fade through white
789	            - 'fadegrays': Fade through grayscale
790	            - 'distance': Distance transform transition
791	            - 'wipeleft', 'wiperight': Horizontal wipe
792	            - 'wipeup', 'wipedown': Vertical wipe
793	            - 'slideleft', 'slideright': Horizontal slide
794	            - 'slideup', 'slidedown': Vertical slide
795	            - 'smoothleft', 'smoothright': Smooth horizontal slide
796	            - 'smoothup', 'smoothdown': Smooth vertical slide
797	            - 'circlecrop': Rectangle crop transition
798	            - 'rectcrop': Rectangle crop transition
799	            - 'circleopen', 'circleclose': Circle open/close
800	            - 'vertopen', 'vertclose': Vertical open/close
801	            - 'horzopen', 'horzclose': Horizontal open/close
802	            - 'diagtl', 'diagtr', 'diagbl', 'diagbr': Diagonal transitions
803	            - 'hlslice', 'hrslice': Horizontal slice
804	            - 'vuslice', 'vdslice': Vertical slice
805	            - 'pixelize': Pixelize effect
806	            - 'radial': Radial transition
807	            - 'hblur': Horizontal blur
808	            Only applied if exactly two videos are provided. Defaults to None (no transition).
809	        transition_duration (float, optional): The duration of the xfade transition in seconds. 
810	                                             Required if transition_effect is specified. Defaults to None.
811	    
812	    Returns:
813	        A status message indicating success or failure.
814	    """
815	    if not video_paths:
816	        return "Error: No video paths provided for concatenation."
817	    if len(video_paths) < 1: # Allow single video to be "concatenated" (effectively copied/re-encoded)
818	        return "Error: At least one video is required."
819	    
820	    if transition_effect and transition_duration is None:
821	        return "Error: transition_duration is required when transition_effect is specified."
822	    if transition_effect and transition_duration <= 0:
823	        return "Error: transition_duration must be positive."
824	
825	    # Validate transition_effect
826	    valid_transitions = {
827	        'dissolve', 'fade', 'fadeblack', 'fadewhite', 'fadegrays', 'distance',
828	        'wipeleft', 'wiperight', 'wipeup', 'wipedown',
829	        'slideleft', 'slideright', 'slideup', 'slidedown',
830	        'smoothleft', 'smoothright', 'smoothup', 'smoothdown',
831	        'circlecrop', 'rectcrop', 'circleopen', 'circleclose',
832	        'vertopen', 'vertclose', 'horzopen', 'horzclose',
833	        'diagtl', 'diagtr', 'diagbl', 'diagbr',
834	        'hlslice', 'hrslice', 'vuslice', 'vdslice',
835	        'pixelize', 'radial', 'hblur'
836	    }
837	    if transition_effect and transition_effect not in valid_transitions:
838	        return f"Error: Invalid transition_effect '{transition_effect}'. Valid options: {', '.join(sorted(valid_transitions))}"
839	
840	    # Check if all input files exist
841	    for video_path in video_paths:
842	        if not os.path.exists(video_path):
843	            return f"Error: Input video file not found at {video_path}"
844	
845	    # Handle single video case (copy or re-encode to target)
846	    if len(video_paths) == 1:
847	        try:
848	            # Simple copy if no processing needed, or re-encode to a standard format.
849	            # For now, let's assume re-encoding to ensure it matches expectations of a processed file.
850	            # This could be enhanced to use target_props like in add_b_roll if needed.
851	            ffmpeg.input(video_paths[0]).output(output_video_path, vcodec='libx264', acodec='aac').run(capture_stdout=True, capture_stderr=True)
852	            return f"Single video processed and saved to {output_video_path}"
853	        except ffmpeg.Error as e:
854	            return f"Error processing single video: {e.stderr.decode('utf8') if e.stderr else str(e)}"
855	
856	    # Handle xfade transition for exactly two videos
857	    if transition_effect and len(video_paths) == 2:
858	        # Create a temporary directory for intermediate files
859	        temp_dir = tempfile.mkdtemp()
860	        try:
861	            video1_path = video_paths[0]
862	            video2_path = video_paths[1]
863	            
864	            props1 = _get_media_properties(video1_path)
865	            props2 = _get_media_properties(video2_path)
866	
867	            if not props1['has_video'] or not props2['has_video']:
868	                return "Error: xfade transition requires both inputs to be videos."
869	            if transition_duration >= props1['duration']:
870	                 return f"Error: Transition duration ({transition_duration}s) cannot be equal or longer than the first video's duration ({props1['duration']})."
871	
872	            # Check if both videos have audio
873	            has_audio = props1['has_audio'] and props2['has_audio']
874	            if not has_audio:
875	                print("Warning: At least one video lacks audio. Xfade will be video-only or silent audio.")
876	
877	            # Determine common target properties for normalization before xfade
878	            # Preferring higher resolution/fps from inputs, or defaulting.
879	            target_w = max(props1['width'], props2['width'], 640) 
880	            target_h = max(props1['height'], props2['height'], 360)
881	            # Ensure a common FPS, e.g., highest of the two, or a default like 30
882	            target_fps = max(props1['avg_fps'], props2['avg_fps'], 30)
883	            if target_fps <= 0: 
884	                target_fps = 30 # safety net
885	
886	            # Normalize input videos to have same dimensions and properties
887	            # First video
888	            norm_video1_path = os.path.join(temp_dir, "norm_video1.mp4")
889	            try:
890	                # Scale and set properties
891	                subprocess.run([
892	                    'ffmpeg',
893	                    '-i', video1_path,
894	                    '-vf', f'scale={target_w}:{target_h}',
895	                    '-r', str(target_fps),
896	                    '-c:v', 'libx264',
897	                    '-c:a', 'aac',
898	                    '-y',
899	                    norm_video1_path
900	                ], check=True, capture_output=True)
901	            except subprocess.CalledProcessError as e:
902	                return f"Error normalizing first video: {e.stderr.decode('utf8') if e.stderr else str(e)}"
903	
904	            # Second video
905	            norm_video2_path = os.path.join(temp_dir, "norm_video2.mp4")
906	            try:
907	                # Scale and set properties
908	                subprocess.run([
909	                    'ffmpeg',
910	                    '-i', video2_path,
911	                    '-vf', f'scale={target_w}:{target_h}',
912	                    '-r', str(target_fps),
913	                    '-c:v', 'libx264',
914	                    '-c:a', 'aac',
915	                    '-y',
916	                    norm_video2_path
917	                ], check=True, capture_output=True)
918	            except subprocess.CalledProcessError as e:
919	                return f"Error normalizing second video: {e.stderr.decode('utf8') if e.stderr else str(e)}"
920	
921	            # Get normalized video 1 duration
922	            norm_props1 = _get_media_properties(norm_video1_path)
923	            norm_video1_duration = norm_props1['duration']
924	            
925	            if transition_duration >= norm_video1_duration:
926	                return f"Error: Transition duration ({transition_duration}s) is too long for the normalized first video ({norm_video1_duration}s)."
927	
928	            # Calculate offset (where second video starts relative to first)
929	            offset = norm_video1_duration - transition_duration
930	            
931	            # Create filter complex for xfade transition
932	            filter_complex = f"[0:v][1:v]xfade=transition={transition_effect}:duration={transition_duration}:offset={offset}"
933	            
934	            # Base command for video transition
935	            cmd = [
936	                'ffmpeg',
937	                '-i', norm_video1_path,
938	                '-i', norm_video2_path,
939	                '-filter_complex'
940	            ]
941	            
942	            # Add appropriate filters for video and audio
943	            if has_audio:
944	                # Audio transition (crossfade)
945	                filter_complex += f",[0:a][1:a]acrossfade=d={transition_duration}:c1=tri:c2=tri"
946	                cmd.extend([filter_complex, '-map', '[v]', '-map', '[a]'])
947	            else:
948	                # Video only
949	                filter_complex += "[v]"
950	                cmd.extend([filter_complex, '-map', '[v]'])
951	            
952	            # Add output file and encoding parameters
953	            cmd.extend([
954	                '-c:v', 'libx264',
955	                '-c:a', 'aac',
956	                '-y',
957	                output_video_path
958	            ])
959	            
960	            try:
961	                subprocess.run(cmd, check=True, capture_output=True)
962	                return f"Videos concatenated successfully with '{transition_effect}' transition to {output_video_path}"
963	            except subprocess.CalledProcessError as e:
964	                return f"Error during xfade process: {e.stderr.decode('utf8') if e.stderr else str(e)}"
965	                
966	        except Exception as e:
967	            return f"An unexpected error occurred during xfade concatenation: {str(e)}"
968	        finally:
969	            # Clean up temporary directory
970	            shutil.rmtree(temp_dir)
971	    
972	    elif transition_effect and len(video_paths) > 2:
973	        return f"Error: xfade transition ('{transition_effect}') is currently only supported for exactly two videos. Found {len(video_paths)} videos."
974	
975	    # Standard concatenation for 2+ videos without xfade
976	    # We'll use the concat demuxer approach
977	    temp_dir = tempfile.mkdtemp()
978	    try:
979	        # Normalize all videos to the same format/codec/resolution
980	        normalized_paths = []
981	        
982	        # Get target properties from first video
983	        first_props = _get_media_properties(video_paths[0])
984	        target_w = first_props['width'] if first_props['width'] > 0 else 1280
985	        target_h = first_props['height'] if first_props['height'] > 0 else 720
986	        target_fps = first_props['avg_fps'] if first_props['avg_fps'] > 0 else 30
987	        if target_fps <= 0:
988	            target_fps = 30
989	        
990	        # Process each video
991	        for i, video_path in enumerate(video_paths):
992	            norm_path = os.path.join(temp_dir, f"norm_{i}.mp4")
993	            try:
994	                subprocess.run([
995	                    'ffmpeg',
996	                    '-i', video_path,
997	                    '-vf', f'scale={target_w}:{target_h}',
998	                    '-r', str(target_fps),
999	                    '-c:v', 'libx264',
1000	                    '-c:a', 'aac',
1001	                    '-y',
1002	                    norm_path
1003	                ], check=True, capture_output=True)
1004	                normalized_paths.append(norm_path)
1005	            except subprocess.CalledProcessError as e:
1006	                return f"Error normalizing video {i}: {e.stderr.decode('utf8') if e.stderr else str(e)}"
1007	        
1008	        # Create a concat file
1009	        concat_list_path = os.path.join(temp_dir, "concat_list.txt")
1010	        with open(concat_list_path, 'w') as f:
1011	            for path in normalized_paths:
1012	                f.write(f"file '{path}'\n")
1013	        
1014	        # Run ffmpeg concat
1015	        try:
1016	            subprocess.run([
1017	                'ffmpeg',
1018	                '-f', 'concat',
1019	                '-safe', '0',
1020	                '-i', concat_list_path,
1021	                '-c', 'copy',
1022	                '-y',
1023	                output_video_path
1024	            ], check=True, capture_output=True)
1025	            return f"Videos concatenated successfully to {output_video_path}"
1026	        except subprocess.CalledProcessError as e:
1027	            return f"Error during concatenation: {e.stderr.decode('utf8') if e.stderr else str(e)}"
1028	            
1029	    except Exception as e:
1030	        return f"An unexpected error occurred during standard concatenation: {str(e)}"
1031	    finally:
1032	        # Clean up temporary directory
1033	        shutil.rmtree(temp_dir)
