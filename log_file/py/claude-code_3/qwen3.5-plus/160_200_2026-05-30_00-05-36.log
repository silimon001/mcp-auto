1573	@mcp.tool()
1574	def add_basic_transitions(video_path: str, output_video_path: str, transition_type: str, duration_seconds: float) -> str:
1575	    """Adds basic fade transitions to the beginning or end of a video.
1576	
1577	    Args:
1578	        video_path: Path to the input video file.
1579	        output_video_path: Path to save the video with the transition.
1580	        transition_type: Type of transition. Options: 'fade_in', 'fade_out'.
1581	                         (Note: 'crossfade_from_black' is like 'fade_in', 'crossfade_to_black' is like 'fade_out')
1582	        duration_seconds: Duration of the fade effect in seconds.
1583	    Returns:
1584	        A status message indicating success or failure.
1585	    """
1586	    if not os.path.exists(video_path):
1587	        return f"Error: Input video file not found at {video_path}"
1588	    if duration_seconds <= 0:
1589	        return "Error: Transition duration must be positive."
1590	
1591	    try:
1592	        props = _get_media_properties(video_path)
1593	        video_total_duration = props['duration']
1594	
1595	        if duration_seconds > video_total_duration:
1596	            return f"Error: Transition duration ({duration_seconds}s) cannot exceed video duration ({video_total_duration}s)."
1597	
1598	        input_stream = ffmpeg.input(video_path)
1599	        video_stream = input_stream.video
1600	        audio_stream = input_stream.audio
1601	        
1602	        processed_video = None
1603	
1604	        if transition_type == 'fade_in' or transition_type == 'crossfade_from_black':
1605	            processed_video = video_stream.filter('fade', type='in', start_time=0, duration=duration_seconds)
1606	        elif transition_type == 'fade_out' or transition_type == 'crossfade_to_black':
1607	            fade_start_time = video_total_duration - duration_seconds
1608	            processed_video = video_stream.filter('fade', type='out', start_time=fade_start_time, duration=duration_seconds)
1609	        else:
1610	            return f"Error: Unsupported transition_type '{transition_type}'. Supported: 'fade_in', 'fade_out'."
1611	
1612	        # Attempt to copy audio, fallback to re-encoding if necessary
1613	        output_streams = []
1614	        if props['has_video']:
1615	            output_streams.append(processed_video)
1616	        if props['has_audio']:
1617	            output_streams.append(audio_stream) # Audio is passed through without fade
1618	        else: # Video only
1619	            pass
1620	        
1621	        if not output_streams:
1622	            return "Error: No suitable video or audio streams found to apply transition."
1623	
1624	        try:
1625	            ffmpeg.output(*output_streams, output_video_path, acodec='copy').run(capture_stdout=True, capture_stderr=True)
1626	            return f"Transition '{transition_type}' applied successfully (audio copied). Output: {output_video_path}"
1627	        except ffmpeg.Error as e_acopy:
1628	            # Fallback: re-encode audio (or just output video if no audio originally)
1629	            try:
1630	                ffmpeg.output(*output_streams, output_video_path).run(capture_stdout=True, capture_stderr=True)
1631	                return f"Transition '{transition_type}' applied successfully (audio re-encoded/processed). Output: {output_video_path}"
1632	            except ffmpeg.Error as e_recode:
1633	                err_acopy = e_acopy.stderr.decode('utf8') if e_acopy.stderr else str(e_acopy)
1634	                err_recode = e_recode.stderr.decode('utf8') if e_recode.stderr else str(e_recode)
1635	                return f"Error applying transition. Audio copy failed: {err_acopy}. Full re-encode failed: {err_recode}."
1636	
1637	    except ffmpeg.Error as e:
1638	        error_message = e.stderr.decode('utf8') if e.stderr else str(e)
