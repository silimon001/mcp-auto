1035	@mcp.tool()
1036	def change_video_speed(video_path: str, output_video_path: str, speed_factor: float) -> str:
1037	    """Changes the playback speed of a video (and its audio).
1038	
1039	    Args:
1040	        video_path: Path to the input video file.
1041	        output_video_path: Path to save the speed-adjusted video file.
1042	        speed_factor: The factor by which to change the speed (e.g., 2.0 for 2x speed, 0.5 for half speed).
1043	                      Must be positive.
1044	    
1045	    Returns:
1046	        A status message indicating success or failure.
1047	    """
1048	    if speed_factor <= 0:
1049	        return "Error: Speed factor must be positive."
1050	    if not os.path.exists(video_path):
1051	        return f"Error: Input video file not found at {video_path}"
1052	
1053	    try:
1054	        # Process atempo values (audio speed) - requires special handling for values outside 0.5-2.0 range
1055	        atempo_value = speed_factor
1056	        atempo_filters = []
1057	        
1058	        # Handle audio speed outside atempo's range (0.5-2.0)
1059	        if speed_factor < 0.5:
1060	            # For speed < 0.5, use multiple atempo=0.5 filters
1061	            while atempo_value < 0.5:
1062	                atempo_filters.append("atempo=0.5")
1063	                atempo_value *= 2  # After applying atempo=0.5, the remaining factor doubles
1064	            # Add the remaining factor if needed
1065	            if atempo_value < 0.99:  # A bit of buffer for floating point comparison
1066	                atempo_filters.append(f"atempo={atempo_value}")
1067	        elif speed_factor > 2.0:
1068	            # For speed > 2.0, use multiple atempo=2.0 filters
1069	            while atempo_value > 2.0:
1070	                atempo_filters.append("atempo=2.0")
1071	                atempo_value /= 2  # After applying atempo=2.0, the remaining factor halves
1072	            # Add the remaining factor if needed
1073	            if atempo_value > 1.01:  # A bit of buffer for floating point comparison
1074	                atempo_filters.append(f"atempo={atempo_value}")
1075	        else:
1076	            # For speed factors within range, just use one atempo filter
1077	            atempo_filters.append(f"atempo={speed_factor}")
1078	        
1079	        # Apply separate filters to video and audio streams
1080	        input_stream = ffmpeg.input(video_path)
1081	        video = input_stream.video.setpts(f"{1.0/speed_factor}*PTS")
1082	        
1083	        # Chain multiple audio filters if needed
1084	        audio = input_stream.audio
1085	        for filter_str in atempo_filters:
1086	            audio = audio.filter("atempo", speed_factor if filter_str == f"atempo={speed_factor}" else 
1087	                               0.5 if filter_str == "atempo=0.5" else 
1088	                               2.0 if filter_str == "atempo=2.0" else 
1089	                               float(filter_str.replace("atempo=", "")))
1090	        
1091	        # Combine processed streams and output
1092	        output = ffmpeg.output(video, audio, output_video_path)
1093	        output.run(capture_stdout=True, capture_stderr=True)
1094	        
1095	        return f"Video speed changed by factor {speed_factor} and saved to {output_video_path}"
1096	    except ffmpeg.Error as e:
1097	        error_message = e.stderr.decode('utf8') if e.stderr else str(e)
1098	        return f"Error changing video speed: {error_message}"
1099	    except Exception as e:
1100	        return f"An unexpected error occurred while changing video speed: {str(e)}"
