2758	def _apply_tool_filtering():
2759	    """
2760	    Apply tool filtering based on TICKTICK_ENABLED_TOOLS environment variable.
2761	
2762	    This removes tools that are not in the enabled list, reducing context window
2763	    usage when using the MCP server with AI assistants.
2764	    """
2765	    import os
2766	
2767	    enabled_tools_env = os.environ.get("TICKTICK_ENABLED_TOOLS")
2768	    if not enabled_tools_env:
2769	        return  # No filtering, all tools enabled
2770	
2771	    enabled_tools = set(enabled_tools_env.split(","))
2772	
2773	    # Get all registered tools
2774	    all_tools = mcp._tool_manager.list_tools()
2775	    tools_to_remove = []
2776	
2777	    for tool in all_tools:
2778	        if tool.name not in enabled_tools:
2779	            tools_to_remove.append(tool.name)
2780	
2781	    # Remove disabled tools
2782	    for tool_name in tools_to_remove:
2783	        try:
2784	            mcp._tool_manager.remove_tool(tool_name)
2785	        except Exception as e:
2786	            logger.warning("Failed to remove tool %s: %s", tool_name, e)
2787	
2788	    remaining = len(all_tools) - len(tools_to_remove)
2789	    logger.info(
2790	        "Tool filtering applied: %d of %d tools enabled",
2791	        remaining,
2792	        len(all_tools),
2793	    )
2794	
2795	
2796	def main():
2797	    """Main entry point for the TickTick MCP server."""
2798	    _apply_tool_filtering()
2799	    mcp.run()
2800	
2801	
2802	if __name__ == "__main__":
2803	    main()
