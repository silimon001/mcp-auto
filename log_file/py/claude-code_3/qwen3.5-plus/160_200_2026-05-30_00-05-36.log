113	@mcp.tool()
114	def convert_video_properties(input_video_path: str, output_video_path: str, target_format: str,
115	                               resolution: str = None, video_codec: str = None, video_bitrate: str = None,
116	                               frame_rate: int = None, audio_codec: str = None, audio_bitrate: str = None,
117	                               audio_sample_rate: int = None, audio_channels: int = None) -> str:
118	    """Converts video file format and ALL specified properties like resolution, codecs, bitrates, and frame rate.
119	    Args listed in PRD.
120	    Returns:
121	        A status message indicating success or failure.
122	    """
123	    try:
124	        stream = ffmpeg.input(input_video_path)
125	        kwargs = {}
126	        vf_filters = []
127	
128	        if resolution and resolution.lower() != 'preserve':
129	            if 'x' in resolution: 
130	                vf_filters.append(f"scale={resolution}")
131	            else: 
132	                vf_filters.append(f"scale=-2:{resolution}")
133	        
134	        if vf_filters:
135	            kwargs['vf'] = ",".join(vf_filters)
136	
137	        if video_codec: kwargs['vcodec'] = video_codec
138	        if video_bitrate: kwargs['video_bitrate'] = video_bitrate
139	        if frame_rate: kwargs['r'] = frame_rate
140	        if audio_codec: kwargs['acodec'] = audio_codec
141	        if audio_bitrate: kwargs['audio_bitrate'] = audio_bitrate
142	        if audio_sample_rate: kwargs['ar'] = audio_sample_rate
143	        if audio_channels: kwargs['ac'] = audio_channels
144	        kwargs['format'] = target_format
145	
146	        output_stream = stream.output(output_video_path, **kwargs)
147	        output_stream.run(capture_stdout=True, capture_stderr=True)
148	        return f"Video converted successfully to {output_video_path} with format {target_format} and specified properties."
149	    except ffmpeg.Error as e:
150	        error_message = e.stderr.decode('utf8') if e.stderr else str(e)
151	        return f"Error converting video properties: {error_message}"
152	    except FileNotFoundError:
153	        return f"Error: Input video file not found at {input_video_path}"
154	    except Exception as e:
155	        return f"An unexpected error occurred: {str(e)}"
