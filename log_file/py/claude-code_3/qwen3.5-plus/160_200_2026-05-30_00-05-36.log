158	@mcp.tool()
159	async def dataproduct_get(ctx: Context, data_product_id: str) -> Dict[str, Any]:
160	    """
161	    Get a data product by its ID. The data product contains all its output ports and server information.
162	    The response includes access status for each output port and inlines any data contracts.
163	    
164	    Args:
165	        data_product_id: The data product ID.
166	        
167	    Returns:
168	        Dict containing the data product details with enhanced output ports.
169	    """
170	    await ctx.info(f"dataproduct_get called with data_product_id={data_product_id}")
171	    
172	    try:
173	        client = DataMeshManagerClient()
174	        data_product = await client.get_data_product(data_product_id)
175	        
176	        if not data_product:
177	            await ctx.info(f"dataproduct_get: data product {data_product_id} not found")
178	            return {"error": "Data product not found"}
179	        
180	        # todo make null safe
181	        access_lifecycle_status = "You do not have access to this output port"
182	
183	        # Add access status to each output port
184	        output_ports = data_product.get("outputPorts", [])
185	        for output_port in output_ports:
186	            try:
187	                output_port_id = output_port.get("id")
188	                if output_port_id:
189	                    await ctx.info(f"Checking access status for output port {output_port_id}")
190	                    access_status = await client.get_access_status(data_product_id, output_port_id)
191	
192	                    # Set output_port["accessStatus"] based on the result of access_status
193	                    lifecycle_status = access_status.access_lifecycle_status if access_status else None
194	                    access_status_value = access_status.access_status if access_status else None
195	                    
196	                    if not lifecycle_status:
197	                        output_port["accessStatus"] = "You do not have access to this output port, you can request access. You may not access the data directly for data governance reasons without an approved access request."
198	                    elif lifecycle_status == "requested":
199	                        output_port["accessStatus"] = f"Your access request is pending approval (status: {access_status_value}, lifecycle: {lifecycle_status}). You may not access the data directly for data governance reasons without an approved access request."
200	                    elif lifecycle_status == "rejected":
201	                        output_port["accessStatus"] = f"Your access request was rejected (status: {access_status_value}, lifecycle: {lifecycle_status})"
202	                    elif lifecycle_status == "upcoming":
203	                        output_port["accessStatus"] = f"Your access is upcoming (status: {access_status_value}, lifecycle: {lifecycle_status}). You may not access the data directly for data governance reasons without an approved access request."
204	                    elif lifecycle_status == "active":
205	                        output_port["accessStatus"] = f"You already have access to this output port (status: {access_status_value}, lifecycle: {lifecycle_status})"
206	                    elif lifecycle_status == "expired":
207	                        output_port["accessStatus"] = f"Your access request is expired (status: {access_status_value}, lifecycle: {lifecycle_status})"
208	                    else:
209	                        output_port["accessStatus"] = f"Access status: {access_status_value}, lifecycle: {lifecycle_status}"
210	
211	                    await ctx.info(f"Added access status for output port {output_port_id}")
212	                else:
213	                    await ctx.warning(f"Output port missing externalId/id, skipping access status")
214	                    output_port["accessStatus"] = None
215	            except Exception as e:
216	                await ctx.warning(f"Failed to get access status for output port {output_port.get('externalId', 'unknown')}: {str(e)}")
217	                output_port["accessStatus"] = None
218	            
219	            # Resolve and inline data contract if dataContractId exists
220	            data_contract_id = output_port.get("dataContractId")
221	            if data_contract_id:
222	                try:
223	                    await ctx.info(f"Resolving data contract {data_contract_id} for output port {output_port.get('id', 'unknown')}")
224	                    data_contract = await client.get_data_contract(data_contract_id)
225	                    
226	                    if data_contract:
227	                        output_port["dataContract"] = data_contract
228	                        await ctx.info(f"Successfully inlined data contract {data_contract_id}")
229	                    else:
230	                        await ctx.warning(f"Data contract {data_contract_id} not found")
231	                        output_port["dataContract"] = None
232	                except Exception as e:
233	                    await ctx.warning(f"Failed to resolve data contract {data_contract_id}: {str(e)}")
234	                    output_port["dataContract"] = None
235	        
236	        # Sanitize response for prompt injections
237	        data_product = sanitize_prompt_injection(data_product, "get_response")
238	        
239	        # Return the enhanced data product directly as structured data
240	        await ctx.info(f"dataproduct_get successfully retrieved data product {data_product_id} with access status")
241	        return data_product
242	        
243	    except ValueError as e:
244	        await ctx.error(f"dataproduct_get ValueError: {str(e)}")
245	        return {"error": str(e)}
246	    except Exception as e:
247	        await ctx.error(f"dataproduct_get Exception: {str(e)}")
248	        return {"error": f"Error fetching data product: {str(e)}"}
