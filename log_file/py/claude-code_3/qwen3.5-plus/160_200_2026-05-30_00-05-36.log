1	"""Command: mcp - Start MCP server for Claude Code integration."""
2	
3	from __future__ import annotations
4	
5	import sys
6	
7	import click
8	from rich.console import Console
9	
10	
11	# Create stderr console for MCP mode - stdout must be reserved for JSON-RPC
12	stderr_console = Console(stderr=True, force_terminal=True)
13	
14	
15	@click.command(name="mcp")
16	@click.option("--dev", is_flag=True, help="Development mode")
17	def mcp(dev: bool) -> None:
18	    """Start MCP server for Claude Code integration.
19	
20	    Starts the FastMCP server using stdio transport, making skills
21	    available to Claude Code via Model Context Protocol.
22	
23	    Usage:
24	        mcp-skillset mcp
25	
26	    The server will run in stdio mode and communicate with Claude Code.
27	
28	    IMPORTANT: All output goes to stderr to preserve stdout for JSON-RPC protocol.
29	    """
30	    stderr_console.print(
31	        "🚀 [bold green]Starting MCP server for Claude Code...[/bold green]"
32	    )
33	    stderr_console.print("📡 stdio transport")
34	
35	    if dev:
36	        stderr_console.print("🔧 [yellow]Development mode enabled[/yellow]")
37	
38	    # Import and configure MCP server
39	    from mcp_skills.mcp.server import configure_services
40	    from mcp_skills.mcp.server import main as mcp_main
41	
42	    try:
43	        # Initialize services (SkillManager, IndexingEngine, ToolchainDetector, RepositoryManager)
44	        stderr_console.print("⚙️  Configuring services...")
45	        configure_services()
46	
47	        stderr_console.print("✅ Services configured")
48	        stderr_console.print("📡 stdio transport active")
49	        stderr_console.print("🎯 Ready for Claude Code connection\n")
50	
51	        # Start FastMCP server (blocks until terminated)
52	        mcp_main()
53	    except KeyboardInterrupt:
54	        stderr_console.print("\n[yellow]⚠️  Server stopped by user[/yellow]")
55	        raise SystemExit(0)
56	    except Exception as e:
57	        stderr_console.print(f"\n[red]❌ Server failed to start: {e}[/red]")
58	        import traceback
59	
60	        if dev:
61	            traceback.print_exc(file=sys.stderr)
62	        raise SystemExit(1)
63	

