38	class HybridSearchConfig(BaseSettings):
39	    """Hybrid search weighting configuration.
40	
41	    Configures the relative weights of vector similarity search vs.
42	    knowledge graph relationships in hybrid search.
43	
44	    Attributes:
45	        vector_weight: Weight for vector similarity (0.0-1.0)
46	        graph_weight: Weight for graph relationships (0.0-1.0)
47	        preset: Optional preset name for identification
48	
49	    Constraints:
50	        - vector_weight + graph_weight must equal 1.0
51	        - Both weights must be non-negative
52	
53	    Use Cases:
54	        - semantic_focused (0.9/0.1): Best for natural language queries
55	        - graph_focused (0.3/0.7): Best for discovering related skills
56	        - balanced (0.5/0.5): General purpose, equal weighting
57	        - current (0.7/0.3): Optimized through testing (default)
58	    """
59	
60	    vector_weight: float = Field(
61	        0.7,
62	        ge=0.0,
63	        le=1.0,
64	        description="Weight for vector similarity search (0.0-1.0)",
65	    )
66	    graph_weight: float = Field(
67	        0.3,
68	        ge=0.0,
69	        le=1.0,
70	        description="Weight for knowledge graph relationships (0.0-1.0)",
71	    )
72	    preset: str | None = Field(
73	        None,
74	        description="Preset name (semantic_focused, graph_focused, balanced, current)",
75	    )
76	
77	    @field_validator("graph_weight")
78	    @classmethod
79	    def validate_weights_sum(cls, v: float, info: Any) -> float:
80	        """Validate that weights sum to 1.0.
81	
82	        Args:
83	            v: graph_weight value
84	            info: Validation context containing vector_weight
85	
86	        Returns:
87	            Validated graph_weight
88	
89	        Raises:
90	            ValueError: If weights don't sum to 1.0
91	        """
92	        vector_weight = info.data.get("vector_weight", 0.0)
93	        total = vector_weight + v
94	        if abs(total - 1.0) > 1e-6:  # Allow small floating point error
95	            raise ValueError(
96	                f"Weights must sum to 1.0, got {total:.6f} "
97	                f"(vector_weight={vector_weight}, graph_weight={v})"
98	            )
99	        return v
100	
101	    @classmethod
102	    def semantic_focused(cls) -> "HybridSearchConfig":
103	        """Preset optimized for semantic similarity queries.
104	
105	        Best for: Natural language queries, fuzzy matching, concept search
106	        Trade-off: Less emphasis on explicit skill relationships
107	
108	        Returns:
109	            HybridSearchConfig with 0.9 vector, 0.1 graph weighting
110	        """
111	        return cls(vector_weight=0.9, graph_weight=0.1, preset="semantic_focused")
112	
113	    @classmethod
114	    def graph_focused(cls) -> "HybridSearchConfig":
115	        """Preset optimized for relationship discovery.
116	
117	        Best for: Finding related skills, dependency traversal, connected components
118	        Trade-off: Less emphasis on semantic similarity
119	
120	        Returns:
121	            HybridSearchConfig with 0.3 vector, 0.7 graph weighting
122	        """
123	        return cls(vector_weight=0.3, graph_weight=0.7, preset="graph_focused")
124	
125	    @classmethod
126	    def balanced(cls) -> "HybridSearchConfig":
127	        """Preset with equal weighting.
128	
129	        Best for: General purpose, no preference between methods
130	        Trade-off: May not excel at either semantic or relationship queries
131	
132	        Returns:
133	            HybridSearchConfig with 0.5 vector, 0.5 graph weighting
134	        """
135	        return cls(vector_weight=0.5, graph_weight=0.5, preset="balanced")
136	
137	    @classmethod
138	    def current(cls) -> "HybridSearchConfig":
139	        """Default preset optimized through testing.
140	
141	        Best for: General skill discovery with slight semantic emphasis
142	        This is the proven default from testing and should work well for most use cases.
143	
144	        Returns:
145	            HybridSearchConfig with 0.7 vector, 0.3 graph weighting
146	        """
147	        return cls(vector_weight=0.7, graph_weight=0.3, preset="current")
