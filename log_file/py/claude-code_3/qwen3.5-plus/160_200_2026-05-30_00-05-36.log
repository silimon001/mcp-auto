2213	def format_habit_markdown(habit: Habit) -> str:
2214	    """Format a habit for markdown display."""
2215	    lines = [
2216	        f"## {habit.name}",
2217	        f"- **ID**: `{habit.id}`",
2218	        f"- **Type**: {habit.habit_type}",
2219	        f"- **Goal**: {habit.goal} {habit.unit}",
2220	    ]
2221	
2222	    if habit.is_numeric:
2223	        lines.append(f"- **Step**: +{habit.step}")
2224	
2225	    lines.append(f"- **Status**: {'Archived' if habit.is_archived else 'Active'}")
2226	    lines.append(f"- **Total Check-ins**: {habit.total_checkins}")
2227	    lines.append(f"- **Current Streak**: {habit.current_streak}")
2228	
2229	    if habit.target_days > 0:
2230	        lines.append(f"- **Target**: {habit.target_days} days")
2231	
2232	    if habit.color:
2233	        lines.append(f"- **Color**: {habit.color}")
2234	
2235	    if habit.repeat_rule:
2236	        lines.append(f"- **Repeat**: `{habit.repeat_rule}`")
2237	
2238	    if habit.reminders:
2239	        lines.append(f"- **Reminders**: {', '.join(habit.reminders)}")
2240	
2241	    if habit.encouragement:
2242	        lines.append(f"- **Encouragement**: {habit.encouragement}")
2243	
2244	    return "\n".join(lines)
2245	
2246	
2247	def format_habit_json(habit: Habit) -> dict[str, Any]:
2248	    """Format a habit for JSON output."""
2249	    return {
2250	        "id": habit.id,
2251	        "name": habit.name,
2252	        "type": habit.habit_type,
2253	        "goal": habit.goal,
2254	        "step": habit.step,
2255	        "unit": habit.unit,
2256	        "status": "archived" if habit.is_archived else "active",
2257	        "total_checkins": habit.total_checkins,
2258	        "current_streak": habit.current_streak,
2259	        "target_days": habit.target_days,
2260	        "color": habit.color,
2261	        "icon": habit.icon,
2262	        "repeat_rule": habit.repeat_rule,
2263	        "reminders": habit.reminders,
2264	        "section_id": habit.section_id,
2265	        "encouragement": habit.encouragement,
2266	        "created_time": habit.created_time.isoformat() if habit.created_time else None,
2267	        "modified_time": habit.modified_time.isoformat() if habit.modified_time else None,
2268	    }
