249	@asynccontextmanager
250	async def lifespan(mcp: FastMCP) -> AsyncIterator[dict[str, Any]]:
251	    """
252	    Manage the TickTick client lifecycle.
253	
254	    Initializes the client on startup and closes it on shutdown.
255	    """
256	    logger.info("Initializing TickTick MCP Server...")
257	
258	    try:
259	        client = TickTickClient.from_settings()
260	        await client.connect()
261	        logger.info("TickTick client connected successfully")
262	        yield {"client": client}
263	    except Exception as e:
264	        logger.error("Failed to initialize TickTick client: %s", e)
265	        raise
266	    finally:
267	        if "client" in locals():
268	            await client.disconnect()
269	            logger.info("TickTick client disconnected")
270	
271	
272	# Initialize FastMCP server
273	mcp = FastMCP(
274	    "ticktick_sdk",
275	    lifespan=lifespan,
276	)
