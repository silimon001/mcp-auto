1237	def _get_media_properties(media_path: str) -> dict:
1238	    """Probes media file and returns key properties."""
1239	    try:
1240	        probe = ffmpeg.probe(media_path)
1241	        video_stream_info = next((s for s in probe['streams'] if s['codec_type'] == 'video'), None)
1242	        audio_stream_info = next((s for s in probe['streams'] if s['codec_type'] == 'audio'), None)
1243	        
1244	        props = {
1245	            'duration': float(probe['format'].get('duration', 0.0)),
1246	            'has_video': video_stream_info is not None,
1247	            'has_audio': audio_stream_info is not None,
1248	            'width': int(video_stream_info['width']) if video_stream_info and 'width' in video_stream_info else 0,
1249	            'height': int(video_stream_info['height']) if video_stream_info and 'height' in video_stream_info else 0,
1250	            'avg_fps': 0, # Default, will be calculated if possible
1251	            'sample_rate': int(audio_stream_info['sample_rate']) if audio_stream_info and 'sample_rate' in audio_stream_info else 44100,
1252	            'channels': int(audio_stream_info['channels']) if audio_stream_info and 'channels' in audio_stream_info else 2,
1253	            'channel_layout': audio_stream_info.get('channel_layout', 'stereo') if audio_stream_info else 'stereo'
1254	        }
1255	        if video_stream_info and 'avg_frame_rate' in video_stream_info and video_stream_info['avg_frame_rate'] != '0/0':
1256	            num, den = map(int, video_stream_info['avg_frame_rate'].split('/'))
1257	            if den > 0:
1258	                props['avg_fps'] = num / den
1259	            else:
1260	                props['avg_fps'] = 30 # Default if denominator is 0
1261	        else: # Fallback if avg_frame_rate is not useful
1262	            props['avg_fps'] = 30 # A common default
1263	
1264	        return props
1265	    except ffmpeg.Error as e:
1266	        raise RuntimeError(f"Error probing file {media_path}: {e.stderr.decode('utf8') if e.stderr else str(e)}")
1267	    except Exception as e:
1268	        raise RuntimeError(f"Unexpected error probing file {media_path}: {str(e)}")
1269	
