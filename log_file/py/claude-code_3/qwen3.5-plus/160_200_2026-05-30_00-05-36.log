1158	
1159	        count = len(updated_tasks)
1160	        if count == 1:
1161	            task = updated_tasks[0]
1162	            action = "pinned" if params.tasks[0].pin else "unpinned"
1163	            if params.response_format == ResponseFormat.MARKDOWN:
1164	                return f"**Success**: Task '{task.title}' has been {action}.\n\n" + format_task_markdown(task)
