429	        # Set computed paths if not provided
430	        if self.repos_dir is None:
431	            self.repos_dir = self.base_dir / "repos"
432	        if self.indices_dir is None:
433	            self.indices_dir = self.base_dir / "indices"
434	        if self.vector_store.persist_directory is None:
435	            self.vector_store.persist_directory = self.indices_dir / "vector_store"
436	        if self.knowledge_graph.persist_path is None:
437	            self.knowledge_graph.persist_path = self.indices_dir / "knowledge_graph.pkl"
438	
439	        # Create directories
440	        self.base_dir.mkdir(parents=True, exist_ok=True)
441	        if self.repos_dir:
442	            self.repos_dir.mkdir(parents=True, exist_ok=True)
443	        if self.indices_dir:
444	            self.indices_dir.mkdir(parents=True, exist_ok=True)
