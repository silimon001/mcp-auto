691	async def ticktick_update_tasks(params: UpdateTasksInput, ctx: Context) -> str:
692	    """
693	    Update one or more tasks.
694	
695	    Updates specified fields of tasks. Supports batch updates (1-100 tasks).
696	    Each update preserves unspecified fields (only specified fields are changed).
697	
698	    Args:
699	        params: Update parameters:
700	            - tasks (list, required): List of update specifications (1-100 tasks)
701	              Each update must contain:
702	                - task_id (str, required): Task to update
703	                - project_id (str, required): Project containing the task
704	              Optional update fields:
705	                - title (str): New title
706	                - content (str): New content/notes
707	                - kind (str): Change task type - 'TEXT', 'NOTE', or 'CHECKLIST'
708	                - priority (str): 'none', 'low', 'medium', 'high'
709	                - start_date (str): Start date in ISO format
710	                - due_date (str): Due date in ISO format
711	                - time_zone (str): IANA timezone (e.g., 'America/New_York')
712	                - all_day (bool): Whether task is all-day
713	                - tags (list[str]): New tags (replaces existing tags)
714	                - recurrence (str): RRULE format for recurring tasks
715	                - column_id (str): Kanban column ID for board assignment
716	                  (use empty string '' to remove from column)
717	            - response_format (str): 'markdown' (default) or 'json'
718	
719	    Returns:
720	        Summary of updated tasks or error message.
721	
722	    Examples:
723	        Update priority:
724	            tasks=[{"task_id": "abc123", "project_id": "proj1", "priority": "high"}]
725	
726	        Convert task to note:
727	            tasks=[{"task_id": "abc123", "project_id": "proj1", "kind": "NOTE"}]
728	
729	        Assign to kanban column:
730	            tasks=[{"task_id": "abc1", "project_id": "proj1", "column_id": "col123"}]
731	
732	        Remove from kanban column:
733	            tasks=[{"task_id": "abc1", "project_id": "proj1", "column_id": ""}]
734	
735	        Batch update multiple tasks:
736	            tasks=[
737	                {"task_id": "abc1", "project_id": "proj1", "title": "Updated 1"},
738	                {"task_id": "abc2", "project_id": "proj1", "priority": "low"}
739	            ]
740	    """
741	    try:
742	        client = get_client(ctx)
743	
744	        # Build update specifications
745	        update_specs = []
746	        for task_item in params.tasks:
747	            spec: dict[str, Any] = {
748	                "task_id": task_item.task_id,
749	                "project_id": task_item.project_id,
750	            }
751	
752	            if task_item.title is not None:
753	                spec["title"] = task_item.title
754	            if task_item.content is not None:
755	                spec["content"] = task_item.content
756	            if task_item.priority is not None:
757	                spec["priority"] = task_item.priority
758	            if task_item.start_date is not None:
759	                spec["start_date"] = task_item.start_date
760	            if task_item.due_date is not None:
761	                spec["due_date"] = task_item.due_date
762	            if task_item.all_day is not None:
763	                spec["all_day"] = task_item.all_day
764	            if task_item.time_zone is not None:
765	                spec["time_zone"] = task_item.time_zone
766	            if task_item.tags is not None:
767	                spec["tags"] = task_item.tags
768	            if task_item.recurrence is not None:
769	                spec["recurrence"] = task_item.recurrence
770	            if task_item.column_id is not None:
771	                spec["column_id"] = task_item.column_id
772	            if task_item.kind is not None:
773	                spec["kind"] = task_item.kind
774	
775	            update_specs.append(spec)
776	
777	        response = await client.update_tasks(update_specs)
778	
779	        if params.response_format == ResponseFormat.MARKDOWN:
780	            count = len(update_specs)
781	            if count == 1:
782	                return f"# Task Updated\n\nSuccessfully updated task `{update_specs[0]['task_id']}`"
783	            else:
784	                return f"# {count} Tasks Updated\n\nSuccessfully updated {count} tasks."
785	        else:
786	            return json.dumps({
787	                "success": True,
788	                "count": len(update_specs),
789	                "response": response
790	            }, indent=2)
791	
792	    except Exception as e:
793	        return handle_error(e, "update_tasks")
794	
