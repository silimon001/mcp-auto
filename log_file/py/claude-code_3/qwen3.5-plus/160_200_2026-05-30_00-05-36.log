351	def convert_video_format(input_video_path: str, output_video_path: str, target_format: str) -> str:
352	    """Converts a video file to the specified target format, attempting to copy codecs first.
353	    Args:
354	        input_video_path: Path to the source video file.
355	        output_video_path: Path to save the converted video file.
356	        target_format: Desired output video format (e.g., 'mp4', 'mov', 'avi').
357	    Returns:
358	        A status message indicating success or failure.
359	    """
360	    primary_kwargs = {'format': target_format, 'vcodec': 'copy', 'acodec': 'copy'}
361	    fallback_kwargs = {'format': target_format} # Re-encode both streams
362	    return _run_ffmpeg_with_fallback(input_video_path, output_video_path, primary_kwargs, fallback_kwargs)
