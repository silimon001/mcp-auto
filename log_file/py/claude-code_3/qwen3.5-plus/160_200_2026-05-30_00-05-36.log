77	def convert_audio_properties(input_audio_path: str, output_audio_path: str, target_format: str, 
78	                               bitrate: str = None, sample_rate: int = None, channels: int = None) -> str:
79	    """Converts audio file format and ALL specified properties like bitrate, sample rate, and channels.
80	
81	    Args:
82	        input_audio_path: Path to the source audio file.
83	        output_audio_path: Path to save the converted audio file.
84	        target_format: Desired output audio format (e.g., 'mp3', 'wav', 'aac').
85	        bitrate: Target audio bitrate (e.g., '128k', '192k'). Optional.
86	        sample_rate: Target audio sample rate in Hz (e.g., 44100, 48000). Optional.
87	        channels: Number of audio channels (1 for mono, 2 for stereo). Optional.
88	    Returns:
89	        A status message indicating success or failure.
90	    """
91	    try:
92	        stream = ffmpeg.input(input_audio_path)
93	        kwargs = {}
94	        if bitrate: 
95	            kwargs['audio_bitrate'] = bitrate
96	        if sample_rate: 
97	            kwargs['ar'] = sample_rate
98	        if channels: 
99	            kwargs['ac'] = channels
100	        kwargs['format'] = target_format
101	
102	        output_stream = stream.output(output_audio_path, **kwargs)
103	        output_stream.run(capture_stdout=True, capture_stderr=True)
104	        return f"Audio converted successfully to {output_audio_path} with format {target_format} and specified properties."
105	    except ffmpeg.Error as e:
106	        error_message = e.stderr.decode('utf8') if e.stderr else str(e)
107	        return f"Error converting audio properties: {error_message}"
108	    except FileNotFoundError:
109	        return f"Error: Input audio file not found at {input_audio_path}"
110	    except Exception as e:
111	        return f"An unexpected error occurred: {str(e)}"
