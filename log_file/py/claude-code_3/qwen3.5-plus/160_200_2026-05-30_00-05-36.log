201	
202	def truncate_response(
203	    result: str,
204	    items_count: int,
205	    truncated_count: int | None = None,
206	) -> str:
207	    """
208	    Truncate response if it exceeds CHARACTER_LIMIT.
209	
210	    Args:
211	        result: The formatted response string
212	        items_count: Total number of items before truncation
213	        truncated_count: Number of items after truncation (if different)
214	
215	    Returns:
216	        Truncated response with guidance message if needed
217	    """
218	    if len(result) <= CHARACTER_LIMIT:
219	        return result
220	
221	    # Find a good truncation point (after a complete item)
222	    truncate_at = CHARACTER_LIMIT - 500  # Leave room for message
223	    truncate_point = result.rfind("\n\n", 0, truncate_at)
224	    if truncate_point == -1:
225	        truncate_point = result.rfind("\n", 0, truncate_at)
226	    if truncate_point == -1:
227	        truncate_point = truncate_at
228	
229	    truncated = result[:truncate_point]
230	
231	    # Add truncation message
232	    message = (
233	        f"\n\n---\n"
234	        f"⚠️ **Response truncated** (exceeded {CHARACTER_LIMIT:,} characters)\n\n"
235	        f"Showing partial results. To see more:\n"
236	        f"- Use filters (project_id, tag, priority) to narrow results\n"
237	        f"- Use the 'limit' parameter to reduce the number of items\n"
238	        f"- Request response_format='json' for more compact output"
239	    )
240	
241	    return truncated + message
