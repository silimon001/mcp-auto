37	def configure_services(
38	    base_dir: Path | None = None,
39	    storage_path: Path | None = None,
40	) -> None:
41	    """Configure global service instances.
42	
43	    This must be called before starting the server to initialize all
44	    services that will handle skill operations.
45	
46	    Args:
47	        base_dir: Base directory for mcp-skillset data (default: ~/.mcp-skillset)
48	        storage_path: Path for storage (ChromaDB, knowledge graph)
