1	import os
2	from typing import Any, List, Dict, Optional
3	from mcp.server.fastmcp import FastMCP, Context
4	from dotenv import load_dotenv
5	from .datameshmanager.datamesh_manager_client import DataMeshManagerClient
6	from .connections.snowflake_client import execute_snowflake_query
7	from .connections.databricks_client import execute_databricks_query
8	from .connections.bigquery_client import execute_bigquery_query
9	from .guardrails import validate_readonly_query, sanitize_prompt_injection
10	
11	load_dotenv()
12	
13	# Initialize FastMCP server
14	mcp = FastMCP(
15	    name="DataProductServer",
16	    instructions="""
17	You are connected to the Data Product MCP server, which provides access to business data.
18	Use this MCP server if you need access to internal business data, such as customers, orders...
19	
20	## Available Tools
21	
22	### 1. dataproduct_search
23	- **Purpose**: Find and explore data products in the organization
24	- **Parameters**: 
25	  - `search_term` (optional): Keywords to search for in data product names/descriptions
26	- **Returns**: List of data products with basic information
27	- **Use**: First use a generic search term like "sales", "customers", "marketing" to find relevant data products. Use more specific terms if the results are too broad.
28	
29	### 2. dataproduct_get
30	- **Purpose**: Get detailed information about a specific data product
31	- **Parameters**: `data_product_id` (required)
32	- **Returns**: Complete data product details including:
33	  - All output ports with server connection information
34	  - Access status for each port (active, pending, rejected, etc.)
35	  - Inlined data contracts with schemas and terms of use
36	- **Use**: Get this info before requesting access or querying data
37	
38	### 3. dataproduct_request_access
39	- **Purpose**: Request access to a specific data product output port
40	- **Parameters**: 
41	  - `data_product_id` (required)
42	  - `output_port_id` (required) 
43	  - `purpose` (required): Business justification for access. Use a high-level description of the kind of usage.
44	- **Returns**: Access request status (may be auto-approved or require manual review)
45	
46	### 4. dataproduct_query
47	- **Purpose**: Execute SQL queries on data product output ports
48	- **Requirements**: Must have active access to the output port
49	- **Parameters**:
50	  - `data_product_id` (required)
51	  - `output_port_id` (required)
52	  - `query` (required): SQL query to execute
53	- **Supports**: Snowflake, Databricks, and BigQuery platforms
54	- **Returns**: Query results as structured data (limited to 100 rows)
55	
56	## Typical Workflow
57	
58	1. **Discover**: Use `dataproduct_search` to find relevant data products
59	2. **Evaluate**: Use `dataproduct_get` to understand structure, access status, and schemas
60	3. **Request Access**: Use `dataproduct_request_access` if you don't have active access
61	4. **Query Data**: Use `dataproduct_query` to execute SQL queries once you have access for typical server types. For other server types, you may need to use server-specific tools.
62	    """
63	)
64	
65	
66	@mcp.tool()
67	async def dataproduct_search(
68	    ctx: Context,
69	    search_term: Optional[str] = None
70	) -> List[Dict[str, Any]]:
71	    """
72	    Search data products based on the search term. Only returns active data products.
73	
74	    Args:
75	        search_term: Search term to filter data products. Multiple search terms are supported, separated by space.
76	                  
77	    Returns:
78	        List of data product summaries with basic information.
79	    """
80	    await ctx.info(f"dataproduct_search called with search_term={search_term}")
81	    
82	    try:
83	        client = DataMeshManagerClient()
84	        results = []
85	        
86	        # First, try the list endpoint (supports archetype and status filters)
87	        try:
88	            await ctx.info("Trying list endpoint first")
89	            data_products = await client.get_data_products(
90	                query=search_term,
91	                status="active"
92	            )
93	            
94	            if data_products:
95	                # Format results from list endpoint
96	                for dp in data_products:
97	                    formatted_product = {
98	                        "id": dp.get("id", "N/A"),
99	                        "name": dp.get("title") or dp.get("info", {}).get("title") or "N/A",
100	                        "description": dp.get("description") or dp.get("info", {}).get("description") or "N/A",
101	                        "owner": dp.get("owner") or dp.get("info", {}).get("owner") or "N/A",
102	                        "source": "simple_search"
103	                    }
104	                    results.append(formatted_product)
105	                
106	                await ctx.info(f"List endpoint returned {len(results)} data products")
107	        
108	        except Exception as e:
109	            await ctx.warning(f"List endpoint failed: {str(e)}")
110	        
111	        # If no results from list endpoint or search_term provided, try semantic search
112	        if not results and search_term:
113	            try:
114	                await ctx.info("Trying semantic search endpoint")
115	                search_term_for_semantic_search = "Find data products related to " + search_term
116	                search_results = await client.search(search_term_for_semantic_search, resource_type="DATA_PRODUCT")
117	                search_data_products = search_results.get("results", [])
118	                
119	                # Add results from search endpoint (avoid duplicates)
120	                existing_ids = {dp["id"] for dp in results}
121	                
122	                for dp in search_data_products:
123	                    dp_id = dp.get("id", "N/A")
124	                    if dp_id not in existing_ids:
125	                        formatted_product = {
126	                            "id": dp_id,
127	                            "name": dp.get("name") or "N/A",
128	                            "description": dp.get("description") or dp.get("info", {}).get("description") or "N/A",
