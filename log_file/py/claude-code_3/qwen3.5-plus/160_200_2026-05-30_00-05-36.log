1103	def remove_silence(media_path: str, output_media_path: str, 
1104	                   silence_threshold_db: float = -30.0, 
1105	                   min_silence_duration_ms: int = 500) -> str:
1106	    """Removes silent segments from an audio or video file.
1107	
1108	    Args:
1109	        media_path: Path to the input audio or video file.
1110	        output_media_path: Path to save the media file with silences removed.
1111	        silence_threshold_db: The noise level (in dBFS) below which is considered silence (e.g., -30.0).
1112	        min_silence_duration_ms: Minimum duration (in milliseconds) of silence to be removed (e.g., 500).
1113	    
1114	    Returns:
1115	        A status message indicating success or failure.
1116	    """
1117	    if not os.path.exists(media_path):
1118	        return f"Error: Input media file not found at {media_path}"
1119	    if min_silence_duration_ms <= 0:
1120	        return "Error: Minimum silence duration must be positive."
1121	
1122	    min_silence_duration_s = min_silence_duration_ms / 1000.0
1123	
1124	    try:
1125	        # Step 1: Detect silence using silencedetect filter
1126	        # The output of silencedetect is written to stderr
1127	        silence_detection_process = (
1128	            ffmpeg
1129	            .input(media_path)
1130	            .filter('silencedetect', n=f'{silence_threshold_db}dB', d=min_silence_duration_s)
1131	            .output('-', format='null') # Output to null as we only need stderr
1132	            .run_async(pipe_stderr=True)
1133	        )
1134	        _, stderr_bytes = silence_detection_process.communicate()
1135	        stderr_str = stderr_bytes.decode('utf8')
1136	
1137	        # Step 2: Parse silencedetect output from stderr
1138	        silence_starts = [float(x) for x in re.findall(r"silence_start: (\d+\.?\d*)", stderr_str)]
1139	        silence_ends = [float(x) for x in re.findall(r"silence_end: (\d+\.?\d*)", stderr_str)]
1140	        # silencedetect might also output silence_duration, but start/end are more direct for segmenting
1141	
1142	        if not silence_starts: # No silences detected, or only one long silence which means the file might be entirely silent or entirely loud
1143	            # If the file is entirely silent, ffmpeg might not produce silence_start/end, or it might be one large segment.
1144	            # A robust way to check if any sound exists might be needed if this is problematic.
1145	            # For now, if no silences are explicitly detected, we can assume no segments need removing.
1146	            # Or, copy the file as is.
1147	            # Let's try to copy the file as is, as no silences were detected for removal.
1148	            try:
1149	                ffmpeg.input(media_path).output(output_media_path, c='copy').run(capture_stdout=True, capture_stderr=True)
1150	                return f"No significant silences detected (or file is entirely silent/loud). Original media copied to {output_media_path}."
1151	            except ffmpeg.Error as e_copy:
1152	                 return f"No significant silences detected, but error copying original file: {e_copy.stderr.decode('utf8') if e_copy.stderr else str(e_copy)}"
1153	
1154	        # Ensure starts and ends are paired correctly. Silencedetect should output them in order.
1155	        # If there's a mismatch, it indicates a parsing error or unexpected ffmpeg output.
1156	        if len(silence_starts) != len(silence_ends):
1157	            # It's possible for a file to end in silence, in which case silence_end might be missing for the last detected silence_start.
1158	            # Or start with silence, where silence_start is 0.
1159	            # A more robust parsing might be needed if ffmpeg output varies significantly.
1160	            # For now, we assume they are paired from the output. If not, it's an issue.
1161	             pass # Continue and see, this might mean it ends with silence and last end is EOF
1162	
1163	        # Get total duration of the media for the last segment
1164	        probe = ffmpeg.probe(media_path)
1165	        duration_str = probe['format']['duration']
1166	        total_duration = float(duration_str)
1167	
1168	        # Step 3: Construct segments to keep (non-silent parts)
1169	        sound_segments = []
1170	        current_pos = 0.0
1171	        for i in range(len(silence_starts)):
1172	            start_silence = silence_starts[i]
1173	            end_silence = silence_ends[i] if i < len(silence_ends) else total_duration
1174	
1175	            if start_silence > current_pos: # There is sound before this silence
1176	                sound_segments.append((current_pos, start_silence))
1177	            current_pos = end_silence # Move current position to the end of this silence
1178	        
1179	        if current_pos < total_duration: # There is sound after the last silence detected
1180	            sound_segments.append((current_pos, total_duration))
1181	        
1182	        if not sound_segments:
1183	            return f"Error: No sound segments were identified to keep. The media might be entirely silent according to the thresholds, or too short."
1184	
1185	        # Step 4: Construct select filter expressions
1186	        video_select_filter_parts = []
1187	        audio_select_filter_parts = []
1188	        for start, end in sound_segments:
1189	            video_select_filter_parts.append(f'between(t,{start},{end})')
1190	            audio_select_filter_parts.append(f'between(t,{start},{end})')
1191	
1192	        video_select_expr = "+".join(video_select_filter_parts)
1193	        audio_select_expr = "+".join(audio_select_filter_parts)
1194	
1195	        # Step 5: Apply filters and output
1196	        input_media = ffmpeg.input(media_path)
1197	        
1198	        has_video = any(s['codec_type'] == 'video' for s in probe['streams'])
1199	        has_audio = any(s['codec_type'] == 'audio' for s in probe['streams'])
1200	
1201	        output_streams = []
1202	        if has_video:
1203	            processed_video = input_media.video.filter('select', video_select_expr).filter('setpts', 'PTS-STARTPTS')
1204	            output_streams.append(processed_video)
1205	        if has_audio:
1206	            processed_audio = input_media.audio.filter('aselect', audio_select_expr).filter('asetpts', 'PTS-STARTPTS')
1207	            output_streams.append(processed_audio)
1208	        
1209	        if not output_streams:
1210	            return "Error: The input media does not seem to have video or audio streams."
1211	
1212	        ffmpeg.output(*output_streams, output_media_path).run(capture_stdout=True, capture_stderr=True)
1213	        return f"Silent segments removed. Output saved to {output_media_path}"
1214	
1215	    except ffmpeg.Error as e:
1216	        error_message = e.stderr.decode('utf8') if e.stderr else str(e)
1217	        return f"Error removing silence: {error_message}"
1218	    except Exception as e:
1219	        return f"An unexpected error occurred while removing silence: {str(e)}"
