404	@mcp.tool(
405	    name="ticktick_create_tasks",
406	    annotations={
407	        "title": "Create Tasks",
408	        "readOnlyHint": False,
409	        "destructiveHint": False,
410	        "idempotentHint": False,
411	        "openWorldHint": True,
412	    },
413	)
414	async def ticktick_create_tasks(params: CreateTasksInput, ctx: Context) -> str:
415	    """
416	    Create one or more tasks in TickTick.
417	
418	    Creates tasks with specified properties. Supports batch creation (1-50 tasks).
419	
420	    IMPORTANT BEHAVIORS:
421	    - If no project_id is specified, tasks are created in the inbox
422	    - RECURRENCE REQUIRES start_date: Recurrence rules without start_date are ignored
423	    - parent_id is supported - the SDK handles parent assignment after creation
424	    - Tags are created automatically if they don't exist
425	
426	    Args:
427	        params: Task creation parameters:
428	            - tasks (list, required): List of task specifications (1-50 tasks)
429	              Each task must contain:
430	                - title (str, required): Task title
431	              Optional fields:
432	                - project_id (str): Project ID (defaults to inbox)
433	                - content (str): Task notes/description
434	                - description (str): Checklist description (for CHECKLIST kind)
435	                - kind (str): Task type - 'TEXT' (standard task, default), 'NOTE' (note),
436	                  or 'CHECKLIST' (checklist with subtask items)
437	                - priority (str): 'none', 'low', 'medium', 'high'
438	                - start_date (str): Start date in ISO format (REQUIRED for recurrence)
439	                - due_date (str): Due date in ISO format
440	                - time_zone (str): IANA timezone (e.g., 'America/New_York')
441	                - all_day (bool): Whether task is all-day (no specific time)
442	                - tags (list[str]): Tag names to apply
443	                - reminders (list[str]): Reminder triggers in iCal format (e.g., 'TRIGGER:-PT30M')
444	                - recurrence (str): RRULE format (e.g., 'RRULE:FREQ=DAILY')
445	                - parent_id (str): Parent task ID to make this a subtask
446	            - response_format (str): 'markdown' (default) or 'json'
447	
448	    Returns:
449	        On success: Summary of created tasks with details
450	        On error: Error message with hints for resolution
451	
452	    Examples:
453	        Simple task:
454	            tasks=[{"title": "Buy groceries"}]
455	
456	        Task with priority and tags:
457	            tasks=[{"title": "Review PR", "priority": "high", "tags": ["work", "urgent"]}]
458	
459	        Note task (different from standard task):
460	            tasks=[{"title": "Meeting notes", "kind": "NOTE", "content": "Discussion points..."}]
461	
462	        Checklist task:
463	            tasks=[{"title": "Packing list", "kind": "CHECKLIST"}]
464	
465	        Recurring task (requires start_date):
466	            tasks=[{"title": "Daily standup", "start_date": "2026-01-20", "recurrence": "RRULE:FREQ=DAILY"}]
467	
468	        Subtask:
469	            tasks=[{"title": "Subtask", "parent_id": "parent_task_id", "project_id": "proj_id"}]
470	    """
471	    try:
472	        client = get_client(ctx)
473	
474	        # Build task specifications
475	        task_specs = []
476	        for task_item in params.tasks:
477	            spec: dict[str, Any] = {"title": task_item.title}
478	
479	            if task_item.project_id:
480	                spec["project_id"] = task_item.project_id
481	            if task_item.content:
482	                spec["content"] = task_item.content
483	            if task_item.description:
484	                spec["description"] = task_item.description
485	            if task_item.priority:
486	                spec["priority"] = task_item.priority
487	            if task_item.start_date:
488	                spec["start_date"] = task_item.start_date
489	            if task_item.due_date:
490	                spec["due_date"] = task_item.due_date
491	            if task_item.time_zone:
492	                spec["time_zone"] = task_item.time_zone
493	            if task_item.all_day is not None:
494	                spec["all_day"] = task_item.all_day
495	            if task_item.tags:
496	                spec["tags"] = task_item.tags
497	            if task_item.reminders:
498	                spec["reminders"] = task_item.reminders
499	            if task_item.recurrence:
500	                spec["recurrence"] = task_item.recurrence
501	            if task_item.parent_id:
502	                spec["parent_id"] = task_item.parent_id
503	            if task_item.kind:
504	                spec["kind"] = task_item.kind
505	
506	            task_specs.append(spec)
507	
508	        created_tasks = await client.create_tasks(task_specs)
509	
510	        if params.response_format == ResponseFormat.MARKDOWN:
511	            if len(created_tasks) == 1:
512	                return f"# Task Created\n\n{format_task_markdown(created_tasks[0])}"
513	            else:
514	                return f"# {len(created_tasks)} Tasks Created\n\n{format_tasks_markdown(created_tasks, 'Created Tasks')}"
515	        else:
516	            return json.dumps({
517	                "success": True,
518	                "count": len(created_tasks),
519	                "tasks": [format_task_json(t) for t in created_tasks]
520	            }, indent=2)
521	
522	    except Exception as e:
523	        return handle_error(e, "create_tasks")
524	
