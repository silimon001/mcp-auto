299	@mcp.tool()
300	async def dataproduct_query(ctx: Context, data_product_id: str, output_port_id: str, purpose: str, query: str) -> Dict[str, Any]:
301	    """
302	    Execute an SQL query on a data product's output port.
303	    This tool connects to the underlying data platform (Snowflake, Databricks) and executes the provided SQL query.
304	    You must have access to the output port to execute queries.
305	
306	    If the data contract specifies terms of use (such as usage, or limitations), you may only execute this tool when the query is in line with these terms.
307	    
308	    Args:
309	        data_product_id: The ID of the data product.
310	        output_port_id: The ID of the output port to query.
311	        purpose: The business purpose for executing this query. Use a high-level description of why you need this data. If there is a data contract, the purpose must be in line with the terms specified in the data contract.
312	        query: The SQL query to execute. Try to use fully qualified table names when appropriate.
313	
314	    Returns:
315	        Dict containing query results with row count and data (limited to 100 rows).
316	    """
317	    await ctx.info(f"dataproduct_query called with data_product_id={data_product_id}, output_port_id={output_port_id}")
318	    
319	    try:
320	        # First, get the data product details to retrieve server information
321	        client = DataMeshManagerClient()
322	        data_product = await client.get_data_product(data_product_id)
323	        
324	        if not data_product:
325	            await ctx.error(f"Data product {data_product_id} not found")
326	            return {"error": "Data product not found"}
327	        
328	        # Find the specified output port
329	        output_ports = data_product.get("outputPorts", [])
330	        target_output_port = None
331	        
332	        for output_port in output_ports:
333	            if output_port.get("id") == output_port_id:
334	                target_output_port = output_port
335	                break
336	        
337	        if not target_output_port:
338	            await ctx.error(f"Output port {output_port_id} not found in data product {data_product_id}")
339	            return {"error": "Output port not found"}
340	        
341	        # Check access status
342	        try:
343	            access_status = await client.get_access_status(data_product_id, output_port_id)
344	            if not access_status or access_status.access_lifecycle_status != "active":
345	                current_status = access_status.access_lifecycle_status if access_status else "unknown"
346	                await ctx.error(f"No active access to output port {output_port_id}, current status: {current_status}")
347	                return {"error": f"You do not have active access to this output port. Current access status: {current_status}. Please request access first using dataproduct_request_access."}
348	        except Exception as e:
349	            await ctx.error(f"Failed to check access status: {str(e)}")
350	            return {"error": "Unable to verify access status. Please ensure you have access to this output port."}
351	
352	        # Apply security guardrails to prevent write operations and dangerous patterns
353	        if not validate_readonly_query(query):
354	            await ctx.error("Query validation failed: Query rejected for security reasons")
355	            return {"error": "Query rejected for security reasons"}
356	        
357	        await ctx.info("Query passed read-only validation")
358	
359	        # Evaluate access with purpose, data governance, and compliance check
360	        query_access_evaluation_enabled = os.getenv("QUERY_ACCESS_EVALUATION_ENABLED", "true").lower() == "true"
361	        
362	        if query_access_evaluation_enabled:
363	            try:
364	                evaluation_response = await client.evaluate_access(data_product_id, output_port_id, query, purpose)
365	                
366	                if not evaluation_response.decision:
367	                    reasons = []
368	                    if evaluation_response.context and evaluation_response.context.reasons:
369	                        for reason in evaluation_response.context.reasons:
370	                            if reason.reason_user:
371	                                user_reason = reason.reason_user.get("en", str(reason.reason_user))
372	                                reasons.append(user_reason)
373	                    
374	                    reason_text = "; ".join(reasons) if reasons else "Access evaluation failed"
375	                    await ctx.error(f"Access evaluation failed: {reason_text}")
376	                    return {"error": f"Query not permitted: {reason_text}"}
377	                
378	                await ctx.info("Access evaluation passed - query is permitted")
379	                
380	            except Exception as e:
381	                await ctx.warning(f"Access evaluation failed due to error: {str(e)}. Proceeding without evaluation.")
382	                # Continue with query execution even if evaluation fails
383	        else:
384	            await ctx.info("Query access evaluation is disabled via QUERY_ACCESS_EVALUATION_ENABLED=false")
385	
386	
387	        # Get server information and type
388	        server_info = target_output_port.get("server", {})
389	        if not server_info:
390	            await ctx.error(f"No server information found for output port {output_port_id}")
391	            return {"error": "No server information available for this output port"}
392	        
393	        # Get server type from output port type field
394	        server_type = target_output_port.get("type", "").lower()
395	        if server_type not in ["snowflake", "databricks", "bigquery"]:
396	            await ctx.error(f"Unsupported server type: {server_type}")
397	            return {"error": f"Unsupported server type '{server_type}'. Supported types: snowflake, databricks, bigquery"}
398	
399	        # Execute the query based on server type
400	        try:
401	            if server_type == "snowflake":
402	                results = await execute_snowflake_query(server_info, query)
403	            elif server_type == "databricks":
404	                results = await execute_databricks_query(server_info, query)
405	            elif server_type == "bigquery":
406	                results = await execute_bigquery_query(server_info, query)
407	            else:
408	                return {"error": f"Server type '{server_type}' is not yet supported by dataproduct-mcp. Supported types: snowflake, databricks, bigquery"}
409	            
410	            # Format results for display
411	            if not results:
412	                return {
413	                    "query": query,
414	                    "row_count": 0,
415	                    "results": [],
416	                    "message": "Query executed successfully, but returned no results."
417	                }
418	            
419	            # Return structured results data
420	            formatted_results = {
421	                "query": query,
422	                "row_count": len(results),
423	                "results": results[:100]  # Limit to first 100 rows to avoid overwhelming output
424	            }
425	            
426	            if len(results) > 100:
427	                formatted_results["note"] = f"Results truncated to first 100 rows. Total rows: {len(results)}"
428	
429	            # Sanitize query results for prompt injections
430	            formatted_results = sanitize_prompt_injection(formatted_results, "query_results")
431	
432	            await ctx.info(f"Query executed successfully, returned {len(results)} rows")
433	            return formatted_results
434	            
435	        except Exception as e:
436	            await ctx.error(f"Failed to execute query: {str(e)}")
437	            return {"error": f"Error executing query: {str(e)}"}
438	        
439	    except ValueError as e:
440	        await ctx.error(f"dataproduct_query ValueError: {str(e)}")
441	        return {"error": str(e)}
442	    except Exception as e:
443	        await ctx.error(f"dataproduct_query Exception: {str(e)}")
444	        return {"error": str(e)}
445	
446	
447	def main():
448	    """Entry point for the executable."""
449	    from importlib.metadata import version
450	    version("dataproduct-mcp")
451	    mcp.run(transport='stdio')
452	
453	
454	if __name__ == "__main__":
455	    main()

