18	@mcp.tool()
19	def extract_audio_from_video(video_path: str, output_audio_path: str, audio_codec: str = 'mp3') -> str:
20	    """Extracts audio from a video file and saves it.
21	    
22	    Args:
23	        video_path: The path to the input video file.
24	        output_audio_path: The path to save the extracted audio file.
25	        audio_codec: The audio codec to use for the output (e.g., 'mp3', 'aac', 'wav'). Defaults to 'mp3'.
26	    Returns:
27	        A status message indicating success or failure.
28	    """
29	    try:
30	        input_stream = ffmpeg.input(video_path)
31	        output_stream = input_stream.output(output_audio_path, acodec=audio_codec)
32	        output_stream.run(capture_stdout=True, capture_stderr=True)
33	        return f"Audio extracted successfully to {output_audio_path}"
34	    except ffmpeg.Error as e:
35	        error_message = e.stderr.decode('utf8') if e.stderr else str(e)
36	        return f"Error extracting audio: {error_message}"
37	    except FileNotFoundError:
38	        return f"Error: Input video file not found at {video_path}"
39	    except Exception as e:
40	        return f"An unexpected error occurred: {str(e)}"
