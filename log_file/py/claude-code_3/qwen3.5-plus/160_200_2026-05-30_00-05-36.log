252	@mcp.tool()
253	async def dataproduct_request_access(ctx: Context, data_product_id: str, output_port_id: str, purpose: str) -> Dict[str, Any]:
254	    """
255	    Request access to a specific output port of a data product.
256	    This creates an access request. Based on the data product configuration, purpose, and data governance rules,
257	    the access will be automatically granted, or it will be reviewed by the data product owner.
258	    
259	    Args:
260	        data_product_id: The ID of the data product.
261	        output_port_id: The ID of the output port to request access to.
262	        purpose: The business purpose/reason for requesting access to this data. Use a high-level description of why you need this data.
263	        
264	    Returns:
265	        Dict containing access request details including access_id, status, and approval information.
266	    """
267	    await ctx.info(f"dataproduct_request_access called with data_product_id={data_product_id}, output_port_id={output_port_id}, purpose={purpose}")
268	    
269	    try:
270	        client = DataMeshManagerClient()
271	        result = await client.post_request_access(data_product_id, output_port_id, purpose)
272	        
273	        # Check if access was automatically granted based on status
274	        status_lower = result.status.lower()
275	        auto_approved = status_lower in ["active"]
276	        
277	        # Return structured response data
278	        response = {
279	            "access_id": result.access_id,
280	            "status": result.status,
281	            "data_product_id": data_product_id,
282	            "output_port_id": output_port_id,
283	            "purpose": purpose,
284	            "auto_approved": auto_approved,
285	            "message": "Access granted automatically! You now have access to this data product output port using the server details and can start using the data immediately." if auto_approved else f"Access request submitted successfully and is now {result.status}. You will be notified when the data product owner reviews your request. You can check the status in dataproduct details in the output port."
286	        }
287	        
288	        await ctx.info(f"dataproduct_request_access successfully submitted for data_product_id={data_product_id}, access_id={result.access_id}, status={result.status}")
289	        return response
290	        
291	    except ValueError as e:
292	        await ctx.error(f"dataproduct_request_access ValueError: {str(e)}")
293	        return {"error": str(e)}
294	    except Exception as e:
295	        await ctx.error(f"dataproduct_request_access Exception: {str(e)}")
296	        return {"error": f"Error requesting access: {str(e)}"}
297	
