693	                                output_buffer.append("  " + "-" * 38)
694	                                
695	                                # Get table with indentation
696	                                instance_table = tabulate(instance_response.round(2), headers='keys', tablefmt='pretty', showindex=False)
697	                                for line in instance_table.split('\n'):
698	                                    output_buffer.append(f"  {line}")
699	                        
700	                        except Exception as e:
