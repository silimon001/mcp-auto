1810	async def ticktick_update_tag(params: TagUpdateInput, ctx: Context) -> str:
1811	    """
1812	    Update a tag's properties.
1813	
1814	    Updates tag color, parent, or label (rename). If label is provided,
1815	    the tag is renamed first, then other updates are applied.
1816	
1817	    Args:
1818	        params: Update parameters:
1819	            - name (str): Current tag name to update (required)
1820	            - color (str): New hex color code (e.g., '#F18181')
1821	            - parent (str): New parent tag name (empty string to remove parent)
1822	            - label (str): New display name/label for the tag (rename)
