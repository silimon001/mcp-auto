32	        self.rag_manager = rag_manager
33	        self.kb_manager = kb_manager # Store kb_manager if needed for other tools
34	        self.mcp_server = FastMCP(
35	            name="Knowledge Base MCP",
36	            instructions=dedent("""
37	            Tools to query multiple custom knowledge bases using similarity search and a ranked knowledge-graph.
38	            
39	            Search modes explained:
40	            - local: Entity-specific queries - focuses on finding specific concepts, tools, or entities
41	            - global: Relationship discovery - focuses on understanding connections between different aspects  
42	            - hybrid: Cross-domain queries - combines both entity-focused and relationship-focused retrieval
43	            - mix: Integrates knowledge graph and vector retrieval
44	            - naive: Performs a basic search without advanced techniques
45	            """),
46	        )
47	        # Register tools using decorators
48	        self.mcp_server.tool(name="retrieve", description="Returns the retrieval results only. Good when the client AI needs evidence for its own chain-of-thought or wish to cross-check multiple modes/top-k values cheaply. Retrieves raw context passages from a knowledge base without synthesizing an LLM answer. Client AI must generate the answer and that increases token volume for the client AI. Faster response, good for multiple queries.")(self.retrieve)
49	        self.mcp_server.tool(name="answer", description="Returns an LLM-synthesised answer from the retrieval results. Good when you want a concise answer in one call. Uses the LLM of the mcp server to generate an answer from a knowledge base and return it with citations. Server AI must generate the answer and that increases token volume for this LLM.")(self.answer)
50	        self.mcp_server.tool(name="list_knowledgebases", description="List all available knowledge bases.")(self.list_knowledgebases)
51	        self.mcp_server.tool(name="query_local", description="Simplified local mode query - Best for entity-specific queries. Focuses on finding specific concepts, tools, or entities within your domains.")(self.query_local)
52	        self.mcp_server.tool(name="query_global", description="Simplified global mode query - Best for relationship discovery. Focuses on understanding relationships and connections between different aspects of your domains.")(self.query_global)
53	        self.mcp_server.tool(name="query_hybrid", description="Simplified hybrid mode query - Best for cross-domain queries. Combines both entity-focused and relationship-focused retrieval, ideal for comprehensive coverage spanning multiple knowledge areas.")(self.query_hybrid)
54	        self.mcp_server.run(transport="stdio")
