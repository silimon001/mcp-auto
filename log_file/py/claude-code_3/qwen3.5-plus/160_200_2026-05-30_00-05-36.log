403	        return self.graph_store.get_related_skills(
404	            skill_id=skill_id,
405	            skill_manager=self.skill_manager,
406	            max_depth=max_depth,
407	        )
408	
409	    def get_stats(self) -> IndexStats:
410	        """Get current index statistics.
411	
412	        Returns:
413	            IndexStats object with current metrics
414	
415	        Statistics Include:
416	        - total_skills: Number of skills in ChromaDB
417	        - vector_store_size: Estimated size in bytes
418	        - graph_nodes: Number of nodes in NetworkX graph
419	        - graph_edges: Number of edges in graph
420	        - last_indexed: ISO timestamp of last indexing
421	
422	        Example:
423	            >>> stats = engine.get_stats()
424	            >>> stats.total_skills
425	            42
426	            >>> stats.graph_nodes
427	            42
428	            >>> stats.graph_edges
429	            156
430	        """
431	        try:
432	            # Get vector store stats
433	            total_skills = self.vector_store.count()
434	
435	            # Estimate vector store size
436	            # Rough estimate: 384 dims * 4 bytes/float + metadata ~= 2KB per skill
437	            vector_store_size = total_skills * 2048
438	
439	            # Get graph stats
440	            graph_stats = self.graph_store.get_stats()
441	            graph_nodes = graph_stats["nodes"]
442	            graph_edges = graph_stats["edges"]
443	
444	            # Last indexed timestamp
445	            last_indexed = (
446	                self._last_indexed.isoformat() if self._last_indexed else "never"
