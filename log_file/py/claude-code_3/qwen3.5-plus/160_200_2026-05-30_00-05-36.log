604	    
605	    # Initialize output buffer
606	    output_buffer = []
607	    
608	    try:
609	        output_buffer.append(f"\nDetailed Cost Breakdown by Region, Service, and Instance Type ({days} days):")
610	        output_buffer.append("-" * 75)
611	        
612	        # First get the daily costs by region and service
613	        response = ce_client.get_cost_and_usage(
614	            TimePeriod={
615	                'Start': start_date,
