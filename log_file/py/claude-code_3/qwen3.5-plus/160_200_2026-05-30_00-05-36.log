2270	
2271	def format_habits_markdown(habits: list[Habit], title: str = "Habits") -> str:
2272	    """Format multiple habits for markdown display."""
2273	    if not habits:
2274	        return f"# {title}\n\nNo habits found."
2275	
2276	    lines = [f"# {title}", f"*{len(habits)} habits*", ""]
2277	
2278	    for habit in habits:
2279	        status = "📦" if habit.is_archived else "✅" if habit.current_streak > 0 else "⏳"
2280	        lines.append(f"### {status} {habit.name}")
2281	        lines.append(f"- **ID**: `{habit.id}`")
2282	        lines.append(f"- **Type**: {habit.habit_type}")
2283	        lines.append(f"- **Streak**: {habit.current_streak} | Total: {habit.total_checkins}")
2284	        if habit.target_days > 0:
2285	            lines.append(f"- **Target**: {habit.target_days} days")
2286	        lines.append("")
2287	
2288	    return "\n".join(lines)
2289	
2290	
2291	def format_habits_json(habits: list[Habit]) -> list[dict[str, Any]]:
2292	    """Format multiple habits for JSON output."""
2293	    return [format_habit_json(h) for h in habits]
