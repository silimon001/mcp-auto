1223	def _parse_time_to_seconds(time_str: str) -> float:
1224	    """Converts HH:MM:SS.mmm or seconds string to float seconds."""
1225	    if isinstance(time_str, (int, float)):
1226	        return float(time_str)
1227	    if ':' in time_str:
1228	        parts = time_str.split(':')
1229	        if len(parts) == 3:
1230	            return int(parts[0]) * 3600 + int(parts[1]) * 60 + float(parts[2])
1231	        elif len(parts) == 2:
1232	            return int(parts[0]) * 60 + float(parts[1])
1233	        else:
1234	            raise ValueError(f"Invalid time format: {time_str}")
1235	    return float(time_str)
