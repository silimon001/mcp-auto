loop 20 | Tool=Edit, Args={"replace_all":false,"file_path":"/home/silimon/MCP-Auto/mcp_server/885122598_ferdousbhai_tasty-agent/tasty_agent/core.py","old_string":"@dataclass\nclass ServerContext:\n    session: Session\n    account: Account\n\n\ndef get_context(ctx: Context) -> ServerContext:\n    \"\"\"Extract ServerContext from the MCP request context.\"\"\"\n    return ctx.request_context.lifespan_context\n\n\ndef get_session(ctx: Context) -> Session:\n    \"\"\"Get the tastytrade session (auto-refreshes tokens before each API call).\"\"\"\n    return get_context(ctx).session\n\n\n@asynccontextmanager\nasync def lifespan(_) -> AsyncIterator[ServerContext]:\n    \"\"\"Manage Tastytrade session lifecycle.\"\"\"\n    client_secret = os.getenv(\"TASTYTRADE_CLIENT_SECRET\")\n    refresh_token = os.getenv(\"TASTYTRADE_REFRESH_TOKEN\")\n    account_id = os.getenv(\"TASTYTRADE_ACCOUNT_ID\")\n\n    if not client_secret or not refresh_token:\n        raise ValueError(\n            \"Missing Tastytrade OAuth credentials. Set TASTYTRADE_CLIENT_SECRET and \"\n            \"TASTYTRADE_REFRESH_TOKEN environment variables.\"\n        )\n\n    try:\n        session = Session(client_secret, refresh_token)\n        accounts = await Account.get(session)\n        logger.info(\"Successfully authenticated with Tastytrade. Found %s account(s).\", len(accounts))\n    except Exception as e:\n        logger.error(\"Failed to authenticate with Tastytrade: %s\", e)\n        raise\n\n    if account_id:\n        account = next((acc for acc in accounts if acc.account_number == account_id), None)\n        if not account:\n            available = [acc.account_number for acc in accounts]\n            raise ValueError(f\"Account '{account_id}' not found. Available: {available}\")\n        logger.info(\"Using specified account: %s\", account.account_number)\n    else:\n        account = accounts[0]\n        logger.info(\"Using default account: %s\", account.account_number)\n\n    yield ServerContext(session=session, account=account)","new_string":"@dataclass\nclass ServerContext:\n    session: Session | None\n    account: Account | None\n\n\ndef get_context(ctx: Context) -> ServerContext:\n    \"\"\"Extract ServerContext from the MCP request context, ensuring authentication.\"\"\"\n    context = ctx.request_context.lifespan_context\n    if context.session is None or context.account is None:\n        raise ValueError(\n            \"Not authenticated with Tastytrade. Please check your credentials and restart the server.\"\n        )\n    return context\n\n\ndef get_session(ctx: Context) -> Session:\n    \"\"\"Get the tastytrade session (auto-refreshes tokens before each API call).\"\"\"\n    return get_context(ctx).session\n\n\n@asynccontextmanager\nasync def lifespan(_) -> AsyncIterator[ServerContext]:\n    \"\"\"Manage Tastytrade session lifecycle with lazy authentication.\"\"\"\n    client_secret = os.getenv(\"TASTYTRADE_CLIENT_SECRET\")\n    refresh_token = os.getenv(\"TASTYTRADE_REFRESH_TOKEN\")\n    account_id = os.getenv(\"TASTYTRADE_ACCOUNT_ID\")\n\n    if not client_secret or not refresh_token:\n        logger.warning(\n            \"Missing Tastytrade OAuth credentials. Tools will fail until credentials are provided.\"\n        )\n        yield ServerContext(session=None, account=None)\n        return\n\n    try:\n        session = Session(client_secret, refresh_token)\n        accounts = await Account.get(session)\n        logger.info(\"Successfully authenticated with Tastytrade. Found %s account(s).\", len(accounts))\n    except Exception as e:\n        logger.error(\"Failed to authenticate with Tastytrade: %s\", e)\n        yield ServerContext(session=None, account=None)\n        return\n\n    if account_id:\n        account = next((acc for acc in accounts if acc.account_number == account_id), None)\n        if not account:\n            available = [acc.account_number for acc in accounts]\n            logger.warning(\"Account '%s' not found. Available: %s\", account_id, available)\n            yield ServerContext(session=None, account=None)\n            return\n        logger.info(\"Using specified account: %s\", account.account_number)\n    else:\n        account = accounts[0]\n        logger.info(\"Using default account: %s\", account.account_number)\n\n    yield ServerContext(session=session, account=account)"}

