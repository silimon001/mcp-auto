78	        self.positions_norm: Dict[str, float] = {name: 0.0 for name in self.joint_names}
79	        self.cartesian_mm: Dict[str, float] = {"x": 0.0, "z": 0.0}
80	        
81	        if read_only:
82	            # In read-only mode, connect and disable torque for manual movement
83	            logger.info("Initializing in READ-ONLY mode")
84	            self._connect_robot_readonly()
