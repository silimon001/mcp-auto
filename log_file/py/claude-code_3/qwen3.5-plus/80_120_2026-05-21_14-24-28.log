29	@mcp.tool
30	def list_workouts() -> dict:
31	    """
32	    List all workouts available on Garmin Connect.
33	
34	    Returns:
35	        A dictionary containing a list of workouts.
36	    """
37	    workouts = garth.connectapi(LIST_WORKOUTS_ENDPOINT)
38	    return {"workouts": workouts}
39	
40	@mcp.tool
41	def get_workout(workout_id: str) -> dict:
42	    """
43	    Get details of a specific workout by its ID.
44	
45	    Args:
46	        workout_id: ID of the workout to retrieve.
47	
48	    Returns:
49	        Workout details as a dictionary.
50	    """
51	    endpoint = GET_WORKOUT_ENDPOINT.format(workout_id=workout_id)
52	    workout = garth.connectapi(endpoint)
53	    return {"workout": workout}
54	
55	@mcp.tool
56	def get_activity(activity_id: str) -> dict:
57	    """
58	    Get details of a specific activity by its ID. An activity represents a completed run, ride, swim, etc.
59	
60	    Args:
61	        activity_id: ID of the activity to retrieve. As returned by the `get_calendar` tool.
62	
63	    Returns:
64	        Activity details as a dictionary.
65	    """
66	    endpoint = GET_ACTIVITY_ENDPOINT.format(activity_id=activity_id)
67	    activity = garth.connectapi(endpoint)
68	    return activity
69	
70	@mcp.tool
71	def list_activities(limit: int = 20, start: int = 0, activityType: str = None, search: str = None) -> dict:
72	    """
73	    List activities (completed runs, rides, swims, etc.) from Garmin Connect.
74	
75	    Args:
76	        limit: Number of activities to return (default=20)
77	        start: Starting position for pagination (default=0)
78	        activityType: Filter by activity type. Accepted values include:
79	            - "auto_racing", "backcountry_skiing_snowboarding_ws", "bouldering", "breathwork"
80	            - "cross_country_skiing_ws", "cycling", "diving", "e_sport", "fitness_equipment"
81	            - "hiking", "indoor_climbing", "motorcycling", "multi_sport", "offshore_grinding"
82	            - "onshore_grinding", "other", "resort_skiing_snowboarding_ws", "running"
83	            - "safety", "skate_skiing_ws", "surfing", "swimming", "walking"
84	            - "windsurfing", "winter_sports", "yoga"
85	        search: Search for activities containing this string in their name
86	
87	    Returns:
88	        A dictionary containing a list of activities and pagination info.
89	    """
90	    params = {
91	        "limit": limit,
92	        "start": start
93	    }
94	
95	    if activityType is not None:
96	        params["activityType"] = activityType
97	
98	    if search is not None:
99	        params["search"] = search
100	
101	    activities = garth.connectapi(LIST_ACTIVITIES_ENDPOINT, "GET", params=params)
102	    return {"activities": activities}
103	
104	@mcp.tool
105	def get_activity_weather(activity_id: str) -> dict:
106	    """
107	    Get weather information for a specific activity.
108	
109	    Args:
110	        activity_id: ID of the activity to retrieve weather for.
111	
112	    Returns:
113	        Weather details as a dictionary containing temperature, conditions, etc.
114	    """
115	    endpoint = GET_ACTIVITY_WEATHER_ENDPOINT.format(activity_id=activity_id)
116	    weather = garth.connectapi(endpoint)
117	    return weather
