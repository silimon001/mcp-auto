11	"""
12	
13	import logging
14	import sys
15	from datetime import datetime
16	from logging import FileHandler, Formatter, StreamHandler
17	from pathlib import Path
18	from mcp_server_unitycatalog.cli import Cli
19	
20	
21	# Defines logging format.
22	FORMAT = "%(asctime)s,%(msecs)d - %(name)s - %(levelname)s - %(message)s"
23	# Defines logging date format.
24	DATE_FORMAT = "%Y-%m-%d %H:%M:%S"
25	
26	
27	def configure(cli: Cli) -> None:
28	    """Initializes the logging configuration by setting up both file and stream handlers.
29	
30	    This function configures the logging system with a file handler that writes logs
31	    to a specified directory and a stream handler that outputs logs to the standard error stream.
32	    It uses the verbosity level specified in the settings to set the logging level and ensures
33	    the log directory exists before creating the log file. The file handler logs messages to a daily
34	    log file named with the current date, while the stream handler outputs log messages to stderr.
35	
36	    Args:
37	        cli (Cli): A settings object containing configuration for
38	        the Unity Catalog MCP server.
39	
40	    Returns:
41	        None
42	    """
43	    # Initializes logging directory.
44	    log_directory = cli.uc_log_directory
45	    log_directory.mkdir(parents=True, exist_ok=True)
46	    level = {
47	        "debug": logging.DEBUG,
48	        "info": logging.INFO,
49	        "warn": logging.WARN,
50	        "error": logging.ERROR,
51	        "critical": logging.CRITICAL,
52	    }.get(cli.uc_verbosity, logging.INFO)
53	    # Configures file logger.
54	    file_handler = FileHandler(
55	        filename=f"{log_directory}/{datetime.now().strftime('%Y-%m-%d')}.log",
56	        encoding="utf-8",
57	        mode="a",
58	    )
59	    file_handler.setFormatter(Formatter(FORMAT, datefmt=DATE_FORMAT))
60	    file_handler.setLevel(level)
61	    # Configures stream logger.
62	    stream_handler = StreamHandler(sys.stderr)
63	    stream_handler.setFormatter(Formatter(FORMAT, datefmt=DATE_FORMAT))
64	    stream_handler.setLevel(level)
65	    # Set up logging with both file and stream handlers.
66	    logging.basicConfig(handlers=(stream_handler, file_handler), level=level)
