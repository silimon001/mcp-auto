1	"""MCP server implementation for Snowflake.
2	
3	This module provides a Model Context Protocol (MCP) server that allows Claude
4	to perform read-only operations against Snowflake databases. It connects to
5	Snowflake using either service account authentication with a private key or
6	external browser authentication. It exposes various tools for querying database
7	metadata and data, including support for multi-view and multi-database queries.
8	
9	The server is designed to be used with Claude Desktop as an MCP server, providing
10	Claude with secure, controlled access to Snowflake data for analysis and reporting.
11	"""
12	
13	import os
14	from typing import Any, Dict, List, Optional, Sequence, Union
15	
16	import anyio
17	import mcp.types as mcp_types
18	import sqlglot
19	from dotenv import load_dotenv
20	from mcp.server import Server
21	from mcp.server.stdio import stdio_server
22	from sqlglot.errors import ParseError
23	
24	from snowflake_mcp_server.utils.snowflake_conn import (
25	    AuthType,
26	    SnowflakeConfig,
27	    connection_manager,
28	)
29	
30	# Load environment variables from .env file
31	load_dotenv()
32	
33	
34	# Initialize Snowflake configuration from environment variables
35	def get_snowflake_config() -> SnowflakeConfig:
36	    """Load Snowflake configuration from environment variables."""
37	    auth_type_str = os.getenv("SNOWFLAKE_AUTH_TYPE", "private_key").lower()
38	    auth_type = (
39	        AuthType.PRIVATE_KEY
40	        if auth_type_str == "private_key"
41	        else AuthType.EXTERNAL_BROWSER
42	    )
43	
44	    config = SnowflakeConfig(
45	        account=os.getenv("SNOWFLAKE_ACCOUNT", ""),
46	        user=os.getenv("SNOWFLAKE_USER", ""),
47	        auth_type=auth_type,
48	        warehouse=os.getenv("SNOWFLAKE_WAREHOUSE"),
49	        database=os.getenv("SNOWFLAKE_DATABASE"),
50	        schema_name=os.getenv("SNOWFLAKE_SCHEMA"),
51	        role=os.getenv("SNOWFLAKE_ROLE"),
52	    )
53	
54	    # Only set private_key_path if using private key authentication
55	    if auth_type == AuthType.PRIVATE_KEY:
56	        config.private_key_path = os.getenv("SNOWFLAKE_PRIVATE_KEY_PATH", "")
57	
58	    return config
59	
60	
61	# Initialize the connection manager at startup
62	def init_connection_manager() -> None:
63	    """Initialize the connection manager with Snowflake config."""
64	    config = get_snowflake_config()
65	    connection_manager.initialize(config)
66	
67	
68	# Define MCP server
69	def create_server() -> Server:
70	    """Create and configure the MCP server."""
71	    # Initialize the connection manager before setting up the server
72	    init_connection_manager()
73	
74	    server: Server = Server(
75	        name="snowflake-mcp-server",
76	        version="0.2.0",
77	        instructions="MCP server for performing read-only operations against "
78	        "Snowflake.",
79	    )
80	
81	    return server
82	
83	
84	# Snowflake query handler functions
85	async def handle_list_databases(
86	    name: str, arguments: Optional[Dict[str, Any]] = None
87	) -> Sequence[
88	    Union[mcp_types.TextContent, mcp_types.ImageContent, mcp_types.EmbeddedResource]
89	]:
90	    """Tool handler to list all accessible Snowflake databases."""
91	    try:
92	        # Get Snowflake connection from connection manager
93	        conn = connection_manager.get_connection()
94	
95	        # Execute query
96	        cursor = conn.cursor()
97	        cursor.execute("SHOW DATABASES")
98	
99	        # Process results
100	        databases = []
101	        for row in cursor:
102	            databases.append(row[1])  # Database name is in the second column
103	
104	        cursor.close()
105	        # Don't close the connection, just the cursor
106	
107	        # Return formatted content
108	        return [
109	            mcp_types.TextContent(
110	                type="text",
111	                text="Available Snowflake databases:\n" + "\n".join(databases),
112	            )
113	        ]
114	
115	    except Exception as e:
116	        return [
117	            mcp_types.TextContent(
118	                type="text", text=f"Error querying databases: {str(e)}"
119	            )
120	        ]
121	
122	
123	async def handle_list_views(
124	    name: str, arguments: Optional[Dict[str, Any]] = None
125	) -> Sequence[
126	    Union[mcp_types.TextContent, mcp_types.ImageContent, mcp_types.EmbeddedResource]
127	]:
128	    """Tool handler to list views in a specified database and schema."""
129	    try:
130	        # Get Snowflake connection from connection manager
131	        conn = connection_manager.get_connection()
132	
133	        # Extract arguments
134	        database = arguments.get("database") if arguments else None
135	        schema = arguments.get("schema") if arguments else None
136	
137	        if not database:
138	            return [
139	                mcp_types.TextContent(
140	                    type="text", text="Error: database parameter is required"
141	                )
142	            ]
143	
144	        # Use the provided database and schema, or use default schema
145	        if database:
146	            conn.cursor().execute(f"USE DATABASE {database}")
147	        if schema:
148	            conn.cursor().execute(f"USE SCHEMA {schema}")
149	        else:
150	            # Get the current schema
151	            cursor = conn.cursor()
152	            cursor.execute("SELECT CURRENT_SCHEMA()")
153	            schema_result = cursor.fetchone()
154	            if schema_result:
155	                schema = schema_result[0]
156	            else:
157	                return [
158	                    mcp_types.TextContent(
159	                        type="text", text="Error: Could not determine current schema"
160	                    )
161	                ]
162	
163	        # Execute query to list views
164	        cursor = conn.cursor()
165	        cursor.execute(f"SHOW VIEWS IN {database}.{schema}")
166	
167	        # Process results
168	        views = []
169	        for row in cursor:
170	            view_name = row[1]  # View name is in the second column
171	            created_on = row[5]  # Creation date
172	            views.append(f"{view_name} (created: {created_on})")
173	
174	        cursor.close()
175	        # Don't close the connection, just the cursor
176	
177	        if views:
178	            return [
179	                mcp_types.TextContent(
180	                    type="text",
181	                    text=f"Views in {database}.{schema}:\n" + "\n".join(views),
182	                )
183	            ]
184	        else:
185	            return [
186	                mcp_types.TextContent(
187	                    type="text", text=f"No views found in {database}.{schema}"
188	                )
189	            ]
190	
191	    except Exception as e:
192	        return [
193	            mcp_types.TextContent(type="text", text=f"Error listing views: {str(e)}")
194	        ]
195	
196	
197	async def handle_describe_view(
198	    name: str, arguments: Optional[Dict[str, Any]] = None
199	) -> Sequence[
200	    Union[mcp_types.TextContent, mcp_types.ImageContent, mcp_types.EmbeddedResource]
201	]:
202	    """Tool handler to describe the structure of a view."""
203	    try:
204	        # Get Snowflake connection from connection manager
205	        conn = connection_manager.get_connection()
206	
207	        # Extract arguments
208	        database = arguments.get("database") if arguments else None
209	        schema = arguments.get("schema") if arguments else None
210	        view_name = arguments.get("view_name") if arguments else None
211	
212	        if not database or not view_name:
213	            return [
214	                mcp_types.TextContent(
215	                    type="text",
216	                    text="Error: database and view_name parameters are required",
217	                )
218	            ]
219	
220	        # Use the provided schema or use default schema
221	        if schema:
222	            full_view_name = f"{database}.{schema}.{view_name}"
223	        else:
224	            # Get the current schema
225	            cursor = conn.cursor()
226	            cursor.execute("SELECT CURRENT_SCHEMA()")
227	            schema_result = cursor.fetchone()
228	            if schema_result:
229	                schema = schema_result[0]
230	                full_view_name = f"{database}.{schema}.{view_name}"
231	            else:
232	                return [
233	                    mcp_types.TextContent(
234	                        type="text", text="Error: Could not determine current schema"
235	                    )
236	                ]
237	
238	        # Execute query to describe view
239	        cursor = conn.cursor()
240	        cursor.execute(f"DESCRIBE VIEW {full_view_name}")
241	
242	        # Process results
243	        columns = []
244	        for row in cursor:
245	            col_name = row[0]
246	            col_type = row[1]
247	            col_null = "NULL" if row[3] == "Y" else "NOT NULL"
248	            columns.append(f"{col_name} : {col_type} {col_null}")
249	
250	        # Get view definition
251	        cursor.execute(f"SELECT GET_DDL('VIEW', '{full_view_name}')")
252	        view_ddl_result = cursor.fetchone()
253	        view_ddl = view_ddl_result[0] if view_ddl_result else "Definition not available"
254	
255	        cursor.close()
256	        # Don't close the connection, just the cursor
257	
258	        if columns:
259	            result = f"## View: {full_view_name}\n\n"
260	            result += "### Columns:\n"
261	            for col in columns:
262	                result += f"- {col}\n"
263	
264	            result += "\n### View Definition:\n```sql\n"
265	            result += view_ddl
266	            result += "\n```"
267	
268	            return [mcp_types.TextContent(type="text", text=result)]
269	        else:
270	            return [
271	                mcp_types.TextContent(
272	                    type="text",
273	                    text=f"View {full_view_name} not found or you don't have permission to access it.",
274	                )
275	            ]
276	
277	    except Exception as e:
278	        return [
279	            mcp_types.TextContent(type="text", text=f"Error describing view: {str(e)}")
280	        ]
281	
282	
283	async def handle_query_view(
284	    name: str, arguments: Optional[Dict[str, Any]] = None
285	) -> Sequence[
286	    Union[mcp_types.TextContent, mcp_types.ImageContent, mcp_types.EmbeddedResource]
287	]:
288	    """Tool handler to query data from a view with optional limit."""
289	    try:
290	        # Get Snowflake connection from connection manager
291	        conn = connection_manager.get_connection()
292	
293	        # Extract arguments
294	        database = arguments.get("database") if arguments else None
295	        schema = arguments.get("schema") if arguments else None
296	        view_name = arguments.get("view_name") if arguments else None
297	        limit = (
298	            int(arguments.get("limit", 10))
299	            if arguments and arguments.get("limit") is not None
300	            else 10
301	        )  # Default limit to 10 rows
302	
303	        if not database or not view_name:
