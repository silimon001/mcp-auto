8	def enable_praw_debug_logging(level: int = logging.DEBUG):
9	    """
10	    Enable verbose PRAW logging for debugging Reddit API interactions.
11	
12	    Args:
13	        level: Logging level (default: logging.DEBUG)
14	
15	    Usage:
16	        from config import enable_praw_debug_logging
17	        enable_praw_debug_logging()  # Enable debug logging
18	        enable_praw_debug_logging(logging.INFO)  # Less verbose
19	    """
20	    for logger_name in ['prawcore', 'praw']:
21	        logger = logging.getLogger(logger_name)
22	        logger.setLevel(level)
23	        if not logger.handlers:
24	            handler = logging.StreamHandler()
25	            handler.setFormatter(logging.Formatter(
26	                '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
27	            ))
28	            logger.addHandler(handler)
