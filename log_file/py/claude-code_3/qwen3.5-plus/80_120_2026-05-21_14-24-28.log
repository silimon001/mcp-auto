168	def parse_architecture_description(description: str) -> Dict[str, List[str]]:
169	    """解析架构描述，提取组件信息"""
170	    components = {
171	        'frontend': [],
172	        'gateway': [],
173	        'services': [],
174	        'cache': [],
175	        'queue': [],
176	        'database': [],
177	        'storage': [],
178	        'monitoring': [],
179	        'external': []
180	    }
181	    
182	    # 前端组件关键词
183	    frontend_keywords = ['ios app', 'android app', 'web应用', 'mobile', '移动应用', 'app', 'react', 'vue', 'angular', '前端', 'ui', '用户界面', '小程序', 'h5', '单页应用']
184	    # 网关组件关键词
185	    gateway_keywords = ['api网关', 'gateway', '负载均衡', 'load balancer', 'cdn', 'nginx', 'haproxy', '反向代理', 'kong', 'zuul']
186	    # 服务组件关键词
187	    service_keywords = ['用户服务', '商品服务', '订单服务', '购物车服务', '支付服务', '推荐服务', '营销服务', '物流服务', '客服服务', '服务', 'service', '微服务', 'microservice', 'api']
188	    # 缓存组件关键词
189	    cache_keywords = ['redis', 'memcached', '缓存', 'cache', 'redis集群']
190	    # 队列组件关键词
191	    queue_keywords = ['kafka', 'rabbitmq', 'rocketmq', 'mq', '消息队列', 'queue', '队列', 'apache kafka']
192	    # 数据库关键词
193	    database_keywords = ['mysql', 'postgresql', 'mongodb', 'cassandra', 'elasticsearch', 'hbase', 'influxdb', '数据库', 'database', 'db', '主从集群', '数据仓库', 'hadoop', 'spark']
194	    # 存储关键词
195	    storage_keywords = ['存储', 'storage', 'hdfs', 'oss', 's3']
196	    # 监控关键词
197	    monitoring_keywords = ['监控', 'monitoring', '日志', 'log', 'metrics', '告警', 'prometheus', 'grafana', 'elk', 'zipkin', 'jaeger', 'jenkins', 'gitlab', 'docker', 'kubernetes']
198	    
199	    lines = description.split('\n')
200	    for line in lines:
201	        line_lower = line.lower()
202	        
203	        # 提取前端组件
204	        for keyword in frontend_keywords:
205	            if keyword in line_lower and line.strip():
206	                components['frontend'].append(line.strip())
207	                break
208	        
209	        # 提取网关组件
210	        for keyword in gateway_keywords:
211	            if keyword in line_lower and line.strip():
212	                components['gateway'].append(line.strip())
213	                break
214	        
215	        # 提取服务组件
216	        for keyword in service_keywords:
217	            if keyword in line_lower and '服务' in line and line.strip():
218	                components['services'].append(line.strip())
219	                break
220	        
221	        # 提取缓存组件
222	        for keyword in cache_keywords:
223	            if keyword in line_lower and line.strip():
224	                components['cache'].append(line.strip())
225	                break
226	        
227	        # 提取队列组件
228	        for keyword in queue_keywords:
229	            if keyword in line_lower and line.strip():
230	                components['queue'].append(line.strip())
231	                break
232	        
233	        # 提取数据库组件
234	        for keyword in database_keywords:
235	            if keyword in line_lower and line.strip():
236	                components['database'].append(line.strip())
237	                break
238	        
239	        # 提取存储组件
240	        for keyword in storage_keywords:
241	            if keyword in line_lower and line.strip():
242	                components['storage'].append(line.strip())
243	                break
244	        
245	        # 提取监控组件
246	        for keyword in monitoring_keywords:
247	            if keyword in line_lower and line.strip():
248	                components['monitoring'].append(line.strip())
249	                break
250	    
251	    return components
