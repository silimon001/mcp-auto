228	# RFC 9728 Protected Resource Metadata — user-registered shadow of the
229	# framework-provided PRM route. fastmcp.app's AWS edge currently returns 405
230	# for the framework-registered /.well-known/oauth-protected-resource/mcp
231	# without forwarding to origin; this custom route reaches origin through the
232	# same edge path as the working /.well-known/mcp-config above. Remove when
233	# FastMCP Cloud fixes the edge routing.
234	@mcp.custom_route("/.well-known/oauth-protected-resource/mcp", methods=["GET"])
235	async def oauth_protected_resource(request) -> Response:
236	    server_base_url = os.getenv("SERVER_URL", "http://localhost:8000").rstrip("/")
237	    project = os.getenv("DESCOPE_PROJECT_ID")
238	    descope_base = os.getenv("DESCOPE_BASE_URL", "https://api.descope.com").rstrip("/")
239	    return JSONResponse({
240	        "resource": f"{server_base_url}/mcp",
241	        "authorization_servers": [f"{descope_base}/v1/apps/{project}"],
242	        "bearer_methods_supported": ["header"],
243	        "scopes_supported": [],
244	    })
