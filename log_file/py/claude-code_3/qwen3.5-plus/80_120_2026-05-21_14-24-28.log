44	
45	    Returns:
46	        Tuple[Optional[Application], Optional[uia_controls.WindowSpecification]]:
47	            A tuple containing the connected `pywinauto.Application` instance and the
48	            main window specification (`WindowSpecification`). Both can be `None` if 
49	            the Abaqus/CAE window is not found or connection fails.
50	    """
51	    global abaqus_main_window_cache, abaqus_app_instance_cache
52	    if abaqus_app_instance_cache and abaqus_main_window_cache and \
53	       abaqus_main_window_cache.exists() and abaqus_main_window_cache.is_visible():
54	        return abaqus_app_instance_cache, abaqus_main_window_cache
