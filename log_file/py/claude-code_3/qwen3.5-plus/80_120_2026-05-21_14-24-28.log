65	                continue
66	            field_names.append(field.name)
67	            if field.default is not MISSING:
68	                defaults[field.name] = field.default
69	        catalog.append(
70	            {
71	                "domain": domain,
72	                "version": version,
73	                "request_fields": field_names,
74	                "defaults": defaults,
75	            }
76	        )
77	    return catalog
78	
79	
80	def generate_impl(args: GenerateArgs) -> dict[str, Any]:
81	    """Delegate to the domain facade with deterministic payloads."""
82	
83	    payload = args.to_payload()
84	    # WHY: The facade owns canonical hashing and RNG seeding; forwarding the payload
85	    # untouched prevents duplicate hash derivations and keeps determinism obvious.
86	    return facade.generate_domain(payload)
87	
88	
89	def create_server(*, api_key: str | None = None) -> FastMCP:
90	    """Create a FastMCP server exposing DataMimic generators."""
91	
92	    server = FastMCP(
93	        name="datamimic-ce",
94	        version=None,
95	    )
96	
97	    @server.tool("list_domains")
98	    async def list_domains() -> list[dict[str, Any]]:
99	        return list_domains_impl()
100	
101	    @server.tool("generate")
102	    async def generate(args: GenerateArgs) -> dict[str, Any]:
103	        return generate_impl(args)
104	
105	    http_middleware = _build_http_middleware(api_key)
106	    setattr(server, HTTP_MIDDLEWARE_ATTR, http_middleware)
107	
108	    for schema in resources.iter_schema_resources():
109	        loader = _schema_loader(schema.domain, schema.version, schema.kind)
110	        server.resource(schema.uri, mime_type="application/schema+json")(loader)
111	
112	    return server
113	
114	
115	def mount_mcp(
116	    app: _FastAPILike,
117	    *,
118	    path: str = "/mcp",
119	    api_key: str | None = None,
120	    server: FastMCP | None = None,
121	) -> FastMCP:
122	    """Mount the FastMCP server onto an existing FastAPI application."""
123	
124	    mcp_server = server or create_server(api_key=api_key)
125	    http_middleware = getattr(mcp_server, HTTP_MIDDLEWARE_ATTR, None)
126	    sse_app = build_sse_app(mcp_server, http_middleware)
127	    app.mount(path, sse_app)
128	    return mcp_server
129	
130	
131	def _build_http_middleware(api_key: str | None) -> list[Middleware] | None:
132	    if not api_key:
133	        return None
134	    # WHY: Starlette middleware keeps HTTP transports gated.
135	    # Avoid reimplementing FastMCP internals just for header inspection.
136	    return [Middleware(_APIKeyMiddleware, api_key=api_key)]
137	
138	
139	def _schema_loader(
140	    domain: str,
141	    version: str,
142	    kind: resources.SchemaKind,
143	) -> Callable[[], dict[str, Any]]:
144	    """Build a parameterless schema loader for the FastMCP registry."""
145	
146	    def load() -> dict[str, Any]:
147	        return resources.load_schema(domain, version, kind)
148	
149	    return load
150	
151	
152	def build_sse_app(
153	    server: FastMCP,
154	    middleware: list[Middleware] | None,
155	) -> Starlette:
156	    """Create an SSE ASGI app with optional middleware layering.
157	
158	    Note: FastMCP's Starlette route may log a benign TypeError due to returning
159	    None after streaming. This does not affect functionality; tests verify end-to-end.
160	    """
161	
162	    sse_factory = cast(Callable[[], Starlette], server.sse_app)
163	    sse_app = sse_factory()
164	    if middleware:
165	        for entry in middleware:
166	            # WHY: Starlette stores middleware callables and kwargs separately; rehydrate
167	            # them instead of reimplementing the wrapping logic here.
168	            sse_app.add_middleware(entry.cls, *entry.args, **entry.kwargs)
169	    return sse_app
170	
171	
