277	def get_snowflake_connection(config: SnowflakeConfig) -> SnowflakeConnection:
278	    """Create a connection to Snowflake using key pair or external browser auth."""
279	    conn_params: Dict[str, Any] = {
280	        "account": config.account,
281	        "user": config.user,
282	    }
283	
284	    # Set authentication parameters based on auth_type
285	    if config.auth_type == AuthType.PRIVATE_KEY:
286	        if not config.private_key_path:
287	            raise ValueError(
288	                "Private key path is required for private key authentication"
289	            )
290	        private_key = load_private_key(config.private_key_path)
291	        conn_params["private_key"] = private_key
292	    elif config.auth_type == AuthType.EXTERNAL_BROWSER:
293	        conn_params["authenticator"] = "externalbrowser"
294	
295	    # Add optional connection parameters
296	    if config.warehouse:
297	        conn_params["warehouse"] = config.warehouse
298	    if config.database:
299	        conn_params["database"] = config.database
300	    if config.schema_name:
301	        conn_params["schema"] = config.schema_name
302	    if config.role:
