1	"""Configuration handling for IMAP MCP server."""
2	
3	import logging
4	import os
5	from dataclasses import dataclass
6	from pathlib import Path
7	from typing import Any, Dict, List, Optional
8	
9	import yaml
10	from dotenv import load_dotenv
