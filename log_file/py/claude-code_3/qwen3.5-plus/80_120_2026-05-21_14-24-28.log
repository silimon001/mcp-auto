334	    @mcp.tool()
335	    async def mem0_get_all_memories(
336	        user_id: str,  # Now required
337	        agent_id: str = "",  # Required with default
338	        run_id: str = "",  # Required with default
339	        limit: int = 0,  # Required with default (0 ignored)
340	        page: int = 0,  # Required with default (0 ignored)
341	        page_size: int = 0,  # Required with default (0 ignored)
342	        enable_graph: bool = False,
343	    ) -> dict:
344	        """Gets memories from Mem0. Requires user_id.
345	        Parameters like agent_id, run_id, limit, page, page_size have defaults if not provided.
346	        Set enable_graph=True to include graph context.
347	        Use page and page_size for pagination (default 0 ignored).
348	        Limit is potentially deprecated/conflicts with pagination (default 0 ignored).""" # Updated docstring
349	        
350	        logging.info(f"Get all request: user={user_id}, agent={agent_id}, run={run_id}, limit={limit}, page={page}, page_size={page_size}, enable_graph={enable_graph}")
351	        
352	        if not mem0_instance:
353	            logging.error("Mem0 instance not initialized.")
354	            return {"status": "error", "message": "Mem0 instance failed to initialize."}
355	            
356	        try:
357	            get_args = {"user_id": user_id}  # user_id is now always provided
358	            
359	            # --- Apply workaround for originally optional parameters ---
360	            if agent_id: # Check if not default ""
361	                get_args["agent_id"] = agent_id
362	                logging.info(f"Using agent_id: {agent_id}")
363	            if run_id: # Check if not default ""
364	                get_args["run_id"] = run_id
365	                logging.info(f"Using run_id: {run_id}")
366	                
367	            # --- Pagination and Limit Handling (checking defaults) ---
368	            page_provided = (page != 0)
369	            page_size_provided = (page_size != 0)
370	            limit_provided = (limit != 0)
371	            
372	            # Prefer pagination if page or page_size is explicitly provided (non-zero)
373	            if page_provided or page_size_provided:
374	                if page_provided:
375	                    get_args["page"] = page
376	                    logging.info(f"Applying pagination: page={page}")
377	                if page_size_provided:
378	                    get_args["page_size"] = page_size
379	                    logging.info(f"Applying pagination: page_size={page_size}")
380	                if limit_provided:
381	                    logging.warning("'limit' parameter provided alongside pagination ('page'/'page_size'). Pagination arguments will be used.")
382	                    # No need to remove limit from get_args as it wasn't added yet
383	            # Use limit only if provided AND no pagination was provided
384	            elif limit_provided:
385	                 get_args["limit"] = limit
386	                 logging.info(f"Applying limit: {limit} (Note: Pagination preferred)")
387	            else:
388	                 logging.info("No pagination or limit provided (or defaults used).")
389	                 
390	            # --- Graph handling ---
391	            if enable_graph:
392	                get_args["enable_graph"] = True
393	                get_args["output_format"] = "v1.1"
394	                logging.info(f"Calling mem0_instance.get_all (GRAPH ENABLED) with args={get_args}")
395	            else:
396	                logging.info(f"Calling mem0_instance.get_all (GRAPH DISABLED) with args={get_args}")
397	                
398	            response = await mem0_instance.get_all(**get_args)
399	            logging.info(f"Mem0 get_all response: {response}")
400	            return {"status": "success", "memories": response}
401	        except Exception as e:
402	            logging.error(f"Error getting all memories: {e}")
403	            logging.error(traceback.format_exc())
404	            return {"status": "error", "message": str(e)}
