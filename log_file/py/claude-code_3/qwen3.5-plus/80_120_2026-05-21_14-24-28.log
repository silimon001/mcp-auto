2	Configuration for the robot controller.
3	Update it before using any other script.
4	"""
5	
6	import os
7	from dataclasses import dataclass, field
8	from typing import Dict, Tuple, Any, Final
9	from lerobot.cameras.opencv.configuration_opencv import OpenCVCameraConfig
10	
11	# Module-level constants
12	DEFAULT_ROBOT_TYPE: Final[str] = "lekiwi" # "so100", "so101", "lekiwi"
13	DEFAULT_SERIAL_PORT: Final[str] = "/dev/tty.usbmodem58FD0168731" # only for SO ARM
14	DEFAULT_REMOTE_IP: Final[str] = "192.168.1.1" # only for LeKiwi
15	
16	# Camera configuration constants
17	# Can also be different for different cameras, set it in lerobot_config
18	DEFAULT_CAMERA_FPS: Final[int] = 30
19	DEFAULT_CAMERA_WIDTH: Final[int] = 640
20	DEFAULT_CAMERA_HEIGHT: Final[int] = 360
21	
22	@dataclass
23	class RobotConfig:
24	    """
25	    Configuration for the robot controller.
26	    
27	    This dataclass contains all configuration parameters needed for robot operation,
28	    including hardware settings, kinematic parameters, and movement constants.
29	    """
30	
31	    # This will hold the configuration for the `lerobot` robot instance.
32	    # It's structured as a dictionary to be passed to `make_robot_from_config` or a similar factory.
33	    lerobot_config: Dict[str, Any] = field(
34	        default_factory=lambda: {
35	            "type": DEFAULT_ROBOT_TYPE,
36	            "port": DEFAULT_SERIAL_PORT,
37	            "remote_ip": DEFAULT_REMOTE_IP,
38	            "cameras": {
39	                "front": OpenCVCameraConfig(
40	                    index_or_path=0,
41	                    fps=DEFAULT_CAMERA_FPS,
42	                    width=DEFAULT_CAMERA_WIDTH,
43	                    height=DEFAULT_CAMERA_HEIGHT,
44	                ),
45	                "wrist": OpenCVCameraConfig(
46	                    index_or_path=1,
47	                    fps=DEFAULT_CAMERA_FPS,
48	                    width=DEFAULT_CAMERA_WIDTH,
49	                    height=DEFAULT_CAMERA_HEIGHT,
50	                ),
51	                "top": OpenCVCameraConfig(
52	                    index_or_path=2,
53	                    fps=DEFAULT_CAMERA_FPS,
54	                    width=DEFAULT_CAMERA_WIDTH,
55	                    height=DEFAULT_CAMERA_HEIGHT,
56	                ),
57	            },
58	        }
59	    )
60	
61	    # Mapping from lerobot's normalized motor outputs (-100 to 100 or 0 to 100) to degrees.
62	    # Format: {motor_name: (norm_min, norm_max, deg_min, deg_max)}
63	    # Use check_positions.py, move your robot to 0, 90, 180 degree positions 
64	    # and insert the corresponding normalized values here
65	    # You can use any 2 points per motor to interpolate, but wider range is better
66	    # TODO: find a simpler way to calibrate the robot
67	    MOTOR_NORMALIZED_TO_DEGREE_MAPPING: Dict[str, Tuple[float, float, float, float]] = field(
68	        default_factory=lambda: {
69	            "shoulder_pan":  (-91.7, 99.5, 0.0, 180.0),
70	            "shoulder_lift": (-89.4, 99.4, 0, 180.0),
71	            "elbow_flex":    (96.5, -92.7, 0, 180.0),
72	            "wrist_flex":    (-90.0, 90.0, -90.0, 90.0),
73	            "wrist_roll":    (100, -100, -90, 90),
74	            "gripper":       (31.0, 100.0, 0.0, 100.0),
75	        }
76	    )
77	
78	    # Movement constants for smooth interpolation
79	    MOVEMENT_CONSTANTS: Dict[str, Any] = field(
80	        default_factory=lambda: {
81	            "DEGREES_PER_STEP": 1.5,           # Degrees per interpolation step
82	            "MAX_INTERPOLATION_STEPS": 150,    # Maximum number of interpolation steps
83	            "STEP_DELAY_SECONDS": 0.01,        # Delay between interpolation steps (100Hz)
84	        }
85	    )
86	
87	    # Robot description for AI/LLM context
88	    robot_description: str = ("""
89	Follow these instructions precisely. Never deviate.
90	
91	You control a 3D printed robot with 5 DOF + gripper. Max forward reach ~250 mm.
92	Shoulder and elbow links are 12 cm and 14 cm. Gripper fingers ~8 cm.
93	Use these to estimate distances. E.g., if the object is near but not in the gripper, you can safely move 5–10 cm forward.
94	
95	Robot has 3 cameras:
96	- front: at the base, looks forward
97	- wrist: close view of gripper
98	- top view: shows whole robot
99	
100	Instructions:
101	- Move slowly and iteratively
102	- Close gripper completely to grab objects
103	- Check results after each move before proceeding
104	- When the object inside your gripper it will not be visible on top and front cameras and will cover the whole view for the wrist one
105	- Split into smaller steps and reanalyze after each one
106	- Use only the latest images to evaluate success
