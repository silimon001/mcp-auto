3	import logging
4	import os
5	from collections.abc import AsyncIterator, Sequence
6	from contextlib import asynccontextmanager
7	from dataclasses import dataclass
8	from datetime import date, datetime
9	from decimal import Decimal
10	from enum import Enum
11	from typing import Any
12	
13	from mcp.server.fastmcp import Context
14	from pydantic import BaseModel
15	from tabulate import tabulate
16	from tastytrade import Account, Session
17	
18	logger = logging.getLogger(__name__)
19	
20	COMPACT_EMPTY_VALUES = (None, "", [], {})
21	
22	
23	def is_compact_empty(
24	    value: Any,
25	    *,
26	    drop_zero_string: bool = False,
27	    drop_numeric_zero: bool = False,
28	) -> bool:
29	    """Return whether a compacted value should be omitted from tool output."""
30	    if value in COMPACT_EMPTY_VALUES:
31	        return True
32	    if drop_zero_string and value == "0":
33	        return True
34	    return drop_numeric_zero and type(value) is not bool and value == 0
35	
36	
37	def compact_row(
38	    data: dict[str, Any],
39	    *,
40	    drop_zero_string: bool = False,
41	    drop_numeric_zero: bool = False,
42	) -> dict[str, Any]:
43	    """Drop empty values from an already compacted row."""
44	    return {
45	        key: value
46	        for key, value in data.items()
47	        if not is_compact_empty(
48	            value,
49	            drop_zero_string=drop_zero_string,
50	            drop_numeric_zero=drop_numeric_zero,
51	        )
52	    }
53	
54	
55	def compact_value(value: Any) -> Any:
56	    """Return a compact, JSON/table friendly scalar."""
57	    if isinstance(value, Decimal):
58	        if value.is_nan():
59	            return None
60	        text = format(value.normalize(), "f")
61	        return text.rstrip("0").rstrip(".") if "." in text else text
62	    if isinstance(value, Enum):
63	        return value.value
64	    if isinstance(value, datetime):
65	        return value.isoformat()
66	    if isinstance(value, date):
67	        return value.isoformat()
68	    if isinstance(value, BaseModel):
69	        return compact_model_dump(value)
70	    if isinstance(value, list):
71	        return [compact_value(item) for item in value if item is not None]
72	    if isinstance(value, tuple):
73	        return tuple(compact_value(item) for item in value if item is not None)
74	    if isinstance(value, dict):
75	        return compact_dict(value)
76	    return value
77	
78	
79	def compact_dict(data: dict[str, Any], fields: Sequence[str] | None = None) -> dict[str, Any]:
80	    """Keep selected non-empty fields and compact scalar values."""
81	    keys = fields or data.keys()
82	    compacted: dict[str, Any] = {}
83	    for key in keys:
84	        if key not in data:
85	            continue
86	        value = compact_value(data[key])
87	        if is_compact_empty(value):
88	            continue
89	        compacted[key] = value
90	    return compacted
91	
92	
93	def compact_model_dump(model: BaseModel, fields: Sequence[str] | None = None) -> dict[str, Any]:
94	    """Dump a Pydantic model without empty fields or verbose Decimal/Enum objects."""
95	    return compact_dict(model.model_dump(), fields)
96	
97	
98	def to_table(data: Sequence[BaseModel] | Sequence[dict[str, Any]], fields: Sequence[str] | None = None) -> str:
99	    """Format rows as a compact plain table."""
100	    if not data:
101	        return "No data"
102	    rows = [
103	        compact_model_dump(item, fields) if isinstance(item, BaseModel) else compact_dict(item, fields) for item in data
104	    ]
105	    return tabulate(rows, headers="keys", tablefmt="plain", missingval="")
106	
107	
108	@dataclass
109	class ServerContext:
110	    session: Session
111	    account: Account
112	
113	
114	def get_context(ctx: Context) -> ServerContext:
115	    """Extract ServerContext from the MCP request context."""
116	    return ctx.request_context.lifespan_context
117	
118	
119	def get_session(ctx: Context) -> Session:
120	    """Get the tastytrade session (auto-refreshes tokens before each API call)."""
121	    return get_context(ctx).session
122	
123	
124	@asynccontextmanager
125	async def lifespan(_) -> AsyncIterator[ServerContext]:
126	    """Manage Tastytrade session lifecycle."""
127	    client_secret = os.getenv("TASTYTRADE_CLIENT_SECRET")
128	    refresh_token = os.getenv("TASTYTRADE_REFRESH_TOKEN")
129	    account_id = os.getenv("TASTYTRADE_ACCOUNT_ID")
130	
131	    if not client_secret or not refresh_token:
132	        raise ValueError(
133	            "Missing Tastytrade OAuth credentials. Set TASTYTRADE_CLIENT_SECRET and "
134	            "TASTYTRADE_REFRESH_TOKEN environment variables."
135	        )
136	
137	    try:
138	        session = Session(client_secret, refresh_token)
139	        accounts = await Account.get(session)
140	        logger.info("Successfully authenticated with Tastytrade. Found %s account(s).", len(accounts))
141	    except Exception as e:
142	        logger.error("Failed to authenticate with Tastytrade: %s", e)
143	        raise
144	
145	    if account_id:
146	        account = next((acc for acc in accounts if acc.account_number == account_id), None)
147	        if not account:
148	            available = [acc.account_number for acc in accounts]
149	            raise ValueError(f"Account '{account_id}' not found. Available: {available}")
150	        logger.info("Using specified account: %s", account.account_number)
151	    else:
152	        account = accounts[0]
153	        logger.info("Using default account: %s", account.account_number)
154	
155	    yield ServerContext(session=session, account=account)
156	

