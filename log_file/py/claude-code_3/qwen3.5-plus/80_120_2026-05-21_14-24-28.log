162	        self.mcp.tool()(self.repository_tools.get_repository)
163	        self.mcp.tool()(self.repository_tools.create_repository)
164	        self.mcp.tool()(self.repository_tools.update_repository)
165	        self.mcp.tool()(self.repository_tools.delete_repository)
166	
167	        # Access key tools
168	        self.mcp.tool()(self.access_key_tools.list_access_keys)
169	        self.mcp.tool()(self.access_key_tools.get_access_key)
170	        self.mcp.tool()(self.access_key_tools.create_access_key)
171	        self.mcp.tool()(self.access_key_tools.update_access_key)
172	        self.mcp.tool()(self.access_key_tools.delete_access_key)
173	
174	    # Tool methods have been moved to dedicated tool classes
175	
176	    def run(self, transport: str = "stdio"):
177	        """Run the MCP server.
178	
179	        Args:
180	            transport: Transport type - "stdio" or "http"
181	        """
182	        logger.info(f"Starting FastMCP server for SemaphoreUI at {self.url}")
183	        if transport == "http":
184	            logger.info(
185	                f"HTTP transport on {self.mcp.settings.host}:{self.mcp.settings.port}"
186	            )
187	            self.mcp.run(transport="streamable-http")
188	        else:
189	            logger.info("STDIO transport")
190	            self.mcp.run(transport="stdio")
191	
192	
193	def start_server(
194	    semaphore_url: Optional[str] = None,
195	    semaphore_token: Optional[str] = None,
196	    transport: str = "stdio",
197	    host: str = "127.0.0.1",
198	    port: int = 8000,
199	):
200	    """
201	    Start an MCP server.
202	
203	    Args:
204	        semaphore_url: SemaphoreUI API URL
205	        semaphore_token: SemaphoreUI API token
206	        transport: Transport type - "stdio" or "http"
207	        host: Host to bind to (for HTTP transport)
208	        port: Port to listen on (for HTTP transport)
209	    """
210	    server = SemaphoreMCPServer(semaphore_url, semaphore_token, host=host, port=port)
211	    server.run(transport=transport)
