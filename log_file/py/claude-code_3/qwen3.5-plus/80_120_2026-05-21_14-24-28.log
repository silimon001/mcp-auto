478	    def disconnect(self, reset_pos: bool = True) -> None:
479	        """Disconnect robot with optional reset to rest position."""
480	        if not self.robot:
481	            return
482	            
483	        logger.info("Disconnecting robot...")
484	        
485	        # Don't move to rest position in read-only mode
486	        if reset_pos and not self.read_only:
487	            try:
488	                result = self.apply_named_preset("1")
489	                if not result.ok:
490	                    logger.warning(f"Rest position failed: {result.msg}")
491	            except Exception as e:
492	                logger.error(f"Error during rest position: {e}", exc_info=True)
493	        elif reset_pos and self.read_only:
494	            logger.info("Skipping rest position in read-only mode")
495	        
496	        try:
497	            self.robot.disconnect()
498	            logger.info("Robot disconnected successfully")
499	        except Exception as e:
