125	    def _connect_robot_readonly(self) -> None:
126	        """Connect to robot and disable torque for manual movement."""
127	        try:
128	            self._connect_robot()
129	
130	            if self.robot_type != "lekiwi":
131	                self.robot.bus.disable_torque()
132	                logger.info(f"Connected to {self.robot_type} in READ-ONLY mode")
133	                logger.info("🔓 TORQUE DISABLED: Robot can now be moved manually while monitoring positions")
134	
135	            else:
136	                logger.warning("LeKiwi does not support remote torque disabling, you need to do it manually on the host.")
137	            
138	        except Exception as e:
139	            logger.error(f"Failed to connect to robot in read-only mode: {e}")
140	            raise
