23	class EventDetails(BaseModel):
24	    summary: str = Field(description="The title or summary of the calendar event.")
25	    start_time: str = Field(description="The start time of the event in ISO 8601 format (e.g., '2025-07-05T15:00:00').")
26	    end_time: str = Field(description="The end time of the event in ISO 8601 format (e.g., '2025-07-05T16:00:00').")
27	    description: Optional[str] = Field(None, description="A detailed description for the event. Can include notes from the source email.")
