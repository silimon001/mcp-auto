1	"""Command line interface for serving the FastMCP endpoint.
2	
3	WHY: Typer in some environments doesn't support ``typing.Literal`` for
4	option types, raising "Type not yet supported". To keep broad
5	compatibility without upgrading tooling, we use ``Enum`` for choices.
6	This keeps the CLI thin, explicit, and compatible across Typer versions.
7	"""
8	
9	from __future__ import annotations
10	
11	import os
12	from enum import StrEnum
13	from typing import Annotated
14	
15	import typer
16	import uvicorn
17	
18	from datamimic_ce.mcp.server import (
19	    HTTP_MIDDLEWARE_ATTR,
20	    build_sse_app,
21	    create_server,
22	)
23	
24	app = typer.Typer(help="Run the DataMimic MCP server")
25	
26	_DEFAULT_HOST = "127.0.0.1"
27	_DEFAULT_PORT = 8765
28	
29	# WHY: Avoid ruff-bugbear B008 (no function calls in argument defaults).
30	# We compute environment-derived defaults at module load and use them as
31	# plain defaults, while passing Typer options via `Annotated` metadata.
32	_ENV_HOST_DEFAULT = os.getenv("DATAMIMIC_MCP_HOST", _DEFAULT_HOST)
33	_ENV_PORT_DEFAULT = int(os.getenv("DATAMIMIC_MCP_PORT", str(_DEFAULT_PORT)))
34	
35	
36	class Transport(StrEnum):
37	    """Supported transport mechanisms for FastMCP.
38	
39	    WHY: Replaces ``Literal['sse', 'stdio']`` to avoid Typer limitations.
40	    """
41	
42	    sse = "sse"
43	    stdio = "stdio"
44	
45	
46	class LogLevel(StrEnum):
47	    """Supported log levels for uvicorn.
48	
49	    WHY: Replaces ``Literal[...]`` to avoid Typer limitations.
50	    """
51	
52	    critical = "critical"
53	    error = "error"
54	    warning = "warning"
55	    info = "info"
56	    debug = "debug"
57	
58	
59	@app.command()
60	def serve(
61	    host: Annotated[
62	        str,
63	        typer.Option(help="Host interface to bind for SSE transport"),
64	    ] = _ENV_HOST_DEFAULT,
65	    port: Annotated[
66	        int,
67	        typer.Option(help="TCP port to bind for SSE transport"),
68	    ] = _ENV_PORT_DEFAULT,
69	    transport: Annotated[
70	        Transport,
71	        typer.Option(
72	            help="FastMCP transport (sse for network clients, stdio for agent runtimes)",
73	        ),
74	    ] = Transport.sse,
75	    log_level: Annotated[
76	        LogLevel,
77	        typer.Option(help="Log level when running the SSE server"),
78	    ] = LogLevel.info,
79	) -> None:
80	    """Start the FastMCP server with optional API key gating."""
81	
82	    api_key = os.getenv("DATAMIMIC_MCP_API_KEY")
83	    server = create_server(api_key=api_key)
84	    middleware = getattr(server, HTTP_MIDDLEWARE_ATTR, None)
85	
86	    if transport == Transport.stdio:
