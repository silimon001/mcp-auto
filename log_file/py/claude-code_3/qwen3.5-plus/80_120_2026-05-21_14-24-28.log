90	async def _fetch_order_market(ctx: Context, instrument_details: list[InstrumentDetail], legs: list[Any]):
91	    """Fetch current quotes and build the signed net market for order legs."""
92	    session = get_session(ctx)
93	    quotes = await _stream_events(session, Quote, [d.streamer_symbol for d in instrument_details], timeout=10.0)
94	    return build_order_market(instrument_details, legs, quotes)
