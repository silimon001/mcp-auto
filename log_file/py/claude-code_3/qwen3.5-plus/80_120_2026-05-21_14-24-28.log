142	    def _deg_to_norm(self, joint_name: str, degrees: float) -> float:
143	        """Convert degrees to normalized value."""
144	        norm_min, norm_max, deg_min, deg_max = self.motor_mapping[joint_name]
145	        if deg_max == deg_min:
146	            return norm_min
147	        return norm_min + ((degrees - deg_min) * (norm_max - norm_min)) / (deg_max - deg_min)
148	
149	    def _norm_to_deg(self, joint_name: str, normalized: float) -> float:
150	        """Convert normalized value to degrees."""
151	        norm_min, norm_max, deg_min, deg_max = self.motor_mapping[joint_name]
152	        if norm_max == norm_min:
153	            return deg_min
154	        return deg_min + ((normalized - norm_min) * (deg_max - deg_min)) / (norm_max - norm_min)
155	
156	    def _validate_normalized_ranges(self, positions_deg: Dict[str, float]) -> tuple[bool, str]:
157	        """
158	        Validate that the target positions will result in normalized values within the robot's calibrated ranges.
159	        Returns (is_valid, error_message)
160	        """
161	        errors = []
162	        
163	        for joint_name, deg_value in positions_deg.items():
164	            if joint_name not in self.motor_mapping:
165	                continue
166	                
167	            norm_value = self._deg_to_norm(joint_name, deg_value)
168	
169	            if joint_name == "gripper":
170	                norm_min, norm_max = 0, 100
171	            else:
172	                norm_min, norm_max = -100, 100
173	            
174	            # Handle inverted ranges (where norm_min > norm_max)
175	            actual_min = min(norm_min, norm_max)
176	            actual_max = max(norm_min, norm_max)
177	            
178	            if norm_value < actual_min or norm_value > actual_max:
179	                errors.append(
180	                    f"{joint_name.replace('_', ' ').title()} position {deg_value:.1f}° "
181	                    f"(normalized: {norm_value:.1f}) is outside valid range "
182	                    f"{actual_min:.1f} to {actual_max:.1f}"
183	                )
184	        
185	        if errors:
186	            return False, "Movement impossible - out of range: " + "; ".join(errors)
187	        
188	        return True, ""
189	
190	    def _build_action(self, positions_deg: Dict[str, float]) -> Dict[str, float]:
191	        """Build action dictionary for lerobot."""
192	        action = {}
193	        
194	        for name, deg in positions_deg.items():
195	            norm_val = self._deg_to_norm(name, deg)
196	            pos_key = f"arm_{name}.pos" if self.robot_type == "lekiwi" else f"{name}.pos"
197	            action[pos_key] = norm_val
198	        
199	        # Add base velocities for lekiwi
200	        if self.robot_type == "lekiwi":
201	            action.update({"x.vel": 0.0, "y.vel": 0.0, "theta.vel": 0.0})
202	        
203	        return action
204	
205	    def _refresh_state(self) -> None:
206	        """Refresh robot state from hardware."""
207	        if not self.robot:
208	            return
209	            
210	        try:
211	            observation = self.robot.get_observation()
212	            
213	            if self.robot_type == "lekiwi":
214	                # LeKiwi returns a state vector in observation.state
215	                if "observation.state" in observation:
216	                    state_vector = observation["observation.state"]
217	                    # State order: arm_shoulder_pan.pos, arm_shoulder_lift.pos, arm_elbow_flex.pos, 
218	                    #              arm_wrist_flex.pos, arm_wrist_roll.pos, arm_gripper.pos, x.vel, y.vel, theta.vel
219	                    state_order = [
220	                        "arm_shoulder_pan.pos", "arm_shoulder_lift.pos", "arm_elbow_flex.pos",
221	                        "arm_wrist_flex.pos", "arm_wrist_roll.pos", "arm_gripper.pos",
222	                        "x.vel", "y.vel", "theta.vel"
223	                    ]
224	                    
225	                    for i, joint_name in enumerate(self.joint_names):
226	                        pos_key = f"arm_{joint_name}.pos"
227	                        if i < len(state_vector) and pos_key in state_order:
228	                            idx = state_order.index(pos_key)
229	                            norm_val = float(state_vector[idx])
230	                            self.positions_norm[joint_name] = norm_val
231	                            self.positions_deg[joint_name] = self._norm_to_deg(joint_name, norm_val)
232	                else:
233	                    # Fallback: try direct observation keys
234	                    for joint_name in self.joint_names:
235	                        pos_key = f"arm_{joint_name}.pos"
236	                        if pos_key in observation:
237	                            norm_val = observation[pos_key]
238	                            self.positions_norm[joint_name] = norm_val
239	                            self.positions_deg[joint_name] = self._norm_to_deg(joint_name, norm_val)
240	            else:
241	                # SO100/SO101: direct observation keys
242	                for joint_name in self.joint_names:
243	                    pos_key = f"{joint_name}.pos"
244	                    if pos_key in observation:
245	                        norm_val = observation[pos_key]
246	                        self.positions_norm[joint_name] = norm_val
247	                        self.positions_deg[joint_name] = self._norm_to_deg(joint_name, norm_val)
248	            
249	            # Update cartesian coordinates
250	            fk_x, fk_z = self.kinematics.forward_kinematics(
251	                self.positions_deg["shoulder_lift"],
252	                self.positions_deg["elbow_flex"]
253	            )
254	            self.cartesian_mm = {"x": fk_x, "z": fk_z}
255	            
256	        except Exception as e:
257	            logger.error(f"Failed to read robot state: {e}", exc_info=True)
258	
259	    def _get_human_readable_state(self) -> Dict[str, float]:
260	        """Calculate human-readable state values."""
261	        # Ensure all state dictionaries exist
262	        positions_deg = getattr(self, 'positions_deg', {name: 0.0 for name in getattr(self, 'joint_names', [])})
263	        cartesian_mm = getattr(self, 'cartesian_mm', {"x": 0.0, "z": 0.0})
264	        
265	        return {
266	            "robot_rotation_counterclockwise_deg": -positions_deg.get("shoulder_pan", 0.0) + 90,
267	            "gripper_heights_mm": cartesian_mm.get("z", 0.0),
268	            "gripper_linear_position_mm": cartesian_mm.get("x", 0.0),
269	            "gripper_tilt_deg": (positions_deg.get("wrist_flex", 0.0) + 
270	                               positions_deg.get("shoulder_lift", 0.0) - 
271	                               positions_deg.get("elbow_flex", 0.0)),
272	            "gripper_rotation_deg": -positions_deg.get("wrist_roll", 0.0),
273	            "gripper_openness_pct": positions_deg.get("gripper", 0.0),
274	        }
275	
276	    def _get_full_state(self) -> Dict[str, Any]:
277	        """Get complete state dictionary."""
278	        # Ensure all state dictionaries exist
279	        positions_deg = getattr(self, 'positions_deg', {})
280	        positions_norm = getattr(self, 'positions_norm', {})
281	        cartesian_mm = getattr(self, 'cartesian_mm', {"x": 0.0, "z": 0.0})
282	        
283	        return {
284	            "joint_positions_deg": {name: round(pos, 1) for name, pos in positions_deg.items()},
285	            "joint_positions_norm": {name: round(pos, 1) for name, pos in positions_norm.items()},
286	            "cartesian_mm": {name: round(pos, 1) for name, pos in cartesian_mm.items()},
287	            "human_readable_state": {name: round(pos, 1) for name, pos in self._get_human_readable_state().items()}
288	        }
289	
290	    def get_current_robot_state(self) -> MoveResult:
291	        """Get current robot state."""
292	        self._refresh_state()
293	        return MoveResult(True, "Current robot state retrieved.", robot_state=self._get_full_state())
294	
295	    def set_joints_absolute(self, positions_deg: Dict[str, float], use_interpolation: bool = True) -> MoveResult:
296	        """Set joints to absolute positions."""
297	        if self.read_only:
298	            return MoveResult(False, "Cannot move robot in read-only mode", robot_state=self._get_full_state())
299	            
300	        if not self.robot:
301	            return MoveResult(False, "Robot not connected", robot_state=self._get_full_state())
302	        
303	        # Filter valid joints
304	        valid_positions = {name: pos for name, pos in positions_deg.items() if name in self.joint_names}
305	        if not valid_positions:
306	            return MoveResult(True, "No valid joints to move", robot_state=self._get_full_state())
307	
308	        # Validate that positions are within LeRobot's accepted ranges
309	        is_valid, error_msg = self._validate_normalized_ranges(valid_positions)
310	        if not is_valid:
311	            return MoveResult(False, error_msg, robot_state=self._get_full_state())
312	
313	        try:
314	            if use_interpolation:
315	                self._execute_interpolated_move(valid_positions)
316	            else:
317	                action = self._build_action(valid_positions)
318	                self.robot.send_action(action)
319	            
320	            # Update state optimistically
321	            self.positions_deg.update(valid_positions)
322	            for name, deg in valid_positions.items():
323	                self.positions_norm[name] = self._deg_to_norm(name, deg)
324	            
325	            # Update cartesian if needed
326	            if "shoulder_lift" in valid_positions or "elbow_flex" in valid_positions:
327	                fk_x, fk_z = self.kinematics.forward_kinematics(
328	                    self.positions_deg["shoulder_lift"],
329	                    self.positions_deg["elbow_flex"]
330	                )
331	                self.cartesian_mm = {"x": fk_x, "z": fk_z}
332	
333	        except Exception as e:
334	            logger.error(f"Move failed: {e}", exc_info=True)
335	            self._refresh_state()
336	            return MoveResult(False, f"Move failed: {e}", robot_state=self._get_full_state())
337	        
338	        return MoveResult(True, "Move completed", robot_state=self._get_full_state())
339	
340	    def _execute_interpolated_move(self, target_positions: Dict[str, float]) -> None:
341	        """Execute smooth interpolated movement."""
342	        if self.read_only:
343	            raise RuntimeError("Cannot move robot in read-only mode")
344	            
345	        if not self.robot:
346	            raise RuntimeError("Robot not connected")
347	            
348	        start_positions = {name: self.positions_deg[name] for name in target_positions.keys()}
349	        
350	        max_change = max(abs(target_positions[name] - start_positions[name]) for name in target_positions.keys())
351	        steps = max(1, min(
352	            self.movement_config["MAX_INTERPOLATION_STEPS"],
353	            int(max_change / self.movement_config["DEGREES_PER_STEP"])
354	        ))
355	        
356	        for i in range(1, steps + 1):
357	            interpolated = {
358	                name: start_positions[name] + (target_positions[name] - start_positions[name]) * (i / steps)
359	                for name in target_positions.keys()
360	            }
361	            
362	            # Validate each interpolation step to avoid sending invalid commands
363	            is_valid, error_msg = self._validate_normalized_ranges(interpolated)
364	            if not is_valid:
365	                logger.warning(f"Interpolation step {i}/{steps} would exceed range limits, stopping interpolation")
366	                break
367	                
368	            action = self._build_action(interpolated)
369	            self.robot.send_action(action)
370	            time.sleep(self.movement_config["STEP_DELAY_SECONDS"])
371	
372	    def increment_joints_by_delta(self, deltas_deg: Dict[str, float]) -> MoveResult:
373	        """Increment joints by delta degrees."""
374	        if self.read_only:
375	            return MoveResult(False, "Cannot move robot in read-only mode", robot_state=self._get_full_state())
376	            
377	        target_positions = {}
378	        warnings = []
379	        
380	        for joint_name, delta in deltas_deg.items():
381	            if joint_name not in self.joint_names:
382	                warnings.append(f"Unknown joint '{joint_name}' ignored.")
383	                continue
384	            target_positions[joint_name] = self.positions_deg[joint_name] + delta
385	        
386	        if not target_positions:
387	            return MoveResult(False, "No valid joints for increment.", warnings, self._get_full_state())
388	        
389	        result = self.set_joints_absolute(target_positions)
390	        result.warnings.extend(warnings)
391	        return result
392	
393	    def execute_intuitive_move(
394	        self,
395	        move_gripper_up_mm: Optional[float] = None,
396	        move_gripper_forward_mm: Optional[float] = None,
397	        tilt_gripper_down_angle: Optional[float] = None,
398	        rotate_gripper_counterclockwise_angle: Optional[float] = None,
399	        rotate_robot_left_angle: Optional[float] = None,
400	        use_interpolation: bool = True
401	    ) -> MoveResult:
402	        """Execute intuitive movement commands."""
403	        if self.read_only:
404	            return MoveResult(False, "Cannot move robot in read-only mode", robot_state=self._get_full_state())
405	            
406	        target_positions = self.positions_deg.copy()
407	        
408	        # Handle cartesian movements
409	        if move_gripper_up_mm is not None or move_gripper_forward_mm is not None:
410	            target_x = self.cartesian_mm["x"] + (move_gripper_forward_mm or 0.0)
411	            target_z = self.cartesian_mm["z"] + (move_gripper_up_mm or 0.0)
412	            
413	            # Validate target
414	            is_valid, msg = self.kinematics.is_cartesian_target_valid(target_x, target_z)
415	            if not is_valid:
416	                return MoveResult(False, f"Invalid target: {msg}", robot_state=self._get_full_state())
417	            
418	            try:
419	                sl_target, ef_target = self.kinematics.inverse_kinematics(target_x, target_z)
420	                target_positions["shoulder_lift"] = sl_target
421	                target_positions["elbow_flex"] = ef_target
422	                
423	                # Wrist compensation
424	                sl_change = sl_target - self.positions_deg["shoulder_lift"]
425	                ef_change = ef_target - self.positions_deg["elbow_flex"]
426	                target_positions["wrist_flex"] = self.positions_deg["wrist_flex"] - (sl_change - ef_change)
427	                
428	            except Exception as e:
429	                return MoveResult(False, f"Kinematics error: {e}", robot_state=self._get_full_state())
430	        
431	        # Handle direct joint movements
432	        if tilt_gripper_down_angle is not None:
433	            target_positions["wrist_flex"] += tilt_gripper_down_angle
434	        if rotate_gripper_counterclockwise_angle is not None:
435	            target_positions["wrist_roll"] -= rotate_gripper_counterclockwise_angle
436	        if rotate_robot_left_angle is not None:
437	            target_positions["shoulder_pan"] -= rotate_robot_left_angle
438	        
439	        return self.set_joints_absolute(target_positions, use_interpolation)
440	
441	    def apply_named_preset(self, preset_key: str) -> MoveResult:
442	        """Apply a named preset position."""
443	        if self.read_only:
444	            return MoveResult(False, "Cannot move robot in read-only mode", robot_state=self._get_full_state())
445	            
446	        if preset_key not in self.presets:
447	            return MoveResult(False, f"Unknown preset: '{preset_key}'", robot_state=self._get_full_state())
448	        
449	        preset_positions = self.presets[preset_key]
450	        logger.info(f"Applying preset '{preset_key}': {preset_positions}")
451	        return self.set_joints_absolute(preset_positions)
452	
453	    def get_camera_images(self) -> Dict[str, np.ndarray]:
454	        """Get camera images from robot observation."""
455	        if not self.robot:
456	            return {}
457	            
458	        try:
459	            observation = self.robot.get_observation()
460	            camera_images = {}
461	            
462	            camera_names = list(robot_config.lerobot_config.get("cameras", {}).keys())
463	            
464	            # Handle both direct camera names (so100/so101) and prefixed names (lekiwi)
465	            for key, value in observation.items():
466	                camera_name = key.replace("observation.images.", "")
467	                
468	                if camera_name in camera_names and isinstance(value, np.ndarray) and value.ndim == 3:
469	                    camera_images[camera_name] = value
470	                elif key in camera_names and isinstance(value, np.ndarray) and value.ndim == 3:
471	                    camera_images[key] = value
472	            
473	            return camera_images
474	        except Exception as e:
475	            logger.error(f"Error getting camera images: {e}", exc_info=True)
476	            return {}
