1	#!/usr/bin/env python3
2	"""Установка зависимостей для code-search.py в локальное виртуальное окружение .venv"""
3	import subprocess
4	import sys
5	import os
6	import platform
7	import msvcrt
8	import time
9	from pathlib import Path
10	
11	# Константы
12	ROOT_DIR = Path(__file__).parent
13	VENV_DIR = ROOT_DIR / ".venv"
14	
15	def input_with_timeout(prompt, timeout, default):
16	    print(prompt, end='', flush=True)
17	    start_time = time.time()
18	    input_str = ''
19	    while True:
20	        if msvcrt.kbhit():
21	            char = msvcrt.getwche()
22	            if char == '\r' or char == '\n':
23	                print()
24	                return input_str if input_str else default
25	            input_str += char
26	        
27	        if time.time() - start_time > timeout:
28	            print(f"\nВремя истекло. Выбрано по умолчанию: {default}")
29	            return default
30	        
31	        time.sleep(0.1)
32	
33	def get_venv_python():
34	    """Возвращает путь к python внутри venv"""
35	    if platform.system() == "Windows":
36	        return VENV_DIR / "Scripts" / "python.exe"
37	    else:
38	        return VENV_DIR / "bin" / "python"
39	
40	def create_venv():
41	    """Создает виртуальное окружение, если оно не существует"""
42	    if VENV_DIR.exists():
43	        print(f"Виртуальное окружение {VENV_DIR} уже существует.")
44	        return
45	
46	    print(f"Создание виртуального окружения в {VENV_DIR}...")
47	    try:
48	        subprocess.check_call([sys.executable, "-m", "venv", str(VENV_DIR)])
49	        print("Виртуальное окружение создано успешно.")
50	    except subprocess.CalledProcessError as e:
51	        print(f"Ошибка при создании venv: {e}")
52	        sys.exit(1)
53	
54	def install_requirements(python_exe, requirements_file):
55	    """Устанавливает зависимости из указанного файла требований"""
56	    if not os.path.exists(requirements_file):
57	        print(f"ОШИБКА: Файл {requirements_file} не найден!")
58	        sys.exit(1)
59	
60	    print(f"Установка зависимостей из {requirements_file}...")
61	    cmd = [str(python_exe), "-m", "pip", "install", "-r", str(requirements_file)]
62	    print(f"Выполнение: {' '.join(cmd)}")
63	    subprocess.run(cmd, check=True)
64	
65	def main():
66	    print("=== Установка зависимостей Code Search (в .venv) ===")
67	    
68	    # 1. Создаем venv
69	    create_venv()
70	    venv_python = get_venv_python()
71	    
72	    if not venv_python.exists():
73	        print(f"ОШИБКА: Интерпретатор не найден по пути {venv_python}")
74	        sys.exit(1)
75	
76	    # 2. Обновляем pip внутри venv
77	    print("\nОбновление pip...")
78	    subprocess.run([str(venv_python), "-m", "pip", "install", "--upgrade", "pip"], check=True)
79	
80	    print("\nВыберите режим ускорения:")
81	    print("1. DirectML (рекомендуется для Windows: AMD, Intel, NVIDIA)")
82	    print("2. NVIDIA CUDA (только для мощных карт NVIDIA)")
83	    print("Если не знаете, что выбрать - выбирайте 1.")
84	    
85	    choice = input_with_timeout("Ваш выбор [1] (10 сек): ", 10, "1").strip()
86	    
87	    requirements_file = "requirements-dml.txt" # Default/DirectML
88	    
89	    if choice == "2":
90	        print("Выбран режим NVIDIA CUDA")
91	        requirements_file = "requirements-cuda.txt"
92	    else:
93	        # DirectML (default)
94	        print("Выбран режим DirectML (или по умолчанию)")
95	        requirements_file = "requirements-dml.txt"
96	
97	    # Full path to req file
98	    req_path = ROOT_DIR / requirements_file
99	
100	    try:
101	        install_requirements(venv_python, req_path)
102	            
103	        print("\nГотово! Теперь все пакеты установлены в изолированное окружение .venv")
104	        print("Для запуска используйте: python run.py")
105	            
106	    except subprocess.CalledProcessError as e:
107	        print(f"\nОшибка установки: {e}")
108	        sys.exit(1)
109	
110	if __name__ == "__main__":
111	    main()
112	

