1	"""
2	Configuration module for SemaphoreMCP.
3	
4	Handles environment variable loading and configuration management.
5	"""
6	
7	import logging
8	import os
9	from typing import Optional
10	
11	from dotenv import load_dotenv
12	
13	# Load environment variables from .env file
14	load_dotenv()
15	
16	# Default configuration values
17	DEFAULT_CONFIG = {
18	    "SEMAPHORE_URL": "http://localhost:3000",
19	    "SEMAPHORE_API_TOKEN": "",
20	    "MCP_LOG_LEVEL": "INFO",
21	}
22	
23	
24	def get_config(key: str, default: Optional[str] = None) -> str:
25	    """
26	    Get a configuration value from environment variables.
27	
28	    Args:
29	        key: Configuration key
30	        default: Default value if not found in environment
31	
32	    Returns:
33	        Configuration value
34	    """
35	    return os.environ.get(key, default or DEFAULT_CONFIG.get(key, ""))
36	
37	
38	def get_log_level() -> int:
39	    """
40	    Get the configured log level.
41	
42	    Returns:
43	        Log level as a logging module constant
44	    """
45	    level_name = get_config("MCP_LOG_LEVEL", "INFO").upper()
46	    level_map = {
47	        "DEBUG": logging.DEBUG,
48	        "INFO": logging.INFO,
49	        "WARNING": logging.WARNING,
50	        "ERROR": logging.ERROR,
51	        "CRITICAL": logging.CRITICAL,
52	    }
53	    return level_map.get(level_name, logging.INFO)
54	
55	
56	def configure_logging() -> None:
57	    """Configure logging based on environment variables."""
58	    logging.basicConfig(
59	        level=get_log_level(),
60	        format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
61	    )
