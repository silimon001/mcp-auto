15	SCHEDULE_WORKOUT_ENDPOINT = "/workout-service/schedule/{workout_id}"
16	CALENDAR_WEEK_ENDPOINT = "/calendar-service/year/{year}/month/{month}/day/{day}/start/{start}"
17	CALENDAR_MONTH_ENDPOINT = "/calendar-service/year/{year}/month/{month}"
