30	def get_reddit_client() -> praw.Reddit:
31	    """Get configured Reddit client (read-only) from environment."""
32	    client_id = None
33	    client_secret = None
34	    user_agent = None
35	    
36	    # Method 1: Try environment variables
37	    client_id = os.environ.get("REDDIT_CLIENT_ID")
38	    client_secret = os.environ.get("REDDIT_CLIENT_SECRET")
39	    user_agent = os.environ.get("REDDIT_USER_AGENT", "RedditMCP/1.0")
40	    
41	    # Method 2: Try loading from .env file (local development)
42	    if not client_id or not client_secret:
43	        # Find .env file in project root
44	        env_path = Path(__file__).parent.parent / '.env'
45	        if env_path.exists():
46	            load_dotenv(env_path)
47	            client_id = os.getenv("REDDIT_CLIENT_ID")
48	            client_secret = os.getenv("REDDIT_CLIENT_SECRET")
49	            if not user_agent:
50	                user_agent = os.getenv("REDDIT_USER_AGENT", "RedditMCP/1.0")
51	    
52	    if not client_id or not client_secret:
53	        raise ValueError(
54	            "Reddit API credentials not found. Please set REDDIT_CLIENT_ID "
55	            "and REDDIT_CLIENT_SECRET either as OS environment variables or in a .env file"
56	        )
57	    
58	    # Create Reddit instance for read-only access
59	    reddit = praw.Reddit(
60	        client_id=client_id,
61	        client_secret=client_secret,
62	        user_agent=user_agent,
63	        redirect_uri="http://localhost:8080",  # Required even for read-only
64	        ratelimit_seconds=300  # Auto-handle rate limits
65	    )
66	    
67	    # Explicitly enable read-only mode
68	    reddit.read_only = True
69	    
70	    return reddit

