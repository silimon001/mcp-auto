347	    ]
348	
349	
350	def dispatch_tool(name: str) -> Optional[UnityCatalogAiTool]:
351	    """Retrieves the Unity Catalog AI tool function by name.
352	
353	    This function looks up and returns the corresponding function
354	    for a given tool name from the `UNITY_CATALOG_AI_TOOLS` registry.
355	
356	    Args:
357	        name (str): The name of the Unity Catalog AI tool.
358	
359	    Returns:
360	        Optional[UnityCatalogAiFunction]: The function corresponding to
361	        the specified tool name if found, otherwise `None`.
362	    """
363	    return UNITY_CATALOG_AI_TOOLS.get(name)
364	
365	
366	@observe(by=LOGGER, args=[1, 2])
367	def execute_function(
368	    client: UnitycatalogFunctionClient,
369	    name: str,
370	    arguments: dict,
371	) -> list[Content]:
372	    """Executes a registered Unity Catalog function with the given parameters.
373	
374	    This function invokes a function stored in Unity Catalog, passing in the
375	    specified arguments and returning the execution result.
376	
377	    Args:
378	        client (UnitycatalogFunctionClient): The Unity Catalog function client.
379	        name (str): The name of the function to execute (not fully qualified).
380	        arguments (dict): A dictionary of parameters to pass to the function.
381	
382	    Returns:
383	        list[Content]: The output of the function execution, wrapped in a
384	        list of `Content` objects.
385	    """
386	    settings = Settings()
387	    content = client.execute_function(
388	        function_name=f"{settings.uc_catalog}.{settings.uc_schema}.{name}",
389	        parameters=arguments,
390	    ).to_json()
391	    return [
392	        TextContent(
393	            type="text",
394	            text=content,
395	        )
396	    ]
