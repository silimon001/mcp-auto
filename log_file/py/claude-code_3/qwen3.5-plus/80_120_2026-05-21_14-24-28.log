701	@mcp.tool(
702	    description="Execute a Reddit operation with validated parameters",
703	    annotations={"readOnlyHint": False, "openWorldHint": True}
704	)
705	async def execute_operation(
706	    operation_id: Annotated[str, "Operation to execute"],
707	    parameters: Annotated[Dict[str, Any], "Parameters matching the schema"],
708	    ctx: Context = None
709	) -> Dict[str, Any]:
710	    """
711	    LAYER 3: Execute a Reddit operation.
712	    Only use after getting schema from get_operation_schema.
713	    """
714	    # Phase 1: Accept context but don't use it yet
715	
716	    # Normalize common parameter aliases
717	    param_aliases = {"subreddit": "subreddit_name"}
718	    for alias, canonical in param_aliases.items():
