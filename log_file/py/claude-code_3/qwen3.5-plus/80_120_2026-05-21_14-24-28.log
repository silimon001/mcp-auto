246	    @mcp.tool()
247	    async def mem0_search_memory(
248	        query: str,
249	        user_id: str,  # Now required
250	        agent_id: str = "",  # Required with default
251	        run_id: str = "",  # Required with default
252	        filters: str = "",  # Required with default (JSON string)
253	        threshold: float = 0.0,  # Required with default
254	        enable_graph: bool = False,
255	        memory_duration: str = "",  # New parameter for filtering by duration type
256	        memory_type: str = "",  # New parameter for filtering by memory type
257	    ) -> dict:
258	        """Searches memories in Mem0. Requires user_id and query.
259	        Parameters like agent_id, run_id, filters, threshold have defaults if not provided.
260	        
261	        For advanced filtering:
262	        - memory_duration: Filter by "short_term" or "long_term"
263	        - memory_type: Filter by "conversation", "working", "attention", "episodic", "semantic", or "procedural"
264	        
265	        Filters is a JSON string representing a dictionary (default "" ignored).
266	        Threshold is a float for minimum similarity score (default 0.0 ignored).
267	        Optional: Set enable_graph=True to use graph retrieval.
268	        Example Filters: '{\\"categories\\": [\\"work\\"], \\"metadata\\": {\\"project\\": \\"xyz\\"}}'"""
269	        
270	        logging.info(f"Search request: user={user_id}, agent={agent_id}, run={run_id}, filters={filters}, memory_duration={memory_duration}, memory_type={memory_type}, threshold={threshold}, enable_graph={enable_graph}, query='{query[:50]}...'")
271	        
272	        if not mem0_instance:
273	            logging.error("Mem0 instance not initialized.")
274	            return {"status": "error", "message": "Mem0 instance failed to initialize."}
275	
276	        try:
277	            search_args = {"user_id": user_id}
278	            filter_dict = {}
279	            
280	            # Parse filters if provided and not the default empty string
281	            if filters:
282	                try:
283	                    parsed_filters = json.loads(filters)
284	                    if isinstance(parsed_filters, dict):
285	                        filter_dict.update(parsed_filters)
286	                        logging.info(f"Applied parsed filters: {parsed_filters}")
287	                    else:
288	                        logging.warning(f"Parsed filters is not a dictionary (type: {type(parsed_filters)}), discarding filters: {filters}")
289	                except json.JSONDecodeError as json_err:
290	                    logging.error(f"Failed to parse filters JSON string: {filters}. Error: {json_err}")
291	                    logging.warning("Proceeding without parsed filters due to parsing error.")
292	            
293	            # Add memory type filters if provided
294	            if memory_duration:
295	                filter_dict["metadata.memory_duration"] = memory_duration
296	                logging.info(f"Adding memory_duration filter: {memory_duration}")
297	                
298	            if memory_type:
299	                filter_dict["metadata.memory_type"] = memory_type
300	                logging.info(f"Adding memory_type filter: {memory_type}")
301	            
302	            # Only add filters to search args if we have any
303	            if filter_dict:
304	                search_args["filters"] = filter_dict
305	                logging.info(f"Final combined filters: {filter_dict}")
306	
307	            # --- Apply workaround for other originally optional parameters ---
308	            if agent_id: # Check if not default ""
309	                search_args["agent_id"] = agent_id
310	                logging.info(f"Using agent_id: {agent_id}")
311	            if run_id: # Check if not default ""
312	                search_args["run_id"] = run_id
313	                logging.info(f"Using run_id: {run_id}")
314	            if threshold != 0.0: # Check if not default 0.0
315	                search_args["threshold"] = threshold
316	                logging.info(f"Applying threshold: {threshold}")
317	
318	            # --- Graph handling ---
319	            if enable_graph:
320	                search_args["enable_graph"] = True
321	                search_args["output_format"] = "v1.1"
322	                logging.info(f"Calling mem0_instance.search (GRAPH ENABLED) with query='{query}', args={search_args}")
323	            else:
324	                 logging.info(f"Calling mem0_instance.search (GRAPH DISABLED) with query='{query}', args={search_args}")
325	
326	            response = await mem0_instance.search(query, **search_args)
327	            logging.info(f"Mem0 search response: {response}")
328	            return {"status": "success", "results": response}
329	        except Exception as e:
330	            logging.error(f"Error searching memory: {e}")
331	            logging.error(traceback.format_exc())
332	            return {"status": "error", "message": str(e)}
