loop 9 | Tool=Write, Args={"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/989535382_jianzhichun_abaqus-mcp-server/stub_windows_modules.py","content":"\"\"\"\nStub modules for Windows-only packages (pywinauto, pygetwindow, pywin32)\nfor Linux compatibility. These allow the MCP server to start and register\nits tools, even though the actual GUI automation will not work on Linux.\n\"\"\"\n\nimport sys\n\ndef _create_stub(name, attrs=None):\n    \"\"\"Create a stub module with given name and attributes.\"\"\"\n    import types\n    mod = types.ModuleType(name)\n    mod.__file__ = f\"<stub:{name}>\"\n    if attrs:\n        for k, v in attrs.items():\n            setattr(mod, k, v)\n    sys.modules[name] = mod\n    return mod\n\ndef _create_mock_class():\n    \"\"\"Create a class that is falsy (bool return False) so `if not x` works.\"\"\"\n    class FalsyMock:\n        def __bool__(self):\n            return False\n        def __nonzero__(self):\n            return False\n        def __getattr__(self, name):\n            return self\n        def __call__(self, *args, **kwargs):\n            return self\n    return FalsyMock\n\ndef install_stubs():\n    \"\"\"Install all Windows-only stubs into sys.modules.\"\"\"\n    Mock = _create_mock_class()\n\n    # pywin32\n    _create_stub(\"pywin32\")\n    _create_stub(\"win32process\", {\n        \"GetWindowThreadProcessId\": Mock(),\n    })\n\n    # pygetwindow\n    _create_stub(\"pygetwindow\", {\n        \"getWindowsWithTitle\": Mock(),\n    })\n    _create_stub(\"gw\", sys.modules[\"pygetwindow\"])\n\n    # pywinauto\n    _create_stub(\"pywinauto\")\n\n    # pywinauto.timings\n    _create_stub(\"pywinauto.timings\", {\n        \"Timings\": Mock(),\n        \"TimeoutError\": Exception,\n    })\n\n    # pywinauto.base_wrapper\n    _create_stub(\"pywinauto.base_wrapper\", {\n        \"BaseWrapper\": Mock,\n    })\n\n    # pywinauto.controls\n    _create_stub(\"pywinauto.controls\")\n\n    # pywinauto.controls.uia_controls\n    _create_stub(\"pywinauto.controls.uia_controls\", {\n        \"WindowSpecification\": Mock,\n        \"EditWrapper\": Mock,\n        \"ButtonWrapper\": Mock,\n    })\n\n    # pywinauto.Application\n    app_mod = _create_stub(\"pywinauto.application\")\n    # We need Application to be callable\n    ApplicationMock = Mock\n    setattr(app_mod, \"Application\", ApplicationMock)\n"}
loop 10 | Tool=Write, Args={"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/989535382_jianzhichun_abaqus-mcp-server/run_server.py","content":"#!/usr/bin/env python3\n\"\"\"\nWrapper script for running abaqus-mcp-server on Linux.\nInstalls Windows-only stubs before importing the MCP server.\n\"\"\"\nimport os\nimport sys\n\n# Ensure stubs are importable\nSCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))\nsys.path.insert(0, SCRIPT_DIR)\n\nfrom stub_windows_modules import install_stubs\ninstall_stubs()\n\n# Now import and run the MCP server\nfrom mcp_server import mcp\n\nif __name__ == \"__main__\":\n    mcp.run()\n"}
