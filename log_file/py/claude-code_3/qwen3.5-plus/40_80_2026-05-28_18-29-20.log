1633	    @server.call_tool()
1634	    async def handle_call_tool(
1635	        name: str, arguments: dict | None
1636	    ) -> list[types.TextContent | types.ImageContent | types.EmbeddedResource]:
1637	
1638	        if name == "send-email":
1639	            recipient = arguments.get("recipient_id")
1640	            if not recipient:
1641	                raise ValueError("Missing recipient parameter")
1642	            subject = arguments.get("subject")
1643	            if not subject:
1644	                raise ValueError("Missing subject parameter")
1645	            message = arguments.get("message")
1646	            if not message:
1647	                raise ValueError("Missing message parameter")
1648	                
1649	            # Extract subject and message content
1650	            email_lines = message.split('\n')
1651	            if email_lines[0].startswith('Subject:'):
1652	                subject = email_lines[0][8:].strip()
1653	                message_content = '\n'.join(email_lines[1:]).strip()
1654	            else:
1655	                message_content = message
1656	                
1657	            send_response = await gmail_service.send_email(recipient, subject, message_content)
1658	            
1659	            if send_response["status"] == "success":
1660	                response_text = f"Email sent successfully. Message ID: {send_response['message_id']}"
1661	            else:
1662	                response_text = f"Failed to send email: {send_response['error_message']}"
1663	            return [types.TextContent(type="text", text=response_text)]
1664	
1665	        if name == "get-unread-emails":
1666	                
1667	            unread_emails = await gmail_service.get_unread_emails()
1668	            return [types.TextContent(type="text", text=str(unread_emails),artifact={"type": "json", "data": unread_emails} )]
1669	        
1670	        if name == "read-email":
1671	            email_id = arguments.get("email_id")
1672	            if not email_id:
1673	                raise ValueError("Missing email ID parameter")
1674	                
1675	            retrieved_email = await gmail_service.read_email(email_id)
1676	            return [types.TextContent(type="text", text=str(retrieved_email),artifact={"type": "dictionary", "data": retrieved_email} )]
1677	        if name == "open-email":
1678	            email_id = arguments.get("email_id")
1679	            if not email_id:
1680	                raise ValueError("Missing email ID parameter")
1681	                
1682	            msg = await gmail_service.open_email(email_id)
1683	            return [types.TextContent(type="text", text=str(msg))]
1684	        if name == "trash-email":
1685	            email_id = arguments.get("email_id")
1686	            if not email_id:
1687	                raise ValueError("Missing email ID parameter")
1688	                
1689	            msg = await gmail_service.trash_email(email_id)
1690	            return [types.TextContent(type="text", text=str(msg))]
1691	        if name == "mark-email-as-read":
1692	            email_id = arguments.get("email_id")
1693	            if not email_id:
1694	                raise ValueError("Missing email ID parameter")
1695	                
1696	            msg = await gmail_service.mark_email_as_read(email_id)
1697	            return [types.TextContent(type="text", text=str(msg))]
1698	        elif name == "create-draft":
1699	            recipient_id = arguments.get("recipient_id")
1700	            subject = arguments.get("subject")
1701	            message = arguments.get("message")
1702	            if not recipient_id or not subject or not message:
1703	                raise ValueError("Missing required parameters for creating a draft")
1704	            draft_response = await gmail_service.create_draft(recipient_id, subject, message)
1705	            if draft_response["status"] == "success":
1706	                response_text = f"Draft created successfully. Draft ID: {draft_response['draft_id']}"
1707	            else:
1708	                response_text = f"Failed to create draft: {draft_response['error_message']}"
1709	            return [types.TextContent(type="text", text=response_text)]
1710	        elif name == "list-drafts":
1711	            drafts = await gmail_service.list_drafts()
1712	            return [types.TextContent(type="text", text=str(drafts), artifact={"type": "json", "data": drafts})]
1713	        elif name == "list-labels":
