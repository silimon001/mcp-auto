24	def convert_int_keys_to_str(obj):
25	    """
26	    Recursively convert integer keys to strings, ObjectIds to strings, and datetime objects to ISO strings
27	    in dictionaries to avoid JSON serialization errors.
28	    This is needed because Metasploit RPC can return data with integer keys, MongoDB returns ObjectIds,
29	    and database queries can return datetime objects.
30	    """
31	    from datetime import datetime
32	
33	    # Handle ObjectId conversion
34	    if hasattr(obj, '__class__') and obj.__class__.__name__ == 'ObjectId':
35	        return str(obj)
36	    # Handle datetime conversion
37	    elif isinstance(obj, datetime):
38	        return obj.isoformat()
39	    elif isinstance(obj, dict):
40	        result = {}
41	        for k, v in obj.items():
42	            # Convert ObjectId keys to strings
43	            if hasattr(k, '__class__') and k.__class__.__name__ == 'ObjectId':
