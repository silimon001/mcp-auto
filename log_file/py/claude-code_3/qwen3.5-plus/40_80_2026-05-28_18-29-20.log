55	async def send_email(email_message: EmailMessage):
56	    """Send email asynchronously.
57	
58	    Args:
59	        email_message (EmailMessage): Email message object, including email content, recipients, etc.
60	
61	    Returns:
62	        str: Returns the message sent by email
63	    """
64	    smtp_server, smtp_port = get_smtp_info()
65	    if not (smtp_server and smtp_port):
66	        raise ValueError("Please check that your email address is entered correctly, or it is not a supported email service")
67	    logger.info(f"send email message: {email_message.model_json_schema()}")
68	    # Build email content
69	    message = MIMEMultipart()
70	    message["From"] = sender
71	    message["To"] = ", ".join(email_message.receiver)  # Convert the recipient list to a comma-delimited string
72	    message["Subject"] = email_message.subject
73	
74	    message.attach(MIMEText(email_message.body, "plain"))
75	
76	    if isinstance(email_message.attachments, str):
77	        try:
78	            email_message.attachments = email_message.attachments.replace("\\", "\\\\")
79	            attachments = json.loads(email_message.attachments)
80	        except Exception as e:
81	            raise ValueError(f"email message attachments error: {e}")
82	        else:
83	            email_message.attachments = attachments
84	
85	    # Attach attachments to email messages
86	    if email_message.attachments:
87	        for file in email_message.attachments:
88	            absolute_path = os.path.join(ATTACHMENT_FOLDER, file)
89	            if os.path.isfile(absolute_path):
90	                message.attach(attach_file(absolute_path))
91	            else:
92	                raise ValueError(f"{absolute_path} not exists")
93	
94	    try:
95	        # Choose correct SMTP class based on port
96	        smtp_class = smtplib.SMTP_SSL if smtp_port == 465 else smtplib.SMTP
97	        
98	        # Create SMTP connection with timeout
99	        with smtp_class(smtp_server, smtp_port, timeout=10) as server:
100	            if smtp_port != 465:
101	                server.starttls()  # Enable TLS for non-SSL connections
102	            
103	            # Login and send
104	            server.login(sender, password)
105	            server.send_message(email_message)
106	            
107	        return f"Email sent successfully from {sender}"
108	
109	    except smtplib.SMTPAuthenticationError:
110	        raise ValueError("Authentication failed - check username and password")
111	    
112	    except smtplib.SMTPServerDisconnected:
113	        raise ConnectionError("Server disconnected unexpectedly")
114	    
115	    except smtplib.SMTPException as e:
116	        raise smtplib.SMTPException(f"SMTP error occurred: {str(e)}")
117	    
118	    except TimeoutError:
119	        raise ConnectionError("Connection timed out")
120	    
121	    except Exception as e:
122	        raise Exception(f"Unexpected error: {str(e)}")
