1	#!/usr/bin/env python3
2	"""
3	Zoho Books MCP Integration Server
4	
5	A server that exposes tools for interacting with Zoho Books via the
6	MCP protocol. Supports STDIO, HTTP/SSE, and WebSocket transports.
7	"""
8	
9	import sys
10	import logging
11	import argparse
12	from typing import Dict, Any
13	
14	from mcp.server.fastmcp import FastMCP
15	
16	from .config import settings
17	from . import tools
18	from .resources import register_resources
19	from .prompts import register_prompts
20	from .transport import (
21	    setup_argparser,
22	    configure_transport_from_args,
23	    initialize_transport,
24	    TransportConfigurationError,
25	    TransportInitializationError
26	)
27	from .errors import ZohoMCPError, handle_exception, AuthenticationError
28	from .logging import setup_logging, request_logging_context
29	from .auth_flow import run_oauth_flow
30	
31	# Initialize logging early in startup process
32	setup_logging(
33	    level=settings.LOG_LEVEL,
34	    log_file=settings.LOG_FILE_PATH,
35	    use_json=settings.LOG_FORMAT_JSON
36	)
37	logger = logging.getLogger("zoho_mcp")
38	
39	
40	def register_tools(mcp_server: FastMCP) -> None:
41	    """
42	    Register all available tools with the MCP server.
43	
44	    Args:
45	        mcp_server: The FastMCP server instance
46	    """
47	    # Register contact management tools
48	    mcp_server.add_tool(tools.list_contacts)
49	    mcp_server.add_tool(tools.create_customer)
50	    mcp_server.add_tool(tools.create_vendor)
51	    mcp_server.add_tool(tools.get_contact)
52	    mcp_server.add_tool(tools.delete_contact)
53	    mcp_server.add_tool(tools.update_contact)
54	    mcp_server.add_tool(tools.email_statement)
55	
56	    # Register invoice management tools
57	    mcp_server.add_tool(tools.list_invoices)
58	    mcp_server.add_tool(tools.create_invoice)
59	    mcp_server.add_tool(tools.get_invoice)
60	    mcp_server.add_tool(tools.email_invoice)
61	    mcp_server.add_tool(tools.mark_invoice_as_sent)
62	    mcp_server.add_tool(tools.void_invoice)
63	    mcp_server.add_tool(tools.record_payment)
64	    mcp_server.add_tool(tools.send_payment_reminder)
65	
66	    # Register expense management tools
67	    mcp_server.add_tool(tools.list_expenses)
68	    mcp_server.add_tool(tools.create_expense)
69	    mcp_server.add_tool(tools.get_expense)
70	    mcp_server.add_tool(tools.update_expense)
71	    mcp_server.add_tool(tools.categorize_expense)
72	    mcp_server.add_tool(tools.upload_receipt)
73	
74	    # Register item management tools
75	    mcp_server.add_tool(tools.list_items)
76	    mcp_server.add_tool(tools.create_item)
77	    mcp_server.add_tool(tools.get_item)
78	    mcp_server.add_tool(tools.update_item)
79	
80	    # Register sales order management tools
81	    mcp_server.add_tool(tools.list_sales_orders)
82	    mcp_server.add_tool(tools.create_sales_order)
83	    mcp_server.add_tool(tools.get_sales_order)
84	    mcp_server.add_tool(tools.update_sales_order)
85	    mcp_server.add_tool(tools.convert_to_invoice)
86	
87	    # These tools will be registered in future tasks
88	    # ...
89	
90	
91	def configure_server(args: argparse.Namespace) -> Dict[str, Any]:
92	    """
93	    Configure server settings based on command line arguments.
94	
95	    Args:
96	        args: Command-line arguments
97	
98	    Returns:
99	        Dictionary of server configuration settings
100	    """
101	    # Override logging level if specified in command line
102	    if hasattr(args, 'log_level') and args.log_level:
103	        log_level = args.log_level
104	        logging.getLogger().setLevel(getattr(logging, log_level))
105	        logger.info(f"Log level set to {log_level}")
106	
107	    # Configure CORS for HTTP transport
108	    if hasattr(args, 'disable_cors') and args.disable_cors:
109	        msg = "CORS is disabled. This is not recommended for production."
110	        logger.warning(msg)
111	
112	    # Prepare server configuration
113	    server_config = {
114	        "name": "zoho-books",
115	        "version": "1.0.0",
116	    }
117	
118	    return server_config
119	
120	
121	def main() -> None:
122	    """
123	    Main entry point for the Zoho Books MCP server.
124	    Sets up FastMCP, registers tools, and starts the appropriate transport.
125	
126	    If the --setup-oauth flag is provided, runs the OAuth setup flow instead
127	    of starting the server.
128	    """
129	    with request_logging_context(request_id="server-startup"):
130	        try:
131	            # Parse command-line arguments
132	            parser = setup_argparser()
133	            args = parser.parse_args()
134	
135	            # Check for OAuth setup early in the process
136	            if hasattr(args, 'setup_oauth') and args.setup_oauth:
137	                logger.info("Starting OAuth setup flow")
138	                print("\n=== Zoho Books OAuth Setup ===\n")
139	
140	                # Get the port from arguments
141	                oauth_port = getattr(args, 'oauth_port', 8099)
142	
143	                # Run the OAuth flow to obtain a refresh token
144	                try:
145	                    _ = run_oauth_flow(port=oauth_port)
146	                    logger.info("OAuth setup completed successfully")
147	                    print("\n✅ OAuth setup completed successfully!")
148	                    print("Refresh token has been saved to configuration.")
149	
150	                    # Exit with success code after OAuth setup completes
151	                    sys.exit(0)
152	                except AuthenticationError as e:
153	                    logger.error(f"OAuth setup failed: {str(e)}")
154	                    print(f"\n❌ OAuth setup failed: {str(e)}")
155	
156	                    if hasattr(e, 'details') and e.details:
157	                        logger.debug(f"Error details: {e.details}")
158	
159	                    # Exit with error code
160	                    sys.exit(1)
161	
162	            # Log server startup (only happens if not running OAuth setup)
163	            logger.info("Starting Zoho Books MCP Integration Server")
164	
165	            # Configure server settings
166	            server_config = configure_server(args)
167	
168	            # Initialize the FastMCP server
169	            logger.info(
170	                f"Initializing FastMCP server with config: {server_config}"
171	            )
172	            mcp_server = FastMCP(**server_config)
173	
174	            # Register all tools
175	            logger.info("Registering MCP tools")
176	            register_tools(mcp_server)
177	
178	            # Register all resources
179	            logger.info("Registering MCP resources")
180	            register_resources(mcp_server)
181	
182	            # Register all prompt templates
183	            logger.info("Registering MCP prompt templates")
184	            register_prompts(mcp_server)
185	
186	            # Configure and initialize the appropriate transport
187	            transport_type, config = configure_transport_from_args(args)
188	            logger.info(f"Configured transport: {transport_type}")
189	
190	            # Enable SSL if configured and not using STDIO
191	            if (
192	                transport_type != "stdio" and
193	                settings.ENABLE_SECURE_TRANSPORT and
194	                settings.SSL_CERT_PATH and
195	                settings.SSL_KEY_PATH
196	            ):
197	                logger.info("Enabling secure transport (SSL)")
198	                config["ssl_certfile"] = settings.SSL_CERT_PATH
199	                config["ssl_keyfile"] = settings.SSL_KEY_PATH
200	
201	            # Start the transport
202	            logger.info(f"Initializing {transport_type} transport")
203	            initialize_transport(mcp_server, transport_type, config)
204	
205	        except TransportConfigurationError as e:
206	            logger.error(f"Transport configuration error: {str(e)}")
207	            # Use handle_exception for consistent error format
208	            error_details = handle_exception(e)
209	            logger.debug(f"Error details: {error_details}")
210	            sys.exit(1)
211	        except TransportInitializationError as e:
212	            logger.error(f"Transport initialization error: {str(e)}")
213	            error_details = handle_exception(e)
214	            logger.debug(f"Error details: {error_details}")
215	            sys.exit(1)
216	        except ZohoMCPError as e:
217	            # For our custom errors, log with the built-in error details
218	            logger.error(f"{e.__class__.__name__}: {str(e)}")
219	            error_details = handle_exception(e)
220	            logger.debug(f"Error details: {error_details}")
221	            sys.exit(1)
222	        except Exception as e:
223	            # For unexpected errors, log the full traceback in debug mode
224	            logger.error(f"Unexpected error: {str(e)}")
225	            error_details = handle_exception(e, log_exception=True)
226	            sys.exit(1)
227	
228	
229	if __name__ == "__main__":
230	    main()
231	

