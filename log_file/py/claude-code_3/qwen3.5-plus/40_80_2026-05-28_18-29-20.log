426	@mcp.tool()
427	@requires_graph_auth
428	async def advanced_mail_search(ctx: Context, search_query: Any) -> str:
429	    """
430	    Search for emails using advanced criteria in JSON format
431	
432	    Args:
433	        ctx: FastMCP Context
434	        search_query: JSON string with search parameters. Valid fields include:
435	            subject: Text to match in the subject line
436	            body: Text to match in the email body
437	            from_email: Sender's email address or display name
438	            to_email: Recipient's email address or display name
439	            cc_email: CC recipient's email address or display name
440	            has_attachments: Boolean (true/false) whether the email has attachments
441	            is_read: Boolean (true/false) for read status of the email
442	            folder_id: ID of the folder to search in (default: inbox)
443	            count: Maximum number of results to return (default: 50)
444	
445	    Example: {"subject": "Meeting", "from_email": "john", "is_read": false}
446	
447	    Returns:
448	        A list of matching emails
449	    """
450	    graph = ctx.request_context.lifespan_context.graph
451	
452	    try:
453	        # Parse the JSON query
454	        if isinstance(search_query, dict):
455	            query_dict = search_query
456	        else:
457	            # Try to parse as JSON string
458	
459	            query_dict = json.loads(search_query)
460	
461	        # Create the mail query
462	        query = MailQuery(
463	            subject=query_dict.get('subject'),
464	            body=query_dict.get('body'),
465	            from_email=query_dict.get('from_email'),
466	            to_email=query_dict.get('to_email'),
467	            cc_email=query_dict.get('cc_email'),
468	            has_attachments=query_dict.get('has_attachments'),
469	            is_read=query_dict.get('is_read'),
470	            folder_id=query_dict.get('folder_id', 'inbox'),
471	            count=query_dict.get('count', 20)
472	        )
473	
474	        # Execute the search
475	        messages = await graph.mail.search_mail(query)
476	
477	        # Format and return results
478	        return format_email_headers(messages)
479	
480	    except json.JSONDecodeError:
481	        return "Error: Invalid JSON format. Please provide a valid JSON object with search criteria."
482	    except Exception as e:
483	        return f"Error executing search: {str(e)}"
484	
