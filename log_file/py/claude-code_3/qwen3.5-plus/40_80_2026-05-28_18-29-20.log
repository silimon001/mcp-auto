31	    def _connect_to_resolve(self) -> None:
32	        """
33	        Connect to DaVinci Resolve based on the current operating system.
34	
35	        This function adds the appropriate paths to sys.path and imports the
36	        DaVinciResolveScript module to establish a connection to Resolve.
37	        """
38	        # Determine the appropriate path based on the operating system
39	        if platform.system() == "Windows":
40	            resolve_script_dir = os.path.join(
41	                os.environ.get("PROGRAMDATA", "C:\\ProgramData"),
42	                "Blackmagic Design",
