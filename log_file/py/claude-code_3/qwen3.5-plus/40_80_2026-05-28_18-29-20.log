50	            # Add the API directory to the system path
51	            if script_api_path not in sys.path:
52	                sys.path.append(script_api_path)
53	
54	            # Import the DaVinciResolveScript module
55	            try:
56	                import DaVinciResolveScript as dvr_script
57	
