624	            stderr_queue = queue.Queue()
625	
626	            # Thread function to read from stdout
627	            def read_stdout():
628	                for line in iter(process.stdout.readline, ''):
629	                    stdout_queue.put(('stdout', line.strip()))
630	                stdout_queue.put(('stdout', None))  # Signal end
631	
632	            # Thread function to read from stderr
633	            def read_stderr():
634	                for line in iter(process.stderr.readline, ''):
635	                    stderr_queue.put(('stderr', line.strip()))
636	                stderr_queue.put(('stderr', None))  # Signal end
637	
638	            # Start reading threads
639	            stdout_thread = threading.Thread(target=read_stdout)
640	            stderr_thread = threading.Thread(target=read_stderr)
641	            stdout_thread.daemon = True
642	            stderr_thread.daemon = True
643	            stdout_thread.start()
644	            stderr_thread.start()
645	
646	            # Read output line by line in real-time (matching working test script)
647	            start_time_scan = time.time()
648	            timeout = 60  # 1 minute timeout like working version
649	            last_status_time = start_time_scan
650	            stdout_done = False
651	            stderr_done = False
