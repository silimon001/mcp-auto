630	    body = body_with_html_tags # Parameter name required to keep Claude reverting to plain text default
631	
632	    try:
633	        # Parse recipient lists
634	        to_list = [email.strip() for email in to_recipients.split(',') if email.strip()]
635	        cc_list = [email.strip() for email in cc_recipients.split(',') if email.strip()] if cc_recipients else None
636	        bcc_list = [email.strip() for email in bcc_recipients.split(',') if email.strip()] if bcc_recipients else None
637	
638	        result = await graph.mail.create_new_email_for_draft_or_send(
639	            to_recipients=to_list,
640	            subject=subject,
641	            body=body,
642	            cc_recipients=cc_list,
643	            bcc_recipients=bcc_list,
644	            save_as_draft=save_as_draft
645	        )
646	
647	        if save_as_draft:
648	            return f"Email saved to Drafts folder with subject: '{subject}'"
649	        else:
650	            return f"Email sent successfully to: {to_recipients}"
651	
652	    except Exception as e:
653	        return f"Error composing email: {str(e)}"
