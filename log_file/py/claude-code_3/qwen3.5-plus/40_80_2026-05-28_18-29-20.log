271	# Sticky repo root (survives MCP server restarts)
272	# ---------------------------------------------------------------------
273	_LAST_REPO_ROOT: Optional[Path] = None
274	_STICKY_FILE = Path(os.environ.get("GAIT_MCP_STICKY_FILE", "~/.gait_mcp_root")).expanduser()
275	
276	def _load_sticky_root() -> Optional[Path]:
277	    try:
278	        if _STICKY_FILE.is_file():
279	            txt = _STICKY_FILE.read_text(encoding="utf-8").strip()
280	            if txt:
281	                p = Path(txt).expanduser().resolve()
282	                if p.exists():
283	                    return p
284	    except Exception:
285	        pass
286	    return None
287	
288	def _persist_sticky_root(p: Path) -> None:
289	    try:
290	        _STICKY_FILE.parent.mkdir(parents=True, exist_ok=True)
291	        _STICKY_FILE.write_text(str(p.resolve()), encoding="utf-8")
292	    except Exception:
293	        # never fail tool calls because of this
294	        pass
295	
296	def _set_last_root(p: Path) -> None:
297	    global _LAST_REPO_ROOT
298	    _LAST_REPO_ROOT = p.resolve()
299	    _persist_sticky_root(_LAST_REPO_ROOT)
300	
301	# Load once at import time so restarts remember the last repo
302	_LAST_REPO_ROOT = _load_sticky_root()
303	
304	def _discover_repo_from(start: Path) -> Optional[GaitRepo]:
305	    cur = start.expanduser().resolve()
306	    for p in (cur, *cur.parents):
307	        if (p / ".gait").is_dir():
308	            _set_last_root(p)
309	            return GaitRepo(root=p)
310	    return None
311	
312	def _try_repo(path: Optional[str] = None) -> Tuple[Optional[GaitRepo], Optional[Dict[str, Any]]]:
313	    try:
314	        candidates: List[Path] = []
315	
316	        # 1) explicit path always wins
317	        if path is not None and str(path).strip():
318	            candidates.append(Path(path).expanduser().resolve())
319	        else:
320	            # 2) in-memory sticky
321	            if _LAST_REPO_ROOT is not None:
322	                candidates.append(_LAST_REPO_ROOT)
323	
324	            # 3) persisted sticky (covers server restarts)
325	            sticky = _load_sticky_root()
326	            if sticky is not None:
327	                candidates.append(sticky)
328	
329	            # 4) cwd
330	            candidates.append(Path.cwd())
331	
332	            # 5) home as last resort
333	            candidates.append(Path.home())
334	
335	        for start in candidates:
336	            repo = _discover_repo_from(start)
337	            if repo is not None:
338	                return (repo, None)
339	
340	        return (
341	            None,
342	            _err(
343	                "GAIT repo not found. Run /gait:init inside a project folder.",
344	                detail=f"candidates={[str(c.expanduser().resolve()) for c in candidates]} cwd={os.getcwd()} sticky={str(_LAST_REPO_ROOT) if _LAST_REPO_ROOT else ''}",
345	            ),
346	        )
347	
348	    except Exception as e:
349	        return (None, _err("GAIT repo not found. Run /gait:init inside a project folder.", detail=str(e)))
350	
