22	async def _health(_request: Request) -> JSONResponse:
23	    """Liveness probe used by Docker HEALTHCHECK and any external monitor."""
24	    return JSONResponse({"status": "ok", "version": __version__})
25	
26	
27	def _configure_logging(level: str) -> None:
28	    logging.basicConfig(
29	        level=level.upper(),
30	        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
31	    )
