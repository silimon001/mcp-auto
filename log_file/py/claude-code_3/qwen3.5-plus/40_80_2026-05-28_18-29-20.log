424	@mcp_tool
425	@mcp.tool()
426	def gait_branch(
427	    name: str,
428	    from_commit: Optional[str] = None,
429	    inherit_memory: bool = True,
430	    force: bool = False,
431	) -> Dict[str, Any]:
432	    """Create a new branch from an optional commit. Optionally inherit pinned memory. Use force=true to reset if exists.
433	
434	    Args:
435	        name: Name of the branch to create
436	        from_commit: Optional commit to branch from
437	        inherit_memory: Whether to inherit pinned memory from current branch
438	        force: If true, reset the branch if it already exists
439	    """
440	    repo, err = _try_repo()
441	    if err:
442	        return err
443	    assert repo is not None
444	
445	    try:
446	        repo.create_branch(name, from_commit=from_commit, inherit_memory=inherit_memory)
447	        return {"ok": True, "created": True, "branch": name}
448	    except FileExistsError:
449	        if not force:
450	            return {"ok": True, "created": False, "branch": name, "note": "already exists (use force=true to reset)"}
451	
452	        target = from_commit if from_commit is not None else repo.head_commit_id()
453	        repo.write_ref(name, target or "")
454	        if inherit_memory:
455	            repo.write_memory_ref(repo.read_memory_ref(repo.current_branch()), name)
456	
457	        return {"ok": True, "created": False, "reset": True, "branch": name, "head": target or ""}
458	
