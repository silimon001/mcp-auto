499	@mcp_tool
500	@mcp.tool()
501	def gait_log(limit: int = 20) -> Dict[str, Any]:
502	    """List recent commits on the current branch (first-parent walk).
503	
504	    Args:
505	        limit: Maximum number of commits to return (default: 20)
506	    """
507	    repo, err = _try_repo()
508	    if err:
509	        return err
510	    assert repo is not None
511	
512	    commits = []
513	    for c in walk_commits(repo, limit=limit):
514	        cid = c["_id"]
515	        parents = c.get("parents") or []
516	        commits.append(
517	            {
518	                "commit": short_oid(cid),
519	                "id": cid,
520	                "created_at": c.get("created_at") or "",
521	                "kind": c.get("kind") or "",
522	                "message": c.get("message") or "",
523	                "parents": [short_oid(x) for x in parents],
524	                "turns": len(c.get("turn_ids") or []),
525	                "merge": len(parents) > 1,
526	            }
527	        )
528	    return {"ok": True, "branch": repo.current_branch(), "commits": commits}
