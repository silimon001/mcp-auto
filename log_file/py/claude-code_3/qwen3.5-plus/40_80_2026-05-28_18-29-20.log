607	async def compose_new_email(ctx: Context,
608	                            to_recipients: str,
609	                            subject: Optional[str] = None,
610	                            body_with_html_tags: Optional[str] = "None",
611	                            cc_recipients: Optional[str] = "",
612	                            bcc_recipients: Optional[str] = "",
613	                            save_as_draft: Optional[bool] = True) -> str:
614	    """
615	    Compose a new email with html formatting and either send it or save as draft
616	
617	    Args:
618	        ctx: FastMCP Context
619	        to_recipients: Comma-separated list of email addresses
620	        subject: Subject line of the email
621	        body_with_html_tags: Content of the email (default HTML formatting)
622	        cc_recipients: Comma-separated list of CC email addresses (optional)
623	        bcc_recipients: Comma-separated list of BCC email addresses (optional)
624	        save_as_draft: If true, saves to Drafts folder; if false, sends immediately
625	
