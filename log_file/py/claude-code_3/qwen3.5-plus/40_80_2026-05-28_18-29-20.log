945	@mcp.tool()
946	@requires_graph_auth
947	async def create_calendar_event(ctx: Context,
948	                                subject: Optional[str],
949	                                start_datetime: str,
950	                                end_datetime: str,
951	                                body_with_html_tags: Optional[str] = "",
952	                                location: Optional[str] = None,
953	                                is_online_meeting: Optional[bool] = False,
954	                                attendees: Optional[str] = "") -> str:
955	    """
956	    Create a new calendar event with html formatting in body
957	
958	    Args:
959	        ctx: FastMCP Context
960	        subject: Subject of the event
961	        start_datetime: Start time in format "YYYY-MM-DDTHH:MM:SS"
962	        end_datetime: End time in format "YYYY-MM-DDTHH:MM:SS"
963	        body_with_html_tags: Body content of the event (default should be HTML); if the event is a meeting, language should make sense for both parties (i.e. instructions should be for everyone from neutral person)
964	        location: Optional location name
965	        is_online_meeting: Whether to make this a Teams online meeting
966	        attendees: Optional comma-separated list of attendee emails
967	
968	    Returns:
969	        A confirmation message with the created event details
970	    """
971	    graph = ctx.request_context.lifespan_context.graph
972	    body = body_with_html_tags # Parameter name required to keep Claude reverting to plain text default
973	
974	    try:
975	        # Parse attendees if provided
976	        attendee_list = None
977	        if attendees:
978	            attendee_list = []
979	            for email in attendees.split(','):
980	                email = email.strip()
981	                if email:
982	                    attendee_list.append({"email": email})
983	
984	        # Create the event
985	        result = await graph.calendar.create_event(
986	            subject=subject,
987	            body=body or f"<p>{subject}</p>",  # Default to subject if body is empty
988	            start_datetime=start_datetime,
989	            end_datetime=end_datetime,
990	            location=location,
991	            is_online_meeting=is_online_meeting,
992	            attendees=attendee_list
993	        )
994	
995	        # Get formatted event details to return
996	        from mcpserver.calendar_formatting import format_calendar_event
997	        formatted_event = format_calendar_event(result)
998	
999	        return f"Event created successfully:\n\n{formatted_event}"
1000	
1001	    except Exception as e:
1002	        return f"Error creating calendar event: {str(e)}"
