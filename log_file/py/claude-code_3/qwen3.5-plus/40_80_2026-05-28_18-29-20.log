428	def enumerate_vulnerabilities(host: str, port: int, progress_callback: Optional[Callable] = None, cve_only: bool = False) -> dict:
429	    """
430	    ENUMERATE VULNERABILITIES: Find security issues and CVEs using nuclei scanner with streaming output.
431	
432	    This function scans a host:port for vulnerabilities using nuclei scanner with real-time output.
433	
434	    Args:
435	        host: Hostname or IP address to scan
436	        port: Port number to scan
437	        progress_callback: Optional callback function to receive real-time progress updates
438	        cve_only: If True, only run CVE-tagged templates (default: False for all templates)
439	
440	    Returns:
441	        Dictionary with scan results
442	    """
443	    try:
444	        # Generate scan ID and start time
445	        scan_id = str(uuid.uuid4())
446	        start_time = datetime.now()
447	
448	        # Build target from host and port
449	        # Determine if we should use HTTP or HTTPS based on port
450	        if port == 443:
451	            target = f"https://{host}:{port}"
452	        elif port == 80:
453	            target = f"http://{host}"
454	        elif port in [8080, 8443, 8000, 8888, 9000, 3000, 5000]:
455	            # Common HTTP ports - try HTTP first
456	            target = f"http://{host}:{port}"
457	        elif port == 21:
458	            target = f"ftp://{host}"
459	        else:
460	            # For non-HTTP ports (like SSH 22), use host:port format
461	            # This will limit nuclei to network-based templates only
462	            target = f"{host}:{port}"
463	
464	        # Test that the port is open first
465	        print(f"🔌 [{scan_id[:8]}] Testing connectivity to {host}:{port}...")
466	        try:
467	            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
468	            sock.settimeout(5)  # 5 second timeout for connection test
469	            result = sock.connect_ex((host, port))
470	            sock.close()
471	
472	            if result != 0:
473	                error_msg = f"Port {port} is not open or not responding on {host}"
474	                print(f"❌ [{scan_id[:8]}] {error_msg}")
475	
476	                if progress_callback:
477	                    progress_callback({
478	                        "type": "connectivity_failed",
479	                        "scan_id": scan_id,
480	                        "host": host,
481	                        "port": port,
482	                        "error": error_msg,
483	                        "message": f"Cannot connect to {host}:{port}"
484	                    })
485	
486	                return {
487	                    "success": False,
488	                    "error": error_msg,
489	                    "scan_id": scan_id,
490	                    "host": host,
491	                    "port": port,
492	                    "target": target
493	                }
494	            else:
495	                print(f"✅ [{scan_id[:8]}] Successfully connected to {host}:{port}")
496	
497	                if progress_callback:
498	                    progress_callback({
499	                        "type": "connectivity_success",
500	                        "scan_id": scan_id,
501	                        "host": host,
502	                        "port": port,
503	                        "message": f"Successfully connected to {host}:{port}"
504	                    })
505	
506	        except socket.gaierror as e:
507	            error_msg = f"DNS resolution failed for {host}: {e}"
508	            print(f"❌ [{scan_id[:8]}] {error_msg}")
509	
510	            if progress_callback:
511	                progress_callback({
512	                    "type": "dns_failed",
513	                    "scan_id": scan_id,
514	                    "host": host,
515	                    "error": error_msg,
516	                    "message": f"Cannot resolve hostname {host}"
517	                })
518	
519	            return {
520	                "success": False,
521	                "error": error_msg,
522	                "scan_id": scan_id,
523	                "host": host,
524	                "port": port,
525	                "target": target
526	            }
527	        except Exception as e:
528	            error_msg = f"Connection test failed for {host}:{port}: {e}"
529	            print(f"❌ [{scan_id[:8]}] {error_msg}")
530	
531	            if progress_callback:
532	                progress_callback({
533	                    "type": "connectivity_error",
534	                    "scan_id": scan_id,
535	                    "host": host,
536	                    "port": port,
537	                    "error": str(e),
538	                    "message": f"Connection error to {host}:{port}"
539	                })
540	
541	            return {
542	                "success": False,
543	                "error": error_msg,
544	                "scan_id": scan_id,
545	                "host": host,
546	                "port": port,
547	                "target": target
548	            }
549	
550	        # Create initial scan record
551	        if DATABASE_AVAILABLE:
552	            print(f"🔌 Connecting to MongoDB...")
553	            database.create_scan_record(scan_id, target, "vuln-scan", "nuclei", start_time)
554	            print(f"✅ MongoDB connection successful")
555	        else:
556	            print(f"⚠️  Database not available, skipping scan record creation")
557	
558	        # Build nuclei command with JSON output for reliable parsing
559	        cmd = [
560	            "nuclei",
561	            "-target", target,
562	            "-timeout", "10",                         # 10 second timeout per template
563	            "-no-color",                             # Disable color output for easier parsing
564	            "-jsonl",                                # JSON Lines output format for structured parsing
565	            "-silent",                               # Only show findings, not progress (progress goes to stderr)
566	        ]
