1035	@mcp.tool()
1036	async def get_current_datetime(ctx: Context) -> str:
1037	    """
1038	    Get the current date and time in various formats
1039	
1040	    Args:
1041	        ctx: FastMCP Context
1042	
1043	    Returns:
1044	        A string with current date and time information in different formats
1045	    """
1046	    from datetime import datetime, timezone
1047	
1048	    # Get current time in UTC
1049	    utc_now = datetime.now(timezone.utc)
1050	
1051	    # Get local time
1052	    local_now = datetime.now()
1053	
1054	    # Format the times in different ways
1055	    result = "Current Date and Time Information:\n\n"
1056	    result += f"UTC Date and Time: {utc_now.strftime('%Y-%m-%d %H:%M:%S %Z')}\n"
1057	    result += f"Local Date and Time: {local_now.strftime('%Y-%m-%d %H:%M:%S')}\n"
1058	    result += f"ISO Format UTC: {utc_now.isoformat()}\n"
1059	    result += f"Calendar-friendly Date: {local_now.strftime('%A, %B %d, %Y')}\n"
1060	    result += f"Time: {local_now.strftime('%I:%M %p')}\n"
1061	
1062	    # Add date components that might be useful for calendar operations
1063	    result += "\nDate Components:\n"
1064	    result += f"Year: {local_now.year}\n"
1065	    result += f"Month number: {local_now.month}\n"
1066	    result += f"Month name: {local_now.strftime('%B')}\n"
1067	    result += f"Day: {local_now.day}\n"
1068	    result += f"Hour: {local_now.hour}\n"
1069	    result += f"Minute: {local_now.minute}\n"
1070	    result += f"Second: {local_now.second}\n"
1071	    result += f"Day name: {local_now.strftime('%A')}\n"
1072	
1073	    return result
