226	                    )
227	            else:
228	                print(f"❌ [domain-discovery] {subdomain} -> resolution failed: {resolve_error}")
229	                resolved_subdomains.append({
230	                    "subdomain": subdomain,
231	                    "ip_address": "",
232	                    "resolved": False,
233	                    "error": resolve_error
234	                })
235	
236	        end_time = datetime.now()
237	        duration = (end_time - start_time).total_seconds()
238	
239	        # Count successful resolutions
240	        successful_resolutions = len([s for s in resolved_subdomains if s["resolved"]])
241	
242	        print(f"✅ [domain-discovery] Discovery completed: {successful_resolutions}/{len(subdomains)} subdomains resolved")
243	
244	        # Update scan status
