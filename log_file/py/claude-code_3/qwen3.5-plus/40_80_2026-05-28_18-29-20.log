20	mcp.add_tool(complete_task)
21	mcp.add_tool(delete_task)
22	
23	# Create SSE transport
24	tp = SseServerTransport("/messages/")
25	
26	
27	# Define handler functions for each server
28	async def handle_sse(request):
29	    async with tp.connect_sse(request.scope, request.receive, request._send) as streams:
30	        await mcp._mcp_server.run(
31	            streams[0],
32	            streams[1],
33	            mcp._mcp_server.create_initialization_options(),
34	        )
35	
36	
37	# Create a single Starlette app with different routes
38	routes = [
39	    Route("/sse", endpoint=handle_sse),
40	    Mount("/messages/", app=tp.handle_post_message),
41	]
42	
43	# Single Starlette app
44	app = Starlette(routes=routes)
45	
