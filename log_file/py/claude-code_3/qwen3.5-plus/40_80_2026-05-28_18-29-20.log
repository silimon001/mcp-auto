249	def parse_nuclei_output(output_lines: list[str]) -> list[dict]:
250	    """
251	    Parse nuclei scanner JSON output into structured vulnerability data.
252	
253	    Expected format: JSON lines from nuclei -jsonl output
254	    """
255	    vulnerabilities = []
256	
257	    for line in output_lines:
258	        line = line.strip()
259	        if not line:
260	            continue
261	
262	        try:
263	            # Try to parse as JSON (new nuclei format)
264	            data = json.loads(line)
265	
266	            # Extract information from JSON structure
267	            template_id = data.get("template-id", "unknown")
268	            template_name = data.get("info", {}).get("name", template_id.replace('-', ' ').title())
269	            protocol = data.get("type", "unknown")
270	            severity = data.get("info", {}).get("severity", "unknown")
271	
272	            # Target information
273	            host = data.get("host", "")
274	            port = data.get("port", "")
275	            scheme = data.get("scheme", "")
276	            url = data.get("url", "")
277	            matched_at = data.get("matched-at", url or f"{host}:{port}")
278	
279	            # Try to parse port as integer
280	            try:
281	                port = int(port) if port else None
282	            except (ValueError, TypeError):
283	                port = None
284	
285	            # Extract results
286	            extracted_results = data.get("extracted-results", [])
287	            if isinstance(extracted_results, list):
288	                extracted_results = ", ".join(str(x) for x in extracted_results)
289	            elif extracted_results:
290	                extracted_results = str(extracted_results)
291	            else:
292	                extracted_results = ""
293	
294	            # Determine hostname vs IP
295	            hostname = None
296	            ip_address = data.get("ip", "")
297	
298	            # If host is different from IP, it's likely a hostname
299	            if host and host != ip_address:
300	                try:
301	                    import ipaddress
302	                    ipaddress.ip_address(host)
303	                    # host is an IP address
304	                    if not ip_address:
305	                        ip_address = host
306	                except ValueError:
307	                    # host is a hostname
308	                    hostname = host
309	            elif host and not ip_address:
310	                # Try to determine if host is IP or hostname
311	                try:
312	                    import ipaddress
313	                    ipaddress.ip_address(host)
314	                    ip_address = host
315	                except ValueError:
316	                    hostname = host
317	
318	            # Build description from template info
319	            description = template_name
320	            if data.get("info", {}).get("description"):
321	                description = data["info"]["description"]
322	
323	            # Build reference
324	            reference = data.get("template-url", f"nuclei-template:{template_id}")
325	
326	            vulnerability = {
327	                "template_id": template_id,
328	                "template_name": template_name,
329	                "protocol": protocol,
330	                "severity": severity,
331	                "hostname": hostname,
332	                "ip_address": ip_address,
333	                "port": port,
334	                "url": url,
335	                "matched_at": matched_at,
336	                "extracted_results": extracted_results,
337	                "description": description,
338	                "reference": reference,
339	                "raw_data": data  # Include full JSON for debugging
340	            }
341	
342	            vulnerabilities.append(vulnerability)
343	
344	        except json.JSONDecodeError:
345	            # Try to parse as old text format for backward compatibility
346	            try:
347	                # Parse old nuclei output format: [template-id] [protocol] [severity] target ["extracted"]
348	                pattern = r'\[([^\]]+)\]\s+\[([^\]]+)\]\s+\[([^\]]+)\]\s+([^\s\[]+)(?:\s+\[([^\]]*)\])?'
349	                match = re.match(pattern, line)
350	
351	                if match:
352	                    template_id = match.group(1)
353	                    protocol = match.group(2)
354	                    severity = match.group(3)
355	                    target = match.group(4)
356	                    extracted = match.group(5) if match.group(5) else ""
357	
358	                    # Parse target to extract hostname, IP, and port
359	                    hostname = None
360	                    ip_address = None
361	                    port = None
362	                    url = target
363	
364	                    # Handle different target formats
365	                    if target.startswith(('http://', 'https://')):
366	                        # URL format
367	                        from urllib.parse import urlparse
368	                        parsed = urlparse(target)
369	                        hostname = parsed.hostname
370	                        port = parsed.port
371	
372	                        # Default ports
373	                        if port is None:
374	                            port = 443 if parsed.scheme == 'https' else 80
375	
376	                    elif ':' in target and not target.startswith('['):
377	                        # hostname:port format
378	                        parts = target.split(':')
379	                        hostname = parts[0]
380	                        try:
381	                            port = int(parts[1])
382	                        except (ValueError, IndexError):
383	                            port = None
384	                    else:
385	                        # Just hostname or IP
386	                        hostname = target
387	
388	                    # Try to resolve IP if we have hostname
389	                    if hostname and not ip_address:
390	                        try:
391	                            # Check if hostname is already an IP
392	                            import ipaddress
393	                            ipaddress.ip_address(hostname)
394	                            ip_address = hostname
395	                            hostname = None  # It's an IP, not a hostname
396	                        except ValueError:
397	                            # It's a hostname, try to resolve it
398	                            try:
399	                                ip_address = socket.gethostbyname(hostname)
400	                            except socket.gaierror:
401	                                pass
402	
403	                    vulnerability = {
404	                        "template_id": template_id,
405	                        "template_name": template_id.replace('-', ' ').title(),
406	                        "protocol": protocol,
407	                        "severity": severity,
408	                        "hostname": hostname,
409	                        "ip_address": ip_address,
410	                        "port": port,
411	                        "url": url,
412	                        "matched_at": target,
413	                        "extracted_results": extracted,
414	                        "description": f"{template_id} vulnerability detected",
415	                        "reference": f"nuclei-template:{template_id}"
416	                    }
417	
418	                    vulnerabilities.append(vulnerability)
419	            except Exception:
420	                # Skip malformed lines but continue processing
421	                continue
422	        except Exception as e:
423	            # Skip malformed lines but continue processing
424	            continue
425	
426	    return vulnerabilities
