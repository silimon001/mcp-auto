966	# ---------------------------------------------------------------------
967	# AI Context Recovery Tools
968	# ---------------------------------------------------------------------
969	@mcp_tool
970	@mcp.tool()
971	def gait_resume(
972	    target: str = "HEAD",
973	    turns: int = 10,
974	    include_pinned_memory: bool = True,
975	) -> Dict[str, Any]:
976	    """Sync AI state with GAIT history. Call this after a revert or to recover context.
977	
978	    Rebuilds the AI's ground truth from GAIT history. Includes explicit instructions
979	    for Copilot to avoid 'ghost turns'.
980	
981	    Args:
982	        target: Commit to resume from (default: HEAD)
983	        turns: Number of recent turns to restore (default: 10)
984	        include_pinned_memory: Whether to include pinned memory in the context bundle
985	    """
986	    repo, err = _try_repo()
987	    if err:
988	        return err
989	    assert repo is not None
990	
991	    head = repo.head_commit_id() or ""
992	    if not head:
993	        return _err("No commits yet; nothing to resume.")
994	
995	    t = (target or "").strip()
996	    cid = head if t in ("", "HEAD", "@") else _resolve_commit_prefix_from_head(repo, head, t)
997	
998	    want = max(0, int(turns))
999	    collected: List[Dict[str, Any]] = []
1000	    seen = set()
1001	    cur = cid
1002	
1003	    # Walk backward through history
1004	    while cur and cur not in seen and len(collected) < want:
1005	        seen.add(cur)
1006	        c = repo.get_commit(cur)
1007	        turn_ids = c.get("turn_ids") or []
1008	
1009	        for tid in turn_ids:
1010	            if len(collected) >= want:
1011	                break
1012	            tdata = repo.get_turn(tid)
1013	            
1014	            # Extract text and artifacts from the stored turn
1015	            user_txt = (tdata.get("user") or {}).get("text", "")
1016	            asst_txt = (tdata.get("assistant") or {}).get("text", "")
1017	            artifacts = tdata.get("context", {}).get("artifacts", [])
1018	            
