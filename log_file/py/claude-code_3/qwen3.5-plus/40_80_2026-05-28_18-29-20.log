197	
198	    def _get_token(self) -> Credentials:
199	        """Get or refresh Google API token"""
200	
201	        token = None
202	    
203	        if os.path.exists(self.token_path):
204	            logger.info('Loading token from file')
205	            token = Credentials.from_authorized_user_file(self.token_path, self.scopes)
206	
207	        if not token or not token.valid:
208	            if token and token.expired and token.refresh_token:
209	                logger.info('Refreshing token')
210	                token.refresh(Request())
211	            else:
212	                logger.info('Fetching new token')
213	                flow = InstalledAppFlow.from_client_secrets_file(self.creds_file_path, self.scopes)
214	                token = flow.run_local_server(port=0)
215	
216	            with open(self.token_path, 'w') as token_file:
217	                token_file.write(token.to_json())
218	                logger.info(f'Token saved to {self.token_path}')
219	
220	        return token
221	
222	    def _get_service(self) -> Any:
223	        """Initialize Gmail API service"""
224	        try:
225	            service = build('gmail', 'v1', credentials=self.token)
226	            return service
227	        except HttpError as error:
228	            logger.error(f'An error occurred building Gmail service: {error}')
229	            raise ValueError(f'An error occurred: {error}')
