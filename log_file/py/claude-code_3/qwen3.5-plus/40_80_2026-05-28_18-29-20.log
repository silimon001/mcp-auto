579	            print(f"🔍 CVE-only mode enabled - adding 'cve' tag")
580	
581	        if tags_to_use:
582	            cmd.extend(["-tags", ",".join(tags_to_use)])
583	            print(f"🏷️  Port {port}: Using tags: {', '.join(tags_to_use)}")
584	
585	        if template_config["severity"]:
586	            cmd.extend(["-severity", ",".join(template_config["severity"])])
587	            print(f"⚠️  Port {port}: Using severity levels: {', '.join(template_config['severity'])}")
588	
589	        scan_type = "CVE-only" if cve_only else "full"
590	        print(f"🎯 {scan_type} template selection for {template_config['service_name']} service on port {port}")
591	
592	        # Debug: Print command being executed
593	        print(f"🔍 DEBUG: Executing nuclei command: {' '.join(cmd)}")
594	        print(f"🎯 DEBUG: Target: {target}")
595	
596	        if progress_callback:
597	            progress_callback({
598	                "type": "scan_started",
599	                "scan_id": scan_id,
600	                "target": target,
601	                "command": ' '.join(cmd),
602	                "message": f"Starting vulnerability scan on {target}"
603	            })
604	
605	        # Execute nuclei scan with streaming output
606	        # Keep stderr separate since nuclei writes progress to stderr and results to stdout
607	        process = subprocess.Popen(
608	            cmd,
609	            stdout=subprocess.PIPE,
610	            stderr=subprocess.PIPE,
611	            text=True,
612	            bufsize=0,  # Unbuffered
