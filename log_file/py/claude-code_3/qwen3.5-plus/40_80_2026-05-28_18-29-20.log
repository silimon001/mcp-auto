20	
21	
22	# Pydantic models for better schema control
23	class PortScanParams(BaseModel):
24	    target: str = Field(
25	        description="IP address or CIDR range to scan (e.g., '192.168.1.1' or '10.0.0.0/24')",
26	        examples=["192.168.1.1", "10.0.0.0/24", "172.16.1.0/24"]
27	    )
28	    ports: str = Field(
29	        default="80,443,22,8080,8443,3389,11434",
30	        description="Comma-separated ports or ranges (e.g., '80,443' or '1-1000' or '80,443,8080-8090')",
31	        examples=["80,443", "1-1000", "22,80,443,8080-8090"]
32	    )
33	    scan_type: str = Field(
34	        default="tcp_syn",
35	        description="Type of scan: must be exactly 'tcp_syn', 'tcp_connect', 'udp', 'tcp_ack', or 'tcp_window'",
36	        examples=["tcp_syn", "tcp_connect", "udp"]
37	    )
38	    rate: int = Field(
39	        default=500,
40	        description="Packets per second rate (100-10000, higher = faster but more aggressive)",
41	        ge=100,
42	        le=10000,
43	        examples=[100, 500, 1000]
44	    )
45	
46	
47	class VulerabilityScanParameters(BaseModel):
48	    host: str = Field(
49	        description="Hostname or IP address to scan for vulnerabilities",
50	        examples=["example.com", "192.168.1.1", "google.com", "10.0.0.1"]
51	    )
52	    port: int = Field(
53	        description="Port number to scan for vulnerabilities",
54	        examples=[80, 443, 22, 8080, 3389],
55	        ge=1,
56	        le=65535
57	    )
58	
59	# Create FastMCP server
60	app = FastMCP(
61	    name="Red Team MCP server",
62	    stateless_http=True,
63	    )
64	
65	# Initialize database on startup
66	database.init_database()
67	
68	# Register SSH tools
69	ssh_scanner.register_tools(app)
70	
71	# Register Metasploit tools
72	metasploit_scanner.register_tools(app)
73	
74	# Register Domain Discovery tools
75	domain_discovery.register_tools(app)
76	
77	@app.tool()
78	async def resolve_hostname_to_ip(
79	    hostname: Annotated[str, "Hostname or domain name to resolve (e.g., 'google.com', 'example.org')"]
80	) -> str:
81	    """Resolve a hostname to an IP address with timeout."""
82	    try:
83	        # Run the blocking socket operation in a thread pool with timeout
84	
85	        ip_address = await asyncio.wait_for(
86	            asyncio.to_thread(socket.gethostbyname, hostname),
87	            timeout=10.0  # 10 second DNS timeout
88	        )
89	        return json.dumps({
90	            "success": True,
91	            "hostname": hostname,
92	            "ip_address": ip_address,
93	            "message": "Hostname resolved successfully"
94	        })
95	    except asyncio.TimeoutError:
96	        return json.dumps({
97	            "success": False,
98	            "message": f"DNS resolution timed out after 10 seconds for hostname: {hostname}"
99	        })
100	    except Exception as e:
101	        return json.dumps({
102	            "success": False,
103	            "message": f"Failed to resolve hostname: {str(e)}"
104	        })
105	
106	def mass_port_scan_sync(target, ports, rate=1000):
107	    return asyncio.run(mass_port_scan(target, ports, rate))
108	
109	@app.tool()
110	async def port_scan(params: PortScanParams) -> List[str]:
111	    """
112	    NETWORK PORT SCANNING: Discover open ports on hosts using masscan.
113	
114	    This tool performs PORT DISCOVERY to find open TCP/UDP ports on target hosts.
115	    It does NOT scan for vulnerabilities - use vulnerability_scan for that.
116	
117	    Use this tool when you want to:
118	    - Find what ports are open on a host
119	    - Discover services running on a network
120	    - Map network topology and services
