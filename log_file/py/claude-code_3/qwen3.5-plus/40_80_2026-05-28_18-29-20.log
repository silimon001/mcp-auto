from pydantic_settings import BaseSettings
from pydantic import Field
from typing import Optional

# (default description constants for each tool)

class ToolSettings(BaseSettings):
    """Configuration for all the tools."""
    tool_publish_description: str = Field(default=..., validation_alias="TOOL_PUBLISH_DESCRIPTION")
    tool_consume_description: str = Field(default=..., validation_alias="TOOL_CONSUME_DESCRIPTION")
    tool_create_topic_description: str = Field(default=..., validation_alias="TOOL_CREATE_TOPIC_DESCRIPTION")
    tool_delete_topic_description: str = Field(default=..., validation_alias="TOOL_DELETE_TOPIC_DESCRIPTION")
    tool_list_topic_description: str = Field(default=..., validation_alias="TOOL_LIST_TOPIC_DESCRIPTION")
    tool_topic_config_description: str = Field(default=..., validation_alias="TOOL_TOPIC_CONFIG_DESCRIPTION")
    tool_cluster_health_description: str = Field(default=..., validation_alias="TOOL_CLUSTER_HEALTH_DESCRIPTION")
    tool_cluster_metadata_description: str = Field(default=..., validation_alias="TOOL_CLUSTER_METADATA_DESCRIPTION")

class KafkaSettings(BaseSettings):
    """Configuration for the Kafka connector."""
    bootstrap_server: Optional[str] = Field(default=None, validation_alias="KAFKA_BOOTSTRAP_SERVERS")
    topic_name: Optional[str] = Field(default=None, validation_alias="TOPIC_NAME")
    from_beginning: Optional[bool] = Field(default=False, validation_alias="IS_TOPIC_READ_FROM_BEGINNING")
    group_id: Optional[str] = Field(default="kafka-mcp-group", validation_alias="DEFAULT_GROUP_ID_FOR_CONSUMER")

    def get_kafka_bootstrap_server(self) -> str:
        return self.bootstrap_server
```

Two Pydantic settings classes:
- **`ToolSettings`** -- configurable descriptions for all 8 MCP tools, read from environment variables with specific aliases.
- **`KafkaSettings`** -- Kafka connection configuration: bootstrap servers, topic name, consumer read-from-beginning flag, and consumer group ID.

