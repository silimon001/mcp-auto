15	import os
16	import json
17	import requests
18	from typing import Literal
19	from pydantic import Field
20	
21	from tools.common import mcp
22	from utils.logger import logger
23	from utils.error import error_json_msg
24	
25	
26	"""
27	
28	    本MCP服务器用于控制小米空气净化器的开关机和模式切换，包含以下两个功能：
29	
30	        1. switch_air_purifier() # 开关机
31	        2. mode_air_purifier()   # 模式切换
32	
33	"""
34	
35	
36	####################
37	# Global vairables #
38	####################
39	CONTROL_CENTER_BASE_URL = os.getenv('CONTROL_CENTER_BASE_URL')
40	CONTROL_CENTER_HEADERS = json.loads(os.getenv('CONTROL_CENTER_HEADERS'))
41	SWITCH_ENTITY_ID = os.getenv('XIAOMI_AIR_PURIFIER_SWITCH_ENTITY_ID')
42	MODE_SELECT_ENTITY_ID = os.getenv('XIAOMI_AIR_PURIFIER_MODE_SELECT_ENTITY_ID')
43	
44	
45	###############
46	# MCP servers #
47	###############
48	@mcp.tool()
49	async def switch_air_purifier(
50	    action: Literal["turn_on", "turn_off"] = Field(description="要执行的操作类型: 打开或者关闭。必须从两个选项中选择一个"), 
51	) -> str:
52	    """
53	    控制空气净化器的开关机流程。请根据用户的需求抽取参数，控制设备。
54	    """
55	
56	    response_json = dict()
57	
58	    try:
59	
60	        # Sanity check
61	        if action not in ['turn_on', 'turn_off']:
62	            return error_json_msg('不支持的开关操作类型。仅支持 turn_on, turn_off。请核对后重新输入。')
63	        logger.info(f"Current action: {action}")
64	        # Request body formation
65	        domain = SWITCH_ENTITY_ID.split(".")[0]
66	        request_url = f"{CONTROL_CENTER_BASE_URL}/api/services/{domain}/{action}"
67	        data = {
68	            "entity_id": SWITCH_ENTITY_ID
69	        }
70	        # HTTP request
71	        response = requests.post(request_url, headers=CONTROL_CENTER_HEADERS, json=data)
72	        response.raise_for_status()
73	        if response.status_code == 200:
74	            response_json['message'] = f"操作成功！"
75	            response_json['status_code'] = 200
