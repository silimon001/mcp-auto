144	def get_lack_params(arguments: dict) -> str | None:
145	    """Check if the parameters dictionary is missing a required field for the EmailMessage model.
146	
147	    Args:
148	        arguments (dict): The supplied parameter dictionary.
149	
150	    Returns:
151	        str | None: If a field is missing, returns an error message for the missing field; otherwise returns None.
152	    """
153	    # Get the field names of the EmailMessage model
154	    required_fields = EmailMessage.model_fields.keys()
155	
156	    # Find the missing fields
157	    missing_fields = [field for field in required_fields if field not in arguments]
158	
159	    # Logging
160	    logger.info(f"Missing params: {missing_fields}")
161	
162	    # If there is a missing field, returns an error message; otherwise returns None
163	    if missing_fields:
164	        return "\n".join(f"{field} is required" for field in missing_fields)
165	    return None
