1	"""
2	MCP Server for Meme Creation Platform.
3	
4	This server provides tools for creating memes using the Imgflip API
5	through the Model Control Protocol (MCP).
6	"""
7	
8	import os
9	import sys
10	import json
11	import asyncio
12	import logging
13	import mcp.server.stdio
14	import mcp.types as types
15	from mcp.server.models import InitializationOptions
16	from mcp.server import NotificationOptions, Server
17	
18	from . import api
19	
20	# Initialize the MCP server
21	server = Server("imgflip-mcp")
22	
23	@server.list_prompts()
24	async def handle_list_prompts() -> list[types.Prompt]:
25	    """
26	    List available prompts.
27	    Each prompt can have optional arguments to customize its behavior.
28	    """
29	    return [
30	        types.Prompt(
31	            name="imgflip_create_meme",
32	            description="Create a meme using Imgflip with a specified template and text",
33	            arguments=[
34	                types.PromptArgument(
35	                    name="template_name",
36	                    description="The name of the meme template to use",
37	                    required=True,
38	                ),
39	                types.PromptArgument(
40	                    name="text_boxes",
41	                    description="The text to display in each box (comma-separated)",
42	                    required=True,
43	                ),
44	            ],
45	        ),
46	        types.Prompt(
47	            name="imgflip_create_from_description",
48	            description="Create a meme from a description of the meme concept",
49	            arguments=[
50	                types.PromptArgument(
51	                    name="description",
52	                    description="A description of the meme concept or idea",
53	                    required=True,
54	                ),
55	            ],
56	        )
57	    ]
58	
59	
60	@server.get_prompt()
61	async def handle_get_prompt(
62	    name: str, arguments: dict[str, str] | None
63	) -> types.GetPromptResult:
64	    """
65	    Generate a prompt by combining arguments with server state.
66	    """
67	    if name == "imgflip_create_meme":
68	        template_name = (arguments or {}).get("template_name", "")
69	        text_boxes = (arguments or {}).get("text_boxes", "")
70	        
71	        return types.GetPromptResult(
72	            description=f"Create a meme with the {template_name} template",
73	            messages=[
74	                types.PromptMessage(
75	                    role="user",
76	                    content=types.TextContent(
77	                        type="text",
78	                        text=f"Create a meme using the '{template_name}' template with the following text boxes:\n{text_boxes}",
79	                    ),
80	                ),
81	            ],
82	        )
83	    elif name == "imgflip_create_from_description":
84	        description = (arguments or {}).get("description", "")
85	        
86	        return types.GetPromptResult(
87	            description=f"Create a meme based on the concept: {description}",
88	            messages=[
89	                types.PromptMessage(
90	                    role="user",
91	                    content=types.TextContent(
92	                        type="text",
93	                        text=f"I want to create a meme that captures this idea or concept: {description}\n\nPlease analyze this concept and determine appropriate meme templates that would work well for it. Then select the best one and generate suitable captions.",
94	                    ),
95	                ),
96	            ],
97	        )
98	    else:
99	        raise ValueError(f"Unknown prompt: {name}")
100	
