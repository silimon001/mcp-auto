159	    Subtitle Tracks: {subtitle_track_count}
160	    """
161	
162	
163	@mcp.resource("mediapool://folders")
164	def get_media_pool_folders() -> str:
165	    """Get a list of folders in the media pool."""
166	    if not resolve_api.is_connected():
167	        return "Error: Not connected to DaVinci Resolve."
168	
169	    media_pool = resolve_api.get_media_pool()
170	    if not media_pool:
171	        return "No media pool available."
172	
173	    root_folder = media_pool.GetRootFolder()
174	    if not root_folder:
175	        return "No root folder available."
176	
177	    def get_folder_structure(folder, indent=""):
178	        result = []
179	        name = folder.GetName()
180	        result.append(f"{indent}- {name}")
181	
182	        subfolders = folder.GetSubFolders()
183	        for subfolder in subfolders:
