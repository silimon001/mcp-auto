48	    host: str = Field(
49	        description="Hostname or IP address to scan for vulnerabilities",
50	        examples=["example.com", "192.168.1.1", "google.com", "10.0.0.1"]
51	    )
52	    port: int = Field(
53	        description="Port number to scan for vulnerabilities",
54	        examples=[80, 443, 22, 8080, 3389],
55	        ge=1,
