529	async def lldb_examine(ctx: Context, session_id: str, expression: str, format: str = "x", count: int = 1) -> str:
530	    """Examine memory"""
531	    try:
532	        session = get_session(ctx, session_id)
533	        
534	        # Map format codes to LLDB format specifiers
535	        format_map = {
536	            "x": "x",      # hex
537	            "d": "d",      # decimal
538	            "u": "u",      # unsigned decimal
539	            "o": "o",      # octal
540	            "t": "t",      # binary
541	            "i": "i",      # instruction
542	            "c": "c",      # character
543	            "f": "f",      # float
544	            "s": "s"       # string
545	        }
546	        
547	        # Get LLDB format or default to hex
548	        lldb_format = format_map.get(format, "x")
549	        
550	        # Build memory examine command
551	        command = f"memory read -f {lldb_format} -c {count} {expression}"
552	        output = await session.execute_command(command)
553	        
554	        return f"Examine {expression} (format: {format}, count: {count}):\n\n{output}"
555	    
556	    except ValueError as e:
557	        return str(e)
558	    except Exception as e:
559	        return f"Failed to examine memory: {str(e)}"
