211	
212	def clear_request_context() -> None:
213	    """Clear request context variables for the current thread."""
214	    if hasattr(_request_context, 'request_id'):
215	        delattr(_request_context, 'request_id')
216	    if hasattr(_request_context, 'client_id'):
