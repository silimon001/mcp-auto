531	@mcp_tool
532	@mcp.tool()
533	def gait_show(commit: str = "HEAD") -> Dict[str, Any]:
534	    """Show a commit (HEAD or id/prefix) including recorded turns and code artifacts.
535	
536	    Args:
537	        commit: Commit ID or prefix to show (default: HEAD)
538	    """
539	    repo, err = _try_repo()
540	    if err:
541	        return err
542	    assert repo is not None
543	
544	    head = repo.head_commit_id() or ""
545	    if not head:
546	        return _err("No commits in this branch yet")
547	
548	    cid = head if commit in ("", "HEAD", "@") else _resolve_commit_prefix_from_head(repo, head, commit)
549	    c = repo.get_commit(cid)
550	
551	    turn_ids = c.get("turn_ids") or []
552	    turns = []
553	    for tid in turn_ids:
554	        t = repo.get_turn(tid)
555	        # Pull artifacts out of the context metadata
556	        artifacts = t.get("context", {}).get("artifacts", [])
557	        
558	        turns.append(
559	            {
560	                "turn_id": tid,
561	                "user": (t.get("user") or {}).get("text", ""),
562	                "assistant": (t.get("assistant") or {}).get("text", ""),
563	                "artifacts": artifacts, # Include the code in the output
564	            }
565	        )
566	
567	    return {
568	        "ok": True,
569	        "commit": cid,
570	        "short": short_oid(cid),
571	        "created_at": c.get("created_at") or "",
572	        "kind": c.get("kind") or "",
573	        "message": c.get("message") or "",
574	        "turns": turns,
575	    }
