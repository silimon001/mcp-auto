405	def gait_init(path: str) -> Dict[str, Any]:
406	    """Initialize GAIT tracking in the given folder (refuses filesystem root). Creates the .gait directory.
407	
408	    Args:
409	        path: Path to initialize GAIT repository (required)
410	    """
411	    # Handle empty path by defaulting to current directory
412	    if not path or not path.strip():
413	        path = "."
414	    root = Path(path).resolve()
415	    if _is_filesystem_root(root):
416	        return _err("Refusing to initialize GAIT at filesystem root. cd into a working folder first.", path=str(root))
417	
418	    repo = GaitRepo(root=root)
419	    repo.init()
420	    _set_last_root(root)   # <-- important
421	    return {"ok": True, "root": str(repo.root), "gait_dir": str(repo.gait_dir)}
