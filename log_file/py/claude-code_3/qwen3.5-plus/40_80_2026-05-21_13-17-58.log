504	                        text=f"Last workout: {log.type} - '{log.name}' ({duration_str}) - {time_ago_str}",
505	                    )
506	                ]
507	            return [TextContent(type="text", text="No workouts logged yet")]
508	
509	        elif name == "check_reminders":
510	            from datetime import datetime
511	
512	            status = await db.check_reminders()
513	
514	            # Get time context
515	            now = datetime.now()
516	            current_time = now.strftime("%I:%M %p")
517	            current_date = now.strftime("%A, %B %d, %Y")
518	
519	            # Get bedtime info
520	            bedtime_hour = int(await db.get_config_value("bedtime_hour"))
521	            bedtime_minute = int(await db.get_config_value("bedtime_minute"))
522	            wakeup_hour = int(await db.get_config_value("wakeup_hour"))
523	            wakeup_minute = int(await db.get_config_value("wakeup_minute"))
524	
525	            current_minutes = now.hour * 60 + now.minute
526	            bedtime_minutes = bedtime_hour * 60 + bedtime_minute
527	            wakeup_minutes = wakeup_hour * 60 + wakeup_minute
528	
529	            # Calculate time to bedtime
530	            time_to_bed = bedtime_minutes - current_minutes
531	            if time_to_bed < 0:
532	                time_to_bed += 1440  # Add 24 hours
533	            hours_to_bed = time_to_bed // 60
534	            mins_to_bed = time_to_bed % 60
535	
536	            # Check if past bedtime
537	            past_bedtime = False
538	            if bedtime_minutes > wakeup_minutes:
539	                past_bedtime = (
540	                    current_minutes >= bedtime_minutes or current_minutes < wakeup_minutes
541	                )
542	            else:
543	                past_bedtime = (
544	                    current_minutes >= bedtime_minutes and current_minutes < wakeup_minutes
545	                )
546	
