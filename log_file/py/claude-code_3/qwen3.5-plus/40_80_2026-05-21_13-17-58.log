195	def attach_file(file_path):
196	    # Define allowed file types
197	    ALLOWED_EXTENSIONS = {
198	        'document': ['doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'pdf'],
199	        'archive': ['zip', 'rar', '7z', 'tar', 'gz'],
200	        'text': ['txt', 'log', 'csv', 'json', 'xml'],
201	        'image': ['jpg', 'jpeg', 'png', 'gif', 'bmp'],
202	        'other': ['md']  # Other special formats allowed
203	    }
204	
205	    # Flatten the list of allowed extensions
206	    allowed_extensions = [ext for exts in ALLOWED_EXTENSIONS.values() for ext in exts]
207	
208	    with open(file_path, 'rb') as f:
209	        file_data = f.read()
210	        filename = os.path.basename(file_path)
211	        ext = filename.lower().split('.')[-1]
212	
213	        # Check if the file type is allowed
214	        if ext not in allowed_extensions:
215	            raise ValueError(f"Unsupported file types: {ext}")
216	
217	        # Process according to file type
218	        if ext in ALLOWED_EXTENSIONS['document']:
219	            attachment = MIMEApplication(file_data, _subtype=ext)
220	        elif ext in ALLOWED_EXTENSIONS['archive']:
221	            attachment = MIMEApplication(file_data)
222	        elif ext in ALLOWED_EXTENSIONS['text']:
223	            try:
224	                attachment = MIMEText(file_data.decode('UTF-8'), 'plain')
225	            except UnicodeDecodeError:
226	                # If UTF-8 decoding is not possible, treat it as a normal attachment
227	                attachment = MIMEApplication(file_data)
228	        elif ext in ALLOWED_EXTENSIONS['image']:
229	            attachment = MIMEImage(file_data)
230	        else:
231	            # Other allowed formats use generic processing
232	            attachment = MIMEApplication(file_data)
233	
234	        attachment.add_header('Content-Disposition', 'attachment', filename=filename)
235	        return attachment
236	
237	async def serve(attachment_folder) -> None:
238	    server = Server("mcp-email")
239	
240	    @server.list_tools()
241	    async def list_tools() -> list[Tool]:
242	        return [
243	            Tool(
244	                name="send_email",
245	                description="""A tool that sends emails based on the provided subject, body and receiver. 
246	                            It ensures secure and accurate email delivery while supporting multiple recipients and custom content. 
247	                            Ideal for automating email workflows. 
248	                            After collecting the information, it needs to be displayed to the user, and then selected to send after the user confirms it.""",
249	                inputSchema=EmailMessage.model_json_schema()
250	            ),
251	            Tool(
252	                name="search_attachments",
253	                description="""Searches for files in a specified directory that match a given pattern. 
254	                            The search can be case-insensitive and returns the full paths of all matching files.
255	                            This tool is useful for locating specific files or attachments within a directory structure.""",
256	                inputSchema={
257	                    "type": "object",
258	                    "properties": {
259	                        "pattern": {
260	                            "type": "string",
261	                            "description": "The text pattern to search for in file names. The search is case-insensitive by default.",
262	                        },
263	                    },
264	                    "required": ["pattern"],
265	                }
266	            )
267	        ]
268	
269	    @server.list_prompts()
270	    async def list_prompts() -> list[Prompt]:
271	        return [
272	            Prompt(
273	                name="send_email",
274	                description="""A tool for sending emails based on the provided subject, body, and recipients.
275	                            It ensures that emails are delivered safely and accurately, and supports multiple recipients and customized content.
276	                            After collecting the information, it needs to be displayed to the user, and then selected to send after the user confirms it.""",
277	                arguments=[
278	                    PromptArgument(
279	                        name="receiver",
280	                        description="The list of recipient email addresses, supports multiple recipients",
281	                        required=True
282	                    ),
283	                    PromptArgument(
284	                        name="body",
285	                        description="The main content of the email",
286	                        required=True
287	                    ),
288	                    PromptArgument(
289	                        name="subject",
290	                        description="The subject line of the email",
291	                        required=True
292	                    ),
293	                    PromptArgument(
294	                        name="attachments",
295	                        description="Email attachments, just need to get the file name of the attachment",
296	                        required=False
297	                    )
298	                ]
299	            ),
300	            Prompt(
301	                name="search_attachments",
302	                description="""Searches for files in a specified directory that match a given pattern. 
303	                            The search can be case-insensitive and returns the full paths of all matching files.
304	                            This tool is useful for locating specific files or attachments within a directory structure.""",
305	                arguments=[
306	                    PromptArgument(
307	                        name="pattern",
308	                        description="The text pattern to search for in file names. The search is case-insensitive by default.",
309	                        required=True
310	                    )
311	                ]
312	            )
313	        ]
314	
315	    @server.call_tool()
316	    async def call_tool(name, arguments: dict) -> list[TextContent]:
317	        match name:
318	            case EmailTools.SEND_EMAIL:
319	                try:
320	                    args = EmailMessage(**arguments)
321	                except ValueError as e:
322	                    raise McpError(ErrorData(code=INVALID_PARAMS, message=str(e)))
323	
324	                try:
325	                    email_response = await send_email(attachment_folder, args)
326	                    return [TextContent(type="text", text=f"Send email response: \n{email_response}")]
327	                except Exception as e:
328	                    raise McpError(ErrorData(code=INTERNAL_ERROR, message=str(e)))
329	
330	            case EmailTools.SEARCH_ATTACHMENTS:
331	                try:
332	                    search_response = await search_attachments(attachment_folder, **arguments)
333	                    return [TextContent(type="text", text=f"Search attachments response: \n{search_response}")]
334	                except Exception as e:
335	                    raise McpError(ErrorData(code=INTERNAL_ERROR, message=str(e)))
336	            case _:
337	                raise ValueError(f"Unknown tool: {name}")
338	
339	
340	    @server.get_prompt()
341	    async def get_prompt(name: str, arguments: dict | None) -> GetPromptResult:
342	        lack_params_message = get_lack_params(arguments)
343	        if not arguments or not lack_params_message:
344	            raise McpError(ErrorData(code=INVALID_PARAMS, message=lack_params_message))
345	
346	        try:
347	            args = EmailMessage(**arguments)
348	        except ValueError as e:
349	            raise McpError(ErrorData(code=INVALID_PARAMS, message=str(e)))
350	
351	        try:
352	            email_response = await send_email(attachment_folder, args)
353	        except McpError as e:
354	            return GetPromptResult(
355	                description=f"Failed to send email",
356	                messages=[
357	                    PromptMessage(
358	                        role="user",
359	                        content=TextContent(type="text", text=str(e)),
360	                    )
361	                ],
362	            )
363	        return GetPromptResult(
364	            description=f"Response of send email by {sender}",
365	            messages=[
366	                PromptMessage(
367	                    role="user", content=TextContent(type="text", text=email_response)
368	                )
369	            ],
370	        )
371	
372	    async with stdio_server() as (read_stream, write_stream):
373	        await server.run(
374	            read_stream,
375	            write_stream,
