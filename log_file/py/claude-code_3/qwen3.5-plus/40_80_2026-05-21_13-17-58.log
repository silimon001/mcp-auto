314	                    ip_address = host
315	                except ValueError:
316	                    hostname = host
317	
318	            # Build description from template info
319	            description = template_name
320	            if data.get("info", {}).get("description"):
321	                description = data["info"]["description"]
322	
323	            # Build reference
324	            reference = data.get("template-url", f"nuclei-template:{template_id}")
325	
326	            vulnerability = {
327	                "template_id": template_id,
