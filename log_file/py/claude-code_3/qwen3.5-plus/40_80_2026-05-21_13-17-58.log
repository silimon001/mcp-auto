14	COLOR_RESET = '\033[0m'
15	COLOR_TIME = '\033[36m'
16	COLOR_NAME = '\033[35m'
17	COLOR_LEVEL = '\033[33m'
18	COLOR_MESSAGE = '\033[37m'
19	
20	def get_logger(name: str) -> logging.Logger:
21	    logger = logging.getLogger(name)
22	    logger.setLevel(logging.DEBUG)
23	    logger.propagate = False
24	
25	    handler = logging.StreamHandler()
26	    handler.setLevel(logging.INFO)
27	
28	    formatter = colorlog.ColoredFormatter(
29	        fmt=(
30	            f"{COLOR_TIME}[%(asctime)s]{COLOR_RESET} "
31	            f"{COLOR_NAME}[%(name)s]{COLOR_RESET} "
32	            f"%(log_color)s[%(levelname)s]{COLOR_RESET} "
33	            f"{COLOR_MESSAGE}%(message)s{COLOR_RESET}"
34	        ),
35	        datefmt="%Y-%m-%d %H:%M:%S",
36	        log_colors={
37	            'DEBUG':    'cyan',
38	            'INFO':     'green',
39	            'WARNING':  'yellow',
40	            'ERROR':    'red',
41	            'CRITICAL': 'bold_red',
42	        }
43	    )
44	
45	    handler.setFormatter(formatter)
46	    logger.handlers.clear()
47	    logger.addHandler(handler)
48	
49	    return logger
50	
