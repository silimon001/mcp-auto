366	def prepare_startup():
367	    """CLI entry point for imgflip-mcp"""
368	    logging.basicConfig(level=logging.INFO)
369	    # Check for environment variables
370	    username = os.getenv("IMGFLIP_USERNAME")
371	    password = os.getenv("IMGFLIP_PASSWORD")
372	    
373	    if not username or not password:
374	        logging.warning("Warning: IMGFLIP_USERNAME and IMGFLIP_PASSWORD environment variables are required")
375	        logging.warning("Without them, you won't be able to create memes")
376	    
377	    # Display welcome message
378	    logging.info("Starting Imgflip MCP Server")
379	    logging.info("This server provides tools for meme generation using the Imgflip API")
380	    logging.info("")
381	    logging.info("Available tools:")
382	    logging.info(" • imgflip_search_memes - Search for meme templates using keywords")
383	    logging.info(" • imgflip_get_template_info - Get info about template including required box count")
384	    logging.info(" • imgflip_create_meme - Create a meme with custom text")
385	    logging.info(" • imgflip_generate_search_terms - Generate optimal search terms for a meme concept")
386	    logging.info(" • imgflip_create_from_concept - Create a meme from a concept description")
