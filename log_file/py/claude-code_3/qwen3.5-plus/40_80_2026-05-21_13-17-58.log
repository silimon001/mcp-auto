222	@contextmanager
223	def request_logging_context(
224	    **context_vars
225	) -> Generator[None, None, None]:
226	    """
227	    Context manager for handling request context in logs.
228	
229	    Args:
230	        **context_vars: Key-value pairs to set in the request contex
