121	def main() -> None:
122	    """
123	    Main entry point for the Zoho Books MCP server.
124	    Sets up FastMCP, registers tools, and starts the appropriate transport.
125	
126	    If the --setup-oauth flag is provided, runs the OAuth setup flow instead
127	    of starting the server.
128	    """
129	    with request_logging_context(request_id="server-startup"):
130	        try:
131	            # Parse command-line arguments
132	            parser = setup_argparser()
133	            args = parser.parse_args()
134	
135	            # Check for OAuth setup early in the process
136	            if hasattr(args, 'setup_oauth') and args.setup_oauth:
137	                logger.info("Starting OAuth setup flow")
138	                print("\n=== Zoho Books OAuth Setup ===\n")
139	
140	                # Get the port from arguments
141	                oauth_port = getattr(args, 'oauth_port', 8099)
142	
143	                # Run the OAuth flow to obtain a refresh token
144	                try:
145	                    _ = run_oauth_flow(port=oauth_port)
146	                    logger.info("OAuth setup completed successfully")
147	                    print("\n✅ OAuth setup completed successfully!")
148	                    print("Refresh token has been saved to configuration.")
149	
150	                    # Exit with success code after OAuth setup completes
151	                    sys.exit(0)
152	                except AuthenticationError as e:
153	                    logger.error(f"OAuth setup failed: {str(e)}")
154	                    print(f"\n❌ OAuth setup failed: {str(e)}")
155	
156	                    if hasattr(e, 'details') and e.details:
157	                        logger.debug(f"Error details: {e.details}")
158	
159	                    # Exit with error code
160	                    sys.exit(1)
161	
162	            # Log server startup (only happens if not running OAuth setup)
163	            logger.info("Starting Zoho Books MCP Integration Server")
164	
165	            # Configure server settings
166	            server_config = configure_server(args)
167	
168	            # Initialize the FastMCP server
169	            logger.info(
170	                f"Initializing FastMCP server with config: {server_config}"
171	            )
172	            mcp_server = FastMCP(**server_config)
173	
174	            # Register all tools
175	            logger.info("Registering MCP tools")
176	            register_tools(mcp_server)
177	
178	            # Register all resources
179	            logger.info("Registering MCP resources")
180	            register_resources(mcp_server)
181	
182	            # Register all prompt templates
183	            logger.info("Registering MCP prompt templates")
184	            register_prompts(mcp_server)
185	
186	            # Configure and initialize the appropriate transport
187	            transport_type, config = configure_transport_from_args(args)
188	            logger.info(f"Configured transport: {transport_type}")
189	
190	            # Enable SSL if configured and not using STDIO
191	            if (
192	                transport_type != "stdio" and
193	                settings.ENABLE_SECURE_TRANSPORT and
194	                settings.SSL_CERT_PATH and
195	                settings.SSL_KEY_PATH
196	            ):
197	                logger.info("Enabling secure transport (SSL)")
198	                config["ssl_certfile"] = settings.SSL_CERT_PATH
199	                config["ssl_keyfile"] = settings.SSL_KEY_PATH
200	
201	            # Start the transport
202	            logger.info(f"Initializing {transport_type} transport")
203	            initialize_transport(mcp_server, transport_type, config)
204	
205	        except TransportConfigurationError as e:
206	            logger.error(f"Transport configuration error: {str(e)}")
207	            # Use handle_exception for consistent error format
208	            error_details = handle_exception(e)
209	            logger.debug(f"Error details: {error_details}")
210	            sys.exit(1)
211	        except TransportInitializationError as e:
212	            logger.error(f"Transport initialization error: {str(e)}")
213	            error_details = handle_exception(e)
214	            logger.debug(f"Error details: {error_details}")
215	            sys.exit(1)
216	        except ZohoMCPError as e:
217	            # For our custom errors, log with the built-in error details
218	            logger.error(f"{e.__class__.__name__}: {str(e)}")
219	            error_details = handle_exception(e)
220	            logger.debug(f"Error details: {error_details}")
221	            sys.exit(1)
222	        except Exception as e:
223	            # For unexpected errors, log the full traceback in debug mode
224	            logger.error(f"Unexpected error: {str(e)}")
225	            error_details = handle_exception(e, log_exception=True)
226	            sys.exit(1)
227	
228	
229	if __name__ == "__main__":
