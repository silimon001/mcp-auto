966	# ---------------------------------------------------------------------
967	# AI Context Recovery Tools
968	# ---------------------------------------------------------------------
969	@mcp_tool
970	@mcp.tool()
971	def gait_resume(
972	    target: str = "HEAD",
973	    turns: int = 10,
974	    include_pinned_memory: bool = True,
975	) -> Dict[str, Any]:
976	    """Sync AI state with GAIT history. Call this after a revert or to recover context.
977	
978	    Rebuilds the AI's ground truth from GAIT history. Includes explicit instructions
979	    for Copilot to avoid 'ghost turns'.
980	
981	    Args:
982	        target: Commit to resume from (default: HEAD)
983	        turns: Number of recent turns to restore (default: 10)
984	        include_pinned_memory: Whether to include pinned memory in the context bundle
985	    """
986	    repo, err = _try_repo()
987	    if err:
988	        return err
989	    assert repo is not None
990	
991	    head = repo.head_commit_id() or ""
992	    if not head:
993	        return _err("No commits yet; nothing to resume.")
994	
995	    t = (target or "").strip()
996	    cid = head if t in ("", "HEAD", "@") else _resolve_commit_prefix_from_head(repo, head, t)
997	
998	    want = max(0, int(turns))
999	    collected: List[Dict[str, Any]] = []
1000	    seen = set()
1001	    cur = cid
1002	
1003	    # Walk backward through history
1004	    while cur and cur not in seen and len(collected) < want:
1005	        seen.add(cur)
1006	        c = repo.get_commit(cur)
1007	        turn_ids = c.get("turn_ids") or []
1008	
1009	        for tid in turn_ids:
1010	            if len(collected) >= want:
1011	                break
1012	            tdata = repo.get_turn(tid)
1013	            
1014	            # Extract text and artifacts from the stored turn
1015	            user_txt = (tdata.get("user") or {}).get("text", "")
1016	            asst_txt = (tdata.get("assistant") or {}).get("text", "")
1017	            artifacts = tdata.get("context", {}).get("artifacts", [])
1018	            
1019	            if user_txt or asst_txt:
1020	                collected.append({
1021	                    "user": user_txt, 
1022	                    "assistant": asst_txt,
1023	                    "artifacts": artifacts
1024	                })
1025	
1026	        parents = c.get("parents") or []
1027	        cur = parents[0] if parents else ""
1028	
1029	    collected.reverse()
1030	
1031	    # The bundle now contains a 'system_instruction' to guide Copilot
1032	    bundle: Dict[str, Any] = {
1033	        "ok": True,
1034	        "current_state": {
1035	            "branch": repo.current_branch(),
1036	            "head": short_oid(cid),
1037	            "total_turns_restored": len(collected)
1038	        },
1039	        "history": collected,
1040	        "instructions": (
1041	            "CRITICAL: History has been synchronized. "
1042	            "1. DO NOT call gait_record_turn for this resume/revert action. "
1043	            "2. Use the provided 'history' as your new current context. "
1044	            "3. If artifacts are present in the history, consider those files to be in their current state."
1045	        )
1046	    }
1047	
1048	    if include_pinned_memory:
1049	        try:
1050	            bundle["pinned_memory"] = repo.build_context_bundle(full=False)
1051	        except Exception as e:
1052	            bundle["pinned_memory_error"] = str(e)
1053	
1054	    return bundle
1055	
