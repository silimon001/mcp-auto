164	async def search_attachments(directory: str, pattern: str,
165	                             ignore_case: bool = True) -> str:
166	    """
167	    Searches for file paths matching the specified pattern in the specified directory.
168	
169	    Args:
170	        directory: the root directory path to search
171	        pattern: the text pattern to search
172	        ignore_case: whether to ignore case
173	
174	    Returns:
175	        A collection of matching file paths
176	    """
177	    # 规范化目录路径
178	    root_dir = os.path.abspath(os.path.expanduser(directory))
179	    if not os.path.exists(root_dir):
180	        raise ValueError(f"directory no exists: {directory}")
181	
182	    matches = set()
183	    pattern = pattern.lower() if ignore_case else pattern
184	
185	    # 遍历目录
186	    for root, _, files in os.walk(root_dir):
187	        for file in files:
188	            file_name = file.lower() if ignore_case else file
189	            if pattern in file_name:
190	                full_path = os.path.join(root, file)
191	                matches.add(full_path)
192	
193	    return "\n".join(matches)
