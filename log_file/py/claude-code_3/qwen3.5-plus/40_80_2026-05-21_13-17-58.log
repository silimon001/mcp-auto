419	@app.call_tool()
420	async def call_tool(name: str, arguments: Any) -> list[TextContent]:
421	    """Handle tool calls."""
422	    try:
423	        if name == "log_water":
424	            amount = arguments["amount"]
425	            unit = arguments.get("unit")
426	            notes = arguments.get("notes")
427	            minutes_ago = arguments.get("minutes_ago", 0)
428	
429	            log = await db.log_water(amount, unit, notes, minutes_ago)
430	            time_str = f" ({minutes_ago} minutes ago)" if minutes_ago > 0 else ""
431	
432	            # Check if this completes the daily goal and update streak
433	            result_text = f"Logged {log.amount} {log.unit} of water at {log.datetime.strftime('%I:%M %p')}{time_str}"
434	            streak = await db.check_and_update_water_streak()
435	            if streak and streak.current == 1 and streak.last_completed_date:
436	                result_text += " 🎯 Daily water goal met!"
437	            elif streak and streak.current > 1:
438	                result_text += f" 🔥 {streak.current}-day water streak!"
439	
440	            return [TextContent(type="text", text=result_text)]
441	
442	        elif name == "log_workout":
443	            workout_type = arguments["type"]
444	            name_arg = arguments["name"]
445	            duration = arguments["duration"]
446	            notes = arguments.get("notes")
447	            minutes_ago = arguments.get("minutes_ago", 0)
448	            weight = arguments.get("weight")
449	            reps = arguments.get("reps")
450	            body_parts = arguments.get("body_parts")
451	
452	            log = await db.log_workout(
453	                workout_type, name_arg, duration, notes, minutes_ago, weight, reps, body_parts
454	            )
455	            duration_str = (
456	                f"{duration // 60}m {duration % 60}s" if duration >= 60 else f"{duration}s"
457	            )
458	            time_str = f" ({minutes_ago} minutes ago)" if minutes_ago > 0 else ""
459	
460	            # Build response with weight info if provided
461	            response = f"Logged {log.type}: '{log.name}' for {duration_str}"
462	            if weight and reps:
463	                total_weight = weight * reps
464	                response += f" ({reps} reps × {weight}lb = {total_weight}lb total)"
465	                if body_parts:
466	                    response += f" [{body_parts}]"
467	            response += f" at {log.datetime.strftime('%I:%M %p')}{time_str}"
468	
469	            # Check if this completes the daily goal and update streak
470	            streak = await db.check_and_update_workout_streak()
471	            if streak and streak.current == 1 and streak.last_completed_date:
472	                response += " 🎯 Daily workout goal met!"
473	            elif streak and streak.current > 1:
474	                response += f" 🔥 {streak.current}-day workout streak!"
475	
476	            return [TextContent(type="text", text=response)]
477	
478	        elif name == "get_last_water":
479	            log = await db.get_last_water()
480	            if log:
481	                minutes_ago = (int(time.time()) - log.timestamp) // 60
482	                time_ago_str = format_time_ago(minutes_ago, log.timestamp)
483	                return [
484	                    TextContent(
485	                        type="text",
486	                        text=f"Last water: {log.amount} {log.unit} ({time_ago_str})",
487	                    )
488	                ]
489	            return [TextContent(type="text", text="No water logged yet")]
490	
491	        elif name == "get_last_workout":
492	            log = await db.get_last_workout()
493	            if log:
494	                minutes_ago = (int(time.time()) - log.timestamp) // 60
495	                time_ago_str = format_time_ago(minutes_ago, log.timestamp)
496	                duration_str = (
497	                    f"{log.duration // 60}m {log.duration % 60}s"
498	                    if log.duration >= 60
499	                    else f"{log.duration}s"
500	                )
501	                return [
