76	
77	@app.tool()
78	async def resolve_hostname_to_ip(
79	    hostname: Annotated[str, "Hostname or domain name to resolve (e.g., 'google.com', 'example.org')"]
80	) -> str:
81	    """Resolve a hostname to an IP address with timeout."""
82	    try:
83	        # Run the blocking socket operation in a thread pool with timeout
84	
85	        ip_address = await asyncio.wait_for(
86	            asyncio.to_thread(socket.gethostbyname, hostname),
87	            timeout=10.0  # 10 second DNS timeout
88	        )
89	        return json.dumps({
90	            "success": True,
91	            "hostname": hostname,
92	            "ip_address": ip_address,
93	            "message": "Hostname resolved successfully"
94	        })
95	    except asyncio.TimeoutError:
96	        return json.dumps({
97	            "success": False,
98	            "message": f"DNS resolution timed out after 10 seconds for hostname: {hostname}"
99	        })
100	    except Exception as e:
101	        return json.dumps({
102	            "success": False,
103	            "message": f"Failed to resolve hostname: {str(e)}"
104	        })
105	
106	def mass_port_scan_sync(target, ports, rate=1000):
107	    return asyncio.run(mass_port_scan(target, ports, rate))
108	
109	@app.tool()
110	async def port_scan(params: PortScanParams) -> List[str]:
111	    """
112	    NETWORK PORT SCANNING: Discover open ports on hosts using masscan.
113	
114	    This tool performs PORT DISCOVERY to find open TCP/UDP ports on target hosts.
115	    It does NOT scan for vulnerabilities - use vulnerability_scan for that.
116	
117	    Use this tool when you want to:
118	    - Find what ports are open on a host
119	    - Discover services running on a network
120	    - Map network topology and services
121	
122	    Examples:
123	    - Find open ports: target='192.168.1.1', ports='80,443,22'
124	    - Scan network range: target='10.0.0.0/24', ports='1-1000'
125	    - Quick web scan: target='example.com', ports='80,443'
126	
127	    IMPORTANT: This tool only finds OPEN PORTS, not vulnerabilities.
128	    For vulnerability scanning, use the vulnerability_scan tool instead.
129	    """
130	
131	
132	    logging.warning("starting mass scan")
133	    try:
134	        res = await asyncio.to_thread(mass_port_scan_sync, target=params.target, ports=params.ports)
135	        logging.warning(res)
136	        return res
137	    except Exception as e:
138	        logging.warning(f"mass scanning failed: {e}")
139	        return []
140	
141	@app.tool(
142	    annotations={
143	        "title": "vulnerability scanner using nuclei scanner",
144	        "description": (
145	            "ENUMERATE VULNERABILITIES: Find security issues and CVEs using nuclei scanner with streaming output. "
146	            "This tool ENUMERATES VULNERABILITIES, MISCONFIGURATIONS, and SECURITY ISSUES. "
147	            "It does NOT find open ports - use port_scan for port discovery. "
148	            "Provides real-time progress updates during scanning."
149	        ),
150	        "readOnlyHint": False,
151	        "openWorldHint": True
152	    },
153	)
154	async def enumerate_vulnerabilities(host: str, port: int) -> []:
155	    """
156	    ENUMERATE VULNERABILITIES: Find security issues and CVEs using nuclei scanner with streaming output.
157	
158	    This tool ENUMERATES VULNERABILITIES, MISCONFIGURATIONS, and SECURITY ISSUES.
159	    It does NOT find open ports - use port_scan for port discovery.
160	
161	    Use this tool when you want to:
162	    - Enumerate security vulnerabilities (CVEs)
163	    - Detect misconfigurations
164	    - Check for exposed sensitive files
165	    - Identify weak SSL/TLS configurations
166	
167	    Examples:
168	    - Enumerate web vulns: host='example.com', port=80
169	    - HTTPS enumeration: host='example.com', port=443
170	    - SSH enumeration: host='192.168.1.1', port=22
171	    - Custom service: host='target.com', port=8080
172	
173	    IMPORTANT: This tool ENUMERATES VULNERABILITIES, not open ports.
174	    For port discovery, use the port_scan tool instead.
175	    """
176	
177	    def scan_with_nuclei_sync(host: str, port: int):
178	        return asyncio.run(scan_with_nuclei(host, port))
179	
180	    findings = await asyncio.to_thread(scan_with_nuclei_sync, host, port)
181	    if not len(findings):
182	        return {"result":"No vulnerabilities found"}
183	    else:
184	        return findings
