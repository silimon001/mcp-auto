347	async def main():
348	    """Main entry point for the MCP server"""
349	    # Check for required environment variables
350	    prepare_startup()
351	
352	    async with mcp.server.stdio.stdio_server() as (read_stream, write_stream):
353	        await server.run(
354	            read_stream,
355	            write_stream,
356	            InitializationOptions(
357	                server_name="imgflip-mcp",
358	                server_version="1.0.0",
359	                capabilities=server.get_capabilities(
360	                    notification_options=NotificationOptions(),
361	                    experimental_capabilities={},
362	                ),
363	            ),
364	        )
