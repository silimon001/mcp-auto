1	"""TeslaMate MCP Server - STDIO Transport (Local)"""
2	
3	import logging
4	from typing import Any, Dict, List
5	
6	from mcp.server.fastmcp import FastMCP
7	
8	from src.config import Config
9	from src.database import DatabaseManager
10	from src.tools import TOOL_DEFINITIONS
11	
12	# Initialize configuration and database manager
13	config = Config.from_env()
14	logger = logging.getLogger(__name__)
15	db_manager = DatabaseManager(config)
16	
17	# Initialize MCP server
18	mcp = FastMCP("teslamate")
19	
20	
21	# Register all predefined query tools dynamically
22	def create_tool_handler(sql_file: str):
23	    """Factory function to create tool handlers"""
24	
25	    def handler() -> List[Dict[str, Any]]:
26	        return db_manager.execute_query_sync(sql_file)
27	
28	    return handler
29	
30	
31	# Register all tools from definitions
32	for tool_def in TOOL_DEFINITIONS:
33	    tool_func = create_tool_handler(tool_def.sql_file)
34	    tool_func.__doc__ = tool_def.description
35	    tool_func.__name__ = tool_def.name
36	
37	    # Register the tool with the MCP server
38	    mcp.tool()(tool_func)
39	
