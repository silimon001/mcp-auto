1910	    async def broadcast_sessions():
1911	        """Broadcast session count and details to all connected dashboard WebSockets."""
1912	        import json
1913	
1914	        now = int(time.time())
1915	        sessions_list = []
1916	        for sid, info in active_sessions.items():
1917	            duration = now - info["connected_at"]
1918	            mins = duration // 60
1919	            secs = duration % 60
1920	            sessions_list.append(
1921	                {
1922	                    "id": sid,
1923	                    "duration": f"{mins}m {secs}s" if mins > 0 else f"{secs}s",
1924	                }
1925	            )
1926	
1927	        message = json.dumps(
1928	            {
1929	                "type": "sessions",
1930	                "count": len(active_sessions),
1931	                "sessions": sessions_list,
1932	            }
1933	        )
1934	        disconnected = set()
1935	        for ws in dashboard_websockets:
1936	            try:
1937	                await ws.send({"type": "websocket.send", "text": message})
1938	            except Exception:
1939	                disconnected.add(ws)
1940	        dashboard_websockets.difference_update(disconnected)
