1	"""
2	Utility functions for the Joplin API client.
3	"""
4	
5	import logging
6	import os
7	from dataclasses import dataclass
8	from datetime import datetime
9	from pathlib import Path
10	
11	from dotenv import load_dotenv
12	
13	logger = logging.getLogger(__name__)
14	
15	class JoplinConfigError(Exception):
16	    """Raised when there is an error with the Joplin configuration."""
17	
18	    def __init__(self, message: str, env_var: str | None = None):
19	        self.env_var = env_var
20	        super().__init__(message)
21	
22	@dataclass
23	class MarkdownContent:
24	    """Represents parsed content from a Markdown file.
25	    
26	    Attributes:
27	        title: The title extracted from the first heading or filename
28	        content: The main content of the file
29	        source_path: Original path to the markdown file
30	        created_time: When the file was created
31	        modified_time: When the file was last modified
32	    """
33	    title: str
34	    content: str
35	    source_path: Path
36	    created_time: datetime
37	    modified_time: datetime
38	
39	    @classmethod
40	    def from_file(cls, file_path: Path) -> 'MarkdownContent':
41	        """Create MarkdownContent from a file.
42	        
43	        Args:
44	            file_path: Path to the markdown file
45	            
46	        Returns:
47	            MarkdownContent instance
48	            
49	        Raises:
50	            FileNotFoundError: If the file doesn't exist
51	            ValueError: If the file is empty or invalid
52	        """
53	        if not file_path.exists():
54	            raise FileNotFoundError(f"File not found: {file_path}")
55	
56	        if not file_path.is_file():
57	            raise ValueError(f"Not a file: {file_path}")
58	
59	        content = file_path.read_text(encoding='utf-8')
60	        if not content.strip():
61	            raise ValueError(f"File is empty: {file_path}")
62	
63	        # Extract title from first heading or use filename
64	        lines = content.splitlines()
65	        title = file_path.stem
66	
67	        for line in lines:
68	            if line.startswith('# '):
69	                title = line[2:].strip()
70	                content = '\n'.join(lines[1:]).strip()
71	                break
72	
73	        return cls(
74	            title=title,
75	            content=content,
76	            source_path=file_path,
77	            created_time=datetime.fromtimestamp(file_path.stat().st_ctime),
78	            modified_time=datetime.fromtimestamp(file_path.stat().st_mtime)
79	        )
80	
81	def get_token_from_env(env_var: str = "JOPLIN_TOKEN") -> str:
82	    """Read the Joplin API token from environment variable.
83	    
84	    First tries to load from .env file, then from environment.
85	    
86	    Args:
87	        env_var: Name of the environment variable containing the token
88	        
89	    Returns:
90	        The API token
91	        
92	    Raises:
93	        JoplinConfigError: If the token is not set or invalid
94	    """
95	    # Try to load from .env file
96	    load_dotenv()
97	
98	    token = os.environ.get(env_var, "").strip()
99	    if not token:
100	        raise JoplinConfigError(
101	            f"No {env_var} found in environment variables or .env file",
102	            env_var=env_var
103	        )
104	
105	    if len(token) < 32:
106	        raise JoplinConfigError(
107	            f"Invalid {env_var}: Token seems too short (< 32 chars)",
108	            env_var=env_var
109	        )
110	
111	    return token
112	
113	def format_timestamp(ts: datetime | None) -> str:
114	    """Format a timestamp for display.
115	    
116	    Args:
117	        ts: Timestamp to format
118	        
119	    Returns:
120	        Formatted string or 'N/A' if timestamp is None
121	    """
122	    return ts.strftime("%Y-%m-%d %H:%M:%S") if ts else "N/A"
123	
124	def format_note_info(
125	    note_id: str,
126	    title: str,
127	    created_time: datetime | None = None,
128	    updated_time: datetime | None = None,
129	    is_todo: bool = False
130	) -> str:
131	    """Format note information for display.
132	    
133	    Args:
134	        note_id: The note's ID
135	        title: The note's title
136	        created_time: Creation timestamp
137	        updated_time: Last update timestamp
138	        is_todo: Whether this is a todo item
139	        
140	    Returns:
141	        Formatted string with note information
142	    """
143	    info = [
144	        f"ID: {note_id}",
145	        f"Title: {title}",
146	        f"Created: {format_timestamp(created_time)}",
147	    ]
148	
149	    if updated_time:
150	        info.append(f"Updated: {format_timestamp(updated_time)}")
151	
152	    if is_todo:
153	        info.append("Type: Todo")
154	
155	    return "\n".join(info)
156	
157	def read_markdown_file(file_path: str | Path) -> tuple[str, str]:
158	    """Read a markdown file and extract title and content.
159	    
160	    This is a convenience wrapper around MarkdownContent.from_file()
161	    that returns just the title and content.
162	    
163	    Args:
164	        file_path: Path to the markdown file
165	        
166	    Returns:
167	        Tuple of (title, content)
168	        
169	    Raises:
170	        FileNotFoundError: If the file doesn't exist
171	        ValueError: If the file is empty or invalid
172	    """
173	    if isinstance(file_path, str):
174	        file_path = Path(file_path)
175	
176	    content = MarkdownContent.from_file(file_path)
177	    return content.title, content.content
178	
179	def sanitize_filename(filename: str) -> str:
180	    """Sanitize a filename by removing invalid characters.
181	    
182	    Args:
183	        filename: Original filename
184	        
185	    Returns:
186	        Sanitized filename that is safe to use on all platforms
187	    """
188	    # Replace invalid characters with underscores
189	    invalid_chars = '<>:"/\\|?*'
190	    sanitized = filename.strip()
191	
192	    for char in invalid_chars:
193	        sanitized = sanitized.replace(char, '_')
194	
195	    # Remove leading/trailing dots and spaces
196	    sanitized = sanitized.strip('. ')
197	
198	    # Ensure we still have a valid filename
199	    if not sanitized:
200	        sanitized = "untitled"
201	
202	    return sanitized
203	

