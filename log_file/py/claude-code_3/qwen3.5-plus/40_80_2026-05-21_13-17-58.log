249	def parse_nuclei_output(output_lines: list[str]) -> list[dict]:
250	    """
251	    Parse nuclei scanner JSON output into structured vulnerability data.
252	
253	    Expected format: JSON lines from nuclei -jsonl output
254	    """
255	    vulnerabilities = []
256	
257	    for line in output_lines:
258	        line = line.strip()
259	        if not line:
260	            continue
261	
262	        try:
263	            # Try to parse as JSON (new nuclei format)
264	            data = json.loads(line)
265	
266	            # Extract information from JSON structure
267	            template_id = data.get("template-id", "unknown")
268	            template_name = data.get("info", {}).get("name", template_id.replace('-', ' ').title())
269	            protocol = data.get("type", "unknown")
270	            severity = data.get("info", {}).get("severity", "unknown")
271	
272	            # Target information
273	            host = data.get("host", "")
274	            port = data.get("port", "")
275	            scheme = data.get("scheme", "")
276	            url = data.get("url", "")
277	            matched_at = data.get("matched-at", url or f"{host}:{port}")
278	
279	            # Try to parse port as integer
280	            try:
281	                port = int(port) if port else None
282	            except (ValueError, TypeError):
283	                port = None
284	
285	            # Extract results
286	            extracted_results = data.get("extracted-results", [])
287	            if isinstance(extracted_results, list):
288	                extracted_results = ", ".join(str(x) for x in extracted_results)
289	            elif extracted_results:
290	                extracted_results = str(extracted_results)
291	            else:
292	                extracted_results = ""
293	
294	            # Determine hostname vs IP
295	            hostname = None
296	            ip_address = data.get("ip", "")
297	
298	            # If host is different from IP, it's likely a hostname
