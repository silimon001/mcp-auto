898	@mcp.tool()
899	@requires_graph_auth
900	async def list_calendar_by_date_range(ctx: Context, start_date: Optional[str] = None, end_date: Optional[str] = None) -> str:
901	    """
902	    List calendar events within a specific date range
903	
904	    Args:
905	        ctx: FastMCP Context
906	        start_date: Start date in format "YYYY-MM-DD" (default: beginning of current week)
907	        end_date: End date in format "YYYY-MM-DD" (default: 2 weeks from start_date)
908	
909	    Returns:
910	        A formatted string with event details within the specified date range
911	    """
912	    graph = ctx.request_context.lifespan_context.graph
913	
914	    try:
915	        events_page = await graph.calendar.list_events_by_date_range(start_date=start_date, end_date=end_date)
916	
917	        # Get the actual date range used (for display in result)
918	        import datetime
919	
920	        if not start_date:
921	            today = datetime.datetime.now().date()
922	            start_of_week = today - datetime.timedelta(days=today.weekday())
923	            start_date = start_of_week.strftime("%Y-%m-%d")
924	
925	        if not end_date:
926	            start_date_obj = datetime.datetime.strptime(start_date, "%Y-%m-%d").date()
927	            end_date_obj = start_date_obj + datetime.timedelta(days=14)
928	            end_date = end_date_obj.strftime("%Y-%m-%d")
929	
930	        # Format the dates for display
931	        start_display = datetime.datetime.strptime(start_date, "%Y-%m-%d").strftime("%A, %B %d, %Y")
932	        end_display = datetime.datetime.strptime(end_date, "%Y-%m-%d").strftime("%A, %B %d, %Y")
933	
934	        result = f"Calendar events from {start_display} to {end_display}:\n\n"
935	
936	        # Reuse your existing formatting function
937	        from mcpserver.calendar_formatting import format_event_page
938	        result += format_event_page(events_page)
939	
940	        return result
941	    except Exception as e:
942	        return f"Error retrieving calendar events: {str(e)}"
943	
