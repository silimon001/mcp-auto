291	@contextmanager
292	def log_api_call(
293	    method: str,
294	    endpoint: str,
295	    logger: logging.Logger,
296	    include_request_body: bool = True,
297	    include_response_body: bool = True
298	) -> Generator[Dict[str, Any], None, None]:
299	    """
300	    Context manager for logging API requests and responses.
301	
302	    Args:
303	        method: HTTP method (GET, POST, etc.)
304	        endpoint: API endpoin
305	        logger: Logger instance
306	        include_request_body: Whether to include the request body in logs
307	        include_response_body: Whether to include the response body in logs
308	
309	    Yields:
310	        Dictionary to store the response and any context
311	    """
312	    context: Dict[str, Any] = {}
313	    start_time = time.time()
314	
315	    logger.info(f"API Request: {method} {endpoint}")
316	
317	    try:
318	        yield context
319	
320	        # Log response if available
321	        response_time_ms = (time.time() - start_time) * 1000
322	        status_code = context.get('status_code', 'unknown')
323	
324	        log_msg = f"API Response: {method} {endpoint} - Status: {status_code}, Time: {response_time_ms:.2f}ms"
325	
326	        # Log at appropriate level based on status code
327	        if isinstance(status_code, int):
328	            if status_code < 400:
329	                logger.info(log_msg)
330	            elif status_code < 500:
331	                logger.warning(log_msg)
332	            else:
333	                logger.error(log_msg)
334	        else:
335	            logger.info(log_msg)
336	
337	        # Log response body if requested and available
338	        if include_response_body and 'response_body' in context:
339	            body = sanitize_request_data(context['response_body'])
340	            logger.debug(f"Response body: {json.dumps(body, indent=2)}")
341	
342	    except Exception as e:
343	        response_time_ms = (time.time() - start_time) * 1000
344	        logger.error(
345	            f"API Error: {method} {endpoint} - Error: {e}, Time: {response_time_ms:.2f}ms",
346	            exc_info=True
347	        )
348	        raise
