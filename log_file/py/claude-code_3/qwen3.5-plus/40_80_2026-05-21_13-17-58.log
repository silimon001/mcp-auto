53	    logger.info("Successfully connected to DaVinci Resolve.")
54	
55	# Define resource and tool functions
56	
57	# System Information Resources
58	
59	
60	@mcp.resource("system://status")
61	def get_system_status() -> str:
62	    """Get the current status of the DaVinci Resolve connection."""
63	    if resolve_api.is_connected():
64	        project_name = resolve_api.get_project_name() or "No project open"
65	        timeline = resolve_api.get_current_timeline()
66	        timeline_name = timeline.GetName() if timeline else "No timeline open"
67	
68	        return f"""
69	        DaVinci Resolve Status:
70	        - Connection: Connected
71	        - Current Project: {project_name}
72	        - Current Timeline: {timeline_name}
73	        """
74	    else:
75	        return """
76	        DaVinci Resolve Status:
77	        - Connection: Not connected
78	        - Error: DaVinci Resolve is not running or not accessible
79	        """
80	
81	
82	# Project Resources
83	
84	
85	@mcp.resource("project://current")
86	def get_current_project() -> str:
87	    """Get information about the current project."""
88	    if not resolve_api.is_connected():
89	        return "Error: Not connected to DaVinci Resolve."
90	
91	    project = resolve_api.get_current_project()
92	    if not project:
93	        return "No project is currently open."
94	
95	    project_name = project.GetName()
96	    timeline_count = project.GetTimelineCount()
97	
98	    current_timeline = project.GetCurrentTimeline()
99	    timeline_name = current_timeline.GetName() if current_timeline else "None"
100	
101	    return f"""
102	    Current Project: {project_name}
103	    Timeline Count: {timeline_count}
104	    Current Timeline: {timeline_name}
105	    """
106	
107	
108	@mcp.resource("project://timelines")
109	def get_project_timelines() -> str:
110	    """Get a list of timelines in the current project."""
111	    if not resolve_api.is_connected():
112	        return "Error: Not connected to DaVinci Resolve."
113	
114	    project = resolve_api.get_current_project()
115	    if not project:
116	        return "No project is currently open."
117	
118	    timeline_count = project.GetTimelineCount()
119	    if timeline_count == 0:
120	        return "No timelines in the current project."
121	
122	    timelines = []
123	    for i in range(1, timeline_count + 1):
124	        timeline = project.GetTimelineByIndex(i)
125	        if timeline:
126	            timelines.append(f"{i}. {timeline.GetName()}")
127	
128	    return "\n".join(timelines)
