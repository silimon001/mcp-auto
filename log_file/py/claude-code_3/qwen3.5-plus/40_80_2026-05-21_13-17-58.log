187	@server.call_tool()
188	async def call_tool(
189	    name: str, arguments: dict
190	) -> list[types.TextContent | types.EmbeddedResource]:
191	    """Handle tool calls from the LLM"""
192	    
193	    if name == "imgflip_search_memes":
194	        query = arguments["query"]
195	        include_nsfw = 1 if arguments.get("include_nsfw", False) else 0
196	        
197	        result = await api.search_meme_templates(query, include_nsfw)
198	        
199	        # If search fails, fallback to popular memes
200	        if not result.get("success"):
201	            fallback_result = await api.get_meme_templates()
202	            if fallback_result.get("success"):
203	                fallback_result["message"] = "Search failed, showing popular templates instead"
204	                return [types.TextContent(type="text", text=json.dumps(fallback_result, indent=2))]
205	        
206	        return [types.TextContent(type="text", text=json.dumps(result, indent=2))]
207	    
208	    elif name == "imgflip_get_template_info":
209	        template_id = arguments["template_id"]
210	        
211	        result = await api.get_meme_by_id(template_id)
212	        
213	        if result.get("success"):
214	            # Extract just the template info
215	            template_info = result.get("data", {}).get("meme", {})
216	            
217	            # Add helpful text about box count
218	            box_count = template_info.get("box_count", 0)
219	            box_guidance = f"This template requires {box_count} text boxes."
220	            
221	            if box_count == 2:
222	                box_guidance += " This is a standard meme template with top and bottom text."
223	            elif box_count == 1:
224	                box_guidance += " This template has only one text area."
225	            elif box_count > 2:
226	                box_guidance += f" You'll need to provide {box_count} different text strings for this template."
227	                
228	            return [types.TextContent(
229	                type="text", 
230	                text=f"Template Information:\n{json.dumps(template_info, indent=2)}\n\n{box_guidance}"
231	            )]
232	        else:
233	            return [types.TextContent(
234	                type="text", 
235	                text=f"Error getting template info: {result.get('error_message', 'Unknown error')}"
236	            )]
237	    
238	    elif name == "imgflip_create_meme":
239	        template_id = arguments["template_id"]
240	        text_boxes = arguments["text_boxes"]
241	        font = arguments.get("font", "impact")
242	        max_font_size = arguments.get("max_font_size", "50")
243	        
244	        # Get template info to check box count
245	        template_info = await api.get_meme_by_id(template_id)
246	        if template_info.get("success"):
247	            required_box_count = template_info.get("data", {}).get("meme", {}).get("box_count", 2)
248	            provided_box_count = len(text_boxes)
249	            
250	            # If too few boxes provided, warn but proceed (empty boxes will be used)
251	            if provided_box_count < required_box_count:
252	                logging.warning(f"Template requires {required_box_count} text boxes, but only {provided_box_count} provided. Empty boxes will be used for remaining positions.")
253	                
254	                # Pad the text_boxes array with empty strings
255	                text_boxes = text_boxes + [""] * (required_box_count - provided_box_count)
256	                
257	            # If too many boxes provided, truncate and warn
258	            elif provided_box_count > required_box_count:
259	                logging.warning(f"Template only supports {required_box_count} text boxes, but {provided_box_count} provided. Extra boxes will be ignored.")
260	                text_boxes = text_boxes[:required_box_count]
261	        
262	        # Create boxes array for API call
263	        boxes = [{"text": text} for text in text_boxes]
264	        
265	        result = await api.create_meme_advanced(template_id, boxes, font, max_font_size)
266	        
267	        # If the API call was successful and we have a URL
