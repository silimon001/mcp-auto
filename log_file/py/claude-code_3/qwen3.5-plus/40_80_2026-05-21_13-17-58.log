230	@mcp.tool()
231	async def download_email_attachments(
232	    email_identifier: str,
233	    msg_id: str,
234	    download_all_in_thread: bool = False
235	) -> Dict[str, Any]:
236	    """Download attachments for a specific email or its entire thread"""
237	    try:
