239	        service = get_gmail_service(email_identifier)
240	        
241	        attachment_dir = Path('./downloaded_attachments')
242	        attachment_dir.mkdir(exist_ok=True)
243	        
244	        if download_all_in_thread:
245	            download_attachments_all(
