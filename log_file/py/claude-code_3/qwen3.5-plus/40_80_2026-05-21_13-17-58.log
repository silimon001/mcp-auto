704	async def lldb_breakpoint_delete(ctx: Context, session_id: str, breakpoint_id: int) -> str:
705	   """Delete a breakpoint"""
706	   try:
707	       session = get_session(ctx, session_id)
708	       output = await session.execute_command(f"breakpoint delete {breakpoint_id}")
709	       return f"Deleted breakpoint {breakpoint_id}\n\nOutput:\n{output}"
