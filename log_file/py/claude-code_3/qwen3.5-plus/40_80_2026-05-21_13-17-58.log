1637	    async def render_summary_page() -> bytes:
1638	        """Render the 30-day summary page with charts."""
1639	        import json
1640	        from datetime import datetime, timedelta
1641	
1642	        # Get data
1643	        body_weight_history = await db.get_body_weight_history(30)
1644	        daily_water = await db.get_daily_water_stats(30)
1645	        daily_body_parts = await db.get_daily_body_part_stats(30)
1646	        current_weight = float(await db.get_config_value("body_weight") or 0)
1647	
1648	        # Generate last 30 days
1649	        today = datetime.now().date()
1650	        dates = [(today - timedelta(days=i)).isoformat() for i in range(29, -1, -1)]
1651	
1652	        # Build water data by date
1653	        water_by_date = {w["date"]: w["total"] for w in daily_water}
1654	
1655	        # Build body weight data by date
1656	        weight_by_date = {}
1657	        for log in body_weight_history:
1658	            date_str = log.datetime.date().isoformat()
1659	            if date_str not in weight_by_date:
1660	                weight_by_date[date_str] = log.weight
1661	
1662	        # Get all unique body parts
1663	        all_body_parts = set()
1664	        for day_stats in daily_body_parts.values():
1665	            all_body_parts.update(day_stats.keys())
1666	        all_body_parts = sorted(all_body_parts)
1667	
1668	        # Build chart data
1669	        chart_labels = [d[5:] for d in dates]  # MM-DD format
1670	        weight_data = [weight_by_date.get(d, None) for d in dates]
1671	        water_data = [water_by_date.get(d, 0) for d in dates]
1672	
1673	        # Build table rows
1674	        table_rows = []
1675	        for date in dates:
1676	            short_date = date[5:]  # MM-DD format
1677	            water = water_by_date.get(date, 0)
1678	            weight = weight_by_date.get(date, "")
1679	            body_part_data = daily_body_parts.get(date, {})
1680	
1681	            row = f"<tr><td>{short_date}</td><td>{water:.0f}</td><td>{weight}</td>"
1682	            for part in all_body_parts:
1683	                val = body_part_data.get(part, 0)
1684	                row += f"<td>{val:.0f}</td>" if val > 0 else "<td>-</td>"
1685	            row += "</tr>"
1686	            table_rows.append(row)
1687	
1688	        # Build header
1689	        header = "<tr><th>Date</th><th>Water (oz)</th><th>Weight (lbs)</th>"
1690	        for part in all_body_parts:
1691	            header += f"<th>{part.title()}</th>"
1692	        header += "</tr>"
1693	
