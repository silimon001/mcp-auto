1	from contextlib import asynccontextmanager
2	from dataclasses import dataclass
3	from typing import Optional, AsyncIterator
4	from mcp.server.fastmcp import FastMCP
5	from settings import AzureSettings
6	import logging
7	from mcpserver.graph.controller import GraphController
8	
9	
10	# Encapsulates state objects for passing via context
11	@dataclass
12	class AppContext:
13	    settings: AzureSettings
14	    graph: GraphController
15	
16	# FastMCP decorated tools accept contexts for managing lifecycle automatically when called by bot
17	@asynccontextmanager
18	async def app_lifespan(server: Optional[FastMCP]) -> AsyncIterator[AppContext]:
19	    """Manage application lifecycle with type-safe context"""
20	
21	    # If authenticated in previous session, graph will hold a valid graph_client
22	    # If not previously authenticated, graph will hold None and a wrapper will trigger auth before tools are run
23	    try:
24	        logging.info("Starting app lifespan")
25	        settings = AzureSettings()
26	        user_client = settings.get_user_client()
27	        graph = GraphController(user_client)
28	
29	        logging.info("Settings initialized: in app_lifespan")
30	    except Exception as e:
31	        logging.error(f"Error in app_lifespan: {str(e)}")
32	        raise e
33	
34	    try:
35	        yield AppContext(settings=settings, graph=graph)
36	    finally:
37	        #Add any cleanup if needed
38	        pass
