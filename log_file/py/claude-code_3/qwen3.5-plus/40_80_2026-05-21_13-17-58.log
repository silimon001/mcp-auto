191	def set_request_context(
192	    request_id: Optional[str] = None,
193	    client_id: Optional[str] = None,
194	    tool_name: Optional[str] = None,
195	) -> None:
196	    """
197	    Set context variables for the current request/thread.
198	
199	    Args:
