200	@dataclass
201	class AppContext:
202	    """Application context for storing active sessions"""
203	    sessions: Dict[str, LldbSession]
204	
205	
206	@asynccontextmanager
207	async def app_lifespan(server: FastMCP) -> AsyncIterator[AppContext]:
208	    """Manage application lifecycle with shared session state"""
209	    # Initialize on startup
210	    sessions = {}
211	    try:
212	        yield AppContext(sessions=sessions)
213	    finally:
214	        # Cleanup all sessions on shutdown
215	        for session_id, session in list(sessions.items()):
216	            await session.cleanup()
217	            sessions.pop(session_id, None)
218	
219	
220	# Create an MCP server
221	mcp = FastMCP("lldb-mcp", lifespan=app_lifespan)
222	
223	
224	# Helper function to get session from context
225	def get_session(ctx: Context, session_id: str) -> LldbSession:
226	    """Get a session by ID or raise an error if not found"""
227	    # Access the lifespan context through request_context
228	    sessions = ctx.request_context.lifespan_context.sessions
229	    if session_id not in sessions:
230	        raise ValueError(f"No active LLDB session with ID: {session_id}")
231	    return sessions[session_id]
