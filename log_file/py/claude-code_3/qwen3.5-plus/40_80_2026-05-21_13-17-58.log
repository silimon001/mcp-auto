1	import logging
2	from contextlib import asynccontextmanager
3	from typing import Any, AsyncIterator
4	
5	from mcp.server import Server
6	from mcp.server.fastmcp import Context, FastMCP
7	from kafka import KafkaConnector
8	from settings import KafkaSettings, ToolSettings
9	
10	# Setup logging
11	logging.basicConfig(
12	    level=logging.INFO,
13	    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
14	)
15	logger = logging.getLogger(__name__)
16	
17	@asynccontextmanager
18	async def server_lifespan(server: Server) -> AsyncIterator[dict]:
19	    """
20	    Context manager to handle the lifespan of the server.
21	    This is used to configure the kafka connector.
22	    All the configuration is now loaded from the environment variables.
23	    Settings handle that for us.
24	    """
25	    try:
26	        kafka_configurations = KafkaSettings()
27	
28	        logger.info(
29	            f"Connecting to kafka at {kafka_configurations.get_kafka_bootstrap_server()}"
30	        )
31	
32	        kafka_connector = KafkaConnector(kafka_bootstrap_url=kafka_configurations.bootstrap_server,
33	                                         topic_name=kafka_configurations.topic_name,
34	                                         group_id=kafka_configurations.group_id)
35	
36	        await kafka_connector.create_producer()
37	
38	        yield {
39	            "kafka_connector": kafka_connector,
40	        }
41	    except Exception as e:
42	        logger.error(e)
43	        raise e
44	    finally:
45	        pass
46	
47	
48	# FastMCP is an alternative interface for declaring the capabilities
49	# of the server. Its API is based on FastAPI.
50	mcp = FastMCP("mcp-server-kafka", lifespan=server_lifespan)
51	
52	# Load the tool settings from the env variables, if they are set,
53	# or use the default values otherwise.
54	tool_settings = ToolSettings()
55	
56	@mcp.tool(name="kafka-publish", description=tool_settings.tool_publish_description)
57	async def publish(ctx: Context, information: Any) -> str:
58	    """
59	    :param ctx:
60	    :param information:
61	    :return:
62	    """
63	    await ctx.debug(f"Storing information {information} in kafka topic")
64	    kafka_connector: KafkaConnector = ctx.request_context.lifespan_context[
65	        "kafka_connector"
66	    ]
67	    await kafka_connector.publish(value=information)
68	    return f"published: {information}"
69	
70	
71	@mcp.tool(name="kafka-consume", description=tool_settings.tool_consume_description)
72	async def consumer(ctx: Context) -> str:
73	    """
74	    :param ctx:
75	    :param information:
76	    :return:
77	    """
78	    await ctx.debug(f"consuming information from kafka")
79	    kafka_connector: KafkaConnector = ctx.request_context.lifespan_context[
80	        "kafka_connector"
81	    ]
82	    information = await kafka_connector.consume()
83	    return f"consumed: {information}"
84	
85	@mcp.tool(name="create-topic", description=tool_settings.tool_create_topic_description)
86	async  def create_topic(ctx: Context, information: Any):
87	    await ctx.debug(f"Creating topic with {information}")
88	    kafka_connector: KafkaConnector = ctx.request_context.lifespan_context[
89	        "kafka_connector"
90	    ]
91	    kafka_connector.create_topic(topic_name=information)
92	    return f"topic: {information} created"
93	
94	@mcp.tool(name="delete-topic", description=tool_settings.tool_delete_topic_description)
95	async def delete_topic(ctx: Context, information: Any):
96	    await ctx.debug(f"Deleting topic: {information}")
97	    kafka_connector: KafkaConnector = ctx.request_context.lifespan_context[
98	        "kafka_connector"
99	    ]
100	    kafka_connector.delete_topic(topic_name=information)
101	    return f"topic: {information} deleted"
102	
103	@mcp.tool(name="list-topics", description=tool_settings.tool_list_topic_description)
104	async def list_topics(ctx: Context):
