144	
145	    timeline_name = timeline.GetName()
146	    start_frame = timeline.GetStartFrame()
147	    end_frame = timeline.GetEndFrame()
148	    duration = end_frame - start_frame + 1
149	
150	    video_track_count = timeline.GetTrackCount("video")
151	    audio_track_count = timeline.GetTrackCount("audio")
152	    subtitle_track_count = timeline.GetTrackCount("subtitle")
153	
154	    return f"""
155	    Timeline: {timeline_name}
