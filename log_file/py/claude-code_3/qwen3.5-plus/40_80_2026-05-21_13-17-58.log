1	"""
2	Logging utilities for the Zoho Books MCP Integration Server.
3	
4	This module provides structured logging functionality, including:
5	- Configurable log formats and levels
6	- Sanitization of sensitive information in logs
7	- Context managers for request/response logging
8	- Handlers for different log destinations
9	"""
10	
11	import sys
12	import os
13	import json
14	import logging
15	import logging.handlers
16	import traceback
17	import re
18	import time
19	import threading
20	import platform
21	from contextlib import contextmanager
22	from typing import Dict, Any, Optional, Union, List, Generator
23	
24	from zoho_mcp.config import settings
25	from zoho_mcp.errors import sanitize_error_message
26	
27	# ThreadLocal storage for request contex
28	_request_context = threading.local()
29	
30	
31	class RequestContextFilter(logging.Filter):
32	    """
33	    Filter that adds request context data to log records.
34	    """
35	    def filter(self, record):
36	        """Add request context to the log record if available."""
37	        record.request_id = getattr(_request_context, 'request_id', '-')
38	        record.client_id = getattr(_request_context, 'client_id', '-')
39	        record.tool_name = getattr(_request_context, 'tool_name', '-')
40	        return True
41	
42	
43	class SensitiveDataFilter(logging.Filter):
44	    """
45	    Filter that redacts sensitive information from log messages.
46	    """
47	    def __init__(self):
48	        super().__init__()
49	        # Compile regular expressions for performance
50	        self.patterns = [
51	            (re.compile(r'client_id=([^&]+)'), 'client_id=REDACTED'),
52	            (re.compile(r'client_secret=([^&]+)'), 'client_secret=REDACTED'),
53	            (re.compile(r'Bearer ([^"\'\\s]+)'), 'Bearer REDACTED'),
54	            (re.compile(r'Zoho-oauthtoken ([^"\'\\s]+)'), 'Zoho-oauthtoken REDACTED'),
55	            (re.compile(r'refresh_token=([^&]+)'), 'refresh_token=REDACTED'),
56	            (re.compile(r'access_token=([^&]+)'), 'access_token=REDACTED'),
57	            (re.compile(r'Authorization: ([^"\'\n]+)'), 'Authorization: REDACTED'),
58	            (re.compile(r'"password":\s*"([^"]+)"'), '"password": "REDACTED"'),
59	            (re.compile(r'"api_key":\s*"([^"]+)"'), '"api_key": "REDACTED"'),
60	            (re.compile(r'"token":\s*"([^"]+)"'), '"token": "REDACTED"'),
61	        ]
62	
63	    def filter(self, record):
64	        """Redact sensitive information from log message."""
65	        if isinstance(record.msg, str):
66	            for pattern, replacement in self.patterns:
67	                record.msg = pattern.sub(replacement, record.msg)
68	
69	        # Also check for exception info
70	        if record.exc_info:
71	            # Sanitize traceback - this is tricky to do reliably, so we use a helper
72	            if hasattr(record, 'exc_text') and record.exc_text:
73	                record.exc_text = sanitize_error_message(record.exc_text)
74	
75	        return True
76	
77	
78	class JsonFormatter(logging.Formatter):
79	    """
80	    Formatter that outputs log records as JSON objects.
81	    """
82	    def __init__(self, include_time=True):
83	        super().__init__()
84	        self.include_time = include_time
85	
86	    def format(self, record):
87	        """Format the log record as a JSON string."""
88	        log_data = {
89	            'timestamp': record.created,
90	            'level': record.levelname,
91	            'name': record.name,
92	            'message': record.getMessage(),
93	        }
94	
95	        # Add request context if available
96	        if hasattr(record, 'request_id') and record.request_id != '-':
97	            log_data['request_id'] = record.request_id
98	        if hasattr(record, 'client_id') and record.client_id != '-':
99	            log_data['client_id'] = record.client_id
100	        if hasattr(record, 'tool_name') and record.tool_name != '-':
101	            log_data['tool_name'] = record.tool_name
102	
103	        # Add exception info if available
104	        if record.exc_info:
105	            log_data['exception'] = {
106	                'type': record.exc_info[0].__name__,
107	                'message': str(record.exc_info[1]),
108	                'traceback': sanitize_error_message(''.join(traceback.format_exception(*record.exc_info))),
109	            }
110	
111	        return json.dumps(log_data)
112	
113	
114	def setup_logging(
115	    level: Optional[str] = None,
116	    log_file: Optional[str] = None,
117	    use_json: bool = False,
118	    max_bytes: int = 10485760,  # 10MB
119	    backup_count: int = 5,
120	) -> None:
121	    """
122	    Configure the logging system for the application.
123	
124	    Args:
125	        level: The log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
126	        log_file: Path to the log file (None for stderr)
127	        use_json: Whether to use JSON formatting
128	        max_bytes: Maximum size of each log file
129	        backup_count: Number of backup log files to keep
130	    """
131	    # Get the root logger
132	    root_logger = logging.getLogger()
133	
134	    # Clear existing handlers
135	    for handler in root_logger.handlers[:]:
136	        root_logger.removeHandler(handler)
137	
138	    # Determine log level
139	    log_level = level or settings.LOG_LEVEL
140	    numeric_level = getattr(logging, log_level.upper(), logging.INFO)
141	    root_logger.setLevel(numeric_level)
142	
143	    # Create formatter
144	    formatter: Union[JsonFormatter, logging.Formatter]
145	    if use_json:
146	        formatter = JsonFormatter()
147	    else:
148	        log_format = settings.LOG_FORMAT
149	        formatter = logging.Formatter(log_format)
150	
151	    # Set up handlers
152	    handlers: List[logging.Handler] = []
153	
154	    # Always add stderr handler
155	    stderr_handler = logging.StreamHandler(sys.stderr)
156	    stderr_handler.setFormatter(formatter)
157	    handlers.append(stderr_handler)
158	
159	    # Add file handler if log_file is specified
160	    if log_file:
161	        log_dir = os.path.dirname(log_file)
162	        if log_dir:
163	            os.makedirs(log_dir, exist_ok=True)
164	
165	        file_handler = logging.handlers.RotatingFileHandler(
166	            log_file,
167	            maxBytes=max_bytes,
168	            backupCount=backup_count,
169	        )
170	        file_handler.setFormatter(formatter)
171	        handlers.append(file_handler)
172	
173	    # Add filters
174	    request_filter = RequestContextFilter()
175	    sensitive_filter = SensitiveDataFilter()
176	
177	    # Apply handlers and filters to root logger
178	    for handler in handlers:
179	        handler.addFilter(sensitive_filter)
180	        handler.addFilter(request_filter)
181	        root_logger.addHandler(handler)
182	
183	    # Initialize module logger
184	    logger = logging.getLogger('zoho_mcp')
185	    logger.info(f"Logging initialized at level {log_level}")
186	
187	    # Log Python version and platform info at DEBUG level
188	    logger.debug(f"Python {platform.python_version()} on {platform.platform()}")
189	
