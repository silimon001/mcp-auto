  "file_path": "/home/silimon/MCP-Auto/mcp_server/963838819_Sofias-ai_mcp-business-central-server/mcp_bc_server/server.py",
  "content": "import os\nimport requests\nfrom mcp.server.fastmcp import FastMCP\n\nmcp = FastMCP(\n    \"business-central-server\",\n    description=\"Business Central MCP Server for Microsoft Dynamics 365\"\n)\n\nBC_URL_SERVER = os.environ.get(\"BC_URL_SERVER\", \"\")\nBC_USER = os.environ.get(\"BC_USER\", \"\")\nBC_PASS = os.environ.get(\"BC_PASS\", \"\")\nBC_COMPANY = os.environ.get(\"BC_COMPANY\", \"\")\n\n\ndef _get_auth():\n    return (BC_USER, BC_PASS)\n\n\ndef _build_url(entity, item_id=None):\n    base = BC_URL_SERVER.rstrip(\"/\")\n    company = BC_COMPANY\n    if item_id:\n        return f\"{base}/companies({{filter_condition}})/{entity}({{filter_condition}})/{entity}('{item_id}')\"\n    return f\"{base}/companies({{filter_condition}})/{entity}\"\n\n\ndef _make_request(method, url, data=None):\n    resp = requests.request(\n        method, url, auth=_get_auth(), json=data,\n        headers={\"Accept\": \"application/json\", \"Content-Type\": \"application/json\"}\n    )\n    resp.raise_for_status()\n    if resp.status_code == 204:\n        return None\n    return resp.json()\n\n\n@mcp.tool()\ndef BC_Get_Schema(entity: str) -> str:\n    \"\"\"Retrieves the schema of any Business Central entity including available fields\"\"\"\n    url = _build_url(entity)\n    result = _make_request(\"GET\", url + \"?$top=1\")\n    if result and \"value\" in result and result[\"value\"]:\n        fields = list(result[\"value\"][0].keys())\n        return f\"Entity: {entity}\\nFields: {', '.join(fields)}\"\n    return f\"No schema found for entity: {entity}\"\n\n\n@mcp.tool()\ndef BC_List_Items(entity: str, filter_field: str = None, top: int = None, skip: int = None) -> list:\n    \"\"\"Fetches a list of entities with optional filtering and pagination\"\"\"\n    url = _build_url(entity)\n    params = {}\n    if filter_field:\n        params[\"$filter\"] = filter_field\n    if top:\n        params[\"$top\"] = top\n    if skip:\n        params[\"$skip\"] = skip\n    result = _make_request(\"GET\", url, params=params if params else None)\n    if result and \"value\" in result:\n        return result[\"value\"]\n    return []\n\n\n@mcp.tool()\ndef BC_Get_Items_By_Field(entity: str, field: str, value: str) -> list:\n    \"\"\"Searches for entities based on a specific field value\"\"\"\n    url = _build_url(entity)\n    result = _make_request(\"GET\", url, params={\"$filter\": f\"{field} eq '{value}'\"})\n    if result and \"value\" in result:\n        return result[\"value\"]\n    return []\n\n\n@mcp.tool()\ndef BC_Create_Item(entity: str, data: dict) -> dict:\n    \"\"\"Creates a new entity record in Business Central\"\"\"\n    url = _build_url(entity)\n    return _make_request(\"POST\", url, data=data)\n\n\n@mcp.tool()\ndef BC_Update_Item(entity: str, item_id: str, data: dict) -> dict:\n    \"\"\"Updates an existing entity record\"\"\"\n    url = _build_url(entity, item_id)\n    return _make_request(\"PATCH\", url, data=data)\n\n\n@mcp.tool()\ndef BC_Delete_Item(entity: str, item_id: str) -> str:\n    \"\"\"Removes an entity record from Business Central\"\"\"\n    url = _build_url(entity, item_id)\n    _make_request(\"DELETE\", url)\n    return f\"Successfully deleted {entity}('{item_id}')\"\n\n\ndef main():\n    mcp.run()\n\n\nif __name__ == \"__main__\":\n    main()\n"
}
