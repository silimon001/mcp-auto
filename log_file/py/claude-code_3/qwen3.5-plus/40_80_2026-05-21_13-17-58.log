273	            'access_token', 'auth_token', 'api_secret', 'secret', 'Authorization',
274	            'auth', 'credentials'
275	        }
276	
277	        for key, value in data.items():
278	            if key.lower() in sensitive_fields or any(s in key.lower() for s in {'password', 'token', 'secret', 'key'}):
279	                result[key] = 'REDACTED'
280	            elif isinstance(value, (dict, list)):
281	                result[key] = sanitize_request_data(value)
282	            else:
283	                result[key] = value
284	        return result
285	    elif isinstance(data, list):
286	        return [sanitize_request_data(item) for item in data]
