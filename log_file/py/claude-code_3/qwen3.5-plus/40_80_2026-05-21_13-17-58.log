36	        examples=["tcp_syn", "tcp_connect", "udp"]
37	    )
38	    rate: int = Field(
39	        default=500,
40	        description="Packets per second rate (100-10000, higher = faster but more aggressive)",
41	        ge=100,
42	        le=10000,
43	        examples=[100, 500, 1000]
44	    )
