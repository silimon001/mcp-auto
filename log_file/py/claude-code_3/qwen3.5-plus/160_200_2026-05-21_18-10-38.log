6	
7	import os
8	import logging
9	from dotenv import load_dotenv
10	from fastmcp import FastMCP
11	
12	from src.client import OpenProjectClient
13	
14	# Load environment variables
15	load_dotenv()
16	
17	# Configure logging
18	logging.basicConfig(
19	    level=os.getenv("LOG_LEVEL", "INFO"),
20	    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
21	)
22	logger = logging.getLogger(__name__)
23	
24	# Initialize FastMCP server
25	mcp = FastMCP(
26	    name="openproject-mcp"
27	)
28	
29	# Initialize OpenProject client as global variable
30	_client = None
31	
32	try:
33	    base_url = os.getenv("OPENPROJECT_URL")
34	    api_key = os.getenv("OPENPROJECT_API_KEY")
35	    proxy = os.getenv("OPENPROJECT_PROXY")
36	
37	    if not base_url or not api_key:
38	        raise ValueError(
39	            "Missing required environment variables: OPENPROJECT_URL and OPENPROJECT_API_KEY must be set"
40	        )
41	
42	    _client = OpenProjectClient(
43	        base_url=base_url,
44	        api_key=api_key,
45	        proxy=proxy
46	    )
47	
48	    logger.info(f"✅ OpenProject MCP Server initialized")
49	    logger.info(f"   Server: {base_url}")
50	    logger.info(f"   Proxy: {proxy if proxy else 'None'}")
51	
52	except Exception as e:
53	    logger.error(f"❌ Failed to initialize OpenProject client: {e}")
54	    raise
55	
56	
57	# Dependency injection helper for tools
58	def get_client():
59	    """Get OpenProject client instance."""
60	    return _client
61	
62	
