225	class LLMClient:
226	    """Manages communication with the LLM provider."""
227	
228	    def __init__(self, api_key: str) -> None:
229	        self.api_key: str = api_key
230	
231	    def get_response(self, messages: list[dict[str, str]]) -> str:
232	        """Get a response from the LLM.
233	
234	        Args:
235	            messages: A list of message dictionaries.
236	
237	        Returns:
238	            The LLM's response as a string.
239	
240	        Raises:
241	            httpx.RequestError: If the request to the LLM fails.
242	        """
243	        url = "https://qianfan.baidubce.com/v2/chat/completions"
244	
245	        headers = {
246	            "Content-Type": "application/json",
247	            "Authorization": f"Bearer {self.api_key}",
248	        }
249	        payload = {
250	            "messages": messages,
251	            #"model": "ernie-4.5-8k-preview",
252	            "model": "deepseek-v3",
253	            #"model": "ernie-4.0-turbo-8k",
254	            "temperature": 0.7,
255	            "top_p": 1,
256	            "stream": False,
257	            "stop": None,
258	        }
259	
260	        #logging.info(f"request qianfan payload: {payload}")
261	
262	        try:
263	            with httpx.Client(timeout=30.0) as client:
264	                response = client.post(url, headers=headers, json=payload)
265	                #logging.info(f"qianfan response: {response.text}")
266	                response.raise_for_status()
267	                data = response.json()
268	                return data["choices"][0]["message"]["content"]
269	
270	        except httpx.RequestError as e:
271	            error_message = f"Error getting LLM response: {str(e)}"
272	            logging.error(error_message)
273	
274	            if isinstance(e, httpx.HTTPStatusError):
275	                status_code = e.response.status_code
276	                logging.error(f"Status code: {status_code}")
277	                logging.error(f"Response details: {e.response.text}")
278	
279	            return (
280	                f"I encountered an error: {error_message}. "
281	                "Please try again or rephrase your request."
282	            )
