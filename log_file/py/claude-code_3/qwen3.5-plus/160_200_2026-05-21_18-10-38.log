66	def register_jenkins_resources(mcp: FastMCP, multi_jenkins_manager) -> None:
67	    """Register MCP resources for Jenkins URL to credentials mapping"""
68	
69	    @mcp.resource("jenkins://instances")
70	    def jenkins_instances() -> dict:
71	        """Lists configured Jenkins instances without leaking credentials."""
72	        instances = []
73	        for instance_id, config in multi_jenkins_manager.instances_config.items():
74	            instances.append(
75	                {
76	                    "id": instance_id,
77	                    "uri": f"jenkins://instances/{instance_id}",
78	                    "url": config.url,
79	                    "display_name": config.display_name or instance_id,
80	                    "description": config.description
81	                    or f"Jenkins instance: {config.url}",
82	                    "has_credentials": bool(config.token),
83	                }
84	            )
85	        return {
86	            "instances": instances,
87	            "total": len(instances),
88	            "usage": "Use the per-instance resource URI for metadata or pass jenkins_url to tools.",
89	        }
90	
91	    @mcp.resource("jenkins://instances/{instance_id}")
92	    def jenkins_instance(instance_id: str) -> dict:
93	        """Returns metadata for a single configured Jenkins instance."""
94	        config = multi_jenkins_manager.instances_config.get(instance_id)
95	        if not config:
96	            return {
97	                "instance_id": instance_id,
98	                "status": "not_configured",
99	                "message": f"No Jenkins instance configured for key '{instance_id}'",
100	            }
101	        return {
102	            "instance_id": instance_id,
103	            "status": "configured",
104	            "uri": f"jenkins://instances/{instance_id}",
105	            "url": config.url,
106	            "display_name": config.display_name or instance_id,
107	            "description": config.description or f"Jenkins instance: {config.url}",
108	            "has_credentials": bool(config.token),
109	        }
110	
111	    @mcp.resource("jenkins://info")
112	    def jenkins_instances_info() -> dict:
113	        """Lists all available Jenkins instances with their URLs and descriptions"""
114	        instances = {}
115	        for instance_id, config in multi_jenkins_manager.instances_config.items():
116	            instances[instance_id] = {
117	                "url": config.url,
118	                "display_name": config.display_name or instance_id,
119	                "description": config.description or f"Jenkins instance: {config.url}",
120	                "username": config.username,
121	            }
122	        return {
123	            "available_instances": instances,
124	            "total": len(instances),
125	            "usage": "Reference Jenkins instances by URL - credentials will be automatically resolved",
126	        }
127	
128	    @mcp.resource("jenkins://resolve/{url}")
129	    def resolve_jenkins_url(url: str) -> dict:
130	        """Resolves a Jenkins URL to find the corresponding instance configuration"""
131	        # Clean up the URL (remove trailing slashes, normalize)
132	        clean_url = url.rstrip("/")
133	        if not clean_url.startswith(("http://", "https://")):
134	            clean_url = f"https://{clean_url}"
135	
136	        # Find matching instance
137	        for instance_id, config in multi_jenkins_manager.instances_config.items():
138	            config_url = config.url.rstrip("/")
139	            if clean_url == config_url:
140	                return {
141	                    "instance_id": instance_id,
142	                    "url": config.url,
143	                    "display_name": config.display_name or instance_id,
144	                    "description": config.description,
145	                    "username": config.username,
146	                    "has_credentials": bool(config.token),
147	                    "status": "configured",
148	                }
149	
150	        return {
151	            "instance_id": None,
152	            "url": clean_url,
153	            "status": "not_configured",
154	            "message": f"No credentials configured for {clean_url}",
155	            "available_instances": list(multi_jenkins_manager.instances_config.keys()),
156	        }
157	
