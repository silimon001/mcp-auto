27	function findPython() {
28	    const isWindows = process.platform === 'win32';
29	    const pythonCommands = isWindows 
30	        ? ['python', 'python3', 'py']
31	        : ['python3', 'python'];
32	    
33	    for (const cmd of pythonCommands) {
34	        try {
35	            const result = spawnSync(cmd, ['--version'], {
36	                stdio: 'pipe',
37	                windowsHide: true
38	            });
39	            if (result.status === 0) {
40	                return cmd;
41	            }
42	        } catch (e) {
43	            continue;
44	        }
45	    }
46	    return null;
47	}
48	
49	const pythonCmd = findPython();
50	
51	if (!pythonCmd) {
52	    console.error('Error: Python not found. Please install Python 3.8+');
53	    console.error('  Windows: https://www.python.org/downloads/');
54	    console.error('  macOS:   brew install python3');
55	    console.error('  Linux:   apt install python3 / yum install python3');
56	    process.exit(1);
57	}
58	
59	// Add package root to PYTHONPATH so Python can find beads_village module
60	const packageRoot = path.join(__dirname, '..');
61	const existingPythonPath = process.env.PYTHONPATH || '';
62	const pathSeparator = process.platform === 'win32' ? ';' : ':';
63	const newPythonPath = existingPythonPath 
64	    ? `${packageRoot}${pathSeparator}${existingPythonPath}`
65	    : packageRoot;
66	
67	const server = spawn(pythonCmd, ['-m', 'beads_village.server'], {
68	    stdio: ['pipe', 'pipe', 'inherit'],
69	    env: {
70	        ...process.env,
71	        PYTHONPATH: newPythonPath,
72	        PYTHONUNBUFFERED: '1',
73	        PYTHONIOENCODING: 'utf-8'
74	    },
75	    windowsHide: true
76	});
77	
78	process.stdin.pipe(server.stdin);
79	server.stdout.pipe(process.stdout);
80	
81	server.on('error', (err) => {
82	    console.error('Failed to start server:', err.message);
83	    process.exit(1);
84	});
85	
86	server.on('close', (code) => {
87	    process.exit(code || 0);
88	});
