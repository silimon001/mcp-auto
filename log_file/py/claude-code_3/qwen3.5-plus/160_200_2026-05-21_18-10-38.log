1	#!/usr/bin/env python3
2	# -*- coding: utf-8 -*-
3	
4	"""
5	MCP Server for Deep Research Agent
6	
7	This module provides an MCP (Model Context Protocol) server interface for the
8	Deep Research Agent. It exposes research capabilities through standardized MCP
9	tools that can be used by AI assistants and other MCP‑compatible clients.
10	
11	Transports:
12	- stdio (default) — for editors/CLIs that spawn a local process
13	- http (streaming) — runs a local HTTP server with streaming responses so
14	  MCP‑over‑HTTP clients can connect over the network
15	
16	Features:
17	- Deep research with multiple backend providers (OpenAI Responses API, Gemini Deep Research, Open Deep Research)
18	- Clarification workflows to improve research quality
19	- Task status monitoring for long‑running research
20	- Configurable research parameters and system instructions
21	- Support for data analysis and visualization capabilities
22	
23	Exposed tools:
24	- deep_research: Main research tool with optional clarification
25	- research_with_context: Research using clarification answers
26	- research_status: Monitor task progress
27	
28	Quick start:
29	    # stdio (default)
30	    uv run deep-research-mcp
31	
32	    # HTTP streaming (bind to 127.0.0.1:8080)
33	    uv run deep-research-mcp --transport http --host 127.0.0.1 --port 8080
34	
35	Note: In HTTP mode, responses are streamed by the underlying FastMCP HTTP
36	server. The tools in this module currently return their full results when a
37	research task completes; clients that support streaming will still benefit from
38	the HTTP transport and any incremental events emitted by the server.
39	
40	Based on the deep research patterns from:
41	https://cookbook.openai.com/examples/deep_research_api/introduction_to_deep_research_api_agents
42	"""
43	
44	import argparse
45	import asyncio
46	import logging
47	from contextlib import suppress
48	from typing import Annotated, Literal, cast
49	
50	from mcp.server.fastmcp import Context, FastMCP

