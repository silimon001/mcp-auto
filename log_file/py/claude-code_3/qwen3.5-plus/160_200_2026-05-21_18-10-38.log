201	    def format_for_llm(self) -> str:
202	        """Format tool information for LLM.
203	
204	        Returns:
205	            A formatted string describing the tool.
206	        """
207	        args_desc = []
208	        if "properties" in self.input_schema:
209	            for param_name, param_info in self.input_schema["properties"].items():
210	                arg_desc = (
211	                    f"- {param_name}: {param_info.get('description', 'No description')}"
212	                )
213	                if param_name in self.input_schema.get("required", []):
214	                    arg_desc += " (required)"
215	                args_desc.append(arg_desc)
216	
217	        return f"""
218	Tool: {self.name}
219	Description: {self.description}
220	Arguments:
221	{chr(10).join(args_desc)}
222	"""
