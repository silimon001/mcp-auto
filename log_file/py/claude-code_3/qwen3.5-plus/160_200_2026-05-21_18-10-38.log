77	    "pytest-asyncio>=1.1.0",
78	    "pytest-cov>=6.2.1",
79	    "pytest-mock>=3.12.0",
80	    "coverage>=7.10.1",
81	]
82	
83	# Testing configuration
84	[tool.pytest.ini_options]
85	testpaths = ["tests"]
86	python_files = ["test_*.py"]
87	python_classes = ["Test*"]
88	python_functions = ["test_*"]
89	addopts = [
90	    "--strict-markers",
91	    "--strict-config",
92	    "--verbose",
93	    "--cov=src",
94	    "--cov-report=html",
95	    "--cov-report=term",
96	    "--cov-report=xml",
97	    "--cov-fail-under=80",
98	]
99	markers = [
100	    "unit: marks tests as unit tests",
101	    "integration: marks tests as integration tests",
102	    "slow: marks tests as slow running",
103	]
104	asyncio_mode = "auto"
105	filterwarnings = [
106	    "ignore::DeprecationWarning",
107	    "ignore::PendingDeprecationWarning",
108	]
109	
