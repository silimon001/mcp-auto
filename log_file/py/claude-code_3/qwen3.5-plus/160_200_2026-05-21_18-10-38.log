8	const http = require('http');
9	const readline = require('readline');
10	
11	/**
12	 * Determine the hostname and port for backend connection
13	 */
14	function getBackendConnectionInfo(config, logger) {
15	  const hostname = config.BACKEND_HOST;
16	  
17	  // If connecting to localhost, use host port; otherwise use internal port
18	  const isLocalhost = hostname === 'localhost' || hostname === '127.0.0.1';
19	  const port = isLocalhost ? config.HTTP_HOST_PORT : config.HTTP_PORT;
20	  
21	  logger.debug(`Backend connection: ${hostname}:${port} (localhost=${isLocalhost})`);
22	  return { hostname, port };
23	}
24	
25	/**
26	 * Check if backend service is available via HTTP ping
27	 */
28	function checkBackendAvailability(config, logger) {
29	  return new Promise((resolve) => {
30	    const { hostname, port } = getBackendConnectionInfo(config, logger);
31	    
32	    logger.info(`Checking backend at ${hostname}:${port}${config.PING_ENDPOINT}`);
33	    
34	    const options = {
35	      hostname,
36	      port,
37	      path: config.PING_ENDPOINT,
38	      method: 'GET',
39	      timeout: 5000
40	    };
41	    
42	    const req = http.request(options, (res) => {
43	      let body = '';
44	      res.on('data', chunk => body += chunk);
45	      res.on('end', () => {
46	        if (res.statusCode === 200 && body.length > 0) {
47	          logger.info(`Backend available. Response: ${body.trim()}`);
48	          resolve(true);
49	        } else {
50	          logger.warn(`Backend ping failed. Status: ${res.statusCode}`);
51	          resolve(false);
52	        }
53	      });
54	    });
55	    
56	    req.on('timeout', () => {
57	      logger.warn('Backend ping timed out');
58	      req.destroy();
59	      resolve(false);
60	    });
61	    
62	    req.on('error', (error) => {
63	      logger.warn(`Backend ping error: ${error.message}`);
64	      resolve(false);
65	    });
66	    
67	    req.end();
68	  });
69	}
70	
71	/**
72	 * Make HTTP request to backend
73	 */
74	function makeHttpRequest(options, body, callback, logPrefix, logger) {
75	  const prefix = logPrefix ? `[${logPrefix}] ` : '';
76	  const timeoutMs = Number.isFinite(options.timeoutMs) ? options.timeoutMs : 10000;
77	  
78	  logger.debug(`${prefix}${options.method} http://${options.hostname}:${options.port}${options.path}`);
79	  if (body) {
80	    logger.debug(`${prefix}Body: ${body.substring(0, 200)}${body.length > 200 ? '...' : ''}`);
81	  }
82	  
83	  const req = http.request(options, (res) => {
84	    let data = '';
85	    
86	    res.on('data', chunk => data += chunk);
87	    
88	    res.on('end', () => {
89	      logger.debug(`${prefix}Response: ${res.statusCode}, ${data.substring(0, 200)}${data.length > 200 ? '...' : ''}`);
90	      
91	      // Follow redirects
92	      if ([301, 302, 303, 307, 308].includes(res.statusCode) && res.headers.location) {
93	        logger.info(`${prefix}Following redirect to: ${res.headers.location}`);
94	        const redirectOptions = { ...options, path: res.headers.location };
95	        if (res.statusCode === 303) redirectOptions.method = 'GET';
96	        return makeHttpRequest(redirectOptions, null, callback, logPrefix, logger);
97	      }
98	      
99	      callback(null, {
100	        content: data,
101	        statusCode: res.statusCode,
102	        headers: res.headers,
103	        finalUrl: options.path
104	      });
105	    });
106	  });
107	  
108	  req.on('error', (error) => {
109	    logger.error(`${prefix}Request error: ${error.message}`);
110	    callback(error);
111	  });
112	  
113	  req.setTimeout(timeoutMs, () => {
114	    logger.error(`${prefix}Request timed out`);
115	    req.destroy();
116	    callback(new Error('Request timed out'));
117	  });
118	  
119	  if (body && ['POST', 'PUT', 'PATCH'].includes(options.method)) {
120	    req.write(body);
121	  }
122	  
123	  req.end();
124	}
125	
126	/**
127	 * Start MCP wrapper - stdio JSON-RPC server
128	 */
129	function startMcpWrapper(config, logger, handlers) {
130	  logger.info('Starting MCP stdio server');
131	  
132	  process.stdin.setEncoding('utf8');
133	  
134	  const rl = readline.createInterface({
135	    input: process.stdin,
136	    output: process.stdout,
137	    terminal: false
138	  });
139	  
140	  rl.on('line', (line) => {
141	    logger.debug(`Received: ${line}`);
142	    
143	    try {
144	      const request = JSON.parse(line);
145	      
146	      // Handle notifications (no response needed)
147	      if (request.method && request.method.startsWith('notifications/')) {
148	        logger.debug(`Notification: ${request.method}`);
149	        return;
150	      }
151	      
152	      // Handle methods
153	      switch (request.method) {
154	        case 'initialize':
155	          handlers.handleInitialize(request, config, logger);
156	          break;
157	        case 'tools/call':
158	          handlers.handleToolCall(request, config, logger);
159	          break;
160	        case 'tools/list':
161	          handlers.handleToolsList(request, config, logger);
162	          break;
163	        case 'resources/list':
164	          handlers.sendStandardResponse(request.id, { resources: [] }, logger);
165	          break;
166	        case 'prompts/list':
167	          handlers.sendStandardResponse(request.id, { prompts: [] }, logger);
168	          break;
169	        default:
170	          logger.warn(`Unsupported method: ${request.method}`);
171	          handlers.sendErrorResponse(request.id, -32601, `Method not supported: ${request.method}`, logger);
172	      }
173	    } catch (error) {
174	      logger.error(`Error processing request: ${error.message}`);
175	      try {
176	        const id = JSON.parse(line).id;
177	        handlers.sendErrorResponse(id, -32603, `Internal error: ${error.message}`, logger);
178	      } catch (e) {
179	        logger.error(`Could not send error response: ${e.message}`);
180	      }
181	    }
182	  });
183	  
184	  rl.on('close', () => {
185	    logger.info('stdin closed - exiting');
186	    process.exit(0);
187	  });
188	  
189	  return rl;
190	}
191	
192	module.exports = {
193	  getBackendConnectionInfo,
194	  checkBackendAvailability,
195	  makeHttpRequest,
196	  startMcpWrapper
197	};
