1	"""py-mcp-installer-service Integration Wrapper.
2	
3	This module provides a clean import wrapper for the py-mcp-installer-service
4	submodule, exposing its API for use within mcp-skillset.
5	
6	The wrapper handles sys.path manipulation to make the submodule's src directory
7	importable and re-exports all necessary classes, types, and exceptions.
8	
9	Usage:
10	    from mcp_skills.services.py_mcp_installer_wrapper import (
11	        MCPInstaller,
12	        Platform,
13	        InstallationResult,
14	    )
15	
16	Design Decision: Centralized import point
17	- All py-mcp-installer imports go through this wrapper
18	- Prevents sys.path pollution across the codebase
19	- Makes submodule dependency explicit and auditable
20	"""
21	
22	from __future__ import annotations
23	
24	import sys
25	from pathlib import Path
26	
27	
28	# Add py-mcp-installer src directory to sys.path
29	_submodule_src = Path(__file__).parent / "py_mcp_installer" / "src"
30	
31	if _submodule_src.exists() and str(_submodule_src) not in sys.path:
32	    sys.path.insert(0, str(_submodule_src))
33	
34	# Re-export core classes
35	# Re-export platform detection
36	# Re-export types
37	# Re-export exceptions
38	from py_mcp_installer import (  # noqa: E402  # noqa: E402  # noqa: E402
39	    AtomicWriteError,
