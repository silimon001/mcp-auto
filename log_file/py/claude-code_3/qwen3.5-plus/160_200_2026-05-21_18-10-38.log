1	# knowledge_mcp/mcp_server.py
2	"""FastMCP server exposing tools to interact with knowledge bases."""
3	
4	import logging
5	# import asyncio # Removed unused import
6	import json
7	from textwrap import dedent
8	from typing import List, Optional, Any, Dict, Annotated
9	
10	from pydantic import BaseModel, Field, field_validator
11	from fastmcp import FastMCP
12	
13	# Import necessary exceptions and manager types
14	from knowledge_mcp.knowledgebases import KnowledgeBaseManager, KnowledgeBaseNotFoundError, KnowledgeBaseError # Added KbManager
15	from knowledge_mcp.rag import ConfigurationError, RAGManagerError, RagManager
16	
17	logger = logging.getLogger(__name__)
18	
19	# --- Helper Function ---
20	def _wrap_result(result: Any) -> str:
21	    """Simple wrapper to ensure string output, can be enhanced."""
22	    return str(result)
23	
24	# --- Knowledge MCP Service Class ---
25	class MCP:
26	    """Encapsulates MCP tools for knowledge base interaction."""
27	    def __init__(self, rag_manager: RagManager, kb_manager: KnowledgeBaseManager):
28	        if not isinstance(rag_manager, RagManager):
29	            raise TypeError("Invalid RagManager instance provided")
30	        if not isinstance(kb_manager, KnowledgeBaseManager):
31	            raise TypeError("Invalid KnowledgeBaseManager instance provided")
32	        self.rag_manager = rag_manager
33	        self.kb_manager = kb_manager # Store kb_manager if needed for other tools
34	        self.mcp_server = FastMCP(
35	            name="Knowledge Base MCP",
36	            instructions=dedent("""
37	            Tools to query multiple custom knowledge bases using similarity search and a ranked knowledge-graph.
38	            
39	            Search modes explained:
40	            - local: Entity-specific queries - focuses on finding specific concepts, tools, or entities
41	            - global: Relationship discovery - focuses on understanding connections between different aspects  
42	            - hybrid: Cross-domain queries - combines both entity-focused and relationship-focused retrieval
43	            - mix: Integrates knowledge graph and vector retrieval
44	            - naive: Performs a basic search without advanced techniques
45	            """),
46	        )
47	        # Register tools using decorators
48	        self.mcp_server.tool(name="retrieve", description="Returns the retrieval results only. Good when the client AI needs evidence for its own chain-of-thought or wish to cross-check multiple modes/top-k values cheaply. Retrieves raw context passages from a knowledge base without synthesizing an LLM answer. Client AI must generate the answer and that increases token volume for the client AI. Faster response, good for multiple queries.")(self.retrieve)
49	        self.mcp_server.tool(name="answer", description="Returns an LLM-synthesised answer from the retrieval results. Good when you want a concise answer in one call. Uses the LLM of the mcp server to generate an answer from a knowledge base and return it with citations. Server AI must generate the answer and that increases token volume for this LLM.")(self.answer)
50	        self.mcp_server.tool(name="list_knowledgebases", description="List all available knowledge bases.")(self.list_knowledgebases)
51	        self.mcp_server.tool(name="query_local", description="Simplified local mode query - Best for entity-specific queries. Focuses on finding specific concepts, tools, or entities within your domains.")(self.query_local)
52	        self.mcp_server.tool(name="query_global", description="Simplified global mode query - Best for relationship discovery. Focuses on understanding relationships and connections between different aspects of your domains.")(self.query_global)
53	        self.mcp_server.tool(name="query_hybrid", description="Simplified hybrid mode query - Best for cross-domain queries. Combines both entity-focused and relationship-focused retrieval, ideal for comprehensive coverage spanning multiple knowledge areas.")(self.query_hybrid)
54	        self.mcp_server.run(transport="stdio")
55	        logger.info("MCP service initialized.")
56	
57	    async def retrieve(self,
58	        kb: Annotated[str, Field(description="Knowledge base to query")],
59	        query: Annotated[str, Field(description="Natural-language query.")],
60	        mode: Annotated[str, Field("mix", description='Retrieval mode ("mix", "local", "global", "hybrid", "naive", "bypass") default: "mix"')],
61	        top_k: Annotated[int, Field(30, ge=5, le=120, description="Number of query results to return (5-120). 30 is reasonable.")],
62	        ids: Annotated[Optional[List[str]], Field(None, description="Restrict search to these document IDs.")],
63	    ) -> str:
64	        """
65	        Retrieve raw context passages from a knowledge‑base without generating an LLM answer.
66	        """
67	        logger.info(f"Executing retrieve for KB '{kb}'")
68	        # Prepare kwargs for rag_manager.query
69	        query_kwargs = {'mode': mode, 'top_k': top_k, 'ids': ids}
70	        query_kwargs['only_need_context'] = True
71	        
72	        try:
73	            # Call the now async query method
74	            context_result: str = await self.rag_manager.query(
75	                kb_name=kb,
76	                query_text=query,
77	                **query_kwargs
78	            )
79	        except (KnowledgeBaseNotFoundError, ConfigurationError) as e:
80	            logger.error(f"Configuration or KB not found error during retrieve for '{kb}': {e}")
81	            raise ValueError(str(e)) from e # FastMCP expects ValueError for user input/config issues
82	        except RAGManagerError as e:
83	            logger.error(f"Runtime RAG error during retrieve for '{kb}': {e}", exc_info=True)
84	            raise RuntimeError(f"Query failed: {e}") from e # FastMCP expects RuntimeError for internal server errors
85	        except Exception as e:
86	            logger.exception(f"Unexpected error during kb_retrieve for '{kb}': {e}")
87	            raise RuntimeError(f"An unexpected error occurred: {e}") from e
88	
89	        return _wrap_result(context_result)
90	
91	    async def answer(self, 
92	        kb: Annotated[str, Field(description="Knowledge base to query")],
93	        query: Annotated[str, Field(description="Natural-language query.")],
94	        mode: Annotated[str, Field("mix", description='Retrieval mode ("mix", "local", "global", "hybrid", "naive", "bypass") default: "mix"')],
95	        top_k: Annotated[int, Field(30, ge=5, le=120, description="Number of query results to return (5-120). 30 is reasonable.")],
96	        response_type: Annotated[str, Field("Multiple Paragraphs", description='Answer style ("Multiple Paragraphs", "Single Paragraph", "Bullet Points").')],
97	        ids: Annotated[Optional[List[str]], Field(None, description="Restrict search to these document IDs.")],
98	    ) -> str:
99	        """
100	        Generate an LLM‑written answer using the chosen knowledge‑base and return it with citations.
101	        """
102	        logger.info(f"Executing answer for KB '{kb}'")
103	        # Prepare kwargs for rag_manager.query
104	        query_kwargs = {'mode': mode, 'top_k': top_k, 'response_type': response_type, 'ids': ids}
105	        query_kwargs['only_need_context'] = False
106	
107	        try:
108	            # Call the now async query method
109	            answer: str = await self.rag_manager.query(
110	                kb_name=kb,
111	                query_text=query,
112	                **query_kwargs
113	            )
114	        except (KnowledgeBaseNotFoundError, ConfigurationError) as e:
115	            logger.error(f"Configuration or KB not found error during kb_answer for '{kb}': {e}")
116	            raise ValueError(str(e)) from e
117	        except RAGManagerError as e:
118	            logger.error(f"Runtime RAG error during kb_answer for '{kb}': {e}", exc_info=True)
119	            raise RuntimeError(f"Query failed: {e}") from e
120	        except Exception as e:
121	            logger.exception(f"Unexpected error during kb_answer for '{kb}': {e}")
122	            raise RuntimeError(f"An unexpected error occurred: {e}") from e
123	
124	        return _wrap_result(answer)
