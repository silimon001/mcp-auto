42	
43	const { program } = require('commander');
44	const { createLogger } = require('./lib/logger');
45	const { loadConfig } = require('./lib/config');
46	const { checkBackendAvailability, startMcpWrapper } = require('./lib/server');
47	const handlers = require('./handlers');
48	
49	// Parse command line arguments
50	program
51	    .option('-H, --backend-host <host>', 'Backend server host (default: 127.0.0.1)')
52	    .option('--http-host-port <port>', 'HTTP port on host system (default: 9081)')
53	    .option('--http-port <port>', 'HTTP port inside container (default: 9080)')
54	    .option('--swank-host-port <port>', 'SWANK port on host system (for documentation)')
55	    .option('--swank-port <port>', 'SWANK port inside container (for documentation)')
56	    .option('--log-file <path>', 'Path to log file (default: /tmp/lisply-mcp-wrapper.log)')
57	    .option('--debug', 'Enable debug logging')
58	    .option('--endpoint-prefix <prefix>', 'Prefix for all endpoints (default: lisply)')
59	    .option('--lisp-eval-endpoint <n>', 'Endpoint name for Lisp evaluation (default: lisp-eval)')
60	    .option('--http-request-endpoint <n>', 'Endpoint name for HTTP requests (default: http-request)')
61	    .option('--ping-endpoint <n>', 'Endpoint name for ping (default: ping-lisp)')
62	    .option('--server-name <n>', 'MCP server name for tool prefixing (default: lisply-mcp)')
