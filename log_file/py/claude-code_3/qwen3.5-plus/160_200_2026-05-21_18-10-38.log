1	"""
2	Configuration management for Velociraptor MCP Server.
3	"""
4	
5	import logging
6	import os
7	from dataclasses import dataclass, field
8	from typing import List
9	
10	
11	@dataclass
12	class VelociraptorConfig:
13	    """Configuration for a Velociraptor server instance."""
14	
15	    api_key: str  # Path to api.config.yaml file or direct API key
16	    ssl_verify: bool = True
17	    timeout: int = 30
18	
19	    @classmethod
20	    def from_env(cls, prefix: str = "VELOCIRAPTOR") -> "VelociraptorConfig":
21	        """Create configuration from environment variables."""
22	        return cls(
23	            api_key=os.getenv(f"{prefix}_API_KEY", ""),
24	            ssl_verify=os.getenv(f"{prefix}_SSL_VERIFY", "true").lower()
25	            not in {"0", "false", "no"},
26	            timeout=int(os.getenv(f"{prefix}_TIMEOUT", "30")),
27	        )
28	
29	    def validate(self) -> None:
30	        """Validate configuration."""
31	        if not self.api_key:
32	            raise ValueError("Velociraptor API key/config path is required")
33	        # If api_key looks like a file path, validate it exists
34	        if self.api_key.endswith(".yaml") or self.api_key.endswith(".yml"):
35	            if not os.path.exists(self.api_key):
36	                raise ValueError(f"Velociraptor API config file not found: {self.api_key}")
37	
38	
39	@dataclass
40	class ServerConfig:
41	    """Configuration for the MCP server."""
42	
43	    host: str = "127.0.0.1"
44	    port: int = 8000
45	    log_level: str = "INFO"
46	    disabled_tools: List[str] = field(default_factory=list)
47	    disabled_categories: List[str] = field(default_factory=list)
48	    read_only: bool = False
49	
50	    @classmethod
51	    def from_env(cls) -> "ServerConfig":
52	        """Create configuration from environment variables."""
53	        disabled_tools = []
54	        if tools_str := os.getenv("VELOCIRAPTOR_DISABLED_TOOLS"):
55	            disabled_tools = [tool.strip() for tool in tools_str.split(",")]
56	
57	        disabled_categories = []
58	        if categories_str := os.getenv("VELOCIRAPTOR_DISABLED_CATEGORIES"):
59	            disabled_categories = [cat.strip() for cat in categories_str.split(",")]
60	
61	        return cls(
62	            host=os.getenv("MCP_SERVER_HOST", "127.0.0.1"),
63	            port=int(os.getenv("MCP_SERVER_PORT", "8000")),
64	            log_level=os.getenv("LOG_LEVEL", "INFO"),
65	            disabled_tools=disabled_tools,
66	            disabled_categories=disabled_categories,
67	            read_only=os.getenv("VELOCIRAPTOR_READ_ONLY", "false").lower() in {"1", "true", "yes"},
68	        )
69	
70	
71	@dataclass
72	class Config:
73	    """Main configuration class."""
74	
75	    velociraptor: VelociraptorConfig
76	    server: ServerConfig
77	
78	    @classmethod
79	    def from_env(cls) -> "Config":
80	        """Create configuration from environment variables."""
81	        return cls(velociraptor=VelociraptorConfig.from_env(), server=ServerConfig.from_env())
82	
83	    def validate(self) -> None:
84	        """Validate all configuration."""
