897	def create_server(config: Config = None) -> VelociraptorMCPServer:
898	    """Factory function to create a VelociraptorMCPServer instance."""
899	    if config is None:
900	        config = Config.from_env()
901	
902	    config.validate()
903	    config.setup_logging()
904	
905	    return VelociraptorMCPServer(config)
