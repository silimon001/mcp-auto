159	def register_tool_with_mcp(mcp: FastMCP, tool) -> None:
160	    """Register a standardized tool with FastMCP"""
161	
162	    # Create wrapper function that matches FastMCP's expected signature
163	    # Instead of **kwargs, we need to create a function with the exact parameters
164	
165	    # Build function signature dynamically
166	    def create_tool_wrapper():
167	        # Create a function string that FastMCP can properly inspect
168	        # Separate required and optional parameters to ensure correct ordering
169	        required_params = []
170	        optional_params = []
171	
172	        for param in tool.parameters:
173	            param_str = f"{param.name}: {param.param_type.__name__}"
174	            if param.required:
175	                required_params.append(param_str)
176	            else:
177	                if param.default is not None:
178	                    param_str += f" = {repr(param.default)}"
179	                else:
180	                    param_str += " = None"
181	                optional_params.append(param_str)
182	
183	        # Combine with required params first, optional params last
184	        params = required_params + optional_params
185	
186	        func_signature = f"async def tool_wrapper({', '.join(params)}):"
187	
188	        # Create the function code
189	        kwargs_assignments = "\n".join(
190	            [f"    kwargs['{param.name}'] = {param.name}" for param in tool.parameters]
191	        )
192	
193	        func_code = f"""{func_signature}
194	    # Build kwargs dict from individual parameters
195	    kwargs = {{}}
196	{kwargs_assignments}
197	    
198	    # Execute the tool
199	    result = tool.execute(**kwargs)
200	    if result.success:
201	        return result.data
202	    else:
203	        raise Exception(f"{{result.error_type}}: {{result.error_message}}")
204	"""
205	
206	        # Create local namespace with tool reference
207	        namespace = {"tool": tool}
208	
209	        # Execute the function definition
210	        exec(func_code, namespace)
211	
212	        return namespace["tool_wrapper"]
213	
214	    # Create the wrapper function
215	    tool_wrapper = create_tool_wrapper()
216	
217	    # Set function name and docstring
218	    tool_wrapper.__name__ = tool.name
219	    tool_wrapper.__doc__ = tool.description
220	
221	    # Register with MCP using the decorator
222	    mcp.tool(tool.name, tool.description)(tool_wrapper)
223	
