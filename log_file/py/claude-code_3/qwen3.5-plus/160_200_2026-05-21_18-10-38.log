378	        try:
379	            config = load_config_from_yaml(args.config)
380	            print(f"Loaded configuration from: {args.config}", file=sys.stderr)
381	        except Exception as e:
382	            print(f"Failed to load config from {args.config}: {e}", file=sys.stderr)
383	            sys.exit(1)
384	
385	    server = create_server(config, args.config, host=args.host, port=args.port)
386	
387	    try:
388	        if args.transport in ["sse", "streamable-http"]:
389	            print(
390	                f"Starting Jenkins MCP Server (FastMCP) on {args.host}:{args.port} with {args.transport} transport...",
391	                file=sys.stderr,
392	            )
393	        else:
394	            print(
395	                "Starting Jenkins MCP Server (FastMCP) with stdio transport...",
396	                file=sys.stderr,
397	            )
398	
399	        sys.stderr.flush()
400	        server.run(transport=args.transport, mount_path=args.mount_path)
401	    except KeyboardInterrupt:
402	        print(
403	            "\nJenkins MCP Server shutting down due to KeyboardInterrupt...",
404	            file=sys.stderr,
405	        )
406	        sys.stderr.flush()
407	    except EOFError:
408	        print(
409	            "Jenkins MCP Server shutting down due to EOF on stdin (e.g., client disconnected).",
410	            file=sys.stderr,
411	        )
412	        sys.stderr.flush()
413	    except BrokenPipeError:
414	        print(
415	            "Jenkins MCP Server shutting down due to BrokenPipeError (e.g., client closed connection).",
416	            file=sys.stderr,
417	        )
418	        try:
419	            sys.stderr.flush()
420	        except:
421	            pass
422	    except Exception as e:
423	        import traceback
424	
425	        print(
426	            f"An unhandled error occurred in server.run, causing server shutdown: {e}",
427	            file=sys.stderr,
428	        )
429	        traceback.print_exc(file=sys.stderr)
430	        sys.stderr.flush()
431	    finally:
432	        print("Jenkins MCP Server run loop finished. Cleaning up...", file=sys.stderr)
433	        print("Jenkins MCP Server stopped.", file=sys.stderr)
434	        sys.stderr.flush()
