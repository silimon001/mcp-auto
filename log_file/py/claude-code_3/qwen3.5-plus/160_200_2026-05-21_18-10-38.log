78	    from src.tools import versions        # 2 tools: list, create
79	    from src.tools import weekly_reports   # 4 tools: generate_weekly_report, get_report_data, generate_this_week_report, generate_last_week_report
80	    from src.tools import news             # 5 tools: list_news, create_news, get_news, update_news, delete_news
81	
