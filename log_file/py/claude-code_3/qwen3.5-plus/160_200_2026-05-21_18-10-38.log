66	class Server:
67	    """Manages MCP server connections and tool execution."""
68	
69	    def __init__(self, name: str, config: dict[str, Any]) -> None:
70	        self.name: str = name
71	        self.config: dict[str, Any] = config
72	        self.stdio_context: Any | None = None
73	        self.session: ClientSession | None = None
74	        self._cleanup_lock: asyncio.Lock = asyncio.Lock()
75	        self.exit_stack: AsyncExitStack = AsyncExitStack()
76	
77	    async def initialize(self) -> None:
78	        """Initialize the server connection."""
79	        command = (
80	            shutil.which("npx")
81	            if self.config["command"] == "npx"
82	            else self.config["command"]
83	        )
84	        if command is None:
85	            raise ValueError("The command must be a valid string and cannot be None.")
86	
87	        server_params = StdioServerParameters(
88	            command=command,
89	            args=self.config["args"],
90	            env={**os.environ, **self.config["env"]}
91	            if self.config.get("env")
92	            else None,
93	        )
94	        
95	        try:
96	            stdio_transport = await self.exit_stack.enter_async_context(
97	                stdio_client(server_params)
98	            )
99	            read, write = stdio_transport
100	            session = await self.exit_stack.enter_async_context(
101	                ClientSession(read, write)
102	            )
103	            await session.initialize()
104	            self.session = session
105	        except Exception as e:
106	            logging.error(f"Error initializing server {self.name}: {e}")
107	            await self.cleanup()
108	            raise
109	
110	
111	    async def list_tools(self) -> list[Any]:
112	        """List available tools from the server.
113	
114	        Returns:
115	            A list of available tools.
116	
117	        Raises:
118	            RuntimeError: If the server is not initialized.
119	        """
120	        if not self.session:
121	            raise RuntimeError(f"Server {self.name} not initialized")
122	
123	        tools_response = await self.session.list_tools()
124	        tools = []
125	
126	        for item in tools_response:
127	            if isinstance(item, tuple) and item[0] == "tools":
128	                tools.extend(
129	                    Tool(tool.name, tool.description, tool.inputSchema)
130	                    for tool in item[1]
131	                )
132	
133	        return tools
