135	    async def execute_tool(
136	        self,
137	        tool_name: str,
138	        arguments: dict[str, Any],
139	        retries: int = 2,
140	        delay: float = 1.0,
141	    ) -> Any:
142	        """Execute a tool with retry mechanism.
143	
144	        Args:
145	            tool_name: Name of the tool to execute.
146	            arguments: Tool arguments.
147	            retries: Number of retry attempts.
148	            delay: Delay between retries in seconds.
149	
150	        Returns:
151	            Tool execution result.
152	
153	        Raises:
154	            RuntimeError: If server is not initialized.
155	            Exception: If tool execution fails after all retries.
156	        """
157	        if not self.session:
158	            raise RuntimeError(f"Server {self.name} not initialized")
159	
160	        attempt = 0
161	        while attempt < retries:
162	            try:
163	                logging.info(f"Executing {tool_name}...")
164	                result = await self.session.call_tool(tool_name, arguments)
165	
166	                return result
167	
168	            except Exception as e:
169	                attempt += 1
170	                logging.warning(
171	                    f"Error executing tool: {e}. Attempt {attempt} of {retries}."
172	                )
173	                if attempt < retries:
174	                    logging.info(f"Retrying in {delay} seconds...")
175	                    await asyncio.sleep(delay)
176	                else:
177	                    logging.error("Max retries reached. Failing.")
178	                    raise
179	
