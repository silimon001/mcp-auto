242	def load_config_from_yaml(config_path: str) -> MCPConfig:
243	    """Load configuration from YAML file"""
244	    config_file = Path(config_path)
245	    if not config_file.exists():
246	        raise FileNotFoundError(f"Config file not found: {config_path}")
247	
248	    with open(config_file, "r") as f:
249	        config_data = yaml.safe_load(f)
250	
251	    # Extract a single Jenkins instance for backward compatibility.
252	    #
253	    # The runtime server uses MultiJenkinsManager for the real multi-instance
254	    # behavior, but several legacy components still require an MCPConfig with a
255	    # concrete JenkinsConfig. Prefer `default_instance` when present. Otherwise
256	    # derive the legacy view from `settings.fallback_instance` or the first
257	    # configured `jenkins_instances` entry.
258	    default_inst = config_data.get("default_instance", {})
259	    if not default_inst:
260	        settings_data = config_data.get("settings", {})
261	        jenkins_instances = config_data.get("jenkins_instances", {}) or {}
262	        fallback_instance = settings_data.get("fallback_instance")
263	
264	        if fallback_instance and fallback_instance in jenkins_instances:
265	            default_inst = jenkins_instances[fallback_instance]
266	        elif jenkins_instances:
267	            first_instance_key = next(iter(jenkins_instances))
268	            default_inst = jenkins_instances[first_instance_key]
269	
270	    jenkins_config = JenkinsConfig(
271	        url=default_inst.get("url", ""),
272	        username=default_inst.get("username", ""),
273	        token=default_inst.get("token", ""),
274	        timeout=default_inst.get("timeout", 30),
275	        verify_ssl=default_inst.get("verify_ssl", True),
276	    )
277	
278	    # Extract other configs
279	    vector_data = config_data.get("vector", {})
280	    vector_config = VectorConfig(
281	        host=vector_data.get(
282	            "host", vector_data.get("qdrant_host", "http://localhost:6333")
283	        ),
284	        collection_name=vector_data.get("collection_name", "jenkins-logs"),
285	        embedding_model=vector_data.get("embedding_model", "all-MiniLM-L6-v2"),
286	        chunk_size=vector_data.get("chunk_size", 50),
287	        chunk_overlap=vector_data.get("chunk_overlap", 5),
288	        top_k_default=vector_data.get("top_k_default", 5),
289	        timeout=vector_data.get("timeout", 30),
290	    )
291	
292	    cache_data = config_data.get("cache", {})
293	    cache_config = CacheConfig(
294	        base_dir=Path(cache_data.get("cache_dir", "/tmp/mcp-jenkins")),
295	        max_size_mb=cache_data.get("max_size_mb", 1000),
296	        retention_days=cache_data.get("retention_days", 7),
297	        enable_compression=cache_data.get("compression", True),
298	    )
299	
300	    server_data = config_data.get("server", {})
301	    server_config = ServerConfig(
302	        transport=server_data.get("transport", "stdio"),
303	        log_level=server_data.get("log_level", "INFO"),
304	        log_file=server_data.get("log_file", ""),
305	    )
306	
307	    cleanup_data = config_data.get("cleanup", {})
308	    cleanup_config = CleanupConfig(
309	        schedule_interval_hours=cleanup_data.get("interval_hours", 24),
310	        retention_days=cleanup_data.get("retention_days", 7),
311	        max_concurrent_cleanups=cleanup_data.get("max_concurrent", 5),
312	    )
313	
314	    return MCPConfig(
315	        jenkins=jenkins_config,
316	        cache=cache_config,
317	        vector=vector_config,
318	        server=server_config,
319	        cleanup=cleanup_config,
320	    )
