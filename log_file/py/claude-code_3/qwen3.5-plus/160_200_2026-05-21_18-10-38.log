101	class VelociraptorMCPServer:
102	    """Main MCP server for Velociraptor integration."""
103	
104	    def __init__(self, config: Config) -> None:
105	        self.config = config
106	        self._client: Optional[VelociraptorClient] = None
107	        self.app = FastMCP(name="Velociraptor MCP Server", version="0.1.0")
108	
109	        # Register tools
110	        self._register_tools()
111	
112	    def _get_client(self) -> VelociraptorClient:
113	        """Get or create Velociraptor client."""
114	        if self._client is None:
115	            self._client = VelociraptorClient(self.config.velociraptor)
116	        return self._client
117	
118	    def _register_tools(self) -> None:
119	        """Register all available tools."""
120	
121	        if "AuthenticateTool" not in self.config.server.disabled_tools:
122	
123	            @self.app.tool(
124	                name="AuthenticateTool",
125	                description="Initialize and test connection to Velociraptor server. This tool requires no parameters and will establish a gRPC connection for subsequent API calls using the api.config.yaml file.",
126	            )
127	            async def authenticate_tool(args: AuthenticateArgs):
128	                """Initialize and test connection to Velociraptor server.
129	
130	                This tool does not require any parameters. Simply call it to initialize
131	                the gRPC connection and test authentication with the Velociraptor server
132	                using the configured api.config.yaml file.
133	
134	                Returns:
135	                    Success message with connection details or error message.
136	                """
137	                try:
138	                    client = self._get_client()
139	                    result = await client.authenticate()
140	                    return [
141	                        {
142	                            "type": "text",
143	                            "text": f"Authentication successful: {json.dumps(result, indent=2)}",
144	                        },
145	                    ]
146	                except Exception as e:
147	                    logger.error("Authentication failed: %s", e)
148	                    return [{"type": "text", "text": f"Authentication failed: {str(e)}"}]
149	
150	        if "GetAgentInfo" not in self.config.server.disabled_tools:
151	
152	            @self.app.tool(
153	                name="GetAgentInfo",
154	                description="Retrieve detailed information about a Velociraptor client by hostname or FQDN. This tool searches for a client using the provided hostname and returns comprehensive client details including ID, OS information, agent version, and connection status.",
155	            )
156	            async def get_agent_info_tool(args: GetAgentInfoArgs):
157	                """Return detailed information about a Velociraptor client by hostname.
158	
159	                This tool searches for a client using the provided hostname or FQDN and returns
160	                detailed information including client ID, operating system details, agent version,
161	                and last seen timestamps.
162	
163	                Args:
164	                    args: An object containing:
165	                        - hostname (required): Hostname or FQDN to search for
166	
167	                Example usage:
168	                    {"args": {"hostname": "workstation-01"}}
169	                    {"args": {"hostname": "server.domain.com"}}
170	
171	                Returns:
172	                    JSON object with client details or error message if not found.
173	                """
174	                try:
175	                    client = self._get_client()
176	
177	                    # Ensure client is authenticated
178	                    if client.stub is None:
179	                        await client.authenticate()
180	
181	                    # Use the find_client_info method from the client
182	                    client_info = client.find_client_info(args.hostname)
183	
184	                    if client_info is None:
185	                        return [
186	                            {
187	                                "type": "text",
188	                                "text": f"No client found with hostname: {args.hostname}",
189	                            },
190	                        ]
191	
192	                    # Format the response
193	                    response_text = json.dumps(client_info, indent=2)
194	
195	                    return [
196	                        {
197	                            "type": "text",
198	                            "text": f"Client information for '{args.hostname}':\n{response_text}",
199	                        },
200	                    ]
201	                except Exception as e:
202	                    logger.error("Failed to get agent info: %s", e)
203	                    return [{"type": "text", "text": f"Error getting agent info: {str(e)}"}]
204	
205	        if "RunVQLQueryTool" not in self.config.server.disabled_tools:
206	
207	            @self.app.tool(
208	                name="RunVQLQueryTool",
209	                description="Execute a VQL (Velociraptor Query Language) query on the Velociraptor server. This tool allows you to run custom VQL queries to retrieve information about clients, artifacts, hunts, or any other Velociraptor data. Requires 'vql' parameter with the query string.",
210	            )
211	            async def run_vql_query_tool(args: RunVQLQueryArgs):
212	                """Execute a VQL query on the Velociraptor server.
213	
214	                VQL (Velociraptor Query Language) is a powerful query language that allows you to:
215	                - List and search clients: SELECT * FROM clients()
216	                - Query artifacts: SELECT * FROM source(artifact='Windows.System.Users')
217	                - Check flows: SELECT * FROM flows()
218	                - Hunt management: SELECT * FROM hunts()
219	                - And much more...
220	
221	                Args:
222	                    args: An object containing:
223	                        - vql (required): VQL query string to execute
224	                        - max_rows (optional): Maximum number of rows to return
225	                        - timeout (optional): Query timeout in seconds
226	
227	                Example usage:
