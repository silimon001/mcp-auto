38	    "Topic :: Text Processing :: Indexing",
39	    "Topic :: Internet :: WWW/HTTP :: Indexing/Search",
40	    "Topic :: Database",
41	    "Typing :: Typed",
42	]
43	# M30: dependency upper bounds. The MCP SDK and Pydantic ship fast and have
44	# repeatedly carried breaking changes across minor versions; cap each at the
45	# next major so a fresh ``pip install openzim-mcp`` can't silently land on a
46	# wheel-incompatible upstream. ``libzim`` is similarly tightly coupled to the
47	# Python binding ABI. tiktoken caps a major because its BPE table updates
48	# have shipped breaking changes across minors in the past. Beautifulsoup
49	# stays unpinned-upward (very stable surface).
50	dependencies = [
51	    "beautifulsoup4>=4.14.3,<5.0",
52	    "html2text>=2025.4.15,<2027.0",
53	    "libzim>=3.9.0,<4.0",
54	    "mcp[cli]>=1.27.0,<2.0",
55	    "pydantic>=2.13.3,<3.0",
56	    "pydantic-settings>=2.14.0,<3.0",
57	    "tiktoken>=0.7.0,<1.0",
58	]
59	
60	[project.optional-dependencies]
61	# Phase D sub-D-1: cross-encoder reranker via FastEmbed (ONNX-backed,
62	# no torch dependency). Adds ~150 MB install footprint. Lazy-imported
63	# inside openzim_mcp.ml.reranker; default install is unaffected.
64	reranker = [
65	    "fastembed>=0.4.0,<1.0",
66	]
67	
