231	
232	                Returns:
233	                    JSON array of query results with columns and data as returned by Velociraptor.
234	                """
235	                try:
236	                    client = self._get_client()
237	
238	                    # Ensure client is authenticated
239	                    if client.stub is None:
240	                        await client.authenticate()
241	
242	                    # Execute the VQL query using the client's run_vql_query method
243	                    results = client.run_vql_query(args.vql)
