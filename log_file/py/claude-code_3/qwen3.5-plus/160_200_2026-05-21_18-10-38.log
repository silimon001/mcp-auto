347	        "--port",
348	        type=int,
349	        default=8000,
350	        help="Port for HTTP transports (default: 8000)",
351	    )
352	    parser.add_argument(
353	        "--host",
354	        type=str,
355	        default="0.0.0.0",
356	        help="Host for HTTP transports (default: 0.0.0.0)",
357	    )
358	    args = parser.parse_args()
359	
360	    print(
361	        f"Initializing Jenkins MCP Server (FastMCP) with {args.transport} transport...",
362	        file=sys.stderr,
363	    )
364	    sys.stderr.flush()
365	
366	    # Set diagnostic config path if provided
367	    if args.diagnostic_config:
368	        import os
369	
370	        os.environ["JENKINS_MCP_DIAGNOSTIC_CONFIG"] = args.diagnostic_config
371	        print(
372	            f"Using custom diagnostic config: {args.diagnostic_config}", file=sys.stderr
373	        )
