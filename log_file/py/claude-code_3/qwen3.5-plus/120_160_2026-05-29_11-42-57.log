178	    def _register_all_tools(self):
179	        """Register all tools with the tool registry for validation and formatting"""
180	        for tool_name, tool_instance in self.local_tools.items():
181	            config = get_tool_config(tool_name)
182	            required_params = config.get("required_params", [])
183	            schema = config.get("schema", {})
184	            
185	            self.tool_registry.register_tool(
186	                tool_name=tool_name,
187	                tool_instance=tool_instance,
188	                required_params=required_params,
189	                schema=schema
190	            )
191	            logger.info(f"Registered tool: {tool_name} with validation rules")
192	    
193	    def format_tool_result_for_mcp(self, result: List[Dict[str, Any]], tool_name: str) -> Dict[str, Any]:
194	        """Format tool results using the new systematic tool registry"""
195	        try:
196	            return self.tool_registry._format_tool_response(tool_name, result)
197	        except Exception as e:
198	            logger.error(f"Error formatting tool result for {tool_name}: {e}")
199	            return {
200	                "content": [
201	                    {
202	                        "type": "text",
203	                        "text": f"❌ Error formatting results for {tool_name}: {str(e)}"
204	                    }
205	                ]
206	            }
207	    
208	    async def handle_initialize(self, message: Dict[str, Any]) -> Dict[str, Any]:
209	        """Handle initialize MCP request"""
210	        try:
211	            logger.info(f"Starting initialize handler for message: {message}")
212	            
213	            params = message.get("params", {})
214	            client_name = params.get("clientInfo", {}).get("name", "Unknown Client")
215	            client_version = params.get("clientInfo", {}).get("version", "1.0.0")
216	            
217	            logger.info(f"MCP Client initialized: {client_name} v{client_version}")
218	            
219	            response = {
220	                "jsonrpc": "2.0",
221	                "id": message.get("id"),
222	                "result": {
223	                    "protocolVersion": "2024-11-05",
224	                    "capabilities": {
225	                        "tools": {},
226	                        "resources": {},
227	                        "prompts": {}
228	                    },
229	                    "serverInfo": {
230	                        "name": "OlaXBT MCP Server",
231	                        "version": "1.0.0"
232	                    }
233	                }
234	            }
235	            
236	            logger.info(f"Initialize response prepared: {response}")
237	            return response
238	            
239	        except Exception as e:
240	            logger.error(f"Error in handle_initialize: {e}")
241	            error_response = {
242	                "jsonrpc": "2.0",
243	                "id": message.get("id"),
244	                "error": {
245	                    "code": "internal_error",
246	                    "message": str(e)
247	                }
248	            }
249	            logger.error(f"Initialize error response: {error_response}")
250	            return error_response
251	    
252	    async def handle_list_tools(self, message: Dict[str, Any]) -> Dict[str, Any]:
253	        """Handle tools/list MCP request"""
254	        try:
255	            tools = await self.registry.list_all_tools()
256	            local_tools = []
257	            
258	            for tool_name, tool in self.local_tools.items():
259	                local_tools.append({
260	                    "name": tool_name,
261	                    "description": tool.description,
262	                    "inputSchema": tool.input_schema
263	                })
264	            
265	            all_tools = tools + local_tools
266	            
267	            return {
268	                "jsonrpc": "2.0",
269	                "id": message.get("id"),
270	                "result": {"tools": all_tools}
271	            }
272	        except Exception as e:
273	            logger.error(f"Error in handle_list_tools: {e}")
274	            return {
275	                "jsonrpc": "2.0",
276	                "id": message.get("id"),
277	                "error": {
278	                    "code": "internal_error",
279	                    "message": str(e)
280	                }
281	            }
282	    
283	    async def handle_call_tool(self, message: Dict[str, Any]) -> Dict[str, Any]:
284	        """Handle tools/call MCP request"""
285	        try:
286	            params = message.get("params", {})
287	            tool_name = params.get("name")
288	            arguments = params.get("arguments", {})
289	            
290	            if not tool_name:
291	                return {
292	                    "jsonrpc": "2.0",
293	                    "id": message.get("id"),
294	                    "error": {
295	                        "code": "invalid_params",
296	                        "message": "Tool name is required"
297	                    }
298	                }
299	            
300	            # Check if it's a local tool
301	            if tool_name in self.local_tools:
302	                tool = self.local_tools[tool_name]
303	                result = await tool.execute(arguments)
304	                formatted_result = self.format_tool_result_for_mcp(result, tool_name)
305	                return {
306	                    "jsonrpc": "2.0",
307	                    "id": message.get("id"),
308	                    "result": formatted_result
309	                }
310	            
311	            # Route to registry for remote tools
312	            try:
313	                result = await self.registry.route_tool_call(tool_name, arguments)
314	                formatted_result = self.format_tool_result_for_mcp(result, tool_name)
315	                return {
316	                    "jsonrpc": "2.0",
317	                    "id": message.get("id"),
318	                    "result": formatted_result
319	                }
320	            except ValueError as e:
321	                return {
322	                    "jsonrpc": "2.0",
323	                    "id": message.get("id"),
324	                    "error": {
325	                        "code": "tool_not_found",
326	                        "message": str(e)
327	                    }
328	                }
329	            
330	        except Exception as e:
331	            logger.error(f"Error in handle_call_tool: {e}")
332	            return {
333	                "jsonrpc": "2.0",
334	                "id": message.get("id"),
335	                "error": {
336	                    "code": "tool_execution_error",
337	                    "message": str(e)
338	                }
339	            }
340	    
