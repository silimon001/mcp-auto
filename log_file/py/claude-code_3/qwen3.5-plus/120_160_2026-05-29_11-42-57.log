211	                print(
212	                    f"Generating embeddings for {len(texts_to_embed)} chunks...",
213	                    file=sys.stderr,
214	                )
215	                embeddings = embedding_model.encode(
216	                    texts_to_embed,
217	                    show_progress_bar=True,  # Enable progress bar
218	                )
219	                # Add embeddings back to the chunk dictionaries
220	                for i, chunk in enumerate(loaded_chunks):
221	                    chunk["embedding"] = embeddings[i]
222	            except Exception as e:
