240	            try:
241	                # Ensure parent directory exists
242	                CACHE_FILE_PATH.parent.mkdir(parents=True, exist_ok=True)
243	                # Data to cache: tuple of (metadata, chunks)
244	                # Using Any for chunk dict value type (mixed str, np.ndarray)
245	                data_to_cache: tuple[Dict[str, float], List[Dict[str, Any]]] = (
246	                    current_file_metadata,
247	                    document_chunks,
248	                )
249	                with open(CACHE_FILE_PATH, "wb") as f_cache:
250	                    pickle.dump(data_to_cache, f_cache)
