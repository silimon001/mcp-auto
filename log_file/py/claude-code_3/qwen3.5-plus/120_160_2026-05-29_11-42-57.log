1	#!/usr/bin/env python3
2	# Copyright 2026 Flyto2. Licensed under Apache-2.0. See LICENSE.
3	
4	"""
5	Flyto2 Core MCP Server — STDIO Transport
6	
7	Thin shell over mcp_handler.py for STDIO-based MCP communication.
8	
9	Usage:
10	    python -m core.mcp_server
11	
12	Claude Code config (~/.claude/mcp_servers.json):
13	{
14	    "flyto-core": {
15	        "command": "python",
16	        "args": ["-m", "core.mcp_server"],
17	        "cwd": "/path/to/flyto-core/src"
18	    }
19	}
20	"""
21	
22	import json
23	import sys
24	import os
25	import asyncio
26	from typing import Any, Dict
27	
28	from core.mcp_handler import (
29	    handle_jsonrpc_request,
30	    execute_module as _handler_execute_module,
31	    TOOLS,
32	    SERVER_VERSION,
33	)
34	
35	# Browser session store — persists BrowserDriver across MCP tool calls (STDIO-specific)
36	_browser_sessions: Dict[str, Any] = {}
37	
38	# ============================================================
39	# Host allowlist — caller MUST opt in
40	# ============================================================
41	# Earlier versions defaulted FLYTO_ALLOWED_HOSTS to
42	# "localhost,127.0.0.1" so the dev experience was friction-free. That
43	# turned MCP into a confused-deputy SSRF: an LLM client (Claude
44	# Desktop, Claude Code, anything else over STDIO) could ask the
45	# server to navigate to the host machine's own services without the
46	# operator ever opting in.
47	#
48	# Now we leave FLYTO_ALLOWED_HOSTS unset unless the caller sets it
49	# explicitly via the MCP client config:
50	#
51	#   "env": { "FLYTO_ALLOWED_HOSTS": "yourdomain.com" }
52	#
53	# Local-dev convenience is preserved by setting
54	# FLYTO_MCP_ALLOW_LOCALHOST=1 on your shell — opt-in, not implicit.
55	if os.environ.get('FLYTO_MCP_ALLOW_LOCALHOST') == '1':
56	    os.environ.setdefault('FLYTO_ALLOWED_HOSTS', 'localhost,127.0.0.1')
57	
58	
59	async def execute_module(module_id, params, context=None):
60	    """Backward-compatible wrapper that injects STDIO _browser_sessions."""
61	    return await _handler_execute_module(
62	        module_id, params, context=context, browser_sessions=_browser_sessions,
63	    )
64	
65	
66	async def async_main():
67	    """MCP Server main loop — persistent event loop for browser session survival."""
68	    loop = asyncio.get_event_loop()
69	    while True:
70	        line = await loop.run_in_executor(None, sys.stdin.readline)
71	        if not line:
72	            break  # EOF
73	        try:
74	            request = json.loads(line.strip())
75	            response = await handle_jsonrpc_request(request, _browser_sessions)
76	            if response is not None:
77	                print(json.dumps(response), flush=True)
78	        except json.JSONDecodeError:
79	            pass
80	        except Exception as e:
81	            print(json.dumps({"jsonrpc": "2.0", "error": {"code": -32000, "message": str(e)}}), flush=True)
82	
83	    # Cleanup: close all browser sessions to prevent zombie Chromium processes
84	    for session_id, driver in list(_browser_sessions.items()):
85	        try:
86	            await driver.close()
87	        except Exception:
88	            pass
89	    _browser_sessions.clear()
90	
91	
92	def main():
93	    """Entry point — runs the async main loop."""
94	    asyncio.run(async_main())
95	
96	
97	if __name__ == "__main__":
98	    main()
99	

