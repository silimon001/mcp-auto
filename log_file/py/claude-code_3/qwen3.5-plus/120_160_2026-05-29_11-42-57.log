31	        description="Whether to verify SSL certificates"
32	    )
33	    
34	    bypass_proxy: bool = Field(
35	        default=True,
36	        description="Whether to bypass proxy for localhost connections"
37	    )
38	
39	
40	class ServerConfig(BaseSettings):
41	    """Server configuration for MCP server."""
42	    
43	    log_level: str = Field(
44	        default="INFO",
45	        description="Logging level"
46	    )
47	    
48	    payload: PayloadConfig = Field(
49	        default_factory=PayloadConfig,
50	        description="Payload CMS configuration"
