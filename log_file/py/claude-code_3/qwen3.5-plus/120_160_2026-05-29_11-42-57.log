918	async def list_normalized_scenes(adapter: MijiaAdapter, home_name: str = "", home_id: str = "") -> List[Dict[str, Any]]:
919	    if home_id or home_name:
920	        home = await resolve_home(adapter, home_name=home_name, home_id=home_id)
921	        scenes = await adapter.get_scenes_list(home["home_id"])
922	        return [normalize_scene(scene, home["name"]) for scene in scenes]
923	
924	    homes = await adapter.get_homes()
925	    all_scenes: List[Dict[str, Any]] = []
926	    for home in homes:
927	        home_summary = normalize_home(home)
928	        scenes = await adapter.get_scenes_list(home_summary["home_id"])
929	        all_scenes.extend(normalize_scene(scene, home_summary["name"]) for scene in scenes)
930	    return all_scenes
