481	@mcp.resource("database://schema")
482	async def get_database_schema() -> str:
483	    """Resource that provides the complete database schema"""
484	    tables = await db_manager.list_tables()
485	    schema_info = {}
486	    for table in tables:
487	        columns = await db_manager.describe_table(table['table_name'])
488	        schema_info[table['table_name']] = columns
489	    
490	    import json
491	    return json.dumps(schema_info, indent=2)
