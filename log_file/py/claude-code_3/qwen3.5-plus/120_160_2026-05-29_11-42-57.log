448	@mcp.tool()
449	async def update_data(table_name: str, set_clause: str, where_condition: str = "") -> str:
450	    """
451	    Update data in a table.
452	    
453	    Args:
454	        table_name: Name of the table to update
455	        set_clause: SET clause (e.g., "name = 'New Name', age = 25")
456	        where_condition: WHERE clause condition (e.g., "id = 1"). If empty, ALL rows will be updated!
457	        
458	    Returns:
459	        Success message with number of rows updated
460	    """
461	    try:
462	        if where_condition.strip():
463	            update_query = f"UPDATE {table_name} SET {set_clause} WHERE {where_condition}"
464	        else:
465	            update_query = f"UPDATE {table_name} SET {set_clause}"
466	            
467	        results = await db_manager.execute_unsafe_query(update_query)
468	        affected_rows = results[0].get('affected_rows', 0) if results else 0
469	        return f"Updated {affected_rows} row(s) in '{table_name}'"
470	        
471	    except Exception as e:
472	        return f"ERROR: Error updating data: {str(e)}"
