155	                    )
156	        except Exception as e:
157	            print(
158	                f"Warning: Failed to load or validate cache ({e}). "
159	                "Regenerating cache.",
160	                file=sys.stderr,
161	            )
162	            # Don't try deletion inside the exception handler for loading
163	
164	        # --- Delete invalid/outdated cache file ---
165	        if not cache_valid and CACHE_FILE_PATH.exists():
166	            # Attempting to delete invalid/outdated cache file...
167	            try:
