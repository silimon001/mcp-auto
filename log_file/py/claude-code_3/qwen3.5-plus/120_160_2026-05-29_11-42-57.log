1	#!/usr/bin/env python3
2	"""
3	MCP Database Server using FastMCP
4	
5	This is a proper MCP server that Claude can connect to directly.
6	It provides database query capabilities through the Model Context Protocol.
7	"""
8	
9	import asyncio
10	import os
11	import sys
12	import logging
13	import argparse
14	from pathlib import Path
15	from typing import Dict, List, Any
16	
17	# Add the app directory to the path
18	# Use absolute path resolution that works both locally and in Docker
19	_script_dir = Path(__file__).resolve().parent
20	_app_dir = _script_dir / 'app'
21	if _app_dir.exists():
22	    sys.path.insert(0, str(_app_dir))
23	else:
24	    # Fallback for Docker container where app might be at /app/app
25	    sys.path.insert(0, '/app/app')
26	
27	from mcp.server import fastmcp
28	from dotenv import load_dotenv
29	
30	# Import our database functionality
31	from db import DatabaseManager
32	from nl_to_sql import NLToSQLConverter
33	
34	# Set up logging
35	logging.basicConfig(level=logging.INFO)
36	logger = logging.getLogger("mcp-database-server")
37	
38	# Load environment variables
39	load_dotenv()
40	
41	# Initialize the MCP server
42	mcp = fastmcp.FastMCP("Database Server")
43	
44	# Global variables for database connection
45	db_manager: DatabaseManager = None
46	nl_converter: NLToSQLConverter = None
47	
48	@mcp.tool()
49	async def query_database(query: str) -> str:
50	    """
51	    Execute a natural language query on the database.
52	    
53	    Args:
54	        query: Natural language description of what you want to query
55	        
56	    Returns:
57	        The query results formatted as text
58	    """
59	    try:
60	        # Get table schemas for context
61	        tables = await db_manager.list_tables()
62	        table_schemas = {}
63	        for table in tables:
64	            columns = await db_manager.describe_table(table['table_name'])
65	            table_schemas[table['table_name']] = columns
66	        
67	        # Convert natural language to SQL
68	        sql_query = nl_converter.convert_to_sql(query, table_schemas)
69	        
70	        # Execute the query
71	        results = await db_manager.execute_safe_query(sql_query)
72	        
73	        # Format the response
74	        response = f"SQL Query: {sql_query}\n\n"
75	        response += f"Results ({len(results)} rows):\n"
76	        
77	        if results:
78	            # Format as a simple table
79	            if isinstance(results[0], dict):
80	                headers = list(results[0].keys())
81	                response += " | ".join(headers) + "\n"
82	                response += " | ".join(["-" * len(h) for h in headers]) + "\n"
83	                
84	                for row in results[:20]:  # Limit to first 20 rows
85	                    values = [str(row.get(h, "")) for h in headers]
86	                    response += " | ".join(values) + "\n"
87	                
88	                if len(results) > 20:
89	                    response += f"\n... and {len(results) - 20} more rows"
90	            else:
91	                response += str(results)
92	        else:
93	            response += "No results found."
94	            
95	        return response
96	        
97	    except Exception as e:
98	        return f"Error executing query: {str(e)}"
99	
100	@mcp.tool()
101	async def list_tables() -> str:
102	    """
103	    List all tables in the database.
104	    
105	    Returns:
106	        A list of all available tables with their column counts
107	    """
108	    try:
109	        tables = await db_manager.list_tables()
110	        
111	        response = "Available Tables:\n\n"
112	        for table in tables:
113	            response += f"- {table['table_name']} ({table['column_count']} columns)\n"
114	        
115	        return response
116	        
117	    except Exception as e:
118	        return f"Error listing tables: {str(e)}"
119	
120	@mcp.tool()
121	async def describe_table(table_name: str) -> str:
122	    """
123	    Get the schema/structure of a specific database table.
124	    
125	    Args:
126	        table_name: Name of the table to describe
127	        
128	    Returns:
129	        The table schema with column names, types, and constraints
130	    """
131	    try:
132	        columns = await db_manager.describe_table(table_name)
133	        
134	        response = f"Table: {table_name}\n\n"
135	        response += "Columns:\n"
136	        for col in columns:
137	            nullable = "NULL" if col['is_nullable'] else "NOT NULL"
138	            response += f"- {col['column_name']}: {col['data_type']} ({nullable})\n"
139	        
140	        return response
141	        
142	    except Exception as e:
143	        return f"Error describing table: {str(e)}"
144	
145	@mcp.tool()
146	async def execute_sql(sql_query: str) -> str:
147	    """
148	    Execute a raw SQL query on the database.
149	    
150	    Args:
151	        sql_query: The SQL query to execute
152	        
153	    Returns:
154	        The query results formatted as text
155	    """
156	    try:
157	        # Basic safety check for destructive operations
158	        sql_lower = sql_query.lower().strip()
159	        dangerous_keywords = ['drop', 'delete', 'truncate', 'alter', 'update']
160	        
161	        for keyword in dangerous_keywords:
162	            if sql_lower.startswith(keyword):
163	                return f"Error: {keyword.upper()} operations are not allowed for safety reasons."
164	        
165	        # Execute the query
166	        results = await db_manager.execute_safe_query(sql_query)
167	        
168	        # Format the response
169	        response = f"SQL Query: {sql_query}\n\n"
170	        response += f"Results ({len(results)} rows):\n"
171	        
172	        if results:
173	            # Format as a simple table
174	            if isinstance(results[0], dict):
175	                headers = list(results[0].keys())
176	                response += " | ".join(headers) + "\n"
177	                response += " | ".join(["-" * len(h) for h in headers]) + "\n"
178	                
179	                for row in results[:20]:  # Limit to first 20 rows
180	                    values = [str(row.get(h, "")) for h in headers]
181	                    response += " | ".join(values) + "\n"
182	                
183	                if len(results) > 20:
184	                    response += f"\n... and {len(results) - 20} more rows"
185	            else:
186	                response += str(results)
187	        else:
188	            response += "No results found."
189	            
190	        return response
191	        
192	    except Exception as e:
193	        return f"Error executing SQL: {str(e)}"
194	
195	@mcp.tool()
196	async def connect_to_database(database_url: str) -> str:
197	    """
198	    Connect to a different database dynamically.
199	    
200	    Args:
201	        database_url: Database connection URL (e.g., sqlite+aiosqlite:///path/to/db.db, 
202	                     postgresql+asyncpg://user:pass@host:port/db)
203	    
204	    Returns:
205	        Connection status and available tables
206	    """
207	    global db_manager
208	    
209	    try:
210	        # Validate URL format
211	        supported_types = [
212	            'sqlite+aiosqlite://',
213	            'postgresql+asyncpg://',
214	            'mysql+aiomysql://',
215	            'mongodb://',
216	            'mongodb+srv://',
217	        ]
218	        if not any(database_url.startswith(db_type) for db_type in supported_types):
219	            return f"ERROR: Unsupported database URL format. Supported: {', '.join(supported_types)}"
220	        
221	        # Store current URL and update environment
222	        previous_url = os.getenv('DATABASE_URL', 'None')
223	        os.environ['DATABASE_URL'] = database_url
224	        
225	        # Create new database manager
226	        new_db_manager = DatabaseManager()
227	        
228	        # Test the connection
229	        connection_test = await new_db_manager.test_connection()
230	        if not connection_test:
231	            # Restore previous URL on failure
232	            if previous_url != 'None':
233	                os.environ['DATABASE_URL'] = previous_url
234	            return f"Failed to connect to database: {database_url}"
235	        
236	        # If successful, update the global manager
237	        db_manager = new_db_manager
238	        
239	        # Get table information
240	        tables = await db_manager.list_tables()
241	        table_info = [f"  - {table['table_name']} ({table['column_count']} columns)" for table in tables]
242	        
243	        response = f"Successfully connected to database!\n"
244	        response += f" Database URL: {database_url}\n"
245	        response += f" Database Type: {db_manager.database_type}\n"
246	        response += f" Available Tables ({len(tables)}):\n"
247	        response += "\n".join(table_info) if table_info else "  No tables found"
248	        
249	        logger.info(f"Dynamic database connection successful: {database_url}")
250	        return response
251	        
252	    except Exception as e:
253	        # Restore previous URL on error
254	        if 'previous_url' in locals() and previous_url != 'None':
255	            os.environ['DATABASE_URL'] = previous_url
256	        
257	        error_msg = f" Error connecting to database: {str(e)}"
258	        logger.error(f"Dynamic database connection failed: {error_msg}")
259	        return error_msg
260	
261	@mcp.tool()
262	async def get_connection_examples() -> str:
263	    """
264	    Get examples of database connection URLs for different database types.
265	    
266	    Returns:
267	        Examples of connection strings for various databases
268	    """
269	    examples = """
270	**Database Connection Examples:**
271	
272	**SQLite (Local Files):**
273	• sqlite+aiosqlite:///students.db
274	• sqlite+aiosqlite:///C:/path/to/database.db
275	• sqlite+aiosqlite:///./local_database.db
276	
277	**PostgreSQL:**
278	• postgresql+asyncpg://username:password@localhost:5432/database_name
279	• postgresql+asyncpg://user:pass@myserver.com:5432/students_db
280	• postgresql+asyncpg://postgres:admin123@127.0.0.1:5432/school
281	
282	**MySQL:**
283	• mysql+aiomysql://username:password@localhost:3306/database_name
284	• mysql+aiomysql://user:pass@mysql-server:3306/students_db
285	
286	**Cloud Databases:**
287	• postgresql+asyncpg://user:pass@host.region.rds.amazonaws.com:5432/db
288	• postgresql+asyncpg://user:pass@host.supabase.co:5432/postgres
289	
290	**Tips:**
291	- Replace 'username', 'password', 'host', 'port', 'database_name' with actual values
292	- Use URL encoding for special characters in passwords
293	- SQLite files can be relative or absolute paths
294	- Test connection with a simple database first
295	"""
296	    return examples
297	
298	@mcp.tool()
299	async def get_current_database_info() -> str:
300	    """
301	    Get information about the currently connected database.
302	    
303	    Returns:
304	        Current database connection details and statistics
305	    """
306	    try:
307	        if not db_manager:
308	            return "ERROR: No database connection established"
309	        
310	        # Test current connection
311	        is_connected = await db_manager.test_connection()
312	        if not is_connected:
313	            return "ERROR: Current database connection is not working"
314	        
315	        # Get database info
316	        current_url = os.getenv('DATABASE_URL', 'Unknown')
317	        tables = await db_manager.list_tables()
318	        
319	        # Calculate some statistics
320	        total_tables = len(tables)
321	        total_columns = sum(table['column_count'] for table in tables)
322	        
323	        response = f"**Current Database Information:**\n\n"
324	        response += f"**Connection URL:** {current_url}\n"
325	        response += f"**Database Type:** {db_manager.database_type}\n"
326	        response += f"**Status:** Connected\n"
327	        response += f"**Tables:** {total_tables}\n"
328	        response += f"**Total Columns:** {total_columns}\n\n"
329	        
330	        if tables:
331	            response += "**Table Details:**\n"
332	            for table in tables:
333	                response += f"  • {table['table_name']} ({table['column_count']} columns)\n"
334	        else:
335	            response += "**No tables found in database**\n"
336	        
337	        return response
338	        
339	    except Exception as e:
340	        return f"ERROR: Error getting database info: {str(e)}"
341	
342	@mcp.tool()
343	async def execute_unsafe_sql(sql_query: str) -> str:
344	    """
345	    Execute any SQL query without safety restrictions (allows CREATE, DELETE, INSERT, DROP, etc.).
346	    WARNING: This tool can modify or delete data. Use with caution!
347	    
348	    Args:
349	        sql_query: Any SQL query including CREATE, INSERT, UPDATE, DELETE, DROP operations
350	        
351	    Returns:
352	        The query results or success message for modification operations
353	    """
354	    try:
355	        results = await db_manager.execute_unsafe_query(sql_query)
356	        
357	        if not results:
358	            return "Query executed successfully (no results returned)"
359	        
360	        # Check if this is a modification operation
361	        if len(results) == 1 and 'query_type' in results[0] and results[0]['query_type'] == 'modification':
362	            affected_rows = results[0].get('affected_rows', 0)
363	            return f"Query executed successfully. Affected rows: {affected_rows}"
364	        
365	        # Format results for display
366	        if isinstance(results, list) and len(results) > 0:
367	            response = f"Query Results ({len(results)} rows):\n\n"
368	            for i, row in enumerate(results):
369	                response += f"Row {i+1}:\n"
370	                for key, value in row.items():
371	                    response += f"  {key}: {value}\n"
372	                response += "\n"
373	            return response
374	        else:
375	            return "Query executed successfully (no data returned)"
376	            
377	    except Exception as e:
378	        return f"ERROR: Error executing unsafe SQL: {str(e)}"
379	
380	@mcp.tool()
381	async def create_table(table_name: str, columns_definition: str) -> str:
382	    """
383	    Create a new table in the database.
384	    
385	    Args:
386	        table_name: Name of the table to create
387	        columns_definition: Column definitions (e.g., "id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INTEGER")
388	        
389	    Returns:
390	        Success message or error details
391	    """
392	    try:
393	        create_query = f"CREATE TABLE {table_name} ({columns_definition})"
394	        results = await db_manager.execute_unsafe_query(create_query)
395	        return f"Table '{table_name}' created successfully!"
396	        
397	    except Exception as e:
398	        return f"ERROR: Error creating table: {str(e)}"
