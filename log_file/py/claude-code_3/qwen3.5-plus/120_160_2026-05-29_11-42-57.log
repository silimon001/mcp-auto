1	"""MCP server implementation for Gemini CLI integration."""
2	
3	import logging
4	import os
5	from importlib import metadata
6	from logging import CRITICAL as LOG_CRITICAL
7	from logging import DEBUG as LOG_DEBUG
8	from logging import ERROR as LOG_ERROR
9	from logging import INFO as LOG_INFO
10	from logging import WARNING as LOG_WARNING
11	from pathlib import Path
12	from typing import Any
13	
14	from mcp.server import Server
15	from mcp.server.lowlevel import NotificationOptions
16	from mcp.server.models import InitializationOptions
17	from mcp.server.stdio import stdio_server
18	from mcp.types import (
19	    EmbeddedResource,
20	    ImageContent,
21	    LoggingLevel,
22	    TextContent,
23	    Tool,
24	)
25	
26	from .tools import GeminiTools
27	
28	logger = logging.getLogger(__name__)
29	
30	# Get version from package metadata
31	try:
32	    __version__ = metadata.version("gemini-mcp")
33	except Exception:
34	    __version__ = "0.1.0"  # Fallback version
35	
36	
37	class GeminiMCPServer:
38	    """MCP Server for Gemini CLI integration."""
39	
40	    def __init__(self, allowed_directories: list[str] | None = None) -> None:
41	        """Initialize the server.
42	
43	        Args:
44	            allowed_directories: List of directories that files can be read from.
45	                                If None, defaults to current working directory.
46	        """
47	        # Initialize allowed directories from environment or parameter
48	        if allowed_directories is None:
49	            # Check for environment variable
50	            env_dirs = os.environ.get("GEMINI_MCP_ALLOWED_DIRS")
51	            if env_dirs:
52	                # Use os.pathsep for platform-specific path separator
53	                allowed_directories = [d.strip() for d in env_dirs.split(os.pathsep) if d.strip()]
54	            else:
55	                # Default to current working directory
56	                allowed_directories = [str(Path.cwd())]
57	
58	        self.tools = GeminiTools(allowed_directories=allowed_directories)
59	        self.server: Server = Server("gemini-mcp")
60	
61	        # Register handlers
62	        self._register_handlers()
63	
64	    def _register_handlers(self) -> None:
65	        """Register all MCP handlers."""
66	
67	        @self.server.list_tools()  # type: ignore[misc]
68	        async def list_tools() -> list[Tool]:
69	            """List all available tools."""
70	            return self.tools.get_tool_definitions()
71	
72	        @self.server.call_tool()  # type: ignore[misc]
73	        async def call_tool(
74	            name: str, arguments: dict[str, Any] | None = None
75	        ) -> list[TextContent | ImageContent | EmbeddedResource]:
76	            """Call a specific tool."""
77	            logger.debug(f"Calling tool: {name} with arguments: {arguments}")
78	
79	            try:
80	                result = await self.tools.call_tool(name, arguments or {})
81	                return [TextContent(type="text", text=result)]
82	            except Exception as e:
83	                logger.error(f"Error calling tool {name}: {e}", exc_info=True)
84	                return [TextContent(type="text", text=f"Error: {e!s}")]
85	
86	        @self.server.set_logging_level()  # type: ignore[misc]
87	        async def set_logging_level(level: LoggingLevel) -> None:
88	            """Set the logging level."""
89	            logger.info(f"Setting logging level to: {level}")
90	            level_map: dict[str, int] = {
91	                "debug": LOG_DEBUG,
92	                "info": LOG_INFO,
93	                "notice": LOG_INFO,  # Python logging doesn't have NOTICE, map to INFO
94	                "warning": LOG_WARNING,
95	                "error": LOG_ERROR,
96	                "critical": LOG_CRITICAL,
97	                "alert": LOG_CRITICAL,  # Python logging doesn't have ALERT, map to CRITICAL
98	                "emergency": LOG_CRITICAL,  # Python logging doesn't have EMERGENCY, map to CRITICAL
99	            }
100	            logging.getLogger().setLevel(level_map.get(level, LOG_INFO))
101	
102	    async def run(self) -> None:
103	        """Run the MCP server."""
104	        logger.info("Starting Gemini MCP Server")
105	        logger.info(f"Version: {__version__}")
106	        logger.info(f"Gemini CLI: {self.tools.gemini_path}")
107	        logger.info(f"Allowed directories: {[str(d) for d in self.tools.allowed_directories]}")
108	
109	        # Run the stdio server
110	        async with stdio_server() as (read_stream, write_stream):
111	            init_options = InitializationOptions(
112	                server_name="gemini-mcp",
113	                server_version=__version__,
114	                capabilities=self.server.get_capabilities(
115	                    notification_options=NotificationOptions(),
116	                    experimental_capabilities={},
117	                ),
118	            )
119	
120	            await self.server.run(
121	                read_stream,
122	                write_stream,
123	                init_options,
124	            )
125	

