575	@server.call_tool()
576	async def handle_call_tool(
577	    name: str, arguments: Optional[Dict[str, Any]]
578	) -> List[types.TextContent]:
579	    """Handle tool calls."""
580	    try:
581	        # Initialize client if not already done
582	        config = ServerConfig.from_env()
583	        payload_client = await initialize_client(config)
584	        
585	        if name == "create_object":
586	            collection_name = arguments.get("collection_name")
587	            data = arguments.get("data")
588	            locale = arguments.get("locale")
589	            
590	            if not collection_name:
591	                raise ValueError("collection_name is required")
592	            if not data:
593	                raise ValueError("data is required")
594	
595	            data = parse_json_tool_argument(
596	                data,
597	                field_name="data",
598	                allowed_types=(dict, list),
599	            )
600	            if not data:
601	                raise ValueError("data is required")
602	            
603	            # Check if data is an array of objects
604	            if isinstance(data, list):
605	                # Handle array of objects
606	                results = []
607	                for item in data:
608	                    result = await payload_client.create_object(collection_name, item, locale)
609	                    results.append(result)
610	                return [types.TextContent(
611	                    type="text",
612	                    text=json.dumps(results, indent=2)
613	                )]
614	            else:
615	                # Handle single object
616	                result = await payload_client.create_object(collection_name, data, locale)
617	                return [types.TextContent(
618	                    type="text",
619	                    text=json.dumps(result, indent=2)
620	                )]
621	        
622	        elif name == "search_objects":
623	            collection_name = arguments.get("collection_name")
624	            if not collection_name:
625	                raise ValueError("collection_name is required")
626	            
627	            query = arguments.get("query")
628	            limit = arguments.get("limit")
629	            page = arguments.get("page")
630	            sort = arguments.get("sort")
631	            locale = arguments.get("locale")
632	            
633	            result = await payload_client.search_objects(
634	                collection_name=collection_name,
635	                where=query,
636	                limit=limit,
637	                page=page,
638	                sort=sort,
639	                locale=locale
640	            )
641	            return [types.TextContent(
642	                type="text",
643	                text=json.dumps(result, indent=2)
644	            )]
645	        
646	        elif name == "update_object":
647	            collection_name = arguments.get("collection_name")
648	            object_id = arguments.get("object_id")
649	            data = arguments.get("data")
650	            locale = arguments.get("locale")
651	            
652	            if not collection_name:
653	                raise ValueError("collection_name is required")
654	            if not object_id:
655	                raise ValueError("object_id is required")
656	            if not data:
657	                raise ValueError("data is required")
658	            
659	            result = await payload_client.update_object(collection_name, object_id, data, locale)
660	            return [types.TextContent(
661	                type="text",
662	                text=json.dumps(result, indent=2)
663	            )]
664	        
665	        elif name == "get_global":
666	            slug = arguments.get("slug")
667	            locale = arguments.get("locale")
668	            depth = arguments.get("depth")
669	            fallback_locale = arguments.get("fallback_locale")
670	            select = arguments.get("select")
671	            populate = arguments.get("populate")
672	            
673	            if not slug:
674	                raise ValueError("slug is required")
675	            
676	            result = await payload_client.get_global(
677	                slug=slug,
678	                locale=locale,
679	                depth=depth,
680	                fallback_locale=fallback_locale,
681	                select=select,
