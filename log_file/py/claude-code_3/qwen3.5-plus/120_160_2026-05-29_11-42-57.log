537	        
538	        logger.info("Database initialized successfully")
539	        
540	    except Exception as e:
541	        logger.error(f"Failed to initialize database: {e}")
542	        raise
543	
544	async def main(database_url: str = None, config_file: str = None):
545	    """Main function to run the MCP server"""
546	    
547	    # Initialize database connection
548	    await initialize_database(database_url, config_file)
549	    
550	    # Run the MCP server using stdio
551	    await mcp.run_stdio_async()
552	
553	if __name__ == "__main__":
554	    # Parse command line arguments
555	    parser = argparse.ArgumentParser(description='MCP Database Server')
556	    parser.add_argument('--database-url', '-d', 
557	                       help='Database URL (e.g., sqlite+aiosqlite:///students.db or postgresql+asyncpg://user:pass@host:port/db)')
558	    parser.add_argument('--config-file', '-c',
