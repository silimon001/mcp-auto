143	def resolve_runtime_surface(argv_values, startup_logger=None) -> str:
144	    valid_surfaces = ("web", "mcp")
145	    cli_surface = None
146	
147	    for index, arg in enumerate(argv_values):
148	        if arg.startswith("--surface="):
149	            cli_surface = arg.split("=", 1)[1].strip().lower()
150	            break
151	        if arg == "--surface" and index + 1 < len(argv_values):
152	            cli_surface = argv_values[index + 1].strip().lower()
153	            break
154	
155	    env_surface = os.environ.get("REVITMCP_SURFACE", "").strip().lower()
156	    requested_surface = cli_surface or env_surface or "web"
157	
158	    if requested_surface not in valid_surfaces:
159	        if startup_logger:
160	            startup_logger.warning(
161	                "Invalid runtime surface '%s'. Falling back to 'web'. Valid values: %s",
162	                requested_surface,
163	                ", ".join(valid_surfaces),
164	            )
165	        return "web"
166	
167	    return requested_surface
