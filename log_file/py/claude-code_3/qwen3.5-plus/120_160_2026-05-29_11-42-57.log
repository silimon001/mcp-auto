1	#!/usr/bin/env python3
2	"""
3	KiCad MCP Server - A Model Context Protocol server for KiCad on macOS.
4	This server allows Claude and other MCP clients to interact with KiCad projects.
5	"""
6	import os
7	import sys
8	import logging # Import logging module
9	
10	# Must import config BEFORE env potentially overrides it via os.environ
11	from kicad_mcp import config
12	from kicad_mcp.server import main as server_main
13	from kicad_mcp.utils.env import load_dotenv
14	
15	# --- Setup Logging --- 
16	log_file = os.path.join(os.path.dirname(__file__), 'kicad-mcp.log') 
17	logging.basicConfig(
18	    level=logging.INFO,
19	    format='%(asctime)s - %(levelname)s - [PID:%(process)d] - %(message)s',
20	    handlers=[
21	        logging.FileHandler(log_file, mode='w'), # Use 'w' to overwrite log on each start
22	        # logging.StreamHandler() # Optionally keep logging to console if needed
23	    ]
24	)
25	# ---------------------
26	
27	logging.info("--- Server Starting --- ")
28	logging.info(f"Initial KICAD_USER_DIR from config.py: {config.KICAD_USER_DIR}")
29	logging.info(f"Initial ADDITIONAL_SEARCH_PATHS from config.py: {config.ADDITIONAL_SEARCH_PATHS}")
30	
31	# Get PID for logging (already used by basicConfig)
32	_PID = os.getpid()
33	
34	# Load environment variables from .env file if present
35	# This attempts to update os.environ
36	dotenv_path = os.path.join(os.path.dirname(__file__), '.env')
37	logging.info(f"Attempting to load .env file from: {dotenv_path}")
38	found_dotenv = load_dotenv() # Assuming this returns True/False or similar
39	logging.info(f".env file found and loaded: {found_dotenv}")
40	
41	# Log effective values AFTER load_dotenv attempt
42	# Note: The config values might not automatically re-read from os.environ 
43	# depending on how config.py is written. Let's check os.environ directly.
44	effective_user_dir = os.getenv('KICAD_USER_DIR')
45	effective_search_paths = os.getenv('KICAD_SEARCH_PATHS')
46	logging.info(f"os.environ['KICAD_USER_DIR'] after load_dotenv: {effective_user_dir}")
47	logging.info(f"os.environ['KICAD_SEARCH_PATHS'] after load_dotenv: {effective_search_paths}")
48	
49	# Re-log the values imported from config.py to see if they reflect os.environ changes
50	# (This depends on config.py using os.getenv internally AFTER load_dotenv runs)
51	try:
52	    from kicad_mcp import config
53	    import importlib
54	    importlib.reload(config) # Attempt to force re-reading config
55	    logging.info(f"Effective KICAD_USER_DIR from config.py after reload: {config.KICAD_USER_DIR}")
56	    logging.info(f"Effective ADDITIONAL_SEARCH_PATHS from config.py after reload: {config.ADDITIONAL_SEARCH_PATHS}")
57	except Exception as e:
58	    logging.error(f"Could not reload config: {e}")
59	    logging.info(f"Using potentially stale KICAD_USER_DIR from initial import: {config.KICAD_USER_DIR}")
60	    logging.info(f"Using potentially stale ADDITIONAL_SEARCH_PATHS from initial import: {config.ADDITIONAL_SEARCH_PATHS}")
61	
62	if __name__ == "__main__":
63	    try:
64	        logging.info(f"Starting KiCad MCP server process") 
65	
66	        # Print search paths from config
67	        logging.info(f"Using KiCad user directory: {config.KICAD_USER_DIR}") # Changed print to logging
68	        if config.ADDITIONAL_SEARCH_PATHS:
69	            logging.info(f"Additional search paths: {', '.join(config.ADDITIONAL_SEARCH_PATHS)}") # Changed print to logging
70	        else:
71	            logging.info(f"No additional search paths configured") # Changed print to logging
72	
73	        # Run server
74	        logging.info(f"Running server with stdio transport") # Changed print to logging
75	        import asyncio
76	        asyncio.run(server_main())
77	    except Exception as e:
78	        logging.exception(f"Unhandled exception in main") # Log exception details
79	        raise
80	

