14	# Simple regex to find markdown headings (##, ###, etc.)
15	HEADING_RE = re.compile(r"^(#{2,4})\s+(.*)")
16	# Simple regex to find Source: URL lines
17	SOURCE_RE = re.compile(r"Source:\s*(https?://\S+)")
18	
