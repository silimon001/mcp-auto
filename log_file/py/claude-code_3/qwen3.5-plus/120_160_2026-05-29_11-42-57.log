189	    async def _execute_unsafe_mongo_query(self, query: str) -> List[Dict[str, Any]]:
190	        """Execute SQL-like write operations against MongoDB collections."""
191	        if self.mongo_database is None:
192	            raise ValueError("MongoDB is not initialized")
193	
194	        normalized = " ".join(query.strip().rstrip(";").split())
195	
196	        # CREATE TABLE users (...) -> create collection 'users'
197	        create_match = re.match(
198	            r"^CREATE\s+TABLE\s+([A-Za-z_][A-Za-z0-9_]*)\s*\((.*)\)$",
199	            normalized,
200	            flags=re.IGNORECASE,
201	        )
202	        if create_match:
203	            collection_name = create_match.group(1)
204	            existing = await self.mongo_database.list_collection_names()
205	            if collection_name not in existing:
206	                await self.mongo_database.create_collection(collection_name)
207	                return [{"affected_rows": 0, "status": "success", "query_type": "modification", "message": f"Collection '{collection_name}' created"}]
208	            return [{"affected_rows": 0, "status": "success", "query_type": "modification", "message": f"Collection '{collection_name}' already exists"}]
209	
210	        # DROP TABLE users -> drop collection
211	        drop_match = re.match(
212	            r"^DROP\s+TABLE\s+([A-Za-z_][A-Za-z0-9_]*)$",
213	            normalized,
214	            flags=re.IGNORECASE,
215	        )
216	        if drop_match:
217	            collection_name = drop_match.group(1)
218	            await self.mongo_database[collection_name].drop()
219	            return [{"affected_rows": 0, "status": "success", "query_type": "modification", "message": f"Collection '{collection_name}' dropped"}]
220	
221	        # INSERT INTO users (name, age) VALUES ('a', 2)
222	        insert_match = re.match(
223	            r"^INSERT\s+INTO\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(([^\)]*)\)\s*VALUES\s*\(([^\)]*)\)$",
224	            normalized,
225	            flags=re.IGNORECASE,
226	        )
227	        if insert_match:
228	            collection_name = insert_match.group(1)
229	            cols = [c.strip() for c in self._split_csv_quoted(insert_match.group(2))]
230	            vals = [self._parse_sql_like_literal(v) for v in self._split_csv_quoted(insert_match.group(3))]
231	            if len(cols) != len(vals):
232	                raise ValueError("INSERT columns and values count mismatch")
233	            doc = {k: v for k, v in zip(cols, vals)}
234	            res = await self.mongo_database[collection_name].insert_one(doc)
235	            return [{"affected_rows": 1, "status": "success", "query_type": "modification", "inserted_id": str(res.inserted_id)}]
236	
237	        # DELETE FROM users WHERE name='a'
238	        delete_match = re.match(
239	            r"^DELETE\s+FROM\s+([A-Za-z_][A-Za-z0-9_]*)(?:\s+WHERE\s+(.+))?$",
240	            normalized,
241	            flags=re.IGNORECASE,
242	        )
243	        if delete_match:
244	            collection_name = delete_match.group(1)
245	            where_clause = delete_match.group(2) or ""
246	            filters = self._parse_where_equals(where_clause)
247	            if filters:
248	                res = await self.mongo_database[collection_name].delete_many(filters)
249	            else:
250	                res = await self.mongo_database[collection_name].delete_many({})
251	            return [{"affected_rows": res.deleted_count, "status": "success", "query_type": "modification"}]
252	
253	        # UPDATE users SET age=30, name='x' WHERE name='a'
254	        update_match = re.match(
255	            r"^UPDATE\s+([A-Za-z_][A-Za-z0-9_]*)\s+SET\s+(.+?)(?:\s+WHERE\s+(.+))?$",
256	            normalized,
257	            flags=re.IGNORECASE,
258	        )
259	        if update_match:
260	            collection_name = update_match.group(1)
261	            set_clause = update_match.group(2)
262	            where_clause = update_match.group(3) or ""
263	
264	            updates: Dict[str, Any] = {}
265	            assignments = self._split_csv_quoted(set_clause)
266	            for item in assignments:
267	                match = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.+)$", item.strip())
268	                if not match:
269	                    raise ValueError(f"Unsupported SET assignment for MongoDB: {item}")
270	                key = match.group(1)
271	                value = self._parse_sql_like_literal(match.group(2))
272	                updates[key] = value
273	
274	            filters = self._parse_where_equals(where_clause)
275	            res = await self.mongo_database[collection_name].update_many(filters, {"$set": updates})
276	            return [{"affected_rows": res.modified_count, "status": "success", "query_type": "modification"}]
277	
278	        raise ValueError(
279	            "Unsupported MongoDB unsafe query format. Supported: CREATE TABLE, DROP TABLE, INSERT INTO, DELETE FROM, UPDATE ... SET ... [WHERE ...]."
280	        )
281	
282	    async def _execute_safe_mongo_query(self, query: str, limit: int = 50) -> List[Dict[str, Any]]:
283	        """Execute a restricted SQL-like query against MongoDB collections.
284	
285	        Supported query forms:
286	        - SELECT * FROM <collection> [LIMIT n]
287	        - SELECT COUNT(*) as <alias> FROM <collection>
288	        """
289	        if self.mongo_database is None:
290	            raise ValueError("MongoDB is not initialized")
291	
292	        normalized = " ".join(query.strip().rstrip(";").split())
293	
294	        count_pattern = re.compile(
295	            r"^SELECT\s+COUNT\(\*\)\s+AS\s+([A-Za-z_][A-Za-z0-9_]*)\s+FROM\s+([A-Za-z_][A-Za-z0-9_]*)\s*(?:LIMIT\s+\d+)?$",
296	            flags=re.IGNORECASE,
297	        )
298	        select_pattern = re.compile(
299	            r"^SELECT\s+\*\s+FROM\s+([A-Za-z_][A-Za-z0-9_]*)(?:\s+LIMIT\s+(\d+))?$",
300	            flags=re.IGNORECASE,
301	        )
302	
303	        count_match = count_pattern.match(normalized)
304	        if count_match:
305	            alias = count_match.group(1)
306	            collection_name = count_match.group(2)
307	            collection = self.mongo_database[collection_name]
308	            total = await collection.count_documents({})
309	            return [{alias: total}]
310	
311	        select_match = select_pattern.match(normalized)
312	        if select_match:
313	            collection_name = select_match.group(1)
314	            query_limit = int(select_match.group(2)) if select_match.group(2) else limit
315	            final_limit = min(max(query_limit, 1), limit)
316	            collection = self.mongo_database[collection_name]
317	            docs = await collection.find({}).limit(final_limit).to_list(length=final_limit)
318	            return [self._serialize_mongo_value(doc) for doc in docs]
319	
320	        raise ValueError(
