58	async def initialize_client(config: ServerConfig) -> PayloadClient:
59	    """Initialize the Payload CMS client with connection test."""
60	    global client, auth_manager
61	    
62	    if client is None:
63	        logger.info(f"Initializing Payload client for {config.payload.base_url}")
64	        client = PayloadClient(config.payload)
65	        
66	        # Initialize auth manager
67	        auth_manager = AuthManager(config.payload)
68	        
69	        # Set up auth callback to update client headers when token changes
70	        def update_client_headers(new_token: str):
71	            if client:
72	                client.auth_token = new_token
73	                client.headers["Authorization"] = f"JWT {new_token}"
74	                logger.info("Client headers updated with new token")
75	        
76	        auth_manager.add_auth_callback(update_client_headers)
77	        
78	        # Set auth manager in client for token refresh
79	        client.set_auth_manager(auth_manager)
80	        
81	        # Test connection to Payload CMS API
82	        # try:
83	        #     logger.info("Testing connection to Payload CMS API...")
84	        #     result = await client._make_request("GET", "users")
85	        #     logger.info(f"Connection test successful: Retrieved {len(result.get('docs', []))} users")
86	        #     logger.debug(f"API Response: {result}")
87	        # except Exception as e:
88	        #     logger.error(f"Connection test failed: {str(e)}")
89	        #     logger.error(f"Error type: {type(e).__name__}")
90	            # Don't raise the exception, just log it so the server can continue
91	            # but the user will know there's a connection issue
92	        
93	        logger.info(f"Payload client initialization completed")
94	    
95	    return client
