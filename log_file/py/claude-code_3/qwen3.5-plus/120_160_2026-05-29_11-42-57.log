107	    def _serialize_mongo_value(self, value: Any) -> Any:
108	        """Convert MongoDB-specific values into JSON-serializable values."""
109	        if isinstance(value, dict):
110	            return {k: self._serialize_mongo_value(v) for k, v in value.items()}
111	        if isinstance(value, list):
112	            return [self._serialize_mongo_value(v) for v in value]
113	        if hasattr(value, "isoformat"):
114	            return value.isoformat()
115	        if not isinstance(value, (str, int, float, bool, type(None))):
116	            return str(value)
117	        return value
118	
119	    def _split_csv_quoted(self, raw: str) -> List[str]:
120	        """Split comma-separated values while preserving quoted segments."""
121	        parts: List[str] = []
122	        buf: List[str] = []
123	        quote: Optional[str] = None
124	        i = 0
125	        while i < len(raw):
126	            ch = raw[i]
127	            if quote:
128	                buf.append(ch)
129	                if ch == quote and (i == 0 or raw[i - 1] != "\\"):
130	                    quote = None
131	            else:
132	                if ch in {"'", '"'}:
133	                    quote = ch
134	                    buf.append(ch)
135	                elif ch == ",":
136	                    parts.append("".join(buf).strip())
137	                    buf = []
138	                else:
139	                    buf.append(ch)
140	            i += 1
141	        if buf:
142	            parts.append("".join(buf).strip())
143	        return [p for p in parts if p]
144	
145	    def _parse_sql_like_literal(self, token: str) -> Any:
146	        """Parse SQL-like literal text into Python values for MongoDB writes."""
147	        t = token.strip()
148	        if not t:
149	            return None
150	
151	        upper = t.upper()
152	        if upper == "NULL":
153	            return None
154	        if upper == "TRUE":
155	            return True
156	        if upper == "FALSE":
157	            return False
158	
159	        if (t.startswith("'") and t.endswith("'")) or (t.startswith('"') and t.endswith('"')):
160	            inner = t[1:-1]
161	            return inner.replace("\\'", "'").replace('\\"', '"')
162	
163	        try:
164	            if "." in t:
165	                return float(t)
166	            return int(t)
167	        except ValueError:
168	            pass
169	
170	        return t
171	
172	    def _parse_where_equals(self, where_clause: str) -> Dict[str, Any]:
173	        """Parse a minimal SQL WHERE clause of key=value [AND key=value ...]."""
174	        clause = where_clause.strip()
175	        if not clause:
176	            return {}
177	
178	        filters: Dict[str, Any] = {}
179	        conditions = re.split(r"\s+AND\s+", clause, flags=re.IGNORECASE)
180	        for cond in conditions:
181	            match = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.+)$", cond.strip())
182	            if not match:
183	                raise ValueError(f"Unsupported WHERE condition for MongoDB: {cond}")
184	            key = match.group(1)
185	            value = self._parse_sql_like_literal(match.group(2).strip())
186	            filters[key] = value
187	        return filters
