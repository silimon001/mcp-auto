1641	@mcp.tool(name="control_by_intent")
1642	async def control_by_intent(
1643	    query: str,
1644	    room: str = "",
1645	    home: str = "",
1646	    prefer_device_type: str = "",
1647	) -> IntentControlToolResult:
1648	    """Route a natural-language-like smart-home request to the best product tool."""
1649	    adapter = get_adapter()
1650	    if not adapter:
1651	        return build_result(False, "Adapter not initialized")
1652	
1653	    try:
1654	        await ensure_connected(adapter)
1655	        known_rooms = await get_known_room_names(adapter)
1656	        parsed = infer_intent(query, fallback_room_hints=FALLBACK_ROOM_HINTS, known_rooms=known_rooms)
1657	        resolved_room = room or parsed.get("room", "")
1658	        device_query = parsed.get("device_query", "").strip()
1659	
1660	        if parsed["intent"] == "execute_scene":
1661	            payload = extract_structured_content(
1662	                await execute_scene(scene_name=parsed.get("scene_name", ""), home_name=home)
1663	            )
1664	            return build_result(
1665	                bool(payload.get("success")),
1666	                payload.get("message", "Executed scene"),
1667	                route="scene",
1668	                parsed_intent=parsed,
1669	                result=payload,
