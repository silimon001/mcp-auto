400	@mcp.tool()
401	async def insert_data(table_name: str, columns: str, values: str) -> str:
402	    """
403	    Insert data into a table.
404	    
405	    Args:
406	        table_name: Name of the table to insert into
407	        columns: Column names (e.g., "name, age, email")
408	        values: Values to insert (e.g., "'John Doe', 30, 'john@example.com'")
409	        
410	    Returns:
411	        Success message with number of rows affected
412	    """
413	    try:
414	        insert_query = f"INSERT INTO {table_name} ({columns}) VALUES ({values})"
415	        results = await db_manager.execute_unsafe_query(insert_query)
416	        affected_rows = results[0].get('affected_rows', 0) if results else 0
417	        return f"Inserted {affected_rows} row(s) into '{table_name}'"
418	        
419	    except Exception as e:
420	        return f"ERROR: Error inserting data: {str(e)}"
421	
422	@mcp.tool()
423	async def delete_data(table_name: str, where_condition: str = "") -> str:
424	    """
425	    Delete data from a table.
426	    WARNING: This will permanently delete data!
427	    
428	    Args:
429	        table_name: Name of the table to delete from
430	        where_condition: WHERE clause condition (e.g., "id = 1" or "age > 65"). If empty, ALL rows will be deleted!
431	        
432	    Returns:
433	        Success message with number of rows deleted
434	    """
435	    try:
436	        if where_condition.strip():
437	            delete_query = f"DELETE FROM {table_name} WHERE {where_condition}"
438	        else:
439	            delete_query = f"DELETE FROM {table_name}"
440	            
441	        results = await db_manager.execute_unsafe_query(delete_query)
442	        affected_rows = results[0].get('affected_rows', 0) if results else 0
443	        return f"Deleted {affected_rows} row(s) from '{table_name}'"
444	        
445	    except Exception as e:
446	        return f"ERROR: Error deleting data: {str(e)}"
