493	async def initialize_database(database_url: str = None, config_file: str = None):
494	    """Initialize the database connection"""
495	    global db_manager, nl_converter
496	    
497	    try:
498	        # Determine database URL from various sources
499	        final_database_url = None
500	        
501	        # Priority: command line URL > config file > environment variable
502	        if database_url:
503	            final_database_url = database_url
504	            logger.info("Using database URL from command line argument")
505	        elif config_file:
506	            # Simple JSON config file support
507	            try:
508	                import json
509	                with open(config_file, 'r') as f:
510	                    config = json.load(f)
511	                final_database_url = config.get('database_url')
512	                if not final_database_url:
513	                    raise ValueError("database_url not found in config file")
514	                logger.info(f"Using database URL from config file: {config_file}")
515	            except Exception as e:
516	                logger.error(f"Failed to load config file {config_file}: {e}")
517	                raise
518	        else:
519	            final_database_url = os.getenv('DATABASE_URL')
520	            if final_database_url:
521	                logger.info("Using database URL from environment variable")
522	        
523	        if not final_database_url:
524	            raise ValueError("No DATABASE_URL provided via argument, config file, or environment variable")
525	        
526	        # Set the environment variable for DatabaseManager
527	        os.environ['DATABASE_URL'] = final_database_url
528	        
529	        db_manager = DatabaseManager()  # No parameter needed
530	        if not await db_manager.test_connection():
