402	    async def handle_initialized_notification(self, message: Dict[str, Any]) -> Dict[str, Any]:
403	        """Handle notifications/initialized MCP request"""
404	        try:
405	            logger.info("MCP Client initialization completed")
406	            
407	            # For notifications, we don't need to return a result
408	            # Just acknowledge receipt
409	            return {
410	                "jsonrpc": "2.0",
411	                "id": message.get("id"),
412	                "result": {"initialized": True}
413	            }
414	        except Exception as e:
415	            logger.error(f"Error in handle_initialized_notification: {e}")
416	            return {
417	                "jsonrpc": "2.0",
418	                "id": message.get("id"),
419	                "error": {
420	                    "code": "internal_error",
421	                    "message": str(e)
422	                }
423	            }
424	    
425	    async def route_mcp_request(self, message: Dict[str, Any]) -> Dict[str, Any]:
426	        """Route MCP requests to appropriate handlers"""
427	        method = message.get("method")
428	        request_id = message.get("id")
429	        
430	        logger.info(f"MCP Request received: {method} (ID: {request_id})")
431	        
432	        # Route to appropriate handler
433	        if method == "initialize":
434	            response = await self.handle_initialize(message)
435	        elif method == "tools/list":
436	            response = await self.handle_list_tools(message)
437	        elif method == "tools/call":
438	            response = await self.handle_call_tool(message)
439	        elif method == "services/list":
440	            response = await self.handle_list_services(message)
441	        elif method == "prompts/list":
442	            response = await self.handle_list_prompts(message)
443	        elif method == "notifications/cancel":
444	            response = await self.handle_cancel_notification(message)
445	        elif method == "notifications/initialized":
446	            response = await self.handle_initialized_notification(message)
447	        else:
448	            logger.warning(f"Unknown MCP method: {method}")
449	            response = {
450	                "jsonrpc": "2.0",
451	                "id": request_id,
452	                "error": {
453	                    "code": "method_not_found",
454	                    "message": f"Unknown method: {method}"
455	                }
456	            }
457	        
458	        logger.info(f"MCP Response sent: {response}")
459	        return response
460	    
461	    async def get_health_status(self) -> Dict[str, Any]:
462	        """Get overall health status of the router and services"""
463	        try:
464	            # Get service statistics
465	            service_stats = await self.registry.get_service_statistics()
466	            
467	            # Check local tools
468	            local_tools_status = {}
469	            for tool_name, tool in self.local_tools.items():
470	                try:
471	                    # Simple health check for local tools
472	                    local_tools_status[tool_name] = "healthy"
473	                except Exception as e:
474	                    local_tools_status[tool_name] = f"unhealthy: {str(e)}"
475	            
476	            return {
477	                "status": "healthy",
478	                "router": "operational",
479	                "local_tools": local_tools_status,
480	                "services": service_stats,
481	                "total_tools": service_stats.get("total_tools", 0) + len(self.local_tools)
482	            }
483	            
484	        except Exception as e:
485	            logger.error(f"Error getting health status: {e}")
486	            return {
487	                "status": "unhealthy",
488	                "error": str(e)
489	            }
