58	@kali_server.call_tool()
59	async def handle_tool_request(
60	    name: str, arguments: Dict[str, Any]
61	) -> Sequence[Union[types.TextContent, types.ImageContent, types.EmbeddedResource]]:
62	    """
63	    Handle MCP tool requests by routing to the appropriate handler.
64	    
65	    Args:
66	        name: The name of the tool being called
67	        arguments: Dictionary of arguments for the tool
68	        
69	    Returns:
70	        Sequence of content items returned by the tool
71	        
72	    Raises:
73	        ValueError: If the tool name is unknown or required arguments are missing
74	    """
75	    if name == "fetch":
76	        if "url" not in arguments:
77	            raise ValueError("Missing required argument 'url'")
78	        return await fetch_website(arguments["url"])
79	    
80	    elif name == "run":
81	        if "command" not in arguments:
82	            raise ValueError("Missing required argument 'command'")
83	        return await run_command(arguments["command"])
84	    
85	    elif name == "resources":
86	        return await list_system_resources()
87	    
88	    elif name == "vulnerability_scan":
89	        if "target" not in arguments:
90	            raise ValueError("Missing required argument 'target'")
91	        scan_type = arguments.get("scan_type", "comprehensive")
92	        return await vulnerability_scan(arguments["target"], scan_type)
93	    
94	    elif name == "web_enumeration":
95	        if "target" not in arguments:
96	            raise ValueError("Missing required argument 'target'")
97	        enum_type = arguments.get("enumeration_type", "full")
98	        return await web_enumeration(arguments["target"], enum_type)
99	    
100	    elif name == "network_discovery":
101	        if "target" not in arguments:
102	            raise ValueError("Missing required argument 'target'")
103	        discovery_type = arguments.get("discovery_type", "comprehensive")
104	        return await network_discovery(arguments["target"], discovery_type)
105	    
106	    elif name == "exploit_search":
107	        if "search_term" not in arguments:
108	            raise ValueError("Missing required argument 'search_term'")
109	        search_type = arguments.get("search_type", "all")
110	        return await exploit_search(arguments["search_term"], search_type)
111	    
112	    elif name == "save_output":
113	        if "content" not in arguments:
114	            raise ValueError("Missing required argument 'content'")
115	        filename = arguments.get("filename")
116	        category = arguments.get("category", "general")
117	        return await save_output(arguments["content"], filename if filename else None, category)
118	    
119	    elif name == "create_report":
120	        if "title" not in arguments:
121	            raise ValueError("Missing required argument 'title'")
122	        if "findings" not in arguments:
123	            raise ValueError("Missing required argument 'findings'")
124	        report_type = arguments.get("report_type", "markdown")
125	        return await create_report(arguments["title"], arguments["findings"], report_type)
126	    
127	    elif name == "file_analysis":
128	        if "filepath" not in arguments:
129	            raise ValueError("Missing required argument 'filepath'")
130	        return await file_analysis(arguments["filepath"])
131	    
132	    elif name == "download_file":
133	        if "url" not in arguments:
134	            raise ValueError("Missing required argument 'url'")
135	        filename = arguments.get("filename")
136	        return await download_file(arguments["url"], filename if filename else None)
137	    
138	    elif name == "session_create":
139	        if "session_name" not in arguments:
140	            raise ValueError("Missing required argument 'session_name'")
141	        description = arguments.get("description", "")
142	        target = arguments.get("target", "")
143	        return await session_create(arguments["session_name"], description, target)
144	    
145	    elif name == "session_list":
146	        return await session_list()
147	    
148	    elif name == "session_switch":
149	        if "session_name" not in arguments:
150	            raise ValueError("Missing required argument 'session_name'")
151	        return await session_switch(arguments["session_name"])
152	    
153	    elif name == "session_status":
154	        return await session_status()
155	    
156	    elif name == "session_delete":
157	        if "session_name" not in arguments:
158	            raise ValueError("Missing required argument 'session_name'")
159	        return await session_delete(arguments["session_name"])
160	    
161	    elif name == "session_history":
162	        return await session_history()
163	
164	    elif name == "session_results":
165	        limit = arguments.get("limit", 3)
166	        lines = arguments.get("lines", 80)
167	        return await session_results(limit, lines)
168	    
169	    elif name == "spider_website":
170	        if "url" not in arguments:
171	            raise ValueError("Missing required argument 'url'")
172	        depth = arguments.get("depth", 2)
173	        threads = arguments.get("threads", 10)
174	        return await spider_website(arguments["url"], depth, threads)
175	    
176	    elif name == "form_analysis":
177	        if "url" not in arguments:
178	            raise ValueError("Missing required argument 'url'")
179	        scan_type = arguments.get("scan_type", "comprehensive")
180	        return await form_analysis(arguments["url"], scan_type)
181	    
182	    elif name == "header_analysis":
183	        if "url" not in arguments:
184	            raise ValueError("Missing required argument 'url'")
185	        include_security = arguments.get("include_security", True)
186	        return await header_analysis(arguments["url"], include_security)
187	    
188	    elif name == "ssl_analysis":
189	        if "url" not in arguments:
190	            raise ValueError("Missing required argument 'url'")
191	        port = arguments.get("port", 443)
192	        return await ssl_analysis(arguments["url"], port)
193	    
194	    elif name == "subdomain_enum":
195	        if "url" not in arguments:
196	            raise ValueError("Missing required argument 'url'")
197	        enum_type = arguments.get("enum_type", "comprehensive")
198	        return await subdomain_enum(arguments["url"], enum_type)
199	    
200	    elif name == "web_audit":
201	        if "url" not in arguments:
202	            raise ValueError("Missing required argument 'url'")
203	        audit_type = arguments.get("audit_type", "comprehensive")
204	        return await web_audit(arguments["url"], audit_type)
205	
206	    elif name == "encode_decode":
207	        if "data" not in arguments:
208	            raise ValueError("Missing required argument 'data'")
209	        operation = arguments.get("operation", "encode")
210	        fmt = arguments.get("format", "base64")
211	        return await encode_decode(arguments["data"], operation, fmt)
212	
213	    elif name == "reverse_shell":
214	        if "lhost" not in arguments:
215	            raise ValueError("Missing required argument 'lhost'")
216	        shell_type = arguments.get("shell_type", "bash")
217	        lport = arguments.get("lport", 4444)
218	        return await reverse_shell(arguments["lhost"], shell_type, lport)
219	
220	    elif name == "hash_identify":
221	        if "hash_value" not in arguments:
222	            raise ValueError("Missing required argument 'hash_value'")
223	        return await hash_identify(arguments["hash_value"])
224	
225	    elif name == "credential_store":
226	        action = arguments.get("action", "list")
227	        return await credential_store(
228	            action=action,
229	            username=arguments.get("username"),
230	            password=arguments.get("password"),
231	            service=arguments.get("service"),
232	            target=arguments.get("target"),
233	            notes=arguments.get("notes"),
234	        )
235	
236	    elif name == "hydra_attack":
237	        if "target" not in arguments:
238	            raise ValueError("Missing required argument 'target'")
239	        return await hydra_attack(
240	            target=arguments["target"],
241	            service=arguments.get("service", "ssh"),
242	            username=arguments.get("username"),
243	            userlist=arguments.get("userlist"),
244	            password=arguments.get("password"),
245	            passlist=arguments.get("passlist"),
246	            threads=arguments.get("threads", 16),
247	            extra_opts=arguments.get("extra_opts", ""),
248	        )
249	
250	    elif name == "payload_generate":
251	        if "payload_type" not in arguments:
252	            raise ValueError("Missing required argument 'payload_type'")
253	        if "platform" not in arguments:
254	            raise ValueError("Missing required argument 'platform'")
255	        if "lhost" not in arguments:
256	            raise ValueError("Missing required argument 'lhost'")
257	        return await payload_generate(
258	            payload_type=arguments["payload_type"],
259	            platform=arguments["platform"],
260	            lhost=arguments["lhost"],
261	            lport=arguments.get("lport", 4444),
262	            format=arguments.get("format", "raw"),
263	            encoder=arguments.get("encoder"),
264	        )
265	
266	    elif name == "port_scan":
267	        if "target" not in arguments:
268	            raise ValueError("Missing required argument 'target'")
269	        scan_type = arguments.get("scan_type", "quick")
270	        ports = arguments.get("ports")
271	        return await port_scan(arguments["target"], scan_type, ports)
272	
273	    elif name == "dns_enum":
274	        if "domain" not in arguments:
275	            raise ValueError("Missing required argument 'domain'")
276	        record_types = arguments.get("record_types", "all")
277	        return await dns_enum(arguments["domain"], record_types)
278	
279	    elif name == "enum_shares":
280	        if "target" not in arguments:
281	            raise ValueError("Missing required argument 'target'")
282	        return await enum_shares(
283	            target=arguments["target"],
284	            enum_type=arguments.get("enum_type", "all"),
285	            username=arguments.get("username"),
286	            password=arguments.get("password"),
287	        )
288	
289	    elif name == "parse_nmap":
290	        if "filepath" not in arguments:
291	            raise ValueError("Missing required argument 'filepath'")
292	        return await parse_nmap(arguments["filepath"])
293	
294	    elif name == "parse_tool_output":
295	        if "filepath" not in arguments:
296	            raise ValueError("Missing required argument 'filepath'")
297	        tool_type = arguments.get("tool_type", "auto")
298	        return await parse_tool_output(arguments["filepath"], tool_type)
299	
300	    elif name == "recon_auto":
301	        if "target" not in arguments:
302	            raise ValueError("Missing required argument 'target'")
303	        depth = arguments.get("depth", "quick")
304	        return await recon_auto(arguments["target"], depth)
305	
306	    else:
307	        raise ValueError(f"Unknown tool: {name}")
308	
