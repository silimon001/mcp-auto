24	def parse_markdown_to_chunks(filename: str, content: str) -> List[Dict[str, str]]:
25	    """
26	    Parses markdown content into chunks based on headings (## and deeper).
27	
28	    Each chunk includes the heading, the content following it, and any
29	    detected Source: URL immediately after the heading.
30	    """
31	    chunks = []
32	    lines = content.splitlines()
33	    # Default for content before the first heading
34	    current_heading = "Introduction"
35	    current_content: List[str] = []
36	    # Use Union explicitly if Optional was removed from imports
37	    current_source_url: Union[str, None] = None
38	    heading_level = 1  # Default heading level
39	
40	    for i, line in enumerate(lines):
41	        heading_match = HEADING_RE.match(line)
42	        source_match = SOURCE_RE.match(line)
43	
44	        if heading_match:
45	            # If we have content for the previous heading, save it as a chunk
46	            if current_content:
47	                content_str = "\n".join(current_content).strip()
48	                if content_str:  # Only add if there's actual content
49	                    chunks.append(
50	                        {
51	                            "filename": filename,
52	                            "heading": current_heading,
53	                            "content": content_str,
54	                            "content_lower": content_str.lower(),
55	                            "heading_lower": current_heading.lower(),
56	                            "source_url": current_source_url or "",
57	                            "level": str(heading_level),
58	                        }
59	                    )
60	
61	            # Start a new chunk
62	            # '#' count indicates level
63	            heading_level = len(heading_match.group(1))
64	            current_heading = heading_match.group(2).strip()
65	            current_content = []
66	            current_source_url = None  # Reset source URL for the new section
67	
68	            # Check the *next* line for a potential Source: URL
69	            if i + 1 < len(lines):
70	                next_line_source_match = SOURCE_RE.match(lines[i + 1])
71	                if next_line_source_match:
72	                    current_source_url = next_line_source_match.group(1)
73	
74	        elif source_match and current_heading == "Introduction":
75	            # Capture Source: URL if it appears before the first heading
76	            current_source_url = source_match.group(1)
77	        # Avoid adding the Source: line itself to content
78	        elif not source_match:
79	            current_content.append(line)
80	
81	    # Add the last chunk
82	    if current_content:
83	        content_str = "\n".join(current_content).strip()
84	        if content_str:
85	            chunks.append(
86	                {
87	                    "filename": filename,
88	                    "heading": current_heading,
89	                    "content": content_str,
90	                    "content_lower": content_str.lower(),
91	                    "heading_lower": current_heading.lower(),
92	                    "source_url": current_source_url or "",
93	                    "level": str(heading_level),
94	                }
95	            )
96	
97	    return chunks
98	
