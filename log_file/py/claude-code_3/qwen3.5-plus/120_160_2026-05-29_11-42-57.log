292	@mcp.tool()
293	def encode_image_to_base64(image_path: str) -> Dict[str, Any]:
294	    """
295	    将本地图片文件编码为base64字符串
296	    
297	    Args:
298	        image_path: 图片文件路径
299	    
300	    Returns:
301	        包含base64编码字符串或错误信息的字典
302	    """
303	    try:
304	        with open(image_path, 'rb') as image_file:
305	            encoded_string = base64.b64encode(image_file.read()).decode('utf-8')
306	            return {
307	                "success": True,
308	                "base64_string": encoded_string,
309	                "message": "图片编码成功"
310	            }
311	    except Exception as e:
312	        return {
313	            "success": False,
314	            "error": f"编码图片失败: {str(e)}"
315	        }
