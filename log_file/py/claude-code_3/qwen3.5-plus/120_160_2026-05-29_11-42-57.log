189	def get_file_hash(file_path: str) -> str:
190	    """Calculate SHA256 hash of file content."""
191	    try:
192	        with open(file_path, 'rb') as f:
193	            return hashlib.sha256(f.read()).hexdigest()
194	    except FileNotFoundError:
195	        return ""
