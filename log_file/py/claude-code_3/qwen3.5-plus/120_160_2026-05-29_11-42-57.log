247	async def get_device_profile(adapter: MijiaAdapter, device_id: str) -> Dict[str, Any]:
248	    devices = await adapter.list_device_infos(refresh=False)
249	    device_info = next((device for device in devices if str(device.get("did")) == str(device_id)), {"did": device_id})
250	    normalized_device = normalize_device(device_info)
251	    properties = dedupe_properties(await adapter.get_device_properties(device_id))
252	    actions = dedupe_actions(await adapter.get_device_actions(device_id))
253	    capabilities = summarize_capabilities(properties, actions)
254	    capability_profile = build_device_capability_profile(device_info, properties, actions)
255	    mapping_report = build_capability_mapping_report(properties, actions, capability_profile)
256	
257	    state: Dict[str, Any] = {}
258	    for control_name, target in capability_profile["controls"].items():
259	        if target.get("kind") == "property" and target.get("readable") and target.get("name"):
260	            try:
261	                state[control_name] = await adapter.get_property_value_by_name(device_id, target["name"])
262	            except Exception:
263	                continue
264	
265	    if normalized_device.get("device_type") in READ_MOSTLY_DEVICE_TYPES:
266	        for prop in properties:
267	            prop_name = getattr(prop, "name", None)
268	            if not prop_name or prop_name in state:
269	                continue
270	            if not getattr(prop, "rw", None) or "r" in str(getattr(prop, "rw", "")).lower():
271	                try:
272	                    state[prop_name] = await adapter.get_property_value_by_name(device_id, prop_name)
273	                except Exception:
274	                    continue
275	
276	    profile = {
277	        "capabilities": capabilities,
278	        "capability_profile": capability_profile,
279	        "mapping_report": mapping_report,
280	        "standard_capability_schema": build_standard_capability_schema(capability_profile),
281	        "profile_driven_schema": build_profile_driven_schema(properties, actions),
282	        "supported_operations": describe_supported_operations(capability_profile["supported_operations"]),
283	        "state": state,
284	        "state_summary": build_state_summary(state),
285	    }
286	    profile["device_resource"] = build_device_resource(normalized_device, profile)
287	    return profile
288	
