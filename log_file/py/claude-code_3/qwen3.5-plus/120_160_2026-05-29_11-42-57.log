156	    async def call_tool(self, name: str, arguments: dict[str, Any]) -> str:
157	        """Call a specific tool."""
158	        if name == "gemini_prompt":
159	            return await self._gemini_prompt(arguments)
160	        elif name == "gemini_research":
161	            return await self._gemini_research(arguments)
162	        elif name == "gemini_analyze_code":
163	            return await self._gemini_analyze_code(arguments)
164	        elif name == "gemini_summarize":
165	            return await self._gemini_summarize(arguments)
166	        else:
167	            raise ValueError(f"Unknown tool: {name}")
168	
169	    def _validate_file_path(self, file_path: str) -> Path:
170	        """Validate that a file path is within allowed directories.
171	
172	        Args:
173	            file_path: Path to validate
174	
175	        Returns:
176	            Resolved Path object
177	
178	        Raises:
179	            ValueError: If path is outside allowed directories
180	        """
181	        # Resolve the path to handle .. and symlinks
182	        try:
183	            resolved_path = Path(file_path).resolve()
184	        except Exception as e:
185	            raise ValueError(f"Invalid file path: {file_path}") from e
186	
187	        # Check if the resolved path is within any allowed directory
188	        for allowed_dir in self.allowed_directories:
189	            try:
190	                resolved_path.relative_to(allowed_dir)
191	                return resolved_path
192	            except ValueError:
193	                continue
194	
195	        raise ValueError(
196	            f"File path '{file_path}' is outside allowed directories. "
197	            f"Allowed: {[str(d) for d in self.allowed_directories]}"
198	        )
199	
200	    async def _run_gemini_command(
201	        self,
202	        prompt: str,
203	        model: str = DEFAULT_GEMINI_MODEL,
204	        files: list[str] | None = None,
205	        stdin_input: str | None = None,
206	    ) -> str:
207	        """Run a Gemini CLI command and return the output.
208	
209	        Args:
210	            prompt: The prompt to send to Gemini
211	            model: The model to use
212	            files: Optional list of file paths to include
213	            stdin_input: Optional input to send via stdin
214	
215	        Returns:
216	            Command output as string
217	
218	        Raises:
219	            RuntimeError: If command execution fails
220	            ValueError: If file paths are invalid
221	        """
222	        cmd = [self.gemini_path, "-m", model, "-p", prompt]
223	
224	        temp_file_list = None
225	        try:
226	            if files:
227	                # Validate all file paths first
228	                validated_paths = []
229	                for file_path in files:
230	                    validated_path = self._validate_file_path(file_path)
231	                    if not validated_path.exists():
232	                        raise ValueError(f"File does not exist: {file_path}")
233	                    validated_paths.append(str(validated_path))
234	
235	                # Create a temporary file listing all files to include
236	                fd, temp_file_list = tempfile.mkstemp(suffix=".txt", text=True)
237	                try:
238	                    # Write file paths using regular file operations to ensure proper cleanup
239	                    with os.fdopen(fd, "w") as f:
240	                        for path in validated_paths:
241	                            f.write(f"{path}\n")
242	
243	                    # Now fd is closed, safe to read the file
244	                    async with aiofiles.open(temp_file_list) as f:
245	                        file_list_content = await f.read()
246	
247	                    # Add all files flag
248	                    cmd.append("-a")
249	                    stdin_input = stdin_input if stdin_input else file_list_content
250	                except Exception:
251	                    # fd is already closed by fdopen, no need to close it again
252	                    raise
253	
254	            logger.debug(f"Running command: {' '.join(cmd)}")
255	
256	            process = await asyncio.create_subprocess_exec(
257	                *cmd,
258	                stdin=asyncio.subprocess.PIPE,
259	                stdout=asyncio.subprocess.PIPE,
260	                stderr=asyncio.subprocess.PIPE,
261	            )
262	
263	            stdout, stderr = await process.communicate(
264	                input=stdin_input.encode() if stdin_input else None
265	            )
266	
267	            if process.returncode != 0:
268	                error_msg = stderr.decode().strip()
269	
270	                # Check for authentication errors
271	                if any(
272	                    phrase in error_msg.lower()
273	                    for phrase in ["not authenticated", "login required", "auth", "credentials"]
274	                ):
275	                    raise RuntimeError(
276	                        f"Gemini CLI authentication error: {error_msg}\n"
277	                        "Please run 'gemini auth login' to authenticate."
278	                    )
279	
280	                raise RuntimeError(f"Gemini CLI error: {error_msg}")
281	
282	            return stdout.decode().strip()
283	
284	        finally:
285	            # Always clean up the temporary file
286	            if temp_file_list and os.path.exists(temp_file_list):
287	                try:
288	                    os.remove(temp_file_list)
289	                except Exception as e:
290	                    logger.warning(f"Failed to remove temporary file {temp_file_list}: {e}")
291	
