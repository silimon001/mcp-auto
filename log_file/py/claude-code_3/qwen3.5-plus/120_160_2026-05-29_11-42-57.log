933	async def resolve_scene(adapter: MijiaAdapter, scene_name: str = "", scene_id: str = "", home_name: str = "", home_id: str = "") -> Dict[str, Any]:
934	    scenes = await list_normalized_scenes(adapter, home_name=home_name, home_id=home_id)
935	    if scene_id:
936	        for scene in scenes:
937	            if scene["scene_id"] == str(scene_id):
938	                return scene
939	        raise RuntimeError(f"Scene with id {scene_id} not found")
940	
941	    if scene_name:
942	        exact = [scene for scene in scenes if str(scene.get("name", "")).lower() == scene_name.strip().lower()]
943	        if exact:
944	            if len(exact) > 1:
945	                raise RuntimeError(f"Multiple scenes matched {scene_name!r}")
946	            return exact[0]
947	        fuzzy = [scene for scene in scenes if scene_name.strip().lower() in str(scene.get("name", "")).lower()]
948	        if not fuzzy:
949	            raise RuntimeError(f"No scene matched {scene_name!r}")
950	        if len(fuzzy) > 1:
951	            raise RuntimeError(f"Multiple scenes matched {scene_name!r}")
952	        return fuzzy[0]
953	
954	    raise RuntimeError("Either scene_id or scene_name is required")
955	
