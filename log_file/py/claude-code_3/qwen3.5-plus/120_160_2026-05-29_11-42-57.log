33	@mcp.tool()
34	def text_to_image(
35	    prompt: str, 
36	    size: str = "1024x1024", 
37	    model: str = "doubao-seedream-3-0-t2i-250415",
38	   # watermark: bool = False
39	) -> Dict[str, Any]:
40	    """
41	    文生图功能 - 根据文本描述生成图片
42	    
43	    Args:
44	        prompt: 图片描述提示词
45	        size: 图片尺寸，格式为"宽x高"，如"1024x1024"
46	        model: 使用的模型名称
47	    Returns:
48	        包含图片URL或错误信息的字典
49	    """
50	    try:
51	        client = initialize_client()
52	        
53	        params = {
54	            "model": model,
55	            "prompt": prompt,
56	            "size": size,
57	            "response_format": "url",
58	            "n": 1
59	        }
60	        
61	        response = client.images.generate(**params)
62	        
63	        if response.data and len(response.data) > 0:
64	            return {
65	                "success": True,
66	                "image_url": response.data[0].url,
67	                "message": "图片生成成功"
68	            }
69	        else:
70	            return {
71	                "success": False,
72	                "error": "未返回图片数据"
73	            }
74	            
75	    except Exception as e:
76	        return {
77	            "success": False,
78	            "error": f"生成图片时出错: {str(e)}"
79	        }
