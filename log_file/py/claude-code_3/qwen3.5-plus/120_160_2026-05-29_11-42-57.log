476	    """Resource that provides information about database tables"""
477	    tables = await db_manager.list_tables()
478	    table_list = "\n".join([f"- {table['table_name']} ({table['column_count']} columns)" for table in tables])
479	    return f"Available Tables:\n{table_list}"
