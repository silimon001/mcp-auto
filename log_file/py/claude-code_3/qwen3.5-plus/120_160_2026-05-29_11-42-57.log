716	            for failed in failed_files[:5]:  # Show first 5 failures
717	                result_text += f"• {failed}\n"
718	            if len(failed_files) > 5:
719	                result_text += f"... and {len(failed_files) - 5} more"
720	        
721	        return result_text
722	        
723	    except Exception as e:
724	        logger.error(f"Batch translation failed: {str(e)}")
725	        return f"❌ Batch translation failed: {str(e)}"
