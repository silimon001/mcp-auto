1	#!/usr/bin/env node
2	
3	/**
4	 * MCP Server for Bing Webmaster Tools
5	 *
6	 * This script runs the Python-based MCP server using the system Python
7	 * or a virtual environment if available.
8	 */
9	
10	const { spawn } = require('child_process');
11	const path = require('path');
12	const fs = require('fs');
13	
14	// Check if we're in development (has .venv) or production
15	const projectRoot = path.dirname(__filename);
16	const venvPath = path.join(projectRoot, '.venv');
17	const venvPython = path.join(venvPath, process.platform === 'win32' ? 'Scripts/python.exe' : 'bin/python');
18	
19	// Determine which Python to use
20	let pythonCommand;
21	if (fs.existsSync(venvPython)) {
22	  pythonCommand = venvPython;
23	} else {
24	  // In production, we'll need Python installed
25	  pythonCommand = process.platform === 'win32' ? 'python' : 'python3';
26	}
27	
28	// Run the MCP server
29	const args = ['-m', 'mcp_server_bwt'];
30	const child = spawn(pythonCommand, args, {
31	  cwd: projectRoot,
32	  stdio: 'inherit',
33	  env: { ...process.env }
34	});
35	
36	// Handle process termination
37	process.on('SIGINT', () => {
38	  child.kill('SIGINT');
39	  process.exit();
40	});
41	
42	process.on('SIGTERM', () => {
43	  child.kill('SIGTERM');
44	  process.exit();
45	});
46	
47	child.on('error', (error) => {
48	  console.error(`Failed to start MCP server: ${error.message}`);
49	  console.error('Please ensure Python 3.10+ is installed and available in your PATH');
50	  process.exit(1);
51	});
52	
53	child.on('exit', (code) => {
54	  process.exit(code || 0);
55	});
