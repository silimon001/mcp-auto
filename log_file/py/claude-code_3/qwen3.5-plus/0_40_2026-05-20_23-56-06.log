122	    """Search the Rust Windows crate API documentation (https://microsoft.github.io/windows-docs-rs/).
123	
124	    An example query is "CreateFile", "VirtualAlloc", "FILE_DISPOSITION_INFORMATION".
125	    You can't search for multiple objects at once, e.g. "CreateFile VirtualAlloc" will not work.
126	
127	    Args:
128	        query: The search term for a single object in the Windows API documentation (e.g., function name, struct name).
129	
130	    Returns:
131	        A SearchResult object containing an optional exact match documentation
132	        and a list of related API functions found in the search results.
133	    """
134	    if _search_service is None:
135	        raise RuntimeError("Search service not initialized")
136	
137	    return await _search_service.search_api(query)
