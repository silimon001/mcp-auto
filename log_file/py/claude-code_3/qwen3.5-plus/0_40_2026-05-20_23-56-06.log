18	logger = logging.getLogger(__name__)
19	
20	
21	class RelatedApiFunction(BaseModel):
22	    """Model representing a related API function."""
23	
24	    type: str = Field(description="Type of the API item (function, struct, etc)")
25	    name: str = Field(description="Full path of the API item")
26	
27	
28	class ApiDocumentation(BaseModel):
29	    """Model representing the API documentation."""
30	
31	    title: str = Field(description="Title of the API documentation")
32	    description: str | None = Field(
33	        description="Description from the documentation block", default=None
34	    )
35	    signature: str | None = Field(
36	        description="Type signature or declaration", default=None
37	    )
38	    content: str = Field(description="Main content of the documentation")
39	    feature: str | None = Field(
40	        description="Required Cargo feature for this API", default=None
41	    )
42	
43	
44	class SearchResult(BaseModel):
45	    """Model representing the search results."""
46	
47	    exact_match: ApiDocumentation | None = Field(
48	        description="Documentation for exact API match if found", default=None
49	    )
50	    related_functions: list[RelatedApiFunction] = Field(
51	        description="List of related API functions", default_factory=list
52	    )
53	
54	
55	class SearchService:
56	    """High-level service for searching Windows documentation."""
57	
58	    def __init__(
59	        self,
60	        browser_manager: BrowserManager,
61	        config: Config,
62	        cache: CacheManager,
63	        search_index: SearchIndexClient,
64	    ) -> None:
65	        """Initialize the search service.
66	
67	        Args:
68	            browser_manager: Browser manager instance
69	            config: Configuration object
70	            cache: Cache manager instance
71	            search_index: Search index client for fast lookups
72	        """
73	        self._browser_manager = browser_manager
74	        self._config = config
75	        self._cache = cache
76	        self._search_index = search_index
77	        self._scraper = DocsScraper(config)
78	
79	    async def search_api(self, search_term: str, max_related: int = 5) -> SearchResult:
80	        """Search the Windows API documentation.
81	
82	        Args:
83	            search_term: The search term (e.g., "CreateFile", "VirtualAlloc")
84	            max_related: Maximum number of related functions to return
85	
86	        Returns:
87	            SearchResult with exact match and related functions
88	
89	        Raises:
90	            Exception: If search fails
91	        """
92	        try:
93	            # Check cache for search results
94	            cache_key = f"search:{search_term}:{max_related}"
95	            cached_result = await self._cache.search_cache.get(cache_key)
96	            if cached_result is not None:
97	                logger.info(f"Cache hit for search: {search_term}")
98	                return cached_result
99	
100	            # Search using the features page (gives full namespace paths)
101	            async with self._browser_manager.get_features_page() as page:
102	                search_results = await self._scraper.search_features_page(
103	                    page, search_term, max_results=max_related
104	                )
105	
106	            if not search_results:
107	                empty_result = SearchResult(related_functions=[])
108	                await self._cache.search_cache.set(cache_key, empty_result)
109	                return empty_result
110	
111	            # Build related functions list and find exact match
112	            related_functions: list[RelatedApiFunction] = []
113	            exact_match_result: dict | None = None
114	
115	            for result_item in search_results:
116	                related_functions.append(
117	                    RelatedApiFunction(
118	                        type=result_item["type"], name=result_item["full_path"]
119	                    )
120	                )
121	
122	                # Check for exact name match (first result is usually exact match)
123	                if (
124	                    exact_match_result is None
125	                    and result_item["name"].lower() == search_term.lower()
126	                ):
127	                    exact_match_result = result_item
128	
129	            # Get exact match documentation if found
130	            exact_match = None
131	            if exact_match_result:
132	                try:
133	                    # Determine item type by checking the docs page
134	                    full_path = exact_match_result["full_path"]
135	                    item_type = await self._determine_item_type(full_path)
136	                    exact_match_result["type"] = item_type
137	
138	                    # Update the related functions with the correct type
139	                    for i, func in enumerate(related_functions):
140	                        if func.name == full_path:
141	                            related_functions[i] = RelatedApiFunction(
142	                                type=item_type, name=full_path
143	                            )
144	                            break
145	
146	                    # Get documentation
147	                    exact_match = await self._get_api_details(
148	                        full_path, exact_match_result["feature"], item_type
149	                    )
150	                except (DocumentationNotFoundError, FeatureNotFoundError) as e:
151	                    logger.warning(
152	                        f"Failed to get details for exact match {full_path}: {e}"
153	                    )
154	
155	            result = SearchResult(
156	                exact_match=exact_match, related_functions=related_functions
157	            )
158	
159	            # Cache the result
160	            await self._cache.search_cache.set(cache_key, result)
161	
162	            return result
163	
164	        except Exception as e:
165	            logger.error(f"Search failed for '{search_term}': {e}")
166	            raise
167	
168	    async def _determine_item_type(self, full_path: str) -> str:
169	        """Determine the item type by trying to load docs with different type prefixes.
170	
171	        Args:
172	            full_path: Full API path (e.g., windows::Win32::System::Memory::VirtualAlloc)
173	
174	        Returns:
175	            Item type ("fn", "struct", "constant", etc.)
176	        """
177	        # Try types in order of likelihood
178	        types_to_try = ["fn", "struct", "type", "constant", "enum", "union", "trait"]
179	
180	        for item_type in types_to_try:
181	            try:
182	                url = self._scraper.full_path_to_doc_url(full_path, item_type)
183	                # Try a quick HEAD request to see if the page exists
184	                async with self._browser_manager.get_docs_page() as page:
185	                    response = await page.goto(
186	                        url, timeout=5000, wait_until="domcontentloaded"
187	                    )
188	                    if response and response.status == 200:
189	                        # Check if it's actually a valid docs page
190	                        has_content = await page.locator("#main-content").count() > 0
191	                        if has_content:
192	                            logger.info(
193	                                f"Determined type '{item_type}' for {full_path}"
194	                            )
195	                            return item_type
196	            except Exception:
197	                continue
198	
199	        # Default to function
200	        logger.warning(f"Could not determine type for {full_path}, defaulting to 'fn'")
201	        return "fn"
202	
203	    async def _get_api_details(
204	        self, api_path: str, feature: str | None = None, item_type: str = "fn"
205	    ) -> ApiDocumentation:
206	        """Get detailed documentation for an API.
207	
208	        Args:
209	            api_path: Full API path
210	            feature: Cargo feature (if already known)
211	            item_type: Type of item (fn, struct, etc.)
212	
213	        Returns:
214	            ApiDocumentation with details
215	
216	        Raises:
217	            DocumentationNotFoundError: If documentation cannot be found
218	        """
219	        # Check doc cache
220	        doc_cache_key = f"doc:{api_path}:{item_type}"
221	        cached_doc = await self._cache.doc_cache.get(doc_cache_key)
222	        if cached_doc is not None:
223	            logger.info(f"Cache hit for documentation: {api_path}")
224	            return cached_doc
225	
226	        # Get documentation page
227	        doc_page = await self._get_doc_page_direct(api_path, item_type)
228	
229	        # Get feature if not provided
230	        if not feature:
231	            try:
232	                feature = await self._get_feature_for_api(api_path)
233	            except Exception as e:
234	                logger.warning(f"Could not get feature for {api_path}: {e}")
235	                # Fallback feature generation
236	                module_path = "::".join(
237	                    self._scraper.convert_doc_to_feature_path(api_path).split("::")[:-1]
238	                )
239	                feature = "_".join(module_path.split("::"))
240	
241	        api_doc = ApiDocumentation(
242	            title=doc_page.title,
243	            description=doc_page.description,
244	            signature=doc_page.signature,
245	            content=doc_page.content,
246	            feature=feature,
247	        )
248	
249	        # Cache the result
250	        await self._cache.doc_cache.set(doc_cache_key, api_doc)
251	
252	        return api_doc
253	
254	    async def _get_doc_page_direct(self, api_path: str, item_type: str) -> DocPage:
255	        """Get documentation page content directly by URL.
256	
257	        Args:
258	            api_path: Full API path
259	            item_type: Type of item (fn, struct, etc.)
260	
261	        Returns:
262	            DocPage content
263	
264	        Raises:
265	            DocumentationNotFoundError: If documentation cannot be found
266	        """
267	        cache_key = f"docpage:{api_path}:{item_type}"
268	        cached = await self._cache.doc_cache.get(cache_key)
269	        if cached is not None:
270	            return cached
271	
272	        # Generate URL directly
273	        url = self._scraper.full_path_to_doc_url(api_path, item_type)
274	
275	        async with self._browser_manager.get_docs_page() as page:
276	            response = await page.goto(
277	                url,
278	                wait_until="domcontentloaded",
279	                timeout=self._config.page_load_timeout,
280	            )
281	
282	            if not response or response.status != 200:
283	                raise DocumentationNotFoundError(
284	                    f"Failed to load page: {response.status if response else 'No response'}"
285	                )
286	
287	            # Verify page loaded correctly
288	            has_content = await page.locator("#main-content").count() > 0
289	            if not has_content:
290	                raise DocumentationNotFoundError(
291	                    "Page loaded but #main-content not found"
292	                )
293	
294	            # Extract content
295	            doc_page = await self._scraper._extract_doc_content(page)
296	
297	        await self._cache.doc_cache.set(cache_key, doc_page)
298	        return doc_page
299	
300	    async def _get_doc_page(self, api_path: str) -> DocPage:
301	        """Get documentation page content with caching.
302	
303	        Args:
304	            api_path: Full API path
305	
306	        Returns:
307	            DocPage content
308	        """
309	        cache_key = f"docpage:{api_path}"
310	        cached = await self._cache.doc_cache.get(cache_key)
311	        if cached is not None:
312	            return cached
313	
314	        async with self._browser_manager.get_docs_page() as page:
315	            doc_page = await self._scraper.get_doc_page_content(page, api_path)
316	
317	        await self._cache.doc_cache.set(cache_key, doc_page)
318	        return doc_page
319	
320	    async def _get_feature_for_api(self, api_path: str) -> str | None:
321	        """Get the Cargo feature for an API with caching.
322	
323	        Args:
324	            api_path: Full API path
325	
326	        Returns:
327	            Feature name or None
328	        """
329	        feature_path = self._scraper.convert_doc_to_feature_path(api_path)
330	        cache_key = f"feature:{feature_path}"
331	
332	        cached = await self._cache.feature_cache.get(cache_key)
333	        if cached is not None:
334	            return cached
335	
336	        async with self._browser_manager.get_features_page() as page:
337	            feature = await self._scraper.find_feature_for_api(page, feature_path)
338	
339	        await self._cache.feature_cache.set(cache_key, feature)
340	        return feature
