66	                "jsonrpc": "2.0",
67	                "method": "api.ready",
68	                "params": [],
69	                "id": 1
70	            }
71	            
72	            response = httpx.post(
73	                "http://localhost:23119/better-bibtex/json-rpc",
74	                json=payload,
75	                headers={
76	                    "Content-Type": "application/json",
77	                    "Accept": "application/json"
78	                },
79	                timeout=2.0
80	            )
81	            
82	            if response.status_code == 200:
83	                result = response.json()
84	                # Check if we got a valid response with both zotero and betterbibtex versions
85	                if "result" in result and isinstance(result["result"], dict):
86	                    ready = "betterbibtex" in result["result"] and "zotero" in result["result"]
87	                    if ready:
88	                        # Cache positive result
89	                        self._bbt_ready_cache = True
90	                    return ready
91	            
92	            return False
93	            
94	        except (httpx.RequestError, httpx.TimeoutException, json.JSONDecodeError):
95	            return False
