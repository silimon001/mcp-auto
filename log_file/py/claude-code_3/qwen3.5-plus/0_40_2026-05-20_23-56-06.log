27	def find_scheme(project_type: str, project_name: str) -> str:
28	    schemes_result = subprocess.run(["xcodebuild",
29	                                    "-list",
30	                                    project_type,
31	                                    project_name],
32	                                    stdout=subprocess.PIPE,
33	                                    stderr=subprocess.PIPE,
34	                                    check=False).stdout.decode("utf-8")
35	    
36	    schemes_lines = schemes_result.splitlines()
37	    schemes = []
38	    in_schemes_section = False
39	    for line in schemes_lines:
40	        if "Schemes:" in line:
41	            in_schemes_section = True
42	            continue
43	        if in_schemes_section:
44	            scheme = line.strip()
45	            if scheme:
46	                schemes.append(scheme)
47	    
48	    if schemes:
49	        return schemes[0]
50	    else:
51	        return ""
