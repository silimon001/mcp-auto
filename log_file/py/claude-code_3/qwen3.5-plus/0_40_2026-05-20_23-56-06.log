33	from utcp.data.utcp_client_config import UtcpClientConfig
34	from utcp.data.call_template import CallTemplate
35	
36	# Global UTCP client instance
37	utcp_client: Optional[UtcpClient] = None
38	
39	# Initialize FastMCP server
40	mcp = FastMCP("UTCP Client MCP Server")
41	
42	async def initialize_utcp_client():
43	    """Initialize the UTCP client and try to load providers.json from the same directory."""
44	    global utcp_client
45	    
46	    if utcp_client is not None:
47	        return utcp_client
48	    
49	    script_dir = Path(__file__).parent
50	    config_file = script_dir / ".utcp_config.json"
51	    
52	    if config_file.exists():
53	        config = json.loads(config_file.read_text())
54	        config = UtcpClientConfig.model_validate(config)
55	    else:
56	        config = UtcpClientConfig()
57	
58	    # Create UTCP client
59	    utcp_client = await UtcpClient.create(config=config)
60	    
61	    return utcp_client
62	
63	
64	@mcp.tool()
65	async def register_manual(manual_call_template: CallTemplate) -> Dict[str, Any]:
66	    """Register a new tool provider with the UTCP client.
67	    
68	    Args:
69	        manual_call_template: Call template to the endpoint of a UTCP Manual
70	        
71	    Returns:
72	        Dictionary with success status and list of registered tools
73	    """
74	    client = await initialize_utcp_client()
75	    
76	    try:
77	        tools = await client.register_manual(manual_call_template)
78	        
79	        return {
80	            "success": True,
81	            "manual_name": manual_call_template.name,
82	            "tools_registered": len(tools),
83	            "tool_names": [tool.name for tool in tools]
84	        }
85	    except Exception as e:
86	        return {
87	            "success": False,
88	            "error": str(e)
89	        }
90	
91	
92	@mcp.tool()
93	async def deregister_manual(manual_name: str) -> Dict[str, Any]:
94	    """Deregister a tool provider from the UTCP client.
95	    
96	    Args:
97	        manual_name: Name of the manual to deregister
98	        
99	    Returns:
100	        Dictionary with success status
101	    """
102	    client = await initialize_utcp_client()
103	    
104	    try:
105	        await client.deregister_manual(manual_name)
106	        return {
107	            "success": True,
108	            "message": f"Manual '{manual_name}' deregistered successfully"
109	        }
110	    except Exception as e:
111	        return {
112	            "success": False,
113	            "error": str(e)
114	        }
115	
