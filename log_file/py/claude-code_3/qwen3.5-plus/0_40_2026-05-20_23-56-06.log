112	    def from_env(cls) -> 'GraphitiConfig':
113	        """Create a configuration instance from environment variables."""
114	        neo4j_uri = os.environ.get('NEO4J_URI', 'bolt://neo4j:7687')
115	        neo4j_user = os.environ.get('NEO4J_USER', 'neo4j')
116	        neo4j_password = os.environ.get('NEO4J_PASSWORD', 'password')
117	        openai_api_key = os.environ.get('OPENAI_API_KEY')
118	        openai_base_url = os.environ.get('OPENAI_BASE_URL')
119	        model_name = os.environ.get('MODEL_NAME')
120	
121	        # Environment context check for password hardening
122	        # Use GRAPHITI_ENV if set, else treat as non-dev
123	        env_context = os.environ.get('GRAPHITI_ENV', '').lower()
124	        if (
125	            neo4j_password == 'password'
126	            and env_context not in ('dev', 'development')
127	        ):
128	            raise ValueError(
129	                "Default Neo4j password 'password' is insecure and not allowed in non-development environments. "
130	                "Set a strong NEO4J_PASSWORD."
131	            )
132	
133	        return cls(
134	            neo4j_uri=neo4j_uri,
135	            neo4j_user=neo4j_user,
136	            neo4j_password=neo4j_password,
137	            openai_api_key=openai_api_key,
138	            openai_base_url=openai_base_url,
139	            model_name=model_name,
140	        )
141	
