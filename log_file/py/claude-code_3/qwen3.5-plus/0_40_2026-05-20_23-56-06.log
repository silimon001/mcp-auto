1096	# --- MODIFIED: Main loading function now handles selection spec ---
1097	def load_entities_from_directory(directory_path: str, subdir_selection_spec: str = "") -> None:
1098	    """Load Python entity modules from a directory, optionally filtering by subdirectories.
1099	
1100	    If subdir_selection_spec is empty, loads all entities recursively from directory_path.
1101	    If subdir_selection_spec is provided (comma-separated subdir names), loads entities
1102	    recursively only from those specific subdirectories within directory_path.
1103	
1104	    Args:
1105	        directory_path: Base path to the directory containing entity modules/subdirectories.
1106	        subdir_selection_spec: Comma-separated string of subdirectory names to load, or empty to load all.
1107	    """
1108	    logger.info(f"Loading entities from base directory: {directory_path} with selection spec: '{subdir_selection_spec or 'ALL'}'")
1109	    base_directory = Path(directory_path)
1110	    if not base_directory.exists() or not base_directory.is_dir():
1111	        logger.warning(f"Base entities directory '{directory_path}' does not exist or is not a directory. Skipping load.")
1112	        return
1113	
1114	    if not subdir_selection_spec:
1115	        # Load all recursively from the base directory
1116	        _load_modules_recursive(base_directory)
1117	    else:
1118	        # Load only specified subdirectories
1119	        selected_subdirs = [subdir.strip() for subdir in subdir_selection_spec.split(',') if subdir.strip()]
1120	        logger.info(f"Selectively loading entities from subdirectories: {selected_subdirs}")
1121	
1122	        if not selected_subdirs:
1123	             logger.warning(f"Empty or invalid subdir selection spec provided: '{subdir_selection_spec}'. No specific subdirectories will be loaded.")
1124	             return
1125	
1126	        for subdir_name in selected_subdirs:
1127	            target_dir = base_directory / subdir_name
1128	            if target_dir.exists() and target_dir.is_dir():
1129	                _load_modules_recursive(target_dir)
1130	            else:
1131	                logger.warning(f"Specified entity subdirectory '{target_dir}' does not exist or is not a directory. Skipping.")
