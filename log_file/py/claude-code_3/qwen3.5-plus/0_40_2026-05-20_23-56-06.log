193	@mcp.tool()
194	def create_form(title: str, description: str = "") -> str:
195	    """
196	    Create a new Google Form
197	
198	    Args:
199	        title: The title of the form
200	        description: Optional description for the form
201	
202	    Returns:
203	        JSON with form ID and URL
204	    """
205	    service = get_forms_service()
206	    form = {
207	        'info': {
208	            'title': title,
209	            'documentTitle': title
210	        }
211	    }
212	
213	    if description:
214	        form['info']['description'] = description
215	
216	    result = service.forms().create(body=form).execute()
217	
218	    return json.dumps({
219	        'form_id': result.get('formId'),
220	        'url': result.get('responderUri')
221	    }, indent=2)
