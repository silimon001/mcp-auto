52	    def _check_bbt_library_ready(self) -> bool:
53	        """Check if the Better BibTeX library is ready via JSON-RPC api.ready() call
54	        
55	           Caches the result, because this is just delay after Zotero is started.
56	        """
57	        if not self.BBT:
58	            return False
59	            
60	        # Return cached result if we've already confirmed it's ready
61	        if self._bbt_ready_cache is True:
62	            return True
63	            
64	        try:
