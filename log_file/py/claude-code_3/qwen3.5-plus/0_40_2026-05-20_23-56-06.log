161	# Function to reconfigure logging level based on final decision
162	def configure_logging(level_name: str):
163	    """
164	    Configure or reconfigure the logging level based on a string level name.
165	    
166	    Args:
167	        level_name: A string representation of the logging level ('debug', 'info', etc.)
168	    """
169	    global logger, log_level
170	    level_name_upper = level_name.upper()
171	    new_level = getattr(logging, level_name_upper, DEFAULT_LOG_LEVEL)
172	    if new_level != log_level:  # Only reconfigure if level changes
173	        log_level = new_level
174	        logging.getLogger().setLevel(log_level)  # Set level on root logger
175	        # Re-get logger instance for safety
176	        logger = logging.getLogger(__name__)
177	        logger.info(f"Logging level reconfigured to: {logging.getLevelName(log_level)}")
178	    else:
179	        logger.info(f"Logging level remains at: {logging.getLevelName(log_level)}")
