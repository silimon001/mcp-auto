227	async def initialize_graphiti(llm_client: Optional[LLMClient] = None, destroy_graph: bool = False):
228	    """Initialize the Graphiti client with the provided settings.
229	
230	    Args:
231	        llm_client: Optional LLMClient instance to use for LLM operations
232	        destroy_graph: Optional boolean to destroy all Graphiti graphs
233	    """
234	    global graphiti_client
235	
236	    # If no client is provided, create a default OpenAI client
237	    if not llm_client:
238	        if config.openai_api_key:
239	            llm_config = LLMConfig(api_key=config.openai_api_key)
240	            if config.openai_base_url:
241	                llm_config.base_url = config.openai_base_url
242	            if config.model_name:
243	                llm_config.model = config.model_name
244	            llm_client = OpenAIClient(config=llm_config)
245	        else:
246	            raise ValueError('OPENAI_API_KEY must be set when not using a custom LLM client')
247	
248	    if not config.neo4j_uri or not config.neo4j_user or not config.neo4j_password:
249	        raise ValueError('NEO4J_URI, NEO4J_USER, and NEO4J_PASSWORD must be set')
250	
251	    graphiti_client = Graphiti(
252	        uri=config.neo4j_uri,
253	        user=config.neo4j_user,
254	        password=config.neo4j_password,
255	        llm_client=llm_client,
256	    )
257	
258	    if destroy_graph:
259	        logger.info('Destroying graph...')
260	        await clear_data(graphiti_client.driver)
261	
262	    # Initialize the graph database with Graphiti's indices
263	    await graphiti_client.build_indices_and_constraints()
264	    logger.info('Graphiti client initialized successfully')
