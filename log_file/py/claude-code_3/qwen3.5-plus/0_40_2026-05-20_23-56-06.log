452	@mcp.tool(description="Get detailed information on specific item(s) in the library")
453	async def get_items_metadata(item_key: Annotated[str, Field(description='Item key(s) to retrieve. Multiple keys are separated by comma.')],
454	                             include_fulltext: bool = Field(default=False, 
455	                                                            description='Include fulltext content (default: False)'),
456	                             include_abstract: bool = Field(default=True, 
457	                                                            description='Include abstract (default: True)'),
458	                             include_bibtex: bool   = Field(default=True,
459	                                                            description='Include BibTeX key (default: True)'),
460	                             context: Optional[Context] = None) -> str:
461	    """
462	    Get detailed information and metadata about specific Zotero item(s) 
463	    in the library as JSON metadata.
464	    
465	    Args:
466	        item_key: The papers Zotero Key. Can be a comma separated list.
467	    """ 
468	    info = None
469	    item_keys : list[str] = [p.strip() for p in item_key.split(',')]
470	    
471	    try:
472	        client = _get_zotero_client()
473	        items = {item['key']: item for item in client.get_subset(item_keys)}
474	
475	        if len(items) == 0:
476	            return json.dumps({
477	                "error": "Items not found",
478	                "missing_keys": list(item_keys),
479	                "suggestion": "Verify the items exist and you have permission to access them"
480	            }, indent=2)
481	
482	        if include_bibtex:
483	            try:
484	                bbt_keys = client.citation_keys(list(items.keys()))
485	                for key, BBT_key in bbt_keys.items():
486	                    items[key]['BBT_key'] = BBT_key
487	            except Exception as e:
488	                await context.warning(f"BBT: {str(e)}")
489	    
490	        formatted_items = [client.format_item(item, include_abstract=True) for key, item in items.items()]
491	        
492	        if len(items) < len(item_keys):
493	            missing_keys = set(item_keys) - set(items.keys())
494	            info = {
495	                "error": "Some items not found",
496	                "missing_keys": list(missing_keys),
497	                "suggestion": "Verify the items exist and you have permission to access them"
498	            }
499	        
500	
501	        if info:
502	            return json.dumps({'log': info, 'items': formatted_items}, indent=2)
503	        else:
504	            return json.dumps(formatted_items, indent=2)
505	    
506	    except Exception as e:
507	        if context and hasattr(context, '_fastmcp'):
508	            await context.error(f"Failed to fetch item details {item_key}. Message: {str(e)}")
509	        return json.dumps({
510	                "error": f"Failed to fetch item details. Message: {str(e)}",
511	                "item_key": item_key,
512	        }, indent=2)
