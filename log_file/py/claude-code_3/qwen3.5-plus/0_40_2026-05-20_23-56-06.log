32	@asynccontextmanager
33	async def lifespan(server) -> AsyncIterator[None]:
34	    """Lifespan context manager for server startup and shutdown.
35	
36	    This manages the browser instance lifecycle, ensuring the browser
37	    is created once at startup and properly cleaned up at shutdown.
38	    """
39	    global \
40	        _browser_manager, \
41	        _search_service, \
42	        _cache_manager, \
43	        _search_index_client, \
44	        _cleanup_task
45	
46	    # Load configuration
47	    config = Config.from_env()
48	    logger.info("Starting Windows RS MCP Server...")
49	
50	    try:
51	        # Initialize cache manager
52	        _cache_manager = CacheManager(ttl=config.cache_ttl, enabled=config.enable_cache)
53	        logger.info(
54	            f"Cache initialized (enabled={config.enable_cache}, ttl={config.cache_ttl}s)"
55	        )
56	
57	        # Initialize and load search index
58	        _search_index_client = SearchIndexClient(
59	            index_url=config.search_index_url, cache_ttl=config.cache_ttl
60	        )
61	        await _search_index_client.load()
62	        logger.info(
63	            f"Search index loaded ({_search_index_client.item_count} items indexed)"
64	        )
65	
66	        # Initialize browser manager
67	        _browser_manager = BrowserManager(config)
68	        await _browser_manager.start()
69	
70	        # Initialize search service
71	        _search_service = SearchService(
72	            _browser_manager, config, _cache_manager, _search_index_client
73	        )
74	        logger.info("Search service initialized")
75	
76	        # Start background cache cleanup task
77	        _cleanup_task = asyncio.create_task(_periodic_cache_cleanup())
78	
79	        logger.info("Server initialization complete")
80	
81	        yield  # Server runs here
82	
83	    finally:
84	        # Cleanup
85	        logger.info("Shutting down server...")
86	
87	        if _cleanup_task:
88	            _cleanup_task.cancel()
89	            try:
90	                await _cleanup_task
91	            except asyncio.CancelledError:
92	                pass
93	
94	        if _browser_manager:
95	            await _browser_manager.stop()
96	
97	        if _cache_manager:
98	            await _cache_manager.clear_all()
99	
100	        logger.info("Server shutdown complete")
101	
102	
103	async def _periodic_cache_cleanup() -> None:
104	    """Periodically clean up expired cache entries."""
105	    try:
106	        while True:
107	            await asyncio.sleep(60)  # Run every minute
108	            if _cache_manager:
109	                removed = await _cache_manager.cleanup_expired_all()
110	                if removed > 0:
111	                    logger.info(f"Cleaned up {removed} expired cache entries")
112	    except asyncio.CancelledError:
113	        logger.info("Cache cleanup task cancelled")
114	        raise
