482	async def search_nodes(
483	    query: str,
484	    group_ids: Optional[list[str]] = None,
485	    max_nodes: int = 10,
486	    center_node_uuid: Optional[str] = None,
487	    entity: str = '',  # cursor seems to break with None
488	) -> Union[NodeSearchResponse, ErrorResponse]:
489	    """Search the Graphiti knowledge graph for relevant node summaries.
490	    These contain a summary of all of a node's relationships with other nodes.
491	
492	    Note: entity is a single entity to filter results (permitted: "Preference", "Procedure").
493	
494	    Args:
495	        query: The search query
496	        group_ids: Optional list of group IDs to filter results
497	        max_nodes: Maximum number of nodes to return (default: 10)
498	        center_node_uuid: Optional UUID of a node to center the search around
499	        entity: Optional single entity to filter results (permitted: "Preference", "Procedure")
500	    """
501	    global graphiti_client
502	
503	    if graphiti_client is None:
504	        return ErrorResponse(error='Graphiti client not initialized')
505	
506	    try:
507	        # Use the provided group_ids or fall back to the default from config if none provided
508	        effective_group_ids = (
509	            group_ids if group_ids is not None else [config.group_id] if config.group_id else []
510	        )
511	
512	        # Configure the search
513	        if center_node_uuid is not None:
514	            search_config = NODE_HYBRID_SEARCH_NODE_DISTANCE.model_copy(deep=True)
515	        else:
516	            search_config = NODE_HYBRID_SEARCH_RRF.model_copy(deep=True)
517	        search_config.limit = max_nodes
518	
519	        filters = SearchFilters()
520	        if entity != '':
521	            filters.node_labels = [entity]
522	
523	        # We've already checked that graphiti_client is not None above
524	        assert graphiti_client is not None
525	
526	        # Use cast to help the type checker understand that graphiti_client is not None
527	        client = cast(Graphiti, graphiti_client)
528	
529	        # Perform the search using the _search method
530	        search_results = await client._search(
531	            query=query,
532	            config=search_config,
533	            group_ids=effective_group_ids,
534	            center_node_uuid=center_node_uuid,
535	            search_filter=filters,
536	        )
537	
538	        if not search_results.nodes:
539	            return NodeSearchResponse(message='No relevant nodes found', nodes=[])
540	
541	        # Format the node results
542	        formatted_nodes: list[NodeResult] = [
543	            {
544	                'uuid': node.uuid,
545	                'name': node.name,
546	                'summary': node.summary if hasattr(node, 'summary') else '',
547	                'labels': node.labels if hasattr(node, 'labels') else [],
548	                'group_id': node.group_id,
549	                'created_at': node.created_at.isoformat(),
550	                'attributes': node.attributes if hasattr(node, 'attributes') else {},
551	            }
552	            for node in search_results.nodes
553	        ]
554	
555	        return NodeSearchResponse(message='Nodes retrieved successfully', nodes=formatted_nodes)
556	    except Exception as e:
557	        error_msg = str(e)
558	        logger.error(f'Error searching nodes: {error_msg}')
559	        return ErrorResponse(error=f'Error searching nodes: {error_msg}')
560	
