53	def find_available_simulator() -> str:
54	    devices_result = subprocess.run(["xcrun", "simctl", "list", "devices", "--json"], stdout=subprocess.PIPE, check=False)
55	    devices_json = json.loads(devices_result.stdout.decode("utf-8"))
56	    
57	    for runtime_id, devices in devices_json["devices"].items():
58	        if "iOS" in runtime_id:
59	            for device in devices:
60	                if device["isAvailable"]:
61	                    return f'platform=iOS Simulator,name={device["name"]},OS={runtime_id.split(".")[-1].replace("iOS-", "").replace("-", ".")}'
62	    return ""
63	class Folder(BaseModel):
64	    """Parameters"""
65	    folder: Annotated[str, Field(description="The full path of the current folder that the iOS Xcode workspace/project sits")]
66	
67	server = Server("build")
68	
69	@server.list_tools()
70	async def list_tools() -> list[Tool]:
71	    return [
72	        Tool(
73	            name = "build",
74	            description = "Build the iOS Xcode workspace/project in the folder",
75	            inputSchema = Folder.model_json_schema(),
76	        ),
77	        Tool(
78	            name="test",
79	            description="Run test for the iOS Xcode workspace/project in the folder",
80	            inputSchema=Folder.model_json_schema(),
81	        )
82	    ]
83	@server.call_tool()
84	async def call_tool(name, arguments: dict) -> list[TextContent]:
85	    try:
86	        args = Folder(**arguments)
87	    except ValueError as e:
88	        raise McpError(ErrorData(code=INVALID_PARAMS, message=str(e)))
89	    os.chdir(args.folder)
90	    xcode_project_path = find_xcode_project()
91	    project_name = os.path.basename(xcode_project_path)
92	    project_type = ""
93	    if xcode_project_path.endswith(".xcworkspace"):
94	        project_type = "-workspace"
95	    else:
96	        project_type = "-project"
97	
98	    scheme = find_scheme(project_type, project_name)
99	    destination = find_available_simulator()
100	    command = ["xcodebuild",
101	               project_type,
102	               project_name,
103	               "-scheme",
104	               scheme,
105	               "-destination",
106	               destination]
107	    if name == "test":
108	        command.append("test")
109	
110	    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False).stdout
111	    
112	    lines = result.decode("utf-8").splitlines()
113	    error_lines = [line for line in lines if "error:" or "warning:" in line.lower()]
114	    error_message = "\n".join(error_lines)
115	    if not error_message:
116	        error_message = "Successful"
117	    return [
118	        TextContent(type="text", text=f"Command: {' '.join(command)}"),
119	        TextContent(type="text", text=f"{error_message}")
120	        ]
121	
122	
123	async def run():
124	    options = server.create_initialization_options()
125	    async with stdio_server() as (read_stream, write_stream):
126	        await server.run(
127	            read_stream,
128	            write_stream,
129	            options,
130	            raise_exceptions=True,
131	        )
132	
133	if __name__ == "__main__":
134	    import asyncio
