132	    except Exception as e:
133	        return f"Failed to create dataset: {str(e)}"
134	
135	
136	@mcp.tool()
137	def upload_rag(dataset_name: str, display_names: list[str], blobs: list[str]) -> str:
138	    """Uploads documents and provide more knowledge base for the dataset.
139	
140	    Args:
141	        dataset_name (str): The name of the dataset to upload documents to
142	        display_names (list[str]): List of display names for the documents
143	        blobs (list[str]): List of document contents as strings
144	
145	    Returns:
146	        str: Response from the API indicating success or failure
147	    """
148	    try:
149	        print("dataset_name", dataset_name)
150	        dataset = ragflow.get_dataset(name=dataset_name)
151	
152	        documents = []
153	        for display_name, blob in zip(display_names, blobs):
154	            documents.append({
155	                "display_name": display_name,
156	                "blob": blob
157	            })
158	
159	        # Upload documents
160	        response = dataset.upload_documents(documents)
161	
162	        # Get document IDs
163	        doc_info = []
164	        for doc in response:
165	            dataset.async_parse_documents([doc.id])
166	            doc_info.append({
167	                "name": doc.display_name if hasattr(doc, 'display_name') else display_names[0],
168	                "id": doc.id
169	            })
170	
171	        # training
172	
173	        return {
174	            "status": "success",
175	            "message": f"Successfully uploaded {len(documents)} documents",
176	            "dataset": dataset_name,
177	            "documents": doc_info
178	        }
179	    except Exception as e:
180	        return {
181	            "status": "error",
182	            "message": str(e)
183	        }
184	
