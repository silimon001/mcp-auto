14	mcp = FastMCP(name="Tailscale Identity Echo Server")
15	
16	@mcp.tool()
17	async def greet() -> str:
18	    req: Request = get_http_request()
19	    return (
20	        f"Hello, {req.headers.get('Tailscale-User-Name','Unknown')}! "
21	        f"You are logged in as {req.headers.get('Tailscale-User-Login','Unknown')}."
22	    )
23	
24	def main():
25	    print(f"Starting FastMCP with transport={transport}", file=sys.stderr)
26	    try:
27	        mcp.run(transport=transport, port=8080, host="0.0.0.0")
28	    except Exception as e:
29	        print(f"FATAL: Server startup failed: {e}", file=sys.stderr)
30	        sys.exit(1)
31	    print("i exit")
