1	#!/usr/bin/env node
2	
3	// UTCP-MCP Bridge Entry Point
4	// This is the main entry point for the npx @utcp/mcp-bridge command
5	
6	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
7	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
8	import { z } from "zod";
9	import path from "path";
10	import { promises as fs } from "fs";
11	import { parse as parseDotEnv } from 'dotenv';
12	import { fileURLToPath } from 'url';
13	import { dirname } from 'path';
14	
15	import "@utcp/http";
16	import "@utcp/text";
17	import "@utcp/mcp";
18	import "@utcp/cli";
19	import "@utcp/dotenv-loader"
20	import "@utcp/file"
21	
22	import {
23	    UtcpClient,
24	    CallTemplateSchema,
25	    InMemConcurrentToolRepository,
26	    TagSearchStrategy,
27	    DefaultVariableSubstitutor,
28	    ensureCorePluginsInitialized,
29	    UtcpClientConfigSerializer
30	} from "@utcp/sdk";
31	import type { UtcpClientConfig } from "@utcp/sdk";
32	import { ContentBlock, ContentBlockSchema } from "@modelcontextprotocol/sdk/types.js";
33	
34	// Get current file directory for Node.js ESM
35	const __filename = fileURLToPath(import.meta.url);
36	const __dirname = dirname(__filename);
37	
38	ensureCorePluginsInitialized();
39	
40	let utcpClient: UtcpClient | null = null;
41	
42	async function main() {
43	    setupMcpTools();
44	    utcpClient = await initializeUtcpClient();
45	    const transport = new StdioServerTransport();
46	    await mcp.connect(transport);
47	}
48	
49	const mcp = new McpServer({
50	    name: "UTCP-Client-MCP-Bridge",
51	    version: "1.0.0",
52	});
53	
54	function setupMcpTools() {
55	    mcp.registerTool("register_manual", {
56	        title: "Register a UTCP Manual",
57	        description: "Registers a new tool provider by providing its call template.",
58	        inputSchema: { manual_call_template: CallTemplateSchema.describe("The call template for the UTCP Manual endpoint.") },
59	    }, async (input) => {
60	        const client = await initializeUtcpClient();
61	        try {
62	            const result = await client.registerManual(input.manual_call_template as any);
63	            return { content: [{ type: "text", text: JSON.stringify(result) }] };
64	        } catch (e: any) {
65	            return { content: [{ type: "text", text: JSON.stringify({ success: false, error: e.message }) }] };
66	        }
67	    });
68	
69	    mcp.registerTool("deregister_manual", {
70	        title: "Deregister a UTCP Manual",
71	        description: "Deregisters a tool provider from the UTCP client.",
72	        inputSchema: { manual_name: z.string().describe("The name of the manual to deregister.") },
73	    }, async (input) => {
74	        const client = await initializeUtcpClient();
75	        try {
76	            const success = await client.deregisterManual(input.manual_name);
77	            const message = success ? `Manual '${input.manual_name}' deregistered.` : `Manual '${input.manual_name}' not found.`;
78	            return { content: [{ type: "text", text: JSON.stringify({ success, message }) }] };
79	        } catch (e: any) {
80	            return { content: [{ type: "text", text: JSON.stringify({ success: false, error: e.message }) }] };
81	        }
82	    });
83	
84	    mcp.registerTool("call_tool", {
85	        title: "Call a UTCP Tool",
86	        description: "Calls a registered tool by its full namespaced name.",
87	        inputSchema: {
88	            tool_name: z.string().describe("The full name of the tool to call."),
89	            arguments: z.record(z.string(), z.any()).describe("A JSON object of arguments."),
90	        },
91	    }, async (input) => {
92	        const client = await initializeUtcpClient();
93	        try {
94	            const result = await client.callTool(input.tool_name, input.arguments);
95	
96	            // Pass MCP content blocks (image, resource, etc.) through to the
97	            // client natively instead of JSON-stringifying them, which would
98	            // turn binary payloads into raw base64 text and bloat the
99	            // conversation. Mirrors @utcp/code-mode-mcp's call_tool_chain.
100	            const content: Array<ContentBlock> = [];
101	            const nonMcp: Array<any> = [];
102	
103	            if (Array.isArray(result)) {
104	                for (const item of result) {
105	                    if (ContentBlockSchema.safeParse(item).success) {
106	                        content.push(item as ContentBlock);
107	                    } else {
108	                        nonMcp.push(item);
109	                    }
110	                }
111	            } else if (ContentBlockSchema.safeParse(result).success) {
112	                content.push(result as ContentBlock);
113	            } else {
114	                nonMcp.push(result);
115	            }
116	
117	            const plain = nonMcp.length > 1 ? nonMcp : nonMcp[0];
118	            content.push({
119	                type: "text",
120	                text: JSON.stringify({ success: true, tool_name: input.tool_name, result: plain }),
121	            });
122	
123	            return { content };
124	        } catch (e: any) {
125	            return { content: [{ type: "text", text: JSON.stringify({ success: false, error: e.message }) }] };
126	        }
127	    });
128	
129	    mcp.registerTool("search_tools", {
130	        title: "Search for UTCP Tools",
131	        description: "Searches for relevant tools based on a task description.",
132	        inputSchema: {
133	            task_description: z.string().describe("A natural language description of the task."),
134	            limit: z.number().optional().default(10),
135	        },
136	    }, async (input) => {
137	        const client = await initializeUtcpClient();
138	        try {
139	            const tools = await client.searchTools(input.task_description, input.limit);
140	            const simplified = tools.map(t => ({ name: t.name, description: t.description, input_schema: t.inputs }));
141	            return { content: [{ type: "text", text: JSON.stringify({ tools: simplified }) }] };
142	        } catch (e: any) {
143	            return { content: [{ type: "text", text: JSON.stringify({ success: false, error: e.message }) }] };
144	        }
145	    });
146	
147	    mcp.registerTool("list_tools", {
148	        title: "List All Registered UTCP Tools",
149	        description: "Returns a list of all tool names currently registered.",
150	        inputSchema: {},
151	    }, async () => {
152	        const client = await initializeUtcpClient();
153	        try {
154	            const tools = await client.config.tool_repository.getTools();
155	            const toolNames = tools.map(t => t.name);
156	            return { content: [{ type: "text", text: JSON.stringify({ tools: toolNames }) }] };
157	        } catch (e: any) {
158	            return { content: [{ type: "text", text: JSON.stringify({ success: false, error: e.message }) }] };
159	        }
160	    });
161	
162	    mcp.registerTool("get_required_keys_for_tool", {
163	        title: "Get Required Variables for Tool",
164	        description: "Get required environment variables for a registered tool.",
165	        inputSchema: {
166	            tool_name: z.string().describe("Name of the tool to get required variables for."),
167	        },
168	    }, async (input) => {
169	        const client = await initializeUtcpClient();
170	        try {
171	            const variables = await client.getRequiredVariablesForRegisteredTool(input.tool_name);
172	            return { content: [{ type: "text", text: JSON.stringify({ success: true, tool_name: input.tool_name, required_variables: variables }) }] };
173	        } catch (e: any) {
174	            return { content: [{ type: "text", text: JSON.stringify({ success: false, tool_name: input.tool_name, error: e.message }) }] };
175	        }
176	    });
177	
178	    mcp.registerTool("tool_info", {
179	        title: "Get Tool Information",
180	        description: "Get complete information about a specific tool including all details.",
181	        inputSchema: {
182	            tool_name: z.string().describe("Name of the tool to get complete information for."),
183	        },
184	    }, async (input) => {
185	        const client = await initializeUtcpClient();
186	        try {
187	            const tool = await client.config.tool_repository.getTool(input.tool_name);
188	            if (!tool) {
189	                return { content: [{ type: "text", text: JSON.stringify({ success: false, error: `Tool '${input.tool_name}' not found` }) }] };
190	            }
191	            return { content: [{ type: "text", text: JSON.stringify({ success: true, tool: tool }) }] };
192	        } catch (e: any) {
193	            return { content: [{ type: "text", text: JSON.stringify({ success: false, error: e.message }) }] };
194	        }
195	    });
196	}
197	
198	async function initializeUtcpClient(): Promise<UtcpClient> {
199	    if (utcpClient) {
200	        return utcpClient as UtcpClient;
201	    }
202	
203	    // Look for config file: 1) Environment variable, 2) Current working directory, 3) Package directory
204	    const cwd = process.cwd();
205	    const packageDir = __dirname;
206	    
207	    let configPath: string;
208	    let scriptDir: string;
209	    
210	    // Check if UTCP_CONFIG_FILE environment variable is set
211	    if (process.env.UTCP_CONFIG_FILE) {
212	        configPath = path.resolve(process.env.UTCP_CONFIG_FILE);
213	        scriptDir = path.dirname(configPath);
214	        
215	        try {
216	            await fs.access(configPath);
217	        } catch {
218	            console.warn(`UTCP config file specified in UTCP_CONFIG_FILE not found: ${configPath}`);
219	        }
220	    } else {
221	        // Fall back to current working directory first, then package directory
222	        configPath = path.resolve(cwd, '.utcp_config.json');
223	        scriptDir = cwd;
224	        
225	        try {
226	            await fs.access(configPath);
227	        } catch {
228	            configPath = path.resolve(packageDir, '.utcp_config.json');
229	            scriptDir = packageDir;
230	        }
231	    }
232	
233	    let rawConfig: any = {};
234	    try {
235	        const configFileContent = await fs.readFile(configPath, 'utf-8');
236	        rawConfig = JSON.parse(configFileContent);
237	    } catch (e: any) {
238	        if (e.code !== 'ENOENT') {
239	            console.warn(`Could not read or parse .utcp_config.json. Error: ${e.message}`);
240	        }
241	    }
242	
243	    const clientConfig = new UtcpClientConfigSerializer().validateDict(rawConfig);
244	
245	    const newClient = await UtcpClient.create(scriptDir, clientConfig);
246	
247	    utcpClient = newClient;
248	    return utcpClient as UtcpClient;
249	}
250	
251	main().catch(err => {
252	    console.error("Failed to start UTCP-MCP Bridge:", err);
253	    process.exit(1);
254	});
255	

