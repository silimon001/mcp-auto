193	    def citation_keys(self, item_keys: list[str]) -> dict[str, str]:
194	        """
195	        Fetch citation keys for given item keys using Better BibTeX JSON-RPC API.
196	        
197	        Args:
198	            item_keys: A list of [libraryID]:[itemKey] strings. 
199	                       If [libraryID] is omitted, assume 'My Library'
200	        
201	        Returns:
202	            dict[string, string] mapping item keys to citation keys
203	        """
204	        if not self.BBT:
205	            raise Exception("Better BibTeX is not available")
206	            
207	        if not self._check_bbt_library_ready():
208	            raise Exception("Better BibTeX library is not ready. Needs some time after starting Zotero.")
209	            
210	        if not item_keys:
211	            return {}
212	            
213	        try:
214	            payload = {
215	                "jsonrpc": "2.0",
216	                "method": "item.citationkey",
217	                "params": [item_keys],
218	                "id": 1
219	            }
220	            
221	            response = httpx.post(
222	                "http://localhost:23119/better-bibtex/json-rpc",
223	                json=payload,
224	                headers={
225	                    "Content-Type": "application/json",
226	                    "Accept": "application/json"
227	                },
228	                timeout=5.0
229	            )
230	            
231	            if response.status_code == 200:
232	                result = response.json()
233	                if "result" in result:
234	                    return result["result"]
235	                elif "error" in result:
236	                    raise Exception(f"Better BibTeX error: {result['error']}")
237	                else:
238	                    raise Exception("Invalid response from Better BibTeX")
239	            else:
240	                raise Exception(f"HTTP error {response.status_code}")
241	                
242	        except (httpx.RequestError, httpx.TimeoutException, json.JSONDecodeError) as e:
243	            raise Exception(f"Failed to fetch citation keys: {str(e)}")
