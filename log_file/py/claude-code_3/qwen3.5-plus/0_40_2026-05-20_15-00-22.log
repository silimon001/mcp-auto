1	#!/usr/bin/env python3
2	"""
3	MCP FastMCP Server for Automatic Favicon Generation
4	
5	This server provides tools to generate favicons from PNG images or URLs.
6	It creates a complete favicon set including various sizes and a manifest.json file.
7	"""
8	
9	import asyncio
10	import json
11	import os
12	import tempfile
13	from pathlib import Path
14	from typing import Any, Dict, List, Optional
15	from urllib.parse import urlparse
16	
17	import aiohttp
18	from PIL import Image
19	from mcp.server.fastmcp import FastMCP
20	
21	mcp = FastMCP(name="favicon-generator")
22	
23	FAVICON_SIZES = [16, 32, 48, 64, 128, 256]
24	ICO_SIZES = [16, 32, 48]
25	APPLE_SIZES = [180, 152, 144, 120, 114, 76, 72, 60, 57]
26	
27	
28	def validate_absolute_path(path: str, path_type: str) -> Path:
29	    """Validate that a path is absolute and exists (for files) or can be created (for directories)."""
30	    path_obj = Path(path)
31	    
32	    if not path_obj.is_absolute():
33	        raise ValueError(f"{path_type} must be an absolute path: {path}")
34	    
35	    return path_obj
36	
37	
38	def create_favicon_set(image_data: bytes, output_dir: str) -> Dict[str, Any]:
39	    """Create a complete favicon set from image data."""
40	    # Write image data to a temp file
41	    with tempfile.NamedTemporaryFile(delete=False, suffix='.png') as temp_file:
42	        temp_file.write(image_data)
43	        temp_file.flush()
44	        temp_path = temp_file.name
45	
46	    try:
47	        with Image.open(temp_path) as img:
48	            # Convert to RGBA if needed
49	            if img.mode != 'RGBA':
50	                img = img.convert('RGBA')
51	
52	            output_path = Path(output_dir)
53	            output_path.mkdir(parents=True, exist_ok=True)
54	            generated_files = []
55	
56	            # Generate PNG favicons
57	            for size in FAVICON_SIZES:
58	                resized = img.resize((size, size), Image.Resampling.LANCZOS)
59	                filename = f"favicon-{size}x{size}.png"
60	                filepath = output_path / filename
61	                resized.save(filepath, "PNG")
62	                generated_files.append(str(filepath))
63	
64	            # Generate ICO file
65	            ico_images = [img.resize((size, size), Image.Resampling.LANCZOS) for size in ICO_SIZES]
66	            ico_path = output_path / "favicon.ico"
67	            ico_images[0].save(ico_path, format='ICO', sizes=[(size, size) for size in ICO_SIZES])
68	            generated_files.append(str(ico_path))
69	
70	            # Generate Apple touch icons
71	            for size in APPLE_SIZES:
72	                resized = img.resize((size, size), Image.Resampling.LANCZOS)
73	                filename = f"apple-touch-icon-{size}x{size}.png"
74	                filepath = output_path / filename
75	                resized.save(filepath, "PNG")
76	                generated_files.append(str(filepath))
77	
78	            # Generate manifest.json
79	            manifest = {
80	                "name": "Favicon App",
81	                "short_name": "Favicon",
82	                "description": "Generated favicon application",
83	                "start_url": "/",
84	                "display": "standalone",
85	                "background_color": "#ffffff",
86	                "theme_color": "#000000",
87	                "icons": [
88	                    {
89	                        "src": f"favicon-{size}x{size}.png",
90	                        "sizes": f"{size}x{size}",
91	                        "type": "image/png"
92	                    } for size in FAVICON_SIZES
93	                ]
94	            }
95	            manifest_path = output_path / "manifest.json"
96	            with open(manifest_path, 'w') as f:
97	                json.dump(manifest, f, indent=2)
98	            generated_files.append(str(manifest_path))
99	
100	            return {
101	                "generated_files": generated_files,
102	                "manifest": manifest,
103	                "output_directory": str(output_path)
104	            }
105	    finally:
106	        os.unlink(temp_path)
107	
108	
109	@mcp.tool()
110	async def generate_favicon_from_png(image_path: str, output_path: str) -> str:
111	    """
112	    Generate a complete favicon set from a PNG image file.
113	
114	    Args:
115	        image_path: Absolute path to the PNG image file.
116	        output_path: Absolute path to the directory where favicon files will be generated.
117	    Returns:
118	        A message describing the generated files and output directory.
119	    """
120	    try:
121	        # Validate absolute paths
122	        image_path_obj = validate_absolute_path(image_path, "image_path")
123	        output_path_obj = validate_absolute_path(output_path, "output_path")
124	        
125	        # Check if image file exists
126	        if not image_path_obj.exists():
127	            return f"Error: Image file does not exist: {image_path}"
128	        
129	        if not image_path_obj.is_file():
130	            return f"Error: Path is not a file: {image_path}"
131	        
132	        # Check if output directory can be created
133	        try:
134	            output_path_obj.mkdir(parents=True, exist_ok=True)
135	        except Exception as e:
136	            return f"Error: Cannot create output directory {output_path}: {str(e)}"
137	        
138	        with open(image_path_obj, 'rb') as f:
139	            image_data = f.read()
140	        result = create_favicon_set(image_data, str(output_path_obj))
141	        return (
142	            f"Successfully generated favicon set!\n\n"
143	            f"Output directory: {result['output_directory']}\n"
144	            f"Generated files:\n" + "\n".join(f"- {f}" for f in result['generated_files'])
145	        )
146	    except ValueError as e:
147	        return f"Error: {str(e)}"
148	    except Exception as e:
149	        return f"Error generating favicon: {str(e)}"
150	
151	
152	@mcp.tool()
153	async def generate_favicon_from_url(image_url: str, output_path: str) -> str:
154	    """
155	    Download an image from a URL and generate a complete favicon set.
156	
157	    Args:
158	        image_url: URL of the image to download.
159	        output_path: Absolute path to the directory where favicon files will be generated.
160	    Returns:
161	        A message describing the generated files and output directory.
162	    """
163	    try:
164	        # Validate absolute path for output directory
165	        output_path_obj = validate_absolute_path(output_path, "output_path")
166	        
167	        # Check if output directory can be created
168	        try:
169	            output_path_obj.mkdir(parents=True, exist_ok=True)
170	        except Exception as e:
171	            return f"Error: Cannot create output directory {output_path}: {str(e)}"
172	        
173	        async with aiohttp.ClientSession() as session:
174	            async with session.get(image_url) as response:
175	                response.raise_for_status()
176	                image_data = await response.read()
177	        result = create_favicon_set(image_data, str(output_path_obj))
178	        return (
179	            f"Successfully downloaded image from {image_url} and generated favicon set!\n\n"
180	            f"Output directory: {result['output_directory']}\n"
181	            f"Generated files:\n" + "\n".join(f"- {f}" for f in result['generated_files'])
182	        )
183	    except ValueError as e:
184	        return f"Error: {str(e)}"
185	    except Exception as e:
186	        return f"Error generating favicon from URL: {str(e)}"
187	
188	
189	def main():
190	    """MCP Auto Favicon Server - Automatic favicon generation functionality for MCP"""
191	    import argparse
192	
193	    parser = argparse.ArgumentParser(
194	        description="Generate favicons from PNG images or URLs"
195	    )
196	    parser.add_argument(
197	        "--output-dir", 
198	        type=str, 
199	        default="./favicons",
200	        help="Default output directory for generated favicons"
201	    )
202	
203	    args = parser.parse_args()
204	    
205	    # Initialize and run the server
206	    mcp.run(transport='stdio')
207	
208	
209	if __name__ == "__main__":
210	    main() 

