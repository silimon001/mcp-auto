1	from typing import Any
2	import httpx
3	from mcp.server.fastmcp import FastMCP
4	import asyncpraw
5	import os
6	from dotenv import load_dotenv
7	
8	load_dotenv()
9	
10	mcp = FastMCP("reddit-summary")
11	
12	async def get_reddit():
13	    try:
14	        username = os.getenv("USERNAME")
15	        password = os.getenv("PASSSWORD")
16	        client_id = os.getenv("CLIENT_ID")
17	        client_secret = os.getenv("CLIENT_SECRET")
18	        user_agent= os.getenv("USER_AGENT")
19	        reddit = asyncpraw.Reddit(username=username,password=password,client_id = client_id,client_secret=client_secret,user_agent=user_agent)
20	        return reddit
21	    except Exception as e:
22	        print(e)
23	        return None
24	
25	@mcp.tool()
26	async def reed_comments(id=None,url=None,limit=15):
27	    """
28	        Reads and summarizes the top level comments that a submission have.
29	        Args:
30	            post id: str or url: str
31	        Output:
32	            List with the comments.
33	    """
34	    if id is None and url is None: return "Invalid argumnts."
35	    reddit = await get_reddit()
36	    if reddit is None: return "Cannot access the reddit client."
37	    submission = None
38	    if id is not None: submission = await reddit.submission(id=id)
39	    if url is not None: submission = await reddit.submission(url=url)
40	    res = []
41	    cnt = 0
42	    async for comment in submission.comments:
43	        if isinstance(comment,asyncpraw.models.MoreComments): continue
44	        if cnt > limit: break
45	        cnt += 1
46	        res.append(comment.body)
47	    await reddit.close()
48	    return res
49	
50	@mcp.tool()
51	async def summarize_frontpage(limit:int = 10, with_comments:bool = False) -> dict:
52	    """
53	    Summarizes the user's reddit frontpage (alias: homepage, feed) by giving information dictinory to LLM.
54	    Optionaly this function can use comments for deeper summaries.
55	    Args:
56	        limit: integer (Optional) [default = 10]: sets a limit for how many post to fetch.
57	        with_comments: bool (Optional) [default = false]: indicates that summary will be done with comments.
58	    Output:
59	        Dictinory with keys as post id's and values as post informations
60	    """
61	    res = {}
62	    reddit = await get_reddit()
63	    if reddit is None: return "Cannot access the reddit client."
64	    async for submission in reddit.front.best(limit=limit):
65	        res[submission.id] = {
66	            "title": submission.title,
67	            "subreddit": submission.subreddit.display_name,
68	            "is-only-text":submission.is_self,
69	            "url": "www.reddit.com"+submission.permalink,
70	            "comments": await reed_comments(id=submission.id) if with_comments else []
71	        }
72	    await reddit.close()
73	    return res
74	
75	@mcp.tool()
76	async def summarize_subreddit(subreddit_name:str ,fetch_by: str = "hot",limit: int = 10, with_comments:bool = False):
77	    """
78	    Summarizes the subreddit's frontpage (alias: homepage, feed) by giving information dictinory to LLM.
79	    Sorting, fetchings options are hot, new, top, rising, random.
80	    Optionaly this function can use comments for deeper summaries.
81	    Args:
82	        subreddit_name: str : name for subrredit without 'r/'
83	        fetch_by: str (Optional) [default = ''hot]: sorting, fetching option for subreddit's feed
84	        limit: integer (Optional) [default = 10]: sets a limit for how many post to fetch.
85	        with_comments: bool (Optional) [default = false]: indicates that summary will be done with comments.
86	    Output:
87	        Dictinory with keys as post id's and values as post informations
88	    """
89	    reddit = await get_reddit()
90	    if reddit is None: return "Cannot access the reddit client."
91	    subreddit = None
92	    try:
93	        subreddit = await reddit.subreddit(subreddit_name)
94	    except:
95	        return "Invalid subreddit name."
96	    generator = None
97	    match fetch_by.lower():
98	        case "hot":
99	            generator = subreddit.hot(limit=limit)
100	        case "new":
101	            generator = subreddit.new(limit=limit)
102	        case "top":
103	            generator = subreddit.top(limit=limit)
104	        case "rising":
105	            generator = subreddit.rising(limit=limit)
106	        case "random":
107	            generator = [None]*limit
108	            try:
109	                for i in range(limit): generator[i] = await subreddit.random()
110	            except:
111	                await reddit.close()
112	                return "This subreddit does not support random feature."
113	        case _:
114	            return "Invalid option for fetching. Only valid options are hot, new, top, rising, random."
115	    
116	    res = {}
117	    async for submission in generator:
118	        res[submission.id] = {
119	            "title": submission.title,
120	            "subreddit": submission.subreddit.display_name,
121	            "is-only-text":submission.is_self,
122	            "url": "www.reddit.com"+submission.permalink,
123	            "comments": await reed_comments(id=submission.id) if with_comments else []
124	        }
125	    await reddit.close()
126	    return res
127	
128	@mcp.prompt()
129	def summarize_my_page():
130	    """Fixed prompt for detailed summary"""
131	    return """Make a summary of the reddit front page via summarize_frontpage function with limit=15 and with_comments=True arguments
132	    Use comments to get deeper understanding of public opinion about posts.
133	    Categorise these post into meaningful categories (e.g. politics/eceonomics, humour and meme, cultural/social etc.)
134	    
135	    For each category display context with following format:
136	    **Number**-**Category Name**:
137	    - **summary of post with comment analysis** from **Subreddit name**
138	    use this format for each post
139	    """
140	
141	if __name__ == "__main__":
142	    mcp.run(transport='stdio')
143	    
