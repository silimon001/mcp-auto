181	def check_rate_limit() -> bool:
182	    """Check if we're exceeding the rate limit."""
183	    global last_scan_times
184	    current_time = time.time()
185	    
186	    # Remove timestamps older than the rate limit period
187	    last_scan_times = [t for t in last_scan_times if current_time - t < RATE_LIMIT_PERIOD]
188	    
189	    # Check if we're under the limit
190	    return len(last_scan_times) < RATE_LIMIT_MAX_SCANS
