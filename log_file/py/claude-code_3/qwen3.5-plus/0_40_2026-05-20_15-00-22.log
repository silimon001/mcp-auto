1	from typing import Any
2	import httpx
3	from bs4 import BeautifulSoup
4	from urllib.parse import urljoin
5	from mcp.server.fastmcp import FastMCP
6	
7	# Initialize the MCP server.
8	mcp = FastMCP("hackage_docs")
9	
10	@mcp.tool()
11	async def get_docs(package: str, version: str, module: str) -> str:
12	    """
13	    Retrieve the documentation for a specific module of a Haskell package from Hackage.
14	    
15	    Args:
16	        package: The full Hackage package name (e.g. "yesod-persistent").
17	        version: The package version (e.g. "2.10.0").
18	        module: The module name to look up (e.g. "Database.Persist" or "Control.Lens").
19	    
20	    Returns:
21	        The extracted documentation text for the specified module, or an error message.
22	    
23	    Example calls:
24	      - get_docs("lens", "5.0.0", "Control.Lens")
25	      - get_docs("vector-algorithms", "0.8.0", "Data.Vector.Algorithms")
26	    """
27	    # Construct the URL for the package's documentation index.
28	    base_url = f"https://hackage.haskell.org/package/{package}-{version}"
29	    
30	    # Fetch the overall package page.
31	    async with httpx.AsyncClient() as client:
32	        try:
33	            response = await client.get(base_url, timeout=30.0)
34	            response.raise_for_status()
35	        except Exception as e:
36	            return f"Error fetching package page from {base_url}: {str(e)}"
37	    
38	    # Parse the overall package page.
39	    soup = BeautifulSoup(response.text, "html.parser")
40	    
41	    # Look for an <a> tag whose text exactly matches the module name.
42	    module_link_tag = soup.find("a", string=lambda s: s and s.strip() == module)
43	    if not module_link_tag:
44	        return f"Module '{module}' not found on the package page."
45	    
46	    # Extract the href attribute and convert it to an absolute URL.
47	    module_href = module_link_tag.get("href")
48	    module_url = urljoin(base_url, module_href)
49	    
50	    # Fetch the module's documentation page.
51	    async with httpx.AsyncClient() as client:
52	        try:
53	            mod_response = await client.get(module_url, timeout=30.0)
54	            mod_response.raise_for_status()
55	        except Exception as e:
56	            return f"Error fetching module page from {module_url}: {str(e)}"
57	    
58	    # Parse and clean the module page HTML.
59	    mod_soup = BeautifulSoup(mod_response.text, "html.parser")
60	    for tag in mod_soup(["script", "style"]):
61	        tag.decompose()
62	    
63	    text = mod_soup.get_text(separator="\n")
64	    lines = [line.strip() for line in text.splitlines()]
65	    cleaned_text = "\n".join(line for line in lines if line)
66	    
67	    return cleaned_text
68	
69	if __name__ == "__main__":
70	    # Run the MCP server using the stdio transport.
71	    mcp.run(transport="stdio")
72	

