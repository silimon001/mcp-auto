1	import time
2	from mcp.server.fastmcp import FastMCP, Context
3	from notebook import Notebook
4	from dotenv import load_dotenv
5	import os
6	from pathlib import Path
7	
8	parent_folder  = Path(__file__).resolve().parent
9	env_path =  parent_folder / '.env'
10	
11	load_dotenv(dotenv_path=env_path)
12	notebooks_folder_name = os.getenv('NOTEBOOKS_FOLDER')
13	notebooks_folder = parent_folder / notebooks_folder_name
14	
15	notebooks_folder.mkdir(exist_ok=True)
16	
17	mcp = FastMCP(name = 'Code Interpreter", "2.0.0", "A simple code interpreter that executes Python code and returns the result.',
18	              instructions= """
19	                You can execute Python code by sending a request with the code you want to run.
20	                Think of this tool as a jupyter notebook. It will remember your previously executed code, if you pass in your session_id. 
21	                It is crucial to remember your session_id for a smooth interaction.
22	                ```
23	                )""")
24	sessions = {}
25	
26	@mcp.tool('execute_code', description='''Executes Python code within a persistent session, retaining past results (e.g., variables, imports). Similar to a Jupyter notebook. A session_id is returned on first use and must be included in subsequent requests to maintain context.''' )
27	
28	async def execute_code(code: str, session_id: int = 0) -> dict:
29	    global sessions
30	    """
31	    Executes the provided Python code and returns the result.
32	    
33	    Args:
34	        code (str): The Python code to execute.
35	        session_id (int, optional): A unique identifier used to associate multiple code execution requests
36	            with the same logical session. If this is the first request, you may omit it or set it to 0.
37	            The system will generate and return a new session_id, which should be reused in follow-up requests
38	            to maintain continuity within the same session.
39	    
40	    Returns:
41	        dict: A dictionary containing the result or an error message.
42	    """
43	    session_info = None
44	
45	    if session_id==0 or not os.path.exists(os.path.join(notebooks_folder, f'{session_id}.txt')):
46	        session_id = int(time.time())
47	        sessions[session_id] =  Notebook(session_id)
48	        session_info = f"Your session_id for this chat is {session_id}. You should provide it for subsequent requests."
49	    elif not sessions.get(session_id):
50	        notebook = Notebook(session_id)
51	        notebook.load_from_file()
52	        sessions[session_id] = notebook
53	
54	    try:
55	        notebook = sessions[session_id]
56	        result = notebook.execute_new_code(code)
57	        if session_info:
58	            result['result'].append(session_info)
59	        if len(result['error'])==0:
60	            notebook.dump_to_file()
61	        return result 
62	    except Exception as e:
63	        return {'error':[str(e)], 'result':[] }
64	
65	
66	
67	if __name__ == '__main__':
68	    mcp.run()

