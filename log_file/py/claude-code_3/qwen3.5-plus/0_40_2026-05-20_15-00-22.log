1	#!/usr/bin/env python3
2	"""
3	MCP Server for PineScript syntax checking
4	"""
5	
6	import asyncio
7	from typing import Any, Optional, Dict, Union
8	import httpx
9	from mcp.server.fastmcp import FastMCP
10	from .pinescript_checker import PineScriptChecker
11	
12	app = FastMCP('pinescript-syntax-checker')
13	
14	@app.tool()
15	async def check_syntax(pine_code: str) -> Optional[Dict[str, Any]]:
16	    """
17	    Check PineScript syntax using TradingView's API
18	
19	    Args:
20	        pine_code: PineScript code to check
21	
22	    Returns:
23	        result: Dictionary containing syntax check results
24	    """
25	    checker = PineScriptChecker()
26	
27	    try:
28	        result = await checker.check_syntax(pine_code)
29	        return result
30	    except Exception as e:
31	        return {
32	            'success': False,
33	            'error': f'Check failed: {str(e)}',
34	            'errors': []
35	        }
36	
37	def main():
38	    """Entry point for the MCP server."""
39	    app.run()
40	
41	if __name__ == "__main__":
42	    main() 

