1	from jupyter_client import KernelManager
2	from jupyter_client.blocking.client import BlockingKernelClient
3	from dotenv import load_dotenv
4	import os
5	from pathlib import Path
6	
7	
8	parent_folder  = Path(__file__).resolve().parent
9	env_path =  parent_folder / '.env'
10	
11	load_dotenv(dotenv_path=env_path)
12	notebooks_folder_name = os.getenv('NOTEBOOKS_FOLDER')
13	notebooks_folder = parent_folder / notebooks_folder_name
14	
15	class Notebook:
16	    def __init__(self,session_id):
17	        self.kernel =  KernelManager()
18	        self.kernel.start_kernel()
19	        self.session_id = session_id
20	        self.client = BlockingKernelClient(connection_file=self.kernel.connection_file)
21	        self.client.load_connection_file()
22	        self.client.start_channels()
23	        self.client.wait_for_ready(timeout=5) 
24	
25	        self.file_path = os.path.join(notebooks_folder, f'{self.session_id}.txt')
26	
27	        self.history = []
28	    
29	    def execute_new_code(self,code):
30	        
31	        result = []
32	        error = []
33	        def output_callback(msg):
34	            if msg['msg_type'] == 'stream':
35	                result.append(msg['content']['text'])
36	            elif msg['msg_type'] == 'execute_result':
37	                result.append(f"Execution Result: {msg['content']['data']['text/plain']}")
38	            elif msg['msg_type'] == 'error':
39	                error.append(f"Error: {msg['content']['ename']}: {msg['content']['evalue']}")
40	        
41	        
42	        self.client.execute_interactive(
43	            code=code,
44	            output_hook=output_callback,
45	            stop_on_error=True  # Optional: stop if an error occurs
46	        )       
47	        if len(error)==0:
48	            self.history.append('\n'+code)
49	        return {"error": error, "result":result}
50	    
51	    def dump_to_file(self):
52	        with open(self.file_path,'w') as f:
53	            for code in self.history:
54	                f.write(code+'\n')
55	
56	    def load_from_file(self):
57	        try:
58	            with open(self.file_path) as f:
59	                code = f.read()
60	                self.execute_new_code(code)
61	                return True
62	        except:
63	            return False
64	
65	    # TODO abstract out creating a new client
66	    def close(self):
67	        self.kernel.shutdown_kernel()
