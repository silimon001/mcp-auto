1	#!/usr/bin/env python3
2	"""
3	Standalone script to run the PineScript Syntax Checker MCP Server
4	This script automatically detects the environment and runs the server appropriately.
5	"""
6	
7	import sys
8	import os
9	import importlib.util
10	
11	def find_package():
12	    """Find the pinescript_syntax_checker package."""
13	    # First, try to import as installed package
14	    try:
15	        import pinescript_syntax_checker
16	        return pinescript_syntax_checker
17	    except ImportError:
18	        pass
19	    
20	    # If not installed, try to find in current directory
21	    current_dir = os.path.dirname(os.path.abspath(__file__))
22	    package_dir = os.path.join(current_dir, "pinescript_syntax_checker")
23	    
24	    if os.path.exists(package_dir):
25	        # Add current directory to path for development
26	        sys.path.insert(0, current_dir)
27	        try:
28	            import pinescript_syntax_checker
29	            return pinescript_syntax_checker
30	        except ImportError:
31	            pass
32	    
33	    raise ImportError("Could not find pinescript_syntax_checker package")
34	
35	def main():
36	    """Main entry point."""
37	    try:
38	        # Find and import the package
39	        package = find_package()
40	        from pinescript_syntax_checker.server import main as server_main
41	        
42	        # Run the server
43	        server_main()
44	    except ImportError as e:
45	        print(f"Error: {e}")
46	        print("Please ensure the package is installed or in the current directory.")
47	        sys.exit(1)
48	    except Exception as e:
49	        print(f"Error running server: {e}")
50	        sys.exit(1)
51	
52	# Make app available globally for MCP
53	try:
54	    package = find_package()
55	    from pinescript_syntax_checker.server import app
56	except ImportError:
57	    # If package not found, create a dummy app for MCP detection
58	    from mcp.server.fastmcp import FastMCP
59	    app = FastMCP('pinescript-syntax-checker')
60	
61	if __name__ == "__main__":
62	    main() 

