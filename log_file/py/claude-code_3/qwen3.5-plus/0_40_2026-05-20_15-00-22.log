225	@mcp.tool()
226	def execute_hedge_arbitrage_strategy(symbol: str, quantity: str) -> Any:
227	    """
228	    Execute hedge arbitrage based on funding rate.
229	
230	    Args:
231	        symbol: The trading pair.
232	        quantity: Amount to trade.
233	
234	    Returns:
235	        Summary of the arbitrage result.
236	    """
237	    asset = symbol.replace("USDT", "")
238	    balance_result = mcp.use_tool("get_account_balance", asset)
239	    try:
240	        available_balance = float(balance_result.get("balance", 0))
241	    except:
242	        available_balance = 0
243	
244	    actual_quantity = min(float(quantity), available_balance) if available_balance > 0 else 0
245	    if actual_quantity <= 0:
246	        return {"error": f"Insufficient {asset} balance."}
247	
248	    funding_rate_data = mcp.use_tool("get_funding_rate_history", symbol)
249	    funding_rate = float(funding_rate_data[0]['fundingRate'])
250	    spot_price_data = mcp.use_tool("get_symbol_price", symbol)
251	    spot_price = float(spot_price_data["price"])
252	
253	    if funding_rate > 0:
254	        mcp.use_tool("place_market_order", symbol, "BUY", actual_quantity)
255	        place_futures_order(symbol, "SELL", actual_quantity)
256	    else:
257	        mcp.use_tool("place_market_order", symbol, "SELL", actual_quantity)
258	        place_futures_order(symbol, "BUY", actual_quantity)
259	
260	    time.sleep(10)
261	
262	    if funding_rate > 0:
263	        place_futures_order(symbol, "BUY", actual_quantity)
264	        mcp.use_tool("place_market_order", symbol, "SELL", actual_quantity)
265	    else:
266	        place_futures_order(symbol, "SELL", actual_quantity)
267	        mcp.use_tool("place_market_order", symbol, "BUY", actual_quantity)
268	
269	    SPOT_FEE = 0.001
270	    FUTURES_FEE = 0.0002
271	    fee = (spot_price * actual_quantity * SPOT_FEE * 2) + (spot_price * actual_quantity * FUTURES_FEE * 2)
272	    profit = abs(funding_rate) * spot_price * actual_quantity
273	    net_profit = profit - fee
274	
275	    return {
276	        "net_profit": round(net_profit, 4),
277	        "fees": round(fee, 4),
278	        "message": f"Arbitrage executed. Estimated net profit: {net_profit:.4f} USDT"
279	    }
