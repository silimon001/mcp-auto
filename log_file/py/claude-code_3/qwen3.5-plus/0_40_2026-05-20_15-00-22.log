158	        def simple_html_to_md(html):
159	            """Convert simple HTML formatting to Markdown
160	            
161	            Could be replaced with more advanced code in the future.
162	            """
163	            # Handle headings
164	            for i in range(6, 0, -1):
165	                html = html.replace(f"<h{i}>", f"{'#' * i} ").replace(f"</h{i}>", "\n\n")
166	            
167	            # Handle basic formatting
168	            html = html.replace("<strong>", "**").replace("</strong>", "**")
169	            html = html.replace("<b>", "**").replace("</b>", "**")
170	            html = html.replace("<em>", "*").replace("</em>", "*")
171	            html = html.replace("<i>", "*").replace("</i>", "*")
172	            
173	            # Handle lists
174	            html = html.replace("<ul>", "\n").replace("</ul>", "\n")
175	            html = html.replace("<ol>", "\n").replace("</ol>", "\n")
176	            html = html.replace("<li>", "- ").replace("</li>", "\n")
177	            
178	            # Handle paragraphs and line breaks
179	            html = html.replace("<p>", "").replace("</p>", "\n\n")
180	            html = html.replace("<br>", "\n").replace("<br/>", "\n").replace("<br />", "\n")
181	            
182	            # Handle links
183	            html = re.sub(r'<a href="([^"]+)"[^>]*>(.*?)</a>', r'[\2](\1)', html)
184	            
185	            # Remove any remaining HTML tags
186	            html = re.sub(r'<[^>]*>', '', html)
187	            return html.strip()
188	
189	        formatted['note'] = simple_html_to_md(note_content)
190	        
191	        return formatted
