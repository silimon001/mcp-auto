1	#!/usr/bin/env python3
2	"""
3	Arrakis MCP Server - Model Context Protocol server for Arrakis VM sandboxes.
4	
5	This module implements an MCP server that exposes Arrakis VM sandbox functionality
6	to LLMs through the Model Context Protocol (MCP).
7	"""
8	
9	import os
10	import sys
11	import argparse
12	import json
13	import logging
14	
15	# Import MCP SDK
16	from mcp.server.fastmcp import FastMCP
17	
18	# Import py_arrakis functionality
19	from py_arrakis.sandbox import Sandbox
20	from py_arrakis.sandbox_manager import SandboxManager
21	
22	# Configure logging
23	logging.basicConfig(
24	    level=logging.INFO,
25	    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
26	    handlers=[logging.StreamHandler()],
27	)
28	logger = logging.getLogger("arrakis-mcp")
29	
30	# Initialize FastMCP server
31	mcp = FastMCP("arrakis")
32	
33	# Default Arrakis server URL
34	DEFAULT_ARRAKIS_URL = "http://localhost:7000"
35	# Will be set in main.
36	sandbox_manager = None
37	
38	@mcp.resource("arrakis://vms")
39	def get_vms() -> str:
40	    """List all available VMs."""
41	    try:
42	        vms = sandbox_manager.list_all()
43	        vm_info = [vm.info() for vm in vms]
44	        return json.dumps(vm_info, indent=2)
45	    except Exception as e:
46	        return f"Error listing VMs: {str(e)}"
47	
48	
49	@mcp.resource("arrakis://vm/{vm_name}")
50	def get_vm_info(vm_name: str) -> str:
51	    """Get information about a specific VM."""
52	    try:
53	        sandbox = Sandbox(sandbox_manager._api, vm_name)
54	        return json.dumps(sandbox.info(), indent=2)
55	    except Exception as e:
56	        return f"Error retrieving VM information: {str(e)}"
57	
58	# Define MCP tools
59	
60	
61	@mcp.tool()
62	def start_sandbox(name: str) -> str:
63	    """
64	    Start a new sandbox VM.
65	
66	    Args:
67	        name: Name to give to the new VM.
68	
69	    Returns:
70	        Information about the created VM.
71	    """
72	    try:
73	        sandbox = sandbox_manager.start_sandbox(name)
74	        return json.dumps(sandbox.info(), indent=2)
75	    except Exception as e:
76	        return f"Error starting sandbox: {str(e)}"
77	
78	
79	@mcp.tool()
80	def restore_snapshot(vm_name: str, snapshot_id: str) -> str:
81	    """
82	    Restore a VM from a snapshot.
83	
84	    Args:
85	        vm_name: Name to give to the restored VM.
86	        snapshot_id: ID of the snapshot to restore from.
87	
88	    Returns:
89	        Information about the restored VM.
90	    """
91	    try:
92	        sandbox = sandbox_manager.restore(vm_name, snapshot_id)
93	        return json.dumps(sandbox.info(), indent=2)
94	    except Exception as e:
95	        return f"Error restoring snapshot: {str(e)}"
96	
97	
98	@mcp.tool()
99	def snapshot(vm_name: str, snapshot_id: str = "") -> str:
100	    """
101	    Create a snapshot of a VM.
102	
103	    Args:
104	        vm_name: Name of the VM to snapshot.
105	        snapshot_id: Optional ID for the snapshot. If not provided, one will be generated.
106	
107	    Returns:
108	        ID of the created snapshot.
109	    """
110	    try:
111	        sandbox = Sandbox(sandbox_manager._api, vm_name)
112	        result = sandbox.snapshot(snapshot_id)
113	        return f"Created snapshot with ID: {result}"
114	    except Exception as e:
115	        return f"Error creating snapshot: {str(e)}"
116	
117	
118	@mcp.tool()
119	def run_command(vm_name: str, cmd: str) -> str:
120	    """
121	    Run a command in a VM.
122	
123	    Args:
124	        vm_name: Name of the VM to run the command in.
125	        cmd: Command to execute.
126	
127	    Returns:
128	        Command output and/or error.
129	    """
130	    try:
131	        sandbox = Sandbox(sandbox_manager._api, vm_name)
132	        result = sandbox.run_cmd(cmd)
133	        output = result.get("output", "")
134	        error = result.get("error", "")
135	
136	        if error:
137	            return f"Command output:\n{output}\n\nError:\n{error}"
138	        return f"Command output:\n{output}"
139	    except Exception as e:
140	        return f"Error running command: {str(e)}"
141	
142	
143	@mcp.tool()
144	def upload_file(vm_name: str, path: str, content: str) -> str:
145	    """
146	    Upload a file to a VM.
147	
148	    Args:
149	        vm_name: Name of the VM to upload to.
150	        path: Destination path in the VM.
151	        content: Content of the file.
152	
153	    Returns:
154	        Success/failure message.
155	    """
156	    try:
157	        sandbox = Sandbox(sandbox_manager._api, vm_name)
158	        sandbox.upload_files([{"path": path, "content": content}])
159	        return f"Successfully uploaded file to {path}"
160	    except Exception as e:
161	        return f"Error uploading file: {str(e)}"
162	
163	
164	@mcp.tool()
165	def download_file(vm_name: str, path: str) -> str:
166	    """
167	    Download a file from a VM.
168	
169	    Args:
170	        vm_name: Name of the VM to download from.
171	        path: Path of the file to download.
172	
173	    Returns:
174	        Content of the file or error message.
175	    """
176	    try:
177	        sandbox = Sandbox(sandbox_manager._api, vm_name)
178	        result = sandbox.download_files([path])
179	
180	        if not result:
181	            return f"No file found at path: {path}"
182	
183	        file_data = result[0]
184	        if "error" in file_data and file_data["error"]:
185	            return f"Error downloading file: {file_data['error']}"
186	
187	        return f"File content:\n{file_data.get('content', '')}"
188	    except Exception as e:
189	        return f"Error downloading file: {str(e)}"
190	
191	
192	@mcp.tool()
193	def destroy_vm(vm_name: str) -> str:
194	    """
195	    Destroy a VM.
196	
197	    Args:
198	        vm_name: Name of the VM to destroy.
199	
200	    Returns:
201	        Success/failure message.
202	    """
203	    try:
204	        sandbox = Sandbox(sandbox_manager._api, vm_name)
205	        sandbox.destroy()
206	        return f"Successfully destroyed VM {vm_name}"
207	    except Exception as e:
208	        return f"Error destroying VM: {str(e)}"
209	
210	
211	@mcp.tool()
212	def destroy_all_vms() -> str:
213	    """
214	    Destroy all VMs.
215	
216	    Returns:
217	        Success/failure message.
218	    """
219	    try:
220	        sandbox_manager.destroy_all()
221	        return "Successfully destroyed all VMs"
222	    except Exception as e:
223	        return f"Error destroying VMs: {str(e)}"
224	
225	
226	@mcp.tool()
227	def update_vm_state(vm_name: str, status: str) -> str:
228	    """
229	    Update the state of a VM.
230	
231	    Args:
232	        vm_name: Name of the VM to update.
233	        status: New state for the VM. Must be either 'stopped' or 'paused'.
234	
235	    Returns:
236	        Success/failure message.
237	    """
238	    try:
239	        sandbox = Sandbox(sandbox_manager._api, vm_name)
240	        sandbox.update_state(status)
241	        return f"Successfully updated VM {vm_name} state to {status}"
242	    except Exception as e:
243	        return f"Error updating VM state: {str(e)}"
244	
245	
246	if __name__ == "__main__":
247	    # Parse command line arguments
248	    parser = argparse.ArgumentParser(description="Arrakis MCP Server")
249	    parser.add_argument(
250	        "--arrakis-url",
251	        default=DEFAULT_ARRAKIS_URL,
252	        help=f"URL of the Arrakis server (default: {DEFAULT_ARRAKIS_URL})"
253	    )
254	    args = parser.parse_args()
255	    sandbox_manager = SandboxManager(args.arrakis_url)
256	    try:
257	        logger.info("Starting Arrakis MCP Server...")
258	        # Run the MCP server with stdio transport (default for Claude Desktop)
259	        mcp.run(transport="stdio")
260	    except KeyboardInterrupt:
261	        logger.info("Server shutting down...")
262	    except Exception as e:
263	        logger.error(f"Error running server: {e}")
264	        sys.exit(1)
265	

