1	"""Search index client for fast API lookups without browser automation.
2	
3	This module downloads and parses the rustdoc search index, enabling
4	sub-millisecond searches instead of multi-second browser automation.
5	"""
6	
7	import asyncio
8	import json
9	import logging
10	import re
11	from dataclasses import dataclass
12	
13	import httpx
14	
15	logger = logging.getLogger(__name__)
16	
17	
18	@dataclass(frozen=True)
19	class SearchIndexItem:
20	    """An item from the search index."""
21	
22	    type: str  # "struct", "fn", "enum", etc.
23	    path: str  # Full path like "windows::Win32::Storage::FileSystem"
24	    name: str  # Item name like "CreateFileA"
25	    full_path: str  # Complete path: path::name
26	
27	    @property
28	    def display_type(self) -> str:
29	        """Get display-friendly type name."""
30	        type_map = {
31	            "fn": "function",
32	            "struct": "struct",
33	            "enum": "enum",
34	            "type": "type",
35	            "trait": "trait",
36	            "mod": "module",
37	            "constant": "constant",
38	            "static": "static",
39	        }
40	        return type_map.get(self.type, self.type)
41	
42	
43	class SearchIndexClient:
44	    """Client for searching the rustdoc search index."""
45	
46	    def __init__(self, index_url: str, cache_ttl: int = 3600):
47	        """Initialize the search index client.
48	
49	        Args:
50	            index_url: URL to the search-index.js file
51	            cache_ttl: Time to live for cached index in seconds
52	        """
53	        self._index_url = index_url
54	        self._cache_ttl = cache_ttl
55	        self._index_data: dict | None = None
56	        self._items_by_name: dict[str, list[SearchIndexItem]] = {}
57	        self._all_items: list[SearchIndexItem] = []
58	        self._loaded = False
59	
60	    async def load(self) -> None:
61	        """Load and parse the search index.
62	
63	        Raises:
64	            httpx.HTTPError: If download fails
65	            ValueError: If parsing fails
66	        """
67	        if self._loaded:
68	            logger.warning("Search index already loaded")
69	            return
70	
71	        logger.info(f"Loading search index from {self._index_url}")
72	        start = asyncio.get_event_loop().time()
73	
74	        try:
75	            # Download the index
76	            async with httpx.AsyncClient(timeout=30.0) as client:
77	                response = await client.get(self._index_url, follow_redirects=True)
78	                response.raise_for_status()
79	                content = response.text
80	
81	            # Parse the JavaScript wrapper
82	            # Format: var searchIndex = new Map(JSON.parse('[...]'));
83	            match = re.search(r"JSON\.parse\('(.+?)'\)", content, re.DOTALL)
84	            if not match:
85	                raise ValueError("Could not find JSON data in search index")
86	
87	            json_str = match.group(1)
88	            # Unescape
89	            json_str = json_str.replace("\\'", "'").replace("\\\\", "\\")
90	
91	            # Parse JSON
92	            crates_list = json.loads(json_str)
93	
94	            # Find the windows crate
95	            for crate_entry in crates_list:
96	                if crate_entry[0] == "windows":
97	                    self._index_data = crate_entry[1]
98	                    break
99	
100	            if not self._index_data:
101	                raise ValueError("Could not find 'windows' crate in search index")
102	
103	            # Build search structures
104	            self._build_search_index()
105	
106	            self._loaded = True
107	            elapsed = asyncio.get_event_loop().time() - start
108	            logger.info(
109	                f"Search index loaded successfully in {elapsed:.2f}s "
110	                f"({len(self._all_items)} items indexed)"
111	            )
112	
113	        except Exception as e:
114	            logger.error(f"Failed to load search index: {e}")
115	            raise
116	
117	    def _build_search_index(self) -> None:
118	        """Build efficient search structures from the raw index data."""
119	        if not self._index_data:
120	            return
121	
122	        # The rustdoc index structure is complex. We'll parse the main parts:
123	        # - "n" contains item names
124	        # - "q" contains parent paths
125	        # - "t" contains type information
126	        # - "p" contains path information
127	
128	        names = self._index_data.get("n", [])
129	        types = self._index_data.get("t", "")
130	        paths = self._index_data.get("q", [])
131	        parent_idx = self._index_data.get("i", [])
132	
133	        # Build a path lookup
134	        path_list = ["windows"]  # Root is always "windows"
135	        if "p" in self._index_data:
136	            # "p" contains path segment definitions
137	            for p in self._index_data["p"]:
138	                if isinstance(p, list) and len(p) >= 2:
139	                    path_list.append("::".join(str(x) for x in p))
140	
141	        # Process items
142	        for idx, name in enumerate(names):
143	            if idx >= len(types):
144	                break
145	
146	            type_char = types[idx]
147	
148	            # Map type characters to readable names
149	            # This is a simplified mapping - rustdoc uses various type codes
150	            type_map = {
151	                "t": "struct",
152	                "f": "fn",
153	                "e": "enum",
154	                "s": "static",
155	                "c": "constant",
156	                "T": "trait",
157	                "m": "mod",
158	                "y": "type",
159	                "p": "primitive",
160	            }
161	            item_type = type_map.get(type_char, type_char)
162	
163	            # Get parent path
164	            parent_path = "windows"
165	            if idx < len(parent_idx):
166	                parent_id = parent_idx[idx]
167	                # parent_id can be int or string, convert to int
168	                try:
169	                    parent_id_int = (
170	                        int(parent_id) if isinstance(parent_id, str) else parent_id
171	                    )
172	                    if 0 <= parent_id_int < len(paths):
173	                        path_parts = paths[parent_id_int]
174	                        if isinstance(path_parts, list):
175	                            parent_path = "windows::" + "::".join(
176	                                str(p) for p in path_parts
177	                            )
178	                        elif isinstance(path_parts, str):
179	                            parent_path = f"windows::{path_parts}"
180	                except (ValueError, TypeError):
181	                    # If conversion fails, use default parent_path
182	                    pass
183	
184	            full_path = f"{parent_path}::{name}"
185	
186	            item = SearchIndexItem(
187	                type=item_type, path=parent_path, name=name, full_path=full_path
188	            )
189	
190	            self._all_items.append(item)
191	
192	            # Index by name (case-insensitive)
193	            name_lower = name.lower()
194	            if name_lower not in self._items_by_name:
195	                self._items_by_name[name_lower] = []
196	            self._items_by_name[name_lower].append(item)
197	
198	        logger.info(
199	            f"Built search index: {len(self._all_items)} total items, "
200	            f"{len(self._items_by_name)} unique names"
201	        )
202	
203	    def search(self, query: str, max_results: int = 10) -> list[SearchIndexItem]:
204	        """Search for items matching the query.
205	
206	        Args:
207	            query: Search term (case-insensitive)
208	            max_results: Maximum number of results to return
209	
210	        Returns:
211	            List of matching items, sorted by relevance
212	
213	        Raises:
214	            RuntimeError: If index not loaded
215	        """
216	        if not self._loaded:
217	            raise RuntimeError("Search index not loaded. Call load() first.")
218	
219	        query_lower = query.lower()
220	        results: list[tuple[int, SearchIndexItem]] = []
221	
222	        # Exact name matches first
223	        if query_lower in self._items_by_name:
224	            for item in self._items_by_name[query_lower]:
225	                results.append((0, item))  # Priority 0 = exact match
226	
227	        # Prefix matches
228	        if len(results) < max_results:
229	            for name_lower, items in self._items_by_name.items():
230	                if name_lower.startswith(query_lower) and name_lower != query_lower:
231	                    for item in items:
232	                        results.append((1, item))  # Priority 1 = prefix match
233	
234	        # Substring matches
235	        if len(results) < max_results:
236	            for name_lower, items in self._items_by_name.items():
237	                if (
238	                    query_lower in name_lower
239	                    and not name_lower.startswith(query_lower)
240	                    and name_lower != query_lower
241	                ):
242	                    for item in items:
243	                        results.append((2, item))  # Priority 2 = substring match
244	
245	        # Sort by priority, then by name length (shorter = more relevant)
246	        results.sort(key=lambda x: (x[0], len(x[1].name), x[1].name))
247	
248	        # Return just the items (without priority scores)
249	        return [item for _, item in results[:max_results]]
250	
251	    def get_by_full_path(self, full_path: str) -> SearchIndexItem | None:
252	        """Get an item by its full path.
253	
254	        Args:
255	            full_path: Full path like "windows::Win32::Storage::FileSystem::CreateFileA"
256	
257	        Returns:
258	            SearchIndexItem if found, None otherwise
259	        """
260	        if not self._loaded:
261	            raise RuntimeError("Search index not loaded. Call load() first.")
262	
263	        for item in self._all_items:
264	            if item.full_path == full_path:
265	                return item
266	
267	        return None
268	
269	    @property
270	    def is_loaded(self) -> bool:
271	        """Check if index is loaded.
272	
273	        Returns:
274	            True if loaded, False otherwise
275	        """
276	        return self._loaded
277	
278	    @property
279	    def item_count(self) -> int:
280	        """Get total number of indexed items.
281	
282	        Returns:
283	            Number of items in index
284	        """
285	        return len(self._all_items)
