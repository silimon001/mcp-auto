546	    """
547	    Get the PDF content for a specific paper.
548	    This returns the first PDF that is an attachement by default.
549	    
550	    Args:
551	        item_key: The paper's item key/ID
552	        attachement_index: Look at attachement with index (Default 0)
553	    """
554	    try:
555	        client = _get_zotero_client()
556	        children = client.children(item_key)
557	        pdf_attachments = [
558	            {
559	                'key': item['key'],
560	                'title': item['data'].get('title', 'Untitled'),
561	                'filename': item['data'].get('filename', 'Unknown'),
562	                'index': idx
563	            }
564	            for idx, item in enumerate(children)
565	            if item['data']['itemType'] == 'attachment' 
566	            and item['data'].get('contentType') == 'application/pdf'
567	        ]
568	        if len(pdf_attachments) == 0:
569	            return json.dumps({
570	                    "error": f"No PDF attachements found.",
571	                    "item_key": item_key,
572	                    "suggestion": "Check if this item has an attached PDF"
573	            }, indent=2)
574	        elif attachment_index >= len(pdf_attachments):
575	            return json.dumps({
576	                    "error": f"Invalid attachment index {attachment_index}",
577	                    "item_key": item_key,
578	                    "available_attachments": pdf_attachments,
579	                    "suggestion": f"Choose an index between 0 and {len(pdf_attachments)-1}"
580	                    }, indent=2)
581	        
582	        selected_attachment = pdf_attachments[attachment_index]
583	        pdf_uri = urllib.parse.unquote(client.file_url(selected_attachment['key']), encoding='utf-8', errors='replace')
