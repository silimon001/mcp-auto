376	                     f"- Hosts: {len(scan_data.get('hosts', []))} ({hosts_up} up)\n"
377	                     f"- Total ports/services: {total_ports}\n\n"
378	                     f"Use the nmap://scan/{scan_id} resource to access full results",
379	            )
380	        ]
