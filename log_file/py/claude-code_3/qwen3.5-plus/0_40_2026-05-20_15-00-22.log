47	@mcp.tool()
48	def get_account_balance(asset: str) -> Any:
49	    """
50	    Get the balance of a specific cryptocurrency asset.
51	
52	    Args:
53	        asset: The cryptocurrency symbol, e.g., BTC.
54	
55	    Returns:
56	        Asset balance info.
57	    """
58	    url = "https://api.binance.com/api/v3/account"
59	    timestamp = int(time.time() * 1000)
60	    params = {"timestamp": timestamp}
61	    query_string = "&".join([f"{k}={v}" for k, v in params.items()])
62	    signature = hmac.new(BINANCE_SECRET_KEY.encode(), query_string.encode(), hashlib.sha256).hexdigest()
63	    params["signature"] = signature
64	    headers = {"X-MBX-APIKEY": BINANCE_API_KEY}
65	    response = requests.get(url, headers=headers, params=params)
66	    if response.status_code == 200:
67	        balances = response.json().get("balances", [])
68	        for balance in balances:
69	            if balance["asset"] == asset:
70	                return {"asset": asset, "balance": balance["free"]}
71	        return {"error": f"No balance found for {asset}"}
72	    return {"error": response.text}
