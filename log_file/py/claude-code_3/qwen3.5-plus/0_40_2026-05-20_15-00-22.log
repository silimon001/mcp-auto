357	def _get_recent_items(limit: Optional[int] = Field(default=10), 
358	                      itemType: str = Field(default='-attachment', 
359	                                            description='Define item types to include, by default excludes attachments'),
360	                     ) -> list[dict[str, Any]] | dict[str, str]:
361	    """Get recently added items (this by default excludes attachements) to your library
362	    
363	    Args:
