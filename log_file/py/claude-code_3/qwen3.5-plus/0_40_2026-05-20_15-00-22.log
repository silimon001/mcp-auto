37	async def handle_sse(request):
38	    try:
39	        async with transport.connect_sse(
40	            request.scope, request.receive, request._send
41	        ) as streams:
42	            await mcp._mcp_server.run(
43	                streams[0],
44	                streams[1],
45	                mcp._mcp_server.create_initialization_options(),
46	            )
47	    except Exception as e:
48	        print(f"Error in handle_sse: {e}")
49	        raise
50	
51	
52	async def wrap_handle_post_message(scope: Scope,
53	                                   receive: Receive,
54	                                   send: Send):
55	    temp_request = Request(scope, receive)
56	    authorization = temp_request.headers.get("authorization")
57	    # ---- Start modify body ----
58	    original_body_bytes = b''
59	    original_receive = receive
60	    more_body = True
61	    while more_body:
62	        message = await original_receive()
63	        print(f"Received message: {message}")
64	        if message['type'] == 'http.request':
65	            original_body_bytes += message.get('body', b'')
66	            more_body = message.get('more_body', False)
67	        elif message['type'] == 'http.disconnect':
68	            print("Client disconnected while reading body")
69	            return
70	        else:
71	            pass
72	
73	    modified_body_bytes = original_body_bytes
74	    try:
75	        # Parse JSON
76	        data = json.loads(original_body_bytes.decode('utf-8'))
77	        if 'params' in data and 'arguments' in data['params']:
78	            if settings.enable_auth:
79	                data['params']['arguments']['dataset_name'] = authorization
80	        modified_body_bytes = json.dumps(data).encode('utf-8')
81	    except json.JSONDecodeError as e:
82	        print(f"Warning: Could not parse request body as JSON: {e}")
83	
84	    except Exception as e:
85	        print(f"Error during body modification: {e}")
86	    _receive_called = False
87	
88	    async def modified_receive():
89	        nonlocal _receive_called
90	        if not _receive_called:
91	            _receive_called = True
92	            return {'type': 'http.request', 'body': modified_body_bytes, 'more_body': False}
93	        else:
94	            await asyncio.sleep(3600)
95	            return {'type': 'http.disconnect'}
96	
97	    return await transport.handle_post_message(scope, modified_receive, send)
98	
99	app = Starlette(
100	    routes=[
101	        Route('/sse/', endpoint=handle_sse),
102	        Mount("/messages/", app=wrap_handle_post_message)
103	    ]
