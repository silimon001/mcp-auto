[USER]:
1	"""
2	Model Context Protocol (MCP) Flight Search Server implementation.
3	
4	This module sets up an MCP-compliant server and registers flight search tools
5	that follow Anthropic's Model Context Protocol specification. These tools can be
6	accessed by Claude and other MCP-compatible AI models.
7	"""
8	from mcp.server.fastmcp import FastMCP
9	import argparse
10	from mcp_flight_search.utils.logging import logger
11	from mcp_flight_search.services.search_service import search_flights
12	from mcp_flight_search.config import DEFAULT_PORT, DEFAULT_CONNECTION_TYPE
13	
14	def create_mcp_server(port=DEFAULT_PORT):
15	    """
16	    Create and configure the Model Context Protocol server.
17	    
18	    Args:
19	        port: Port number to run the server on
20	        
21	    Returns:
22	        Configured MCP server instance
23	    """
24	    mcp = FastMCP("FlightSearchService", port=port)
25	    
26	    # Register MCP-compliant tools
27	    register_tools(mcp)
28	    
29	    return mcp
30	
31	def register_tools(mcp):
32	    """
33	    Register all tools with the MCP server following the Model Context Protocol specification.
34	    
35	    Each tool is decorated with @mcp.tool() to make it available via the MCP interface.
36	    
37	    Args:
38	        mcp: The MCP server instance
39	    """
40	    @mcp.tool()
41	    async def search_flights_tool(origin: str, destination: str, outbound_date: str, return_date: str = None):
42	        """
43	        Search for flights using SerpAPI Google Flights.
44	        
45	        This MCP tool allows AI models to search for flight information by specifying
46	        departure and arrival airports and travel dates.
47	        
48	        Args:
49	            origin: Departure airport code (e.g., ATL, JFK)
50	            destination: Arrival airport code (e.g., LAX, ORD)
51	            outbound_date: Departure date (YYYY-MM-DD)
52	            return_date: Return date for round trips (YYYY-MM-DD)
53	            
54	        Returns:
55	            A list of available flights with details
56	        """
57	        return await search_flights(origin, destination, outbound_date, return_date)
58	
59	    @mcp.tool()
60	    def server_status():
61	        """
62	        Check if the Model Context Protocol server is running.
63	        
64	        This MCP tool provides a simple way to verify the server is operational.
65	        
66	        Returns:
67	            A status message indicating the server is online
68	        """
69	        return {"status": "online", "message": "MCP Flight Search server is running"}
70	    
71	    logger.debug("Model Context Protocol tools registered")
72	
73	def main():
74	    """
75	    Main entry point for the Model Context Protocol Flight Search Server.
76	    """
77	    # Initialize argument parser
78	    parser = argparse.ArgumentParser(description="Model Context Protocol Flight Search Service")
79	    parser.add_argument("--connection_type", type=str, default=DEFAULT_CONNECTION_TYPE, 
80	                        choices=["http", "stdio"], help="Connection type (http or stdio)")
81	    parser.add_argument("--port", type=int, default=DEFAULT_PORT, 
82	                        help=f"Port to run the server on (default: {DEFAULT_PORT})")
83	    args = parser.parse_args()
84	    
85	    # Initialize MCP server
86	    mcp = create_mcp_server(port=args.port)
87	    
88	    # Determine server type
89	    server_type = "sse" if args.connection_type == "http" else "stdio"
90	    
91	    # Start the server
92	    logger.info(f"🚀 Starting Model Context Protocol Flight Search Service on port {args.port} with {args.connection_type} connection")
93	    mcp.run(server_type)
94	
95	if __name__ == "__main__":
96	    main() 

