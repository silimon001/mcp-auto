621	@mcp.tool(description="Search the Zotero library for an item.")
622	async def search_library(query: str, 
623	                         qmode: Literal["everything"] | Literal["titleCreatorYear"] = Field(default='titleCreatorYear', 
624	                                                                                            description='Use all field and full text search (`everything`), or only Title, Creator and Year search (`titleCreatorYear`)'),
625	                         itemType: str = Field(default='-attachment', 
626	                                               description=_zotero_item_type_desc),
627	                         tag: Optional[str] = Field(default=None, 
628	                                          description=_zotero_tag_type_desc),
629	                         include_abstract: bool = Field(default=False, description='Should search results include the abstract?'),
630	                         limit: Optional[int] = None,
631	                         context: Optional[Context] = None) -> str:
632	    """
633	    Search the Zotero library for an item.
634	    
635	    Args:
636	        query: Search query
637	        qmode: Query mode (`titleCreatorYear` or `everything` (default))
638	        itemType: Configuration on items to search, (default no attachements).
639	        limit: How many items to return (default unlimited)
640	    """
641	    if not query.strip():
642	        return json.dumps({
643	            "error": "Search query is required"
644	        }, indent=2)
645	        
646	    try:
647	        client = _get_zotero_client()
648	        optional_args = {'tag': tag,
649	                         'limit': limit}
650	        items = client.items(q=query, qmode=qmode, itemType=itemType, 
651	                             **{key: value for key, value in optional_args.items() if value is not None})
652	        if len(items) < 1:
653	            return json.dumps({
654	                "error": "No results found",
655	                "query": query,
656	                "suggestion": "Try a different search term or verify your library contains matching items"
657	            }, indent=2)
658	            
659	        formatted_items = [client.format_item(item, include_abstract=include_abstract) for item in items]
660	        return json.dumps(formatted_items, indent=2)
661	    except Exception as e:
662	        if context and hasattr(context, '_fastmcp'):
663	            await context.error(f"Search failed ({query}). Message: {str(e)}")
664	        return json.dumps({
665	                "error": f"Search failed. Message: {str(e)}",
666	                "query": query,
667	        }, indent=2)
