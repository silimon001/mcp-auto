1	#!/usr/bin/env python3
2	"""
3	MCP Server for Stock Image Search and Download
4	Supports multiple stock image platforms: Pexels, Unsplash, Pixabay
5	"""
6	
7	import os
8	import requests
9	import json
10	import sys
11	from typing import List, Dict, Optional, Any
12	from pathlib import Path
13	from urllib.parse import quote
14	from dotenv import load_dotenv
15	from mcp.server.fastmcp import FastMCP
16	
17	# Load environment variables
18	load_dotenv()
19	
20	print("--- Stock Images MCP Server Starting ---", file=sys.stderr)
21	sys.stderr.flush()
22	
23	# Initialize the FastMCP server
24	mcp = FastMCP("stock-images-mcp")
25	
26	# API Keys from environment variables
27	PEXELS_API_KEY = os.getenv("PEXELS_API_KEY")
28	UNSPLASH_API_KEY = os.getenv("UNSPLASH_API_KEY")
29	PIXABAY_API_KEY = os.getenv("PIXABAY_API_KEY")
30	
31	# Create downloads directory
32	DOWNLOADS_DIR = Path("downloads")
33	DOWNLOADS_DIR.mkdir(exist_ok=True)
34	
35	class StockImageError(Exception):
36	    """Custom exception for stock image API errors"""
37	    pass
38	
39	def validate_api_key(platform: str, api_key: str) -> None:
40	    """Validate that API key exists for the platform"""
41	    if not api_key:
42	        raise StockImageError(f"API key for {platform} not found. Please set {platform.upper()}_API_KEY in your .env file")
43	
44	def search_pexels(query: str, per_page: int = 10) -> List[Dict[str, Any]]:
45	    """Search images on Pexels"""
46	    validate_api_key("Pexels", PEXELS_API_KEY)
47	    
48	    headers = {"Authorization": PEXELS_API_KEY}
49	    url = f"https://api.pexels.com/v1/search?query={quote(query)}&per_page={per_page}"
50	    
51	    try:
52	        response = requests.get(url, headers=headers)
53	        response.raise_for_status()
54	        data = response.json()
55	        
56	        images = []
57	        for photo in data.get("photos", []):
58	            images.append({
59	                "id": photo["id"],
60	                "url": photo["src"]["original"],
61	                "preview_url": photo["src"]["medium"],
62	                "photographer": photo["photographer"],
63	                "alt": photo.get("alt", ""),
64	                "width": photo["width"],
65	                "height": photo["height"],
66	                "platform": "pexels"
67	            })
68	        return images
69	    except requests.RequestException as e:
70	        raise StockImageError(f"Pexels API error: {str(e)}")
71	
72	def search_unsplash(query: str, per_page: int = 10) -> List[Dict[str, Any]]:
73	    """Search images on Unsplash"""
74	    validate_api_key("Unsplash", UNSPLASH_API_KEY)
75	    
76	    headers = {"Authorization": f"Client-ID {UNSPLASH_API_KEY}"}
77	    url = f"https://api.unsplash.com/search/photos?query={quote(query)}&per_page={per_page}"
78	    
79	    try:
80	        response = requests.get(url, headers=headers)
81	        response.raise_for_status()
82	        data = response.json()
83	        
84	        images = []
85	        for photo in data.get("results", []):
86	            images.append({
87	                "id": photo["id"],
88	                "url": photo["urls"]["full"],
89	                "preview_url": photo["urls"]["regular"],
90	                "photographer": photo["user"]["name"],
91	                "alt": photo.get("alt_description", ""),
92	                "width": photo["width"],
93	                "height": photo["height"],
94	                "platform": "unsplash"
95	            })
96	        return images
97	    except requests.RequestException as e:
98	        raise StockImageError(f"Unsplash API error: {str(e)}")
99	
100	def search_pixabay(query: str, per_page: int = 10) -> List[Dict[str, Any]]:
101	    """Search images on Pixabay"""
102	    validate_api_key("Pixabay", PIXABAY_API_KEY)
103	    
104	    url = f"https://pixabay.com/api/?key={PIXABAY_API_KEY}&q={quote(query)}&per_page={per_page}&image_type=photo"
105	    
106	    try:
107	        response = requests.get(url)
108	        response.raise_for_status()
109	        data = response.json()
110	        
111	        images = []
112	        for hit in data.get("hits", []):
113	            images.append({
114	                "id": hit["id"],
115	                "url": hit["largeImageURL"],
116	                "preview_url": hit["webformatURL"],
117	                "photographer": hit["user"],
118	                "alt": hit.get("tags", ""),
119	                "width": hit["imageWidth"],
120	                "height": hit["imageHeight"],
121	                "platform": "pixabay"
122	            })
123	        return images
124	    except requests.RequestException as e:
125	        raise StockImageError(f"Pixabay API error: {str(e)}")
126	
127	@mcp.tool()
128	async def search_stock_images(query: str, platform: str = "all", per_page: int = 10) -> str:
129	    """
130	    Search for stock images across multiple platforms (Pexels, Unsplash, Pixabay)
131	    
132	    Args:
133	        query: Search query for images
134	        platform: Platform to search on (all, pexels, unsplash, pixabay). Default: all
135	        per_page: Number of images to return per platform (1-50). Default: 10
136	    """
137	    print(f"MCP Tool (Stock Images): search_stock_images called with query: {query}, platform: {platform}", file=sys.stderr)
138	    
139	    try:
140	        results = {}
141	        
142	        if platform in ["all", "pexels"] and PEXELS_API_KEY:
143	            results["pexels"] = search_pexels(query, per_page)
144	        
145	        if platform in ["all", "unsplash"] and UNSPLASH_API_KEY:
146	            results["unsplash"] = search_unsplash(query, per_page)
147	        
148	        if platform in ["all", "pixabay"] and PIXABAY_API_KEY:
149	            results["pixabay"] = search_pixabay(query, per_page)
150	        
151	        if not results:
152	            return "No API keys configured. Please set up your API keys in the .env file."
153	        
154	        # Format results for display
155	        formatted_results = []
156	        for platform_name, images in results.items():
157	            formatted_results.append(f"\n## {platform_name.title()} Results ({len(images)} images):")
158	            for i, img in enumerate(images, 1):
159	                formatted_results.append(
160	                    f"{i}. **{img['photographer']}** - {img['width']}x{img['height']}\n"
161	                    f"   Preview: {img['preview_url']}\n"
162	                    f"   Full: {img['url']}\n"
163	                    f"   Alt: {img['alt']}\n"
164	                )
165	        
166	        return f"# Stock Image Search Results for '{query}'\n" + "\n".join(formatted_results)
167	        
168	    except StockImageError as e:
169	        return f"Error: {str(e)}"
170	
171	def main():
172	    """Main function to run the MCP server"""
173	    mcp.run(transport='stdio')
174	    print("--- mcp.run() finished (should not happen if running as server) ---", file=sys.stderr)
175	    sys.stderr.flush()
176	
177	if __name__ == "__main__":
178	    print("--- Entering main block, calling mcp.run() ---", file=sys.stderr)
179	    sys.stderr.flush()
180	    main()
181	
182	print("--- Script reached end (should not happen if running as server) ---", file=sys.stderr)
183	sys.stderr.flush()
184	

