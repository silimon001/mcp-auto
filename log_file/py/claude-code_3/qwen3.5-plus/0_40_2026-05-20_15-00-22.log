390	        scan_list = []
391	        for scan_id, scan_data in scan_results.items():
392	            hosts_count = len(scan_data.get("hosts", []))
393	            scan_list.append(f"- Scan ID: {scan_id}")
394	            scan_list.append(f"  Target: {scan_data.get('target')}")
395	            scan_list.append(f"  Options: {scan_data.get('options')}")
396	            scan_list.append(f"  Hosts: {hosts_count}")
397	            scan_list.append("")
