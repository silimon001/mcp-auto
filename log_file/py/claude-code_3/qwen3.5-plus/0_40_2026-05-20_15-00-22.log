98	      MCP_ENTITIES_DIR: "${MCP_ROOT_ENTITIES_DIR:-entities}" # Default to base dir if var not set
99	      # Default MCP_ROOT_ENTITIES to empty string if not set in .env,
100	      # ensuring entrypoint.sh omits --entities unless explicitly set
101	      MCP_ENTITIES: "${MCP_ROOT_ENTITIES:-}"
102	      GRAPHITI_LOG_LEVEL: "${MCP_ROOT_LOG_LEVEL:-info}" # Default to 'info' if var not set
