300	        "quantity": quantity,
301	        "timestamp": timestamp
302	    }
303	    query_string = "&".join([f"{k}={v}" for k, v in params.items()])
304	    signature = hmac.new(BINANCE_SECRET_KEY.encode(), query_string.encode(), hashlib.sha256).hexdigest()
305	    params["signature"] = signature
306	    headers = {"X-MBX-APIKEY": BINANCE_API_KEY}
