1	from fastmcp import FastMCP
2	import requests
3	import os
4	from dotenv import load_dotenv
5	
6	load_dotenv()
7	
8	mcp = FastMCP("networksdb")
9	
10	NETWORKSDB_ENDPOINT = 'https://networksdb.io'
11	api_key = os.getenv("NETWORKSDB_API_KEY")
12	if not api_key:
13	    raise ValueError("NETWORKSDB_API_KEY environment variable is required")
14	
15	def make_request(path: str, params: dict = {}):
16	    try:
17	        response = requests.post(
18	            f'{NETWORKSDB_ENDPOINT}{path}', 
19	            headers={'X-Api-Key': api_key}, 
20	            data=params,
21	            timeout=30.0
22	        )
23	        response.raise_for_status()
24	        return response.json()
25	    except requests.Timeout:
26	        return {"error": "Request timed out"}
27	    except Exception as e:
28	        return {"error": str(e)}
29	
30	@mcp.tool()
31	def key_info():
32	    """Get information about your NetworksDB API key and usage statistics."""
33	    return make_request('/api/key')
34	
35	@mcp.tool()
36	def ip_info(ip: str = None):
37	    """Get information about an IP address."""
38	    return make_request('/api/ip-info', {'ip': ip} if ip else {})
39	
40	@mcp.tool()
41	def ip_geo(ip: str = None):
42	    """Get geolocation information for an IP address."""
43	    return make_request('/api/ip-geo', {'ip': ip} if ip else {})
44	
45	@mcp.tool()
46	def org_search(query: str):
47	    """Search for organizations by name."""
48	    return make_request('/api/org-search', {'search': query})
49	
50	@mcp.tool()
51	def org_info(id: str):
52	    """Get information about an organization."""
53	    return make_request('/api/org-info', {'id': id})
54	
55	@mcp.tool()
56	def org_networks(id: str, ipv6: bool = False):
57	    """Get networks belonging to an organization."""
58	    params = {'id': id}
59	    if ipv6:
60	        params['ipv6'] = True
61	    return make_request('/api/org-networks', params)
62	
63	@mcp.tool()
64	def asn_info(asn: str):
65	    """Get information about an ASN."""
66	    return make_request('/api/asn-info', {'asn': asn})
67	
68	@mcp.tool()
69	def asn_networks(asn: str, ipv6: bool = False):
70	    """Get networks belonging to an ASN."""
71	    params = {'asn': asn}
72	    if ipv6:
73	        params['ipv6'] = True
74	    return make_request('/api/asn-networks', params)
75	
76	@mcp.tool()
77	def dns(domain: str):
78	    """Get DNS records for a domain."""
79	    return make_request('/api/dns', {'domain': domain})
80	
81	@mcp.tool()
82	def reverse_dns(ip: str):
83	    """Get reverse DNS records for an IP address."""
84	    return make_request('/api/reverse-dns', {'ip': ip})
85	
86	@mcp.tool()
87	def mass_reverse_dns(start: str, end: str = None):
88	    """Get reverse DNS records for a range of IP addresses or CIDR."""
89	    if end:
90	        params = {'ip_start': start, 'ip_end': end}
91	    else:
92	        params = {'cidr': start}
93	    return make_request('/api/mass-reverse-dns', params)
94	
95	if __name__ == "__main__":
96	    mcp.run(transport="stdio") 

