7	transport = os.getenv("MCP_TRANSPORT", "streamable-http").strip()
8	
9	# Validate transport
10	if transport not in {"streamable-http", "sse"}:
11	    print(f"ERROR: Unsupported transport '{transport}'", file=sys.stderr)
12	    sys.exit(1)
