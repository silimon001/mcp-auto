311	@mcp.tool()
312	def find_arbitrage_pairs(
313	        min_funding_rate: float = 0.0005,
314	        min_avg_volume: float = 1_000_000,
315	        history_days: int = 7,
316	        stability_threshold: float = 0.8
317	) -> list[dict[str, Any]]:
318	    """
319	    Find arbitrage pairs based on funding rate, volume, and rate direction stability.
320	
321	    Args:
322	        min_funding_rate: Minimum funding rate to qualify.
323	        min_avg_volume: Minimum 24hr volume in USDT.
324	        history_days: How many days of history to analyze.
325	        stability_threshold: Minimum proportion of funding rates in same direction.
326	
327	    Returns:
328	        List of qualifying arbitrage opportunities.
329	    """
330	    current_url = "https://fapi.binance.com/fapi/v1/premiumIndex"
331	    history_url = "https://fapi.binance.com/fapi/v1/fundingRate"
332	    candidates = []
333	
334	    response = requests.get(current_url)
335	    if response.status_code != 200:
336	        return [{"error": "Failed to fetch current funding data"}]
337	
338	    for pair in response.json():
339	        try:
340	            symbol = pair["symbol"]
341	            current_rate = float(pair["lastFundingRate"])
342	
343	            if abs(current_rate) < min_funding_rate:
344	                continue
345	
346	            history_params = {
347	                "symbol": symbol,
348	                "limit": history_days * 3
349	            }
350	            history_resp = requests.get(history_url, params=history_params)
351	            if history_resp.status_code != 200:
352	                continue
353	
354	            rates = [float(x["fundingRate"]) for x in history_resp.json()]
355	            same_dir = sum(1 for r in rates if (r > 0 and current_rate > 0) or (r < 0 and current_rate < 0))
356	            stability = same_dir / len(rates) if rates else 0
357	
358	            ticker_url = f"https://fapi.binance.com/fapi/v1/ticker/24hr?symbol={symbol}"
359	            ticker_resp = requests.get(ticker_url)
360	            if ticker_resp.status_code != 200:
361	                continue
362	
363	            volume = float(ticker_resp.json().get("quoteVolume", 0))
364	            if volume > min_avg_volume and stability >= stability_threshold:
365	                candidates.append({
366	                    "symbol": symbol,
367	                    "current_funding_rate": current_rate,
368	                    "avg_volume": volume,
369	                    "stability": round(stability, 2)
370	                })
371	
372	        except Exception:
373	            continue
374	
375	    return sorted(candidates, key=lambda x: -abs(x["current_funding_rate"]))
376	
