h = HOME / ".claude" / "settings.json" 421 422 if not settings_path.exists(): 423 print("settings.json not found") 424 sys.exit(1) 425 426 settings = json.loads(settings_path.read_text()) 427 428 anthropic_model = settings.get('env').get("ANTHROPIC_MODEL") 429 430 if not anthropic_model: 431 print("ANTHROPIC_MODEL not found in settings.json") 432 sys.exit(1) 433 434 normalized = normalize_model_name(anthropic_model) 435 436 if normalized != model_name: 437 print( 438 f"Model mismatch:\n" 439 f"expected: {model_name}\n" 440 f"actual: {anthropic_model}" 441 ) 442 sys.exit(1) 443 444 print(f"Model verified: {anthropic_model}") 445 446 def env_ready(): 447 import shutil 448 # 1. Add .mcp.json 449 target_mcp = CWD / ".mcp.json" 450 source_mcp = MAIN_CWD / "claude_code_copy" / ".mcp.json" 451 452 if target_mcp.exists(): 453 target_mcp.unlink() 454 455 shutil.copy2(source_mcp, target_mcp) 456 print("Add .mcp.json") 457 458 # 2. Delete .claude dir 459 skills_dir = CWD / ".claude" 460 461 if skills_dir.exists(): 462 shutil.rmtree(skills_dir) 463 print(f"Deleted {skills_dir} folder") 464 465 # 3. Delete CLAUDE.md 466 claude_md = CWD / 'CLAUDE.md' 467 468 if claude_md.exists(): 469 claude_md.unlink() 470 print(f"Deleted {claude_md}") 471 472 473 # ========================= 474 # 6. 示例入口 475 # ========================= 476 if __name__ == "__main__": 477 478 os.makedirs('mcp_server', exist_ok=True) 479 os.makedirs('mcp_server_config', exist_ok=True) 480 with open('mcp_server_config/config.json', 'w', encoding='utf-8') as f: 481 f.write('{\n "Servers": {\n\n }\n}') 482 483 with open('prompt_for_exp3.md', 'r', encoding='utf-8') as f: 484 task_prompt = f.read() 485 task_prompt = task_prompt.replace("{WORKSPACE}", str(CWD)) 486 487 from glob import glob 488 readme_dir = MAIN_CWD / "data" / "dataset" / dataset_name / "sampled_validated_readme" 489 readme_files = sorted(glob(str(readme_dir / "*.md")), key=os.path.getsize) 490 491 pos = 40 492 count = 40 493 494 for readme_path in readme_files[pos:pos+count]: 495 496 verify_model(model_name) 497 env_ready() 498 499 readme_path = Path(readme_path) 500 filename_parts = readme_path.stem.split('_') 501 repo_id = filename_parts[0] 502 503 with open(readme_path, 'r', encoding='utf-8') as f: 504 readme_content = f.read() 505 506 extra_info = add_extra_info(dataset_name, repo_id) 507 508 query = f'''\n=== README.md START ===\n{readme_content}\n=== README.md END ===\n{extra_info}''' 509 510 all_prompt = task_prompt + query 511 512 run_task(all_prompt, "claude_code", pos, count)
