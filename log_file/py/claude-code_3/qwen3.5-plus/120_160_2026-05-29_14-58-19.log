11	
12	def search_chunks(
13	    query: str, filename: Optional[str] = None, max_results: int = 5
14	) -> List[Dict[str, Union[str, float]]]:
15	    """
16	    Performs semantic search over the loaded document chunks using embeddings.
17	    """
18	    if not query:
19	        return []
20	    all_chunks = get_all_chunks()
21	    if not all_chunks:
22	        # Consider logging this instead of printing
23	        # import sys
24	        # print("Warning: No chunks loaded for searching.", file=sys.stderr)
25	        return []
26	
27	    # Generate embedding for the query
28	    try:
29	        query_embedding = embedding_model.encode(query)
30	    except Exception as e:
31	        # Consider logging this instead of printing
32	        # import sys
33	        # print(f"Error encoding query '{query}': {e}", file=sys.stderr)
34	        return []  # Cannot search if query encoding fails
35	
36	    results_with_scores = []
37	
38	    for idx, chunk in enumerate(all_chunks):
39	        # Filter by filename if provided
40	        if filename and chunk["filename"] != filename:
41	            continue
42	
43	        # Check if chunk has an embedding
44	        chunk_embedding = chunk.get("embedding")
45	        if chunk_embedding is None or not isinstance(chunk_embedding, np.ndarray):
46	            continue  # Skip chunks without embeddings
47	
48	        # Calculate dot product similarity (recommended for multi-qa-mpnet-base-dot-v1)
49	        try:
50	            # Note: dot_score doesn't guarantee a range like [-1, 1], scores can be higher/lower.
51	            # util.dot_score returns a tensor, get the single value
52	            similarity = dot_score(query_embedding, chunk_embedding)[0][0].item()
53	        except Exception as e:
54	            # Consider logging this instead of printing
55	            # import sys
56	            # print(f"Error calculating similarity for chunk {idx}: {e}", file=sys.stderr)
57	            similarity = -float("inf")  # Assign a very low score if calculation fails
58	
59	        # Store results with scores
60	        results_with_scores.append(
61	            {
62	                "filename": chunk["filename"],
63	                "heading": chunk["heading"],
64	                "content": chunk["content"],  # Return original content
65	                "score": similarity,
66	                "source_url": chunk.get("source_url", ""),
67	            }
68	        )
69	
70	    # Sort results by score (descending)
71	    results_with_scores.sort(key=lambda x: x["score"], reverse=True)
72	
73	    return results_with_scores[:max_results]
