103	@app.get("/mcp/list_tables", response_model=List[TableInfo])
104	async def list_tables(db_manager: DatabaseManager = Depends(get_db_manager)):
105	    """List all available tables in the database"""
106	    try:
107	        tables = await db_manager.list_tables()
108	        return [
