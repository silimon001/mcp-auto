273	def get_document_headings(filename: str) -> List[Dict[str, Union[int, str]]]:
274	    """Returns the heading structure for a specific document."""
275	    headings = []
276	    seen_headings = set()
277	    for chunk in document_chunks:
278	        if chunk["filename"] == filename:
279	            # Use heading text + level to define uniqueness for this list
280	            heading_key = (chunk["heading"], chunk["level"])
281	            if heading_key not in seen_headings:
282	                headings.append(
283	                    {
284	                        # Convert back to int for output
285	                        "level": int(chunk["level"]),
286	                        "title": chunk["heading"],
287	                    }
288	                )
289	                seen_headings.add(heading_key)
290	    # Note: This simple approach doesn't guarantee perfect hierarchical order
291	    # if headings were out of order in the source, but gives a flat list.
292	    return headings
