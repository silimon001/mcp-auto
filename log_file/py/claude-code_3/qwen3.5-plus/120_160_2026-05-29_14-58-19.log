24	def parse_markdown_to_chunks(filename: str, content: str) -> List[Dict[str, str]]:
25	    """
26	    Parses markdown content into chunks based on headings (## and deeper).
27	
28	    Each chunk includes the heading, the content following it, and any
29	    detected Source: URL immediately after the heading.
30	    """
31	    chunks = []
32	    lines = content.splitlines()
33	    # Default for content before the first heading
