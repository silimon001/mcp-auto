740	def build_state_summary(state: Dict[str, Any]) -> Dict[str, Any]:
741	    power = state.get("power")
742	    return {
743	        "power": power,
744	        "power_status": "on" if power is True else "off" if power is False else "unknown",
745	        "brightness": state.get("brightness"),
746	        "color_temperature": state.get("color_temperature"),
747	        "mode": state.get("mode"),
748	        "target_temperature": state.get("target_temperature"),
749	        "fan_speed": state.get("fan_speed"),
750	        "cover_position": state.get("cover_position"),
751	        "temperature": state.get("temperature"),
752	        "humidity": state.get("relative-humidity"),
753	        "battery_level": state.get("battery-level"),
754	    }
