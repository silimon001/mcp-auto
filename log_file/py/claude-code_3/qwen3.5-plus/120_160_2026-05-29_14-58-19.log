40	
41	class TableInfo(BaseModel):
42	    table_name: str
43	    column_count: int
44	
45	class ColumnInfo(BaseModel):
46	    column_name: str
47	    data_type: str
48	    is_nullable: bool
49	
50	class TableSchema(BaseModel):
51	    table_name: str
52	    columns: List[ColumnInfo]
53	
54	# Global variables
55	nl_converter: Optional[NLToSQLConverter] = None
56	
57	@asynccontextmanager
58	async def lifespan(app: FastAPI):
59	    """Application lifespan manager"""
60	    global nl_converter
61	    
62	    # Startup
63	    logger.info("Starting MCP Database Server...")
64	    try:
65	        nl_converter = NLToSQLConverter()
66	        logger.info("NL to SQL converter initialized")
67	    except Exception as e:
68	        logger.error(f"Failed to initialize NL converter: {e}")
69	        nl_converter = None
70	    
71	    yield
72	    
73	    # Shutdown
74	    logger.info("Shutting down MCP Database Server...")
75	
76	# Create FastAPI app
77	app = FastAPI(
78	    title="MCP Database Server",
79	    description="An MCP server exposing relational databases (Postgres/MySQL) to AI agents. Supports NL→SQL.",
80	    version="1.0.0",
81	    lifespan=lifespan
82	)
