1641	@mcp.tool(name="control_by_intent")
1642	async def control_by_intent(
1643	    query: str,
1644	    room: str = "",
1645	    home: str = "",
1646	    prefer_device_type: str = "",
1647	) -> IntentControlToolResult:
1648	    """Route a natural-language-like smart-home request to the best product tool."""
1649	    adapter = get_adapter()
1650	    if not adapter:
1651	        return build_result(False, "Adapter not initialized")
1652	
1653	    try:
1654	        await ensure_connected(adapter)
1655	        known_rooms = await get_known_room_names(adapter)
1656	        parsed = infer_intent(query, fallback_room_hints=FALLBACK_ROOM_HINTS, known_rooms=known_rooms)
1657	        resolved_room = room or parsed.get("room", "")
1658	        device_query = parsed.get("device_query", "").strip()
1659	
1660	        if parsed["intent"] == "execute_scene":
1661	            payload = extract_structured_content(
1662	                await execute_scene(scene_name=parsed.get("scene_name", ""), home_name=home)
1663	            )
1664	            return build_result(
1665	                bool(payload.get("success")),
1666	                payload.get("message", "Executed scene"),
1667	                route="scene",
1668	                parsed_intent=parsed,
1669	                result=payload,
1670	            )
1671	
1672	        if parsed["intent"] == "list_devices":
1673	            payload = extract_structured_content(await list_devices(
1674	                query=parsed.get("device_query", ""),
1675	                room=resolved_room,
1676	                home=home,
1677	                device_type=prefer_device_type,
1678	            ))
1679	            return build_result(
1680	                bool(payload.get("success")),
1681	                payload.get("message", "Listed devices"),
1682	                route="device_list",
1683	                parsed_intent=parsed,
1684	                result=payload,
1685	            )
1686	
1687	        if parsed["intent"] == "get_device":
1688	            payload = extract_structured_content(await get_device(
1689	                device_name=device_query,
1690	                room=resolved_room,
1691	                home=home,
1692	                device_type=prefer_device_type,
1693	                refresh=True,
1694	            ))
1695	            return build_result(
1696	                bool(payload.get("success")),
1697	                payload.get("message", "Loaded device"),
1698	                route="device_status",
1699	                parsed_intent=parsed,
1700	                result=payload,
1701	            )
1702	
1703	        if parsed["intent"] in OPERATION_CAPABILITY_MAP or parsed["intent"] == "toggle":
1704	            if not device_query:
1705	                return build_result(False, "No target device could be inferred from the request", parsed_intent=parsed)
1706	
1707	            device = await resolve_device(
1708	                adapter,
1709	                device_name=device_query,
1710	                room=resolved_room,
1711	                home=home,
1712	                device_type=prefer_device_type,
1713	                refresh=True,
1714	            )
1715	            profile = await get_device_profile(adapter, device["device_id"])
1716	            supported_lookup = {
1717	                item["operation"]: item["enabled"]
1718	                for item in profile.get("supported_operations", [])
1719	            }
1720	            if supported_lookup.get(parsed["intent"], False):
1721	                kwargs: Dict[str, Any] = {
1722	                    "operation": parsed["intent"],
1723	                    "device_id": device["device_id"],
1724	                    "refresh": True,
1725	                }
1726	                if "value" in parsed:
1727	                    kwargs["value"] = parsed["value"]
1728	                payload = extract_structured_content(await control_device(**kwargs))
1729	                return build_result(
1730	                    bool(payload.get("success")),
1731	                    payload.get("message", "Controlled device"),
1732	                    route="standard_operation",
1733	                    parsed_intent=parsed,
1734	                    result=payload,
1735	                )
1736	
1737	            fallback_payload = extract_structured_content(await control_device_with_profile_fallback(
1738	                adapter,
1739	                query=query,
1740	                device_name=device_query,
1741	                room=resolved_room,
1742	                home=home,
1743	                prefer_device_type=prefer_device_type,
1744	                parsed_intent=parsed,
1745	            ))
1746	            fallback_result = build_result(
1747	                bool(fallback_payload.get("success")),
1748	                (
1749	                    f"Fell back to profile-driven control for {device['name']}"
1750	                    if fallback_payload.get("success")
1751	                    else f"Profile-driven fallback did not succeed for {device['name']}"
1752	                ),
1753	                parsed_intent=parsed,
1754	                fallback_mode="profile_driven",
1755	                fallback_result=fallback_payload,
1756	            )
1757	            return fallback_result
1758	
1759	        return build_result(
1760	            False,
1761	            "Could not route the request to a supported smart-home intent",
1762	            parsed_intent=parsed,
1763	        )
1764	    except Exception as exc:
1765	        logger.error(f"Failed to control by intent: {exc}")
1766	        fallback_rooms = await get_known_room_names(adapter) if adapter and adapter.connected else None
1767	        return build_error_result(
1768	            exc,
1769	            parsed_intent=infer_intent(query, fallback_room_hints=FALLBACK_ROOM_HINTS, known_rooms=fallback_rooms),
1770	        )
1771	
