69	        "list_accounts": {"readOnlyHint": True},
70	        "get_account": {"readOnlyHint": True},
71	        "create_account": {"destructiveHint": False},
72	        "update_account": {"destructiveHint": False},
73	        "manage_account_state": {"destructiveHint": False},
74	        "delete_account": {"destructiveHint": True, "confirmationRequiredHint": True},
75	
76	        # Campaign tools
77	        "create_campaign": {"destructiveHint": False},
78	        "list_campaigns": {"readOnlyHint": True},
79	        "get_campaign": {"readOnlyHint": True},
80	        "update_campaign": {"destructiveHint": False},
81	        "activate_campaign": {"destructiveHint": False},
82	        "pause_campaign": {"destructiveHint": False},
83	        "delete_campaign": {"destructiveHint": True, "confirmationRequiredHint": True},
84	        "search_campaigns_by_contact": {"readOnlyHint": True},
85	
86	        # Lead tools
87	        "list_leads": {"readOnlyHint": True},
88	        "get_lead": {"readOnlyHint": True},
89	        "create_lead": {"destructiveHint": False},
90	        "update_lead": {"destructiveHint": False},
91	        "list_lead_lists": {"readOnlyHint": True},
92	        "create_lead_list": {"destructiveHint": False},
93	        "update_lead_list": {"destructiveHint": False},
94	        "get_verification_stats_for_lead_list": {"readOnlyHint": True},
95	        "add_leads_to_campaign_or_list_bulk": {"destructiveHint": False},
96	        "delete_lead": {"destructiveHint": True, "confirmationRequiredHint": True},
97	        "delete_lead_list": {"destructiveHint": True, "confirmationRequiredHint": True},
98	        "move_leads_to_campaign_or_list": {"destructiveHint": False},
