32	def _import_modules_from_path(module_path: Path, package_prefix: str, module_type: str):
33	    """Helper function to import all modules from a given path.
34	    
35	    Args:
36	        module_path: Path to the directory containing modules
37	        package_prefix: Package prefix for module names (e.g., "app.services.search.tools")
38	        module_type: Type of module for error messages (e.g., "tool", "prompt")
39	    """
40	    if not module_path.is_dir():
41	        return
42	    
43	    # First, import the package itself to trigger the __init__.py
44	    importlib.import_module(package_prefix)
45	    
46	    # Then, iterate over any other modules that might not be in __init__.py
47	    for _, module_name, _ in pkgutil.iter_modules([str(module_path)], f"{package_prefix}."):
48	        try:
49	            importlib.import_module(module_name)
50	        except ImportError as e:
51	            print(f"Warning: Could not import {module_type} module '{module_name}': {e}", file=sys.stderr)
52	
53	
54	def _load_tools_and_prompts(service_path: Path, service_name: str):
55	    """Load tools and prompts from a service directory.
56	    
57	    Args:
58	        service_path: Path to the service directory
59	        service_name: Fully qualified service name (e.g., "app.services.search")
60	    """
61	    # Discover and import tools
62	    tools_path = service_path / "tools"
63	    _import_modules_from_path(tools_path, f"{service_name}.tools", "tool")
64	    
65	    # Discover and import prompts
66	    prompts_path = service_path / "prompts"
67	    _import_modules_from_path(prompts_path, f"{service_name}.prompts", "prompt")
68	
69	
70	def discover_and_import_services(package):
71	    """Dynamically imports all tool and prompt modules to trigger registration decorators."""
72	    for _, service_name, _ in pkgutil.iter_modules(package.__path__, package.__name__ + "."):
73	        service_module = importlib.import_module(service_name)
74	        service_path = Path(service_module.__file__).parent
75	        
76	        # Special handling for 'internal' directory - recursively discover nested services
77	        if service_name.endswith('.internal'):
78	            for _, nested_service_name, _ in pkgutil.iter_modules([str(service_path)], f"{service_name}."):
79	                nested_service_module = importlib.import_module(nested_service_name)
80	                nested_service_path = Path(nested_service_module.__file__).parent
81	                _load_tools_and_prompts(nested_service_path, nested_service_name)
82	        else:
83	            # Regular service discovery
84	            _load_tools_and_prompts(service_path, service_name)
85	
86	
87	def create_server() -> FastMCP:
88	    """Creates and configures the MCP server."""
89	    print("Discovering services...", file=sys.stderr)
90	    discover_and_import_services(app.services)
91	    
92	    # Import system-level prompts (not in service subdirectories)
93	    system_prompts_loaded = False
94	    try:
95	        importlib.import_module("app.services.system_prompts")
96	        system_prompts_loaded = True
97	    except ImportError as e:
98	        print(f"Warning: Could not import system prompts: {e}", file=sys.stderr)
99	
100	    mcp = FastMCP("WXDI MCP Server", version="1.0.0")
101	
102	    # Add middleware for enhanced error messages
103	    mcp.add_middleware(ValidationErrorHandlingMiddleware())
104	
105	    # Register tools first to get the actual count
106	    service_registry.register_all(mcp)
107	    actual_registered_count = service_registry.get_registered_count()
108	
109	    print(f"Registering {actual_registered_count} discovered tools...", file=sys.stderr)
110	    print("✅ Tool registration complete.", file=sys.stderr)
111	
112	    # Register prompts
113	    prompt_registry.register_all(mcp)
114	    actual_prompt_count = prompt_registry.get_registered_count()
115	    
116	    if actual_prompt_count > 0:
117	        if system_prompts_loaded:
118	            print("✅ System prompts loaded.", file=sys.stderr)
119	        print(f"Registering {actual_prompt_count} discovered prompts...", file=sys.stderr)
120	        print("✅ Prompt registration complete.", file=sys.stderr)
121	
122	    return mcp
