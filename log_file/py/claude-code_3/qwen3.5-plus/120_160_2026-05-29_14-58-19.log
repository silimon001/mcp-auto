1	"""Modular Unraid MCP Server.
2	
3	This is the main server implementation using the modular architecture with
4	separate modules for configuration, core functionality, subscriptions, and tools.
5	"""
6	
7	import os
8	import secrets
9	import sys
10	from typing import Literal, cast
11	
12	from dotenv import set_key
13	from fastmcp import FastMCP
14	from fastmcp.server.middleware.error_handling import ErrorHandlingMiddleware
15	from fastmcp.server.middleware.logging import LoggingMiddleware
16	from fastmcp.server.middleware.rate_limiting import SlidingWindowRateLimitingMiddleware
17	from fastmcp.server.middleware.response_limiting import ResponseLimitingMiddleware
18	from starlette.middleware import Middleware as ASGIMiddleware
19	
20	from .config import settings as _settings
21	from .config.logging import log_configuration_status, logger
22	from .config.settings import (
23	    CREDENTIALS_DIR,
24	    CREDENTIALS_ENV_PATH,
25	    LOG_LEVEL_STR,
26	    UNRAID_MCP_HOST,
27	    UNRAID_MCP_PORT,
28	    UNRAID_VERIFY_SSL,
29	    VERSION,
30	    apply_bearer_token,
31	    validate_required_config,
32	)
33	from .core import middleware_refs as _middleware_refs
34	from .core.auth import BearerAuthMiddleware, HealthMiddleware, WellKnownMiddleware
35	from .subscriptions.diagnostics import register_diagnostic_tools
36	from .subscriptions.resources import register_subscription_resources
37	from .tools.unraid import register_unraid_tool
38	
39	
40	def _chmod_safe(path: object, mode: int, *, strict: bool = False) -> None:
41	    """Best-effort chmod, with optional fail-closed behavior for secrets."""
42	    try:
43	        path.chmod(mode)  # type: ignore[union-attr]
44	    except PermissionError as exc:
45	        if strict:
46	            raise RuntimeError(f"Failed to secure permissions on {path}") from exc
47	        logger.debug("Could not chmod %s (volume mount?) — skipping", path)
48	
49	
50	# Middleware chain order matters — each layer wraps everything inside it:
51	#   logging → error_handling → rate_limiter → response_limiter → tool
52	
53	# 1. Log every tools/call and resources/read: method, duration, errors.
54	#    Outermost so it captures errors after they've been converted by error_handling.
55	_logging_middleware = LoggingMiddleware(
56	    logger=logger,
57	    methods=["tools/call", "resources/read"],
58	)
59	
60	# 2. Catch any unhandled exceptions and convert to proper MCP errors.
61	#    Tracks error_counts per (exception_type:method) for health diagnose.
62	_error_middleware = ErrorHandlingMiddleware(
63	    logger=logger,
64	    include_traceback=LOG_LEVEL_STR == "DEBUG",
65	)
66	# Expose via neutral module to break the circular import between server.py
67	# (which imports tools/unraid.py) and health/diagnose (which needs error stats).
68	# tools/unraid.py imports middleware_refs, not server, avoiding the cycle.
69	_middleware_refs.error_middleware = _error_middleware
70	
71	# 3. Rate limiting: 540 requests per 60-second sliding window.
72	#    SlidingWindowRateLimitingMiddleware only supports window_minutes (int), so the
73	#    upstream Unraid "100 req/10 s" burst limit cannot be enforced exactly here.
74	#    540 req/min is a conservative 1-minute equivalent that prevents sustained
75	#    overload while staying well under the 600 req/min ceiling.
76	#    Note: this does NOT cap bursts within a 10 s window; a client can still send
77	#    up to 540 requests in the first 10 s of a window. Add a sub-minute rate limiter
78	#    in front of this server (e.g. nginx limit_req) if tighter burst control is needed.
79	_rate_limiter = SlidingWindowRateLimitingMiddleware(max_requests=540, window_minutes=1)
80	
81	# 4. Cap tool responses at 512 KB to protect the client context window.
82	#    Oversized responses are truncated with a clear suffix rather than erroring.
83	_response_limiter = ResponseLimitingMiddleware(max_size=512_000)
84	
85	# Note: ResponseCachingMiddleware was removed because all caching was disabled for
86	# the `unraid` tool. The consolidated tool mixes reads and mutations under one name,
87	# making per-subaction cache exclusion impossible. A fully disabled middleware
88	# adds overhead with no benefit. Caching can be re-added if/when the tool is split
89	# into separate read/write tools.
90	
91	
92	# Initialize FastMCP instance — ASGI-level bearer auth added at run time via
93	# mcp.run(middleware=[...]) so it fires before any MCP protocol processing.
94	mcp = FastMCP(
95	    name="Unraid MCP Server",
96	    instructions="Provides tools to interact with an Unraid server's GraphQL API.",
97	    version=VERSION,
98	    middleware=[
99	        _logging_middleware,
100	        _error_middleware,
101	        _rate_limiter,
102	        _response_limiter,
103	    ],
104	)
105	
106	# Note: SubscriptionManager singleton is defined in subscriptions/manager.py
107	# and imported by resources.py - no duplicate instance needed here
108	
109	# Register all modules at import time so `fastmcp run server.py --reload` can
110	# discover the fully-configured `mcp` object without going through run_server().
111	# run_server() no longer calls this — tools are registered exactly once here.
112	
113	
114	def register_all_modules() -> None:
115	    """Register all tools and resources with the MCP instance."""
116	    try:
117	        # Register subscription resources and diagnostic tools
118	        register_subscription_resources(mcp)
119	        register_diagnostic_tools(mcp)
120	        logger.info("Subscription resources and diagnostic tools registered")
121	
122	        # Register the consolidated unraid tool
123	        register_unraid_tool(mcp)
124	        logger.info("unraid tool registered successfully - Server ready!")
125	
126	    except Exception as e:
127	        logger.error(f"Failed to register modules: {e}", exc_info=True)
128	        raise
129	
130	
131	register_all_modules()
132	
133	
134	def ensure_token_exists() -> None:
135	    """Auto-generate a bearer token on first HTTP startup if none is configured.
136	
137	    Writes the token to ``~/.unraid-mcp/.env`` via ``dotenv.set_key`` (in-place,
138	    preserves existing comments and key order), then applies it to the module
139	    global via ``apply_bearer_token()`` and removes it from ``os.environ`` so it
140	    is no longer readable by subprocess spawns.
141	
142	    No-op when:
143	    - ``UNRAID_MCP_BEARER_TOKEN`` is already set (token was loaded at startup).
144	    - ``UNRAID_MCP_DISABLE_HTTP_AUTH=true`` (gateway-delegated auth).
145	    """
146	    if _settings.UNRAID_MCP_BEARER_TOKEN or _settings.UNRAID_MCP_DISABLE_HTTP_AUTH:
147	        return
148	
149	    token = secrets.token_urlsafe(32)
150	
151	    # Ensure credentials dir exists with restricted permissions.
152	    CREDENTIALS_DIR.mkdir(parents=True, exist_ok=True)
153	    _chmod_safe(CREDENTIALS_DIR, 0o700, strict=True)
154	
155	    # Touch the file and restrict permissions BEFORE writing the token.
156	    # This closes the window where the file has default umask permissions.
157	    if not CREDENTIALS_ENV_PATH.exists():
158	        CREDENTIALS_ENV_PATH.touch(mode=0o600)
159	    _chmod_safe(CREDENTIALS_ENV_PATH, 0o600, strict=True)
160	
161	    # In-place .env write — preserves comments and existing keys.
162	    # File is already 0o600 so the token is never world-readable.
163	    set_key(str(CREDENTIALS_ENV_PATH), "UNRAID_MCP_BEARER_TOKEN", token, quote_mode="auto")
164	
165	    print(
166	        f"\n[unraid-mcp] Generated HTTP bearer token and saved it to {CREDENTIALS_ENV_PATH}.\n"
167	        "Configure your MCP client to send Authorization: Bearer <token> using that stored value.\n",
168	        file=sys.stderr,
169	        flush=True,
170	    )
171	
172	    # Store in module global; pop from os.environ so subprocesses cannot inherit it
173	    apply_bearer_token(token)
174	    os.environ.pop("UNRAID_MCP_BEARER_TOKEN", None)
175	
176	    logger.info("Bearer token generated and written to %s", CREDENTIALS_ENV_PATH)
177	
178	
179	def run_server() -> None:
180	    """Run the MCP server with the configured transport."""
181	    is_http = _settings.UNRAID_MCP_TRANSPORT in ("streamable-http", "sse")
182	
183	    try:
184	        if is_http:
185	            ensure_token_exists()
186	
187	        if (
188	            is_http
189	            and not _settings.UNRAID_MCP_DISABLE_HTTP_AUTH
190	            and not _settings.UNRAID_MCP_BEARER_TOKEN
191	        ):
192	            print(
193	                "FATAL: HTTP transport requires a bearer token. "
194	                "Set UNRAID_MCP_BEARER_TOKEN in ~/.unraid-mcp/.env or restart to auto-generate.",
195	                file=sys.stderr,
196	            )
197	            sys.exit(1)
198	
199	        is_valid, missing = validate_required_config()
200	        if not is_valid:
201	            logger.warning(
202	                "Missing configuration: %s. "
203	                "Server will prompt for credentials on first tool call via elicitation.",
204	                ", ".join(missing),
205	            )
206	
207	        log_configuration_status(logger)
208	
209	        if UNRAID_VERIFY_SSL is False:
210	            logger.warning(
211	                "SSL VERIFICATION DISABLED (UNRAID_VERIFY_SSL=false). "
212	                "Connections to Unraid API are vulnerable to man-in-the-middle attacks. "
213	                "Only use this in trusted networks or for development."
214	            )
215	
216	        if is_http:
217	            if _settings.UNRAID_MCP_DISABLE_HTTP_AUTH:
218	                logger.warning(
219	                    "HTTP auth disabled (UNRAID_MCP_DISABLE_HTTP_AUTH=true). "
220	                    "Ensure an upstream gateway enforces authentication."
221	                )
222	            else:
223	                logger.info("HTTP bearer token authentication enabled.")
224	
225	        if is_http:
226	            logger.info(
227	                "Starting Unraid MCP Server on %s:%s using %s transport...",
228	                UNRAID_MCP_HOST,
229	                UNRAID_MCP_PORT,
230	                _settings.UNRAID_MCP_TRANSPORT,
231	            )
232	        else:
233	            logger.info("Starting Unraid MCP Server using stdio transport...")
234	
235	        if is_http:
236	            if _settings.UNRAID_MCP_TRANSPORT == "sse":
237	                logger.warning(
238	                    "SSE transport is deprecated. Consider switching to 'streamable-http'."
239	                )
240	            # ASGI-level bearer auth wraps the entire HTTP stack — fires before any
241	            # MCP protocol processing and before the MCP-level middleware chain.
242	            transport_literal = cast(
243	                "Literal['stdio', 'http', 'sse', 'streamable-http']",
244	                _settings.UNRAID_MCP_TRANSPORT,
245	            )
246	            mcp.run(
247	                transport=transport_literal,
248	                host=UNRAID_MCP_HOST,
249	                port=UNRAID_MCP_PORT,
250	                path="/mcp",
251	                middleware=[
252	                    # Middleware order (outermost → innermost):
253	                    # 1. HealthMiddleware   — GET /health → 200, no auth.
254	                    # 2. WellKnownMiddleware — GET /.well-known/oauth-protected-resource → 200,
255	                    #    no auth.  MCP clients probe this after a 401 to discover how to
256	                    #    authenticate; responding correctly stops the 401 cascade.
257	                    # 3. BearerAuthMiddleware — all other HTTP requests require a valid token.
258	                    ASGIMiddleware(HealthMiddleware),  # type: ignore
259	                    ASGIMiddleware(WellKnownMiddleware),  # type: ignore
260	                    ASGIMiddleware(
261	                        BearerAuthMiddleware,  # type: ignore
262	                        token=_settings.UNRAID_MCP_BEARER_TOKEN or "",
263	                        disabled=_settings.UNRAID_MCP_DISABLE_HTTP_AUTH,
264	                    ),
265	                ],
266	            )
267	        elif _settings.UNRAID_MCP_TRANSPORT == "stdio":
268	            mcp.run()
269	        else:
270	            logger.error(
271	                f"Unsupported MCP_TRANSPORT: {_settings.UNRAID_MCP_TRANSPORT}. "
272	                "Choose 'streamable-http', 'sse', or 'stdio'."
273	            )
274	            sys.exit(1)
275	    except Exception as e:
276	        logger.critical("Unraid MCP server crashed: %s", e, exc_info=True)
277	        sys.exit(1)
278	    finally:
279	        logger.info("Unraid MCP server stopped")
280	
281	
282	if __name__ == "__main__":
283	    run_server()
284	

