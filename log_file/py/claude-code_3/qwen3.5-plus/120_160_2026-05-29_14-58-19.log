670	async def set_keyframe(
671	    object_name: str, property_name: str, value: Any, frame: int, ctx: Context
672	) -> str:
673	    """
674	    Set a keyframe for an object property.
675	
676	    Args:
677	        object_name: Name of the object
678	        property_name: Name of the property to keyframe (e.g., 'position.x')
679	        value: Value to set at the keyframe
680	        frame: Frame number to set the keyframe at
681	    """
682	    async with c4d_connection_context() as connection:
683	        if not connection.connected:
684	            return "❌ Not connected to Cinema 4D"
685	
686	        # Send command to Cinema 4D
687	        response = send_to_c4d(
688	            connection,
689	            {
690	                "command": "set_keyframe",
691	                "object_name": object_name,
