49	    "together": Together,
50	    "litellm": LiteLLM,
51	    "vercel": v0,
52	    "v0": v0,
53	    "aws": AwsBedrock,
54	    "bedrock": AwsBedrock,
55	    "azure": AzureAIFoundry,
56	    "cerebras": Cerebras,
57	    "meta": Llama,
58	    "deepinfra": DeepInfra,
59	    "ibm": WatsonX,
60	    "watsonx": WatsonX,
61	}
62	
63	
64	@mcp.tool()
65	async def outsource_text(provider: str, model: str, prompt: str) -> str:
66	    """
67	    Delegate text generation to another AI model. Use this when you need capabilities
68	    or perspectives from a different model than yourself.
69	
70	    Args:
71	        provider: The AI provider to use (e.g., "openai", "anthropic", "google", "groq")
72	        model: The specific model identifier (e.g., "gpt-4o", "claude-3-5-sonnet-20241022", "gemini-2.0-flash-exp")
73	        prompt: The instruction or query to send to the external model
74	
75	    Returns:
76	        The text response from the external model, or an error message if the request fails
77	
78	    Example usage:
79	        To get a different perspective: provider="anthropic", model="claude-3-5-sonnet-20241022", prompt="Analyze this problem from a different angle..."
80	        To leverage specialized models: provider="deepseek", model="deepseek-coder", prompt="Write optimized Python code for..."
81	    """
82	    try:
83	        # Get the appropriate model class based on provider
84	        provider_lower = provider.lower()
85	
86	        if provider_lower not in PROVIDER_MODEL_MAP:
87	            raise ValueError(f"Unknown provider: {provider}")
88	
89	        model_class = PROVIDER_MODEL_MAP[provider_lower]
90	
91	        # Create the agent
92	        agent = Agent(
93	            model=model_class(id=model),
94	            name="Text Generation Agent",
95	            instructions="You are a helpful AI assistant. Respond to the user's prompt directly and concisely.",
96	        )
97	
98	        # Run the agent and get response
99	        response = await agent.arun(prompt)
100	
101	        # Extract the text content from the response
102	        if hasattr(response, "content"):
103	            return response.content
104	        else:
105	            return str(response)
106	
107	    except Exception as e:
108	        return f"Error generating text: {str(e)}"
109	
110	
111	@mcp.tool()
112	async def outsource_image(provider: str, model: str, prompt: str) -> str:
113	    """
114	    Delegate image generation to an external AI model. Use this when you need to create
115	    visual content.
116	
117	    Args:
118	        provider: The AI provider to use (currently only "openai" is supported)
119	        model: The image model to use ("dall-e-3" for high quality, "dall-e-2" for faster/cheaper)
120	        prompt: A detailed description of the image you want to generate
121	
122	    Returns:
123	        The URL of the generated image, which can be shared with users or used in responses
124	
125	    Example usage:
126	        For high-quality images: provider="openai", model="dall-e-3", prompt="A photorealistic rendering of..."
127	        For quick concepts: provider="openai", model="dall-e-2", prompt="A simple sketch showing..."
128	
129	    Note: Only OpenAI currently supports image generation. Other providers will return an error.
130	    """
131	    try:
132	        provider_lower = provider.lower()
133	
134	        # Currently only OpenAI supports image generation through our integration
135	        if provider_lower == "openai":
136	            if model in ["dall-e-3", "dall-e-2"]:
137	                import openai
138	
139	                # Use OpenAI directly for more control
140	                client = openai.AsyncOpenAI()
141	
142	                # Generate image with appropriate parameters for each model
143	                try:
144	                    if model == "dall-e-3":
145	                        response = await client.images.generate(
146	                            model=model,
147	                            prompt=prompt,
148	                            n=1,
149	                            size="1024x1024",
150	                            response_format="url"
151	                        )
152	                    else:  # dall-e-2
153	                        response = await client.images.generate(
154	                            model=model,
155	                            prompt=prompt,
156	                            n=1,
157	                            size="512x512",
158	                            response_format="url"
159	                        )
160	
161	                    # Get the image URL
162	                    image_url = response.data[0].url
163	                    return image_url
164	
165	                except openai.OpenAIError as e:
166	                    return f"Error: OpenAI API error - {str(e)}"
167	
168	            else:
169	                return f"Error: Model '{model}' is not a supported OpenAI image generation model. Supported models: dall-e-3, dall-e-2"
170	        else:
171	            return f"Error: Provider '{provider}' does not support image generation through this tool. Currently only 'openai' is supported."
172	
173	    except Exception as e:
174	        return f"Error generating image: {str(e)}"
175	
176	
177	def main():
178	    """Entry point for the MCP server."""
179	    # Run the server
180	    mcp.run(transport='stdio')
181	
182	
183	if __name__ == "__main__":
184	    main()
