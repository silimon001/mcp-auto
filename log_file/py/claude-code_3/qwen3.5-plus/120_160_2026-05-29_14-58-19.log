382	    async def list_tables(self) -> List[Dict[str, Any]]:
383	        """List all tables in the database"""
384	        try:
385	            if self.database_type == "mongodb":
386	                collections = await self.mongo_database.list_collection_names()
387	                tables: List[Dict[str, Any]] = []
388	                for name in sorted(collections):
389	                    count = 0
390	                    try:
391	                        count = await self.mongo_database[name].count_documents({})
392	                    except Exception:
393	                        count = 0
394	                    tables.append({"table_name": name, "column_count": count})
395	                return tables
396	
397	            async with self.engine.begin() as conn:
398	                if self.database_type == "postgresql":
399	                    query = text("""
400	                        SELECT 
401	                            table_name,
402	                            (SELECT COUNT(*) FROM information_schema.columns 
403	                             WHERE table_schema = t.table_schema 
404	                             AND table_name = t.table_name) as column_count
405	                        FROM information_schema.tables t
406	                        WHERE table_schema = 'public'
407	                        AND table_type = 'BASE TABLE'
408	                        ORDER BY table_name
409	                    """)
410	                elif self.database_type == "sqlite":
411	                    query = text("""
412	                        SELECT 
413	                            name as table_name,
414	                            0 as column_count
415	                        FROM sqlite_master 
416	                        WHERE type='table' 
417	                        AND name NOT LIKE 'sqlite_%'
418	                        ORDER BY name
419	                    """)
420	                else:  # MySQL
421	                    query = text("""
422	                        SELECT 
423	                            table_name,
424	                            (SELECT COUNT(*) FROM information_schema.columns 
425	                             WHERE table_schema = t.table_schema 
426	                             AND table_name = t.table_name) as column_count
427	                        FROM information_schema.tables t
428	                        WHERE table_schema = DATABASE()
429	                        AND table_type = 'BASE TABLE'
430	                        ORDER BY table_name
431	                    """)
432	                
433	                result = await conn.execute(query)
434	                tables = []
435	                for row in result:
436	                    # Use index-based access instead of attribute access for compatibility
437	                    table_info = {
438	                        "table_name": row[0],  # First column is table_name
439	                        "column_count": row[1] if len(row) > 1 else 0  # Second column is column_count
440	                    }
441	                    
442	                    # For SQLite, get actual column count
443	                    if self.database_type == "sqlite":
444	                        col_query = text(f"PRAGMA table_info({row[0]})")
445	                        col_result = await conn.execute(col_query)
446	                        table_info["column_count"] = len(list(col_result))
447	                    
448	                    tables.append(table_info)
449	                
450	                return tables
451	        except Exception as e:
452	            logger.error(f"Error listing tables: {e}")
453	            raise
