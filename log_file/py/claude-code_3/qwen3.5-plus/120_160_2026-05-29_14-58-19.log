453	def build_home_directory(homes: List[Dict[str, Any]], devices: List[Dict[str, Any]]) -> Dict[str, Any]:
454	    normalized_homes = [normalize_home(home) for home in homes]
455	    normalized_devices = [normalize_device_summary(device) for device in devices]
456	    home_rows = []
457	
458	    for home in normalized_homes:
459	        rooms = []
460	        for room_info in home.get("rooms", []):
461	            room_devices = [
462	                device for device in normalized_devices
463	                if str(device.get("home_id", "")) == str(home.get("home_id", ""))
464	                and str(device.get("room_name", "") or "") == str(room_info.get("name", "") or "")
465	            ]
466	            rooms.append(
467	                {
468	                    "room_id": room_info.get("room_id"),
469	                    "name": room_info.get("name"),
470	                    "device_count": len(room_devices),
471	                }
472	            )
473	
474	        home_devices = [
475	            device for device in normalized_devices
476	            if str(device.get("home_id", "")) == str(home.get("home_id", ""))
477	        ]
478	        home_rows.append(
479	            {
480	                "home_id": home.get("home_id"),
481	                "name": home.get("name"),
482	                "room_count": len(rooms),
483	                "device_count": len(home_devices),
484	                "rooms": rooms,
485	            }
486	        )
487	
488	    return {
489	        "homes": home_rows,
490	        "home_count": len(home_rows),
491	        "assistant_summary": (
492	            f"已整理 {len(home_rows)} 个家庭的房间目录。"
493	            "如果客户端暂时没有走到 get_home_overview，这个结果也足够先做房间级浏览和筛选。"
494	        ),
495	        "next_steps": {
496	            "overview_with": "get_home_overview",
497	            "list_devices_with": "list_devices",
498	            "inspect_device_with": "get_device_status",
499	        },
500	    }
