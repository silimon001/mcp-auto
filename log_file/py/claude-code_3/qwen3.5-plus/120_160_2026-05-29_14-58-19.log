1148	@mcp.tool(name="prepare_login")
1149	async def prepare_login(force_reauth: bool = False, reopen_qr: bool = True) -> ServiceStatusToolResult:
1150	    """Prepare QR login artifacts and optionally force a fresh QR login flow."""
1151	    adapter = get_adapter()
1152	    if not adapter:
1153	        return build_result(False, "Adapter not initialized")
1154	
1155	    try:
1156	        action = "status_only"
1157	        if force_reauth:
1158	            adapter.clear_auth_data()
1159	            await adapter.disconnect()
1160	            connected = await adapter.connect()
1161	            action = "force_reauth"
1162	            if reopen_qr:
1163	                adapter.open_qr_artifacts()
1164	            return build_result(
1165	                connected,
1166	                "Forced QR login flow prepared" if connected else "QR login flow started but connection is not ready yet",
1167	                action=action,
1168	                **build_service_status_payload(adapter),
1169	            )
1170	
1171	        qr_status = adapter.get_qr_status()
1172	        reopened = False
1173	        if reopen_qr and (qr_status.get("page_exists") or qr_status.get("image_exists")):
1174	            reopened = adapter.open_qr_artifacts()
1175	            action = "reopen_qr" if reopened else "status_only"
1176	
1177	        return build_result(
1178	            True,
1179	            "Login artifacts are ready" if reopened else "Loaded current login status",
1180	            action=action,
1181	            **build_service_status_payload(adapter),
1182	        )
1183	    except Exception as exc:
1184	        logger.error(f"Failed to prepare login: {exc}")
1185	        return build_error_result(exc)
