186	def extract_api_key_from_request(ctx: Context) -> str | None:
187	    """
188	    Extract API key from request context for multi-tenant HTTP mode.
189	    
190	    Checks headers in order:
191	    1. x-instantly-api-key
192	    2. Authorization: Bearer <key>
193	    """
194	    if not ctx or not hasattr(ctx, "request"):
195	        return None
196	    
197	    request = ctx.request
198	    if not request or not hasattr(request, "headers"):
199	        return None
200	    
201	    headers = request.headers
202	    
203	    # Check custom header first
204	    api_key = headers.get("x-instantly-api-key")
205	    if api_key:
206	        return api_key
207	    
208	    # Check Authorization header
209	    auth_header = headers.get("authorization", "")
210	    if auth_header.lower().startswith("bearer "):
211	        return auth_header[7:]
212	    
213	    return None
214	
215	
216	def main():
217	    """Main entry point for the Instantly MCP server."""
218	    import argparse
219	    
220	    parser = argparse.ArgumentParser(description="Instantly MCP Server")
221	    parser.add_argument(
222	        "--transport",
223	        choices=["stdio", "http"],
224	        default="stdio",
225	        help="Transport mode (default: stdio)",
226	    )
227	    parser.add_argument(
228	        "--host",
229	        default=os.environ.get("HOST", "0.0.0.0"),
230	        help="HTTP host (default: 0.0.0.0)",
231	    )
232	    parser.add_argument(
233	        "--port",
234	        type=int,
235	        default=int(os.environ.get("PORT", "8000")),
236	        help="HTTP port (default: 8000)",
237	    )
238	    parser.add_argument(
239	        "--api-key",
240	        help="Instantly API key (overrides INSTANTLY_API_KEY env var)",
241	    )
242	    
243	    args = parser.parse_args()
244	    
245	    # Set API key if provided
246	    if args.api_key:
247	        set_api_key(args.api_key)
248	    
249	    # Log startup info
250	    client = get_client()
251	    print(f"[Instantly MCP] 🚀 Starting server v{SERVER_VERSION}", file=sys.stderr)
252	    print(f"[Instantly MCP] 🔑 API key: {'✅ Configured' if client.has_api_key else '❌ Not set (multi-tenant mode)'}", file=sys.stderr)
253	    print(f"[Instantly MCP] 🚌 Transport: {args.transport}", file=sys.stderr)
254	    
255	    if args.transport == "http":
256	        print(f"[Instantly MCP] 🌐 HTTP endpoints:", file=sys.stderr)
257	        print(f"[Instantly MCP]    - http://{args.host}:{args.port}/mcp", file=sys.stderr)
258	        print(f"[Instantly MCP]    - http://{args.host}:{args.port}/mcp/YOUR_API_KEY", file=sys.stderr)
259	        if not client.has_api_key:
260	            print(f"[Instantly MCP] ⚠️  Multi-tenant mode: Provide API key via URL or headers", file=sys.stderr)
261	        
262	        # Use custom HTTP app with URL-based auth support
263	        from .http_app import run_http_server
264	        run_http_server(mcp, host=args.host, port=args.port)
265	    else:
266	        if not client.has_api_key:
267	            print("[Instantly MCP] ❌ API key required for stdio mode", file=sys.stderr)
268	            print("[Instantly MCP] Set INSTANTLY_API_KEY env var or use --api-key", file=sys.stderr)
269	            sys.exit(1)
270	        mcp.run(transport="stdio")
271	
272	
273	if __name__ == "__main__":
274	    main()
