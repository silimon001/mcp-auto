105	💡 Tried paths:
106	   • {input_file} (as provided)
107	   • {cwd / input_file} (from current directory)
108	   • {script_dir / input_file} (from script directory)
109	💡 Try using absolute path or ensure file is in one of these directories"""
110	        return input_path, error_msg
111	    
112	    if not input_path.suffix.lower() == '.pptx':
113	        return input_path, f"❌ Error: File must be a PowerPoint (.pptx) file: {input_file}"
