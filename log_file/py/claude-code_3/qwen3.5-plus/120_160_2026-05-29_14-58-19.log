354	def build_enabled_operations(profile: Dict[str, Any]) -> List[Dict[str, Any]]:
355	    return [
356	        {
357	            "operation": item["operation"],
358	            "preferred_tool": item["preferred_tool"],
359	        }
360	        for item in profile.get("supported_operations", [])
361	        if item.get("enabled")
362	    ]
