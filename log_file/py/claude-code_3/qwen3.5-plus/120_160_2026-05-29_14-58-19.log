1	"""Servers."""
2	
3	import functools
4	import io
5	from pathlib import Path
6	from typing import NamedTuple
7	
8	import pandas as pd
9	import requests
10	
11	
12	class Server(NamedTuple):
13	    """Container for the server short description and URL."""
14	
15	    description: str
16	    url: str
17	
18	
19	@functools.lru_cache(maxsize=128)
20	def servers_list() -> dict:
21	    """Download a new server list from awesome-erddap.
22	
23	    First we try to load the latest list from GitHub.
24	    If that fails we fall back to the default one shipped with the package.
25	
26	    """
27	    try:
28	        url = "https://raw.githubusercontent.com/IrishMarineInstitute/awesome-erddap/master/erddaps.json"
29	        r = requests.get(url, timeout=10)
30	        df_servers = pd.read_json(io.StringIO(r.text))
31	    except requests.HTTPError:
32	        path = Path(__file__).absolute().parent
33	        df_servers = pd.read_json(path.joinpath("erddaps.json"))
34	    # Drop non-public servers.
35	    df_servers = df_servers[df_servers["public"]]
36	    return {
37	        row["short_name"].lower(): Server(row["name"], row["url"])
38	        for k, row in df_servers.iterrows()
39	        if row["short_name"]
40	    }
41	
42	
43	servers = servers_list()
