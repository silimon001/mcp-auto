729	def build_control_assistant_summary(device_name: str, operation: str, outcome: Dict[str, Any]) -> str:
730	    after_summary = outcome.get("after_summary", {})
731	    if operation == "turn_on":
732	        return f"已请求打开 {device_name}。当前状态摘要：{after_summary}"
733	    if operation == "turn_off":
734	        return f"已请求关闭 {device_name}。当前状态摘要：{after_summary}"
735	    if operation == "toggle":
736	        return f"已请求切换 {device_name}。当前状态摘要：{after_summary}"
737	    return f"已对 {device_name} 执行 {operation}。当前状态摘要：{after_summary}"
