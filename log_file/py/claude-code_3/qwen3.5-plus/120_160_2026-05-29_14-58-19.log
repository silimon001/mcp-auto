324	        
325	        # Format success message
326	        lang_name = Config.LANGUAGE_MAP.get(target_language, target_language)
327	        translation_mode = "Natural/Polished" if enable_polishing else "Literal"
328	        post_processing_status = "✅ Applied" if post_processing_applied else "⚠️ Skipped"
329	        
330	        return f"""✅ Specific slides translation completed successfully!
331	
332	📁 Input file: {input_path}
333	📁 Output file: {output_file}
334	📄 Translated slides: {sorted(set(slide_list))}
335	🌐 Target language: {target_language} ({lang_name})
336	🎨 Translation mode: {translation_mode}
