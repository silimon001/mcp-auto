21	    @mcp.tool()
22	    async def get_product_images(
23	        product_id: str,
24	        perspective: str = "front",
25	        location_id: Optional[str] = None,
26	        ctx: Context = None
27	    ) -> Image:
28	        """
29	        Get an image for a specific product from the requested perspective.
30	        
31	        Use get_product_details first to see what perspectives are available (typically "front", "back", "left", "right").
32	        
33	        Args:
34	            product_id: The unique product identifier
35	            perspective: The image perspective to retrieve (default: "front")
36	            location_id: Store location ID (uses preferred if not provided)
37	        
38	        Returns:
39	            The product image from the requested perspective
40	        """
41	        # Use preferred location if none provided
42	        if not location_id:
43	            location_id = get_preferred_location_id()
44	            if not location_id:
45	                return {
46	                    "success": False,
47	                    "error": "No location_id provided and no preferred location set. Use set_preferred_location first."
48	                }
49	        
50	        if ctx:
51	            await ctx.info(f"Fetching images for product {product_id} at location {location_id}")
52	        
53	        client = get_client_credentials_client()
54	        
55	        try:
56	            # Get product details to extract image URLs
57	            product_details = client.product.get_product(
58	                product_id=product_id,
59	                location_id=location_id
60	            )
61	            
62	            if not product_details or "data" not in product_details:
63	                return {
64	                    "success": False,
65	                    "message": f"Product {product_id} not found"
66	                }
67	            
68	            product = product_details["data"]
69	            
70	            # Check if images are available
71	            if "images" not in product or not product["images"]:
72	                return {
73	                    "success": False,
74	                    "message": f"No images available for product {product_id}"
75	                }
76	            
77	            # Find the requested perspective image
78	            perspective_image = None
79	            available_perspectives = []
80	            
81	            for img_data in product["images"]:
82	                img_perspective = img_data.get("perspective", "unknown")
83	                available_perspectives.append(img_perspective)
84	                
85	                # Skip if not the requested perspective
86	                if img_perspective != perspective:
87	                    continue
88	                    
89	                if not img_data.get("sizes"):
90	                    continue
91	                
92	                # Find the best image size (prefer large, fallback to xlarge or other available)
93	                img_url = None
94	                size_preference = ["large", "xlarge", "medium", "small", "thumbnail"]
95	                
96	                # Create a map of available sizes for quick lookup
97	                available_sizes = {size.get("size"): size.get("url") for size in img_data.get("sizes", []) if size.get("size") and size.get("url")}
98	                
99	                # Select best size based on preference order
100	                for size in size_preference:
101	                    if size in available_sizes:
102	                        img_url = available_sizes[size]
103	                        break
104	                
105	                if img_url:
106	                    try:
107	                        if ctx:
108	                            await ctx.info(f"Downloading {perspective} image from {img_url}")
109	                        
110	                        # Download image
111	                        response = requests.get(img_url)
112	                        response.raise_for_status()
113	                        
114	                        # Create Image object
115	                        perspective_image = Image(
116	                            data=response.content,
117	                            format="jpeg"  # Kroger images are typically JPEG
118	                        )
119	                        break
120	                    except Exception as e:
121	                        if ctx:
122	                            await ctx.warning(f"Failed to download {perspective} image: {str(e)}")
123	            
124	            # If the requested perspective wasn't found
125	            if not perspective_image:
126	                available_str = ", ".join(available_perspectives) if available_perspectives else "none"
127	                return {
128	                    "success": False,
129	                    "message": f"No image found for perspective '{perspective}'. Available perspectives: {available_str}"
130	                }
131	            
132	            return perspective_image
133	        
134	        except Exception as e:
135	            if ctx:
136	                await ctx.error(f"Error getting product images: {str(e)}")
137	            return {
138	                "success": False,
139	                "error": str(e)
140	            }
