225	                            "formatted_sale": format_currency(price.get("promo")),
226	                            "on_sale": price.get("promo") is not None and price.get("promo") < price.get("regular", float('inf'))
227	                        }
228	                
229	                # Add aisle information
230	                if "aisleLocations" in product:
231	                    formatted_product["aisle_locations"] = [
232	                        {
233	                            "description": aisle.get("description"),
234	                            "number": aisle.get("number"),
235	                            "side": aisle.get("side"),
236	                            "shelf_number": aisle.get("shelfNumber")
237	                        }
238	                        for aisle in product["aisleLocations"]
239	                    ]
240	                
241	                # Add image information
242	                if "images" in product and product["images"]:
243	                    formatted_product["images"] = [
244	                        {
245	                            "perspective": img.get("perspective"),
246	                            "url": img["sizes"][0].get("url") if img.get("sizes") else None,
247	                            "size": img["sizes"][0].get("size") if img.get("sizes") else None
248	                        }
249	                        for img in product["images"]
250	                        if img.get("sizes")
251	                    ]
252	                
253	                formatted_products.append(formatted_product)
254	            
255	            if ctx:
256	                await ctx.info(f"Found {len(formatted_products)} products")
257	            
258	            return {
259	                "success": True,
