16	
17	@dataclass
18	class C4DConnection:
19	    sock: Optional[socket.socket] = None
20	    connected: bool = False
21	
22	
23	# Asynchronous context manager for Cinema 4D connection
24	@asynccontextmanager
25	async def c4d_connection_context():
26	    """Asynchronous context manager for Cinema 4D connection."""
27	    connection = C4DConnection()
28	    try:
29	        # Initialize connection to Cinema 4D
30	        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
31	        sock.connect((C4D_HOST, C4D_PORT))
32	        connection.sock = sock
33	        connection.connected = True
34	        logger.info(f"✅ Connected to Cinema 4D at {C4D_HOST}:{C4D_PORT}")
35	        yield connection  # Yield the connection
36	    except Exception as e:
37	        logger.error(f"❌ Failed to connect to Cinema 4D: {str(e)}")
38	        connection.connected = False  # Ensure connection is marked as not connected
39	        yield connection  # Still yield the connection object
40	    finally:
41	        # Clean up on server shutdown
42	        if connection.sock:
43	            connection.sock.close()
44	            logger.info("🔌 Disconnected from Cinema 4D")
45	
