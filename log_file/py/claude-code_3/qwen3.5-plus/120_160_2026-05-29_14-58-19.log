780	def find_profile_control_match(query: str, profile: Dict[str, Any]) -> Dict[str, Any] | None:
781	    lowered_query = query.strip().lower()
782	    if not lowered_query:
783	        return None
784	
785	    profile_driven = profile.get("profile_driven_schema", {})
786	    writable_properties = profile_driven.get("writable_properties", [])
787	    actions = profile_driven.get("actions", [])
788	
789	    def score_match(item: Dict[str, Any]) -> int:
790	        score = 0
791	        for term in item.get("matching_terms", []):
792	            normalized_term = str(term).strip().lower()
793	            if not normalized_term:
794	                continue
795	            if normalized_term in lowered_query:
796	                score = max(score, len(normalized_term))
797	        return score
798	
799	    best_property = None
800	    best_property_score = 0
801	    for item in writable_properties:
802	        score = score_match(item)
803	        if score > best_property_score:
804	            best_property = item
805	            best_property_score = score
806	
807	    best_action = None
808	    best_action_score = 0
809	    for item in actions:
810	        score = score_match(item)
811	        if score > best_action_score:
812	            best_action = item
813	            best_action_score = score
814	
815	    if best_property_score <= 0 and best_action_score <= 0:
816	        return None
817	
818	    if best_property_score >= best_action_score and best_property:
819	        return {
820	            "kind": "property",
821	            "name": best_property.get("name"),
822	            "description": best_property.get("description"),
823	            "type": best_property.get("type"),
824	            "range": best_property.get("range"),
825	            "value_list": best_property.get("value_list"),
826	        }
827	
828	    if best_action:
829	        return {
830	            "kind": "action",
831	            "name": best_action.get("name"),
832	            "description": best_action.get("description"),
833	        }
834	    return None
835	
836	
837	async def control_device_with_profile_fallback(
838	    adapter: MijiaAdapter,
839	    query: str,
840	    device_name: str,
841	    room: str = "",
842	    home: str = "",
843	    prefer_device_type: str = "",
844	    parsed_intent: Dict[str, Any] | None = None,
845	) -> ControlToolResult:
846	    device = await resolve_device(
847	        adapter,
848	        device_name=device_name,
849	        room=room,
850	        home=home,
851	        device_type=prefer_device_type,
852	    )
853	    profile = await get_device_profile(adapter, device["device_id"])
854	    match = find_profile_control_match(query, profile)
855	    if not match:
856	        return build_result(
857	            False,
858	            f"Could not match a profile-driven control for {device['name']}",
859	            device={k: v for k, v in device.items() if k != "raw"},
860	            device_resource=profile.get("device_resource"),
861	            profile_driven_controls=profile.get("profile_driven_schema", {}),
862	            parsed_intent=parsed_intent or {},
863	        )
864	
865	    if match["kind"] == "property":
866	        value = parsed_intent.get("value") if parsed_intent else None
867	        if value is None:
868	            return build_result(
869	                False,
870	                f"Matched property {match['name']} on {device['name']} but no value was provided",
871	                device={k: v for k, v in device.items() if k != "raw"},
872	                matched_control=match,
873	                device_resource=profile.get("device_resource"),
874	                parsed_intent=parsed_intent or {},
875	            )
876	        capability_name = None
877	        for item in profile.get("profile_driven_schema", {}).get("writable_properties", []):
878	            if item.get("name") == match["name"]:
879	                if item.get("value_list"):
880	                    capability_name = "mode"
881	                break
882	        if capability_name:
883	            resolved_target = {
884	                "name": match["name"],
885	                "value_list": next(
886	                    (
887	                        item.get("value_list")
888	                        for item in profile.get("profile_driven_schema", {}).get("writable_properties", [])
889	                        if item.get("name") == match["name"]
890	                    ),
891	                    None,
892	                ),
893	                "range": next(
894	                    (
895	                        item.get("range")
896	                        for item in profile.get("profile_driven_schema", {}).get("writable_properties", [])
897	                        if item.get("name") == match["name"]
898	                    ),
899	                    None,
900	                ),
901	            }
902	            value = coerce_value_for_target(capability_name, resolved_target, value)
903	        return await control_device(
904	            "set_property",
905	            device_id=device["device_id"],
906	            value=value,
907	            property_name=match["name"],
908	        )
909	
910	    return await control_device(
911	        "run_action",
912	        device_id=device["device_id"],
913	        value=[],
914	        action_name=match["name"],
915	    )
