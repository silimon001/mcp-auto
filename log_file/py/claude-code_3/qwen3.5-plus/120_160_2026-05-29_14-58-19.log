757	def summarize_control_outcome(operation: str, before_state: Dict[str, Any], after_state: Dict[str, Any]) -> Dict[str, Any]:
758	    changed_keys = sorted(
759	        key for key in set(before_state) | set(after_state)
760	        if before_state.get(key) != after_state.get(key)
761	    )
762	    power_changed = before_state.get("power") != after_state.get("power")
763	    expected_power = None
764	    if operation == "turn_on":
765	        expected_power = True
766	    elif operation == "turn_off":
767	        expected_power = False
768	
769	    return {
770	        "changed": bool(changed_keys),
771	        "changed_keys": changed_keys,
772	        "power_changed": power_changed,
773	        "expected_power": expected_power,
774	        "power_matches_expectation": expected_power is None or after_state.get("power") == expected_power,
775	        "before_summary": build_state_summary(before_state),
776	        "after_summary": build_state_summary(after_state),
777	    }
