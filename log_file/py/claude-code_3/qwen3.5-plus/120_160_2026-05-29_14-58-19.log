25	def get_controller(controller_type=None):
26	    """
27	    Factory function to get a terminal controller based on the specified type or platform.
28	
29	    Args:
30	        controller_type: The type of controller to get ("iterm", "applescript", "subprocess")
31	                        or None to auto-detect
32	
33	    Returns:
34	        A terminal controller instance
35	    """
36	    system = platform.system()
37	
38	    # If controller type is specified, try to use it
39	    if controller_type:
40	        if controller_type == "iterm" and system == "Darwin":
41	            if ITERM_AVAILABLE:
42	                return ITermController()
43	            else:
44	                raise ImportError(
45	                    "iTerm2 API not available. Install with 'pip install iterm2'"
46	                )
47	        elif controller_type == "applescript" and system == "Darwin":
48	            return AppleScriptTerminalController()
49	        elif controller_type == "subprocess":
50	            return SubprocessTerminalController()
51	        else:
52	            raise ValueError(
53	                f"Controller type '{controller_type}' not supported on {system}"
54	            )
55	
56	    # Auto-detect the best controller
57	    if system == "Darwin":
58	        if ITERM_AVAILABLE:
59	            try:
60	                # Check if iTerm2 is installed
61	                import subprocess
62	
63	                result = subprocess.run(
64	                    [
65	                        "osascript",
66	                        "-e",
67	                        'tell application "System Events" to exists application process "iTerm2"',
68	                    ],
69	                    capture_output=True,
70	                    text=True,
71	                )
72	                if "true" in result.stdout.lower():
73	                    return ITermController()
74	            except Exception:
75	                pass
76	
77	        # Fall back to AppleScript for macOS Terminal
78	        return AppleScriptTerminalController()
79	
80	    # Default to subprocess controller for all other platforms
81	    return SubprocessTerminalController()
82	

