31	# Pydantic models for request/response
32	class QueryRequest(BaseModel):
33	    nl_query: str
34	    limit: Optional[int] = 50
35	
36	class QueryResponse(BaseModel):
37	    sql_query: str
38	    results: List[Dict[str, Any]]
