2	# =================================
3	
4	# Core API Configuration (Required)
5	# ---------------------------------
6	UNRAID_API_KEY=your_api_key
7	UNRAID_API_URL=http://your-unraid-server
8	
9	# MCP Server Settings
10	# -------------------
11	# Default transport is streamable-http (v1.2.0+).
12	# Use stdio for Claude Desktop / local process-based clients.
