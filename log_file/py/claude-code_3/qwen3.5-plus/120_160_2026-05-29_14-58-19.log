455	    async def describe_table(self, table_name: str) -> List[Dict[str, Any]]:
456	        """Get column information for a specific table"""
457	        try:
458	            if self.database_type == "mongodb":
459	                collection = self.mongo_database[table_name]
460	                sample_doc = await collection.find_one()
461	                if not sample_doc:
462	                    return [{"column_name": "_id", "data_type": "objectId", "is_nullable": False}]
463	
464	                columns = []
465	                for key, value in sample_doc.items():
466	                    columns.append(
467	                        {
468	                            "column_name": key,
469	                            "data_type": type(value).__name__,
470	                            "is_nullable": key != "_id",
471	                        }
472	                    )
473	                return columns
474	
475	            async with self.engine.begin() as conn:
476	                if self.database_type == "postgresql":
477	                    query = text("""
478	                        SELECT 
479	                            column_name,
480	                            data_type,
481	                            is_nullable
482	                        FROM information_schema.columns
483	                        WHERE table_schema = 'public'
484	                        AND table_name = :table_name
485	                        ORDER BY ordinal_position
486	                    """)
487	                elif self.database_type == "sqlite":
488	                    query = text(f"PRAGMA table_info({table_name})")
489	                    result = await conn.execute(query)
490	                    columns = []
491	                    for row in result:
492	                        columns.append({
493	                            "column_name": row[1],  # name column
494	                            "data_type": row[2],    # type column
495	                            "is_nullable": not bool(row[3])  # notnull column
496	                        })
497	                    return columns
498	                else:  # MySQL
499	                    query = text("""
500	                        SELECT 
501	                            column_name,
502	                            data_type,
503	                            is_nullable
504	                        FROM information_schema.columns
505	                        WHERE table_schema = DATABASE()
506	                        AND table_name = :table_name
507	                        ORDER BY ordinal_position
508	                    """)
509	                
510	                result = await conn.execute(query, {"table_name": table_name})
511	                # Use index-based access for compatibility with different SQLAlchemy versions
512	                return [
513	                    {
514	                        "column_name": row[0],  # column_name
515	                        "data_type": row[1],    # data_type
516	                        "is_nullable": row[2] == "YES"  # is_nullable
517	                    }
518	                    for row in result
519	                ]
520	        except Exception as e:
521	            logger.error(f"Error describing table {table_name}: {e}")
522	            raise
523	    
524	    def _is_query_safe(self, query: str) -> bool:
525	        """Check if query is safe (read-only operations only)"""
526	        # Remove comments and normalize whitespace
527	        cleaned_query = re.sub(r'--.*$', '', query, flags=re.MULTILINE)
528	        cleaned_query = re.sub(r'/\*.*?\*/', '', cleaned_query, flags=re.DOTALL)
529	        cleaned_query = ' '.join(cleaned_query.split()).upper()
530	        
531	        # Check for dangerous operations
532	        dangerous_patterns = [
533	            r'\bDROP\b', r'\bDELETE\b', r'\bINSERT\b', r'\bUPDATE\b',
534	            r'\bALTER\b', r'\bCREATE\b', r'\bTRUNCATE\b', r'\bREPLACE\b',
535	            r'\bMERGE\b', r'\bEXEC\b', r'\bEXECUTE\b', r'\bCALL\b'
536	        ]
537	        
538	        for pattern in dangerous_patterns:
539	            if re.search(pattern, cleaned_query):
540	                return False
541	        
542	        # Must start with SELECT
543	        if not re.match(r'^\s*SELECT\b', cleaned_query):
544	            return False
545	        
546	        return True
547	    
548	    async def execute_safe_query(self, query: str, limit: int = 50) -> List[Dict[str, Any]]:
549	        """Execute a query with safety checks"""
550	        # Safety checks
551	        if not self._is_query_safe(query):
552	            raise ValueError("Query contains unsafe operations. Only SELECT queries are allowed.")
553	
554	        if self.database_type == "mongodb":
555	            return await self._execute_safe_mongo_query(query, limit=limit)
556	        
557	        # Add/modify LIMIT clause
558	        query_upper = query.upper()
559	        if 'LIMIT' in query_upper:
560	            # Replace existing LIMIT with our limit
561	            query = re.sub(r'\bLIMIT\s+\d+', f'LIMIT {limit}', query, flags=re.IGNORECASE)
562	        else:
563	            # Add LIMIT clause
564	            query = f"{query.rstrip(';')} LIMIT {limit}"
565	        
566	        try:
567	            async with self.engine.begin() as conn:
568	                result = await conn.execute(text(query))
569	                
570	                # Convert rows to dictionaries
571	                rows = []
572	                for row in result:
573	                    row_dict = {}
574	                    for i, col in enumerate(result.keys()):
575	                        value = row[i]
576	                        # Handle special types that aren't JSON serializable
577	                        if hasattr(value, 'isoformat'):  # datetime objects
578	                            value = value.isoformat()
579	                        elif hasattr(value, '__str__') and not isinstance(value, (str, int, float, bool, type(None))):
580	                            value = str(value)
581	                        row_dict[col] = value
582	                    rows.append(row_dict)
583	                
584	                return rows
585	                
586	        except Exception as e:
587	            logger.error(f"Error executing query: {e}")
588	            raise
589	    
590	    async def execute_unsafe_query(self, query: str) -> List[Dict[str, Any]]:
591	        """Execute any SQL query without safety restrictions (allows CREATE, DELETE, INSERT, etc.)"""
592	        try:
593	            if self.database_type == "mongodb":
594	                return await self._execute_unsafe_mongo_query(query)
595	
596	            async with self.engine.begin() as conn:
597	                result = await conn.execute(text(query))
598	
599	                # Check if this query returns rows
600	                if result.returns_rows:
601	                    # Convert rows to dictionaries
602	                    rows = []
603	                    for row in result:
604	                        row_dict = {}
605	                        for i, col in enumerate(result.keys()):
606	                            value = row[i]
607	                            # Handle special types that aren't JSON serializable
608	                            if hasattr(value, 'isoformat'):  # datetime objects
609	                                value = value.isoformat()
610	                            elif hasattr(value, '__str__') and not isinstance(value, (str, int, float, bool, type(None))):
611	                                value = str(value)
612	                            row_dict[col] = value
613	                        rows.append(row_dict)
614	                    return rows
615	                else:
616	                    # For non-SELECT queries (INSERT, UPDATE, CREATE, DELETE, etc.)
617	                    return [{"affected_rows": result.rowcount, "status": "success", "query_type": "modification"}]
618	
619	        except Exception as e:
620	            logger.error(f"Error executing unsafe query: {e}")
621	            raise
