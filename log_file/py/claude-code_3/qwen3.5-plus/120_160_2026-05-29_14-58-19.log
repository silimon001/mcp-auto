957	async def execute_operation(
958	    adapter: MijiaAdapter,
959	    device: Dict[str, Any],
960	    device_id: str,
961	    operation: str,
962	    value: Any = None,
963	    property_name: str = "",
964	    action_name: str = "",
965	) -> Dict[str, Any]:
966	    properties = dedupe_properties(await adapter.get_device_properties(device_id))
967	    actions = dedupe_actions(await adapter.get_device_actions(device_id))
968	    capability_profile = build_device_capability_profile(device, properties, actions)
969	    controls = capability_profile["controls"]
970	    supported_operations = capability_profile["supported_operations"]
971	
972	    if operation in supported_operations and not supported_operations[operation]:
973	        raise RuntimeError(
974	            f"This {capability_profile['primary_domain']} device does not support {operation}. "
975	            f"Supported operations: {', '.join(name for name, enabled in supported_operations.items() if enabled) or 'none'}"
976	        )
977	
978	    if operation == "turn_on":
979	        target = controls.get("power")
980	        if not target or not target.get("writable"):
981	            raise RuntimeError("This device does not expose a writable power capability")
982	        await adapter.set_property_value_by_name(device_id, target["name"], True)
983	        return {"operation": operation, "target": target, "value": True, "primary_domain": capability_profile["primary_domain"]}
984	
985	    if operation == "turn_off":
986	        target = controls.get("power")
987	        if not target or not target.get("writable"):
988	            raise RuntimeError("This device does not expose a writable power capability")
989	        await adapter.set_property_value_by_name(device_id, target["name"], False)
990	        return {"operation": operation, "target": target, "value": False, "primary_domain": capability_profile["primary_domain"]}
991	
992	    if operation == "toggle":
993	        action_target = controls.get("toggle")
994	        if action_target:
995	            await adapter.call_action_by_name(device_id, action_target["name"], [])
996	            return {"operation": operation, "target": action_target, "primary_domain": capability_profile["primary_domain"]}
997	        power_target = controls.get("power")
998	        if power_target:
999	            current_value = await adapter.get_property_value_by_name(device_id, power_target["name"])
1000	            next_value = not bool(current_value)
1001	            await adapter.set_property_value_by_name(device_id, power_target["name"], next_value)
1002	            return {"operation": operation, "target": power_target, "value": next_value, "primary_domain": capability_profile["primary_domain"]}
1003	        raise RuntimeError("This device does not support toggle control")
1004	
1005	    capability_name = OPERATION_CAPABILITY_MAP.get(operation)
1006	    if capability_name:
1007	        capability_definition = get_capability_definition(capability_name)
1008	        if capability_definition["kind"] == "property" and operation.startswith("set_"):
1009	            target = controls.get(capability_name)
1010	            if not target or not target.get("writable"):
1011	                raise RuntimeError(f"This device does not support {capability_definition['label'].lower()} control")
1012	            resolved_value = coerce_value_for_target(capability_name, target, value)
1013	            if capability_definition.get("value_type") == "integer":
1014	                resolved_value = int(resolved_value)
1015	            await adapter.set_property_value_by_name(device_id, target["name"], resolved_value)
1016	            return {
1017	                "operation": operation,
1018	                "capability": capability_name,
1019	                "target": target,
1020	                "value": resolved_value,
1021	                "capability_definition": build_standard_capability_definition(capability_name, target),
1022	                "primary_domain": capability_profile["primary_domain"],
1023	            }
1024	
1025	    if operation == "set_property":
1026	        if not property_name:
1027	            raise RuntimeError("property_name is required for set_property")
1028	        await adapter.set_property_value_by_name(device_id, property_name, value)
1029	        return {"operation": operation, "target": property_name, "value": value}
1030	
1031	    if operation == "run_action":
1032	        if not action_name:
1033	            raise RuntimeError("action_name is required for run_action")
1034	        await adapter.call_action_by_name(device_id, action_name, value or [])
1035	        return {"operation": operation, "target": action_name, "value": value or []}
1036	
1037	    raise RuntimeError(f"Unsupported operation: {operation}")
1038	
