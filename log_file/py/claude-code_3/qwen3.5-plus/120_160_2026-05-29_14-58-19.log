119	    def _split_csv_quoted(self, raw: str) -> List[str]:
120	        """Split comma-separated values while preserving quoted segments."""
121	        parts: List[str] = []
122	        buf: List[str] = []
123	        quote: Optional[str] = None
124	        i = 0
125	        while i < len(raw):
126	            ch = raw[i]
127	            if quote:
128	                buf.append(ch)
129	                if ch == quote and (i == 0 or raw[i - 1] != "\\"):
130	                    quote = None
131	            else:
132	                if ch in {"'", '"'}:
133	                    quote = ch
134	                    buf.append(ch)
135	                elif ch == ",":
136	                    parts.append("".join(buf).strip())
137	                    buf = []
138	                else:
139	                    buf.append(ch)
140	            i += 1
141	        if buf:
142	            parts.append("".join(buf).strip())
143	        return [p for p in parts if p]
