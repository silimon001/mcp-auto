2	
3	# Set non-interactive mode for apt
4	ENV DEBIAN_FRONTEND=noninteractive
5	
6	# Install system dependencies and security tools
7	RUN apt-get update && apt-get install -y \
8	    python3 \
9	    python3-pip \
10	    python3-venv \
11	    git \
12	    nmap \
13	    metasploit-framework \
14	    netcat-openbsd \
15	    curl \
16	    wget \
17	    dnsutils \
18	    whois \
19	    hydra \
20	    gobuster \
21	    dirb \
22	    nikto \
23	    sqlmap \
24	    testssl.sh \
25	    amass \
26	    httpx-toolkit \
27	    subfinder \
28	    gospider \
29	    golang \
30	    smbclient \
31	    enum4linux \
32	    nfs-common \
33	    hashid \
34	    && apt-get clean \
35	    && rm -rf /var/lib/apt/lists/*
36	
37	# Install waybackurls using Go
38	RUN go install github.com/tomnomnom/waybackurls@latest && \
39	    cp /root/go/bin/waybackurls /usr/local/bin/
40	
41	# Create app directory
42	WORKDIR /app
43	COPY . /app/
44	
45	# Create and activate virtual environment
46	RUN python3 -m venv /app/venv
47	ENV PATH="/app/venv/bin:$PATH"
48	
49	# Install uv package manager
50	RUN pip install --no-cache-dir -v uv
51	
52	# Install Python dependencies
53	RUN pip install --no-cache-dir -v -r requirements.txt
54	
55	# Install development tooling used by run_tests.sh
56	RUN pip install --no-cache-dir -v \
57	    pyright \
58	    ruff \
59	    pytest \
