1	"""
2	Instantly MCP Server - Main Server
3	
4	A lightweight, robust FastMCP server for the Instantly.ai V2 API.
5	
6	Features:
7	- 38 tools across 6 categories (accounts, campaigns, leads, emails, analytics, background_jobs)
8	- Dual transport support (HTTP for remote, stdio for local)
9	- Lazy loading via TOOL_CATEGORIES environment variable
10	- Per-request API key support for multi-tenant deployments
11	- MCP 2025-06-18 annotations (readOnlyHint, destructiveHint, etc.)
12	
13	Usage:
14	  # HTTP mode (remote deployment)
15	  fastmcp run src/instantly_mcp/server.py --transport http --port 8000
16	
17	  # stdio mode (local Claude Desktop)
18	  fastmcp run src/instantly_mcp/server.py
19	
20	  # With lazy loading (reduce context window)
21	  TOOL_CATEGORIES=accounts,campaigns fastmcp run src/instantly_mcp/server.py
22	"""
23	
24	import os
25	import sys
26	from typing import Any
27	
28	from fastmcp import FastMCP
29	from fastmcp.server import Context
30	
31	from .client import get_client, set_api_key
