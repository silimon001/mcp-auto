131	                )
132	                for col in schema
133	            ]
134	        )
135	    except Exception as e:
136	        logger.error(f"Error describing table {table_name}: {e}")
137	        raise HTTPException(status_code=500, detail=f"Failed to describe table: {str(e)}")
138	
139	@app.post("/mcp/query", response_model=QueryResponse)
140	async def execute_nl_query(
141	    request: QueryRequest,
142	    db_manager: DatabaseManager = Depends(get_db_manager)
143	):
144	    """Convert natural language query to SQL and execute it"""
145	    global nl_converter
146	    
147	    if not nl_converter:
148	        raise HTTPException(status_code=503, detail="NL to SQL converter not available")
149	    
150	    try:
151	        # Get table schemas for context
152	        tables = await db_manager.list_tables()
153	        table_schemas = {}
154	        for table in tables:
155	            schema = await db_manager.describe_table(table["table_name"])
156	            table_schemas[table["table_name"]] = schema
157	        
158	        # Convert natural language to SQL
159	        sql_query = nl_converter.convert_to_sql(request.nl_query, table_schemas)
160	        
161	        # Execute the query with safety checks
162	        results = await db_manager.execute_safe_query(sql_query, limit=request.limit)
163	        
164	        return QueryResponse(
165	            sql_query=sql_query,
166	            results=results,
167	            row_count=len(results)
168	        )
169	        
170	    except Exception as e:
171	        logger.error(f"Error executing NL query '{request.nl_query}': {e}")
172	        raise HTTPException(status_code=500, detail=f"Failed to execute query: {str(e)}")
173	
