1	"""
2	Natural Language to SQL Converter
3	
4	Uses HuggingFace transformers to convert natural language queries to SQL.
5	"""
6	
7	import os
8	import logging
9	import re
10	from typing import Dict, List, Any, Optional
11	
12	try:
13	    from transformers import AutoModelForSeq2SeqLM, AutoTokenizer, pipeline
14	    HF_AVAILABLE = True
15	except (ImportError, AttributeError, RuntimeError) as e:
16	    HF_AVAILABLE = False
17	    # Mock classes for when transformers is not available
18	    class AutoModelForSeq2SeqLM:
19	        pass
20	    class AutoTokenizer:
21	        pass
22	    def pipeline(*args, **kwargs):
23	        return None
24	
25	logger = logging.getLogger(__name__)
26	
27	class NLToSQLConverter:
28	    """Converts natural language queries to SQL using HuggingFace models"""
29	    
30	    def __init__(self, model_name: str = "gaussalgo/T5-LM-Large-text2sql-spider"):
31	        self.model_name = model_name
32	        self.model = None
33	        self.tokenizer = None
34	        self.pipeline = None
35	        self._initialize_model()
36	    
37	    def _initialize_model(self):
38	        """Initialize the HuggingFace model"""
39	        if not HF_AVAILABLE:
40	            logger.warning("HuggingFace transformers not available. Using rule-based fallback.")
41	            return
42	
43	        # Default disabled to avoid model downloads in low-connectivity environments.
44	        enable_hf = os.getenv("ENABLE_HF_MODEL", "false").lower() in {"1", "true", "yes", "on"}
45	        if not enable_hf:
46	            logger.info("ENABLE_HF_MODEL is disabled. Using rule-based SQL generation.")
47	            return
48	
49	        # Default true to avoid network fetches unless explicitly allowed.
50	        local_files_only = os.getenv("HF_LOCAL_FILES_ONLY", "true").lower() in {"1", "true", "yes", "on"}
51	        cache_dir = os.getenv("HF_MODEL_CACHE_DIR") or None
52	
53	        try:
54	            self.tokenizer = AutoTokenizer.from_pretrained(
55	                self.model_name,
56	                local_files_only=local_files_only,
57	                cache_dir=cache_dir,
58	            )
59	            self.model = AutoModelForSeq2SeqLM.from_pretrained(
60	                self.model_name,
61	                local_files_only=local_files_only,
62	                cache_dir=cache_dir,
63	            )
64	            self.pipeline = pipeline(
65	                "text2text-generation",
66	                model=self.model,
67	                tokenizer=self.tokenizer,
68	            )
69	            logger.info("HuggingFace text2sql model loaded: %s", self.model_name)
70	        except Exception as e:
71	            self.model = None
72	            self.tokenizer = None
73	            self.pipeline = None
74	            logger.warning("Failed to load HuggingFace model (%s). Falling back to rule-based SQL.", e)
75	            return
76	    
77	    def _create_table_context(self, table_schemas: Dict[str, List[Dict[str, Any]]]) -> str:
78	        """Create table context string for the model"""
79	        context_parts = []
80	        
81	        for table_name, columns in table_schemas.items():
82	            column_info = []
83	            for col in columns:
84	                col_str = f"{col['column_name']} {col['data_type']}"
85	                if not col['is_nullable']:
86	                    col_str += " NOT NULL"
87	                column_info.append(col_str)
88	            
89	            context_parts.append(f"Table {table_name}: {', '.join(column_info)}")
90	        
91	        return " | ".join(context_parts)
92	    
93	    def _generate_with_pipeline(self, prompt: str) -> str:
94	        """Generate SQL using the pipeline"""
95	        try:
96	            result = self.pipeline(prompt, max_length=512, num_return_sequences=1)
97	            return result[0]['generated_text'].strip()
98	        except Exception as e:
99	            logger.error(f"Error generating with pipeline: {e}")
100	            raise
101	    
102	    def _generate_with_model(self, prompt: str) -> str:
103	        """Generate SQL using model directly"""
104	        try:
105	            inputs = self.tokenizer.encode(prompt, return_tensors="pt", max_length=512, truncation=True)
106	            
107	            with self.tokenizer.as_target_tokenizer():
108	                outputs = self.model.generate(
109	                    inputs,
110	                    max_length=150,
111	                    num_beams=4,
112	                    num_return_sequences=1,
113	                    temperature=0.7,
114	                    do_sample=False,
115	                    early_stopping=True
116	                )
117	            
118	            sql = self.tokenizer.decode(outputs[0], skip_special_tokens=True)
119	            return sql.strip()
120	        except Exception as e:
121	            logger.error(f"Error generating with model: {e}")
122	            raise
123	    
124	    def _rule_based_fallback(self, nl_query: str, table_schemas: Dict[str, List[Dict[str, Any]]]) -> str:
125	        """Rule-based fallback for SQL generation when ML model is not available"""
126	        nl_lower = nl_query.lower()
127	        
128	        # Get first table as default
129	        table_names = list(table_schemas.keys())
130	        if not table_names:
131	            raise ValueError("No tables available")
132	        
133	        default_table = table_names[0]
134	        
135	        # Simple patterns for common queries
136	        if any(word in nl_lower for word in ['all', 'everything', 'list', 'show']):
137	            if 'customers' in nl_lower or 'customer' in nl_lower:
138	                table = 'customers' if 'customers' in table_names else default_table
139	            elif 'orders' in nl_lower or 'order' in nl_lower:
140	                table = 'orders' if 'orders' in table_names else default_table
141	            else:
142	                table = default_table
143	            return f"SELECT * FROM {table}"
144	        
145	        if 'count' in nl_lower:
146	            if 'customers' in nl_lower:
147	                table = 'customers' if 'customers' in table_names else default_table
148	            elif 'orders' in nl_lower:
149	                table = 'orders' if 'orders' in table_names else default_table
150	            else:
151	                table = default_table
152	            return f"SELECT COUNT(*) as count FROM {table}"
153	        
154	        if any(word in nl_lower for word in ['top', 'first', 'limit']):
155	            # Extract number if present
156	            numbers = re.findall(r'\d+', nl_query)
157	            limit = numbers[0] if numbers else "10"
158	            
159	            if 'customers' in nl_lower:
160	                table = 'customers' if 'customers' in table_names else default_table
161	            elif 'orders' in nl_lower:
162	                table = 'orders' if 'orders' in table_names else default_table
163	            else:
164	                table = default_table
165	            
166	            return f"SELECT * FROM {table} LIMIT {limit}"
167	        
168	        # Default fallback
169	        return f"SELECT * FROM {default_table}"
170	    
171	    def convert_to_sql(self, nl_query: str, table_schemas: Dict[str, List[Dict[str, Any]]]) -> str:
172	        """Convert natural language query to SQL"""
173	        try:
174	            # Create table context
175	            table_context = self._create_table_context(table_schemas)
176	            
177	            # Try ML-based conversion first
178	            if self.pipeline or (self.model and self.tokenizer):
179	                try:
180	                    # Format prompt for the model
181	                    prompt = f"Tables: {table_context} | Question: {nl_query} | SQL:"
182	                    
183	                    if self.pipeline:
184	                        sql = self._generate_with_pipeline(prompt)
185	                    else:
186	                        sql = self._generate_with_model(prompt)
187	                    
188	                    # Clean up the generated SQL
189	                    sql = self._clean_generated_sql(sql)
190	                    
191	                    if sql and self._is_valid_sql(sql):
192	                        logger.info(f"Generated SQL: {sql}")
193	                        return sql
194	                    else:
195	                        logger.warning("Generated SQL is invalid, falling back to rule-based")
196	                        
197	                except Exception as e:
198	                    logger.error(f"ML-based conversion failed: {e}")
199	            
200	            # Fallback to rule-based approach
201	            sql = self._rule_based_fallback(nl_query, table_schemas)
202	            logger.info(f"Rule-based SQL: {sql}")
203	            return sql
204	            
205	        except Exception as e:
206	            logger.error(f"Error converting NL to SQL: {e}")
207	            raise ValueError(f"Failed to convert query to SQL: {str(e)}")
208	    
209	    def _clean_generated_sql(self, sql: str) -> str:
210	        """Clean up generated SQL"""
211	        if not sql:
212	            return ""
213	        
214	        # Remove extra whitespace
215	        sql = ' '.join(sql.split())
216	        
217	        # Remove trailing semicolon
218	        sql = sql.rstrip(';')
219	        
220	        # Ensure it starts with SELECT
221	        if not sql.upper().startswith('SELECT'):
222	            if 'SELECT' in sql.upper():
223	                # Extract the SELECT part
224	                select_pos = sql.upper().find('SELECT')
225	                sql = sql[select_pos:]
226	            else:
227	                return ""
228	        
229	        return sql
230	    
231	    def _is_valid_sql(self, sql: str) -> bool:
232	        """Basic validation of generated SQL"""
233	        if not sql:
234	            return False
235	        
236	        sql_upper = sql.upper()
237	        
238	        # Must start with SELECT
239	        if not sql_upper.startswith('SELECT'):
240	            return False
241	        
242	        # Must contain FROM
243	        if 'FROM' not in sql_upper:
244	            return False
245	        
246	        # Should not contain dangerous operations
247	        dangerous = ['DROP', 'DELETE', 'INSERT', 'UPDATE', 'ALTER', 'CREATE', 'TRUNCATE']
248	        for op in dangerous:
249	            if op in sql_upper:
250	                return False
251	        
252	        return True

