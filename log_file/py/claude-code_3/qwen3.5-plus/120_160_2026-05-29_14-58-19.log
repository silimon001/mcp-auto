195	async def resolve_home(adapter: MijiaAdapter, home_name: str = "", home_id: str = "") -> Dict[str, Any]:
196	    homes = await adapter.get_homes()
197	    normalized = [normalize_home(home) for home in homes]
198	
199	    if home_id:
200	        for home in normalized:
201	            if home["home_id"] == str(home_id):
202	                return home
203	        raise RuntimeError(f"Home with id {home_id} not found")
204	
205	    if home_name:
206	        exact = [home for home in normalized if str(home.get("name", "")).lower() == home_name.strip().lower()]
207	        if exact:
208	            if len(exact) > 1:
209	                raise RuntimeError(f"Multiple homes matched {home_name!r}")
210	            return exact[0]
211	        fuzzy = [home for home in normalized if home_name.strip().lower() in str(home.get("name", "")).lower()]
212	        if not fuzzy:
213	            raise RuntimeError(f"No home matched {home_name!r}")
214	        if len(fuzzy) > 1:
215	            raise RuntimeError(f"Multiple homes matched {home_name!r}")
216	        return fuzzy[0]
217	
218	    raise RuntimeError("Either home_id or home_name is required")
219	
