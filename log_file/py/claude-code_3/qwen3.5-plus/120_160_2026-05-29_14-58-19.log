107	
108	                response_data += chunk
109	
110	                # For long operations, log progress on data receipt
111	                elapsed = time.time() - start_time
112	                if (
113	                    command_type
114	                    in [
115	                        "render_frame",
116	                        "render_preview",
117	                        "snapshot_scene",
118	                        "apply_mograph_fields",
119	                        "execute_python",
120	                    ]
121	                    and elapsed > 5
122	                ):
123	                    logger.debug(
124	                        f"Received partial data for {command_type} ({len(response_data)} bytes, {elapsed:.1f}s elapsed)"
125	                    )
126	
127	                if b"\n" in chunk:  # Message complete when we see a newline
128	                    logger.debug(f"Received complete response for {command_type}")
129	                    break
130	
131	            except socket.timeout:
132	                logger.error(f"Socket timeout while receiving data for {command_type}")
133	                return {
134	                    "error": f"Timeout waiting for response from Cinema 4D ({timeout}s) for {command_type}"
135	                }
136	
137	        # Parse and return response
138	        if not response_data:
139	            logger.error(f"No response received from Cinema 4D for {command_type}")
140	            return {"error": f"No response received from Cinema 4D for {command_type}"}
141	
142	        response_text = response_data.decode("utf-8").strip()
143	
144	        try:
145	            return json.loads(response_text)
146	        except json.JSONDecodeError as e:
147	            # If JSON parsing fails, log the exact response for debugging
148	            logger.error(f"Failed to parse JSON response: {str(e)}")
149	            logger.error(f"Raw response (first 200 chars): {response_text[:200]}...")
150	            return {"error": f"Invalid response from Cinema 4D: {str(e)}"}
151	
152	    except socket.timeout:
153	        logger.error(f"Socket timeout during {command_type} ({timeout}s)")
154	        return {
155	            "error": f"Timeout communicating with Cinema 4D ({timeout}s) for {command_type}"
156	        }
157	    except Exception as e:
158	        logger.error(f"Communication error during {command_type}: {str(e)}")
159	        return {"error": f"Communication error: {str(e)}"}
160	
161	
162	def _fmt_vec(v):
163	    """Format a vector/list as a compact string."""
164	    if isinstance(v, (list, tuple)):
165	        return f"({', '.join(f'{x:.1f}' if isinstance(x, float) else str(x) for x in v)})"
166	    return str(v)
167	
168	
169	def _fmt_props(d, indent="  "):
170	    """Format a dict as bullet list lines."""
171	    lines = []
172	    for k, v in d.items():
173	        label = k.replace("_", " ").title()
174	        if isinstance(v, (list, tuple)) and len(v) <= 4 and all(isinstance(x, (int, float)) for x in v):
175	            lines.append(f"{indent}- **{label}**: {_fmt_vec(v)}")
176	        elif isinstance(v, dict):
177	            lines.append(f"{indent}- **{label}**:")
178	            lines.extend(_fmt_props(v, indent + "  "))
179	        else:
180	            lines.append(f"{indent}- **{label}**: {v}")
181	    return lines
182	
183	
184	def format_c4d_response(response: Dict[str, Any], command_type: str) -> str:
185	    """Format a Cinema 4D response dict as readable markdown."""
186	    if "error" in response:
187	        return f"❌ Error: {response['error']}"
188	
189	    status = response.get("status", "ok")
190	
191	    if command_type == "add_primitive":
192	        obj = response.get("object", {})
193	        name = obj.get("name", "Object")
194	        lines = [f"✅ Created **{name}**"]
195	        if "type" in obj:
196	            lines.append(f"  - **Type**: {obj['type']}")
197	        if "position" in obj:
198	            lines.append(f"  - **Position**: {_fmt_vec(obj['position'])}")
199	        if "size" in obj:
200	            lines.append(f"  - **Size**: {_fmt_vec(obj['size'])}")
201	        if "guid" in obj:
202	            lines.append(f"  - **GUID**: `{obj['guid']}`")
203	        return "\n".join(lines)
204	
205	    elif command_type == "modify_object":
206	        obj_name = response.get("object", {}).get("name", "Object")
207	        modified = response.get("modified_properties", response.get("properties", {}))
208	        lines = [f"✅ Modified **{obj_name}**"]
209	        if isinstance(modified, dict):
210	            lines.extend(_fmt_props(modified))
211	        return "\n".join(lines)
212	
213	    elif command_type == "list_objects":
214	        objects = response.get("objects", [])
215	        if not objects:
216	            return "Scene is empty — no objects found."
217	        lines = [f"📦 **Scene Objects** ({len(objects)} total)"]
218	        for obj in objects:
219	            indent = "  " * obj.get("depth", 0)
220	            lines.append(f"  {indent}- **{obj['name']}** ({obj.get('type', '?')})")
221	        return "\n".join(lines)
222	
223	    elif command_type == "create_material":
224	        mat = response.get("material", {})
225	        name = mat.get("name", "Material")
226	        lines = [f"✅ Created material **{name}**"]
227	        if "color" in mat:
228	            lines.append(f"  - **Color**: {_fmt_vec(mat['color'])}")
229	        return "\n".join(lines)
230	
231	    elif command_type == "apply_material":
232	        mat = response.get("material_name", response.get("material", "?"))
233	        obj = response.get("object_name", response.get("object", "?"))
234	        return f"✅ Applied material **{mat}** → **{obj}**"
235	
236	    elif command_type == "render_frame":
237	        info = response.get("render_info", response)
238	        lines = ["✅ Render complete"]
239	        if "output_path" in info:
240	            lines.append(f"  - **Output**: `{info['output_path']}`")
241	        if "width" in info and "height" in info:
242	            lines.append(f"  - **Resolution**: {info['width']}×{info['height']}")
243	        if "render_time" in info:
244	            lines.append(f"  - **Time**: {info['render_time']}")
245	        return "\n".join(lines)
246	
247	    elif command_type == "set_keyframe":
248	        lines = ["✅ Keyframe set"]
249	        for key in ("object_name", "property", "value", "frame"):
250	            if key in response:
251	                lines.append(f"  - **{key.replace('_', ' ').title()}**: {response[key]}")
252	        return "\n".join(lines)
253	
254	    elif command_type in ("save_scene", "load_scene"):
255	        action = "Saved" if command_type == "save_scene" else "Loaded"
256	        path = response.get("file_path", response.get("path", ""))
257	        lines = [f"✅ {action} scene"]
258	        if path:
259	            lines.append(f"  - **Path**: `{path}`")
260	        return "\n".join(lines)
261	
262	    elif command_type == "create_mograph_cloner":
263	        obj = response.get("object", {})
264	        name = obj.get("name", "Cloner")
265	        lines = [f"✅ Created cloner **{name}**"]
266	        if "mode" in obj:
267	            lines.append(f"  - **Mode**: {obj['mode']}")
268	        if "guid" in obj:
269	            lines.append(f"  - **GUID**: `{obj['guid']}`")
270	        return "\n".join(lines)
271	
272	    elif command_type == "add_effector":
273	        obj = response.get("object", response.get("effector", {}))
274	        name = obj.get("name", "Effector")
275	        lines = [f"✅ Added effector **{name}**"]
276	        if "type" in obj:
277	            lines.append(f"  - **Type**: {obj['type']}")
278	        if "applied_to" in obj:
279	            lines.append(f"  - **Applied to**: {obj['applied_to']}")
280	        return "\n".join(lines)
281	
282	    elif command_type == "apply_mograph_fields":
283	        field = response.get("field", {})
284	        name = field.get("name", "Field")
285	        lines = [f"✅ Applied field **{name}**"]
286	        if "type" in field:
287	            lines.append(f"  - **Type**: {field['type']}")
288	        if "applied_to" in field:
289	            lines.append(f"  - **Target**: {field['applied_to']}")
290	        if "strength" in field:
291	            lines.append(f"  - **Strength**: {field['strength']}")
292	        if "falloff" in field:
293	            lines.append(f"  - **Falloff**: {field['falloff']}")
294	        return "\n".join(lines)
295	
296	    elif command_type in ("create_soft_body", "apply_dynamics"):
297	        obj_name = response.get("object_name", response.get("object", {}).get("name", "Object"))
298	        dtype = response.get("type", response.get("dynamics_type", "dynamics"))
299	        return f"✅ Applied **{dtype}** dynamics to **{obj_name}**"
300	
301	    elif command_type == "create_abstract_shape":
302	        obj = response.get("object", {})
303	        name = obj.get("name", "Shape")
304	        lines = [f"✅ Created abstract shape **{name}**"]
305	        if "type" in obj:
306	            lines.append(f"  - **Type**: {obj['type']}")
307	        return "\n".join(lines)
308	
309	    elif command_type == "create_camera":
310	        cam = response.get("camera", response.get("object", {}))
311	        name = cam.get("name", "Camera")
312	        lines = [f"✅ Created camera **{name}**"]
313	        if "position" in cam:
314	            lines.append(f"  - **Position**: {_fmt_vec(cam['position'])}")
315	        if "focal_length" in cam:
316	            lines.append(f"  - **Focal Length**: {cam['focal_length']}mm")
317	        if "guid" in cam:
318	            lines.append(f"  - **GUID**: `{cam['guid']}`")
319	        return "\n".join(lines)
320	
321	    elif command_type == "create_light":
322	        obj = response.get("object", {})
323	        name = obj.get("name", "Light")
324	        lines = [f"✅ Created light **{name}**"]
325	        if "type" in obj:
326	            lines.append(f"  - **Type**: {obj['type']}")
327	        return "\n".join(lines)
328	
329	    elif command_type == "apply_shader":
330	        shader = response.get("shader", {})
331	        lines = [f"✅ Applied **{shader.get('type', 'shader')}** shader"]
332	        if "material" in shader:
333	            lines.append(f"  - **Material**: {shader['material']}")
334	        if "applied_to" in shader and shader["applied_to"] != "None":
335	            lines.append(f"  - **Applied to**: {shader['applied_to']}")
336	        return "\n".join(lines)
337	
338	    elif command_type == "animate_camera":
339	        cam = response.get("camera_animation", {})
340	        lines = [f"✅ Camera animation created"]
341	        if "type" in cam:
342	            lines.append(f"  - **Type**: {cam['type']}")
343	        if "camera_name" in cam:
344	            lines.append(f"  - **Camera**: {cam['camera_name']}")
345	        if "frame_range" in cam:
346	            lines.append(f"  - **Frame Range**: {cam['frame_range']}")
347	        if "keyframe_count" in cam:
348	            lines.append(f"  - **Keyframes**: {cam['keyframe_count']}")
349	        return "\n".join(lines)
350	
351	    elif command_type == "execute_python":
352	        result = response.get("result", "No output")
353	        output = response.get("output", "")
354	        variables = response.get("variables", {})
355	        warning = response.get("warning", "")
356	        lines = ["✅ Script executed successfully"]
357	        if output:
358	            lines.append(f"**Output:**\n```\n{output}\n```")
359	        elif result and result != "No output":
360	            lines.append(f"**Output:**\n```\n{result}\n```")
361	        if variables:
362	            vars_str = "\n".join(f"  {k}: {v}" for k, v in variables.items())
363	            lines.append(f"**Variables:**\n{vars_str}")
364	        if warning:
365	            lines.append(f"⚠️ {warning}")
366	        return "\n".join(lines) if len(lines) > 1 else "Script executed (no output)"
367	
368	    elif command_type == "group_objects":
369	        group = response.get("group", {})
370	        name = group.get("name", "Group")
371	        children = group.get("children", [])
372	        lines = [f"✅ Grouped into **{name}**"]
373	        if children:
374	            lines.append(f"  - **Children**: {', '.join(children)}")
375	        return "\n".join(lines)
376	
377	    elif command_type == "render_preview":
378	        if "image_data" not in response:
379	            return "❌ No image data returned from Cinema 4D"
380	        w = response.get("width", "?")
381	        h = response.get("height", "?")
382	        fmt = response.get("format", "png")
383	        lines = [f"✅ Preview rendered ({w}×{h}, {fmt})"]
384	        # Embed as base64 markdown image so Claude Code can display it
385	        lines.append(f"![preview](data:image/{fmt};base64,{response['image_data']})")
386	        return "\n".join(lines)
387	
388	    elif command_type == "snapshot_scene":
389	        snap = response.get("snapshot", {})
390	        lines = ["✅ Scene snapshot created"]
391	        if "path" in snap:
392	            lines.append(f"  - **Path**: `{snap['path']}`")
393	        if "timestamp" in snap:
394	            lines.append(f"  - **Timestamp**: {snap['timestamp']}")
395	        if "size" in snap:
396	            lines.append(f"  - **Size**: {snap['size']}")
397	        if "assets" in snap:
398	            lines.append(f"  - **Assets**: {len(snap['assets'])}")
399	        return "\n".join(lines)
400	
401	    # Fallback: format the dict generically
402	    lines = [f"✅ {status}"]
403	    for k, v in response.items():
404	        if k == "status":
405	            continue
406	        if isinstance(v, dict):
407	            lines.append(f"  - **{k.replace('_', ' ').title()}**:")
408	            lines.extend(_fmt_props(v, "    "))
409	        elif isinstance(v, list) and len(v) > 0 and isinstance(v[0], dict):
410	            lines.append(f"  - **{k.replace('_', ' ').title()}**: ({len(v)} items)")
411	        else:
412	            lines.append(f"  - **{k.replace('_', ' ').title()}**: {v}")
413	    return "\n".join(lines)
