186	async def get_known_room_names(adapter: MijiaAdapter) -> List[str]:
187	    homes = await adapter.get_homes()
188	    room_names: List[str] = []
189	    for home in homes:
190	        home_summary = normalize_home(home)
191	        room_names.extend([room["name"] for room in home_summary["rooms"] if room.get("name")])
192	    return room_names
