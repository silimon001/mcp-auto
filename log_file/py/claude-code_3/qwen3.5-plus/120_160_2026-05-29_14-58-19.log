93	@app.get("/health")
94	async def health_check():
95	    """Health check endpoint"""
96	    return {
97	        "status": "healthy",
98	        "service": "mcp-db-server",
99	        "version": "1.1.0",
100	        "database_connected": True  # Will be updated with actual DB check
101	    }
