287	                                   detect_source=auto_detect_source)
288	
289	        # Generate output filename if not provided
290	        if not output_file:
291	            sorted_slides = sorted(set(slide_list))
292	            if len(sorted_slides) > 1 and sorted_slides[-1] - sorted_slides[0] == len(sorted_slides) - 1:
293	                slides_suffix = f"_slides_range_{sorted_slides[0]}_{sorted_slides[-1]}"
294	            else:
295	                slides_suffix = f"_slides_{'_'.join(map(str, sorted_slides))}"
296	            output_file = str(input_path.parent / f"{input_path.stem}_translated_{target_language}{slides_suffix}{input_path.suffix}")
297	
298	        logger.info(f"Starting specific slides translation: {input_path} -> {target_language}")
299	        with build_cache(cache_backend) as cache:
300	            translator = PowerPointTranslator(model_id, enable_polishing,
301	                                              cache=cache, glossary=glossary,
302	                                              translate_charts=translate_charts,
303	                                              source_language=source_language,
304	                                              auto_detect_source=auto_detect_source)
305	            result = translator.translate_specific_slides(str(input_path), output_file, target_language, slide_list)
306	        
307	        # Check for errors
308	        if result.errors:
309	            return f"❌ Translation failed: {'; '.join(result.errors)}"
310	        
311	        # Apply post-processing if enabled
312	        config = Config()
313	        post_processing_applied = False
314	        if config.get_bool('ENABLE_TEXT_AUTOFIT', True):
315	            try:
316	                verbose = config.get_bool('DEBUG', False)
317	                post_processor = PowerPointPostProcessor(config, verbose=verbose)
318	                # Overwrite the original output file instead of creating a new one
319	                final_output = post_processor.process_presentation(output_file, output_file)
320	                post_processing_applied = True
321	                logger.info("Post-processing applied: Text auto-fitting enabled")
322	            except Exception as e:
