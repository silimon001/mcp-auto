326	        """Initialize SQLAlchemy async engine with optional MySQL SSL support"""
327	        try:
328	            if self.database_type == "mongodb":
329	                if AsyncIOMotorClient is None:
330	                    raise ImportError("motor is required for MongoDB support. Install with: pip install motor")
331	
332	                timeout_ms = int(os.getenv("MONGO_SERVER_SELECTION_TIMEOUT_MS", "5000"))
333	                self.mongo_client = AsyncIOMotorClient(
