34	    "openai": OpenAIChat,
35	    "anthropic": Claude,
36	    "google": Gemini,
37	    "groq": Groq,
38	    "deepseek": DeepSeek,
39	    "xai": xAI,
40	    "perplexity": Perplexity,
41	    "cohere": Cohere,
42	    "fireworks": Fireworks,
