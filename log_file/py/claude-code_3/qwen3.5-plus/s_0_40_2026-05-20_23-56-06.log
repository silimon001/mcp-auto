loop 20 | Tool=Edit, Args={"replace_all":false,"file_path":"/home/silimon/MCP-Auto/mcp_server/961579916_MorDavid_ExternalAttacker-MCP/ExternalAttacker-MCP.py","old_string":"import threading\nimport time\nimport sys\nimport os\n\ndef start_flask_app():\n    \"\"\"Start the Flask backend app in a background thread.\"\"\"\n    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n    from ExternalAttacker_App import app\n    def run_flask():\n        app.run(host='127.0.0.1', port=6991, use_reloader=False)\n    thread = threading.Thread(target=run_flask, daemon=True)\n    thread.start()\n    # Wait for Flask to be ready\n    for i in range(30):\n        try:\n            requests.get('http://127.0.0.1:6991/', timeout=1)\n            return\n        except Exception:\n            time.sleep(0.5)\n\nif __name__ == \"__main__\":\n    start_flask_app()\n    mcp.run(transport=\"stdio\")","new_string":"import threading\nimport time\nimport subprocess\nimport sys\nimport os\n\ndef start_flask_app():\n    \"\"\"Start the Flask backend app in a background process.\"\"\"\n    flask_script = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'ExternalAttacker-App.py')\n    proc = subprocess.Popen(\n        [sys.executable, flask_script],\n        stdout=subprocess.DEVNULL,\n        stderr=subprocess.DEVNULL,\n    )\n    # Wait for Flask to be ready\n    for i in range(30):\n        try:\n            requests.get('http://127.0.0.1:6991/', timeout=1)\n            return\n        except Exception:\n            time.sleep(0.5)\n\nif __name__ == \"__main__\":\n    start_flask_app()\n    mcp.run(transport=\"stdio\")"}

