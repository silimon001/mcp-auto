83	    def _generate_task_name(self, query: str) -> str:
84	        """Generate a descriptive task name from the query."""
85	        # Clean the query and extract key terms
86	        query_lower = query.lower().strip()
87	
88	        # Common patterns for red team operations
89	        patterns = {
90	            r'port\s*scan|scan.*port': 'port-scan',
91	            r'vuln|vulnerability|vulnerabilities': 'vuln-scan',
92	            r'ssh.*brute|brute.*ssh': 'ssh-brute',
93	            r'exploit|metasploit': 'exploit',
94	            r'banner|grab.*banner': 'banner-grab',
95	            r'search.*host|list.*host|find.*host|hosts.*with': 'host-search',
96	            r'search.*exploit|find.*exploit': 'exploit-search',
97	            r'search.*vuln|find.*vuln': 'vuln-search',
98	            r'enumerate|enum': 'enumeration',
99	            r'resolve|dns|hostname': 'dns-lookup',
100	            r'capabilities|tools|help': 'info-query'
101	        }
102	
103	        # Check for pattern matches
104	        for pattern, name in patterns.items():
105	            if re.search(pattern, query_lower):
106	                # Add target info if available
107	                target_match = re.search(r'(\d+\.\d+\.\d+\.\d+|[\w\.-]+\.\w+|\d+\.\d+\.\d+\.\d+/\d+)', query)
108	                if target_match:
109	                    target = target_match.group(1)
110	                    # Shorten long targets
111	                    if len(target) > 15:
112	                        target = target[:12] + "..."
113	                    return f"{name}-{target}"
114	
115	                # Add port info if available
116	                port_match = re.search(r'port\s*(\d+)', query_lower)
117	                if port_match:
118	                    port = port_match.group(1)
119	                    return f"{name}-{port}"
120	
121	                return name
122	
123	        # Fallback: use first few words
124	        words = re.findall(r'\w+', query_lower)
125	        if words:
126	            # Take first 2-3 meaningful words, skip common words
127	            skip_words = {'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with', 'by'}
128	            meaningful_words = [w for w in words[:5] if w not in skip_words]
129	            if meaningful_words:
130	                name = '-'.join(meaningful_words[:3])
131	                # Limit length
132	                if len(name) > 20:
133	                    name = name[:17] + "..."
134	                return name
135	
136	        # Ultimate fallback
137	        return f"task-{self.task_counter}"
