121	async def get_application_by_identifier(identifier: str) -> Dict[str, Any]:
122	    """
123	    Gets information about a specific application by its identifier.
124	
125	    Args:
126	        identifier: The identifier of the application to look up.
127	
128	    Returns:
129	        A string containing information about the application, or a message
130	        indicating that the application was not found.
131	    """
132	    device = await _get_remote_device()
133	
134	    try:
135	        apps = await asyncio.to_thread(device.enumerate_applications)
136	        target = next(
137	            (a for a in apps if a.identifier.lower() == identifier.lower()
138	             or a.name.lower() == identifier.lower()),
139	            None
140	        )
141	
142	        if not target:
143	            return {"found": False, "error": f"Application '{identifier}' not found."}
144	        
145	        return {
146	            "pid": target.pid if target.pid != 0 else None,
147	            "name": target.name,
148	            "identifier": target.identifier,
149	            "found": True
150	        }
151	        
152	    except frida.ProcessNotFoundError:
153	        return {"error": f"Application '{identifier}' not found."}
154	    except Exception as e:
