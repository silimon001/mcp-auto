682	        clear_existing=not args.keep_existing,
683	        batch_size=args.batch_size,
684	        max_workers=args.max_workers,
685	        prefer_rpc=args.prefer_rpc
686	    )
687	
688	    # Print results as JSON for programmatic use
689	    print("\n" + "="*50)
690	    print("RESULTS:")
