1	"""Data models for Red Team MCP Server."""
2	
3	from datetime import datetime
4	from enum import Enum
5	from typing import Dict, List, Optional, Union
6	
7	from pydantic import BaseModel, Field, validator
8	
9	
10	class ScanStatus(str, Enum):
11	    """Status of a scan operation."""
12	    PENDING = "pending"
13	    RUNNING = "running"
14	    COMPLETED = "completed"
15	    FAILED = "failed"
16	    CANCELLED = "cancelled"
17	
18	
19	class PortState(str, Enum):
20	    """State of a scanned port."""
21	    OPEN = "open"
22	    CLOSED = "closed"
23	    FILTERED = "filtered"
24	
25	
26	class ScanTarget(BaseModel):
27	    """Target specification for scanning."""
28	    
29	    ip_range: str = Field(..., description="IP range to scan (e.g., '192.168.1.0/24')")
30	    ports: Union[str, List[int]] = Field(
31	        default="1-1000",
32	        description="Ports to scan (e.g., '80,443' or [80, 443] or '1-1000')"
33	    )
34	    
35	    @validator('ip_range')
36	    def validate_ip_range(cls, v):
37	        import ipaddress
38	        try:
39	            # Try to parse as network
40	            ipaddress.ip_network(v, strict=False)
41	        except ValueError:
42	            try:
43	                # Try to parse as single IP
44	                ipaddress.ip_address(v)
45	            except ValueError:
46	                raise ValueError(f"Invalid IP range or address: {v}")
47	        return v
48	    
49	    @validator('ports')
50	    def validate_ports(cls, v):
51	        if isinstance(v, str):
52	            # Validate port range string format
53	            if '-' in v:
54	                try:
55	                    start, end = map(int, v.split('-'))
56	                    if not (1 <= start <= 65535 and 1 <= end <= 65535 and start <= end):
57	                        raise ValueError("Invalid port range")
58	                except ValueError:
59	                    raise ValueError("Invalid port range format")
60	            elif ',' in v:
61	                try:
62	                    ports = [int(p.strip()) for p in v.split(',')]
63	                    for port in ports:
64	                        if not (1 <= port <= 65535):
65	                            raise ValueError(f"Invalid port number: {port}")
66	                except ValueError:
67	                    raise ValueError("Invalid port list format")
68	            else:
69	                try:
70	                    port = int(v)
71	                    if not (1 <= port <= 65535):
72	                        raise ValueError(f"Invalid port number: {port}")
73	                except ValueError:
74	                    raise ValueError("Invalid port format")
75	        elif isinstance(v, list):
76	            for port in v:
77	                if not isinstance(port, int) or not (1 <= port <= 65535):
78	                    raise ValueError(f"Invalid port number: {port}")
79	        return v
80	
81	
82	class PortResult(BaseModel):
83	    """Result of scanning a single port."""
84	    
85	    port: int = Field(..., description="Port number")
86	    protocol: str = Field(default="tcp", description="Protocol (tcp/udp)")
87	    state: PortState = Field(..., description="Port state")
88	    service: Optional[str] = Field(None, description="Detected service name")
89	    banner: Optional[str] = Field(None, description="Service banner")
90	    timestamp: datetime = Field(default_factory=datetime.utcnow)
91	
92	
93	class HostResult(BaseModel):
94	    """Result of scanning a single host."""
95	    
96	    ip: str = Field(..., description="IP address")
97	    hostname: Optional[str] = Field(None, description="Resolved hostname")
98	    ports: List[PortResult] = Field(default_factory=list, description="Port scan results")
99	    os_info: Optional[str] = Field(None, description="OS detection info")
100	    timestamp: datetime = Field(default_factory=datetime.utcnow)
101	
102	
103	class ScanRequest(BaseModel):
104	    """Request to perform a scan."""
105	    
106	    scan_id: str = Field(..., description="Unique scan identifier")
107	    target: ScanTarget = Field(..., description="Target specification")
108	    scan_type: str = Field(default="tcp_syn", description="Type of scan to perform")
109	    rate: Optional[int] = Field(None, description="Scan rate (packets per second)")
110	    timeout: Optional[int] = Field(None, description="Scan timeout in seconds")
111	    options: Dict[str, Union[str, int, bool]] = Field(
112	        default_factory=dict,
113	        description="Additional scan options"
114	    )
115	    
116	    @validator('scan_type')
117	    def validate_scan_type(cls, v):
118	        valid_types = ['tcp_syn', 'tcp_connect', 'udp', 'tcp_ack', 'tcp_window']
119	        if v not in valid_types:
120	            raise ValueError(f"scan_type must be one of {valid_types}")
121	        return v
122	
123	
124	class ScanResult(BaseModel):
125	    """Complete result of a scan operation."""
126	    
127	    scan_id: str = Field(..., description="Unique scan identifier")
128	    request: ScanRequest = Field(..., description="Original scan request")
129	    status: ScanStatus = Field(..., description="Scan status")
130	    hosts: List[HostResult] = Field(default_factory=list, description="Host results")
131	    start_time: datetime = Field(default_factory=datetime.utcnow)
132	    end_time: Optional[datetime] = Field(None, description="Scan completion time")
133	    error_message: Optional[str] = Field(None, description="Error message if failed")
134	    stats: Dict[str, Union[int, float]] = Field(
135	        default_factory=dict,
136	        description="Scan statistics"
137	    )
138	    
139	    @property
140	    def duration(self) -> Optional[float]:
141	        """Calculate scan duration in seconds."""
142	        if self.end_time:
143	            return (self.end_time - self.start_time).total_seconds()
144	        return None
145	    
146	    @property
147	    def total_hosts(self) -> int:
148	        """Total number of hosts scanned."""
149	        return len(self.hosts)
150	    
151	    @property
152	    def total_open_ports(self) -> int:
153	        """Total number of open ports found."""
154	        return sum(
155	            len([p for p in host.ports if p.state == PortState.OPEN])
156	            for host in self.hosts
157	        )
158	
159	
