452	    def _parse_agent_results(self, response: str) -> tuple[list, list, list]:
453	        """Parse the agent response to extract shells, credentials, and vulnerabilities."""
454	        shells_obtained = []
455	        credentials_found = []
456	        vulnerabilities_found = []
457	
458	        # Simple parsing - look for patterns in the response
459	        # This is a basic implementation that could be enhanced with more sophisticated parsing
460	
461	        # Look for SSH success patterns
462	        ssh_patterns = [
463	            r"SSH.*success.*(\d+\.\d+\.\d+\.\d+).*port\s*(\d+).*username[:\s]*(\w+).*password[:\s]*(\w+)",
464	            r"authentication.*successful.*(\w+)@(\d+\.\d+\.\d+\.\d+):(\d+).*password[:\s]*(\w+)",
465	            r"SHELL.*ACCESS.*(\d+\.\d+\.\d+\.\d+).*(\d+).*(\w+).*(\w+)"
466	        ]
467	
468	        for pattern in ssh_patterns:
469	            matches = re.finditer(pattern, response, re.IGNORECASE)
470	            for match in matches:
471	                if len(match.groups()) >= 4:
472	                    shells_obtained.append({
473	                        "type": "ssh",
474	                        "host": match.group(1) if "." in match.group(1) else match.group(2),
475	                        "port": int(match.group(2) if "." in match.group(1) else match.group(3)),
476	                        "username": match.group(3) if "." in match.group(1) else match.group(1),
477	                        "password": match.group(4),
478	                        "method": "ssh_brute_force"
479	                    })
480	
481	        # Look for credential patterns
482	        cred_patterns = [
483	            r"credential.*found.*username[:\s]*(\w+).*password[:\s]*(\w+)",
484	            r"login.*successful.*(\w+)[:/](\w+)",
485	            r"auth.*success.*user[:\s]*(\w+).*pass[:\s]*(\w+)"
486	        ]
487	
488	        for pattern in cred_patterns:
489	            matches = re.finditer(pattern, response, re.IGNORECASE)
490	            for match in matches:
491	                credentials_found.append({
492	                    "username": match.group(1),
493	                    "password": match.group(2),
494	                    "service": "unknown",
495	                    "method": "brute_force"
496	                })
497	
498	        # Look for vulnerability patterns
499	        vuln_patterns = [
500	            r"CVE-(\d{4}-\d+)",
501	            r"vulnerability.*found.*port\s*(\d+)",
502	            r"exploit.*available.*(\w+)"
503	        ]
504	
505	        for pattern in vuln_patterns:
506	            matches = re.finditer(pattern, response, re.IGNORECASE)
507	            for match in matches:
508	                if "CVE" in pattern:
509	                    vulnerabilities_found.append({
510	                        "cve": f"CVE-{match.group(1)}",
511	                        "severity": "unknown",
512	                        "description": f"CVE-{match.group(1)} identified"
513	                    })
514	                elif "port" in pattern:
515	                    vulnerabilities_found.append({
516	                        "port": int(match.group(1)),
517	                        "severity": "unknown",
518	                        "description": f"Vulnerability on port {match.group(1)}"
519	                    })
520	
521	        return shells_obtained, credentials_found, vulnerabilities_found
