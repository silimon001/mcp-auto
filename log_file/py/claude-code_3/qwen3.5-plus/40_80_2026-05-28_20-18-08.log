69	def get_metasploit_client():
70	    """Get or create Metasploit RPC client connection."""
71	    global _msf_client
72	
73	    if _msf_client is None:
74	        try:
75	            from pymetasploit3.msfrpc import MsfRpcClient
76	            import json
77	
78	            # Try to patch msgpack which is used by pymetasploit3
79	            try:
80	                import msgpack
81	
82	                # Store original packb function
83	                original_packb = msgpack.packb
84	
85	                def patched_packb(obj, **kwargs):
86	                    """Patched msgpack.packb that converts integer keys to strings."""
87	                    try:
88	                        # Convert integer keys before packing
89	                        converted_obj = convert_int_keys_to_str(obj)
90	                        return original_packb(converted_obj, **kwargs)
91	                    except Exception:
92	                        # Fallback to original if conversion fails
93	                        return original_packb(obj, **kwargs)
94	
95	                # Apply the msgpack patch
96	                msgpack.packb = patched_packb
97	                print("🔧 DEBUG: Applied msgpack patch for integer keys")
98	
99	            except ImportError:
100	                print("⚠️  DEBUG: msgpack not available for patching")
101	
102	            # Also patch json.dumps as a backup
103	            original_dumps = json.dumps
104	
105	            def patched_dumps(obj, **kwargs):
106	                """Patched json.dumps that converts integer keys to strings."""
107	                try:
108	                    # Try the original dumps first
109	                    return original_dumps(obj, **kwargs)
110	                except TypeError as e:
111	                    if "int is not allowed for map key" in str(e) or "keys must be a string" in str(e):
112	                        # Convert integer keys to strings and try again
113	                        converted_obj = convert_int_keys_to_str(obj)
114	                        return original_dumps(converted_obj, **kwargs)
115	                    else:
116	                        raise
117	
118	            # Apply the json patch
119	            json.dumps = patched_dumps
120	            print("🔧 DEBUG: Applied JSON patch for integer keys")
121	
122	            # Default connection parameters - can be made configurable later
123	            password = "msf"  # Default msfrpcd password
124	            host = "127.0.0.1"
125	            port = 55553  # Default msfrpcd port
126	            ssl = True  # msfrpcd runs with SSL by default
127	
128	            _msf_client = MsfRpcClient(password, host=host, port=port, ssl=ssl)
129	            logger.info(f"Connected to Metasploit RPC server at {host}:{port}")
130	
131	        except ImportError:
