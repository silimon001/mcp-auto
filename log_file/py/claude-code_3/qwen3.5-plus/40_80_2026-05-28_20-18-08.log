633	async def hack_machine(target_host: str, target_ports: str = "1-65535",
634	                      scan_rate: int = 1000):
635	    """
636	    Execute a systematic penetration test against a target machine.
637	
638	    This tool implements a complete penetration testing methodology:
639	    1. Reconnaissance (port scanning, service enumeration)
640	    2. Vulnerability assessment (nuclei scanning)
641	    3. Exploitation (SSH brute force, Metasploit exploits)
642	    4. Post-exploitation (command execution, information gathering)
643	
644	    Args:
645	        target_host: Target IP address or hostname to hack
646	        target_ports: Port range to scan (default: 1-65535)
647	        scan_rate: Scan rate for port scanning (default: 1000)
648	
649	    Returns:
650	        Structured report with:
651	        - Success/failure status
652	        - Shells obtained (with connection details)
653	        - Credentials discovered
654	        - Vulnerabilities found
655	        - Recommended next steps for the main agent
656	        - Detailed execution log
657	    """
658	    # Create a simple hacking agent for this specific task
659	    import os
660	    ollama_host = os.getenv("OLLAMA_HOST", "http://192.168.0.242:11434")
661	    hacking_agent = HackingAgent(
662	        ollama_model="qwen3:14b",
663	        ollama_host=ollama_host,
664	        mcp_timeout=600
665	    )
666	
667	    # Initialize the agent
668	    if not await hacking_agent.initialize():
669	        return "❌ Failed to initialize hacking agent"
670	
671	    try:
672	        # Stream the hacking process - collect updates and print them for visibility
673	        final_result = None
674	        update_count = 0
675	
676	        async for update in hacking_agent.hack_machine_streaming(
677	            target_host=target_host,
678	            target_ports=target_ports,
679	            scan_rate=scan_rate
680	        ):
681	            update_count += 1
682	
683	            # Print streaming updates so we can see them in the tool output
684	            scan_display = update.get("scan_display_id", "unknown")
685	
686	            if update["type"] == "status":
687	                print(f"📡 [{scan_display}] {update['message']}")
688	            elif update["type"] == "tool_call":
689	                # Print tool call with parameters
690	                tool_name = update.get("tool_name", "unknown")
691	                parameters = update.get("parameters", {})
692	                if parameters:
693	                    # Format parameters nicely
694	                    param_str = ", ".join([f"{k}={v}" for k, v in parameters.items()])
695	                    print(f"🔧 [{scan_display}] Calling {tool_name} with parameters: {param_str}")
696	                else:
697	                    print(f"🔧 [{scan_display}] Calling {tool_name}")
698	            elif update["type"] == "tool_result":
699	                print(f"✅ [{scan_display}] {update['message']}")
700	            elif update["type"] == "finding":
701	                print(f"🎯 [{scan_display}] {update['message']}")
702	            elif update["type"] == "complete":
703	                print(f"✅ [{scan_display}] {update['message']}")
704	                final_result = update["final_report"]
705	                break
