18	class KafkaConnector:
19	    """
20	    Encapsulates the connection to a kafka server and all the methods to interact with it.
21	    :param kafka_bootstrap_url: The URL of the kafka server.
22	    :param topic_name: The topic to which the client will talk to.
23	    """
24	
25	    def __init__(self, kafka_bootstrap_url: str, topic_name: str, group_id: str):
26	        self.KAFKA_BOOTSTRAP_SERVERS = kafka_bootstrap_url
27	        self.topic_name = topic_name
28	        self.group_id = group_id
29	        self.producer = None
30	        # Initialize admin client for topic management and cluster health
31	        self.admin_client = AdminClient({'bootstrap.servers': kafka_bootstrap_url})
32	
33	    async def create_producer(self):
34	        """Create and start a Kafka producer."""
35	        producer = AIOKafkaProducer(bootstrap_servers=self.KAFKA_BOOTSTRAP_SERVERS)
36	        await producer.start()
37	        logger.info(f"Kafka producer started, connected to {self.KAFKA_BOOTSTRAP_SERVERS}")
38	        self.producer = producer
39	        return producer
40	
41	    async def close_producer(self):
42	        """Close the Kafka producer."""
43	        await self.producer.stop()
44	        logger.info("Kafka producer stopped")
45	
46	    async def publish(self, value):
47	        """
48	        Publish a message to the specified Kafka topic.
49	
50	        Args:
51	            producer: AIOKafkaProducer instance
52	            topic_name: Topic to publish to
53	            key: Message key (can be None)
54	            value: Message value
55	        """
56	        try:
57	            key = str(uuid.uuid4())
58	            # Convert value to bytes if it's not already
59	            if isinstance(value, dict):
60	                value_bytes = json.dumps(value).encode('utf-8')
61	            elif isinstance(value, str):
62	                value_bytes = value.encode('utf-8')
63	            else:
64	                value_bytes = value
65	
66	            # Convert key to bytes if it's not None and not already bytes
67	            key_bytes = None
68	            if key is not None:
69	                if isinstance(key, str):
70	                    key_bytes = key.encode('utf-8')
71	                else:
72	                    key_bytes = key
73	
74	            # Send message
75	            await self.producer.send_and_wait(self.topic_name, value=value_bytes, key=key_bytes)
76	            logger.info(f"Published message with key {key} to topic {self.topic_name}")
77	        except Exception as e:
78	            logger.error(f"Error publishing message: {e}")
79	            raise
80	
81	    async def consume(self, from_beginning=True):
82	        """
83	        Consume messages from the specified Kafka topics.
84	
85	        Args:
86	            from_beginning: Whether to start consuming from the beginning
87	        """
88	        # Convert single topic to list
89	        if isinstance(self.topic_name, str):
90	            topics = [self.topic_name]
91	
92	        # Set auto_offset_reset based on from_beginning
93	        auto_offset_reset = 'earliest' if from_beginning else 'latest'
94	
95	        # Create consumer
96	        consumer = AIOKafkaConsumer(
97	            *topics,
98	            bootstrap_servers=self.KAFKA_BOOTSTRAP_SERVERS,
99	            group_id=self.group_id,
100	            auto_offset_reset=auto_offset_reset,
101	            enable_auto_commit=True,
102	        )
103	
104	        # Start consumer
105	        await consumer.start()
106	        logger.info(f"Kafka consumer started, subscribed to {topics}")
107	
108	        messages = []
109	
110	        try:
111	            # Get a batch of messages with timeout
112	            batch = await consumer.getmany(timeout_ms=5000)
113	
114	            for tp, msgs in batch.items():
115	                for msg in msgs:
116	                    logger.info(f"Raw message received: {msg}")
117	                    processed_message = await self._process_message(msg)
118	                    messages.append(processed_message)
119	
120	            return messages
121	        finally:
122	            # Close consumer
123	            await consumer.stop()
124	            logger.info("Kafka consumer stopped")
125	
126	    async def _process_message(self, msg):
127	        """
128	       Process a message received from Kafka.
129	
130	       Args:
131	           msg: Message object from Kafka
132	       """
133	        try:
134	            # Decode the message value
135	            if msg.value:
136	                try:
137	                    value = json.loads(msg.value.decode('utf-8'))
138	                except json.JSONDecodeError:
139	                    value = msg.value.decode('utf-8')
140	            else:
141	                value = None
142	
143	            # Decode the message key
144	            key = msg.key.decode('utf-8') if msg.key else None
145	
146	            logger.info(f"Received message: Topic={msg.topic}, Partition={msg.partition}, "
147	                        f"Offset={msg.offset}, Key={key}, Value={value}")
148	
149	            # Your message processing logic here
150	            return value
151	        except Exception as e:
152	            logger.error(f"Error processing message: {e}")
153	            raise
