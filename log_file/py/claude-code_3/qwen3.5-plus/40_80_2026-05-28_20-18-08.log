1	#!/usr/bin/env python3
2	"""
3	MCP Server: GAIT (Git for AI Tracking) for Gemini-CLI, Claude Desktop, and VS Code.
4	
5	Design goals:
6	- STDIO MCP: NEVER write to stdout except protocol (FastMCP handles this)
7	- Log to STDERR only
8	- Be resilient when GAIT is not initialized yet (return structured errors)
9	- Enforce: DO NOT init at filesystem root
10	- Provide GAIT-native revert/reset semantics (optionally also reset memory)
11	- Provide remote add/list/get + push/fetch/pull/clone + repo create
12	
13	Gemini-CLI note:
14	Some Gemini wrappers call tools using one of these styles:
15	  tool(args=[...], kwargs={...})
16	  tool(call_args=[...], call_kwargs={...})
17	So we must accept and unpack those safely.
18	"""
19	
20	from __future__ import annotations
21	
22	import functools
23	import inspect
24	import logging
25	import os
26	import re
27	import datetime
28	import sys
29	from pathlib import Path
30	from typing import Any, Dict, List, Optional, Tuple
31	
32	# ---------------------------------------------------------------------
33	# Logging (stderr only)
34	# ---------------------------------------------------------------------
35	logging.basicConfig(
36	    level=logging.INFO,
37	    format="%(asctime)s | %(name)s | %(levelname)s | %(message)s",
38	    stream=sys.stderr,
39	)
40	logging.getLogger("mcp.server.lowlevel.server").setLevel(logging.WARNING)
41	
42	log = logging.getLogger("GaitMCP")
43	
44	# ---------------------------------------------------------------------
45	# MCP
46	# ---------------------------------------------------------------------
47	try:
48	    from mcp.server.fastmcp import FastMCP
49	except Exception:
50	    try:
51	        from fastmcp import FastMCP  # type: ignore
52	    except Exception as e:
53	        log.error("FastMCP not found. Install with: pip install mcp")
54	        raise
55	
56	# ---------------------------------------------------------------------
57	# GAIT core
58	# ---------------------------------------------------------------------
59	from gait.repo import GaitRepo
60	from gait.schema import Turn
61	from gait.tokens import count_turn_tokens
62	from gait.objects import short_oid
63	from gait.log import walk_commits
64	
65	# ---------------------------------------------------------------------
66	# GAIT remote (your real implementation)
67	# ---------------------------------------------------------------------
68	from gait.remote import (
69	    RemoteSpec,
70	    remote_add,
71	    remote_get,
72	    remote_list,
73	    push as remote_push,
74	    fetch as remote_fetch,
75	    pull as remote_pull,
76	    clone_into,
77	    create_repo as remote_create_repo,
78	)
79	
80	if sys.version_info < (3, 11):
81	    # Shim for Python 3.10 compatibility
82	    import datetime as dt
83	    if not hasattr(dt, 'UTC'):
84	        dt.UTC = dt.timezone.utc
85	
86	# ---------------------------------------------------------------------
87	
88	mcp = FastMCP("GAIT")
89	
90	# ---------------------------------------------------------------------
91	# Helpers
92	# ---------------------------------------------------------------------
93	def _err(msg: str, *, detail: str = "", **extra: Any) -> Dict[str, Any]:
94	    out: Dict[str, Any] = {"ok": False, "error": msg}
95	    if detail:
96	        out["detail"] = detail
97	    out.update(extra)
98	    return out
99	
100	
101	def _is_filesystem_root(p: Path) -> bool:
102	    p = p.resolve()
103	    return str(p) == str(Path(p.anchor).resolve())
104	
105	
106	def _get_gaithub_token(provided: str = "") -> Optional[str]:
107	    t = (provided or "").strip()
108	    if t:
109	        return t
110	    env = os.environ.get("GAITHUB_TOKEN", "").strip()
111	    return env or None
112	
113	
114	def _require_gaithub_token(provided: str = "") -> str:
115	    tok = _get_gaithub_token(provided)
116	    if not tok:
117	        raise RuntimeError("GAITHUB_TOKEN is not set (and token was not provided as an argument).")
118	    return tok
119	
120	
121	def _remote_spec(repo: GaitRepo, remote: str, owner: str, repo_name: str) -> RemoteSpec:
122	    base_url = remote_get(repo, remote)
123	    return RemoteSpec(base_url=base_url, owner=owner, repo=repo_name, name=remote)
124	
125	
126	def _resolve_commit_prefix_from_head(repo: GaitRepo, head: str, prefix: str) -> str:
127	    prefix = prefix.strip()
128	    if not prefix:
129	        raise ValueError("empty commit prefix")
130	
131	    cid = head
132	    seen = set()
133	    while cid and cid not in seen:
134	        seen.add(cid)
135	        if cid.startswith(prefix):
136	            return cid
137	        c = repo.get_commit(cid)
138	        parents = c.get("parents") or []
139	        cid = parents[0] if parents else ""
140	    raise ValueError(f"Unknown commit or prefix: {prefix}")
141	
142	
143	def _resolve_revert_target(repo: GaitRepo, target: str) -> str:
144	    t = (target or "").strip()
145	    head = repo.head_commit_id() or ""
146	    if not head:
147	        raise ValueError("No HEAD commit to revert")
148	
149	    if not t:
150	        t = "HEAD~1"
151	
152	    m = re.fullmatch(r"HEAD~(\d+)", t.upper())
153	    if m:
154	        n = int(m.group(1))
155	        if n <= 0:
156	            raise ValueError("HEAD~N must be >= 1")
157	
158	        cid = head
159	        for _ in range(n):
160	            c = repo.get_commit(cid)
161	            parents = c.get("parents") or []
162	            cid = parents[0] if parents else ""
163	            if not cid:
164	                break
165	        return cid  # may be "" meaning empty
166	
167	    return _resolve_commit_prefix_from_head(repo, head, t)
168	
169	
170	def _unpack_wrapper_call(call_kwargs: Dict[str, Any]) -> Tuple[List[Any], Dict[str, Any]]:
171	    """
172	    Normalize wrapper calling styles into (args, kwargs).
173	
174	    Supported wrapper payloads:
175	      - {"args":[...], "kwargs":{...}}
176	      - {"call_args":[...], "call_kwargs":{...}}
177	
178	    If neither wrapper exists, treat call_kwargs as real kwargs (minus any stray wrapper keys).
179	    """
180	    if "call_args" in call_kwargs or "call_kwargs" in call_kwargs:
181	        akey, kkey = "call_args", "call_kwargs"
182	    else:
183	        akey, kkey = "args", "kwargs"
184	
185	    inner_args: List[Any] = []
186	    inner_kwargs: Dict[str, Any] = {}
187	
188	    if kkey in call_kwargs and isinstance(call_kwargs[kkey], dict):
189	        inner_kwargs = dict(call_kwargs[kkey])
190	
191	    if akey in call_kwargs and isinstance(call_kwargs[akey], list):
192	        inner_args = list(call_kwargs[akey])
193	
194	    # If wrapper DIDN'T actually use either form, treat outer kwargs as real kwargs.
195	    if not inner_args and not inner_kwargs:
196	        outer = dict(call_kwargs)
197	        outer.pop("args", None)
198	        outer.pop("kwargs", None)
199	        outer.pop("call_args", None)
200	        outer.pop("call_kwargs", None)
201	        return ([], outer)
202	
203	    return (inner_args, inner_kwargs)
204	
