31	            f"{COLOR_NAME}[%(name)s]{COLOR_RESET} "
32	            f"%(log_color)s[%(levelname)s]{COLOR_RESET} "
33	            f"{COLOR_MESSAGE}%(message)s{COLOR_RESET}"
34	        ),
