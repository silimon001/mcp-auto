170	            'updated_at': datetime.now(),
171	            'data_source': 'filesystem'
172	        }
173	
174	        # Extract CVE references from References section
175	        cves = []
176	
177	        # Method 1: Look for CVE references in the References array format
178	        # e.g., ['CVE', '2017-0144']
179	        cve_ref_matches = re.findall(r"\[\s*'CVE'\s*,\s*'([^']+)'\s*\]", content)
180	        for cve_num in cve_ref_matches:
181	            cves.append(f"CVE-{cve_num}")
182	
183	        # Method 2: Look for %w(CVE 2008-4250) format
184	        cve_w_matches = re.findall(r"%w\(\s*CVE\s+([^)]+)\)", content)
185	        for cve_num in cve_w_matches:
