1	import httpx
2	from datetime import datetime, timedelta
3	from zoneinfo import ZoneInfo
4	from mcp.server.fastmcp import FastMCP
5	from config import TICKTICK_API_BASE, HEADERS
6	
7	mcp = FastMCP("ticktick")
8	
9	
10	@mcp.tool()
11	async def get_projects():
12	    """
13	    Returns a list of projects from TickTick.
14	    """
15	    url = f"{TICKTICK_API_BASE}/project"
16	    async with httpx.AsyncClient() as client:
17	        response = await client.get(url, headers=HEADERS)
18	        return response.json()
19	
20	
21	@mcp.tool()
22	async def project_details(project_id: str):
23	    """
24	    Returns details of a specific project in TickTick.
25	    """
26	    url = f"{TICKTICK_API_BASE}/project/{project_id}/data"
27	    async with httpx.AsyncClient() as client:
28	        response = await client.get(url, headers=HEADERS)
29	        return response.json()
30	
31	
32	@mcp.tool()
33	async def get_today_tasks(timezone: str = "Asia/Jakarta"):
34	    """
35	    Returns all tasks due today across all projects.
36	
37	    Args:
38	        timezone: IANA timezone string (default: Asia/Jakarta).
39	    """
40	    tz = ZoneInfo(timezone)
41	    today_start = datetime.now(tz).replace(hour=0, minute=0, second=0, microsecond=0)
42	    today_end = today_start + timedelta(days=1)
43	
44	    async with httpx.AsyncClient() as client:
45	        # Get all projects
46	        resp = await client.get(f"{TICKTICK_API_BASE}/project", headers=HEADERS)
47	        data = resp.json()
48	        projects = data if isinstance(data, list) else data.get("projects", [])
49	
50	        today_tasks = []
51	        for project in projects:
52	            pid = project["id"]
53	            pname = project.get("name", "")
54	            resp = await client.get(
55	                f"{TICKTICK_API_BASE}/project/{pid}/data", headers=HEADERS
56	            )
57	            data = resp.json()
58	            tasks = data.get("tasks", [])
59	            for task in tasks:
60	                due = task.get("dueDate") or task.get("startDate")
61	                if not due:
62	                    continue
63	                # Parse TickTick date format (e.g. "2019-11-13T03:00:00+0000")
64	                try:
65	                    dt = datetime.fromisoformat(due.replace("+0000", "+00:00"))
66	                    dt_local = dt.astimezone(tz)
67	                    if today_start <= dt_local < today_end:
68	                        task["_projectName"] = pname
69	                        today_tasks.append(task)
70	                except (ValueError, TypeError):
71	                    continue
72	
73	        return today_tasks
74	
75	
76	@mcp.tool()
77	async def get_task_details(project_id: str, task_id: str):
78	    """
79	    Returns details of a specific task in TickTick.
80	    """
81	    url = f"{TICKTICK_API_BASE}/project/{project_id}/task/{task_id}"
82	    async with httpx.AsyncClient() as client:
83	        response = await client.get(url, headers=HEADERS)
84	        return response.json()
85	
86	
87	@mcp.tool()
88	async def create_project(project_name: str):
89	    """
90	    Creates a new project in TickTick.
91	
92	    Body Args:
93	    name, name of the project
94	    """
95	    url = f"{TICKTICK_API_BASE}/project"
96	    payload = {"name": project_name}
97	    async with httpx.AsyncClient() as client:
98	        response = await client.post(url, headers=HEADERS, json=payload)
99	        return response.json()
100	
101	
102	@mcp.tool()
103	async def create_task(
104	    project_id: str,
105	    title: str,
106	    content: str | None = None,
107	    desc: str | None = None,
108	    isAllDay: bool | None = None,
109	    startDate: str | None = None,
110	    dueDate: str | None = None,
111	    timeZone: str | None = None,
112	    reminders: list | None = None,
113	    repeatFlag: str | None = None,
114	    priority: int | None = 0,
115	    sortOrder: int | None = None,
116	    items: list | None = None,
117	):
118	    """
119	    Creates a new task in TickTick.
120	
121	    Args:
122	        project_id: ID of the project the task belongs to.
123	        title: Task title (required).
124	        content: Task content.
125	        desc: Description of checklist.
126	        isAllDay: All-day event flag.
127	        startDate: Start date/time (e.g., "2019-11-13T03:00:00+0000").
128	        dueDate: Due date/time (e.g., "2019-11-13T03:00:00+0000").
129	        timeZone: Time zone for the dates.
130	        reminders: List of reminders.
131	        repeatFlag: Recurrence rules.
132	        priority: Task priority (0=Normal, higher=higher priority).
133	        sortOrder: Sort order.
134	        items: List of subtasks (dicts with keys like 'title', 'startDate', etc.).
135	    """
136	    url = f"{TICKTICK_API_BASE}/task"
137	    payload = {
138	        "projectId": project_id,
139	        "title": title,
140	    }
141	    if content is not None:
142	        payload["content"] = content
143	    if desc is not None:
144	        payload["desc"] = desc
145	    if isAllDay is not None:
146	        payload["isAllDay"] = isAllDay
147	    if startDate is not None:
148	        payload["startDate"] = startDate
149	    if dueDate is not None:
150	        payload["dueDate"] = dueDate
151	    if timeZone is not None:
152	        payload["timeZone"] = timeZone
153	    if reminders is not None:
154	        payload["reminders"] = reminders
155	    if repeatFlag is not None:
156	        payload["repeatFlag"] = repeatFlag
157	    if priority is not None:
158	        payload["priority"] = priority
159	    if sortOrder is not None:
160	        payload["sortOrder"] = sortOrder
161	    if items is not None:
162	        payload["items"] = items
163	
164	    if isAllDay is False and startDate is None:
165	        pass
166	
167	    async with httpx.AsyncClient() as client:
168	        response = await client.post(url, headers=HEADERS, json=payload)
