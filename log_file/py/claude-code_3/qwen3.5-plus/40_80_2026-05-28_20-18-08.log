91	def configure_server(args: argparse.Namespace) -> Dict[str, Any]:
92	    """
93	    Configure server settings based on command line arguments.
94	
95	    Args:
96	        args: Command-line arguments
97	
98	    Returns:
99	        Dictionary of server configuration settings
100	    """
101	    # Override logging level if specified in command line
102	    if hasattr(args, 'log_level') and args.log_level:
103	        log_level = args.log_level
104	        logging.getLogger().setLevel(getattr(logging, log_level))
105	        logger.info(f"Log level set to {log_level}")
106	
107	    # Configure CORS for HTTP transport
108	    if hasattr(args, 'disable_cors') and args.disable_cors:
109	        msg = "CORS is disabled. This is not recommended for production."
110	        logger.warning(msg)
111	
112	    # Prepare server configuration
113	    server_config = {
114	        "name": "zoho-books",
115	        "version": "1.0.0",
116	    }
117	
118	    return server_config
