1	# main.py
2	from mcp.server.fastmcp import FastMCP
3	from mcp.server.sse import SseServerTransport
4	from starlette.applications import Starlette
5	from starlette.routing import Mount, Route
6	
7	# Import all tools
8	from tools import *
9	
10	# Create MCP server
11	mcp = FastMCP("ticktick_mcp")
12	
13	mcp.add_tool(get_projects)
14	mcp.add_tool(project_details)
15	mcp.add_tool(get_today_tasks)
16	mcp.add_tool(get_task_details)
17	mcp.add_tool(create_project)
18	mcp.add_tool(create_task)
19	mcp.add_tool(update_task)
20	mcp.add_tool(complete_task)
21	mcp.add_tool(delete_task)
22	
23	# Create SSE transport
24	tp = SseServerTransport("/messages/")
25	
26	
27	# Define handler functions for each server
28	async def handle_sse(request):
29	    async with tp.connect_sse(request.scope, request.receive, request._send) as streams:
30	        await mcp._mcp_server.run(
31	            streams[0],
32	            streams[1],
33	            mcp._mcp_server.create_initialization_options(),
34	        )
35	
36	
37	# Create a single Starlette app with different routes
38	routes = [
39	    Route("/sse", endpoint=handle_sse),
40	    Mount("/messages/", app=tp.handle_post_message),
41	]
42	
43	# Single Starlette app
44	app = Starlette(routes=routes)
45	
46	# Run the server
47	if __name__ == "__main__":
48	    import uvicorn
49	
50	    uvicorn.run(app, host="0.0.0.0", port=58321)
51	

