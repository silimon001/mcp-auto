826	        # Get bedtime config
827	        bedtime_hour = int(await db.get_config_value("bedtime_hour"))
828	        bedtime_minute = int(await db.get_config_value("bedtime_minute"))
829	        wakeup_hour = int(await db.get_config_value("wakeup_hour"))
830	        wakeup_minute = int(await db.get_config_value("wakeup_minute"))
831	
832	        # Calculate bedtime progress
833	        now = datetime.now()
834	        current_minutes = now.hour * 60 + now.minute
835	        bedtime_minutes = bedtime_hour * 60 + bedtime_minute
836	        wakeup_minutes = wakeup_hour * 60 + wakeup_minute
837	
838	        # Calculate awake period (handles overnight bedtime)
839	        if bedtime_minutes > wakeup_minutes:
840	            # Normal case: wake up in morning, sleep at night
841	            awake_duration = bedtime_minutes - wakeup_minutes
842	            if current_minutes >= wakeup_minutes:
843	                elapsed = current_minutes - wakeup_minutes
844	            else:
845	                # Before wakeup time (late night)
846	                elapsed = awake_duration + (current_minutes + 1440 - bedtime_minutes)
847	        else:
848	            # Edge case: bedtime before wakeup (e.g., night shift)
849	            awake_duration = 1440 - wakeup_minutes + bedtime_minutes
850	            if current_minutes >= wakeup_minutes:
851	                elapsed = current_minutes - wakeup_minutes
852	            else:
853	                elapsed = current_minutes + 1440 - wakeup_minutes
854	
855	        # Calculate percentage
856	        if awake_duration > 0:
857	            bedtime_percent = min(100, (elapsed / awake_duration) * 100)
858	        else:
859	            bedtime_percent = 0
860	
861	        # Check if past bedtime
862	        past_bedtime = False
863	        if bedtime_minutes > wakeup_minutes:
864	            past_bedtime = current_minutes >= bedtime_minutes or current_minutes < wakeup_minutes
865	        else:
