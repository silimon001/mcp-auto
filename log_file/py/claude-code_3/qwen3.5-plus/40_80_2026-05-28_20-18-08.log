18	def execute_masscan_streaming(target: str, ports: str, rate: int = 100, timeout: int = 300,
19	                             progress_callback=None) -> tuple[bool, str, Path]:
20	    """Execute masscan with streaming output processing and return success status, stderr output, and output file path."""
21	    try:
22	        # Create temporary output file
23	        with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
24	            output_file = Path(f.name)
25	
26	        # Build masscan command with banner grabbing
27	        cmd = [
28	            "sudo", "masscan",
29	            target,
30	            "-p", ports,
31	            "--rate", str(rate),
32	            "--banners",
33	            "-oJ", str(output_file)
34	        ]
35	
36	        # Execute scan with streaming output
37	        process = subprocess.Popen(
38	            cmd,
39	            stdout=subprocess.PIPE,
40	            stderr=subprocess.PIPE,
41	            text=True,
42	            bufsize=1,  # Line buffered
43	            universal_newlines=True
44	        )
45	
46	        stderr_output = ""
47	        hosts_found = 0
48	        ports_found = 0
49	
50	        try:
51	            # Monitor the output file for new results
52	            import time
53	            start_time = time.time()
54	            last_size = 0
55	
56	            while process.poll() is None:
57	                # Check for timeout
58	                if time.time() - start_time > timeout:
59	                    process.terminate()
60	                    process.wait(timeout=5)
61	                    return False, f"Scan timed out after {timeout} seconds", output_file
62	
63	                # Check if output file has grown
64	                if output_file.exists():
65	                    current_size = output_file.stat().st_size
66	                    if current_size > last_size:
67	                        # Process new content
68	                        new_results = _process_new_output(output_file, last_size)
69	                        if new_results:
70	                            for result in new_results:
71	                                if 'ip' in result and 'ports' in result:
72	                                    hosts_found += 1
73	                                    ports_found += len(result.get('ports', []))
74	
75	                                    # Call progress callback if provided
76	                                    if progress_callback:
77	                                        progress_callback({
78	                                            'type': 'host_found',
79	                                            'ip': result.get('ip'),
80	                                            'ports': result.get('ports', []),
81	                                            'total_hosts': hosts_found,
82	                                            'total_ports': ports_found
83	                                        })
84	
85	                        last_size = current_size
86	
87	                # Small delay to avoid busy waiting
88	                time.sleep(0.1)
89	
90	            # Wait for process to complete and get stderr
91	            _, stderr = process.communicate()
92	            stderr_output = stderr.strip()
93	
94	            # Process any remaining output
95	            if output_file.exists():
96	                final_results = _process_new_output(output_file, last_size)
97	                if final_results and progress_callback:
98	                    for result in final_results:
99	                        if 'ip' in result and 'ports' in result:
100	                            hosts_found += 1
101	                            ports_found += len(result.get('ports', []))
102	                            progress_callback({
103	                                'type': 'host_found',
104	                                'ip': result.get('ip'),
105	                                'ports': result.get('ports', []),
106	                                'total_hosts': hosts_found,
107	                                'total_ports': ports_found
108	                            })
109	
110	            # Final progress update
