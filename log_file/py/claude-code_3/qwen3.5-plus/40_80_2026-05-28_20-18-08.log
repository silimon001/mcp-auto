1085	        message=message or "",
1086	        include_merges=bool(include_merges),
1087	    )
1088	
1089	    return {
1090	        "ok": True,
1091	        "branch": r["branch"],
1092	        "mode": r["mode"],
1093	        "old_head": short_oid(r["old_head"]),
1094	        "new_head": short_oid(r["new_head"]),
1095	        "old_head_full": r["old_head"],
1096	        "new_head_full": r["new_head"],
1097	        "backup_ref": r.get("backup_ref", ""),
1098	        "squashed_commits": [short_oid(x) for x in r.get("squashed_commits", [])],
1099	        "squashed_commits_full": r.get("squashed_commits", []),
1100	        "base_parent": short_oid(r["base_parent"]) if r.get("base_parent") else "(empty)",
1101	        "turns_squashed": r.get("turns_squashed", 0),
1102	        "summary_turn_id": short_oid(r.get("summary_turn_id", "")),
1103	        "instruction": (
1104	            "HISTORY REWRITTEN: Do NOT call gait_record_turn for this action. "
1105	            "Immediately call gait_resume(turns=...) to re-sync your working context."
1106	        ),
1107	    }
