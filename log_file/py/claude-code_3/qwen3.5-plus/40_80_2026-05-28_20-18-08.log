350	                },
351	                "final_report": self._format_hacking_results(result, full_response)
352	            }
353	
354	        except Exception as e:
355	            end_time = datetime.now()
356	            duration = (end_time - start_time).total_seconds()
357	
358	            error_result = HackingResult(
359	                target_host=target_host,
360	                success=False,
361	                shells_obtained=[],
