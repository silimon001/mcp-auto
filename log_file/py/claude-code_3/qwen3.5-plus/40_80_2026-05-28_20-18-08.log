150	def parse_exploit_module_file(file_path, exploit_name):
151	    """Parse a Metasploit exploit module file to extract metadata."""
152	    try:
153	        with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
154	            content = f.read()
155	
156	        info = {
157	            'name': exploit_name,
158	            'description': f"Metasploit exploit module: {exploit_name}",
159	            'author': [],
