331	                shells_obtained=shells_obtained,
332	                vulnerabilities_found=vulnerabilities_found,
333	                credentials_found=credentials_found,
334	                methodology_steps=[],  # Not needed anymore
335	                duration_seconds=duration
336	            )
337	
338	            # Yield final completion status
339	            yield {
340	                "type": "complete",
341	                "success": success,
342	                "message": f"✅ Penetration test completed in {duration:.2f}s" if success else f"❌ Penetration test failed after {duration:.2f}s",
343	                "scan_id": scan_id,
344	                "scan_display_id": scan_display_id,
