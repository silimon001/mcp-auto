118	async def create_meme_advanced(
119	    template_id: str, 
120	    boxes: List[Dict[str, Any]], 
121	    font: str = "impact", 
122	    max_font_size: str = "50"
123	) -> Dict[str, Any]:
124	    """
125	    Create a meme using the Imgflip API with advanced options
126	    
127	    Args:
128	        template_id: The ID of the meme template to use
129	        boxes: List of box objects, each containing text and optional positioning info
130	        font: Font family to use (default: "impact")
131	        max_font_size: Maximum font size in pixels (default: "50")
132	        
133	    Returns:
134	        dict: API response with success status and data or error message
135	    """
136	    url = "https://api.imgflip.com/caption_image"
137	    
138	    username = os.getenv("IMGFLIP_USERNAME")
139	    password = os.getenv("IMGFLIP_PASSWORD")
140	    
141	    if not username or not password:
142	        return {
143	            "success": False, 
144	            "error_message": "IMGFLIP_USERNAME and IMGFLIP_PASSWORD environment variables are required"
145	        }
146	    
147	    # Prepare the payload using FormData format
148	    form_data = aiohttp.FormData()
149	    form_data.add_field("template_id", template_id)
150	    form_data.add_field("username", username)
151	    form_data.add_field("password", password)
152	    form_data.add_field("font", font)
153	    form_data.add_field("max_font_size", max_font_size)
154	    
155	    # If there are exactly 2 boxes and they only have text (no positioning),
156	    # we can use the simpler text0/text1 format for better compatibility
157	    if len(boxes) == 2 and all(set(box.keys()) == {"text"} for box in boxes):
158	        form_data.add_field("text0", boxes[0]["text"])
159	        form_data.add_field("text1", boxes[1]["text"])
160	    else:
161	        # Otherwise use the boxes parameter
162	        for i, box in enumerate(boxes):
163	            form_data.add_field(f"text{i}", box["text"])
164	    
165	    try:
166	        async with aiohttp.ClientSession() as session:
167	            async with session.post(url, data=form_data) as response:
168	                # Check HTTP status code first
169	                if response.status != 200:
170	                    return {
171	                        "success": False,
172	                        "error_message": f"HTTP error: {response.status} - {response.reason}"
173	                    }
174	                
175	                # Parse JSON response
176	                try:
177	                    data = await response.json()
178	                except json.JSONDecodeError:
179	                    return {
180	                        "success": False,
181	                        "error_message": "Invalid JSON response from ImgFlip API"
182	                    }
183	                
184	                # Check if the API returned a success response
185	                if not data.get("success"):
186	                    error_message = data.get("error_message", "Unknown API error")
187	                    logging.error(f"ImgFlip API error: {error_message}")
188	                    return {"success": False, "error_message": error_message}
189	                
190	                # Handle potential missing data in success response
191	                if "data" not in data or "url" not in data.get("data", {}):
192	                    return {
193	                        "success": False,
194	                        "error_message": "API returned success but no meme URL was provided"
195	                    }
196	                
197	                return data
198	    except aiohttp.ClientError as e:
199	        logging.error(f"Error connecting to ImgFlip API: {str(e)}")
200	        return {"success": False, "error_message": f"Connection error: {str(e)}"}
201	    except Exception as e:
202	        logging.error(f"Unexpected error creating meme: {str(e)}")
203	        return {"success": False, "error_message": f"Unexpected error: {str(e)}"}

