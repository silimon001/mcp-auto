87	def safe_convert_to_serializable(obj):
88	    """Convert objects to JSON-serializable format, handling all edge cases."""
89	    try:
90	        if isinstance(obj, (str, int, float, bool, type(None))):
91	            return obj
92	        elif isinstance(obj, (list, tuple)):
93	            return [safe_convert_to_serializable(item) for item in obj]
94	        elif isinstance(obj, dict):
95	            # Convert all keys to strings to avoid MongoDB key restrictions
96	            result = {}
97	            for k, v in obj.items():
98	                try:
99	                    key_str = str(k)
100	                    result[key_str] = safe_convert_to_serializable(v)
101	                except Exception:
102	                    # If conversion fails, skip this key-value pair
103	                    continue
104	            return result
105	        else:
106	            # For any other type, convert to string
107	            return str(obj)
108	    except Exception:
109	        # If all else fails, return a safe string representation
110	        return f"<conversion_error: {type(obj).__name__}>"
