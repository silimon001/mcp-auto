188	        # Method 3: Also search for direct CVE patterns in the entire content
189	        cve_pattern = r'CVE-\d{4}-\d{4,7}'
190	        direct_cves = re.findall(cve_pattern, content, re.IGNORECASE)
191	        cves.extend(direct_cves)
192	
193	        info['cve_references'] = list(set(cves))  # Remove duplicates
194	
195	        # Extract description
196	        desc_match = re.search(r"'Description'\s*=>\s*%q\{([^}]+)\}", content, re.DOTALL)
197	        if not desc_match:
198	            desc_match = re.search(r"'Description'\s*=>\s*'([^']+)'", content)
199	        if not desc_match:
200	            desc_match = re.search(r"'Description'\s*=>\s*\"([^\"]+)\"", content)
201	        if desc_match:
202	            info['description'] = desc_match.group(1).strip()
203	
204	        # Extract author(s)
205	        author_matches = re.findall(r"'Author'\s*=>\s*\[(.*?)\]", content, re.DOTALL)
206	        if author_matches:
207	            author_text = author_matches[0]
208	            # Extract individual authors
209	            authors = re.findall(r"'([^']+)'", author_text)
210	            info['author'] = ', '.join(authors)
211	        else:
212	            # Single author
213	            author_match = re.search(r"'Author'\s*=>\s*'([^']+)'", content)
214	            if author_match:
215	                info['author'] = author_match.group(1)
216	
217	        # Extract disclosure date
218	        date_match = re.search(r"'DisclosureDate'\s*=>\s*'([^']+)'", content)
219	        if date_match:
220	            info['disclosure_date'] = date_match.group(1)
221	
222	        # Extract rank
223	        rank_match = re.search(r"Rank\s*=\s*(\w+)", content)
224	        if rank_match:
225	            info['rank'] = rank_match.group(1).replace('Ranking', '')  # Remove 'Ranking' suffix
226	
227	        # Extract payload constraints/info from the module
228	        payload_info = []
229	
230	        # Look for payload space constraints
231	        space_match = re.search(r"'Space'\s*=>\s*(\d+)", content)
232	        if space_match:
233	            payload_info.append(f"Space: {space_match.group(1)} bytes")
234	
235	        # Look for payload arch constraints - handle multiple formats
236	        # Format 1: 'Arch' => [ARCH_X64]
237	        arch_match = re.search(r"'Arch'\s*=>\s*\[(.*?)\]", content, re.DOTALL)
238	        if arch_match:
