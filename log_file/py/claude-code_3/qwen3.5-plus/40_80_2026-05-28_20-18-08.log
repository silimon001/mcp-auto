1	"""
2	    * SPDX-FileCopyrightText: Copyright 2025 LG Electronics Inc.
3	    * SPDX-License-Identifier: Apache-2.0
4	"""
5	import logging
6	import os
7	from typing import Final
8	
9	from dotenv import load_dotenv
10	from mcp.server.fastmcp import FastMCP
11	from thinqconnect import ThinQApi
12	
13	import thinqconnect_mcp.prompts as prompts
14	import thinqconnect_mcp.tools as tools
15	
16	# Environment Variables
17	load_dotenv()
18	PAT: Final[str] = os.getenv("THINQ_PAT")
19	COUNTRY: Final[str] = os.getenv("THINQ_COUNTRY")
20	
21	# Constants
22	CLIENT_ID: Final[str] = "thinqconnect-mcp-client"
23	MCP_NAME: Final[str] = "thinqconnect-mcp"
24	
25	
26	# Validation for environment variables
27	def validate_config() -> None:
28	    if not PAT:
29	        raise ValueError("PAT is not configured. Please set the THINQ_PAT environment variable.")
30	    if not COUNTRY:
31	        raise ValueError("Country code is not configured. Please set the THINQ_COUNTRY environment variable.")
32	
33	
34	# Configure logging
35	logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(name)s - %(levelname)s - %(message)s")
36	logger = logging.getLogger(__name__)
37	
38	
39	def setup_thinq_api() -> ThinQApi:
40	    """Initialize and configure ThinQ API client"""
41	    thinq_api = ThinQApi(session=None, access_token=PAT, country_code=COUNTRY, client_id=CLIENT_ID)
42	    thinq_api.set_log_level("DEBUG")
43	    return thinq_api
44	
45	
46	def setup_mcp() -> FastMCP:
47	    """Initialize and configure MCP server"""
48	    return FastMCP(name=MCP_NAME)
49	
50	
51	# Initialize MCP and API
52	validate_config()
53	mcp = setup_mcp()
54	thinq_api = setup_thinq_api()
55	
56	
57	# Prompt handlers
58	@mcp.prompt("I want to know how to use the ThinQ Connect MCP Server")
59	async def welcome_prompt() -> str:
60	    return prompts.welcome_prompt()
61	
62	
63	# Tool handlers
64	@mcp.tool(
65	    description="""Retrieves a list of all devices connected to the ThinQ Connect platform
66	    Args:
67	        None
68	
69	    Returns:
70	        String containing connected device list information
71	    """
72	)
73	async def get_device_list() -> str:
74	    return await tools.get_device_list(thinq_api=thinq_api)
75	
76	
77	@mcp.tool(
78	    description="""Retrieves available control commands and parameter information for a specific device
79	    Args:
80	        device_type: Device type (e.g., DEVICE_AIR_CONDITIONER, DEVICE_ROBOT_CLEANER, DEVICE_STYLER)
81	        device_id: Unique ID of the device to query
82	
83	    Returns:
84	        String containing device control commands and parameter information
85	    """
86	)
87	async def get_device_available_controls(device_type: str, device_id: str) -> str:
88	    return await tools.get_device_available_controls(thinq_api=thinq_api, device_type=device_type, device_id=device_id)
89	
90	
91	@mcp.tool(
92	    description="""Retrieves status information for a specific device
93	    Args:
94	        device_id: Unique ID of the device to query
95	
96	    Returns:
97	        String containing device status information
98	    """
99	)
100	async def get_device_status(device_id: str) -> str:
101	    return await tools.get_device_status(thinq_api=thinq_api, device_id=device_id)
102	
103	
104	@mcp.tool(
105	    description="""Send control commands to a specific device on the ThinQ Connect platform to change its settings or state
106	    Args:
107	        device_type: Device type (e.g., DEVICE_AIR_CONDITIONER, DEVICE_ROBOT_CLEANER, DEVICE_STYLER)
108	        device_id: Unique ID of the device to control
109	        control_method: Co ntrol method name to execute (e.g., set_air_con_operation_mode, set_target_temperature, set_wind_strength)
110	        control_params: Parameter dictionary to pass to the control method (e.g., {'operation': 'POWER_OFF'}, {'temperature': 25}, {'wind_strength': 'HIGH'})
111	
112	    Returns:
113	        String containing device control result message
114	    """
115	)
116	async def post_device_control(
117	    device_type: str,
118	    device_id: str,
119	    control_method: str,
120	    control_params: dict,
121	) -> str:
122	    return await tools.post_device_control(
123	        thinq_api=thinq_api,
124	        device_type=device_type,
125	        device_id=device_id,
126	        control_method=control_method,
127	        control_params=control_params,
128	    )
129	
130	
131	def main() -> None:
132	    """Main entry point of the application"""
133	    try:
134	        mcp.run()
135	    except Exception as e:
