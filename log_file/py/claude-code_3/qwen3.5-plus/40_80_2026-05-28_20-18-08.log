132	def _process_new_output(output_file: Path, last_position: int) -> list[dict]:
133	    """Process new content in the output file since last_position."""
134	    results = []
135	
136	    try:
137	        with open(output_file, 'r') as f:
138	            f.seek(last_position)
139	            for line in f:
140	                line = line.strip()
141	                if line and not line.startswith('#'):
142	                    try:
143	                        data = json.loads(line)
144	                        results.append(data)
145	                    except json.JSONDecodeError:
146	                        continue
147	    except Exception:
148	        pass
149	
150	    return results
