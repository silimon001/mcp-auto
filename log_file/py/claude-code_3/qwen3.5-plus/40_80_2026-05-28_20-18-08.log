1057	# Squash 
1058	# ---------------------------------------------------------------------
1059	@mcp_tool
1060	@mcp.tool()
1061	def gait_summarize_and_squash(
1062	    last: int = 10,
1063	    mode: str = "soft",
1064	    message: str = "",
1065	    include_merges: bool = False,
1066	    path: Optional[str] = None,
1067	) -> Dict[str, Any]:
1068	    """Squash the last N turn-commits into one summary commit (context compression). Safe by default (mode=soft creates a backup ref).
1069	
1070	    Args:
1071	        last: Number of recent commits to squash (default: 10)
1072	        mode: Squash mode - 'soft' creates backup ref, 'hard' does not (default: soft)
1073	        message: Optional message for the squashed commit
1074	        include_merges: Whether to include merge commits in the squash
1075	        path: Optional path to the GAIT repository
1076	    """
1077	    repo, err = _try_repo(path)
1078	    if err:
1079	        return err
1080	    assert repo is not None
1081	
1082	    r = repo.summarize_and_squash(
