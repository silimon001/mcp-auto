1	"""FastMCP server factory and lifespan management."""
2	
3	from __future__ import annotations
4	
5	import logging
6	from collections.abc import AsyncIterator
7	from contextlib import asynccontextmanager
8	from dataclasses import dataclass, field
9	from typing import Any
10	
11	from mcp.server.fastmcp import FastMCP
12	from psycopg_pool import AsyncConnectionPool
13	
14	from .config import Settings
15	from .db import build_pool
16	from .prompts import register_prompts
17	from .resources import register_resources
18	from .schema import load_schema
19	from .tools import (
20	    discover_predefined_tools,
21	    register_custom_sql,
22	    register_predefined_tools,
23	    register_schema_tool,
24	)
25	
26	logger = logging.getLogger(__name__)
27	
28	
29	@dataclass
30	class AppContext:
31	    """Per-process state exposed to tools via the request context."""
32	
33	    pool: AsyncConnectionPool
34	    schema: list[dict[str, Any]] | None = field(default=None)
35	
36	
37	def create_server(settings: Settings) -> FastMCP:
38	    """Build the FastMCP server, wire up the lifespan, and register all tools."""
39	
40	    @asynccontextmanager
41	    async def lifespan(_server: FastMCP) -> AsyncIterator[AppContext]:
42	        pool = build_pool(settings)
43	        await pool.open()
44	        logger.info(
45	            "Database pool opened (min=%d, max=%d)",
46	            settings.pool_min_size,
47	            settings.pool_max_size,
48	        )
49	        try:
50	            schema = await load_schema(pool)
51	            logger.info("Loaded schema: %d columns cached", len(schema))
52	            yield AppContext(pool=pool, schema=schema)
53	        finally:
54	            await pool.close()
55	            logger.info("Database pool closed")
56	
57	    mcp = FastMCP(
58	        "teslamate",
59	        lifespan=lifespan,
60	        host=settings.host,
61	        port=settings.port,
62	        debug=settings.debug,
63	    )
64	
65	    tools = discover_predefined_tools()
66	    register_predefined_tools(mcp, tools)
67	    register_schema_tool(mcp)
68	    register_custom_sql(
69	        mcp,
70	        statement_timeout_ms=settings.query_timeout_ms,
71	        row_limit=settings.custom_sql_row_limit,
72	    )
73	    register_resources(mcp, tools)
74	    register_prompts(mcp)
75	    logger.info(
76	        "Registered %d predefined tools + run_sql + get_database_schema + 2 resources + 6 prompts",
77	        len(tools),
78	    )
79	
80	    return mcp
81	

