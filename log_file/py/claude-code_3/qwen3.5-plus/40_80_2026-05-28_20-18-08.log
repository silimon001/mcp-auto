124	def format_note_info(
125	    note_id: str,
126	    title: str,
127	    created_time: datetime | None = None,
128	    updated_time: datetime | None = None,
129	    is_todo: bool = False
130	) -> str:
131	    """Format note information for display.
132	    
133	    Args:
