97	    # Check all service types in constants.py
98	    for service in [
99	        "http", "ftp", "ssh", "telnet", "smtp", "pop3", "imap", 
100	        "dns", "ldap", "mysql", "postgresql", "redis", "mongodb",
101	        "rdp", "vnc", "smb", "ntp", "snmp"
