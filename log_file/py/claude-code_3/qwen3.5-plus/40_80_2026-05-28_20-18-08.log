62	
63	        # Extract title from first heading or use filename
64	        lines = content.splitlines()
65	        title = file_path.stem
66	
67	        for line in lines:
68	            if line.startswith('# '):
69	                title = line[2:].strip()
70	                content = '\n'.join(lines[1:]).strip()
71	                break
72	
73	        return cls(
74	            title=title,
75	            content=content,
76	            source_path=file_path,
