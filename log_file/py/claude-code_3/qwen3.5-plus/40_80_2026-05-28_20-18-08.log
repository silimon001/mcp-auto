278	def port_scan_streaming(target: str, ports: str, scan_type: str = "tcp_syn", rate: int = 100,
279	                       progress_callback=None) -> dict:
280	    """
281	    NETWORK PORT SCANNING: Discover open ports on hosts using masscan with real-time progress.
282	
283	    This function performs PORT DISCOVERY to find open TCP/UDP ports on target hosts
284	    and provides real-time progress updates via callback.
285	
286	    Args:
287	        target: IP address or CIDR range to scan
288	        ports: Comma-separated ports or ranges
289	        scan_type: Type of scan (tcp_syn, tcp_connect, udp, etc.)
290	        rate: Packets per second rate
291	        progress_callback: Function to call with progress updates
292	
293	    Returns:
294	        Dictionary with scan results
295	    """
296	    try:
297	        # Generate scan ID and start time
298	        scan_id = str(uuid.uuid4())
299	        start_time = datetime.now()
300	
301	        # Create initial scan record
302	        database.create_scan_record(scan_id, target, ports, scan_type, start_time)
303	
304	        # Progress tracking
305	        discovered_hosts = []
306	        total_hosts_found = 0
307	        total_ports_found = 0
308	
309	        def internal_progress_callback(progress_data):
310	            nonlocal total_hosts_found, total_ports_found
311	
312	            if progress_data['type'] == 'host_found':
313	                # Process and store the new host data immediately
314	                ip = progress_data['ip']
315	                port_data = progress_data['ports']
316	
317	                # Convert to our expected format
318	                host_entry = {"ip": ip, "ports": []}
319	
320	                for port_info in port_data:
321	                    port = port_info.get('port')
322	                    protocol = port_info.get('proto', 'tcp')
323	                    state = port_info.get('status', 'open')
324	                    service_info = port_info.get('service', {})
325	
326	                    if port:
327	                        # Get banner info if available
328	                        banner_info = {}
329	                        if service_info:
330	                            service_name = service_info.get('name', 'unknown')
331	                            banner_text = service_info.get('banner', '').strip()
332	                            banner_info = {
333	                                "service": service_name,
334	                                "version": "",
335	                                "banner": banner_text
336	                            }
337	                        else:
338	                            # Try to get banner with netcat
339	                            try:
340	                                banner_info = getBanner(ip, port)
341	                            except Exception:
342	                                banner_info = {"service": "unknown", "version": "", "banner": ""}
343	
344	                        host_entry["ports"].append({
345	                            "port": port,
346	                            "protocol": protocol,
347	                            "state": state,
348	                            "service": banner_info.get("service", "unknown"),
349	                            "version": banner_info.get("version", ""),
350	                            "banner": banner_info.get("banner", "")
351	                        })
352	
353	                discovered_hosts.append(host_entry)
354	                total_hosts_found = progress_data['total_hosts']
355	                total_ports_found = progress_data['total_ports']
356	
357	                # Save incremental results to database
358	                try:
359	                    database.save_incremental_scan_result(scan_id, host_entry)
360	                except Exception as e:
361	                    print(f"Warning: Failed to save incremental result: {e}")
362	
363	                # Call user's progress callback
364	                if progress_callback:
365	                    progress_callback({
366	                        'type': 'host_discovered',
367	                        'scan_id': scan_id,
368	                        'host': host_entry,
369	                        'total_hosts': total_hosts_found,
370	                        'total_ports': total_ports_found,
371	                        'message': f"Found host {ip} with {len(host_entry['ports'])} open ports"
372	                    })
373	
374	            elif progress_data['type'] == 'scan_complete':
375	                if progress_callback:
376	                    progress_callback({
377	                        'type': 'scan_complete',
378	                        'scan_id': scan_id,
379	                        'total_hosts': total_hosts_found,
380	                        'total_ports': total_ports_found,
381	                        'return_code': progress_data['return_code']
382	                    })
383	
384	        # Execute the scan with streaming (use default 5-minute timeout)
385	        success, error_output, output_file = execute_masscan_streaming(
386	            target, ports, rate, progress_callback=internal_progress_callback
387	        )
388	
389	        end_time = datetime.now()
390	        duration = (end_time - start_time).total_seconds()
391	
392	        if not success:
393	            # Update scan record with error
394	            database.update_scan_status(
395	                scan_id,
396	                "failed",
397	                end_time,
398	                duration,
399	                0,
400	                0,
401	                "",
402	                error_output
403	            )
404	
405	            return {
406	                "success": False,
407	                "error": f"Masscan command failed: {error_output}",
408	                "scan_id": scan_id,
409	                "target": target,
410	                "ports": ports
411	            }
412	
413	        # Final processing of any remaining results
414	        final_hosts = parse_masscan_results(output_file)
415	
416	        # Merge with discovered hosts (in case we missed any)
417	        all_hosts = discovered_hosts.copy()
418	        for host in final_hosts:
419	            # Check if we already have this host
420	            existing_host = None
421	            for existing in all_hosts:
422	                if existing["ip"] == host["ip"]:
423	                    existing_host = existing
424	                    break
425	
426	            if not existing_host:
427	                all_hosts.append(host)
428	
429	        # Save final results to database
430	        total_hosts, total_open_ports = database.save_scan_results(
431	            scan_id, target, ports, scan_type, start_time, end_time, all_hosts
432	        )
433	
434	        return {
435	            "success": True,
436	            "scan_id": scan_id,
437	            "target": target,
438	            "ports_scanned": ports,
439	            "scan_type": scan_type,
440	            "total_hosts": total_hosts,
441	            "total_open_ports": total_open_ports,
442	            "hosts": all_hosts,
443	            "duration_seconds": duration,
444	            "message": f"Scan completed - found {total_hosts} hosts with {total_open_ports} open ports"
445	        }
446	
447	    except Exception as e:
448	        return {
449	            "success": False,
450	            "error": str(e),
451	            "scan_id": scan_id if 'scan_id' in locals() else None
452	        }
453	
454	
455	def port_scan(target: str, ports, scan_type: str = "tcp_syn", rate: int = 100) -> dict:
456	    """
457	    NETWORK PORT SCANNING: Discover open ports on hosts using masscan.
458	
459	    This function performs PORT DISCOVERY to find open TCP/UDP ports on target hosts.
460	    This is the legacy synchronous version for backward compatibility.
461	
462	    Args:
463	        target: IP address or CIDR range to scan
464	        ports: Comma-separated ports or ranges
465	        scan_type: Type of scan (tcp_syn, tcp_connect, udp, etc.)
466	        rate: Packets per second rate
467	
468	    Returns:
