1	#!/usr/bin/env python3
2	"""
3	Domain Discovery Tool - Red Team MCP
4	
5	This tool is used to enumerate subdomains from a top level domain using subfinder.
6	
7	Features:
8	1. Validate that the domain resolves using DNS
9	2. Execute subfinder tool to discover subdomains
10	3. Resolve each subdomain to IP address
11	4. Store results in database and return structured response
12	"""
13	
14	import asyncio
15	import json
16	import socket
17	import subprocess
18	import uuid
19	from datetime import datetime
20	from typing import List, Dict, Optional, Callable
21	from pathlib import Path
22	
23	# Handle both relative and absolute imports
24	try:
25	    from . import database
26	except ImportError:
27	    # When running directly, use absolute import
28	    import database
29	
30	# Check if database is available
31	try:
32	    database.get_database()
33	    DATABASE_AVAILABLE = True
34	except Exception:
35	    DATABASE_AVAILABLE = False
36	    print("⚠️  Database not available for domain discovery")
37	
38	
39	def validate_domain_resolution(domain: str, timeout: int = 10) -> tuple[bool, str, str]:
40	    """
41	    Validate that a domain resolves to an IP address.
42	
43	    Args:
44	        domain: Domain name to validate
45	        timeout: DNS resolution timeout in seconds
46	
47	    Returns:
48	        Tuple of (success, ip_address, error_message)
49	    """
50	    try:
51	        # Remove any protocol prefixes and paths
52	        clean_domain = domain.replace('http://', '').replace('https://', '').split('/')[0]
53	
54	        # Use asyncio.wait_for equivalent for sync code with signal timeout
55	
56	        ip_address = socket.gethostbyname(clean_domain)
57	        return True, ip_address, ""
58	
59	    except socket.timeout as e:
60	        return False, "", str(e)
61	    except socket.gaierror as e:
62	        return False, "", f"DNS resolution failed: {str(e)}"
63	    except Exception as e:
64	        return False, "", f"Domain validation error: {str(e)}"
65	
66	
67	def execute_subfinder(domain: str, timeout: int = 300) -> tuple[bool, List[str], str]:
68	    """
69	    Execute subfinder tool to discover subdomains.
70	
71	    Args:
72	        domain: Target domain to scan for subdomains
73	        timeout: Execution timeout in seconds
74	
75	    Returns:
76	        Tuple of (success, subdomains_list, error_message)
77	    """
78	    try:
79	        # Clean domain name
80	        clean_domain = domain.replace('http://', '').replace('https://', '').split('/')[0]
81	
82	        # Build subfinder command
83	        cmd = [
84	            "subfinder",
85	            "-d", clean_domain,
86	            "-silent",  # Only output subdomains
87	            "-timeout", "10",  # Per-request timeout
88	        ]
89	
90	        print(f"🔍 Executing subfinder: {' '.join(cmd)}")
91	
92	        # Execute subfinder with timeout
93	        process = subprocess.Popen(
94	            cmd,
95	            stdout=subprocess.PIPE,
96	            stderr=subprocess.PIPE,
97	            text=True,
98	            universal_newlines=True
99	        )
100	
101	        try:
102	            stdout, stderr = process.communicate(timeout=timeout)
103	        except subprocess.TimeoutExpired:
104	            process.kill()
105	            process.wait()
106	            return False, [], f"Subfinder timed out after {timeout} seconds"
107	
108	        if process.returncode != 0:
109	            return False, [], f"Subfinder failed with exit code {process.returncode}: {stderr}"
110	
111	        # Parse subdomains from output
112	        subdomains = []
113	        for line in stdout.strip().split('\n'):
114	            line = line.strip()
115	            if line and not line.startswith('#'):
116	                subdomains.append(line)
117	
118	        return True, subdomains, ""
119	
120	    except FileNotFoundError:
121	        return False, [], "Subfinder tool not found. Please install subfinder: https://github.com/projectdiscovery/subfinder"
122	    except Exception as e:
123	        return False, [], f"Subfinder execution error: {str(e)}"
124	
125	
126	def resolve_subdomain_to_ip(subdomain: str, timeout: int = 5) -> tuple[bool, str, str]:
127	    """
128	    Resolve a subdomain to its IP address.
129	
130	    Args:
131	        subdomain: Subdomain to resolve
132	        timeout: DNS resolution timeout in seconds
133	
134	    Returns:
135	        Tuple of (success, ip_address, error_message)
136	    """
137	    try:
138	        ip_address = socket.gethostbyname(subdomain)
139	        return True, ip_address, ""
140	    except Exception as e:
141	        return False, "", f"DNS resolution failed: {str(e)}"
142	
143	def discover_subdomains(domain: str, timeout: int = 300) -> dict:
144	    """
145	    Main domain discovery function that orchestrates the entire process.
146	
147	    Args:
148	        domain: Target domain to discover subdomains for
149	        timeout: Overall timeout for the discovery process
150	        progress_callback: Optional callback for progress updates
151	
152	    Returns:
153	        Dictionary with discovery results
154	    """
155	    scan_id = str(uuid.uuid4())
156	    start_time = datetime.now()
157	
158	    try:
159	        print(f"🌐 Starting subdomain discovery for: {domain}")
160	        # Step 1: Validate main domain resolves
161	        print(f"🔍 Validating domain resolution...")
162	        domain_valid, domain_ip, domain_error = validate_domain_resolution(domain)
163	
164	        if not domain_valid:
165	            error_msg = f"Domain validation failed: {domain_error}"
166	            print(f"❌ {error_msg}")
167	            return {
168	                "success": False,
169	                "error": error_msg,
170	                "scan_id": scan_id,
171	                "domain": domain
172	            }
173	
174	        print(f"✅ Domain {domain} resolves to {domain_ip}")
175	
176	
177	        # Create initial scan record
178	        if DATABASE_AVAILABLE:
179	            database.create_scan_record(scan_id, domain, "subdomains", "domain-discovery", start_time)
180	
181	        # Step 2: Execute subfinder to discover subdomains
182	        print(f"🔍 [domain-discovery] Discovering subdomains using subfinder...")
183	        subfinder_success, subdomains, subfinder_error = execute_subfinder(domain, timeout)
184	
185	        if not subfinder_success:
186	            error_msg = f"Subfinder execution failed: {subfinder_error}"
187	            print(f"❌ [domain-discovery] {error_msg}")
188	            return {
189	                "success": False,
190	                "error": error_msg,
191	                "scan_id": scan_id,
192	                "domain": domain
193	            }
194	
195	        print(f"✅ [domain-discovery] Found {len(subdomains)} subdomains")
196	
197	        # Step 3: Resolve each subdomain to IP
198	        print(f"🔍 [domain-discovery] Resolving subdomains to IP addresses...")
199	        resolved_subdomains = []
200	
201	        for i, subdomain in enumerate(subdomains):
202	
203	            resolve_success, subdomain_ip, resolve_error = resolve_subdomain_to_ip(subdomain)
204	
205	            if resolve_success:
206	                print(f"✅ [domain-discovery] {subdomain} -> {subdomain_ip}")
207	                resolved_subdomains.append({
208	                    "subdomain": subdomain,
209	                    "ip_address": subdomain_ip,
210	                    "resolved": True
211	                })
212	
213	                # Save to database
214	                if DATABASE_AVAILABLE:
215	                    database.save_scan_result_entry(
216	                        scan_id=scan_id,
217	                        hostname=subdomain,
218	                        ip_address=subdomain_ip,
219	                        port=0,  # Not applicable for domain discovery
220	                        protocol="dns",
221	                        state="resolved",
222	                        service="domain",
223	                        version="",
224	                        banner="",
225	                        agent="domain-discovery"
226	                    )
227	            else:
228	                print(f"❌ [domain-discovery] {subdomain} -> resolution failed: {resolve_error}")
229	                resolved_subdomains.append({
230	                    "subdomain": subdomain,
231	                    "ip_address": "",
232	                    "resolved": False,
233	                    "error": resolve_error
234	                })
235	
236	        end_time = datetime.now()
237	        duration = (end_time - start_time).total_seconds()
238	
239	        # Count successful resolutions
240	        successful_resolutions = len([s for s in resolved_subdomains if s["resolved"]])
241	
242	        print(f"✅ [domain-discovery] Discovery completed: {successful_resolutions}/{len(subdomains)} subdomains resolved")
243	
244	        # Update scan status
245	        if DATABASE_AVAILABLE:
246	            database.update_scan_status(
247	                scan_id,
248	                "completed",
249	                end_time,
250	                duration,
251	                successful_resolutions,
252	                len(subdomains),
253	                json.dumps(resolved_subdomains)
254	            )
255	
256	        return {
257	            "success": True,
