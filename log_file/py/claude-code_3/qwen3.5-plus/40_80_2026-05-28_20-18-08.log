1	"""
2	Utility functions for the Joplin API client.
3	"""
4	
5	import logging
6	import os
7	from dataclasses import dataclass
8	from datetime import datetime
9	from pathlib import Path
10	
11	from dotenv import load_dotenv
12	
13	logger = logging.getLogger(__name__)
14	
15	class JoplinConfigError(Exception):
16	    """Raised when there is an error with the Joplin configuration."""
17	
18	    def __init__(self, message: str, env_var: str | None = None):
19	        self.env_var = env_var
20	        super().__init__(message)
21	
22	@dataclass
23	class MarkdownContent:
24	    """Represents parsed content from a Markdown file.
25	    
26	    Attributes:
27	        title: The title extracted from the first heading or filename
28	        content: The main content of the file
29	        source_path: Original path to the markdown file
30	        created_time: When the file was created
