155	@mcp.tool()
156	async def read_folder(
157	    ctx: Context,
158	    folder_id: str = Field(
159	        ..., description="Primary key ID of the folder to read (e.g., 'p2330')"
160	    ),
161	    folder_name: str = Field(..., description="Name of the folder to verify and read"),
162	) -> str:
163	    """Read a folder by its primary key ID with AppleScript verification.
164	
165	    Security Features:
166	    - Verifies folder exists with the given ID and name
167	    - Uses primary key ID for precise identification
168	    - Returns detailed folder information with contents
169	
170	    Output:
171	    - Folder metadata (name, ID, creation/modification dates)
172	    - Direct child folders (names and IDs)
173	    - Notes in the folder (names and IDs)
174	    - Summary counts
175	    """
176	    try:
177	        folder_data = await notes_tools.read_folder(folder_id, folder_name)
178	
179	        # Format the response
180	        result = "Folder Details:\n"
181	        result += f"Folder Name: {folder_data.get('name', 'N/A')}\n"
182	        result += f"Folder ID: {folder_data.get('folder_id', 'N/A')}\n"
183	        result += f"Creation Date: {folder_data.get('creation_date', 'N/A')}\n"
184	        result += (
185	            f"Modification Date: {folder_data.get('modification_date', 'N/A')}\n\n"
186	        )
187	
188	        # Child folders section
189	        child_folders = folder_data.get("child_folders", [])
190	        child_folders_count = folder_data.get("child_folders_count", 0)
191	        result += f"Direct Child Folders ({child_folders_count}):\n"
192	
193	        if child_folders:
194	            for i, child_folder in enumerate(child_folders, 1):
195	                result += f"  {i:2d}. {child_folder.get('name', 'N/A')}\n"
196	                result += f"      ID: {child_folder.get('id', 'N/A')}\n"
197	        else:
198	            result += "  No child folders\n"
199	
200	        result += "\n"
201	
202	        # Notes section
203	        notes = folder_data.get("notes", [])
204	        notes_count = folder_data.get("notes_count", 0)
205	        result += f"Notes ({notes_count}):\n"
206	
207	        if notes:
208	            for i, note in enumerate(notes, 1):
209	                result += f"  {i:2d}. {note.get('name', 'N/A')}\n"
210	                result += f"      ID: {note.get('note_id', 'N/A')}\n"
211	        else:
212	            result += "  No notes\n"
213	
214	        return result
215	
216	    except ValueError as e:
217	        error_msg = f"Invalid input: {str(e)}"
218	        await ctx.error(error_msg)
219	        raise ValueError(error_msg)
220	    except RuntimeError as e:
221	        error_msg = f"Folder not found or verification error: {str(e)}"
222	        await ctx.error(error_msg)
223	        raise RuntimeError(error_msg)
224	    except Exception as e:
225	        await ctx.error(f"Error reading folder: {str(e)}")
226	        raise
