110	def save_scan_results(scan_id: str, target: str, ports: str, scan_type: str,
111	                     start_time: datetime, end_time: datetime, hosts: list[dict]) -> tuple[int, int]:
112	    """Save scan results to database with hostname resolution and return (total_hosts, total_open_ports)."""
113	    duration = (end_time - start_time).total_seconds()
114	
115	    # Calculate stats
116	    total_hosts = len(hosts)
117	    total_open_ports = sum(
118	        len([p for p in host["ports"] if p["state"] == "open"])
119	        for host in hosts
120	    )
121	
122	    # Update database with results
123	    db = get_database()
124	
125	    # Update scan record
126	    db.scans.update_one(
127	        {"scan_id": scan_id},
128	        {
129	            "$set": {
130	                "status": "completed",
131	                "end_time": end_time,
132	                "duration_seconds": duration,
133	                "total_hosts": total_hosts,
134	                "total_open_ports": total_open_ports,
135	                "results_json": hosts
136	            }
137	        }
138	    )
139	
140	    # Insert individual port entries with hostname resolution
141	    finding_docs = []
142	    for host in hosts:
143	        ip_address = host["ip"]
144	
145	        # Resolve hostname for this IP with timeout
146	        hostname = None
147	        try:
148	            # Use a shorter timeout for reverse DNS to avoid blocking
149	            import signal
150	
151	            def timeout_handler(signum, frame):
152	                raise socket.timeout("DNS timeout")
153	
154	            # Set a 3-second timeout for reverse DNS
155	            old_handler = signal.signal(signal.SIGALRM, timeout_handler)
156	            signal.alarm(3)
157	            try:
158	                hostname = socket.gethostbyaddr(ip_address)[0]
159	            finally:
160	                signal.alarm(0)
161	                signal.signal(signal.SIGALRM, old_handler)
162	
163	        except (socket.herror, socket.gaierror, socket.timeout):
164	            # If reverse DNS fails, try to extract hostname from target if it was a hostname
165	            if not target.replace('.', '').replace('/', '').replace('-', '').isdigit():
166	                # Target might be a hostname or CIDR, check if it resolves to this IP
167	                try:
168	                    # Also use timeout for forward DNS
169	                    old_handler = signal.signal(signal.SIGALRM, timeout_handler)
170	                    signal.alarm(3)
171	                    try:
172	                        resolved_ip = socket.gethostbyname(target.split('/')[0])
173	                        if resolved_ip == ip_address:
174	                            hostname = target.split('/')[0]
175	                    finally:
176	                        signal.alarm(0)
177	                        signal.signal(signal.SIGALRM, old_handler)
178	                except:
179	                    pass
180	
181	        # Create one entry per port
182	        for port in host["ports"]:
183	            finding_docs.append({
184	                "scan_id": scan_id,
185	                "agent": "port-scan",
186	                "hostname": hostname,
187	                "ip_address": ip_address,
188	                "port": port["port"],
189	                "protocol": port["protocol"],
190	                "state": port["state"],
191	                "service": port.get("service", ""),
192	                "version": port.get("version", ""),
193	                "banner": port.get("banner", ""),
194	                "timestamp": datetime.now()
195	            })
196	
197	    # Insert all findings in batch
198	    if finding_docs:
199	        db.findings.insert_many(finding_docs)
200	
201	    return total_hosts, total_open_ports
