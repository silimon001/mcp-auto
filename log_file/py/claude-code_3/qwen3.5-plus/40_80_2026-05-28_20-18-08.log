15	@mcp.tool()
16	async def create_note(
17	    ctx: Context,
18	    name: str = Field(
19	        ...,
20	        description="Note title wrapped in <h1> tags (e.g., '<h1>My Note Title</h1>')",
21	    ),
22	    body: str = Field(
23	        ...,
24	        description="Note body content with appropriate HTML formatting (e.g., '<p>Content here</p>'). For proper spacing between two sections, use <br>.",
25	    ),
26	    folder_path: str = Field(
27	        default="Notes",
28	        description="Target folder path (e.g., 'Work' or 'Work/Projects/2024'). Defaults to 'Notes'",
29	    ),
30	) -> str:
31	    """Create a new note with specified name and content.
32	
33	    Supported HTML: <h1-h6>, <b><i><u>, <p><div><br>, <ul><ol><li>, <table>, <a>
34	    Best Practices: Use semantic HTML, add <br> tags for spacing, avoid CSS styles
35	    Folders: Root level or nested paths (up to 5 levels deep)
36	    Limitations: No special chars in name, no complex CSS/JS
37	
38	    Example:
39	    name: "<h1>Project Report</h1>"
40	    body: "<p>Status: <b>In Progress</b></p><br><ul><li>Task 1</li></ul>"
41	    """
42	    try:
43	        # Validate the title content in the name parameter
44	        ValidationUtils.validate_html_title_content(name)
45	
46	        # Combine name (title) and body into complete HTML content with <br> spacing
47	        combined_content = name + "<br>" + body
48	        note = await notes_tools.create_note("note", combined_content, folder_path)
49	        return str(note)
50	    except ValueError as e:
51	        # Handle validation errors with clear messages
52	        error_msg = f"Invalid input: {str(e)}"
53	        await ctx.error(error_msg)
54	        raise ValueError(error_msg)
55	    except Exception as e:
56	        await ctx.error(f"Error creating note: {str(e)}")
57	        raise
