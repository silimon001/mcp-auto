40	            'ERROR':    'red',
41	            'CRITICAL': 'bold_red',
42	        }
43	    )
44	
45	    handler.setFormatter(formatter)
46	    logger.handlers.clear()
47	    logger.addHandler(handler)
48	
49	    return logger
