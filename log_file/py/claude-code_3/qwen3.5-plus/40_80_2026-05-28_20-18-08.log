493	    @app.tool()
494	    async def search_exploits(
495	        platform: Annotated[str, "Filter by platform (e.g., 'windows', 'linux', 'unix'). Leave empty for all platforms."] = "",
496	        search_term: Annotated[str, "Search term to filter exploits by name or description. Leave empty for no filtering."] = "",
497	        cve: Annotated[str, "Search for specific CVE reference (e.g., 'CVE-2017-0144'). Leave empty for no CVE filtering."] = "",
498	        limit: Annotated[int, "Maximum number of exploits to return"] = 50
499	    ) -> str:
500	        """
501	        Search the cached exploits database for fast results.
502	
503	        This tool searches a pre-populated database of Metasploit exploits for extremely fast results.
504	        The database contains detailed information including CVE references, author, disclosure dates, etc.
505	
506	        Use this tool when you want to:
507	        - Quickly find exploits by platform, service, or vulnerability
508	        - Search for exploits by CVE number
509	        - Filter exploits by rank or author
510	        - Get fast results without querying Metasploit RPC
511	
512	        Note: The exploits database must be populated first using the populate_exploits.py script.
