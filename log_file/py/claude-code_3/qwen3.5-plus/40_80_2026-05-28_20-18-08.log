1	import functools
2	import logging
3	from typing import Callable
4	
5	
6	def requires_graph_auth(func: Callable) -> Callable:
7	    """Decorator that handles Microsoft GraphController authentication before executing the wrapped function"""
8	
9	    @functools.wraps(func)
10	    async def wrapper(ctx, *args, **kwargs):
11	        logging.info("Checking for graph authentication")
12	
13	        # Get the settings from the context
14	        auth_settings = ctx.request_context.lifespan_context.settings
15	
16	        # Check if we already have a client
17	        user_client = auth_settings.get_user_client()
18	
19	        if user_client is not None:
20	            # We're authenticated, proceed with the function
21	            logging.info("Already authenticated, proceeding with function")
22	            ctx.request_context.lifespan_context.graph.user_client = user_client
23	            return await func(ctx, *args, **kwargs)
24	        else:
25	            # We need to authenticate - return instructions
26	            logging.info("Authentication required, returning instructions")
27	            try:
28	                auth_message = auth_settings.get_auth_instructions()
29	                return auth_message
30	            except Exception as e:
31	                logging.error(f"Authentication error: {str(e)}")
32	                return f"Error during authentication: {str(e)}"
33	
34	    return wrapper
35	

