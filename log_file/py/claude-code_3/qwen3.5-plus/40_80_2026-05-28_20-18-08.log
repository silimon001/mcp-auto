297	@mcp.tool()
298	async def lldb_load(ctx: Context, session_id: str, program: str, arguments: List[str] = None) -> str:
299	    """Load a program into LLDB"""
300	    try:
301	        session = get_session(ctx, session_id)
302	        
303	        # Normalize path if working directory is set
304	        if session.working_dir and not os.path.isabs(program):
305	            program = os.path.join(session.working_dir, program)
306	        
307	        # Create target
308	        output = await session.execute_command(f"file \"{program}\"")
309	        
310	        # Set program arguments if provided
311	        if arguments:
312	            args_str = " ".join(f'"{arg}"' for arg in arguments)
313	            args_output = await session.execute_command(f"settings set -- target.run-args {args_str}")
314	            output += f"\n{args_output}"
315	        
316	        # Update session target
317	        session.target = program
318	        
319	        return f"Program loaded: {program}\n\nOutput:\n{output}"
320	    
321	    except ValueError as e:
322	        return str(e)
323	    except Exception as e:
324	        return f"Failed to load program: {str(e)}"
