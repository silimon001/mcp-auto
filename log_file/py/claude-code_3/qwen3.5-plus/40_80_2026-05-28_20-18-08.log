115	def _get_web_banner(ip: str, port: int, timeout: int, is_https: bool = False) -> Dict[str, str]:
116	    """
117	    Use HTTP/HTTPS library to retrieve banner information from a web service.
118	    Uses regular expressions to extract version information from headers and response body.
119	
120	    Args:
121	        ip: IP address to connect to
122	        port: Port number to connect to
123	        timeout: Connection timeout in seconds
124	        is_https: Whether to use HTTPS (True) or HTTP (False)
125	
126	    Returns:
127	        Dictionary with service, version, and banner information
128	    """
129	    try:
130	        # Use http.client to send a GET request to get both headers and body
131	        if is_https:
132	            # Create an SSL context that doesn't verify certificates
133	            context = ssl.create_default_context()
134	            context.check_hostname = False
135	            context.verify_mode = ssl.CERT_NONE
136	            conn = http.client.HTTPSConnection(ip, port, timeout=timeout, context=context)
137	        else:
138	            conn = http.client.HTTPConnection(ip, port, timeout=timeout)
139	
140	        conn.request("GET", "/")
141	        response = conn.getresponse()
142	
143	        # Get headers as a dictionary
144	        headers = {k.lower(): v for k, v in response.getheaders()}
145	
146	        # Read response body (limited to prevent huge responses)
147	        body = response.read(4096).decode('utf-8', errors='ignore')
148	
149	        # Extract server information
150	        server = headers.get('server', '')
151	
152	        # Construct banner text from status line, headers, and a preview of the body
153	        status_line = f"HTTP/{response.version // 10}.{response.version % 10} {response.status} {response.reason}"
154	        header_lines = [f"{k}: {v}" for k, v in response.getheaders()]
155	        banner_text = status_line + "\r\n" + "\r\n".join(header_lines)
156	
157	        # Determine service and version
158	        service_name = "https" if is_https else "http"
159	        version = ""
160	
161	        # Check for specific services in both headers and body
162	        content_type = headers.get('content-type', '').lower()
163	        version_patterns = [
164	            # Apache version
165	            {
166	                "regex": r'Apache(?:/(\d+\.\d+\.\d+))?',
167	                "format": "Apache{}"
168	            },
169	            # Nginx version
170	            {
171	                "regex": r'nginx(?:/(\d+\.\d+\.\d+))?',
172	                "format": "nginx{}"
173	            },
174	            # IIS version
175	            {
176	                "regex": r'Microsoft-IIS/(\d+\.\d+)',
177	                "format": "Microsoft-IIS/{}"
178	            },
179	            # Lighttpd version
180	            {
181	                "regex": r'lighttpd(?:/(\d+\.\d+\.\d+))?',
182	                "format": "lighttpd{}"
183	            },
184	            # Gunicorn version
185	            {
186	                "regex": r'gunicorn(?:/(\d+\.\d+\.\d+))?',
187	                "format": "gunicorn{}"
188	            },
189	            # Generic server header
190	            {
191	                "regex": r'(.*)',
192	                "format": "{}"
193	            }
194	        ]
195	
196	        if server:
197	            for pattern in version_patterns:
198	                match = re.search(pattern["regex"], server, re.IGNORECASE)
199	                if match:
200	                    # If we have a version group, use it
201	                    if match.groups() and match.group(1):
202	                        version_str = match.group(1)
203	                        # Format with a slash between name and version
204	                        version = pattern["format"].format(f"/{version_str}")
205	                    else:
206	                        # Otherwise use the whole match without additional formatting
207	                        version = pattern["format"].format("")
208	                    break
209	        else:
210	            # If no server header, use generic HTTP
211	            version = "HTTP"
212	
213	        return {
214	            "service": service_name,
215	            "version": version,
216	            "banner": banner_text
217	        }
218	    except Exception as e:
219	        return {
220	            "service": "http",
221	            "version": "",
222	            "banner": f"Error: {str(e)}"
223	        }
