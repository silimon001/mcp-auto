41	    async def validate_masscan(self) -> bool:
42	        """Validate that masscan is available and working."""
43	        try:
44	            # Build command with or without sudo
45	            if self.config.scanner.use_sudo:
46	                cmd = ["sudo", self.config.scanner.masscan_path, "--version"]
47	            else:
48	                cmd = [self.config.scanner.masscan_path, "--version"]
49	
50	            result = await asyncio.create_subprocess_exec(
51	                *cmd,
52	                stdout=asyncio.subprocess.PIPE,
53	                stderr=asyncio.subprocess.PIPE
54	            )
55	            stdout, stderr = await result.communicate()
56	
57	            # Masscan returns exit code 1 for --version, but still outputs version info
58	            version_output = stdout.decode().strip() or stderr.decode().strip()
59	
60	            if "Masscan version" not in version_output:
61	                logger.error(f"Masscan validation failed: unexpected output: {version_output}")
62	                if self.config.scanner.use_sudo and "sudo" in version_output:
63	                    logger.error("Hint: Check sudo permissions for masscan")
64	                return False
65	
66	            logger.info(f"Masscan validation successful: {version_output.split()[2] if len(version_output.split()) > 2 else 'unknown version'}")
67	
68	            # Additional validation: check if we can run a basic scan command
69	            if self.config.scanner.use_sudo:
70	                logger.info("Checking sudo permissions for masscan...")
71	                test_result = await asyncio.create_subprocess_exec(
72	                    "sudo", "-n", self.config.scanner.masscan_path, "--help",
73	                    stdout=asyncio.subprocess.PIPE,
74	                    stderr=asyncio.subprocess.PIPE
75	                )
76	                await test_result.communicate()
77	                if test_result.returncode != 0:
78	                    logger.warning("Sudo access to masscan may require password. Consider setting up NOPASSWD sudo for masscan.")
79	
80	            return True
81	
82	        except FileNotFoundError:
83	            logger.error(f"Masscan not found at: {self.config.scanner.masscan_path}")
84	            return False
85	        except Exception as e:
86	            logger.error(f"Masscan validation error: {e}")
87	            return False
