33	class Scanner:
34	    """Scanner component that integrates with masscan."""
35	
36	    def __init__(self, config: RedTeamMCPConfig):
37	        self.config = config
38	        self.active_scans: Dict[str, asyncio.Task] = {}
39	        self.scan_results: Dict[str, ScanResult] = {}
