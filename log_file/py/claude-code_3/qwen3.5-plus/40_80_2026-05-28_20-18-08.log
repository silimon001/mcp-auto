151	        """
152	        Execute systematic penetration test against target machine with streaming updates.
153	
154	        Args:
155	            target_host: Target IP address or hostname
156	            target_ports: Port range to scan
157	            scan_rate: Scan rate for port scanning
158	
159	        Yields:
160	            Progress updates and final results
161	        """
162	        # Generate unique scan ID for database tracking
163	        scan_id = str(uuid.uuid4())
164	        # Create descriptive scan identifier for display
165	        scan_display_id = f"hack-{target_host}"
166	        start_time = datetime.now()
167	        shells_obtained = []
168	        vulnerabilities_found = []
169	        credentials_found = []
170	
171	        try:
172	            # Yield initial status
173	            yield {
174	                "type": "status",
175	                "phase": "initialization",
176	                "message": f"🎯 Starting penetration test against {target_host}",
177	                "scan_id": scan_id,
178	                "scan_display_id": scan_display_id,
179	                "target": target_host
180	            }
181	
182	            # Simple prompt - let the agent use its instructions and tools naturally
183	            prompt = (f"Perform a systematic penetration test on {target_host}. The target has already been port scanned"
184	                      f" - use search_findings to discover open ports and services, "
185	                      f"then proceed with vulnerability assessment and exploitation. "
186	                      f"Follow your methodology and use the available tools.")
187	
188	            # Use arun with stream=True and stream_intermediate_steps=True to get tool events
189	            # Add timeout to prevent hanging
190	            import asyncio
191	            try:
192	                response_stream = await asyncio.wait_for(
193	                    self.agent.arun(prompt, stream=True,
194	                                   stream_intermediate_steps=True,
195	                                   show_full_reasoning=True),
196	                    timeout=self.mcp_timeout  # Use the configured timeout
197	                )
198	            except asyncio.TimeoutError:
199	                yield {
200	                    "type": "error",
201	                    "message": f"❌ Hacking operation timed out after {self.mcp_timeout} seconds",
202	                    "scan_id": scan_id,
203	                    "scan_display_id": scan_display_id,
204	                    "error": "timeout"
205	                }
206	                return
207	
208	            # Iterate over the streaming response objects
209	            full_response = ""
210	            seen_tool_calls = set()  # Track tool calls to avoid duplicates
211	            async for response_chunk in response_stream:
212	                # Handle different event types according to Agno documentation
213	                event_type = getattr(response_chunk, 'event', None)
214	
215	                if event_type == 'ToolCallStarted':
216	                    # Tool call is starting - get info from tools attribute
217	                    tools = getattr(response_chunk, 'tools', [])
218	                    if tools:
219	                        # Get the latest tool call (last in the list)
220	                        latest_tool = tools[-1]
221	                        tool_name = latest_tool.get('tool_name', 'unknown')
222	                        tool_args = latest_tool.get('tool_args', {})
223	
224	                    tool_key = f"call:{tool_name}:{str(tool_args)}"
225	                    if tool_key not in seen_tool_calls:
226	                        seen_tool_calls.add(tool_key)
227	                        yield {
228	                            "type": "tool_call",
229	                            "tool_name": tool_name,
230	                            "message": f"Calling {tool_name}",
231	                            "scan_id": scan_id,
232	                            "scan_display_id": scan_display_id,
233	                            "parameters": tool_args
234	                        }
235	
236	                elif event_type == 'ToolCallCompleted':
237	                    # Tool call completed
238	                    tools = getattr(response_chunk, 'tools', [])
239	                    if tools:
240	                        latest_tool = tools[-1]
241	                        tool_name = latest_tool.get('tool_name', 'unknown')
242	                    else:
243	                        tool_name = 'unknown'
244	
245	                    result_key = f"result:{tool_name}"
246	                    if result_key not in seen_tool_calls:
247	                        seen_tool_calls.add(result_key)
248	                        yield {
249	                            "type": "tool_result",
250	                            "tool_name": tool_name,
251	                            "message": f"✅ {tool_name} completed",
252	                            "scan_id": scan_id,
253	                            "scan_display_id": scan_display_id
254	                        }
255	
256	                # Accumulate the full response from RunResponse events
257	                if event_type == 'RunResponse' and hasattr(response_chunk, 'content') and response_chunk.content:
258	                    full_response += response_chunk.content
259	
260	                elif event_type == 'RunError':
261	                    yield {
262	                        "type": "error",
263	                        "message": "❌ Error during penetration test",
264	                        "scan_id": scan_id,
265	                        "scan_display_id": scan_display_id,
266	                        "final_report": full_response
267	                    }
268	
269	
270	
271	            # Parse results from the agent's response and tool calls
272	            # Extract shells, credentials, and vulnerabilities from response
273	            shells_obtained, credentials_found, vulnerabilities_found = self._parse_agent_results(full_response)
274	
275	            # Yield findings as they're discovered
276	            if shells_obtained:
277	                yield {
278	                    "type": "finding",
279	                    "category": "shells",
280	                    "message": f"🐚 Found {len(shells_obtained)} shell access(es)!",
281	                    "data": shells_obtained,
282	                    "scan_id": scan_id,
283	                    "scan_display_id": scan_display_id
284	                }
285	
286	            if credentials_found:
287	                yield {
288	                    "type": "finding",
289	                    "category": "credentials",
290	                    "message": f"🔑 Found {len(credentials_found)} credential(s)!",
291	                    "data": credentials_found,
292	                    "scan_id": scan_id,
293	                    "scan_display_id": scan_display_id
294	                }
295	
296	            if vulnerabilities_found:
297	                yield {
298	                    "type": "finding",
299	                    "category": "vulnerabilities",
300	                    "message": f"🚨 Found {len(vulnerabilities_found)} vulnerability(ies)!",
301	                    "data": vulnerabilities_found,
302	                    "scan_id": scan_id,
303	                    "scan_display_id": scan_display_id
304	                }
305	
306	            end_time = datetime.now()
307	            duration = (end_time - start_time).total_seconds()
308	
309	            # Determine success based on results
310	            success = len(shells_obtained) > 0
311	
312	            # Yield database save status
