647	# ---------------------------------------------------------------------
648	# Turn recording (auto tracking)
649	# ---------------------------------------------------------------------
650	@mcp_tool
651	@mcp.tool()
652	def gait_record_turn(
653	    user_text: str = "",
654	    assistant_text: str = "",
655	    artifacts: Optional[List[Dict[str, str]]] = None,
656	    note: str = "vscode-copilot",
657	    use_memory_snapshot: bool = True,
658	) -> Dict[str, Any]:
659	    """Record a turn and include code artifacts/files created.
660	
661	    Args:
662	        user_text: The user's input text
663	        assistant_text: The assistant's response text
664	        artifacts: List of {"path": "...", "content": "..."} for code files created
665	        note: Optional note for the turn (default: vscode-copilot)
666	        use_memory_snapshot: Whether to include pinned memory context snapshot
667	    """
668	    repo, err = _try_repo()
669	    if err: return err
670	    
671	    # Bundle the artifacts into the turn metadata
672	    context: Dict[str, Any] = {"artifacts": artifacts or []}
673	    
674	    if use_memory_snapshot:
675	        try:
676	            context["pinned_context"] = repo.build_context_bundle(full=False)
677	        except Exception as e:
678	            context["pinned_context_error"] = str(e)
679	
680	    # Calculate tokens (ensure your count_turn_tokens handles the extra context)
681	    tokens = count_turn_tokens(user_text=user_text, assistant_text=assistant_text)
682	
683	    turn = Turn.v0(
684	        user_text=user_text,
685	        assistant_text=assistant_text,
686	        context=context, # The code is now stored here!
687	        tools={},
688	        model={"provider": "vscode-copilot"},
689	        tokens=tokens,
690	        visibility="private",
691	    )
692	    _, commit_id = repo.record_turn(turn, message=note)
693	    return {"ok": True, "commit": short_oid(commit_id), "artifacts_tracked": len(artifacts or [])}
694	
695	# ---------------------------------------------------------------------
696	# Revert / reset
697	# ---------------------------------------------------------------------
698	@mcp_tool
699	@mcp.tool()
700	def gait_revert(target: str = "HEAD~1", also_memory: bool = True) -> Dict[str, Any]:
701	    """Rewind branch history and optionally reset pinned memory. After calling this, you MUST call gait_resume to sync state.
702	
703	    Args:
704	        target: Target commit to revert to (default: HEAD~1)
705	        also_memory: Whether to also reset pinned memory to match the new state
706	    """
707	    repo, err = _try_repo()
708	    if err:
709	        return err
710	    assert repo is not None
711	
712	    branch = repo.current_branch()
713	    head_before = repo.head_commit_id() or ""
714	    if not head_before:
715	        return _err("Nothing to revert (branch has no commits).", branch=branch)
716	
717	    new_head = _resolve_revert_target(repo, target)
718	
719	    # Perform the History Reset
720	    if new_head == "":
721	        repo.write_ref(branch, "")
722	        head_after = ""
723	    else:
724	        head_after = repo.reset_branch(new_head)
725	
726	    out: Dict[str, Any] = {
727	        "ok": True,
728	        "branch": branch,
729	        "head_before": short_oid(head_before),
730	        "head_after": short_oid(head_after) if head_after else "(empty)",
731	        # CRITICAL: This instruction tells Copilot what to do next
732	        "instruction": "HISTORY REWOUND. Do NOT call gait_record_turn for this action. Immediately call gait_resume() to see the new state of the code and memory."
733	    }
734	
735	    # Keep the Memory Logic! 
736	    # This ensures the AI's 'pinned' context matches the new point in time.
737	    if also_memory:
738	        try:
739	            old_mem = repo.read_memory_ref(branch)
740	            # Reset memory to match the state of the repo at the new head
741	            new_mem = repo.reset_memory_to_commit(branch, repo.head_commit_id())
742	            out["memory_status"] = "Memory synced to new HEAD"
743	            out["memory_id"] = new_mem
744	        except Exception as e:
745	            out["memory_error"] = f"Could not sync memory: {str(e)}"
746	
747	    return out
748	
