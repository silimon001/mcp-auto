570	                "agent": agent,
571	                "severity": severity,
572	                "template_id": template_id
573	            },
574	            "message": f"Found {len(results)} matching findings"
575	        }
576	
577	    except Exception as e:
578	        return {
579	            "success": False,
580	            "error": str(e),
581	            "message": "Failed to search findings"
582	        }
