297	def register_tools(app):
298	    """Register domain discovery tools with the FastMCP app."""
299	
300	    @app.tool()
301	    async def domain_discovery(
302	        domain: str,
303	        timeout: int = 300
304	    ) -> str:
305	        """
306	        DOMAIN DISCOVERY: Enumerate subdomains from a top-level domain using subfinder.
307	
308	        This tool discovers subdomains for a given domain and resolves them to IP addresses.
309	        It provides real-time progress updates during the discovery process.
310	
311	        Process:
312	        1. Validate that the main domain resolves via DNS
313	        2. Execute subfinder tool to discover subdomains
314	        3. Resolve each discovered subdomain to its IP address
315	        4. Store results in database for later analysis
316	
317	        Args:
318	            domain: Target domain to discover subdomains for (e.g., 'example.com')
319	            timeout: Maximum time to spend on discovery in seconds (default: 300)
320	
321	        Returns:
322	            JSON string with discovery results including subdomains and their IP addresses
323	
324	        Examples:
325	        - Discover subdomains: domain='example.com'
326	        - Quick discovery: domain='google.com', timeout=120
327	        """
328	        try:
329	            # Run the blocking domain discovery function in a thread pool (like nuclei scanner)
330	            result = await asyncio.to_thread(
331	                discover_subdomains,
332	                domain,
333	                timeout
334	            )
335	
336	            # Create a concise response for agents
337	            if result and result.get("success"):
338	                # Get resolved subdomains
339	                subdomains = result.get("subdomains", [])
340	                resolved_subdomains = [s for s in subdomains if s.get("resolved")]
341	
342	                # Create summary
343	                summary = {
344	                    "success": True,
345	                    "scan_id": result.get("scan_id"),
346	                    "domain": domain,
347	                    "domain_ip": result.get("domain_ip"),
348	                    "total_subdomains_found": result.get("total_subdomains", 0),
349	                    "subdomains_resolved": result.get("resolved_subdomains", 0),
350	                    "duration_seconds": result.get("duration_seconds", 0),
351	                    "message": f"✅ Found {result.get('resolved_subdomains', 0)} resolved subdomains out of {result.get('total_subdomains', 0)} discovered for {domain}"
352	                }
353	
354	                # Add top 10 resolved subdomains for display
355	                if resolved_subdomains:
356	                    summary["top_resolved_subdomains"] = [
357	                        f"{sub['subdomain']} -> {sub['ip_address']}"
358	                        for sub in resolved_subdomains[:10]
359	                    ]
360	
361	                    if len(resolved_subdomains) > 10:
362	                        summary["additional_subdomains"] = len(resolved_subdomains) - 10
363	                        summary["note"] = f"Showing top 10 of {len(resolved_subdomains)} resolved subdomains. Full results saved to database."
364	
365	                return json.dumps(summary, indent=2)
366	            else:
367	                return json.dumps({
368	                    "success": False,
369	                    "domain": domain,
370	                    "error": "Domain discovery failed or returned no results",
371	                    "message": f"❌ Domain discovery failed for {domain}"
372	                })
373	
374	        except Exception as e:
375	            return json.dumps({
376	                "success": False,
377	                "error": str(e),
378	                "domain": domain,
379	                "message": f"❌ Domain discovery failed for {domain}: {str(e)}"
380	            })
381	
