113	def safe_get_attribute(obj, attr_name, default=None):
114	    """Safely get an attribute from a Metasploit object."""
115	    try:
116	        value = getattr(obj, attr_name, default)
117	        # Convert to basic Python types to avoid Metasploit object issues
118	        if hasattr(value, '__iter__') and not isinstance(value, (str, bytes)):
119	            try:
120	                return list(value)
121	            except:
122	                return str(value)
123	        return value
124	    except Exception:
125	        return default
