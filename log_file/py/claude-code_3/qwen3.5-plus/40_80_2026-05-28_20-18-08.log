89	    def _validate_target(self, target: ScanTarget) -> None:
90	        """Validate scan target against security policies."""
91	        import ipaddress
92	
93	        # Parse target network
94	        try:
95	            network = ipaddress.ip_network(target.ip_range, strict=False)
96	        except ValueError:
97	            try:
98	                # Single IP
99	                ip = ipaddress.ip_address(target.ip_range)
100	                network = ipaddress.ip_network(f"{ip}/{ip.max_prefixlen}")
101	            except ValueError:
102	                raise ValueError(f"Invalid IP range: {target.ip_range}")
103	
104	        # Check against blocked networks
105	        for blocked in self.config.scanner.blocked_networks:
106	            blocked_network = ipaddress.ip_network(blocked)
107	            if network.overlaps(blocked_network):
108	                raise ValueError(f"Target {target.ip_range} overlaps with blocked network {blocked}")
109	
110	        # Validate number of targets
111	        if network.num_addresses > self.config.scanner.max_targets:
112	            raise ValueError(
113	                f"Target range too large: {network.num_addresses} addresses "
114	                f"(max: {self.config.scanner.max_targets})"
115	            )
116	
117	    def _build_masscan_command(self, request: ScanRequest, output_file: Path) -> List[str]:
118	        """Build masscan command from scan request."""
119	        # Check if we need sudo for masscan
120	        use_sudo = self.config.scanner.use_sudo if hasattr(self.config.scanner, 'use_sudo') else True
121	
122	        if use_sudo:
123	            cmd = [
124	                "sudo",
125	                self.config.scanner.masscan_path,
126	                request.target.ip_range,
127	            ]
128	        else:
129	            cmd = [
130	                self.config.scanner.masscan_path,
131	                request.target.ip_range,
132	            ]
133	
134	        # Add ports
135	        if isinstance(request.target.ports, str):
136	            cmd.extend(["-p", request.target.ports])
137	        elif isinstance(request.target.ports, list):
138	            port_str = ",".join(map(str, request.target.ports))
139	            cmd.extend(["-p", port_str])
140	
141	        # Add rate limiting
142	        rate = request.rate or self.config.scanner.max_rate
143	        rate = min(rate, self.config.scanner.max_rate)  # Enforce max rate
144	        cmd.extend(["--rate", str(rate)])
145	
146	        # Add output format
147	        cmd.extend(["-oJ", str(output_file)])
148	
149	        # Add scan type options (masscan defaults to SYN scan, so we only need to specify others)
150	        if request.scan_type == "tcp_connect":
151	            cmd.append("--tcp-connect")
152	        elif request.scan_type == "udp":
153	            cmd.append("--udp")
154	        elif request.scan_type == "tcp_ack":
155	            cmd.append("--tcp-ack")
156	        elif request.scan_type == "tcp_window":
157	            cmd.append("--tcp-window")
158	        # tcp_syn is the default, so no flag needed
159	
160	        # Add timeout (masscan uses --wait for connection timeout, not scan timeout)
161	        # For scan timeout, we'll handle it at the process level
162	
163	        # Add additional options
164	        for key, value in request.options.items():
165	            if key.startswith("--"):
166	                cmd.append(key)
167	                if value is not True:  # Don't add value for boolean flags
168	                    cmd.append(str(value))
169	
170	        return cmd
171	
172	    def _parse_masscan_output(self, output_file: Path) -> List[HostResult]:
173	        """Parse masscan JSON output into HostResult objects."""
174	        hosts: Dict[str, HostResult] = {}
175	
176	        if not output_file.exists():
177	            logger.warning(f"Masscan output file not found: {output_file}")
178	            return []
179	
180	        try:
181	            with open(output_file, 'r') as f:
182	                for line in f:
183	                    line = line.strip()
184	                    if not line or line.startswith('#'):
185	                        continue
186	
187	                    try:
188	                        data = json.loads(line)
189	                        ip = data.get('ip')
190	                        port_data = data.get('ports', [])
191	
192	                        if not ip:
193	                            continue
194	
195	                        # Get or create host result
196	                        if ip not in hosts:
197	                            hosts[ip] = HostResult(ip=ip)
198	
199	                        # Add port results
200	                        for port_info in port_data:
201	                            port = port_info.get('port')
202	                            protocol = port_info.get('proto', 'tcp')
203	                            state = port_info.get('status', 'open')
204	
205	                            if port:
206	                                port_result = PortResult(
207	                                    port=port,
208	                                    protocol=protocol,
209	                                    state=PortState.OPEN if state == 'open' else PortState.CLOSED,
210	                                    timestamp=datetime.utcnow()
211	                                )
212	                                hosts[ip].ports.append(port_result)
213	
214	                    except json.JSONDecodeError as e:
215	                        logger.warning(f"Failed to parse masscan output line: {line} - {e}")
216	                        continue
217	
218	        except Exception as e:
219	            logger.error(f"Error parsing masscan output: {e}")
220	            return []
221	
222	        return list(hosts.values())
223	
224	    async def _run_scan(self, request: ScanRequest) -> ScanResult:
225	        """Execute a single scan operation."""
226	        scan_result = ScanResult(
227	            scan_id=request.scan_id,
228	            request=request,
229	            status=ScanStatus.RUNNING,
230	            start_time=datetime.utcnow()
231	        )
232	
233	        try:
234	            # Validate target
235	            self._validate_target(request.target)
236	
237	            # Create temporary output file
238	            with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
239	                output_file = Path(f.name)
240	
241	            try:
242	                # Build and execute masscan command
243	                cmd = self._build_masscan_command(request, output_file)
244	                logger.info(f"Executing masscan: {' '.join(shlex.quote(arg) for arg in cmd)}")
245	
246	                process = await asyncio.create_subprocess_exec(
247	                    *cmd,
248	                    stdout=asyncio.subprocess.PIPE,
249	                    stderr=asyncio.subprocess.PIPE
250	                )
251	
252	                # Apply timeout at process level
253	                timeout = request.timeout or self.config.scanner.timeout
254	                try:
255	                    stdout, stderr = await asyncio.wait_for(
256	                        process.communicate(),
257	                        timeout=timeout
258	                    )
259	                except asyncio.TimeoutError:
260	                    process.kill()
261	                    await process.wait()
262	                    raise MasscanError(f"Scan timed out after {timeout} seconds")
263	
264	                if process.returncode != 0:
265	                    error_msg = stderr.decode().strip()
266	                    logger.error(f"Masscan failed: {error_msg}")
267	                    raise MasscanError(f"Masscan execution failed: {error_msg}")
268	
269	                # Parse results
270	                hosts = self._parse_masscan_output(output_file)
271	                scan_result.hosts = hosts
272	                scan_result.status = ScanStatus.COMPLETED
273	                scan_result.end_time = datetime.utcnow()
274	
275	                # Add statistics
276	                scan_result.stats = {
277	                    "total_hosts": len(hosts),
278	                    "total_ports": sum(len(host.ports) for host in hosts),
279	                    "open_ports": sum(
280	                        len([p for p in host.ports if p.state == PortState.OPEN])
281	                        for host in hosts
282	                    ),
283	                    "duration_seconds": scan_result.duration or 0,
284	                }
285	
286	                logger.info(f"Scan {request.scan_id} completed successfully")
287	
288	            finally:
289	                # Clean up temporary file
290	                try:
291	                    output_file.unlink()
292	                except Exception as e:
293	                    logger.warning(f"Failed to clean up temp file {output_file}: {e}")
294	
295	        except Exception as e:
296	            scan_result.status = ScanStatus.FAILED
297	            scan_result.error_message = str(e)
298	            scan_result.end_time = datetime.utcnow()
299	            logger.error(f"Scan {request.scan_id} failed: {e}")
300	
301	        return scan_result
302	
303	    async def start_scan(self, target: ScanTarget, **kwargs) -> str:
304	        """Start a new scan operation."""
305	        scan_id = str(uuid.uuid4())
306	
307	        request = ScanRequest(
308	            scan_id=scan_id,
309	            target=target,
310	            **kwargs
311	        )
312	
313	        # Create scan task
314	        task = asyncio.create_task(self._run_scan(request))
315	        self.active_scans[scan_id] = task
316	
317	        # Store initial result
318	        self.scan_results[scan_id] = ScanResult(
319	            scan_id=scan_id,
320	            request=request,
321	            status=ScanStatus.PENDING,
322	            start_time=datetime.utcnow()
323	        )
324	
325	        logger.info(f"Started scan {scan_id} for target {target.ip_range}")
326	        return scan_id
327	
328	    async def get_scan_status(self, scan_id: str) -> Optional[ScanResult]:
329	        """Get the status of a scan operation."""
330	        if scan_id in self.scan_results:
331	            # Check if scan is complete
332	            if scan_id in self.active_scans:
333	                task = self.active_scans[scan_id]
334	                if task.done():
335	                    try:
336	                        result = await task
337	                        self.scan_results[scan_id] = result
338	                        del self.active_scans[scan_id]
339	                    except Exception as e:
340	                        logger.error(f"Scan task {scan_id} failed: {e}")
341	
342	            return self.scan_results[scan_id]
343	
344	        return None
345	
346	    async def cancel_scan(self, scan_id: str) -> bool:
347	        """Cancel a running scan operation."""
348	        if scan_id in self.active_scans:
349	            task = self.active_scans[scan_id]
350	            task.cancel()
351	
352	            try:
353	                await task
354	            except asyncio.CancelledError:
355	                pass
356	
357	            del self.active_scans[scan_id]
358	
359	            # Update scan result
360	            if scan_id in self.scan_results:
361	                self.scan_results[scan_id].status = ScanStatus.CANCELLED
362	                self.scan_results[scan_id].end_time = datetime.utcnow()
363	
364	            logger.info(f"Cancelled scan {scan_id}")
365	            return True
366	
367	        return False
368	
369	    def list_scans(self) -> List[str]:
370	        """List all scan IDs."""
371	        return list(self.scan_results.keys())
372	
373	    async def cleanup_completed_scans(self, max_age_hours: int = 24) -> int:
374	        """Clean up old completed scan results."""
375	        cutoff_time = datetime.utcnow().timestamp() - (max_age_hours * 3600)
376	        removed_count = 0
377	
378	        scan_ids_to_remove = []
379	        for scan_id, result in self.scan_results.items():
380	            if (result.status in [ScanStatus.COMPLETED, ScanStatus.FAILED, ScanStatus.CANCELLED] and
381	                result.start_time.timestamp() < cutoff_time):
382	                scan_ids_to_remove.append(scan_id)
383	
384	        for scan_id in scan_ids_to_remove:
385	            del self.scan_results[scan_id]
386	            removed_count += 1
387	
388	        logger.info(f"Cleaned up {removed_count} old scan results")
389	        return removed_count
