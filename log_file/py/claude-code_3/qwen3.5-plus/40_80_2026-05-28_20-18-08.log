44	@mcp.tool()
45	async def list_installed_applications() -> List[Dict[str, Any]]:
46	    """
47	    Lists all installed applications on the remote device.
48	    Returns a list of applications including their name, identifier, and PID if running.
49	    """
50	    device = await _get_remote_device()
51	    
52	    try:
53	        applications = await asyncio.to_thread(device.enumerate_applications)
54	
55	        if not applications:
