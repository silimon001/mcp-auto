[USER]:
1	"""Database access: pooling and read-only query execution."""
2	
3	from __future__ import annotations
4	
5	from typing import Any
6	
7	from psycopg import sql
8	from psycopg.rows import dict_row
9	from psycopg_pool import AsyncConnectionPool
10	
11	from .config import Settings
12	from .serialization import rows_to_jsonable
13	
14	
15	def build_pool(settings: Settings) -> AsyncConnectionPool:
16	    """Construct an async connection pool. Caller is responsible for `open()` and `close()`."""
17	    return AsyncConnectionPool(
18	        conninfo=settings.database_url,
19	        min_size=settings.pool_min_size,
20	        max_size=settings.pool_max_size,
21	        kwargs={"row_factory": dict_row},
22	        open=False,
23	    )
24	
25	
26	async def fetch_all(
27	    pool: AsyncConnectionPool,
28	    query: str,
29	    params: tuple[Any, ...] | None = None,
30	) -> list[dict[str, Any]]:
31	    """Run a trusted query and return JSON-safe rows. Used for predefined SQL files."""
32	    async with pool.connection() as conn, conn.cursor() as cur:
33	        await cur.execute(query, params)
34	        rows = await cur.fetchall()
35	    return rows_to_jsonable(rows)
36	
37	
38	async def fetch_readonly(
39	    pool: AsyncConnectionPool,
40	    query: str,
41	    statement_timeout_ms: int,
42	) -> list[dict[str, Any]]:
43	    """Run an untrusted query in a read-only transaction with hard timeouts.
44	
45	    The PostgreSQL transaction is opened with READ ONLY, and `statement_timeout`,
46	    `lock_timeout`, and `idle_in_transaction_session_timeout` are set as session-
47	    local guards. The transaction is always rolled back, so even a query that
48	    bypasses Python-side checks cannot mutate the database.
49	    """
50	    # SET LOCAL refuses parameter binding, so the timeout must be inlined as a
51	    # literal. int() casts make any non-integer fail loudly before reaching PG.
52	    stmt_ms = int(statement_timeout_ms)
53	    lock_ms = 2000
54	
55	    async with pool.connection() as conn:
56	        await conn.set_autocommit(False)
57	        async with conn.transaction(force_rollback=True), conn.cursor() as cur:
58	            await cur.execute("SET TRANSACTION READ ONLY")
59	            await cur.execute(
60	                sql.SQL("SET LOCAL statement_timeout = {ms}").format(ms=sql.Literal(stmt_ms))
61	            )
62	            await cur.execute(
63	                sql.SQL("SET LOCAL lock_timeout = {ms}").format(ms=sql.Literal(lock_ms))
64	            )
65	            await cur.execute(
66	                sql.SQL("SET LOCAL idle_in_transaction_session_timeout = {ms}").format(
67	                    ms=sql.Literal(stmt_ms)
68	                )
69	            )
70	            await cur.execute(query)
71	            rows = await cur.fetchall()
72	    return rows_to_jsonable(rows)
73	

