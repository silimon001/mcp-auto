424	def search_findings(hostname: Optional[str] = None, ip_address: Optional[str] = None,
425	                   port: Optional[int] = None, service: Optional[str] = None,
426	                   agent: Optional[str] = None, severity: Optional[str] = None,
427	                   template_id: Optional[str] = None, limit: int = 20) -> dict:
428	    """
429	    Search findings by hostname, IP address, port, service, agent, severity, or template ID.
430	
431	    This allows flexible searching across all findings to find:
432	    - All ports open on a specific host (agent='port-scan')
433	    - All vulnerabilities on a specific host (agent='vuln-scan')
434	    - All hosts running a specific service
435	    - All instances of a specific port across hosts
436	    - All critical/high severity vulnerabilities
437	    - All SSH findings (agent='ssh-agent')
438	    """
439	    try:
440	        print(f"🔍 Searching findings with params: hostname={hostname}, ip={ip_address}, port={port}, service={service}, agent={agent}, limit={limit}")
441	        db = get_database()
442	
443	        # Build dynamic query based on provided parameters
444	        query_filter = {}
445	
446	        if hostname:
447	            query_filter["hostname"] = {"$regex": hostname, "$options": "i"}
448	
449	        if ip_address:
450	            query_filter["ip_address"] = {"$regex": ip_address, "$options": "i"}
451	
452	        if port:
453	            query_filter["port"] = port
454	
455	        if service:
456	            query_filter["service"] = {"$regex": service, "$options": "i"}
457	
458	        if agent:
459	            query_filter["agent"] = agent
460	
461	        if severity:
462	            query_filter["severity"] = severity
463	
464	        if template_id:
465	            query_filter["template_id"] = {"$regex": template_id, "$options": "i"}
466	
467	        # If no conditions, return error
468	        if not query_filter:
469	            return {
470	                "success": False,
471	                "error": "No search parameters provided",
472	                "message": "Please provide at least one search parameter"
473	            }
474	
475	        print(f"📋 Query filter: {query_filter}")
476	        print(f"🔍 Executing database query...")
477	
478	        # Define severity order for sorting (vulnerabilities first by severity, then by timestamp)
479	        pipeline = [
480	            {"$match": query_filter},
481	            {"$lookup": {
482	                "from": "scans",
483	                "localField": "scan_id",
484	                "foreignField": "scan_id",
485	                "as": "scan_info"
486	            }},
487	            {"$unwind": "$scan_info"},
488	            {"$addFields": {
489	                "severity_order": {
490	                    "$switch": {
491	                        "branches": [
492	                            {"case": {"$eq": ["$severity", "critical"]}, "then": 1},
493	                            {"case": {"$eq": ["$severity", "high"]}, "then": 2},
494	                            {"case": {"$eq": ["$severity", "medium"]}, "then": 3},
495	                            {"case": {"$eq": ["$severity", "low"]}, "then": 4},
496	                            {"case": {"$eq": ["$severity", "info"]}, "then": 5}
497	                        ],
498	                        "default": 6
499	                    }
500	                }
501	            }},
502	            {"$sort": {"severity_order": 1, "timestamp": -1}},
503	            {"$limit": limit},
504	            {"$project": {
505	                "scan_id": 1,
506	                "target": "$scan_info.target",
507	                "agent": 1,
508	                "hostname": 1,
509	                "ip_address": 1,
510	                "port": 1,
511	                "protocol": 1,
512	                "state": 1,
513	                "service": 1,
514	                "version": 1,
515	                "banner": 1,
516	                "template_id": 1,
517	                "template_name": 1,
518	                "severity": 1,
519	                "url": 1,
520	                "matched_at": 1,
521	                "extracted_results": 1,
522	                "description": 1,
523	                "reference": 1,
524	                "scan_time": "$scan_info.start_time",
525	                "timestamp": 1
526	            }}
527	        ]
528	
529	        results_cursor = db.findings.aggregate(pipeline)
530	        print(f"✅ Database query executed, processing results...")
531	
532	        # Format results
533	        results = []
534	        for result_doc in results_cursor:
535	            result = {
536	                "scan_id": result_doc.get("scan_id"),
537	                "target": result_doc.get("target"),
538	                "agent": result_doc.get("agent"),
539	                "hostname": result_doc.get("hostname"),
540	                "ip_address": result_doc.get("ip_address"),
