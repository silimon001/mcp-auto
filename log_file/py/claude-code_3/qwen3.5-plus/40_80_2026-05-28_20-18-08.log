864	async def async_enumerate_vulnerabilities(host: str, port: int, timeout: int = 60) -> AsyncGenerator[Dict, None]:
865	    """
866	    ENUMERATE VULNERABILITIES: Find security issues and CVEs using nuclei scanner with streaming output.
867	
868	    This tool ENUMERATES VULNERABILITIES, MISCONFIGURATIONS, and SECURITY ISSUES.
869	    It does NOT find open ports - use port_scan for port discovery.
