9	def getBanner(ip: str, port: int, timeout: int = 5) -> Dict[str, str]:
10	    """
11	    Retrieve banner information from a host:port.
12	    Uses HTTP/HTTPS library for web services and socket connections for other services.
13	
14	    For HTTP/HTTPS services, the function automatically detects the protocol based on the port
15	    (e.g., 443, 8443 for HTTPS) and uses the appropriate connection method. For HTTPS connections,
16	    certificate verification is disabled to allow banner grabbing from servers with self-signed
17	    or invalid certificates.
18	
19	    Args:
20	        ip: IP address to connect to
21	        port: Port number to connect to
22	        timeout: Connection timeout in seconds
23	
24	    Returns:
25	        Dictionary with service, version, and banner information
26	    """
27	    try:
28	        # Initial service guess based on port
29	        initial_service = _guess_service_by_port(port)
30	
31	        # Use HTTP/HTTPS library for web services
32	        if initial_service in ["http", "https"]:
33	            return _get_web_banner(ip, port, timeout, is_https=(initial_service == "https"))
34	
35	        # Use socket connection for non-web services
36	        # Create socket connection
37	        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
38	        sock.settimeout(timeout)
39	
40	        # Connect to the target
41	        sock.connect((ip, port))
42	
43	        # Receive banner/response
44	        banner_text = ""
45	        try:
46	            data = sock.recv(1024)
47	            banner_text = data.decode('utf-8', errors='ignore').strip()
48	        except:
49	            pass
50	
51	        sock.close()
52	
53	        if banner_text:
54	            # Identify service and version from banner and port
55	            service_info = _identify_service(banner_text, port)
56	            service_name = service_info[0]
57	            version = service_info[1]
58	            if "\r\n" in banner_text:
59	                banner_text = banner_text.split("\r\n")[0]
60	
61	            return {
62	                "service": service_name,
63	                "version": version,
64	                "banner": banner_text
65	            }
66	        else:
67	            # If no banner text, use port-based guess only
68	            service_name = _guess_service_by_port(port)
69	            return {
