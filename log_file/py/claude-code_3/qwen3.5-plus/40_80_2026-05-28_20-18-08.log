8	
9	class Settings(BaseSettings):
10	    """Runtime configuration.
11	
12	    All values can be supplied via environment variables or a `.env` file.
13	    `DATABASE_URL` is the only required field.
14	    """
15	
16	    model_config = SettingsConfigDict(
17	        env_file=".env",
