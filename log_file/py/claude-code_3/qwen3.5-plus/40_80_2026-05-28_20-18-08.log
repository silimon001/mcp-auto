207	    args2: List[Any],
208	    kwargs2: Dict[str, Any],
209	) -> Tuple[List[Any], Dict[str, Any]]:
210	    """
211	    Fix for wrappers that send only one side of a turn, or use alternate names.
212	
213	    We accept (and normalize) these aliases:
214	      - user_text: "user" | "input" | "prompt" | "question"
215	      - assistant_text: "assistant" | "output" | "response" | "answer"
216	      - note: "message"
217	      - use_memory_snapshot: "snapshot" | "memory_snapshot"
218	
219	    We ALSO support positional calling patterns some wrappers may use:
220	      - gait_record_turn("just user text")
221	      - gait_record_turn("user text", "assistant text")
222	    """
223	    # 1) Positional fallbacks
224	    # If the tool was invoked positionally, map:
225	    #   [0] -> user_text, [1] -> assistant_text
226	    if args2:
227	        if "user_text" not in kwargs2 and len(args2) >= 1 and isinstance(args2[0], str):
228	            kwargs2["user_text"] = args2[0]
229	        if "assistant_text" not in kwargs2 and len(args2) >= 2 and isinstance(args2[1], str):
230	            kwargs2["assistant_text"] = args2[1]
231	        # We consumed positional intent; clear args to avoid double-binding
232	        args2 = []
233	
234	    # 2) Keyword aliases
235	    aliases = {
236	        "user": "user_text",
237	        "input": "user_text",
238	        "prompt": "user_text",
239	        "question": "user_text",
240	        "assistant": "assistant_text",
241	        "output": "assistant_text",
242	        "response": "assistant_text",
243	        "answer": "assistant_text",
244	        "message": "note",
245	        "snapshot": "use_memory_snapshot",
246	        "memory_snapshot": "use_memory_snapshot",
247	    }
248	    for src, dst in aliases.items():
249	        if dst not in kwargs2 and src in kwargs2:
250	            kwargs2[dst] = kwargs2.pop(src)
251	
252	    # 3) Some wrappers send role+text instead of user/assistant fields
253	    #    e.g. {"role":"user","text":"hi"} or {"role":"assistant","text":"hello"}
254	    role = (kwargs2.get("role") or "").strip().lower()
255	    text = kwargs2.get("text")
256	    if isinstance(text, str) and text.strip():
257	        if role == "user" and not kwargs2.get("user_text"):
258	            kwargs2["user_text"] = text
259	        elif role in ("assistant", "model") and not kwargs2.get("assistant_text"):
260	            kwargs2["assistant_text"] = text
261	
262	    # 4) Ensure keys exist (so downstream code is stable)
263	    kwargs2.setdefault("user_text", "")
264	    kwargs2.setdefault("assistant_text", "")
265	    kwargs2.setdefault("note", "gemini-cli")
266	    kwargs2.setdefault("use_memory_snapshot", True)
267	
268	    return args2, kwargs2
269	
270	# ---------------------------------------------------------------------
271	# Sticky repo root (survives MCP server restarts)
272	# ---------------------------------------------------------------------
273	_LAST_REPO_ROOT: Optional[Path] = None
274	_STICKY_FILE = Path(os.environ.get("GAIT_MCP_STICKY_FILE", "~/.gait_mcp_root")).expanduser()
275	
276	def _load_sticky_root() -> Optional[Path]:
277	    try:
278	        if _STICKY_FILE.is_file():
279	            txt = _STICKY_FILE.read_text(encoding="utf-8").strip()
280	            if txt:
281	                p = Path(txt).expanduser().resolve()
282	                if p.exists():
283	                    return p
284	    except Exception:
285	        pass
286	    return None
287	
288	def _persist_sticky_root(p: Path) -> None:
289	    try:
290	        _STICKY_FILE.parent.mkdir(parents=True, exist_ok=True)
291	        _STICKY_FILE.write_text(str(p.resolve()), encoding="utf-8")
292	    except Exception:
293	        # never fail tool calls because of this
294	        pass
295	
296	def _set_last_root(p: Path) -> None:
297	    global _LAST_REPO_ROOT
298	    _LAST_REPO_ROOT = p.resolve()
299	    _persist_sticky_root(_LAST_REPO_ROOT)
300	
301	# Load once at import time so restarts remember the last repo
302	_LAST_REPO_ROOT = _load_sticky_root()
303	
304	def _discover_repo_from(start: Path) -> Optional[GaitRepo]:
305	    cur = start.expanduser().resolve()
306	    for p in (cur, *cur.parents):
307	        if (p / ".gait").is_dir():
308	            _set_last_root(p)
309	            return GaitRepo(root=p)
310	    return None
311	
312	def _try_repo(path: Optional[str] = None) -> Tuple[Optional[GaitRepo], Optional[Dict[str, Any]]]:
313	    try:
314	        candidates: List[Path] = []
315	
316	        # 1) explicit path always wins
317	        if path is not None and str(path).strip():
318	            candidates.append(Path(path).expanduser().resolve())
319	        else:
320	            # 2) in-memory sticky
321	            if _LAST_REPO_ROOT is not None:
322	                candidates.append(_LAST_REPO_ROOT)
323	
324	            # 3) persisted sticky (covers server restarts)
325	            sticky = _load_sticky_root()
326	            if sticky is not None:
327	                candidates.append(sticky)
328	
329	            # 4) cwd
330	            candidates.append(Path.cwd())
331	
332	            # 5) home as last resort
333	            candidates.append(Path.home())
334	
335	        for start in candidates:
336	            repo = _discover_repo_from(start)
337	            if repo is not None:
338	                return (repo, None)
339	
340	        return (
341	            None,
342	            _err(
343	                "GAIT repo not found. Run /gait:init inside a project folder.",
344	                detail=f"candidates={[str(c.expanduser().resolve()) for c in candidates]} cwd={os.getcwd()} sticky={str(_LAST_REPO_ROOT) if _LAST_REPO_ROOT else ''}",
345	            ),
346	        )
347	
348	    except Exception as e:
349	        return (None, _err("GAIT repo not found. Run /gait:init inside a project folder.", detail=str(e)))
350	
351	
352	def mcp_tool(fn):
353	    """
354	    Decorator for MCP tools.
355	
356	    - Accepts wrapper calling styles used by some Gemini wrappers (args/kwargs or call_args/call_kwargs).
357	    - Preserves normal MCP invocation (positional args permitted).
358	    - Special-cases gait_record_turn to normalize one-sided turns.
359	    - Converts exceptions into structured error dicts: {"ok": False, "error": "...", "detail": "..."}.
360	    """
361	    @functools.wraps(fn)
362	    def wrapper(*call_args: Any, **call_kwargs: Any):
363	        try:
364	            args2, kwargs2 = _unpack_wrapper_call(call_kwargs)
365	
366	            # If MCP runtime passed positional args normally, preserve them
367	            if call_args:
368	                args2 = list(call_args) + args2
369	
370	            # Special normalization for gait_record_turn to retain user-only or assistant-only turns
371	            if fn.__name__ == "gait_record_turn":
372	                args2, kwargs2 = _coerce_record_turn_kwargs(list(args2), dict(kwargs2))
373	
374	            return fn(*args2, **kwargs2)
375	
376	        except Exception as e:
377	            log.exception("tool failed: %s", fn.__name__)
378	            return _err(f"{fn.__name__} failed", detail=str(e))
379	
380	    # Preserve the original function's signature for FastMCP schema generation
381	    wrapper.__signature__ = inspect.signature(fn)
382	    return wrapper
383	
384	
