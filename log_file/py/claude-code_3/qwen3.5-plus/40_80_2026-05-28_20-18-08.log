189	    invalid_chars = '<>:"/\\|?*'
190	    sanitized = filename.strip()
191	
192	    for char in invalid_chars:
193	        sanitized = sanitized.replace(char, '_')
194	
195	    # Remove leading/trailing dots and spaces
196	    sanitized = sanitized.strip('. ')
