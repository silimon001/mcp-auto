1	"""Configuration management for Red Team MCP Server."""
2	
3	import os
4	from pathlib import Path
5	from typing import List, Optional
6	
7	from pydantic import BaseModel, Field, validator
8	
9	
10	class ScannerConfig(BaseModel):
11	    """Configuration for the scanner component."""
12	
13	    masscan_path: str = Field(default="masscan", description="Path to masscan binary")
14	    use_sudo: bool = Field(default=True, description="Use sudo to run masscan (required for raw sockets)")
15	    max_rate: int = Field(default=1000, description="Maximum scan rate (packets per second)")
16	    max_targets: int = Field(default=1000, description="Maximum number of targets per scan")
17	    allowed_ports: List[int] = Field(
18	        default_factory=lambda: list(range(1, 65536)),
19	        description="List of allowed ports to scan"
20	    )
21	    blocked_networks: List[str] = Field(
22	        default_factory=lambda: [
23	            "127.0.0.0/8",    # Localhost
24	            "10.0.0.0/8",     # Private networks
25	            "172.16.0.0/12",  # Private networks
26	            "192.168.0.0/16", # Private networks
27	            "169.254.0.0/16", # Link-local
28	            "224.0.0.0/4",    # Multicast
29	        ],
30	        description="Networks that are blocked from scanning"
31	    )
32	    timeout: int = Field(default=300, description="Scan timeout in seconds")
33	
34	    @validator('max_rate')
35	    def validate_max_rate(cls, v):
36	        if v <= 0 or v > 100000:
37	            raise ValueError('max_rate must be between 1 and 100000')
38	        return v
39	
40	    @validator('max_targets')
41	    def validate_max_targets(cls, v):
42	        if v <= 0 or v > 10000:
43	            raise ValueError('max_targets must be between 1 and 10000')
44	        return v
45	
46	
47	class SecurityConfig(BaseModel):
48	    """Security configuration for the MCP server."""
49	
50	    enable_logging: bool = Field(default=True, description="Enable detailed logging")
51	    log_level: str = Field(default="INFO", description="Logging level")
52	    log_file: Optional[str] = Field(default=None, description="Log file path")
53	    require_auth: bool = Field(default=False, description="Require authentication")
54	    auth_token: Optional[str] = Field(default=None, description="Authentication token")
55	    rate_limit_requests: int = Field(default=100, description="Rate limit per minute")
56	
57	    @validator('log_level')
58	    def validate_log_level(cls, v):
59	        valid_levels = ['DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL']
60	        if v.upper() not in valid_levels:
61	            raise ValueError(f'log_level must be one of {valid_levels}')
62	        return v.upper()
63	
64	
65	class RedTeamMCPConfig(BaseModel):
66	    """Main configuration for Red Team MCP Server."""
67	
68	    server_name: str = Field(default="red-team-mcp", description="Server name")
69	    version: str = Field(default="0.1.0", description="Server version")
70	    scanner: ScannerConfig = Field(default_factory=ScannerConfig)
71	    security: SecurityConfig = Field(default_factory=SecurityConfig)
72	    data_dir: Path = Field(
73	        default_factory=lambda: Path.home() / ".red-team-mcp",
74	        description="Data directory for storing results"
75	    )
76	
77	    def __init__(self, **kwargs):
78	        super().__init__(**kwargs)
79	        # Ensure data directory exists
80	        self.data_dir.mkdir(parents=True, exist_ok=True)
81	
82	    @classmethod
83	    def from_env(cls) -> "RedTeamMCPConfig":
84	        """Load configuration from environment variables."""
85	        config_data = {}
86	
87	        # Scanner config from env
88	        scanner_config = {}
89	        if masscan_path := os.getenv("REDTEAM_MASSCAN_PATH"):
90	            scanner_config["masscan_path"] = masscan_path
91	        if max_rate := os.getenv("REDTEAM_MAX_RATE"):
92	            scanner_config["max_rate"] = int(max_rate)
93	        if max_targets := os.getenv("REDTEAM_MAX_TARGETS"):
94	            scanner_config["max_targets"] = int(max_targets)
95	        if timeout := os.getenv("REDTEAM_TIMEOUT"):
96	            scanner_config["timeout"] = int(timeout)
97	
98	        if scanner_config:
99	            config_data["scanner"] = scanner_config
100	
101	        # Security config from env
102	        security_config = {}
103	        if log_level := os.getenv("REDTEAM_LOG_LEVEL"):
104	            security_config["log_level"] = log_level
105	        if log_file := os.getenv("REDTEAM_LOG_FILE"):
106	            security_config["log_file"] = log_file
107	        if auth_token := os.getenv("REDTEAM_AUTH_TOKEN"):
108	            security_config["auth_token"] = auth_token
109	            security_config["require_auth"] = True
110	        if rate_limit := os.getenv("REDTEAM_RATE_LIMIT"):
111	            security_config["rate_limit_requests"] = int(rate_limit)
112	
113	        if security_config:
114	            config_data["security"] = security_config
115	
116	        # Data directory from env
117	        if data_dir := os.getenv("REDTEAM_DATA_DIR"):
118	            config_data["data_dir"] = Path(data_dir)
119	
120	        return cls(**config_data)
121	
122	    @classmethod
123	    def from_file(cls, config_path: Path) -> "RedTeamMCPConfig":
124	        """Load configuration from a JSON file."""
125	        import json
126	
127	        if not config_path.exists():
128	            raise FileNotFoundError(f"Configuration file not found: {config_path}")
129	
130	        with open(config_path, 'r') as f:
131	            config_data = json.load(f)
132	
133	        return cls(**config_data)
134	
135	    def save_to_file(self, config_path: Path) -> None:
136	        """Save configuration to a JSON file."""
137	        import json
138	
139	        config_path.parent.mkdir(parents=True, exist_ok=True)
140	
141	        with open(config_path, 'w') as f:
142	            json.dump(self.dict(), f, indent=2, default=str)
143	

