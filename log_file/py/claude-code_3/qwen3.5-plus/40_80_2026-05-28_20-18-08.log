31	async def search_meme_templates(query: str, include_nsfw: int = 0) -> Dict[str, Any]:
32	    """Search for meme templates using the Imgflip Premium API"""
33	    url = "https://api.imgflip.com/search_memes"
34	    
35	    username = os.getenv("IMGFLIP_USERNAME")
36	    password = os.getenv("IMGFLIP_PASSWORD")
37	    
38	    if not username or not password:
39	        return {
40	            "success": False, 
41	            "error_message": "IMGFLIP_USERNAME and IMGFLIP_PASSWORD environment variables are required for premium features"
42	        }
43	    
44	    # Prepare the payload using FormData format
45	    form_data = aiohttp.FormData()
46	    form_data.add_field("username", username)
47	    form_data.add_field("password", password)
48	    form_data.add_field("query", query)
49	    form_data.add_field("include_nsfw", str(include_nsfw))
50	    
51	    try:
52	        async with aiohttp.ClientSession() as session:
53	            async with session.post(url, data=form_data) as response:
54	                data = await response.json()
55	                
56	                if not data.get("success"):
57	                    error_message = data.get("error_message", "Unknown API error")
58	                    logging.error(f"ImgFlip Search API error: {error_message}")
59	                    return {"success": False, "error_message": error_message}
60	                
61	                return data
62	    except aiohttp.ClientError as e:
63	        logging.error(f"Error connecting to ImgFlip API: {str(e)}")
64	        return {"success": False, "error_message": f"Connection error: {str(e)}"}
65	    except json.JSONDecodeError:
66	        logging.error("Error decoding JSON response from ImgFlip API")
67	        return {"success": False, "error_message": "Invalid response from ImgFlip API"}
68	    except Exception as e:
69	        logging.error(f"Unexpected error searching meme templates: {str(e)}")
70	        return {"success": False, "error_message": f"Unexpected error: {str(e)}"}
