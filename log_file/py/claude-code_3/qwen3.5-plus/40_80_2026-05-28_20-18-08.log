11	async def get_meme_templates() -> Dict[str, Any]:
12	    """Get popular meme templates from Imgflip API (used as fallback)"""
13	    url = "https://api.imgflip.com/get_memes"
14	    
15	    async with aiohttp.ClientSession() as session:
16	        try:
17	            async with session.get(url) as response:
18	                response.raise_for_status()
19	                data = await response.json()
20	                return data
21	        except aiohttp.ClientError as e:
22	            logging.error(f"Error connecting to ImgFlip API: {str(e)}")
23	            return {"success": False, "error_message": f"Connection error: {str(e)}"}
24	        except json.JSONDecodeError:
25	            logging.error("Error decoding JSON response from ImgFlip API")
26	            return {"success": False, "error_message": "Invalid response from ImgFlip API"}
27	        except Exception as e:
28	            logging.error(f"Unexpected error getting templates: {str(e)}")
29	            return {"success": False, "error_message": f"Unexpected error: {str(e)}"}
