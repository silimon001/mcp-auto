398	def add_extra_info(dataset_name: str, repo_id: str) -> str:
399	    """从数据集读取仓库额外信息"""
400	    final_text = ''
401	    repo_info_path = Path.cwd() / "data" / "dataset" / dataset_name / "repo_info.json"
402	    if repo_info_path.exists():
403	        with open(repo_info_path, 'r', encoding='utf-8') as f:
404	            repo_infos = json.load(f)
405	        for repo_info in repo_infos:
406	            if repo_info.get('id') == int(repo_id):
407	                info = {k: repo_info.get(k) for k in ["id", "description", "language", "size", "topic", "html_url"]}
408	                info['owner'] = repo_info.get('full_name').split('/')[0]
409	                info['name'] = repo_info.get('full_name').split('/')[1]
410	                final_text += f'\n=== REPO INFO START ===\n{info}\n=== REPO INFO END ===\n'
411	                break
412	    return final_text
