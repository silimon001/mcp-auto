1000	@mcp.tool()
1001	async def animate_camera(
1002	    animation_type: str,
1003	    camera_name: Optional[str] = None,
1004	    positions: Optional[List[List[float]]] = None,
1005	    frames: Optional[List[int]] = None,
1006	    ctx: Context = None,
1007	) -> str:
1008	    """
1009	    Create a camera animation.
1010	
1011	    Args:
1012	        animation_type: Type of animation (wiggle, orbit, spline, linear)
1013	        camera_name: Optional name of camera to animate
1014	        positions: Optional list of [x,y,z] camera positions for keyframes
1015	        frames: Optional list of frame numbers for keyframes
1016	    """
1017	    async with c4d_connection_context() as connection:
1018	        if not connection.connected:
1019	            return "❌ Not connected to Cinema 4D"
1020	
1021	        # Create command with the animation type
1022	        command = {"command": "animate_camera", "path_type": animation_type}
1023	
1024	        # Add camera name if provided
1025	        if camera_name:
1026	            command["camera_name"] = camera_name
1027	
1028	        # Handle positions and frames if provided
1029	        if positions:
1030	            command["positions"] = positions
1031	
1032	            # Generate frames if not provided (starting at 0 with 15 frame intervals)
1033	            if not frames:
1034	                frames = [i * 15 for i in range(len(positions))]
1035	
1036	            command["frames"] = frames
1037	
1038	        if animation_type == "orbit":
1039	            # For orbit animations, we need to generate positions in a circle
1040	            # if none are provided
1041	            if not positions:
1042	                # Create a set of default positions for an orbit animation
1043	                radius = 200  # Default orbit radius
1044	                height = 100  # Default height
1045	                points = 12  # Number of points around the circle
1046	
1047	                orbit_positions = []
1048	                orbit_frames = []
1049	
1050	                # Create positions in a circle
1051	                for i in range(points):
1052	                    angle = (i / points) * 2 * 3.14159  # Convert to radians
1053	                    x = radius * math.cos(angle)
1054	                    z = radius * math.sin(angle)
1055	                    y = height
1056	                    orbit_positions.append([x, y, z])
1057	                    orbit_frames.append(i * 10)  # 10 frames between positions
1058	
1059	                command["positions"] = orbit_positions
1060	                command["frames"] = orbit_frames
1061	
1062	        # Send the command to Cinema 4D
1063	        response = send_to_c4d(connection, command)
1064	
1065	        return format_c4d_response(response, "animate_camera")
