168	def get_adapter() -> Optional[MijiaAdapter]:
169	    global _adapter
170	    if _adapter is None:
171	        try:
172	            _adapter = MijiaAdapter()
173	            logger.info("Mijia adapter created successfully")
174	        except Exception as exc:
175	            logger.error(f"Failed to create Mijia adapter: {exc}")
176	    return _adapter
