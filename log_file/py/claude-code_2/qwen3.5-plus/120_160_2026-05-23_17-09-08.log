733	    if operation == "turn_off":
734	        return f"已请求关闭 {device_name}。当前状态摘要：{after_summary}"
735	    if operation == "toggle":
736	        return f"已请求切换 {device_name}。当前状态摘要：{after_summary}"
737	    return f"已对 {device_name} 执行 {operation}。当前状态摘要：{after_summary}"
