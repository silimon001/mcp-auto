1041	@click.command()
1042	@click.option("--port", default=8000, help="Port to listen on for HTTP/SSE connections")
1043	@click.option(
1044	    "--transport",
1045	    type=click.Choice(["stdio", "sse"]),
1046	    default="sse",
1047	    help="Transport type (stdio for command line, sse for Claude Desktop)"
1048	)
1049	@click.option(
1050	    "--debug", 
1051	    is_flag=True, 
1052	    default=False, 
1053	    help="Enable debug mode"
1054	)
1055	def main(port: int, transport: str, debug: bool) -> int:
1056	    """
1057	    Start the Kali MCP Server with the specified transport.
1058	    
1059	    Args:
1060	        port: Port number to listen on when using SSE transport
1061	        transport: Transport type (stdio or SSE)
1062	        debug: Enable debug mode
1063	        
1064	    Returns:
1065	        Exit code (0 for success)
1066	    """
1067	    if transport == "sse":
1068	        return start_sse_server(port, debug)
1069	    else:
1070	        return start_stdio_server(debug)
1071	
1072	
1073	def start_sse_server(port: int, debug: bool) -> int:
1074	    """
1075	    Start the server with SSE transport for web/Claude Desktop usage.
1076	    
1077	    Args:
1078	        port: Port number to listen on
1079	        debug: Enable debug mode
1080	        
1081	    Returns:
1082	        Exit code (0 for success)
1083	    """
1084	    import uvicorn
1085	    from mcp.server.sse import SseServerTransport
1086	    from starlette.applications import Starlette
1087	    from starlette.routing import Mount, Route
1088	
1089	    # Create SSE transport handler
1090	    sse_transport = SseServerTransport("/messages/")
1091	
1092	    async def handle_sse_connection(request):
1093	        """Handle incoming SSE connections."""
1094	        async with sse_transport.connect_sse(
1095	            request.scope, request.receive, request._send
1096	        ) as streams:
1097	            await kali_server.run(
1098	                streams[0], streams[1], kali_server.create_initialization_options()
1099	            )
1100	
1101	    # Configure Starlette routes
1102	    starlette_app = Starlette(
1103	        debug=debug,
1104	        routes=[
1105	            Route("/sse", endpoint=handle_sse_connection),
1106	            Mount("/messages/", app=sse_transport.handle_post_message),
1107	        ],
1108	    )
1109	
1110	    # Run the server
1111	    print(f"Starting Kali MCP Server with SSE transport on port {port}")
1112	    print(f"Connect to this server using: http://localhost:{port}/sse")
1113	    uvicorn.run(starlette_app, host="0.0.0.0", port=port)
1114	    return 0
1115	
1116	
1117	def start_stdio_server(debug: bool) -> int:
1118	    """
1119	    Start the server with stdio transport for command-line usage.
1120	    
1121	    Args:
1122	        debug: Enable debug mode
1123	        
1124	    Returns:
1125	        Exit code (0 for success)
1126	    """
1127	    from mcp.server.stdio import stdio_server
1128	
1129	    async def start_stdio_connection():
1130	        """Initialize and run the stdio server."""
1131	        print("Starting Kali MCP Server with stdio transport")
1132	        async with stdio_server() as streams:
1133	            await kali_server.run(
1134	                streams[0], streams[1], kali_server.create_initialization_options()
1135	            )
1136	
1137	    # Run the server
1138	    anyio.run(start_stdio_connection)
1139	    return 0
1140	
1141	
1142	if __name__ == "__main__":
1143	    main()

