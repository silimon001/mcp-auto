70	    password = os.getenv("DELINEA_PASSWORD")
71	    base_url = cfg.get("delinea_base_url") or os.getenv("DELINEA_BASE_URL")
72	
73	    platform_hostname = cfg.get("platform_hostname") or os.getenv(
74	        "PLATFORM_HOSTNAME", ""
75	    )
76	    if username and password:
77	        session = DelineaSession(
78	            base_url=base_url or "",
79	            username=username,
80	            platform_hostname=platform_hostname,
81	        )
82	        SessionManager.init(session)
83	    enabled = set(cfg.get("enabled_tools", []))
84	    tools.register(mcp, enabled)
85	
86	    # Always register the legacy SS-local user tools so SS-only deployments
87	    # have a fallback even when Platform is not configured.
88	    secretserver_users.register(mcp)
89	
90	    # Configure Platform tools.  Always register them so the canonical
91	    # user_management / search_users tool names are available to the
92	    # client.  When Platform is not configured the tools return a clear
93	    # error directing the caller to either configure Platform or use
94	    # secretserver_local_*.
95	    if cfg.get("platform_hostname"):
96	        user_platform_tools.configure(
