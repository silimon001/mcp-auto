153	class Client:
154	    def __init__(self):
155	        self.session: Optional[ClientSession] = None
156	        self.exit_stack = AsyncExitStack()
157	        self.tools = []
158	        self.process = None
159	        self._server_process_started = False  # 标记是否由我们启动了服务器进程
