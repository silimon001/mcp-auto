58	def _init_from_config(cfg: dict[str, Any]) -> None:
59	    """Initialise sessions and tool registration from a config dict."""
60	    tools.configure(cfg)
61	    global _debug
62	    _debug = bool(cfg.get("debug", False))
63	    if _debug and not logging.getLogger().handlers:
64	        logging.basicConfig(level=logging.DEBUG)
