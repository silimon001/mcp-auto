247	async def get_device_profile(adapter: MijiaAdapter, device_id: str) -> Dict[str, Any]:
248	    devices = await adapter.list_device_infos(refresh=False)
249	    device_info = next((device for device in devices if str(device.get("did")) == str(device_id)), {"did": device_id})
250	    normalized_device = normalize_device(device_info)
251	    properties = dedupe_properties(await adapter.get_device_properties(device_id))
252	    actions = dedupe_actions(await adapter.get_device_actions(device_id))
253	    capabilities = summarize_capabilities(properties, actions)
254	    capability_profile = build_device_capability_profile(device_info, properties, actions)
255	    mapping_report = build_capability_mapping_report(properties, actions, capability_profile)
256	
257	    state: Dict[str, Any] = {}
258	    for control_name, target in capability_profile["controls"].items():
259	        if target.get("kind") == "property" and target.get("readable") and target.get("name"):
260	            try:
261	                state[control_name] = await adapter.get_property_value_by_name(device_id, target["name"])
262	            except Exception:
263	                continue
264	
265	    if normalized_device.get("device_type") in READ_MOSTLY_DEVICE_TYPES:
266	        for prop in properties:
267	            prop_name = getattr(prop, "name", None)
268	            if not prop_name or prop_name in state:
269	                continue
270	            if not getattr(prop, "rw", None) or "r" in str(getattr(prop, "rw", "")).lower():
271	                try:
272	                    state[prop_name] = await adapter.get_property_value_by_name(device_id, prop_name)
273	                except Exception:
274	                    continue
275	
276	    profile = {
277	        "capabilities": capabilities,
278	        "capability_profile": capability_profile,
279	        "mapping_report": mapping_report,
280	        "standard_capability_schema": build_standard_capability_schema(capability_profile),
281	        "profile_driven_schema": build_profile_driven_schema(properties, actions),
282	        "supported_operations": describe_supported_operations(capability_profile["supported_operations"]),
283	        "state": state,
284	        "state_summary": build_state_summary(state),
285	    }
286	    profile["device_resource"] = build_device_resource(normalized_device, profile)
287	    return profile
288	
289	
290	def summarize_device_profile(profile: Dict[str, Any]) -> Dict[str, Any]:
291	    capability_profile = profile["capability_profile"]
292	    summary_controls = []
293	    for capability_name, target in capability_profile.get("controls", {}).items():
294	        summary_controls.append(
295	            {
296	                "capability": capability_name,
297	                "kind": target.get("kind"),
298	                "name": target.get("name"),
299	                "readable": target.get("readable"),
300	                "writable": target.get("writable"),
301	            }
302	        )
303	
304	    summary_supported_operations = [
305	        {
306	            "operation": item["operation"],
307	            "enabled": item["enabled"],
308	            "preferred_tool": item["preferred_tool"],
309	        }
310	        for item in profile.get("supported_operations", [])
311	        if item.get("enabled")
312	    ]
313	
314	    mapping_report = profile.get("mapping_report", {})
315	    return {
316	        "primary_domain": capability_profile.get("primary_domain"),
317	        "device_domains": capability_profile.get("device_domains", []),
318	        "capability_families": capability_profile.get("capability_families", []),
319	        "controls": summary_controls,
320	        "supported_operations": summary_supported_operations,
321	        "state": profile.get("state", {}),
322	        "state_summary": build_state_summary(profile.get("state", {})),
323	        "mapping_summary": {
324	            "mapped_property_count": mapping_report.get("mapped_property_count", 0),
325	            "unmapped_property_count": mapping_report.get("unmapped_property_count", 0),
326	            "mapped_action_count": mapping_report.get("mapped_action_count", 0),
327	            "unmapped_action_count": mapping_report.get("unmapped_action_count", 0),
328	            "coverage": mapping_report.get("coverage", {}),
329	        },
330	        "profile_driven_controls": {
331	            "generic_operations": profile.get("profile_driven_schema", {}).get("generic_operations", {}),
332	            "writable_properties": [
333	                {
334	                    "name": item.get("name"),
335	                    "description": item.get("description"),
336	                    "type": item.get("type"),
337	                    "range": item.get("range"),
338	                    "value_list": item.get("value_list"),
339	                }
340	                for item in profile.get("profile_driven_schema", {}).get("writable_properties", [])
341	            ],
342	            "actions": [
343	                {
344	                    "name": item.get("name"),
345	                    "description": item.get("description"),
346	                }
347	                for item in profile.get("profile_driven_schema", {}).get("actions", [])
348	            ],
349	        },
350	        "device_resource": profile.get("device_resource", {}),
351	    }
352	
353	
354	def build_enabled_operations(profile: Dict[str, Any]) -> List[Dict[str, Any]]:
355	    return [
356	        {
357	            "operation": item["operation"],
358	            "preferred_tool": item["preferred_tool"],
359	        }
360	        for item in profile.get("supported_operations", [])
361	        if item.get("enabled")
362	    ]
363	
364	
365	def build_device_status_payload(device: Dict[str, Any], profile: Dict[str, Any]) -> Dict[str, Any]:
366	    enabled_operations = build_enabled_operations(profile)
367	    state_summary = profile.get("state_summary", build_state_summary(profile.get("state", {})))
368	    return {
369	        "device": {k: v for k, v in device.items() if k != "raw"},
370	        "device_resource": profile.get("device_resource", {}),
371	        "state": profile.get("state", {}),
372	        "state_summary": state_summary,
373	        "supported_operations": enabled_operations,
374	        "assistant_summary": (
375	            f"{device.get('name')} 当前位于 {device.get('location', {}).get('label') or '未知位置'}，"
376	            f"在线状态为 {'在线' if device.get('online') else '离线'}。"
377	            f"当前摘要：{state_summary}"
378	        ),
379	        "quick_actions": [item["operation"] for item in enabled_operations[:5]],
380	        "next_steps": {
381	            "use_control_by_intent": bool(profile.get("device_resource", {}).get("usage")),
382	            "use_control_device": bool(profile.get("profile_driven_schema", {}).get("generic_operations")),
383	            "check_capabilities_with": "get_device_capabilities",
384	        },
385	    }
