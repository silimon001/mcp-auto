674	def build_service_status_payload(adapter: Optional[MijiaAdapter]) -> Dict[str, Any]:
675	    if not adapter:
676	        return {
677	            "service": {
678	                "name": SERVER_NAME,
679	                "version": SERVER_VERSION,
680	                "connected": False,
681	                "has_saved_login": False,
682	                "auth_file": None,
683	                "log_file": str(log_file_path),
684	                "qr": None,
685	                "device_count": 0,
686	            },
687	            "assistant_summary": "服务尚未初始化，先检查服务启动状态。",
688	            "next_steps": {
689	                "prepare_login_with": "prepare_login",
690	                "status_with": "get_service_status",
691	            },
692	        }
693	
694	    qr_status = adapter.get_qr_status()
695	    connected = adapter.connected
696	    has_saved_login = adapter.has_valid_auth_data()
697	    should_scan_qr = bool(not connected and qr_status.get("enabled") and (not has_saved_login or qr_status.get("page_exists") or qr_status.get("image_exists")))
698	
699	    if connected:
700	        assistant_summary = "服务已连接米家云，可以直接刷新设备或开始控制。"
701	    elif should_scan_qr:
702	        assistant_summary = "服务当前未连接，建议先扫码完成登录；二维码页和图片路径已在 service.qr 中提供。"
703	    elif has_saved_login:
704	        assistant_summary = "服务当前未连接，但本地存在已保存登录，可尝试重连。"
705	    else:
706	        assistant_summary = "服务当前未连接，也没有可用的已保存登录，建议先准备二维码登录。"
707	
708	    return {
709	        "service": {
710	            "name": SERVER_NAME,
711	            "version": SERVER_VERSION,
712	            "connected": connected,
713	            "has_saved_login": has_saved_login,
714	            "auth_file": str(adapter.get_auth_file_path()),
715	            "log_file": str(log_file_path),
716	            "qr": qr_status,
717	            "device_count": adapter.device_count,
718	        },
719	        "assistant_summary": assistant_summary,
720	        "next_steps": {
721	            "should_scan_qr": should_scan_qr,
722	            "prepare_login_with": "prepare_login",
723	            "reconnect_with": "reconnect_service",
724	            "refresh_devices_with": "refresh_devices" if connected else None,
725	        },
726	    }
