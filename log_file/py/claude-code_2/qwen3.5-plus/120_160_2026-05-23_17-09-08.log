17	    # Try to find Python with MCP installed
18	    for py_cmd in python3.9 python3.10 python3.11 python3.12; do
19	        if command -v $py_cmd >/dev/null 2>&1; then
20	            if $py_cmd -c "import importlib.util; exit(0 if importlib.util.find_spec('mcp') else 1)" 2>/dev/null; then
21	                PYTHON_EXEC=$py_cmd
22	                echo "Found MCP in $PYTHON_EXEC"
