67	    def _setup(self):
68	        if not self.config.enable_logging:
69	            return
70	
71	        # 关键修复：递归创建目录
72	        self.config.log_dir.mkdir(parents=True, exist_ok=True)
73	
74	        timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
75	        log_filename = self.config.log_dir / f"{self.config.pos}_{self.config.pos+self.config.count}_{timestamp}.log"
76	
77	        print(f"Logging to: {log_filename}")
78	
79	        logging.basicConfig(
80	            filename=str(log_filename),
81	            level=logging.INFO,
82	            format='%(asctime)s - %(levelname)s - %(message)s',
83	            filemode='w',
84	            force=True
85	        )
86	
87	    def log(self, content: str, is_error: bool = False):
88	        print(content)
