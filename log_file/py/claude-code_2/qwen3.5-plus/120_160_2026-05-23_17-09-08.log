585	@mcp.tool()
586	async def inspect_redshift_materials(
587	    material_name: Optional[str] = None,
588	    include_assignments: bool = True,
589	    include_preview: bool = True,
590	    include_description: bool = True,
591	    include_container: bool = True,
592	    include_graph: bool = True,
593	    ctx: Context = None,
594	) -> str:
595	    """
596	    Inspect Redshift materials with best-effort fallbacks.
597	
598	    This tool is read-only and is designed to be useful even when the Redshift
599	    Python runtime is unavailable. It can still report names, assignments,
600	    preview-derived colors, readable description/container fields, and will
601	    attempt graph inspection only when Cinema 4D exposes that data.
602	
603	    Args:
604	        material_name: Optional material name filter
605	        include_assignments: Include texture-tag assignments in the scene
606	        include_preview: Include sampled preview bitmap color data
607	        include_description: Include readable description entries
608	        include_container: Include safe BaseContainer values
609	        include_graph: Attempt node-graph inspection when available
610	    """
611	    async with c4d_connection_context() as connection:
612	        if not connection.connected:
613	            return "❌ Not connected to Cinema 4D"
614	
615	        command = {
616	            "command": "inspect_redshift_materials",
617	            "include_assignments": include_assignments,
618	            "include_preview": include_preview,
619	            "include_description": include_description,
620	            "include_container": include_container,
621	            "include_graph": include_graph,
622	        }
623	
624	        if material_name:
625	            command["material_name"] = material_name
626	
627	        response = send_to_c4d(connection, command)
628	
629	        if "error" in response:
630	            return f"❌ Error: {response['error']}"
631	
632	        return json.dumps(response, indent=2)
