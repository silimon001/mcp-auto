1	from __future__ import annotations
2	
3	import json
4	import re
5	from collections import OrderedDict
6	from dataclasses import dataclass, field
7	from pathlib import Path
8	from typing import List
9	
10	
11	# ============================================================
12	# 1. 正则
13	# ============================================================
14	
15	# RESULT block
16	RESULT_RE = re.compile(
17	    r"=+\s*\n\[RESULT\].*?(?=\n=+|\Z)",
18	    re.MULTILINE | re.DOTALL
19	)
20	
21	# TURN
22	TURN_RE = re.compile(
23	    r"\[TURN\s+(\d+)\]"
24	)
25	
26	# TOOL
27	TOOL_RE = re.compile(
28	    r"\[ASSISTANT\]\[TOOL\]:\s*(.+)"
29	)
30	
31	# assistant 普通输出
32	ASSISTANT_RE = re.compile(
33	    r"\[ASSISTANT\](?!\[TOOL\])\s*:?(.*)",
34	)
35	
36	# RESULT 状态
37	RESULT_FAIL_RE = re.compile(
38	    r"状态:\s*❌\s*失败"
39	)
40	
41	RESULT_SUCCESS_RE = re.compile(
42	    r"状态:\s*✅\s*成功"
43	)
44	
45	# DONE / FAILED FLAG
46	DONE_LINE_RE = re.compile(
47	    r"^\s*✅\s*@@Task Done@@\s*$"
48	)
49	
50	FAILED_LINE_RE = re.compile(
51	    r"^\s*❌\s*@@Task Failed@@\s*$"
52	)
53	
54	SERVER_OK_RE = re.compile(
55	    r"^\[OK\]\s+The server\s+.+?\s+started successfully,\s+tools:\s+.+$",
56	    re.MULTILINE
57	)
58	
59	# ============================================================
60	# 2. 数据结构
61	# ============================================================
62	
63	@dataclass
64	class ToolCall:
65	    tool_name: str
66	    tool_args: str
67	
68	
69	@dataclass
70	class LoopRecord:
71	    loop_id: int
72	    tool_calls: list[ToolCall] = field(default_factory=list)
73	
74	
75	@dataclass
76	class SegmentRecord:
77	    serial_number: int
78	    status: str
79	    loops: List[LoopRecord] = field(default_factory=list)
80	
81	
82	# ============================================================
83	# 3. Segment 切分
84	# ============================================================
85	
86	def split_segments(text: str) -> list[str]:
87	    """
88	    基于 [RESULT] 切分任务段
89	    """
90	
91	    matches = list(RESULT_RE.finditer(text))
92	
93	    if not matches:
94	        return [text]
95	
96	    segments = []
97	
98	    start = 0
99	
100	    for m in matches:
101	        end = m.end()
102	
103	        seg = text[start:end].strip()
104	
105	        if seg:
106	            segments.append(seg)
107	
108	        start = end
109	
110	    tail = text[start:].strip()
111	
112	    if tail:
113	        segments.append(tail)
114	
115	    return segments
116	
117	
118	# ============================================================
119	# 4. assistant 输出提取
120	# ============================================================
121	
122	def extract_last_assistant_message(segment: str) -> str:
123	    """
124	    仅提取最后一个 assistant 普通输出
125	    不包含:
126	        [ASSISTANT][TOOL]
127	    """
128	
129	    lines = segment.splitlines()
130	
131	    messages = []
132	
133	    collecting = False
134	    current = []
135	
136	    for line in lines:
137	
138	        # TOOL 行直接结束
139	        if TOOL_RE.search(line):
140	            if collecting and current:
141	                messages.append("\n".join(current).strip())
142	            collecting = False
143	            current = []
144	            continue
145	
146	        # assistant 开始
147	        if line.startswith("[ASSISTANT]") and "[TOOL]" not in line:
148	
149	            if collecting and current:
150	                messages.append("\n".join(current).strip())
151	
152	            collecting = True
153	
154	            content = line.replace("[ASSISTANT]", "").strip(": ")
155	
156	            current = [content]
157	            continue
158	
159	        # 进入其它 block
160	        if line.startswith("[USER]") \
161	                or line.startswith("[SYSTEM]") \
162	                or line.startswith("[TOOL]") \
163	                or TURN_RE.search(line):
164	
165	            if collecting and current:
166	                messages.append("\n".join(current).strip())
167	
168	            collecting = False
169	            current = []
170	            continue
171	
172	        # assistant continuation
173	        if collecting:
174	            current.append(line)
175	
176	    if collecting and current:
177	        messages.append("\n".join(current).strip())
178	
179	    if not messages:
180	        return ""
181	
182	    return messages[-1]
183	
184	
185	# ============================================================
186	# 5. 提取状态（新逻辑）
187	# ============================================================
188	
189	def extract_last_flag(message: str) -> str | None:
190	    """
191	    只识别：
192	        单独占一行的 flag
193	
194	    返回：
195	        DONE
196	        FAILED
197	        None
198	    """
199	
200	    flags = []
201	
202	    for raw_line in message.splitlines():
203	
204	        line = raw_line.strip()
205	
206	        if DONE_LINE_RE.fullmatch(line):
207	            flags.append("DONE")
208	
209	        elif FAILED_LINE_RE.fullmatch(line):
210	            flags.append("FAILED")
211	
212	    if not flags:
213	        return None
214	
215	    return flags[-1]
216	
217	def extract_status(segment: str) -> str:
218	    """
219	    最终可靠判定逻辑：
220	
221	    成功必须同时满足：
222	
223	    1. segment 中存在:
224	       [OK] The server xxx started successfully
225	
226	    2. 最后 assistant message 中
227	       最后一个独立行 flag 是:
228	       ✅ @@Task Done@@
229	
230	    否则失败
231	    """
232	
233	    # --------------------------------------------------------
234	    # 1. 必须存在 server started successfully
235	    # --------------------------------------------------------
236	
237	    server_ok = bool(
238	        SERVER_OK_RE.search(segment)
239	    )
240	
241	    if not server_ok:
242	        return "❌ @@Task Failed@@"
243	
244	    # --------------------------------------------------------
245	    # 2. 提取最后 assistant message
246	    # --------------------------------------------------------
247	
248	    last_msg = extract_last_assistant_message(segment)
249	
250	    if not last_msg:
251	        return "❌ @@Task Failed@@"
252	
253	    # --------------------------------------------------------
254	    # 3. 提取最后 flag
255	    # --------------------------------------------------------
256	
257	    last_flag = extract_last_flag(last_msg)
258	
259	    # --------------------------------------------------------
260	    # 4. 最终判定
261	    # --------------------------------------------------------
262	
263	    if last_flag == "DONE":
264	        return "✅ @@Task Done@@"
265	
266	    return "❌ @@Task Failed@@"
267	
268	# ============================================================
269	# 6. compact json
270	# ============================================================
271	
272	def compact_json(raw: str) -> str:
273	
274	    raw = raw.strip()
275	
276	    if not raw:
277	        return "{}"
278	
279	    try:
280	
281	        data = json.loads(raw)
282	
283	        if isinstance(data, dict):
284	            data.pop("description", None)
285	
286	        return json.dumps(
287	            data,
288	            ensure_ascii=False,
289	            separators=(",", ":"),
290	        )
291	
292	    except Exception:
293	
294	        return " ".join(
295	            raw.split()
296	        )
297	
298	
299	# ============================================================
300	# 7. 解析 loops
301	# ============================================================
302	
303	def parse_loops(segment: str) -> list[LoopRecord]:
304	
305	    lines = segment.splitlines()
306	
307	    loop_map: OrderedDict[int, LoopRecord] = OrderedDict()
308	
309	    current_turn = None
310	
311	    i = 0
312	
313	    while i < len(lines):
314	
315	        line = lines[i]
316	
317	        # -------------------------------------------------
318	        # TURN
319	        # -------------------------------------------------
320	
321	        m = TURN_RE.search(line)
322	
323	        if m:
324	
325	            turn_id = int(m.group(1))
326	
327	            # 跳过 turn0
328	            if turn_id == 0:
329	                current_turn = None
330	                i += 1
331	                continue
332	
333	            current_turn = turn_id
334	
335	            if current_turn not in loop_map:
336	                loop_map[current_turn] = LoopRecord(
337	                    loop_id=current_turn
338	                )
339	
340	            i += 1
341	            continue
342	
343	        # -------------------------------------------------
344	        # TOOL
345	        # -------------------------------------------------
346	
347	        m = TOOL_RE.search(line)
348	
349	        if m and current_turn is not None:
350	
351	            tool_name = m.group(1).strip()
352	
353	            i += 1
354	
355	            # 找 TOOL INPUT
356	            while i < len(lines):
357	
358	                if "[TOOL INPUT]:" in lines[i]:
359	                    break
360	
361	                if TOOL_RE.search(lines[i]):
362	                    break
363	
364	                if TURN_RE.search(lines[i]):
365	                    break
366	
367	                i += 1
368	
369	            raw_args = "{}"
370	
371	            if i < len(lines) and "[TOOL INPUT]:" in lines[i]:
372	
373	                i += 1
374	
375	                arg_lines = []
376	
377	                while i < len(lines):
378	
379	                    nxt = lines[i]
380	
381	                    if TURN_RE.search(nxt):
382	                        break
383	
384	                    if TOOL_RE.search(nxt):
385	                        break
386	
387	                    if nxt.startswith("[TOKENS]"):
388	                        break
389	
390	                    if nxt.startswith("------------------------------------------------------------"):
391	                        break
392	
393	                    arg_lines.append(nxt)
394	
395	                    i += 1
396	
397	                raw_args = "\n".join(arg_lines)
398	
399	            cleaned_args = compact_json(raw_args)
400	
401	            loop_map[current_turn].tool_calls.append(
402	                ToolCall(
403	                    tool_name=tool_name,
404	                    tool_args=cleaned_args,
405	                )
406	            )
407	
408	            continue
409	
410	        i += 1
411	
412	    # turn 连续重编号
413	    final_loops = []
414	
415	    for new_idx, (_, loop) in enumerate(
416	        loop_map.items(),
417	        start=1
418	    ):
419	        loop.loop_id = new_idx
420	        final_loops.append(loop)
421	
422	    return final_loops
423	
424	
425	# ============================================================
426	# 8. 解析整个日志
427	# ============================================================
428	
429	def simplify_log_text(text: str) -> list[SegmentRecord]:
430	
431	    segments = split_segments(text)
432	
433	    results: list[SegmentRecord] = []
434	
435	    for idx, seg in enumerate(segments, start=1):
436	
437	        status = extract_status(seg)
438	
439	        loops = parse_loops(seg)
440	
441	        results.append(
442	            SegmentRecord(
443	                serial_number=idx,
444	                status=status,
445	                loops=loops,
446	            )
447	        )
448	
449	    return results
450	
451	
452	# ============================================================
453	# 9. 输出
454	# ============================================================
455	
456	def write_simplified_log(
457	    records: list[SegmentRecord],
458	    output_path: Path,
459	):
460	
461	    lines: list[str] = []
462	
463	    for seg in records:
464	
465	        lines.append(
466	            f"{seg.serial_number} | {seg.status}"
467	        )
468	
469	        for loop in seg.loops:
470	
471	            if not loop.tool_calls:
472	
473	                lines.append(
474	                    f"loop {loop.loop_id} | 无 tool_calls"
475	                )
476	
477	                continue
478	
479	            tool_parts = []
480	
481	            for tc in loop.tool_calls:
482	
483	                tool_parts.append(
484	                    f"Tool={tc.tool_name}, Args={tc.tool_args}"
485	                )
486	
487	            merged = " ; ".join(tool_parts)
488	
489	            lines.append(
490	                f"loop {loop.loop_id} | {merged}"
491	            )
492	
