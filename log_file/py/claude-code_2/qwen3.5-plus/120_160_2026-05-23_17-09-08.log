226	async def resolve_device(
227	    adapter: MijiaAdapter,
228	    device_name: str = "",
229	    device_id: str = "",
230	    room: str = "",
231	    home: str = "",
232	    device_type: str = "",
233	    refresh: bool = False,
234	) -> Dict[str, Any]:
235	    if refresh:
