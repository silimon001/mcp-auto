13	def run_claude_stream(prompt_text: str, json_log_path: str):
14	    """
15	    流式运行 Claude，并实时写 JSONL
16	
17	    修复内容：
18	    1. 收到 result 后立即终止 Claude 进程
19	    2. 避免 readline 永久阻塞
20	    3. 后台线程持续消费 stderr，防止 pipe deadlock
21	    4. 增加超时保护
22	    5. 更稳健的异常处理
23	    """
24	
25	    import threading
26	    import queue
27	
28	    process = subprocess.Popen(
29	        [
30	            "claude",
31	            "--print",
32	            "--verbose",
33	            "--max-turns", "20",
34	            "--output-format", "stream-json",
35	            "--permission-mode", "bypassPermissions"
36	        ],
37	        stdin=subprocess.PIPE,
38	        stdout=subprocess.PIPE,
39	        stderr=subprocess.PIPE,
40	        text=True,
41	        encoding="utf-8",
42	        bufsize=1
43	    )
44	
45	    # =========================
46	    # 输入 prompt
47	    # =========================
48	    process.stdin.write(prompt_text)
49	    process.stdin.close()
50	
51	    events = []
52	    stderr_lines = []
53	
54	    # 用 queue 做线程安全通信
55	    stdout_queue = queue.Queue()
56	    stderr_queue = queue.Queue()
57	
58	    # =========================
59	    # 后台消费 stdout
60	    # =========================
61	    def read_stdout():
62	        try:
63	            for line in iter(process.stdout.readline, ''):
64	                stdout_queue.put(line)
65	        except Exception as e:
66	            stdout_queue.put(f"__ERROR__:{e}")
67	        finally:
68	            stdout_queue.put(None)
69	
70	    # =========================
71	    # 后台消费 stderr
72	    # =========================
73	    def read_stderr():
74	        try:
75	            for line in iter(process.stderr.readline, ''):
76	                stderr_queue.put(line)
77	                stderr_lines.append(line)
78	        except Exception as e:
79	            stderr_queue.put(f"__ERROR__:{e}")
80	        finally:
81	            stderr_queue.put(None)
82	
83	    stdout_thread = threading.Thread(target=read_stdout, daemon=True)
84	    stderr_thread = threading.Thread(target=read_stderr, daemon=True)
85	
86	    stdout_thread.start()
87	    stderr_thread.start()
88	
89	    got_result = False
90	
