635	@mcp.tool()
636	async def render_frame(
637	    output_path: Optional[str] = None,
638	    width: Optional[int] = None,
639	    height: Optional[int] = None,
640	    ctx: Context = None,
641	) -> str:
642	    """
643	    Render the current frame.
644	
645	    Args:
646	        output_path: Optional path to save the rendered image
647	        width: Optional render width in pixels
648	        height: Optional render height in pixels
649	    """
650	    async with c4d_connection_context() as connection:
651	        if not connection.connected:
652	            return "❌ Not connected to Cinema 4D"
