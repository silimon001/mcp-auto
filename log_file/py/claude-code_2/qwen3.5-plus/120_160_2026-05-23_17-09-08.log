161	    async def init(self, name: str, config: dict):
162	        type = config.get("type", "stdio")
163	        
164	        if type == "stdio":
165	            await self.init_stdio(config)
166	        elif type == "sse":
167	            await self.init_sse(config)
168	        elif type == "streamable_http":
169	            await self.init_streamable_http(config)
170	        else:
171	            raise Exception(f"[FAIL] server {name}: Unknown transport type '{type}'")       
172	
173	    async def init_stdio(self, config: dict):
174	        env = get_safe_value(config, "env")
175	        if env is None:
176	            env = {}
177	        # 强制添加清华源，解决连接超时问题
178	        env['UV_DEFAULT_INDEX'] = 'https://pypi.tuna.tsinghua.edu.cn/simple'
179	        env['UV_INDEX_URL'] = 'https://pypi.tuna.tsinghua.edu.cn/simple'
180	        
181	        server_params = StdioServerParameters(
182	            command=get_safe_value(config, "command"),
183	            args=get_safe_value(config, "args"),
184	            env=env,
185	            cwd=get_safe_value(config, "cwd"))
186	        stdio_transport = await self.exit_stack.enter_async_context(stdio_client(server_params))
187	        read_stream, write_stream = stdio_transport
188	        self.session = await self.exit_stack.enter_async_context(ClientSession(read_stream, write_stream))
189	        
190	        await self.session.initialize()
191	        response = await self.session.list_tools()
192	        self.tools = response.tools if hasattr(response, 'tools') else []
193	            
194	    async def init_sse(self, config: dict):
195	        url = get_safe_value(config, "url")
196	        headers = get_safe_value(config, "headers")
197	        if not url:
198	            raise ValueError("URL is required for SSE transport")
199	
200	        from urllib.parse import urlparse
201	        parsed = urlparse(url)
202	        if not parsed.path or parsed.path == "/":
203	            raise ValueError(
204	                "URL must include an endpoint path (e.g., /mcp, /sse). "
205	                "Got: {url}"
206	            )
207	
208	        if get_safe_value(config, 'command') is not None:
209	            command = get_safe_value(config, "command"),
210	            args = get_safe_value(config, "args")
211	            env = get_safe_value(config, "env")
212	            cwd = get_safe_value(config, "cwd")
213	            self.process = start_process(command,args,env,cwd,url)
214	            self._server_process_started = True
215	
216	        try:
217	            sse_transport = await self.exit_stack.enter_async_context(sse_client(url=url, headers=headers))
218	            read_stream, write_stream = sse_transport
219	            self.session = await self.exit_stack.enter_async_context(ClientSession(read_stream, write_stream))
220	        
221	            await self.session.initialize()
222	            response = await self.session.list_tools()
223	            self.tools = response.tools if hasattr(response, 'tools') else []
224	
225	        except Exception as e:
226	            print(f"[ERROR] Failed to connect the MCP server: {e}")
227	
228	            # ❗ 关键：失败时关闭 server
229	            await self._cleanup_server_process()
230	
231	            raise
