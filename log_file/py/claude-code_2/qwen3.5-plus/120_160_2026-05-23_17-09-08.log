420	@mcp.tool()
421	async def get_scene_info(ctx: Context) -> str:
422	    """Get information about the current Cinema 4D scene."""
423	    async with c4d_connection_context() as connection:
424	        if not connection.connected:
425	            return "❌ Not connected to Cinema 4D"
426	
427	        response = send_to_c4d(connection, {"command": "get_scene_info"})
428	
429	        if "error" in response:
430	            return f"❌ Error: {response['error']}"
431	
432	        # Format scene info nicely
433	        scene_info = response.get("scene_info", {})
434	        return f"""
435	# Cinema 4D Scene Information
436	- **Filename**: {scene_info.get('filename', 'Untitled')}
437	- **Objects**: {scene_info.get('object_count', 0)}
438	- **Polygons**: {scene_info.get('polygon_count', 0):,}
439	- **Materials**: {scene_info.get('material_count', 0)}
440	- **Current Frame**: {scene_info.get('current_frame', 0)}
441	- **FPS**: {scene_info.get('fps', 30)}
442	- **Frame Range**: {scene_info.get('frame_start', 0)} - {scene_info.get('frame_end', 90)}
443	"""
