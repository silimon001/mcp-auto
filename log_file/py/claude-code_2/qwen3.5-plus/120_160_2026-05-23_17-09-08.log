452	    ctx: Context = None,
453	) -> str:
454	    """
455	    Add a primitive object to the Cinema 4D scene.
456	
457	    Args:
458	        primitive_type: Type of primitive (cube, sphere, cone, cylinder, plane, etc.)
459	        name: Optional name for the new object
460	        position: Optional [x, y, z] position
461	        size: Optional [x, y, z] size or dimensions
462	    """
463	    async with c4d_connection_context() as connection:
