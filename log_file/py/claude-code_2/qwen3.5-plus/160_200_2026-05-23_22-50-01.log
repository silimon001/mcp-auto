342	                        f.write(f"    - {err}\n")
343	                f.write(f"{'=' * 60}\n")
344	                continue   # result 块输出完毕，跳过后续普通处理
345	
346	            # -------- system / user --------
347	            if isinstance(item, dict):
348	                role = item["type"].upper()
349	                ts = item.get("timestamp", "")
350	                f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
351	                f.write(f"[{role}]:\n{item['content']}\n")
352	                f.write("\n" + "-" * 60 + "\n")
353	                continue
354	
355	            # -------- assistant --------
356	            turn += 1
357	            msg = messages[item]
358	            ts = msg.get("timestamp", "")
359	            f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
360	
361	            text = "\n".join(msg["texts"]).strip()
362	            if text:
363	                f.write(f"[ASSISTANT]:\n{text}\n")
364	
365	            for tool in msg["tools"]:
