184	"tests/**/*" = ["D", "S"]
185	"setup.py" = ["D"]
186	
187	[tool.ruff.lint.pydocstyle]
188	convention = "google"
189	
190	[tool.mypy]
191	python_version = "3.8"
192	strict = true
193	warn_return_any = true
194	warn_unused_configs = true
195	disallow_untyped_defs = true
196	disallow_incomplete_defs = true
197	check_untyped_defs = true
198	disallow_untyped_decorators = true
199	no_implicit_optional = true
200	warn_redundant_casts = true
201	warn_unused_ignores = true
202	warn_no_return = true
203	warn_unreachable = true
204	implicit_reexport = false
205	strict_equality = true
206	show_error_codes = true
207	
208	[[tool.mypy.overrides]]
209	module = [
