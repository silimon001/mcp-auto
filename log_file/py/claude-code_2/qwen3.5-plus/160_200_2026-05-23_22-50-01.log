138	target-version = "py38"
139	line-length = 100
140	fix = true
141	show-fixes = true
142	
143	[tool.ruff.lint]
144	select = [
145	    # pycodestyle
146	    "E",
147	    # Pyflakes
148	    "F",
149	    # pyupgrade
150	    "UP",
151	    # flake8-bugbear
152	    "B",
153	    # flake8-simplify
