310	def write_log(messages, order, log_file):
311	    """按轮次和时间戳输出，末尾附加任务结果总结"""
312	    turn = 0
313	    with open(log_file, "a", encoding="utf-8") as f:
314	        for item in order:
315	            # -------- 结果总结（直接输出，不改变轮次）--------
316	            if isinstance(item, dict) and item.get("type") == "result":
317	                ts = item.get("timestamp", "")
318	                data = item["data"]
319	
320	                f.write(f"\n{'=' * 60}\n")
321	                f.write(f"[RESULT] [TIMESTAMP {ts}]\n")
322	                f.write(f"  状态: {'❌ 失败' if data['is_error'] else '✅ 成功'}\n")
323	                f.write(f"  子类型: {data['subtype']}\n")
324	                f.write(f"  实际轮次: {data['num_turns']}\n")
325	                f.write(f"  停止原因: {data['stop_reason']}\n")
326	                f.write(f"  终端原因: {data['terminal_reason']}\n")
327	                f.write(f"  耗时: {data['duration_ms']} ms (API: {data['duration_api_ms']} ms)\n")
328	                f.write(f"  成本: ${data['total_cost_usd']:.6f}\n")
329	
330	                usage = data.get("usage", {})
331	                if usage:
332	                    f.write(f"  Token 使用:\n")
333	                    f.write(f"    - 输入: {usage.get('input_tokens', '?')}\n")
334	                    f.write(f"    - 输出: {usage.get('output_tokens', '?')}\n")
335	                    f.write(f"    - 缓存创建: {usage.get('cache_creation_input_tokens', '?')}\n")
336	                    f.write(f"    - 缓存读取: {usage.get('cache_read_input_tokens', '?')}\n")
337	
338	                errors = data.get("errors", [])
339	                if errors:
