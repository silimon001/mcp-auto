164	    "S",
165	    # flake8-logging-format
166	    "G",
167	    # Perflint
168	    "PERF",
169	    # Refactor
170	    "RET",
171	]
172	ignore = [
173	    "D100",  # Missing docstring in public module
174	    "D104",  # Missing docstring in public package
175	    "D107",  # Missing docstring in __init__
176	    "D203",  # 1 blank line required before class docstring
177	    "D213",  # Multi-line docstring summary should start at the second line
178	    "S101",  # Use of assert detected
179	    "S603",  # subprocess call: check for execution of untrusted input
180	    "S607",  # Starting a process with a partial executable path
181	]
