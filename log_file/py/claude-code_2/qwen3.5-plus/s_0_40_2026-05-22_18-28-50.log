th open('claude_code/prompt_init.md', 'r', encoding='utf-8') as f: 427 task_prompt = f.read() 428 429 task_prompt = task_prompt.replace("{WORKSPACE}", os.getcwd()) 430 print(task_prompt) 431 432 from glob import glob 433 # 获取待处理的 README 文件列表 434 readme_dir = Path.cwd() / "data" / "dataset" / dataset_name / "sampled_validated_readme" 435 readme_files = sorted(glob(str(readme_dir / "*.md")), key=os.path.getsize) 436 437 pos = 0 438 count = 40 439 440 for readme_path in readme_files[pos:pos+count]: 441 442 mcp_file = Path("/home/silimon/MCP-Auto/.mcp.json") 443 if mcp_file.exists(): 444 mcp_file.unlink() 445 print("Deleted .mcp.json") 446 447 readme_path = Path(readme_path) 448 filename_parts = readme_path.stem.split('_') 449 repo_id = filename_parts[0] 450 repo_name = '_'.join(filename_parts[1:]).replace('_README', '') 451 452 with open(readme_path, 'r', encoding='utf-8') as f: 453 readme_content = f.read() 454 455 extra_info = add_extra_info(dataset_name, repo_id) 456 457 query = f'''\n=== README.md START ===\n{readme_content}\n=== README.md END ===\n{extra_info}''' 458 459 all_prompt = task_prompt + query 460 461 print(all_prompt) 462 463 run_task(all_prompt, "claude_code", pos, count)
