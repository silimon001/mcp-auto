310	def write_log(messages, order, log_file):
311	    """按轮次和时间戳输出，末尾附加任务结果总结"""
312	    turn = 0
313	    with open(log_file, "a", encoding="utf-8") as f:
314	        for item in order:
315	            # -------- 结果总结（直接输出，不改变轮次）--------
316	            if isinstance(item, dict) and item.get("type") == "result":
317	                ts = item.get("timestamp", "")
318	                data = item["data"]
319	
320	                f.write(f"\n{'=' * 60}\n")
321	                f.write(f"[RESULT] [TIMESTAMP {ts}]\n")
322	                f.write(f"  状态: {'❌ 失败' if data['is_error'] else '✅ 成功'}\n")
323	                f.write(f"  子类型: {data['subtype']}\n")
324	                f.write(f"  实际轮次: {data['num_turns']}\n")
325	                f.write(f"  停止原因: {data['stop_reason']}\n")
326	                f.write(f"  终端原因: {data['terminal_reason']}\n")
327	                f.write(f"  耗时: {data['duration_ms']} ms (API: {data['duration_api_ms']} ms)\n")
328	                f.write(f"  成本: ${data['total_cost_usd']:.6f}\n")
329	
330	                usage = data.get("usage", {})
331	                if usage:
332	                    f.write(f"  Token 使用:\n")
333	                    f.write(f"    - 输入: {usage.get('input_tokens', '?')}\n")
334	                    f.write(f"    - 输出: {usage.get('output_tokens', '?')}\n")
335	                    f.write(f"    - 缓存创建: {usage.get('cache_creation_input_tokens', '?')}\n")
336	                    f.write(f"    - 缓存读取: {usage.get('cache_read_input_tokens', '?')}\n")
337	
338	                errors = data.get("errors", [])
339	                if errors:
340	                    f.write(f"  错误信息:\n")
341	                    for err in errors:
342	                        f.write(f"    - {err}\n")
343	                f.write(f"{'=' * 60}\n")
344	                continue   # result 块输出完毕，跳过后续普通处理
345	
346	            # -------- system / user --------
347	            if isinstance(item, dict):
348	                role = item["type"].upper()
349	                ts = item.get("timestamp", "")
350	                f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
351	                f.write(f"[{role}]:\n{item['content']}\n")
352	                f.write("\n" + "-" * 60 + "\n")
353	                continue
354	
355	            # -------- assistant --------
356	            turn += 1
357	            msg = messages[item]
358	            ts = msg.get("timestamp", "")
359	            f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
360	
361	            text = "\n".join(msg["texts"]).strip()
362	            if text:
363	                f.write(f"[ASSISTANT]:\n{text}\n")
364	
365	            for tool in msg["tools"]:
366	                f.write(f"[ASSISTANT][TOOL]: {tool['name']}\n")
367	                f.write("[TOOL INPUT]:\n")
368	                f.write(json.dumps(tool["input"], indent=2, ensure_ascii=False))
369	                f.write("\n")
370	
371	            if msg["tokens"]:
372	                t = msg["tokens"]
373	                f.write(f"[TOKENS] input={t['input']} output={t['output']}\n")
374	
375	            f.write("\n" + "-" * 60 + "\n")
376	
377	def run_task(prompt_text: str, task_name, pos, count):
378	
379	    json_log_path = f"{LOG_DIR}/tmp_{task_name}.jsonl"
380	
381	    events, stderr = run_claude_stream(
382	        prompt_text,
383	        json_log_path
384	    )
385	
386	    messages, order = collect_messages(events)
387	    log_file = f"{LOG_DIR}/{pos}_{pos+count}_{timestamp}.log"
388	    write_log(messages, order, log_file)
389	
390	    if stderr:
391	        with open(log_file, "a") as f:
392	            f.write("\n[STDERR]\n")
393	            f.write(stderr)
394	
395	    print(f"✅ Done: {log_file}")
396	
