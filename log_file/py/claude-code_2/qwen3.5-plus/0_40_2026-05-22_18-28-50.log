19	def handle_shutdown(sig, frame):
20	    print("[*] Shutting down MCP server gracefully...")
21	    if hasattr(handle_shutdown, "_is_shutting_down") and handle_shutdown._is_shutting_down:
22	        return
23	    handle_shutdown._is_shutting_down = True
24	
25	    if hasattr(asyncio, "get_running_loop"):
26	        try:
27	            loop = asyncio.get_running_loop()
28	            for task in asyncio.all_tasks(loop):
29	                task.cancel()
30	            print("[*] All tasks cancelled, shutdown complete.")
31	        except RuntimeError:
32	            pass
33	    import os
34	    os._exit(0)
