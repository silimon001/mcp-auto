878	async def initialize_server() -> MCPConfig:
879	    """Initialize the Graphiti server with the specified LLM client."""
880	    global config
881	
882	    parser = argparse.ArgumentParser(
883	        description='Run the Graphiti MCP server with optional LLM client'
884	    )
885	    parser.add_argument(
886	        '--group-id',
887	        help='Namespace for the graph. This is an arbitrary string used to organize related data. '
888	        'If not provided, a random UUID will be generated.',
889	    )
890	    parser.add_argument(
891	        '--transport',
892	        choices=['sse', 'stdio'],
893	        default='sse',
894	        help='Transport to use for communication with the client. (default: sse)',
895	    )
896	    # OpenAI is the only supported LLM client
897	    parser.add_argument('--model', help='Model name to use with the LLM client')
898	    parser.add_argument('--destroy-graph', action='store_true', help='Destroy all Graphiti graphs')
899	    parser.add_argument(
900	        '--use-custom-entities',
901	        action='store_true',
902	        help='Enable entity extraction using the predefined ENTITIES',
903	    )
904	    # Add argument for specifying entities
905	    # --- MODIFIED: --entities now takes a comma-separated string for subdir selection ---
906	    parser.add_argument(
907	        '--entities',
908	        type=str,
909	        default="", # Default to empty string, meaning load all
910	        help='Comma-separated list of entity subdirectories (relative to --entities-dir) to load. '
911	             'If empty, all entities in --entities-dir are loaded.'
912	    )
913	    # --- End Modification ---
914	    # Add argument for custom entity directory
915	    parser.add_argument(
916	        '--entities-dir',
917	        help='Directory containing custom entity modules to load'
918	    )
919	    # Add argument for log level
920	    parser.add_argument(
921	        '--log-level',
922	        choices=['debug', 'info', 'warn', 'error', 'fatal'],
923	        default=os.environ.get('GRAPHITI_LOG_LEVEL', 'info').lower(),  # Default to ENV or 'info'
924	        help='Set the logging level.'
925	    )
926	    # --- NEW: Argument to control loading of root/base entities ---
927	    parser.add_argument(
