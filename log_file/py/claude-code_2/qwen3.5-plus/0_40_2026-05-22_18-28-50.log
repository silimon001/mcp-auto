13	def run_claude_stream(prompt_text: str, json_log_path: str):
14	    """
15	    流式运行 Claude，并实时写 JSONL
16	
17	    修复内容：
18	    1. 收到 result 后立即终止 Claude 进程
19	    2. 避免 readline 永久阻塞
20	    3. 后台线程持续消费 stderr，防止 pipe deadlock
21	    4. 增加超时保护
22	    5. 更稳健的异常处理
23	    """
24	
25	    import threading
26	    import queue
27	
28	    process = subprocess.Popen(
29	        [
30	            "claude-tap",
31	            "--",
32	            "--print",
33	            "--verbose",
34	            "--max-turns", "20",
35	            "--output-format", "stream-json",
36	            "--permission-mode", "bypassPermissions"
37	        ],
38	        stdin=subprocess.PIPE,
39	        stdout=subprocess.PIPE,
40	        stderr=subprocess.PIPE,
41	        text=True,
42	        encoding="utf-8",
43	        bufsize=1
44	    )
45	
46	    # =========================
47	    # 输入 prompt
48	    # =========================
49	    process.stdin.write(prompt_text)
50	    process.stdin.close()
51	
52	    events = []
53	    stderr_lines = []
54	
55	    # 用 queue 做线程安全通信
56	    stdout_queue = queue.Queue()
57	    stderr_queue = queue.Queue()
58	
59	    # =========================
60	    # 后台消费 stdout
61	    # =========================
62	    def read_stdout():
63	        try:
64	            for line in iter(process.stdout.readline, ''):
65	                stdout_queue.put(line)
66	        except Exception as e:
67	            stdout_queue.put(f"__ERROR__:{e}")
68	        finally:
69	            stdout_queue.put(None)
70	
71	    # =========================
72	    # 后台消费 stderr
73	    # =========================
74	    def read_stderr():
75	        try:
76	            for line in iter(process.stderr.readline, ''):
77	                stderr_queue.put(line)
78	                stderr_lines.append(line)
79	        except Exception as e:
80	            stderr_queue.put(f"__ERROR__:{e}")
81	        finally:
82	            stderr_queue.put(None)
83	
84	    stdout_thread = threading.Thread(target=read_stdout, daemon=True)
85	    stderr_thread = threading.Thread(target=read_stderr, daemon=True)
86	
87	    stdout_thread.start()
88	    stderr_thread.start()
89	
90	    got_result = False
91	
92	    # =========================
93	    # 主事件循环
94	    # =========================
95	    with open(json_log_path, "a", encoding="utf-8") as jf:
96	
97	        while True:
98	
99	            try:
100	                line = stdout_queue.get(timeout=1)
101	
102	            except queue.Empty:
103	
104	                # 已收到 result，则不再继续等待
105	                if got_result:
106	                    break
107	
108	                # 子进程退出
109	                if process.poll() is not None:
110	                    break
111	
112	                continue
113	
114	            # stdout EOF
115	            if line is None:
116	                break
117	
118	            line = line.strip()
119	
120	            if not line:
121	                continue
122	
123	            try:
124	                obj = json.loads(line)
125	
126	                obj["_received_at"] = datetime.now(
127	                    timezone.utc
128	                ).isoformat()
129	
130	                events.append(obj)
131	
132	                jf.write(
133	                    json.dumps(
134	                        obj,
135	                        ensure_ascii=False
136	                    ) + "\n"
137	                )
138	
139	                # 减少 flush 开销
140	                jf.flush()
141	
142	                # =========================
143	                # 收到最终 result
144	                # =========================
145	                if obj.get("type") == "result":
146	
147	                    got_result = True
148	
149	                    # 非常关键：
150	                    # 不再等待 Claude 主进程自然退出
151	                    try:
152	                        process.terminate()
153	                    except Exception:
154	                        pass
155	
156	                    break
157	
158	            except json.JSONDecodeError:
159	                continue
160	
161	            except Exception as e:
162	                print(f"⚠️ JSON parse error: {e}")
163	
164	    # =========================
165	    # 等待退出
166	    # =========================
167	    try:
168	        process.wait(timeout=5)
169	
170	    except subprocess.TimeoutExpired:
171	
172	        print("⚠️ Claude process timeout, killing...")
173	
174	        try:
175	            process.kill()
176	        except Exception:
177	            pass
178	
179	    # =========================
180	    # 确保线程结束
181	    # =========================
182	    stdout_thread.join(timeout=1)
183	    stderr_thread.join(timeout=1)
184	
185	    stderr = "".join(stderr_lines)
186	
187	    return events, stderr
188	
189	def render_content(obj):
190	    """
191	    把 Claude stream-json content 递归展开成纯 string
192	    """
193	    if obj is None:
194	        return ""
195	
196	    # str
197	    if isinstance(obj, str):
198	        return obj
199	
200	    # dict（核心：Claude node）
201	    if isinstance(obj, dict):
202	        t = obj.get("type")
203	
204	        # tool result wrapper
205	        if t == "text":
206	            return render_content(obj.get("text"))
207	
208	        if t == "tool_result":
209	            return render_content(obj.get("content"))
210	
211	        # fallback：尽量抽取 text
212	        if "text" in obj:
213	            return render_content(obj["text"])
214	
215	        return json.dumps(obj, ensure_ascii=False)
216	
217	    # list（递归 flatten）
218	    if isinstance(obj, list):
219	        return "\n".join(render_content(x) for x in obj)
220	
221	    # fallback
222	    return str(obj)
223	
224	
225	def collect_messages(events):
226	    """聚合事件，记录时间戳，并捕获 result 事件用于总结"""
227	    messages = {}
228	    order = []      # dict(system/user/result) 或 str(assistant msg_id)
229	
230	    for event in events:
231	        etype = event.get("type")
232	        ts = event.get("timestamp") or event.get("_received_at", datetime.now(timezone.utc).isoformat())
233	
234	        # -------- system --------
235	        if etype == "system":
236	            order.append({
237	                "type": "system",
238	                "content": f"[SYSTEM] {event.get('subtype', '')}",
239	                "timestamp": ts
240	            })
241	            continue
242	
243	        # -------- user --------
244	        if etype == "user":
245	            contents = event.get("message", {}).get("content", [])
246	            text = render_content(contents)
247	            order.append({
248	                "type": "user",
249	                "content": text,
250	                "timestamp": ts
251	            })
252	            continue
253	
254	        # -------- result (最终总结) --------
255	        if etype == "result":
256	            order.append({
257	                "type": "result",
258	                "timestamp": ts,
259	                "data": {
260	                    "subtype": event.get("subtype"),
261	                    "is_error": event.get("is_error"),
262	                    "num_turns": event.get("num_turns"),
263	                    "stop_reason": event.get("stop_reason"),
264	                    "total_cost_usd": event.get("total_cost_usd"),
265	                    "duration_ms": event.get("duration_ms"),
266	                    "duration_api_ms": event.get("duration_api_ms"),
267	                    "usage": event.get("usage", {}),
268	                    "errors": event.get("errors", []),
269	                    "terminal_reason": event.get("terminal_reason")
270	                }
271	            })
272	            continue
273	
274	        # -------- assistant --------
275	        if etype == "assistant":
276	            msg = event.get("message", {})
277	            msg_id = msg.get("id")
278	
279	            if msg_id not in messages:
280	                messages[msg_id] = {
281	                    "type": "assistant",
282	                    "texts": [],
283	                    "tools": [],
284	                    "tokens": None,
285	                    "timestamp": ts
286	                }
287	                order.append(msg_id)     # 保证顺序
288	
289	            entry = messages[msg_id]
290	
291	            for c in msg.get("content", []):
292	                ctype = c.get("type")
293	                if ctype == "text":
294	                    entry["texts"].append(c.get("text", ""))
295	                elif ctype == "tool_use":
296	                    entry["tools"].append({
297	                        "name": c.get("name"),
298	                        "input": c.get("input")
299	                    })
300	
301	            if msg.get("usage"):
302	                entry["tokens"] = {
303	                    "input": msg["usage"].get("input_tokens"),
304	                    "output": msg["usage"].get("output_tokens")
305	                }
306	
307	    return messages, order
308	
