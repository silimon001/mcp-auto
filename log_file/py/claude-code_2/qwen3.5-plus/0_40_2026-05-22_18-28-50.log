60	@server.read_resource()
61	async def handle_read_resource(uri: AnyUrl) -> str:
62	    """
63	    Read a specific scan result by its URI.
64	    The scan ID is extracted from the URI path component.
65	    """
66	    if uri.scheme != "nmap":
67	        raise ValueError(f"Unsupported URI scheme: {uri.scheme}")
68	
69	    scan_id = uri.path
70	    if scan_id is not None:
71	        scan_id = scan_id.lstrip("/")
72	        if scan_id in scan_results:
73	            return json.dumps(scan_results[scan_id], indent=2)
74	    raise ValueError(f"Scan result not found: {scan_id}")
