192	    def make_streamable_http_handler(active_app_key: str):
193	        """
194	        Returns a Route-compatible endpoint function + its StreamableHTTPSessionManager,
195	        both bound to a specific MCP app.
196	        """
197	        active_app = MCP_APPS[active_app_key]
198	
199	        session_manager = StreamableHTTPSessionManager(
200	            app=active_app,
201	            event_store=None,
202	            json_response=True,
203	            stateless=True,
204	        )
205	
206	        async def handle_streamable_http(request: Request):
207	            """Route-compatible endpoint for StreamableHTTP that handles credential injection."""
