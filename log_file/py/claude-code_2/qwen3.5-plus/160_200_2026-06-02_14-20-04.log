13	async def optimize_spark_code(spark_code: str, optimization_level: Optional[str] = "medium") -> Dict[str, Any]:
14	    """
15	    Optimizes Apache Spark code based on specified optimization level.
16	    
17	    Args:
18	        spark_code: The Spark code to optimize
