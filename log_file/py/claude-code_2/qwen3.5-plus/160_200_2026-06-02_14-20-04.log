42	        logger.info("Code optimization completed")
43	        
44	        # Return the optimized code
45	        return {
46	            "status": "success",
47	            "original_code": spark_code,
48	            "optimized_code": optimized_code,
49	            "optimization_level": optimization_level,
50	            "optimizations_applied": [
51	                "Used Claude AI for intelligent Spark code optimization",
52	                "Applied schema optimizations and type hints",
53	                "Added broadcast hints for small tables",
54	                "Optimized partitioning and storage levels"
55	            ]
56	        }
57	    except anthropic.APIError as e:
