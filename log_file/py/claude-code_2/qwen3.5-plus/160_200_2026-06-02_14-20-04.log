18	const path = require('path');
19	const fs = require('fs');
20	
21	// Auto-install dependencies if needed
22	function ensureDependencies() {
23	  try {
24	    require.resolve('commander');
25	    return true;
26	  } catch (e) {
27	    console.error('Missing dependencies. Running npm install...');
28	    const { execSync } = require('child_process');
29	    try {
30	      execSync('npm install', { cwd: __dirname, stdio: ['ignore', 'pipe', 'pipe'] });
31	      console.error('Dependencies installed. Please restart.');
32	      process.exit(0);
33	    } catch (err) {
34	      console.error('Failed to install dependencies:', err.message);
35	      console.error('Please run: cd ' + __dirname + ' && npm install');
36	      process.exit(1);
37	    }
38	  }
39	}
40	
41	ensureDependencies();
42	
43	const { program } = require('commander');
44	const { createLogger } = require('./lib/logger');
45	const { loadConfig } = require('./lib/config');
46	const { checkBackendAvailability, startMcpWrapper } = require('./lib/server');
47	const handlers = require('./handlers');
48	
49	// Parse command line arguments
50	program
51	    .option('-H, --backend-host <host>', 'Backend server host (default: 127.0.0.1)')
52	    .option('--http-host-port <port>', 'HTTP port on host system (default: 9081)')
53	    .option('--http-port <port>', 'HTTP port inside container (default: 9080)')
54	    .option('--swank-host-port <port>', 'SWANK port on host system (for documentation)')
55	    .option('--swank-port <port>', 'SWANK port inside container (for documentation)')
56	    .option('--log-file <path>', 'Path to log file (default: /tmp/lisply-mcp-wrapper.log)')
57	    .option('--debug', 'Enable debug logging')
58	    .option('--endpoint-prefix <prefix>', 'Prefix for all endpoints (default: lisply)')
59	    .option('--lisp-eval-endpoint <n>', 'Endpoint name for Lisp evaluation (default: lisp-eval)')
60	    .option('--http-request-endpoint <n>', 'Endpoint name for HTTP requests (default: http-request)')
61	    .option('--ping-endpoint <n>', 'Endpoint name for ping (default: ping-lisp)')
62	    .option('--server-name <n>', 'MCP server name for tool prefixing (default: lisply-mcp)')
63	    .option('--eval-timeout <ms>', 'Timeout for Lisp evaluation in milliseconds (default: 30000)')
64	    .option('--request-timeout-ms <ms>', 'Timeout for backend HTTP requests in milliseconds (default: 10000)')
65	    .parse(process.argv);
66	
67	// Load configuration
68	const config = loadConfig(program);
69	
70	// Create logger
71	const logger = createLogger(config);
72	
73	// Log startup info
74	logger.info('='.repeat(60));
75	logger.info('Lisply MCP Wrapper starting');
76	logger.info('='.repeat(60));
77	logger.info(`Server name: ${config.SERVER_NAME}`);
78	logger.info(`Backend: ${config.BACKEND_HOST}:${config.HTTP_HOST_PORT} (host) / :${config.HTTP_PORT} (container)`);
79	logger.info(`Endpoints: ${config.EVAL_ENDPOINT}, ${config.HTTP_REQUEST_ENDPOINT}, ${config.PING_ENDPOINT}`);
80	
81	// Main: check backend availability and start MCP server
82	checkBackendAvailability(config, logger)
83	  .then(available => {
84	    if (available) {
85	      logger.info('Backend service is available - starting MCP server');
86	      startMcpWrapper(config, logger, handlers);
87	    } else {
88	      logger.error('Backend service is NOT available');
89	      logger.error(`Expected backend at: ${config.BACKEND_HOST}:${config.HTTP_HOST_PORT}`);
90	      logger.error('');
91	      logger.error('Please ensure the docker-compose services are running:');
