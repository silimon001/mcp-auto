130	        oauth_routes_list = build_oauth_routes(
131	            oauth_cfg, portal_client, oauth_state_store, validation_cache=oauth_validation_cache
132	        )
133	        logger.info("Running with OAuth bearer authentication")
134	    else:
135	        logger.info("Running with header-based authentication")
136	        logger.info("Expected headers: JUSPAY_API_KEY, JUSPAY_MERCHANT_ID, JUSPAY_WEB_LOGIN_TOKEN")
