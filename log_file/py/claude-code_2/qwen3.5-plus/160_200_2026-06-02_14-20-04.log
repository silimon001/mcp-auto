93	      logger.error('');
94	      process.exit(1);
95	    }
96	  })
97	  .catch(error => {
98	    logger.error(`Fatal error: ${error.message}`);
99	    if (error.stack) {
100	      logger.error(error.stack);
101	    }
102	    process.exit(1);
103	  });
104	
105	// Handle signals gracefully
106	process.on('SIGINT', () => {
107	  logger.info('Received SIGINT - exiting');
108	  process.exit(0);
109	});
110	
111	process.on('SIGTERM', () => {
112	  logger.info('Received SIGTERM - exiting');
113	  process.exit(0);
114	});
115	
