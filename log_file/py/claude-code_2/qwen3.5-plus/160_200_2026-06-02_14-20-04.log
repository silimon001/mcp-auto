"' + (code.match(/\"([^\"]+)\"/) || ['', 'COMMON-LISP'])[1] + '\">';\n          } else if (code.includes('(defparameter') || code.includes('(setq')) {\n            result = code.match(/\\*\\w+\\*/)?.[0] || 'NIL';\n          } else {\n            result = code.trim();\n          }\n        }\n        res.writeHead(200, {'Content-Type': 'application/json'});\n        res.end(JSON.stringify({Result: result, Stdout: '', Error: ''}));\n      } catch(e) {\n        res.writeHead(400, {'Content-Type': 'application/json'});\n        res.end(JSON.stringify({Result: '', Stdout: '', Error: e.message}));\n      }\n    } else if (url === '/lisply/http-request') {\n      res.writeHead(200, {'Content-Type': 'application/json'});\n      res.end(JSON.stringify({status: 200, body: '{}'}));\n    } else {\n      res.writeHead(200, {'Content-Type': 'application/json'});\n      res.end(JSON.stringify({status: 'ok'}));\n    }\n  });\n});\n\nserver.listen(9081, '127.0.0.1', () => {\n  console.error('Mock Lisply backend running on http://127.0.0.1:9081');\n});\nEOF\necho \"Mock backend created\"",
