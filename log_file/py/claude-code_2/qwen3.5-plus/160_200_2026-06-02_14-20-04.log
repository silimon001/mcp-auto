7	
8	const fs = require('fs');
9	const path = require('path');
10	const { execSync } = require('child_process');
11	
12	/**
13	 * Get environment variable with fallback
14	 */
15	function getEnvVar(name, defaultValue, prefixes = ['', 'LISPLY_']) {
16	  for (const prefix of prefixes) {
17	    const fullName = `${prefix}${name}`;
18	    if (process.env[fullName] !== undefined) {
19	      return process.env[fullName];
20	    }
21	  }
22	  return defaultValue;
23	}
24	
25	/**
26	 * Parse boolean from string
27	 */
28	function parseBool(value, defaultValue = false) {
29	  if (value === undefined || value === null) return defaultValue;
30	  if (typeof value === 'boolean') return value;
31	  if (typeof value === 'string') {
32	    const lowered = value.toLowerCase().trim();
33	    if (lowered === 'true' || lowered === 'yes' || lowered === '1') return true;
34	    if (lowered === 'false' || lowered === 'no' || lowered === '0') return false;
35	  }
36	  return defaultValue;
37	}
38	
39	/**
40	 * Parse integer with bounds
41	 */
42	function parseInt10(value, defaultValue, min = null, max = null) {
43	  if (value === undefined || value === null) return defaultValue;
44	  const intValue = parseInt(value, 10);
45	  if (isNaN(intValue)) return defaultValue;
46	  if (min !== null && intValue < min) return min;
47	  if (max !== null && intValue > max) return max;
48	  return intValue;
49	}
50	
51	/**
52	 * Get git branch (for version info)
53	 */
54	function getGitBranch() {
55	  try {
56	    const projectRoot = path.join(__dirname, '..', '..');
57	    return execSync(`cd "${projectRoot}" && git rev-parse --abbrev-ref HEAD`, 
58	                    { encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }).trim();
59	  } catch (e) {
60	    return 'unknown';
61	  }
62	}
63	
64	/**
65	 * Create prefixed tool name
66	 */
67	function createPrefixedToolName(serverName, toolName) {
68	  if (!serverName || !toolName) return toolName;
69	  const coreServerName = serverName
70	    .replace(/^lisply-mcp-?/, '')
71	    .replace(/^mcp-?/, '')
72	    .replace(/-+$/, '');
73	  const prefix = coreServerName || serverName;
74	  return `${prefix}__${toolName}`;
75	}
76	
77	/**
78	 * Extract original tool name from prefixed name
79	 */
80	function extractOriginalToolName(prefixedToolName) {
81	  if (!prefixedToolName) return prefixedToolName;
82	  const parts = prefixedToolName.split('__');
83	  if (parts.length >= 2) {
84	    return parts.slice(1).join('__');
85	  }
86	  return prefixedToolName;
87	}
88	
89	/**
90	 * Load configuration from CLI args and environment
91	 */
92	function loadConfig(program) {
93	    const options = program.opts();
94	    
95	    const MIN_PORT = 1;
96	    const MAX_PORT = 65535;
97	  
98	  // Backend connection
99	  const BACKEND_HOST = options.backendHost || getEnvVar('BACKEND_HOST', '127.0.0.1');
100	  const HTTP_PORT = parseInt10(options.httpPort || getEnvVar('HTTP_PORT', '9080'), 9080, MIN_PORT, MAX_PORT);
101	  const HTTP_HOST_PORT = parseInt10(options.httpHostPort || getEnvVar('HTTP_HOST_PORT', '9081'), 9081, MIN_PORT, MAX_PORT);
102	  
103	  // SWANK ports (informational, for docs/diagnostics)
104	  const SWANK_PORT = parseInt10(options.swankPort || getEnvVar('SWANK_PORT', '4200'), 4200, MIN_PORT, MAX_PORT);
105	  const SWANK_HOST_PORT = parseInt10(options.swankHostPort || getEnvVar('SWANK_HOST_PORT', '4201'), 4201, MIN_PORT, MAX_PORT);
106	  
107	  // Endpoints
108	  const ENDPOINT_PREFIX = options.endpointPrefix || getEnvVar('ENDPOINT_PREFIX', 'lisply');
109	  const LISP_EVAL_ENDPOINT_NAME = options.lispEvalEndpoint || getEnvVar('LISP_EVAL_ENDPOINT', 'lisp-eval');
110	  const HTTP_REQUEST_ENDPOINT_NAME = options.httpRequestEndpoint || getEnvVar('HTTP_REQUEST_ENDPOINT', 'http-request');
111	  const PING_ENDPOINT_NAME = options.pingEndpoint || getEnvVar('PING_ENDPOINT', 'ping-lisp');
112	  
113	  const BASE_PATH = `/${ENDPOINT_PREFIX}`;
114	  const EVAL_ENDPOINT = `${BASE_PATH}/${LISP_EVAL_ENDPOINT_NAME}`;
115	  const HTTP_REQUEST_ENDPOINT = `${BASE_PATH}/${HTTP_REQUEST_ENDPOINT_NAME}`;
116	  const PING_ENDPOINT = `${BASE_PATH}/${PING_ENDPOINT_NAME}`;
117	  
118	  // Server identification
119	  const SERVER_NAME = options.serverName || getEnvVar('SERVER_NAME', 'lisply-mcp');
120	  
121	  // Timeouts
122	  const EVAL_TIMEOUT = parseInt10(options.evalTimeout || getEnvVar('EVAL_TIMEOUT', '30000'), 30000);
123	  const REQUEST_TIMEOUT_MS = parseInt10(
124	    options.requestTimeoutMs || getEnvVar('REQUEST_TIMEOUT_MS', '10000'),
125	    10000
126	  );
127	  
128	  // Logging
129	  const LOG_FILE = options.logFile || getEnvVar('LOG_FILE', '/tmp/lisply-mcp-wrapper.log');
130	  const DEBUG_MODE = parseBool(options.debug, false) || parseBool(getEnvVar('DEBUG_MODE', 'false'), false);
131	  
132	  // Version
133	  const VERSION = `2.0.0-${getGitBranch()}`;
134	  
135	  return {
136	    BACKEND_HOST,
137	    HTTP_PORT,
138	    HTTP_HOST_PORT,
139	    SWANK_PORT,
140	    SWANK_HOST_PORT,
141	    ENDPOINT_PREFIX,
142	    BASE_PATH,
143	    EVAL_ENDPOINT,
144	    HTTP_REQUEST_ENDPOINT,
145	    PING_ENDPOINT,
146	    SERVER_NAME,
147	    EVAL_TIMEOUT,
148	    REQUEST_TIMEOUT_MS,
149	    LOG_FILE,
150	    DEBUG_MODE,
151	    VERSION,
152	    options
153	  };
154	}
155	
156	module.exports = {
157	  getEnvVar,
158	  parseBool,
159	  parseInt10,
160	  getGitBranch,
161	  createPrefixedToolName,
162	  extractOriginalToolName,
163	  loadConfig
164	};
