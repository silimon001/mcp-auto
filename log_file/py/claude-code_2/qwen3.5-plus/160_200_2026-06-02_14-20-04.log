152	    def make_sse_handler(active_app_key: str, transport: SseServerTransport):
153	        """Returns an async SSE endpoint bound to a specific MCP app and transport."""
154	        active_app = MCP_APPS[active_app_key]
155	
156	        async def handler(request: Request):
157	            logging.info(
158	                f"New SSE connection from: {request.client} - {request.method} {request.url.path}"
159	            )
160	
161	            if active_app_key == "dashboard":
162	                from juspay_dashboard_mcp.tools import set_juspay_request_credentials
163	                juspay_creds = getattr(request.state, "juspay_credentials", None)
164	                set_juspay_request_credentials(juspay_creds)
165	            elif active_app_key == "default":
166	                from juspay_mcp.tools import set_juspay_request_credentials
167	                juspay_creds = getattr(request.state, "juspay_credentials", None)
168	                set_juspay_request_credentials(juspay_creds)
169	            # docs: no credentials needed
170	
171	            async with transport.connect_sse(
172	                request.scope, request.receive, request._send
173	            ) as streams:
174	                logging.info(f"MCP Session starting for {request.client}")
175	                try:
176	                    await active_app.run(
177	                        streams[0],
178	                        streams[1],
179	                        active_app.create_initialization_options(),
180	                    )
181	                except Exception as e:
182	                    logging.error(
183	                        f"Error during MCP session for {request.client}: {e}"
184	                    )
185	                finally:
186	                    logging.info(f"MCP Session ended for {request.client}")
187	
188	            return _AlreadySentResponse()
189	
190	        return handler
