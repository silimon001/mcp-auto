202	        reminders: List of reminders.
203	        repeatFlag: Recurrence rules.
204	        priority: Task priority (0=Normal, higher=higher priority).
205	        sortOrder: Sort order.
206	        items: List of subtasks (dicts with keys like 'title', 'startDate', etc.).
207	    """
208	    url = f"{TICKTICK_API_BASE}/task/{task_id}"
209	    payload = {
210	        "id": task_id,
211	        "projectId": project_id,
212	    }
213	    if title is not None:
214	        payload["title"] = title
215	    if content is not None:
216	        payload["content"] = content
217	    if desc is not None:
218	        payload["desc"] = desc
219	    if isAllDay is not None:
220	        payload["isAllDay"] = isAllDay
221	    if startDate is not None:
222	        payload["startDate"] = startDate
223	    if dueDate is not None:
224	        payload["dueDate"] = dueDate
225	    if timeZone is not None:
226	        payload["timeZone"] = timeZone
227	    if reminders is not None:
228	        payload["reminders"] = reminders
229	    if repeatFlag is not None:
230	        payload["repeatFlag"] = repeatFlag
231	    if priority is not None:
232	        payload["priority"] = priority
233	    if sortOrder is not None:
234	        payload["sortOrder"] = sortOrder
235	    if items is not None:
236	        payload["items"] = items
237	
238	    if isAllDay is False and startDate is None:
239	        pass
240	
241	    async with httpx.AsyncClient() as client:
242	        response = await client.post(url, headers=HEADERS, json=payload)
243	        return response.json()
244	
245	
246	@mcp.tool()
247	async def complete_task(project_id: str, task_id: str):
248	    """
249	    Completes a task in TickTick.
250	    """
251	    url = f"{TICKTICK_API_BASE}/project/{project_id}/task/{task_id}/complete"
252	    async with httpx.AsyncClient() as client:
253	        await client.post(url, headers=HEADERS)
254	        return {"message": "Task completed"}
255	
256	
257	@mcp.tool()
258	async def delete_task(project_id: str, task_id: str):
259	    """
260	    Deletes a task in TickTick.
261	    """
262	    url = f"{TICKTICK_API_BASE}/project/{project_id}/task/{task_id}"
263	    async with httpx.AsyncClient() as client:
264	        await client.delete(url, headers=HEADERS)
265	        return {"message": "Task deleted"}
