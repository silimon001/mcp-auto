39	class EmailMessage(BaseModel):
40	    receiver: list[str] = Field(description="The list of recipient email addresses, supports multiple recipients")
41	    body: str = Field(description="The main content of the email")
42	    subject: str = Field(description="The subject line of the email")
43	    attachments: Union[list[str], str] = Field(default=[], description="Email attachments, just need to get the file name of the attachment")
44	
45	class EmailTools(str, Enum):
46	    SEND_EMAIL = "send_email"
47	    SEARCH_ATTACHMENTS = "search_attachments"
48	
49	
50	async def send_email(attachment_folder, email_message: EmailMessage):
51	    """Send email asynchronously.
52	
53	    Args:
54	        attachment_folder (str): Attachment folder path, used to store or read attachment files.
55	        email_message (EmailMessage): Email message object, including email content, recipients, etc.
56	
57	    Returns:
58	        str: Returns the message sent by email
59	    """
60	    smtp_server, smtp_port = get_smtp_info()
61	    if not (smtp_server and smtp_port):
62	        raise ValueError("Please check that your email address is entered correctly, or it is not a supported email service")
63	    logger.info(f"send email message: {email_message.model_json_schema()}")
64	    # Build email content
65	    message = MIMEMultipart()
66	    message["From"] = sender
67	    message["To"] = ", ".join(email_message.receiver)  # Convert the recipient list to a comma-delimited string
68	    message["Subject"] = email_message.subject
69	
70	    message.attach(MIMEText(email_message.body, "plain"))
71	
72	    if isinstance(email_message.attachments, str):
73	        try:
74	            email_message.attachments = email_message.attachments.replace("\\", "\\\\")
75	            attachments = json.loads(email_message.attachments)
76	        except Exception as e:
77	            raise ValueError(f"email message attachments error: {e}")
78	        else:
79	            email_message.attachments = attachments
80	
81	    # Attach attachments to email messages
82	    if email_message.attachments:
83	        for file in email_message.attachments:
84	            absolute_path = os.path.join(attachment_folder, file)
85	            if os.path.isfile(absolute_path):
86	                message.attach(attach_file(absolute_path))
87	            else:
88	                raise ValueError(f"{absolute_path} not exists")
89	
90	    try:
91	        # Choose correct SMTP class based on port
92	        smtp_class = smtplib.SMTP_SSL if smtp_port == 465 else smtplib.SMTP
93	        
94	        # Create SMTP connection with timeout
95	        with smtp_class(smtp_server, smtp_port, timeout=10) as server:
96	            if smtp_port != 465:
97	                server.starttls()  # Enable TLS for non-SSL connections
98	            
99	            # Login and send
100	            server.login(sender, password)
101	            server.send_message(email_message)
102	            
103	        return f"Email sent successfully from {sender}"
104	
105	    except smtplib.SMTPAuthenticationError:
106	        raise ValueError("Authentication failed - check username and password")
107	    
108	    except smtplib.SMTPServerDisconnected:
109	        raise ConnectionError("Server disconnected unexpectedly")
110	    
111	    except smtplib.SMTPException as e:
112	        raise smtplib.SMTPException(f"SMTP error occurred: {str(e)}")
113	    
114	    except TimeoutError:
115	        raise ConnectionError("Connection timed out")
116	    
117	    except Exception as e:
118	        raise Exception(f"Unexpected error: {str(e)}")
119	
120	
121	
122	def get_smtp_info() -> tuple[str, int] | tuple[None, None]:
123	    """Get the SMTP server address and port from the configuration based on the sender's email domain name.
124	
125	    Returns:
126	        tuple[str, int] | tuple[None, None]: Returns the matching SMTP server address and port; if not found, returns (None, None).
127	    """
128	    # Extract the domain name part of the sender's email
129	    domain = f"@{sender.split('@')[1]}"
130	
131	    # Traverse the configuration and find the matching domain name
132	    for config in email_config:
133	        if config.get("domain") == domain:
134	            return config.get("server"), config.get("port")
135	
136	    # No matching configuration found
137	    return None, None
138	
139	
140	def get_lack_params(arguments: dict) -> str | None:
141	    """Check if the parameters dictionary is missing a required field for the EmailMessage model.
142	
143	    Args:
144	        arguments (dict): The supplied parameter dictionary.
145	
146	    Returns:
147	        str | None: If a field is missing, returns an error message for the missing field; otherwise returns None.
148	    """
149	    # Get the field names of the EmailMessage model
150	    required_fields = EmailMessage.model_fields.keys()
151	
152	    # Find the missing fields
153	    missing_fields = [field for field in required_fields if field not in arguments]
154	
155	    # Logging
156	    logger.info(f"Missing params: {missing_fields}")
157	
158	    # If there is a missing field, returns an error message; otherwise returns None
159	    if missing_fields:
160	        return "\n".join(f"{field} is required" for field in missing_fields)
161	    return None
