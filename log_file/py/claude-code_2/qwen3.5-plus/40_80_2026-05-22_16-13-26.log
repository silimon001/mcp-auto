183	@mcp.tool()
184	async def create_interactive_session(
185	    process_id: int = Field(description="The ID of the process to attach to.")
186	) -> Dict[str, Any]:
187	    """Create an interactive session."""
188	    try:
189	        device = await _get_remote_device()
190	        
191	        session = await asyncio.to_thread(device.attach, process_id)
192	        
