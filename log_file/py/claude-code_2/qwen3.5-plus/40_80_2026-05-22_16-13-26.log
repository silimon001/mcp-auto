644	def search_exploits_database(
645	    platform: Optional[str] = None,
646	    search_term: Optional[str] = None,
647	    cve: Optional[str] = None,
648	    rank: Optional[str] = None,
649	    author: Optional[str] = None,
650	    limit: int = 50
651	) -> dict:
652	    """
653	    Search the cached exploits database for fast results.
654	
655	    Args:
656	        platform: Filter by platform (e.g., 'windows', 'linux', 'unix')
657	        search_term: Search in name and description
658	        cve: Search for specific CVE reference
659	        rank: Filter by exploit rank (e.g., 'excellent', 'great', 'good')
660	        author: Filter by author name
661	        limit: Maximum number of results to return
662	
663	    Returns:
664	        Dictionary with search results
665	    """
666	    try:
667	        db = get_database()
668	
669	        # Build query filter
670	        query_filter = {}
671	
672	        if platform:
673	            query_filter["platform"] = {"$regex": platform, "$options": "i"}
674	
675	        if search_term:
676	            query_filter["$or"] = [
677	                {"name": {"$regex": search_term, "$options": "i"}},
678	                {"description": {"$regex": search_term, "$options": "i"}}
679	            ]
680	
681	        if cve:
682	            query_filter["cve_references"] = {"$regex": cve.upper(), "$options": "i"}
683	
684	        if rank:
685	            query_filter["rank"] = {"$regex": rank, "$options": "i"}
686	
687	        if author:
688	            query_filter["author"] = {"$regex": author, "$options": "i"}
689	
690	        # Execute query with sorting by rank and disclosure date
691	        rank_order = {
692	            "excellent": 1,
693	            "great": 2,
694	            "good": 3,
695	            "normal": 4,
696	            "average": 5,
697	            "low": 6,
698	            "manual": 7
699	        }
700	
701	        pipeline = [
702	            {"$match": query_filter},
703	            {"$addFields": {
704	                "rank_order": {
705	                    "$switch": {
706	                        "branches": [
707	                            {"case": {"$eq": ["$rank", "excellent"]}, "then": 1},
708	                            {"case": {"$eq": ["$rank", "great"]}, "then": 2},
709	                            {"case": {"$eq": ["$rank", "good"]}, "then": 3},
710	                            {"case": {"$eq": ["$rank", "normal"]}, "then": 4},
711	                            {"case": {"$eq": ["$rank", "average"]}, "then": 5},
712	                            {"case": {"$eq": ["$rank", "low"]}, "then": 6},
713	                            {"case": {"$eq": ["$rank", "manual"]}, "then": 7}
714	                        ],
715	                        "default": 8
716	                    }
717	                }
718	            }},
719	            {"$sort": {"rank_order": 1, "disclosure_date": -1}},
720	            {"$limit": limit},
721	            {"$project": {"rank_order": 0}}  # Remove the temporary field
722	        ]
723	
724	        results_cursor = db.exploits.aggregate(pipeline)
725	        exploits_raw = list(results_cursor)
726	
727	        # Convert ObjectIds and datetime objects to strings to avoid JSON serialization errors
728	        exploits = []
729	        for exploit in exploits_raw:
730	            # Convert ObjectId to string
731	            if '_id' in exploit:
732	                exploit['_id'] = str(exploit['_id'])
733	            # Convert datetime objects to ISO strings
734	            if 'disclosure_date' in exploit and exploit['disclosure_date']:
735	                if hasattr(exploit['disclosure_date'], 'isoformat'):
736	                    exploit['disclosure_date'] = exploit['disclosure_date'].isoformat()
737	            if 'created_at' in exploit and exploit['created_at']:
738	                if hasattr(exploit['created_at'], 'isoformat'):
739	                    exploit['created_at'] = exploit['created_at'].isoformat()
740	            if 'updated_at' in exploit and exploit['updated_at']:
741	                if hasattr(exploit['updated_at'], 'isoformat'):
742	                    exploit['updated_at'] = exploit['updated_at'].isoformat()
743	            exploits.append(exploit)
744	
745	        return {
746	            "success": True,
747	            "total_found": len(exploits),
748	            "exploits": exploits,
749	            "filters_applied": {
750	                "platform": platform or "none",
751	                "search_term": search_term or "none",
752	                "cve": cve or "none",
753	                "rank": rank or "none",
754	                "author": author or "none",
755	                "limit": limit
756	            },
757	            "message": f"Found {len(exploits)} exploits matching criteria"
758	        }
759	
760	    except Exception as e:
761	        return {
762	            "success": False,
763	            "error": str(e),
764	            "message": "Failed to search exploits database"
765	        }

