139	def list_exploits_internal(
140	    platform: str = "",
141	    search_term: str = "",
142	    cve: str = "",
143	    limit: int = 50
144	) -> Dict[str, Any]:
145	    """
146	    List available Metasploit exploits with optional filtering.
147	
148	    Args:
149	        platform: Filter by platform (e.g., 'windows', 'linux', 'unix') leave blank for all platforms
150	        search_term: Search term to filter exploits
151	        cve: CVE to filter exploits
152	        limit: Maximum number of exploits to return
153	
154	    Returns:
155	        Dictionary with exploit list and metadata
156	    """
157	    try:
158	        scan_id = str(uuid.uuid4())
159	        start_time = datetime.now()
160	
161	        # Create initial scan record
162	
163	        print(f"🚀 DEBUG: Listing exploits using fast database search - platform='{platform}', search='{search_term}', limit={limit}, cve={cve}")
164	
165	        db_result = database.search_exploits_database(
166	            platform=platform or None,
167	            search_term=search_term or None,
168	            cve=cve or None,  # CVE search is handled in search_term
169	            limit=limit
170	        )
171	
172	        if not len(db_result['exploits']):
173	            db_result = database.search_exploits_database(
174	                platform=None,
175	                search_term=search_term or None,
176	                cve=cve or None,  # CVE search is handled in search_term
177	                limit=limit
178	            )
179	
180	
181	        if not db_result["success"]:
182	            raise Exception(f"Database search failed: {db_result.get('error', 'Unknown error')}")
183	
184	        # Convert database results to the expected format
185	        filtered_exploits = []
186	        for exploit in db_result["exploits"]:
187	            exploit_info = {
188	                "name": exploit.get("name", ""),
189	                "description": exploit.get("description", ""),
190	                "rank": exploit.get("rank", "Unknown"),
191	                "author": exploit.get("author", "Unknown"),
192	                "disclosure_date": exploit.get("disclosure_date"),
193	                "platform": exploit.get("platform", ""),
194	                "targets": exploit.get("targets", []),
195	                "required_options": exploit.get("required_options", []),
196	                "all_options": exploit.get("all_options", []),
197	                "references": exploit.get("references", []),
198	                "cves": exploit.get("cve_references", []),
199	                "compatible_payloads": exploit.get("compatible_payloads", []),
200	                "payload_constraints": exploit.get("payload_constraints", []),
201	                "data_source": exploit.get("data_source", "database")
202	            }
203	            filtered_exploits.append(exploit_info)
204	
205	        end_time = datetime.now()
206	        duration = (end_time - start_time).total_seconds()
207	
208	        # Store results in database
209	        results_json = json.dumps({
