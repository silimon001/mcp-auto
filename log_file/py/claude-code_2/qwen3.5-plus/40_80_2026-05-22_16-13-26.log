1	import asyncio
2	from typing import Dict, Any, Optional, List
3	from pydantic import Field
4	import frida
5	from fastmcp import FastMCP
6	from threading import Lock
7	import tempfile
8	import os
9	
10	mcp = FastMCP("FridaC2MCP", json_response=True, stateless_http=False)
11	
12	# Globals for managing interactive sessions
13	_scripts = {}
14	_script_messages = {}
15	_message_queues = {}
16	global_persistent_scripts = {}
17	
18	# --- Helper Functions ---
19	
20	def _get_device_sync() -> frida.core.Device:
21	    """Blocking helper to get the device (run in thread)."""
22	    try:
23	        return frida.get_remote_device()
24	    except Exception as e:
25	        raise RuntimeError(f"Could not connect to remote Frida server: {e}")
26	
27	async def _get_remote_device() -> frida.core.Device:
28	    """Async wrapper to get device without blocking the event loop."""
29	    return await asyncio.to_thread(_get_device_sync)
30	
31	# --- Tools ---
32	
33	@mcp.tool()
34	async def get_device_information() -> Dict[str, Any]:
35	    """Retrieves detailed system information for the remote device."""
36	    device = await _get_remote_device()
37	
38	    try:
39	        params = await asyncio.to_thread(device.query_system_parameters)
40	        return params
41	    except Exception as e:
42	        raise RuntimeError(f"Failed to query system parameters: {e}")
43	
44	@mcp.tool()
45	async def list_installed_applications() -> List[Dict[str, Any]]:
46	    """
47	    Lists all installed applications on the remote device.
48	    Returns a list of applications including their name, identifier, and PID if running.
49	    """
50	    device = await _get_remote_device()
51	    
52	    try:
53	        applications = await asyncio.to_thread(device.enumerate_applications)
54	
55	        if not applications:
56	            return []
57	        
58	        return [
59	            {
60	             "pid": app.pid if app.pid != 0 else None,
61	             "name": app.name,
62	             "identifier": app.identifier
63	            }
64	            for app in sorted(applications, key=lambda app: app.name.lower())
65	        ]
66	
67	    except Exception as e:
68	        raise RuntimeError(f"Failed to enumerate applications: {e}")
69	
70	@mcp.tool()
71	async def enumerate_processes() -> List[Dict[str, Any]]:
72	    """
73	    Lists all running processes on the remote device.
74	    Returns a list of dictionaries containing the PID and process name.
75	    """
76	    device = await _get_remote_device()
77	
78	    try:
79	        processes = await asyncio.to_thread(device.enumerate_processes)
80	
81	        if not processes:
82	            return []
83	        
84	        return [
85	            {
86	                "pid": proc.pid,
87	                "name": proc.name
88	            }
89	            for proc in sorted(processes, key=lambda p: p.name.lower())
90	        ]
91	        
92	    except Exception as e:
93	        raise RuntimeError(f"Failed to enumerate processes: {e}")
94	
95	@mcp.tool()
96	async def get_frontmost_application() -> Dict[str, Any]:
97	    """
98	    Gets information about the frontmost application on the remote device.
99	
100	    Returns:
101	        A dictionary containing information about the frontmost application, or a
102	        message indicating that no application is in the foreground.
103	    """
104	    device = await _get_remote_device()
105	
106	    try:
107	        app = await asyncio.to_thread(device.get_frontmost_application) 
108	    except Exception as e:
109	        raise RuntimeError(f"Failed to get the frontmost application: {e}")
110	
111	    if app is None:
112	        return {"message": "No application is currently in the foreground."}
113	
114	    return {
115	        "pid": app.pid,
116	        "name": app.name,
117	        "identifier": app.identifier
118	    }
119	
120	@mcp.tool()
121	async def get_application_by_identifier(identifier: str) -> Dict[str, Any]:
122	    """
123	    Gets information about a specific application by its identifier.
124	
125	    Args:
126	        identifier: The identifier of the application to look up.
127	
128	    Returns:
129	        A string containing information about the application, or a message
130	        indicating that the application was not found.
131	    """
132	    device = await _get_remote_device()
133	
134	    try:
135	        apps = await asyncio.to_thread(device.enumerate_applications)
136	        target = next(
137	            (a for a in apps if a.identifier.lower() == identifier.lower()
138	             or a.name.lower() == identifier.lower()),
139	            None
140	        )
141	
142	        if not target:
143	            return {"found": False, "error": f"Application '{identifier}' not found."}
144	        
145	        return {
146	            "pid": target.pid if target.pid != 0 else None,
147	            "name": target.name,
148	            "identifier": target.identifier,
149	            "found": True
150	        }
151	        
152	    except frida.ProcessNotFoundError:
153	        return {"error": f"Application '{identifier}' not found."}
154	    except Exception as e:
155	        raise RuntimeError(f"An error occurred while getting the application: {e}")
156	
157	@mcp.tool()
158	async def start_application(
159	    program: str = Field(description="The program/bundle identifier to spawn."),
