25	# ==================== 配置类 ====================
26	class Config:
27	    """集中管理应用配置"""
28	    def __init__(self, pos: int, count: int, model_name:str, enable_logging: bool = False):
29	        self.pos = pos
30	        self.count = count
31	        self.enable_logging = enable_logging
32	        self.auto_deploy = False
33	        self.max_chat_loop = 21
34	
35	        # LLM 配置
36	        self.model: str = None
37	        self.base_url: str = None
38	        self.headers: Optional[Dict] = None
39	        self.api_key: str = None
40	        self.is_streaming: bool = False
41	        self.enable_thinking: bool = False
42	
43	        # 路径配置
44	        self.cwd = os.getcwd()
45	        self.prompt_dir = Path(self.cwd) / "mcp-auto" / "prompt"
46	        self.log_dir = Path(self.cwd) / "log_file" / dataset_name / framework_name / model_name
47	        self.data_dir = Path(self.cwd) / "data"
48	
49	    def set_llm(self, model: str, base_url: str, headers: Optional[Dict] = None,
50	                api_key: str = None, is_streaming: bool = False, enable_thinking: bool = False):
51	        self.model = model
52	        self.base_url = base_url
53	        self.headers = headers
54	        self.api_key = api_key
55	        self.is_streaming = is_streaming
56	        self.enable_thinking = enable_thinking
