211	            "filters": {
212	                "platform": platform,
213	                "search_term": search_term,
214	                "limit": limit
215	            }
216	        })
217	
218	        database.update_scan_status(
219	            scan_id,
220	            "completed",
221	            end_time,
222	            duration,
223	            1,
224	            len(filtered_exploits),
225	            results_json
226	        )
227	
228	        print(f"🎯 DEBUG: Found {len(filtered_exploits)} exploits using fast database search (took {duration:.2f}s)")
229	
230	        return {
231	            "success": True,
232	            "scan_id": scan_id,
233	            "filtered_exploits": len(filtered_exploits),
234	            "exploits": filtered_exploits,
235	            "filters_applied": {
236	                "platform": platform or "none",
237	                "search_term": search_term or "none",
238	                "limit": limit
239	            },
240	            "duration_seconds": duration,
241	            "message": f"Found {len(filtered_exploits)} exploits matching criteria (fast database search)",
242	            "search_method": "database"
243	        }
244	
245	    except Exception as e:
246	        return {
247	            "success": False,
