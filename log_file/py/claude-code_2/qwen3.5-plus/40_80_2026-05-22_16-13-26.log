253	def execute_exploit_internal(
254	    exploit_name: str,
255	    target_host: str,
256	    target_port: int = None,
257	    payload: str = "",
258	) -> Dict[str, Any]:
259	    """
260	    Execute a Metasploit exploit against a target.
261	
262	    Args:
263	        exploit_name: Name of the exploit module to use
264	        target_host: Target host IP or hostname
265	        target_port: Target port (if required by exploit)
266	        payload: Payload to use (if not specified, will use default)
267	        exploit_options: Additional exploit options as key-value pairs
268	        payload_options: Additional payload options as key-value pairs
269	
