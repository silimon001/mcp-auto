172	
173	    IMPORTANT: This tool ENUMERATES VULNERABILITIES, not open ports.
174	    For port discovery, use the port_scan tool instead.
175	    """
176	
177	    def scan_with_nuclei_sync(host: str, port: int):
178	        return asyncio.run(scan_with_nuclei(host, port))
179	
