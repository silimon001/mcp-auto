424	def search_findings(hostname: Optional[str] = None, ip_address: Optional[str] = None,
425	                   port: Optional[int] = None, service: Optional[str] = None,
426	                   agent: Optional[str] = None, severity: Optional[str] = None,
427	                   template_id: Optional[str] = None, limit: int = 20) -> dict:
428	    """
429	    Search findings by hostname, IP address, port, service, agent, severity, or template ID.
430	
431	    This allows flexible searching across all findings to find:
432	    - All ports open on a specific host (agent='port-scan')
433	    - All vulnerabilities on a specific host (agent='vuln-scan')
434	    - All hosts running a specific service
435	    - All instances of a specific port across hosts
436	    - All critical/high severity vulnerabilities
437	    - All SSH findings (agent='ssh-agent')
