441	        db = get_database()
442	
443	        # Build dynamic query based on provided parameters
444	        query_filter = {}
445	
446	        if hostname:
447	            query_filter["hostname"] = {"$regex": hostname, "$options": "i"}
448	
449	        if ip_address:
450	            query_filter["ip_address"] = {"$regex": ip_address, "$options": "i"}
451	
452	        if port:
453	            query_filter["port"] = port
454	
455	        if service:
456	            query_filter["service"] = {"$regex": service, "$options": "i"}
457	
458	        if agent:
459	            query_filter["agent"] = agent
460	
461	        if severity:
462	            query_filter["severity"] = severity
463	
464	        if template_id:
465	            query_filter["template_id"] = {"$regex": template_id, "$options": "i"}
466	
467	        # If no conditions, return error
468	        if not query_filter:
469	            return {
470	                "success": False,
471	                "error": "No search parameters provided",
472	                "message": "Please provide at least one search parameter"
473	            }
474	
475	        print(f"📋 Query filter: {query_filter}")
476	        print(f"🔍 Executing database query...")
