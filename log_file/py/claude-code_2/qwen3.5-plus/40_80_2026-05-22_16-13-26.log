195	        
196	        _scripts[session_id] = session
197	        _script_messages[session_id] = []
198	        global_persistent_scripts[session_id] = []
199	        
200	        return {
201	            "status": "success",
202	            "session_id": session_id,
203	            "message": f"Session created for PID {process_id}."
204	        }
205	    except Exception as e:
206	        raise RuntimeError(f"Failed to create session: {e}")
207	    
208	@mcp.tool()
209	async def execute_in_session(
210	    session_id: str,
211	    javascript_code: str,
212	    keep_alive: bool = Field(default=False, description="Keep script loaded for hooks/callbacks.")
213	) -> Dict[str, Any]:
214	    """
215	    Execute JavaScript in a session. Compiles with esbuild before execution.
216	
217	    - keep_alive=False (one-shot): Script runs, returns result, and unloads. Console output
218	      is captured and returned directly in the response's 'console_output' field.
219	      Do NOT call get_session_messages for one-shot scripts — the output is already in the response.
220	    - keep_alive=True (persistent hooks): Script stays loaded for ongoing interception.
221	      Console output from hooks is queued and must be retrieved via get_session_messages.
222	      You MUST use keep_alive=True when hooking/intercepting functions.
223	    """
224	    if session_id not in _scripts:
225	        raise ValueError(f"Session {session_id} not found.")
226	    
227	    session = _scripts[session_id]
228	    if session.is_detached:
229	        raise frida.InvalidOperationError("Session is detached.")
230	    
231	    wrapped_code = f"""
232	    import Java from 'frida-java-bridge';
233	    'use strict';
234	
235	    var _console_output = [];
236	    var _origLog = console.log;
237	    console.log = function() {{
238	        var msg = Array.prototype.slice.call(arguments).join(' ');
239	        _console_output.push(msg);
240	        if (_origLog) _origLog.apply(console, arguments);
241	    }};
242	
243	    Java.perform(function() {{
244	        send({{ 'type': 'agent:ready' }});
245	        try {{
246	            var result = (function() {{
247	                {javascript_code}
248	            }})();
249	            send({{ 
250	                'type': 'agent:result', 
251	                'status': 'success',
252	                'result': result !== undefined ? String(result) : 'Script executed (no direct return value).',
253	                'console_output': _console_output
254	            }});
255	        }} catch (e) {{
256	            send({{ 
257	                'type': 'agent:result',
258	                'status': 'error',
259	                'error': {{ 'message': e.message, 'stack': e.stack }},
260	                'console_output': _console_output
261	            }});
262	        }}
263	    }});
264	    """
265	
266	    if keep_alive:
267	        uncompiled_code = javascript_code
268	    else:
269	        uncompiled_code = wrapped_code
270	
271	    # --- ESBuild Compilation Step (preserved from original) ---
272	    compiled_code = ""
273	    with tempfile.NamedTemporaryFile(mode='w+', delete=False, suffix='.js', dir="/data/data/com.termux/files/home", encoding='utf-8') as infile:
274	        infile_path = infile.name
275	        outfile_path = infile_path.replace('.js', '.compiled.js')
276	
277	        try:
278	            if keep_alive:
279	                log_shim = (
280	                    "var _origLog = console.log;\n"
281	                    "console.log = function() {\n"
282	                    "    var msg = Array.prototype.slice.call(arguments).join(' ');\n"
283	                    "    send({ type: 'agent:log', message: msg });\n"
284	                    "    if (_origLog) _origLog.apply(console, arguments);\n"
285	                    "};\n"
286	                )
287	                uncompiled_code = log_shim + uncompiled_code
288	
289	            if "frida-java-bridge" not in uncompiled_code:
290	                uncompiled_code = "import Java from 'frida-java-bridge';\n" + uncompiled_code
291	
292	            infile.write(uncompiled_code)
293	            infile.close()
294	            
295	            command = [
296	                'esbuild', infile_path, '--bundle', '--minify',
297	                f'--outfile={outfile_path}'
298	            ]
299	            
300	            process = await asyncio.create_subprocess_exec(
301	                *command,
302	                stdout=asyncio.subprocess.PIPE,
303	                stderr=asyncio.subprocess.PIPE
304	            )
305	            stdout, stderr = await process.communicate()
306	
307	            if process.returncode != 0:
308	                raise RuntimeError(f"esbuild failed: {stderr.decode()}")
309	
310	            with open(outfile_path, 'r', encoding='utf-8') as f:
311	                compiled_code = f.read()
312	
313	        finally:
314	            if os.path.exists(infile_path): os.remove(infile_path)
315	            if os.path.exists(outfile_path): os.remove(outfile_path)
316	    
317	    if not compiled_code:
318	        raise RuntimeError("Compilation produced an empty script.")
319	
320	    loop = asyncio.get_running_loop()
321	    result_future = loop.create_future()
322	
323	    def on_message(message, data):
324	        payload = message.get('payload', {})
325	        msg_type = payload.get('type') if isinstance(payload, dict) else None
326	
327	        if message.get('type') == 'error':
328	            if not result_future.done():
329	                loop.call_soon_threadsafe(
330	                    result_future.set_exception,
331	                    RuntimeError(message.get('description', 'Unknown script error'))
332	                )
333	            return
334	
335	        if msg_type == 'agent:result':
336	            if not result_future.done():
337	                loop.call_soon_threadsafe(result_future.set_result, payload)
338	        elif msg_type == 'agent:log':
339	            if session_id in _script_messages:
340	                _script_messages[session_id].append({"type": "log", "message": payload.get("message", "")})
341	        elif msg_type != 'agent:ready':
342	            if session_id in _script_messages:
343	                _script_messages[session_id].append({"type": message["type"], "payload": payload})
344	
345	
346	    try:
347	        def sync_load_script():
348	            script = session.create_script(compiled_code)
349	            script.on("message", on_message)
350	            script.load()
351	            return script
352	        
353	        script = await asyncio.to_thread(sync_load_script)
354	
355	        if keep_alive:
356	            global_persistent_scripts[session_id].append(script)
357	
358	        if keep_alive:
359	            return {
360	                "status": "success",
361	                "message": "Persistent script loaded. Hooks are active if the script runs correctly.",
362	                "script_unloaded": False
363	            }
364	
365	        receipt = await asyncio.wait_for(result_future, timeout=10.0)
366	
367	        result_data = {
368	            "status": receipt.get("status", "error"),
369	            "script_unloaded": not keep_alive
370	        }
371	        if receipt.get("status") == "success":
372	            result_data["result"] = receipt.get("result")
373	        else:
374	            result_data["error_details"] = receipt.get("error")
375	
376	        console_output = receipt.get("console_output", [])
377	        if console_output:
378	            result_data["console_output"] = console_output
379	
380	        return result_data
381	
382	    except asyncio.TimeoutError:
383	        return {
384	            "status": "timeout",
385	            "message": "Timed out waiting for script result. The script may have hung.",
386	            "script_unloaded": not keep_alive
387	        }
388	    except Exception as e:
389	         return {"status": "error", "message": f"Failed to execute script: {e}"}
390	
391	    finally:
392	        if not keep_alive and 'script' in locals() and script:
393	            try:
394	                await asyncio.to_thread(script.unload)
395	            except:
396	                pass
397	
398	@mcp.tool()
399	async def get_session_messages(session_id: str) -> Dict[str, Any]:
400	    """
401	    Retrieve and flush queued messages from persistent (keep_alive=True) scripts.
402	    Messages are cleared after retrieval — each message is returned only once.
403	    Only useful for persistent hooks; one-shot scripts return output directly in execute_in_session.
404	    """
405	    if session_id not in _script_messages:
406	        raise ValueError("Session not found.")
407	    
408	    msgs = list(_script_messages[session_id])
409	    _script_messages[session_id].clear()
410	    return {"messages": msgs}
