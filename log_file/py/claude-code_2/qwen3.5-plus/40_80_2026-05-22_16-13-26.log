2	Utility functions for the Joplin API client.
3	"""
4	
5	import logging
6	import os
7	from dataclasses import dataclass
8	from datetime import datetime
9	from pathlib import Path
10	
11	from dotenv import load_dotenv
12	
13	logger = logging.getLogger(__name__)
14	
15	class JoplinConfigError(Exception):
16	    """Raised when there is an error with the Joplin configuration."""
17	
18	    def __init__(self, message: str, env_var: str | None = None):
19	        self.env_var = env_var
20	        super().__init__(message)
21	
22	@dataclass
23	class MarkdownContent:
24	    """Represents parsed content from a Markdown file.
25	    
26	    Attributes:
27	        title: The title extracted from the first heading or filename
28	        content: The main content of the file
29	        source_path: Original path to the markdown file
30	        created_time: When the file was created
31	        modified_time: When the file was last modified
32	    """
33	    title: str
34	    content: str
35	    source_path: Path
36	    created_time: datetime
37	    modified_time: datetime
38	
39	    @classmethod
40	    def from_file(cls, file_path: Path) -> 'MarkdownContent':
41	        """Create MarkdownContent from a file.
42	        
43	        Args:
44	            file_path: Path to the markdown file
45	            
46	        Returns:
47	            MarkdownContent instance
48	            
49	        Raises:
50	            FileNotFoundError: If the file doesn't exist
51	            ValueError: If the file is empty or invalid
52	        """
53	        if not file_path.exists():
54	            raise FileNotFoundError(f"File not found: {file_path}")
55	
56	        if not file_path.is_file():
57	            raise ValueError(f"Not a file: {file_path}")
58	
59	        content = file_path.read_text(encoding='utf-8')
60	        if not content.strip():
61	            raise ValueError(f"File is empty: {file_path}")
62	
63	        # Extract title from first heading or use filename
64	        lines = content.splitlines()
65	        title = file_path.stem
66	
67	        for line in lines:
68	            if line.startswith('# '):
69	                title = line[2:].strip()
70	                content = '\n'.join(lines[1:]).strip()
71	                break
72	
73	        return cls(
74	            title=title,
75	            content=content,
76	            source_path=file_path,
77	            created_time=datetime.fromtimestamp(file_path.stat().st_ctime),
78	            modified_time=datetime.fromtimestamp(file_path.stat().st_mtime)
79	        )
