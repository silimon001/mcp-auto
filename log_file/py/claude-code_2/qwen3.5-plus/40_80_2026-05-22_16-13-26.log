59	# ==================== 日志管理器 ====================
60	class Logger:
61	    """封装日志记录功能"""
62	    def __init__(self, config: Config):
63	        self.config = config
64	        self.logger = logging.getLogger(__name__)
65	        self._setup()
66	
67	    def _setup(self):
68	        if not self.config.enable_logging:
69	            return
70	
71	        # 关键修复：递归创建目录
72	        self.config.log_dir.mkdir(parents=True, exist_ok=True)
73	
74	        timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
75	        log_filename = self.config.log_dir / f"{self.config.pos}_{self.config.pos+self.config.count}_{timestamp}.log"
76	
77	        print(f"Logging to: {log_filename}")
78	
79	        logging.basicConfig(
80	            filename=str(log_filename),
81	            level=logging.INFO,
82	            format='%(asctime)s - %(levelname)s - %(message)s',
83	            filemode='w',
84	            force=True
85	        )
86	
87	    def log(self, content: str, is_error: bool = False):
88	        print(content)
89	        if self.config.enable_logging:
90	            if is_error:
91	                logging.error(content)
92	            else:
93	                logging.info(content)
94	
95	
96	# ==================== MCP 客户端管理器 ====================
97	class MCPClientManager:
98	    """管理多个 MCP 客户端连接与工具调用"""
99	    def __init__(self, logger: Logger):
100	        self.clients: Dict[str, Client] = {}
101	        self.logger = logger
102	        self.all_tools: List[Tool] = []
103	
104	    async def connect_servers(self, configs: dict):
105	        servers = configs.get("Servers", {})
106	        for name, server_config in servers.items():
107	            client = Client()
108	            try:
109	                await client.init(name, server_config)
110	            except Exception as e:
111	                self.logger.log(str(e), is_error=True)
112	                return
113	            self.clients[name] = client
114	            self.all_tools.extend(client.tools)
115	            self.logger.log(f"Client {name} initialized with tools: {[tool.name for tool in client.tools]}")
116	
117	    async def call_tool(self, server_name: str, tool_name: str, tool_args: dict) -> str:
118	        result = await self.clients[server_name].session.call_tool(tool_name, tool_args)
119	        response = result.content[0].text
120	        if tool_name == 'execute_command':
121	            response = simplify.simplify_log(response)
122	        return response
123	
124	    async def shutdown(self):
125	        for name, client in self.clients.items():
126	            try:
127	                self.logger.log(f"Shutting down client-server connect: {name}")
128	                await client.cleanup()
129	            except Exception as e:
130	                print(f"Error shutting down client-server connect {name}: {e}")
131	
132	
133	# ==================== LLM 客户端 ====================
134	class LLMClient:
135	    """封装与 LLM 的通信"""
136	    def __init__(self, config: Config, logger: Logger):
137	        self.config = config
138	        self.logger = logger
139	        self.communicate_count = 0
140	
141	    @staticmethod
142	    def _delete_reasoning(msg: dict) -> dict:
143	        """移除 reasoning_content 字段"""
144	        if 'reasoning_content' in msg:
145	            return {k: v for k, v in msg.items() if k != 'reasoning_content'}
146	        return msg
147	
148	    def communicate(self, messages: List[dict], tools: List[dict]) -> dict:
149	        """发送请求并返回解析后的响应和用量"""
150	        response = None
151	        if self.config.base_url == 'https://dashscope.aliyuncs.com/compatible-mode/v1':
152	            session = OpenAI(
153	                api_key=self.config.api_key,
154	                base_url=self.config.base_url,
155	            )
156	            response = session.chat.completions.create(
157	                model=self.config.model,
158	                messages=messages,
159	                tools=tools,
160	                stream=self.config.is_streaming,
161	                temperature=0.1, # (0, 2]
162	                tool_choice="auto",
163	                extra_body={"enable_thinking": self.config.enable_thinking}
164	            )
165	            usage = response.usage.to_dict()
166	            choices = response.choices[0].message.to_dict()
167	        else:
168	            # 预留其他 API 适配位置
169	            raise NotImplementedError("Unsupported base_url")
170	
171	        self.communicate_count += 1
172	        self.logger.log(f"--- Communicate Count: {self.communicate_count} ---")
173	        return {
174	            'usage': usage,
175	            'response': self._delete_reasoning(choices)
176	        }
177	
178	
179	# ==================== 对话管理器 ====================
180	class ConversationManager:
181	    """管理消息列表、工具消息筛选"""
182	    def __init__(self):
183	        self.messages: List[dict] = []
184	        self.all_tool_messages: List[dict] = []          # 所有可用工具（OpenAI格式）
185	        self.active_tool_names: List[str] = []           # 当前可用的工具名列表
186	
187	    def register_tools(self, tools: List[Tool]):
188	        """将 MCP Tool 转换为 OpenAI function 格式并存储"""
189	        for tool in tools:
190	            tool_msg = {
191	                "type": "function",
192	                "function": {
193	                    "name": tool.name,
194	                    "description": tool.description,
195	                    "parameters": {
196	                        "type": tool.inputSchema.get('type', 'object'),
197	                        "properties": tool.inputSchema.get('properties', {}),
198	                        "required": tool.inputSchema.get('required', [])
199	                    }
200	                }
201	            }
202	            self.all_tool_messages.append(tool_msg)
203	
204	    def set_active_tools(self, names: List[str]):
205	        """设置当前阶段可用的工具"""
206	        self.active_tool_names = names
207	
208	    def get_active_tool_messages(self) -> List[dict]:
209	        """返回当前激活的工具消息列表"""
210	        return [t for t in self.all_tool_messages if t['function']['name'] in self.active_tool_names]
211	
212	    def add_system_message(self, content: str):
213	        self.messages.append({"role": "system", "content": content})
214	
215	    def add_user_message(self, content: str):
216	        self.messages.append({"role": "user", "content": content})
217	
218	    def add_assistant_message(self, message: dict):
219	        self.messages.append(message)
220	
221	    def add_tool_result(self, tool_call_id: str, content: str):
