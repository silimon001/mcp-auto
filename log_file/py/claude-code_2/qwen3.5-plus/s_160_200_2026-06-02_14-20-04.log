loop 18 | Tool=Bash, Args={"command":"cat << 'EOF' > /home/silimon/mcp-auto/claude_code/mcp_server/961228236_gornskew_lisply-mcp/scripts/mock-backend.js\n#!/usr/bin/env node\nconst http = require('http');\n\nconst server = http.createServer((req, res) => {\n  let body = '';\n  req.on('data', chunk => body += chunk);\n  req.on('end', () => {\n    const url = req.url;\n    if (url === '/lisply/ping-lisp') {\n      res.writeHead(200, {'Content-Type': 'application/json'});\n      res.end(JSON.stringify({status: 'ok', server: 'lisply-mock'}));\n    } else if (url === '/lisply/lisp-eval') {\n      try {\n        const data = JSON.parse(body);\n        const code = data.code || '';\n        let result = '';\n        const evalPatterns = [\n          [/^\\(\\+\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)\\)$/, (a, b, c) => String(Number(a) + Number(b) + Number(c))],\n          [/^\\(\\+\\s+(\\d+)\\s+(\\d+)\\)$/, (a, b) => String(Number(a) + Number(b))],\n          [/^\\(-\\s+(\\d+)\\s+(\\d+)\\)$/, (a, b) => String(Number(a) - Number(b))],\n          [/^\\(\\*\\s+(\\d+)\\s+(\\d+)\\)$/, (a, b) => String(Number(a) * Number(b))],\n          [/^\\(\\/\\s+(\\d+)\\s+(\\d+)\\)$/, (a, b) => String(Number(a) / Number(b))],\n          [/^\\(=\\s+(\\d+)\\s+(\\d+)\\)$/, (a, b) => String(Number(a) === Number(b) ? 'T' : 'NIL')],\n          [/^\\(<=\\s+(\\d+)\\s+(\\d+)\\)$/, (a, b) => String(Number(a) <= Number(b) ? 'T' : 'NIL')],\n          [/^\\(>\\s+(\\d+)\\s+(\\d+)\\)$/, (a, b) => String(Number(a) > Number(b) ? 'T' : 'NIL')],\n          [/^\\(<\\s+(\\d+)\\s+(\\d+)\\)$/, (a, b) => String(Number(a) < Number(b) ? 'T' : 'NIL')],\n        ];\n        let matched = false;\n        for (const [re, fn] of evalPatterns) {\n          const m = code.match(re);\n          if (m) { result = fn(m[1], m[2], m[3]); matched = true; break; }\n        }\n        if (!matched) {\n          if (code.includes('(format')) {\n            result = '\"output\"';\n          } else if (code.includes('(in-package')) {\n            result = '#<PACKAGE \"' + (code.match(/\"([^\"]+)\"/) || ['', 'COMMON-LISP'])[1] + '\">';\n          } else if (code.includes('(defparameter') || code.includes('(setq')) {\n            result = code.match(/\\*\\w+\\*/)?.[0] || 'NIL';\n          } else {\n            result = code.trim();\n          }\n        }\n        res.writeHead(200, {'Content-Type': 'application/json'});\n        res.end(JSON.stringify({Result: result, Stdout: '', Error: ''}));\n      } catch(e) {\n        res.writeHead(400, {'Content-Type': 'application/json'});\n        res.end(JSON.stringify({Result: '', Stdout: '', Error: e.message}));\n      }\n    } else if (url === '/lisply/http-request') {\n      res.writeHead(200, {'Content-Type': 'application/json'});\n      res.end(JSON.stringify({status: 200, body: '{}'}));\n    } else {\n      res.writeHead(200, {'Content-Type': 'application/json'});\n      res.end(JSON.stringify({status: 'ok'}));\n    }\n  });\n});\n\nserver.listen(9081, '127.0.0.1', () => {\n  console.error('Mock Lisply backend running on http://127.0.0.1:9081');\n});\nEOF\necho \"Mock backend created\""}
