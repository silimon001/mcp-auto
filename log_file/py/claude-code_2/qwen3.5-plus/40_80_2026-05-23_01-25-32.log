200	@dataclass
201	class AppContext:
202	    """Application context for storing active sessions"""
203	    sessions: Dict[str, LldbSession]
204	
205	
206	@asynccontextmanager
207	async def app_lifespan(server: FastMCP) -> AsyncIterator[AppContext]:
208	    """Manage application lifecycle with shared session state"""
209	    # Initialize on startup
210	    sessions = {}
211	    try:
212	        yield AppContext(sessions=sessions)
213	    finally:
214	        # Cleanup all sessions on shutdown
215	        for session_id, session in list(sessions.items()):
216	            await session.cleanup()
217	            sessions.pop(session_id, None)
218	
219	
220	# Create an MCP server
221	mcp = FastMCP("lldb-mcp", lifespan=app_lifespan)
222	
223	
224	# Helper function to get session from context
225	def get_session(ctx: Context, session_id: str) -> LldbSession:
226	    """Get a session by ID or raise an error if not found"""
227	    # Access the lifespan context through request_context
228	    sessions = ctx.request_context.lifespan_context.sessions
229	    if session_id not in sessions:
230	        raise ValueError(f"No active LLDB session with ID: {session_id}")
231	    return sessions[session_id]
232	
233	
234	@mcp.tool()
235	async def lldb_start(ctx: Context, lldb_path: str = "lldb", working_dir: str = None) -> str:
236	    """Start a new LLDB session"""
237	    session_id = str(uuid.uuid4())
238	    debug_log(f"Starting new LLDB session with ID: {session_id}")
239	    
240	    try:
241	        # Verify lldb path
242	        try:
243	            debug_log(f"Verifying lldb path: {lldb_path}")
244	            proc = await asyncio.create_subprocess_exec(
245	                lldb_path, "--version",
246	                stdout=asyncio.subprocess.PIPE,
247	                stderr=asyncio.subprocess.PIPE
248	            )
249	            debug_log(f"Communicating with lldb")
250	            try:
251	                stdout, stderr = await asyncio.wait_for(proc.communicate(), timeout=5.0)
252	                debug_log(f"Received response from lldb")
253	                if proc.returncode != 0:
254	                    error_msg = stderr.decode('utf-8', errors='replace').strip()
255	                    return f"Failed to start LLDB: Invalid lldb path '{lldb_path}'. Error: {error_msg}"
256	            except asyncio.TimeoutError:
257	                debug_log("Timeout while verifying lldb path")
258	                proc.kill()
259	                await proc.wait()
260	                return f"Failed to start LLDB: Timeout while verifying lldb path '{lldb_path}'"
261	        except Exception as e:
262	            debug_log(f"Error verifying lldb path: {str(e)}")
263	            return f"Failed to start LLDB: Invalid lldb path '{lldb_path}'. Error: {str(e)}"
264	        
265	        # Use provided working directory or current dir
266	        working_dir = working_dir or os.getcwd()
267	        debug_log(f"Using working directory: {working_dir}")
268	        
269	        # Create new LLDB session
270	        session = LldbSession(session_id=session_id, lldb_path=lldb_path, working_dir=working_dir)
271	        debug_log(f"Created new LLDB session")
272	        
273	        # Start LLDB process with timeout
274	        try:
275	            debug_log("Starting LLDB process...")
276	            output = await asyncio.wait_for(session.start(), timeout=10.0)
277	            debug_log(f"LLDB session started successfully")
278	        except asyncio.TimeoutError:
279	            debug_log("Timeout while starting LLDB session")
280	            await session.cleanup()
281	            return f"Failed to start LLDB: Timeout while initializing LLDB session"
282	        except Exception as e:
283	            debug_log(f"Error starting LLDB session: {str(e)}")
284	            await session.cleanup()
285	            return f"Failed to start LLDB: {str(e)}"
286	        
287	        # Store session in context
288	        ctx.request_context.lifespan_context.sessions[session_id] = session
289	        debug_log(f"Stored session in context")
290	        return f"LLDB session started with ID: {session_id}\n\nOutput:\n{output}"
291	    
292	    except Exception as e:
293	        debug_log(f"Unexpected error in lldb_start: {str(e)}")
294	        return f"Failed to start LLDB: {str(e)}"
295	
