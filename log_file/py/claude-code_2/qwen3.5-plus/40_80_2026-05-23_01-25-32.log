37	def setup_logging(level: str = "INFO", log_file: Optional[str] = None, mcp_mode: bool = False):
38	    """Setup logging configuration."""
39	    handlers = []
40	    
41	    # Always add file handler if specified
42	    if log_file:
43	        file_handler = logging.FileHandler(log_file)
44	        file_handler.setFormatter(
45	            logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
46	        )
47	        handlers.append(file_handler)
48	    
49	    # Only add console handler if NOT in MCP mode
50	    if not mcp_mode:
51	        handlers.append(RichHandler(console=console, show_time=True, show_path=False))
52	    else:
53	        # In MCP mode, log to stderr instead of stdout
54	        stderr_handler = logging.StreamHandler(sys.stderr)
