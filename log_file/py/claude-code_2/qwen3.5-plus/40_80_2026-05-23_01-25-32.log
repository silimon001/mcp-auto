126	def get_smtp_info() -> tuple[str, int] | tuple[None, None]:
127	    """Get the SMTP server address and port from the configuration based on the sender's email domain name.
128	
129	    Returns:
130	        tuple[str, int] | tuple[None, None]: Returns the matching SMTP server address and port; if not found, returns (None, None).
131	    """
132	    # Extract the domain name part of the sender's email
133	    domain = f"@{sender.split('@')[1]}"
134	
135	    # Traverse the configuration and find the matching domain name
136	    for config in email_config:
137	        if config.get("domain") == domain:
138	            return config.get("server"), config.get("port")
139	
140	    # No matching configuration found
141	    return None, None
