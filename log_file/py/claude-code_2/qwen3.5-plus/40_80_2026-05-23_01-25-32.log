56	@mcp.tool(name="kafka-publish", description=tool_settings.tool_publish_description)
57	async def publish(ctx: Context, information: Any) -> str:
58	    """
59	    :param ctx:
60	    :param information:
61	    :return:
62	    """
63	    await ctx.debug(f"Storing information {information} in kafka topic")
64	    kafka_connector: KafkaConnector = ctx.request_context.lifespan_context[
65	        "kafka_connector"
66	    ]
67	    await kafka_connector.publish(value=information)
68	    return f"published: {information}"
69	
70	
71	@mcp.tool(name="kafka-consume", description=tool_settings.tool_consume_description)
72	async def consumer(ctx: Context) -> str:
73	    """
74	    :param ctx:
75	    :param information:
76	    :return:
77	    """
