48	@mcp.tool()
49	async def switch_air_purifier(
50	    action: Literal["turn_on", "turn_off"] = Field(description="要执行的操作类型: 打开或者关闭。必须从两个选项中选择一个"), 
51	) -> str:
52	    """
53	    控制空气净化器的开关机流程。请根据用户的需求抽取参数，控制设备。
54	    """
55	
56	    response_json = dict()
57	
58	    try:
59	
60	        # Sanity check
61	        if action not in ['turn_on', 'turn_off']:
62	            return error_json_msg('不支持的开关操作类型。仅支持 turn_on, turn_off。请核对后重新输入。')
63	        logger.info(f"Current action: {action}")
64	        # Request body formation
65	        domain = SWITCH_ENTITY_ID.split(".")[0]
66	        request_url = f"{CONTROL_CENTER_BASE_URL}/api/services/{domain}/{action}"
67	        data = {
68	            "entity_id": SWITCH_ENTITY_ID
69	        }
70	        # HTTP request
71	        response = requests.post(request_url, headers=CONTROL_CENTER_HEADERS, json=data)
72	        response.raise_for_status()
73	        if response.status_code == 200:
74	            response_json['message'] = f"操作成功！"
75	            response_json['status_code'] = 200
76	
77	    except requests.exceptions.RequestException as e:
78	        response_json['message'] = f"操作运行失败！错误内容：HTTP请求失败，原因：{str(e)}"
79	        response_json['status_code'] = 299
80	    except Exception as e:
81	        response_json['message'] = f"操作运行失败！错误内容: {str(e)}"
82	        response_json['status_code'] = 299
83	
84	    logger.info(f"{response_json}")
85	    return response_json
