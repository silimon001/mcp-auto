5	from mcp.server import Server
6	from mcp.types import Resource, Tool, TextContent
7	from pydantic import AnyUrl
8	
9	# Configure logging
10	logging.basicConfig(
11	    level=logging.INFO,
12	    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
13	)
14	logger = logging.getLogger("mssql_mcp_server")
15	
16	def get_db_config():
17	    """Get database configuration from environment variables."""
18	    config = {
19	        "driver": os.getenv("MSSQL_DRIVER", "SQL Server"),
20	        "server": os.getenv("MSSQL_HOST", "localhost"),
21	        "user": os.getenv("MSSQL_USER"),
22	        "password": os.getenv("MSSQL_PASSWORD"),
23	        "database": os.getenv("MSSQL_DATABASE"),
24	        "trusted_server_certificate": os.getenv("TrustServerCertificate", "yes"),
25	        "trusted_connection": os.getenv("Trusted_Connection", "no")
26	    }
27	    if not all([config["user"], config["password"], config["database"]]):
28	        logger.error("Missing required database configuration. Please check environment variables:")
29	        logger.error("MSSQL_USER, MSSQL_PASSWORD, and MSSQL_DATABASE are required")
30	        raise ValueError("Missing required database configuration")
31	    
32	    connection_string = f"Driver={config['driver']};Server={config['server']};UID={config['user']};PWD={config['password']};Database={config['database']};TrustServerCertificate={config['trusted_server_certificate']};Trusted_Connection={config['trusted_connection']};"
33	
34	    return config, connection_string
35	
36	# Initialize server
37	app = Server("mssql_mcp_server")
38	
39	@app.list_resources()
40	async def list_resources() -> list[Resource]:
41	    """List MSSQL tables as resources."""
42	    config, connection_string = get_db_config()
43	    try:
44	        with connect(connection_string) as conn:
45	            with conn.cursor() as cursor:
46	                # Use INFORMATION_SCHEMA to list tables in MSSQL
47	                cursor.execute("SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_TYPE = 'BASE TABLE';")
48	                tables = cursor.fetchall()
49	                logger.info(f"Found tables: {tables}")
50	                
51	                resources = []
52	                for table in tables:
53	                    resources.append(
54	                        Resource(
55	                            uri=f"mssql://{table[0]}/data",
56	                            name=f"Table: {table[0]}",
57	                            mimeType="text/plain",
58	                            description=f"Data in table: {table[0]}"
59	                        )
60	                    )
61	                return resources
62	    except Error as e:
63	        logger.error(f"Failed to list resources: {str(e)}")
64	        return []
65	
66	@app.read_resource()
67	async def read_resource(uri: AnyUrl) -> str:
68	    """Read table contents."""
69	    config, connection_string = get_db_config()
70	    uri_str = str(uri)
71	    logger.info(f"Reading resource: {uri_str}")
72	    
73	    if not uri_str.startswith("mssql://"):
74	        raise ValueError(f"Invalid URI scheme: {uri_str}")
75	        
76	    parts = uri_str[8:].split('/')
77	    table = parts[0]
78	    
79	    try:
80	        with connect(connection_string) as conn:
81	            with conn.cursor() as cursor:
82	                cursor.execute(f"SELECT TOP 100 * FROM {table}")
83	                columns = [desc[0] for desc in cursor.description]
84	                rows = cursor.fetchall()
85	                result = [",".join(map(str, row)) for row in rows]
86	                return "\n".join([",".join(columns)] + result)
87	                
88	    except Error as e:
89	        logger.error(f"Database error reading resource {uri}: {str(e)}")
90	        raise RuntimeError(f"Database error: {str(e)}")
91	
92	@app.list_tools()
93	async def list_tools() -> list[Tool]:
94	    """List available MSSQL tools."""
95	    logger.info("Listing tools...")
96	    return [
97	        Tool(
98	            name="execute_sql",
99	            description="Execute an SQL query on the MSSQL server",
100	            inputSchema={
101	                "type": "object",
102	                "properties": {
103	                    "query": {
104	                        "type": "string",
105	                        "description": "The SQL query to execute"
106	                    }
107	                },
108	                "required": ["query"]
109	            }
110	        )
111	    ]
112	
113	@app.call_tool()
114	async def call_tool(name: str, arguments: dict) -> list[TextContent]:
115	    """Execute SQL commands."""
116	    config, connection_string = get_db_config()
117	    logger.info(f"Calling tool: {name} with arguments: {arguments}")
118	    
119	    if name != "execute_sql":
120	        raise ValueError(f"Unknown tool: {name}")
121	    
122	    query = arguments.get("query")
123	    if not query:
124	        raise ValueError("Query is required")
125	    
126	    try:
127	        with connect(connection_string) as conn:
128	            with conn.cursor() as cursor:
129	                cursor.execute(query)
130	                
131	                # Special handling for listing tables in MSSQL
132	                if query.strip().upper() == "SHOW TABLES":
133	                    cursor.execute("SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_TYPE = 'BASE TABLE';")
134	                    tables = cursor.fetchall()
135	                    result = [f"Tables_in_{config['database']}"]  # Header
136	                    result.extend([table[0] for table in tables])
137	                    return [TextContent(type="text", text="\n".join(result))]
138	                
139	                # Regular SELECT queries
140	                elif query.strip().upper().startswith("SELECT"):
141	                    columns = [desc[0] for desc in cursor.description]
142	                    rows = cursor.fetchall()
143	                    result = [",".join(map(str, row)) for row in rows]
144	                    return [TextContent(type="text", text="\n".join([",".join(columns)] + result))]
145	                
146	                # Non-SELECT queries
147	                else:
148	                    conn.commit()
149	                    return [TextContent(type="text", text=f"Query executed successfully. Rows affected: {cursor.rowcount}")]
150	                
151	    except Exception as e:
152	        logger.error(f"Error executing SQL '{query}': {e}")
153	        return [TextContent(type="text", text=f"Error executing query: {str(e)}")]
154	
155	async def main():
156	    """Main entry point to run the MCP server."""
157	    from mcp.server.stdio import stdio_server
158	    
159	    logger.info("Starting MSSQL MCP server...")
160	    config, _ = get_db_config()
161	    logger.info(f"Database config: {config['server']}/{config['database']} as {config['user']}")
162	    
163	    async with stdio_server() as (read_stream, write_stream):
164	        try:
165	            await app.run(
166	                read_stream,
167	                write_stream,
168	                app.create_initialization_options()
169	            )
170	        except Exception as e:
171	            logger.error(f"Server error: {str(e)}", exc_info=True)
172	            raise
173	
174	if __name__ == "__main__":
175	    asyncio.run(main())
176	

