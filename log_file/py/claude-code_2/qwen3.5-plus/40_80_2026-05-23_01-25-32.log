20	def _get_device_sync() -> frida.core.Device:
21	    """Blocking helper to get the device (run in thread)."""
22	    try:
23	        return frida.get_remote_device()
24	    except Exception as e:
25	        raise RuntimeError(f"Could not connect to remote Frida server: {e}")
26	
27	async def _get_remote_device() -> frida.core.Device:
28	    """Async wrapper to get device without blocking the event loop."""
29	    return await asyncio.to_thread(_get_device_sync)
