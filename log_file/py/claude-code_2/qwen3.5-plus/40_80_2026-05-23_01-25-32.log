19	# Global debug flag - set to False by default
20	DEBUG = False
21	
22	def debug_log(message: str) -> None:
23	    """Print debug messages only when DEBUG flag is enabled"""
24	    if DEBUG:
25	        print(f"[DEBUG] {message}")
26	
27	# Class to handle LLDB sessions
28	class LldbSession:
29	    def __init__(self, session_id: str, lldb_path: str, working_dir: Optional[str] = None):
30	        self.id = session_id
31	        self.lldb_path = lldb_path
32	        self.working_dir = working_dir or os.getcwd()
33	        self.process = None
34	        self.master_fd = None
35	        self.slave_fd = None
36	        self.target = None
37	        self.ready = False
38	    
39	    async def start(self) -> str:
40	        """Start the LLDB process with a PTY"""
41	        debug_log(f"Starting LLDB process with path: {self.lldb_path}")
42	        
43	        # Create a pseudo-terminal pair
44	        self.master_fd, self.slave_fd = pty.openpty()
45	        debug_log(f"Created PTY pair: master={self.master_fd}, slave={self.slave_fd}")
46	        
47	        # Make the terminal raw
48	        old_settings = termios.tcgetattr(self.slave_fd)
49	        new_settings = termios.tcgetattr(self.slave_fd)
50	        new_settings[3] = new_settings[3] & ~termios.ECHO  # Disable echo
51	        termios.tcsetattr(self.slave_fd, termios.TCSADRAIN, new_settings)
52	        
53	        # Start LLDB process
54	        cmd = [self.lldb_path]
55	        self.process = await asyncio.create_subprocess_exec(
56	            *cmd,
57	            stdin=self.slave_fd,
58	            stdout=self.slave_fd,
59	            stderr=self.slave_fd,
60	            cwd=self.working_dir
61	        )
62	        debug_log(f"LLDB process created with PID: {self.process.pid}")
63	        
64	        # Close slave end in parent process
65	        os.close(self.slave_fd)
66	        self.slave_fd = None
67	        
68	        # Make the master fd non-blocking
69	        flags = fcntl.fcntl(self.master_fd, fcntl.F_GETFL)
70	        fcntl.fcntl(self.master_fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)
71	        
72	        # Wait for initial prompt
73	        debug_log("Waiting for initial prompt...")
74	        output = await self.read_until_prompt()
75	        debug_log("Initial prompt received")
76	
77	        self.ready = True
78	        
79	        # Send version command to confirm LLDB is working
80	        debug_log("Sending version command")
81	        version_output = await self.execute_command("version")
82	        output += version_output
83	        
84	        return output
85	    
86	    async def execute_command(self, command: str) -> str:
87	        """Execute an LLDB command and return the output"""
88	        if not self.ready:
89	            raise RuntimeError("LLDB session is not ready")
90	
91	        if not self.process:
92	            raise RuntimeError("LLDB session is not ready: no process")
93	
94	        if self.process.returncode is not None:
95	            raise RuntimeError("LLDB session is not ready: process has terminated, code: %d" % self.process.returncode)
96	        
97	        # Write command to master fd
98	        debug_log(f"Executing command: {command}")
99	        os.write(self.master_fd, f"{command}\n".encode())
100	        
101	        # Read response until prompt
102	        return await self.read_until_prompt()
103	    
104	    async def read_until_prompt(self) -> str:
105	        """Read from LLDB until prompt is encountered"""
106	        if not self.master_fd:
107	            raise RuntimeError("PTY not initialized")
108	            
109	        buffer = b""
110	        prompt_pattern = b"(lldb)"
111	        
112	        start_time = asyncio.get_event_loop().time()
113	        debug_log("Starting to read until prompt")
114	        
115	        # Read until we see the prompt or timeout
116	        while True:
117	            # Check for timeout
118	            current_time = asyncio.get_event_loop().time()
119	            if current_time - start_time > 10.0:
120	                debug_log(f"Global timeout reached after {current_time - start_time:.1f} seconds")
121	                return buffer.decode('utf-8', errors='replace') + "\n[Timeout waiting for LLDB response]"
122	            
123	            # Check if process has terminated
124	            if self.process and self.process.returncode is not None:
125	                debug_log(f"Process terminated with code: {self.process.returncode}")
126	                if buffer:
127	                    return buffer.decode('utf-8', errors='replace')
128	                raise RuntimeError(f"LLDB process terminated with code {self.process.returncode}")
129	            
130	            try:
131	                # Try to read from the master fd
132	                chunk = os.read(self.master_fd, 1024)
133	                if chunk:
134	                    debug_log(f"Read {len(chunk)} bytes from PTY")
135	                    buffer += chunk
136	                    
137	                    # Print readable content for debugging
138	                    try:
139	                        decoded = chunk.decode('utf-8', errors='replace')
140	                        debug_log(f"Read data: {decoded.strip()}")
141	                    except:
142	                        pass
143	                    
144	                    # Check if buffer contains the prompt
145	                    if prompt_pattern in buffer:
146	                        debug_log("Found LLDB prompt in buffer")
147	                        return buffer.decode('utf-8', errors='replace')
148	            except BlockingIOError:
149	                # No data available yet, yield control
150	                await asyncio.sleep(0.1)
151	            except Exception as e:
152	                debug_log(f"Error reading from PTY: {str(e)}")
153	                if buffer:
154	                    return buffer.decode('utf-8', errors='replace') + f"\n[Error reading from LLDB: {str(e)}]"
155	                raise RuntimeError(f"Error reading from LLDB: {str(e)}")
156	    
157	    async def cleanup(self):
158	        """Clean up LLDB resources"""
159	        debug_log("Cleaning up LLDB session")
160	        try:
161	            if self.master_fd is not None:
162	                # Send quit command
163	                try:
164	                    os.write(self.master_fd, b"quit\n")
165	                    # Wait briefly for the process to exit
166	                    await asyncio.sleep(0.5)
167	                except Exception as e:
168	                    debug_log(f"Error sending quit command: {e}")
169	                
170	            if self.process and self.process.returncode is None:
171	                debug_log("Terminating LLDB process")
172	                self.process.terminate()
173	                try:
174	                    await asyncio.wait_for(self.process.wait(), 2.0)
175	                except asyncio.TimeoutError:
176	                    debug_log("Force killing LLDB process")
177	                    self.process.kill()
178	                    await self.process.wait()
179	                    
180	            # Close the PTY master fd
181	            if self.master_fd is not None:
182	                debug_log(f"Closing master fd: {self.master_fd}")
183	                os.close(self.master_fd)
184	                self.master_fd = None
185	                
186	            # Close the PTY slave fd if it's still open
187	            if self.slave_fd is not None:
188	                debug_log(f"Closing slave fd: {self.slave_fd}")
189	                os.close(self.slave_fd)
190	                self.slave_fd = None
191	                
192	        except Exception as e:
193	            debug_log(f"Error during cleanup: {e}")
194	        finally:
195	            self.process = None
196	            self.ready = False
197	            debug_log("LLDB session cleanup completed")
198	
