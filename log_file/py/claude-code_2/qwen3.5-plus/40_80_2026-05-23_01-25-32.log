168	async def search_attachments(pattern: str, ignore_case: bool = True) -> str:
169	    """
170	    Searches for file paths matching the specified pattern in the specified directory.
171	
172	    Args:
173	        pattern: the text pattern to search
174	        ignore_case: whether to ignore case
175	
176	    Returns:
177	        A collection of matching file paths
178	    """
179	    # 规范化目录路径
180	    root_dir = os.path.abspath(os.path.expanduser(ATTACHMENT_FOLDER))
181	    if not os.path.exists(root_dir):
182	        raise ValueError(f"directory no exists: {ATTACHMENT_FOLDER}")
183	
184	    matches = set()
185	    pattern = pattern.lower() if ignore_case else pattern
186	
187	    # 遍历目录
188	    for root, _, files in os.walk(root_dir):
189	        for file in files:
190	            file_name = file.lower() if ignore_case else file
191	            if pattern in file_name:
192	                full_path = os.path.join(root, file)
193	                matches.add(full_path)
194	
195	    return "\n".join(matches)
196	
197	def attach_file(file_path):
198	    # Define allowed file types
199	    ALLOWED_EXTENSIONS = {
200	        'document': ['doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'pdf'],
201	        'archive': ['zip', 'rar', '7z', 'tar', 'gz'],
202	        'text': ['txt', 'log', 'csv', 'json', 'xml'],
203	        'image': ['jpg', 'jpeg', 'png', 'gif', 'bmp'],
204	        'other': ['md']  # Other special formats allowed
205	    }
206	
207	    # Flatten the list of allowed extensions
208	    allowed_extensions = [ext for exts in ALLOWED_EXTENSIONS.values() for ext in exts]
209	
210	    with open(file_path, 'rb') as f:
211	        file_data = f.read()
212	        filename = os.path.basename(file_path)
213	        ext = filename.lower().split('.')[-1]
214	
215	        # Check if the file type is allowed
216	        if ext not in allowed_extensions:
217	            raise ValueError(f"Unsupported file types: {ext}")
218	
219	        # Process according to file type
220	        if ext in ALLOWED_EXTENSIONS['document']:
221	            attachment = MIMEApplication(file_data, _subtype=ext)
222	        elif ext in ALLOWED_EXTENSIONS['archive']:
223	            attachment = MIMEApplication(file_data)
224	        elif ext in ALLOWED_EXTENSIONS['text']:
225	            try:
226	                attachment = MIMEText(file_data.decode('UTF-8'), 'plain')
227	            except UnicodeDecodeError:
228	                # If UTF-8 decoding is not possible, treat it as a normal attachment
229	                attachment = MIMEApplication(file_data)
230	        elif ext in ALLOWED_EXTENSIONS['image']:
231	            attachment = MIMEImage(file_data)
232	        else:
233	            # Other allowed formats use generic processing
234	            attachment = MIMEApplication(file_data)
235	
236	        attachment.add_header('Content-Disposition', 'attachment', filename=filename)
237	        return attachment
