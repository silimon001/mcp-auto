558	
559	    # Create the node
560	    node = resolve_api.create_fusion_node(comp, node_type, parameters)
561	    if node:
562	        return f"Successfully created {node_type} node in the Fusion composition."
563	    else:
564	        return f"Failed to create {node_type} node. Check that the node type is valid."
565	
566	
567	@mcp.tool()
568	def create_fusion_node_chain(node_chain: List[Dict[str, Any]]) -> str:
569	    """
570	    Create a chain of connected Fusion nodes in the current composition.
571	
572	    Args:
573	        node_chain: A list of dictionaries, each containing:
574	                    - 'type': The type of node to create
575	                    - 'name': Optional name for the node
576	                    - 'params': Optional dictionary of parameters to set on the node
577	
578	    Returns:
579	        A message indicating success or failure
580	    """
581	    if not resolve_api.is_connected():
582	        return "Error: Not connected to DaVinci Resolve."
583	
584	    # Get the current Fusion composition
585	    comp = resolve_api.get_current_comp()
586	    if not comp:
587	        return "No active Fusion composition. Please open the Fusion page and select a composition first."
588	
589	    if not node_chain or len(node_chain) == 0:
590	        return "No nodes specified in the chain."
591	
592	    try:
593	        # Create the first node
594	        prev_node = None
595	        nodes_created = []
596	
597	        for node_info in node_chain:
598	            node_type = node_info.get("type")
599	            if not node_type:
600	                continue
601	
602	            # Create the node
603	            node = resolve_api.create_fusion_node(comp, node_type, node_info.get("params"))
604	
605	            if not node:
606	                continue
607	
608	            # Set the node name if provided
609	            if "name" in node_info and node_info["name"]:
610	                node.SetAttrs({"TOOLS_Name": node_info["name"]})
611	
612	            # Connect to previous node if this isn't the first node
613	            if prev_node:
614	                # Connect the main output of the previous node to the main input of this node
615	                node.ConnectInput("Input", prev_node)
616	
617	            prev_node = node
618	            nodes_created.append(node_type)
619	
620	        if not nodes_created:
621	            return "Failed to create any nodes in the chain."
622	
623	        return f"Successfully created node chain: {' -> '.join(nodes_created)}"
624	    except Exception as e:
625	        return f"Error creating node chain: {str(e)}"
626	
627	
628	# Tools for Page Navigation
629	
630	
631	@mcp.tool()
632	def open_page(page_name: str) -> str:
633	    """
634	    Open a specific page in DaVinci Resolve.
635	
636	    Args:
637	        page_name: The name of the page to open (media, edit, fusion, color, fairlight, deliver)
638	
639	    Returns:
640	        A message indicating success or failure
641	    """
642	    if not resolve_api.is_connected():
643	        return "Error: Not connected to DaVinci Resolve."
644	
645	    valid_pages = ["media", "edit", "fusion", "color", "fairlight", "deliver"]
646	    if page_name.lower() not in valid_pages:
647	        return f"Invalid page name. Valid pages are: {', '.join(valid_pages)}."
648	
649	    success = resolve_api.open_page(page_name.lower())
650	    if success:
651	        return f"Successfully opened the {page_name.capitalize()} page."
652	    else:
653	        return f"Failed to open the {page_name.capitalize()} page."
654	
655	
656	# Tools for Advanced Operations
657	
658	
659	@mcp.tool()
660	def execute_python(code: str) -> str:
661	    """
662	    Execute arbitrary Python code in DaVinci Resolve.
663	
664	    Args:
665	        code: The Python code to execute
666	
667	    Returns:
668	        The result of the code execution
669	    """
670	    if not resolve_api.is_connected():
671	        return "Error: Not connected to DaVinci Resolve."
672	
673	    # Create a local namespace with access to the Resolve API
674	    local_namespace = {
675	        "resolve_api": resolve_api,
676	        "resolve": resolve_api.resolve,
677	        "fusion": resolve_api.fusion,
678	        "project_manager": resolve_api.project_manager,
679	        "current_project": resolve_api.current_project,
680	        "media_storage": resolve_api.media_storage,
681	        "media_pool": resolve_api.media_pool,
682	    }
683	
684	    try:
685	        # Execute the code in the local namespace
686	        exec(code, globals(), local_namespace)
687	
688	        # Update the Resolve API objects with any changes made in the code
689	        resolve_api.resolve = local_namespace.get("resolve", resolve_api.resolve)
690	        resolve_api.fusion = local_namespace.get("fusion", resolve_api.fusion)
691	        resolve_api.project_manager = local_namespace.get(
692	            "project_manager", resolve_api.project_manager
693	        )
694	        resolve_api.current_project = local_namespace.get(
695	            "current_project", resolve_api.current_project
696	        )
697	        resolve_api.media_storage = local_namespace.get("media_storage", resolve_api.media_storage)
698	        resolve_api.media_pool = local_namespace.get("media_pool", resolve_api.media_pool)
699	
700	        # Check for a result variable
701	        if "result" in local_namespace:
702	            result = local_namespace["result"]
703	            return str(result)
704	
705	        return "Code executed successfully."
706	    except Exception as e:
707	        return f"Error executing code: {str(e)}"
708	
709	
710	@mcp.tool()
711	def execute_lua(script: str) -> str:
712	    """
713	    Execute a Lua script in DaVinci Resolve's Fusion.
714	
715	    Args:
716	        script: The Lua script to execute
717	
718	    Returns:
719	        The result of the script execution
720	    """
721	    if not resolve_api.is_connected():
722	        return "Error: Not connected to DaVinci Resolve."
723	
724	    if not resolve_api.fusion:
725	        return "Fusion is not available."
726	
727	    try:
728	        result = resolve_api.execute_lua(script)
729	        return str(result) if result is not None else "Script executed successfully."
730	    except Exception as e:
731	        return f"Error executing Lua script: {str(e)}"
732	
