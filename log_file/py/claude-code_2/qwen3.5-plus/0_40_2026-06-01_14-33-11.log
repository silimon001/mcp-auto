149	# Configure logging
150	log_level_str = os.environ.get(ENV_GRAPHITI_LOG_LEVEL, 'info').upper()
151	log_level = getattr(logging, log_level_str, DEFAULT_LOG_LEVEL)
152	
153	logging.basicConfig(
154	    level=log_level,
155	    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
156	    stream=sys.stderr,
157	)
158	logger = logging.getLogger(__name__)
159	logger.info(f'Initial logging configured with level: {logging.getLevelName(log_level)}')
160	
161	# Function to reconfigure logging level based on final decision
162	def configure_logging(level_name: str):
163	    """
164	    Configure or reconfigure the logging level based on a string level name.
165	    
166	    Args:
167	        level_name: A string representation of the logging level ('debug', 'info', etc.)
168	    """
169	    global logger, log_level
170	    level_name_upper = level_name.upper()
171	    new_level = getattr(logging, level_name_upper, DEFAULT_LOG_LEVEL)
172	    if new_level != log_level:  # Only reconfigure if level changes
173	        log_level = new_level
174	        logging.getLogger().setLevel(log_level)  # Set level on root logger
175	        # Re-get logger instance for safety
176	        logger = logging.getLogger(__name__)
177	        logger.info(f"Logging level reconfigured to: {logging.getLevelName(log_level)}")
178	    else:
179	        logger.info(f"Logging level remains at: {logging.getLevelName(log_level)}")
180	
181	# Create global config instance
182	config = GraphitiConfig.from_env()
183	
184	# MCP server instructions
185	GRAPHITI_MCP_INSTRUCTIONS = """
186	Welcome to Graphiti MCP - a memory service for AI agents built on a knowledge graph. Graphiti performs well
187	with dynamic data such as user interactions, changing enterprise data, and external information.
188	
189	Graphiti transforms information into a richly connected knowledge network, allowing you to 
190	capture relationships between concepts, entities, and information. The system organizes data as episodes 
191	(content snippets), nodes (entities), and facts (relationships between entities), creating a dynamic, 
192	queryable memory store that evolves with new information. Graphiti supports multiple data formats, including 
193	structured JSON data, enabling seamless integration with existing data pipelines and systems.
194	
195	Facts contain temporal metadata, allowing you to track the time of creation and whether a fact is invalid 
196	(superseded by new information).
197	
198	Key capabilities:
199	1. Add episodes (text, messages, or JSON) to the knowledge graph with the add_episode tool
200	2. Search for nodes (entities) in the graph using natural language queries with search_nodes
201	3. Find relevant facts (relationships between entities) with search_facts
202	4. Retrieve specific entity edges or episodes by UUID
203	5. Manage the knowledge graph with tools like delete_episode, delete_entity_edge, and clear_graph
204	
205	The server connects to a database for persistent storage and uses language models for certain operations. 
206	Each piece of information is organized by group_id, allowing you to maintain separate knowledge domains.
207	
208	When adding information, provide descriptive names and detailed content to improve search quality. 
209	When searching, use specific queries and consider filtering by group_id for more relevant results.
210	
211	For optimal performance, ensure the database is properly configured and accessible, and valid 
212	API keys are provided for any language model operations.
213	"""
214	
215	
216	# MCP server instance
217	mcp = FastMCP(
218	    'graphiti',
219	    instructions=GRAPHITI_MCP_INSTRUCTIONS,
220	)
221	
222	
223	# Initialize Graphiti client
224	graphiti_client: Optional[Graphiti] = None
225	
226	
227	async def initialize_graphiti(llm_client: Optional[LLMClient] = None, destroy_graph: bool = False):
228	    """Initialize the Graphiti client with the provided settings.
229	
230	    Args:
231	        llm_client: Optional LLMClient instance to use for LLM operations
232	        destroy_graph: Optional boolean to destroy all Graphiti graphs
233	    """
234	    global graphiti_client
235	
236	    # If no client is provided, create a default OpenAI client
237	    if not llm_client:
238	        if config.openai_api_key:
239	            llm_config = LLMConfig(api_key=config.openai_api_key)
240	            if config.openai_base_url:
241	                llm_config.base_url = config.openai_base_url
242	            if config.model_name:
243	                llm_config.model = config.model_name
244	            llm_client = OpenAIClient(config=llm_config)
245	        else:
246	            raise ValueError('OPENAI_API_KEY must be set when not using a custom LLM client')
247	
248	    if not config.neo4j_uri or not config.neo4j_user or not config.neo4j_password:
249	        raise ValueError('NEO4J_URI, NEO4J_USER, and NEO4J_PASSWORD must be set')
250	
251	    graphiti_client = Graphiti(
252	        uri=config.neo4j_uri,
253	        user=config.neo4j_user,
254	        password=config.neo4j_password,
255	        llm_client=llm_client,
256	    )
257	
258	    if destroy_graph:
259	        logger.info('Destroying graph...')
260	        await clear_data(graphiti_client.driver)
261	
262	    # Initialize the graph database with Graphiti's indices
263	    await graphiti_client.build_indices_and_constraints()
264	    logger.info('Graphiti client initialized successfully')
265	
