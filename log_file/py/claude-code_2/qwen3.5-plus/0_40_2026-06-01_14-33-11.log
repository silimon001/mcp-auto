388	# ==================== 工具函数 ====================
389	def add_extra_info(dataset_name: str, repo_id: str) -> str:
390	    """从数据集读取仓库额外信息"""
391	    final_text = ''
392	    repo_info_path = Path.cwd() / "data" / "dataset" / dataset_name / "repo_info.json"
393	    if repo_info_path.exists():
394	        with open(repo_info_path, 'r', encoding='utf-8') as f:
395	            repo_infos = json.load(f)
396	        for repo_info in repo_infos:
397	            if repo_info.get('id') == int(repo_id):
398	                info = {k: repo_info.get(k) for k in ["id", "description", "language", "size", "topic", "html_url"]}
399	                info['owner'] = repo_info.get('full_name').split('/')[0]
400	                info['name'] = repo_info.get('full_name').split('/')[1]
401	                final_text += f'\n=== REPO INFO START ===\n{info}\n=== REPO INFO END ===\n'
402	                break
403	    return final_text
404	
405	
406	# ==================== 主函数 ====================
407	async def main():
408	
409	    test_flag = True
410	
411	    API_KEY = ''
412	
413	    if test_flag:
414	        API_KEY = os.getenv("QWEN_TMP_KEY")
415	    else:
416	        API_KEY = os.getenv("QWEN_MCP_AUTO_KEY")
417	
418	    pos = 0
419	    count = 40
420	
421	    # 初始化配置
422	    model_name = 'qwen3.5-plus'
423	    config = Config(pos, count, model_name, enable_logging=True)
424	    config.set_llm(
425	        model=model_name,
426	        base_url='https://dashscope.aliyuncs.com/compatible-mode/v1',
427	        api_key=API_KEY,
428	        is_streaming=False,
429	        enable_thinking=True
430	    )
431	    config.auto_deploy = True
432	    config.max_chat_loop = 20
433	
434	    # 初始化各组件
435	    logger = Logger(config)
436	    mcp_manager = MCPClientManager(logger)
437	    llm_client = LLMClient(config, logger)
438	    conv_manager = ConversationManager()
439	    prompt_manager = PromptManager(config)
440	
441	    # 连接 MCP 服务器
442	    config_path = Path.cwd() / "MCP-Auto-Server" / "mcp_server_config.json"
443	    with open(config_path, "r", encoding="utf-8") as f:
444	        server_configs = json.load(f)
445	    await mcp_manager.connect_servers(server_configs)
446	    conv_manager.register_tools(mcp_manager.all_tools)
447	
448	    logger.log(f"Based on {model_name}.")
449	
450	    # 读取初始 prompt
451	    init_prompt_path = config.prompt_dir / "prompt_init.md"
452	    with open(init_prompt_path, "r", encoding="utf-8") as f:
453	        init_prompt = f.read()
454	
455	    # 获取待处理的 README 文件列表
456	    readme_dir = Path.cwd() / "data" / "dataset" / dataset_name / "sampled_validated_readme"
457	    readme_files = sorted(glob(str(readme_dir / "*.md")), key=os.path.getsize)
458	
459	    # 创建执行循环实例
460	    loop = ExecutionLoop(config, logger, mcp_manager, llm_client, conv_manager, prompt_manager)
461	
462	    for readme_path in readme_files[pos:pos+count]:
463	        readme_path = Path(readme_path)
464	        filename_parts = readme_path.stem.split('_')
465	        repo_id = filename_parts[0]
466	        repo_name = '_'.join(filename_parts[1:]).replace('_README', '')
467	
468	        with open(readme_path, 'r', encoding='utf-8') as f:
469	            readme_content = f.read()
470	
471	        extra_info = add_extra_info(dataset_name, repo_id)
472	        query = f'''=== README.md START ===\n{readme_content}\n=== README.md END ===\n{extra_info}'''
473	        await loop.run(init_prompt, query, repo_id, str(readme_path))
474	
475	    await mcp_manager.shutdown()
476	
477	
478	if __name__ == '__main__':
479	    asyncio.run(main())

