51	        if os.name == 'nt':
52	            startupinfo = subprocess.STARTUPINFO()
53	            startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW
54	        
55	        cmd = [tool] + args.split()
56	        process = subprocess.Popen(
57	            cmd,
58	            shell=False,  # Security: Prevent shell injection
59	            stdout=subprocess.PIPE,
60	            stderr=subprocess.PIPE,
61	            startupinfo=startupinfo,
62	            encoding='utf-8',
63	            errors='replace'
64	        )
65	        stdout, stderr = process.communicate(timeout=300)  # 5 minute timeout
66	        
67	        return {
68	            'stdout': stdout,
69	            'stderr': stderr,
70	            'returncode': process.returncode
71	        }
72	    except subprocess.TimeoutExpired:
73	        return {'error': 'Command timed out'}
74	    except Exception as e:
75	        return {'error': 'Internal error'}
