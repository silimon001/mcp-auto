267	def format_fact_result(edge: EntityEdge) -> dict[str, Any]:
268	    """Format an entity edge into a readable result.
269	
270	    Since EntityEdge is a Pydantic BaseModel, we can use its built-in serialization capabilities.
271	
272	    Args:
273	        edge: The EntityEdge to format
274	
275	    Returns:
276	        A dictionary representation of the edge with serialized dates and excluded embeddings
277	    """
278	    return edge.model_dump(
279	        mode='json',
280	        exclude={
281	            'fact_embedding',
282	        },
283	    )
284	
285	
286	# Dictionary to store queues for each group_id
287	# Each queue is a list of tasks to be processed sequentially
288	episode_queues: dict[str, asyncio.Queue] = {}
289	# Dictionary to track if a worker is running for each group_id
290	queue_workers: dict[str, bool] = {}
291	
292	
293	async def process_episode_queue(group_id: str):
294	    """Process episodes for a specific group_id sequentially.
295	
296	    This function runs as a long-lived task that processes episodes
297	    from the queue one at a time.
298	    """
299	    global queue_workers
300	
301	    logger.info(f'Starting episode queue worker for group_id: {group_id}')
302	    queue_workers[group_id] = True
303	
304	    try:
305	        while True:
306	            # Get the next episode processing function from the queue
307	            # This will wait if the queue is empty
308	            process_func = await episode_queues[group_id].get()
309	
310	            try:
311	                # Process the episode
312	                await process_func()
313	            except Exception as e:
314	                logger.error(f'Error processing queued episode for group_id {group_id}: {str(e)}')
315	            finally:
316	                # Mark the task as done regardless of success/failure
317	                episode_queues[group_id].task_done()
318	    except asyncio.CancelledError:
319	        logger.info(f'Episode queue worker for group_id {group_id} was cancelled')
320	    except Exception as e:
321	        logger.error(f'Unexpected error in queue worker for group_id {group_id}: {str(e)}')
322	    finally:
323	        queue_workers[group_id] = False
324	        logger.info(f'Stopped episode queue worker for group_id: {group_id}')
325	
