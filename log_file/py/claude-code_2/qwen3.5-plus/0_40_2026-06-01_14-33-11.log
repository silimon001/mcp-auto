80	        api_key = request.headers.get('X-API-Key')
81	        if not api_key or api_key != os.environ.get('API_KEY'):
82	            return jsonify({'error': 'Unauthorized'}), 401
83	        return f(*args, **kwargs)
84	    return decorated_function
