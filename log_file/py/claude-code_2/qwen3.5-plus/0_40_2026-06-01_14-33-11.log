1	"""
2	Nmap MCP Server Package
3	
4	This package provides an MCP (Model Control Protocol) interface for running nmap scans.
5	It allows AI assistants to run network scans and analyze the results.
6	"""
7	
8	__version__ = "0.1.0"
9	
10	from . import server
11	import asyncio
12	
13	def main():
14	    """Main entry point for the package."""
15	    asyncio.run(server.main())
16	
17	# Optionally expose other important items at package level
18	__all__ = ['main', 'server']

