1043	def _load_and_register_entity_module(file_path: Path) -> None:
1044	    """Loads a single Python file, finds, and registers entity classes."""
1045	    module_name = file_path.stem
1046	    full_module_path = str(file_path.absolute())
1047	    
1048	    try:
1049	        # Dynamically import the module
1050	        spec = importlib.util.spec_from_file_location(module_name, full_module_path)
1051	        if spec and spec.loader:
1052	            module = importlib.util.module_from_spec(spec)
1053	            # Add module to sys.modules BEFORE exec_module to handle circular imports if any
1054	            # sys.modules[module_name] = module # Consider if needed, might complicate things
1055	            spec.loader.exec_module(module)
1056	            
1057	            entities_registered = 0
1058	            # Look for BaseModel classes in the module
1059	            for attribute_name in dir(module):
1060	                attribute = getattr(module, attribute_name)
1061	                
1062	                # Check if it's a class, a subclass of BaseModel, not BaseModel itself, and has a docstring
1063	                if (isinstance(attribute, type) and
1064	                    issubclass(attribute, BaseModel) and
1065	                    attribute != BaseModel and
1066	                    attribute.__doc__):
1067	                    
1068	                    # Register the entity
1069	                    register_entity(attribute_name, attribute)
1070	                    entities_registered += 1
1071	                    logger.debug(f"Auto-registered entity: {attribute_name} from {file_path.name}")
1072	            
1073	            if entities_registered > 0:
1074	                 logger.info(f"Successfully loaded module: {file_path.name} (registered {entities_registered} entities)")
1075	            # else:
1076	            #      logger.debug(f"Loaded module {file_path.name}, but found no entities to register.")
1077	
1078	    except Exception as e:
1079	        logger.error(f"Error loading entity module {file_path.name} ({full_module_path}): {str(e)}", exc_info=True)
1080	        # Continue loading other modules
1081	
1082	# --- NEW: Helper function for recursive loading ---
1083	def _load_modules_recursive(base_dir: Path) -> None:
1084	    """Recursively finds and loads Python entity modules from a base directory."""
1085	    logger.info(f"Recursively loading entities from: {base_dir}")
1086	    python_files_found = 0
1087	    for file_path in base_dir.rglob('*.py'):
1088	        if file_path.name.startswith('__'):
1089	            continue  # Skip __init__.py etc.
1090	        python_files_found += 1
1091	        _load_and_register_entity_module(file_path)
