52	@mcp.tool()
53	async def scan_subdomains(target: str, domain_file: bool, threads: int = 4):
54	    """
55	    Scan target domain(s) for subdomains using subfinder binary
56	    
57	    Args:
58	        target: Domain or file containing domains to scan
59	        domain_file: Whether target is a file containing domains
60	        threads: Number of concurrent threads to use
61	    """
62	    command = [
63	        "subfinder",
64	        "-list" if domain_file else "-domain", target,
65	        "-json",
66	        "-all", 
67	        "-silent",
68	        "-active",
69	        "-t", str(threads)
70	    ]
71	    return run_command(command)
