74	async def scan_ports(target: str, file: bool, ports: str = "80,443", top_ports: bool = False, threads: int = 20):
75	    """
76	    Scan a target domain for open ports using naabu binary
77	    
78	    Args:
79	        target: Domain or IP to scan
80	        file: Whether to scan a file containing domains
81	        ports: Port range to scan (e.g. "80,443" or "1-1000") or number of top ports
82	        top_ports: Whether to scan top N ports or use port range
83	        threads: Number of concurrent threads (default: 20)
84	    """
85	    command = [
86	        "naabu",
87	        "-silent",
88	        "-nc", 
