1	import ccxt.async_support as ccxt
2	import asyncio
3	from mcp.server.fastmcp import FastMCP, Context
4	from typing import Dict, List, Optional, Tuple
5	import json
6	import pandas as pd
7	
8	# Initialize FastMCP server
9	mcp = FastMCP("CryptoOrderbookMCP", dependencies=["ccxt", "pandas"])
10	
11	# Supported exchanges
12	SUPPORTED_EXCHANGES = ['binance', 'kraken', 'coinbase', 'bitfinex', 'okx', 'bybit']
13	
14	async def fetch_order_book_data(exchange_id: str, symbol: str, depth_percentage: float, ctx: Context) -> Tuple[Optional[ccxt.Exchange], Optional[Dict], Optional[float], Optional[float], Optional[str]]:
15	    """
16	    Common function to validate inputs, fetch order book, and calculate mid-price and price range.
17	    
18	    Args:
19	        exchange_id: The exchange identifier (e.g., 'binance', 'kraken')
20	        symbol: The trading pair (e.g., 'BTC/USDT')
21	        depth_percentage: Percentage range from mid-price (default: 1.0%)
22	        ctx: MCP context for error reporting
23	    
24	    Returns:
25	        Tuple containing (exchange object, order book, mid_price, price_range, error) or (None, None, None, None, error) on error.
26	    """
27	    # Validate exchange
28	    if exchange_id.lower() not in SUPPORTED_EXCHANGES:
29	        await ctx.error(f"Unsupported exchange: {exchange_id}")
30	        return None, None, None, None, f"Unsupported exchange: {exchange_id}"
31	    
32	    # Validate depth percentage
33	    if depth_percentage <= 0 or depth_percentage > 10:
34	        await ctx.error("Depth percentage must be between 0 and 10")
35	        return None, None, None, None, "Depth percentage must be between 0 and 10"
36	
37	    # Initialize exchange
38	    try:
39	        exchange = getattr(ccxt, exchange_id.lower())()
40	    except AttributeError:
41	        await ctx.error(f"Failed to initialize exchange: {exchange_id}")
42	        return None, None, None, None, f"Failed to initialize exchange: {exchange_id}"
43	
44	    try:
45	        # Validate symbol
46	        try:
47	            markets = await exchange.load_markets()
48	            if symbol not in markets:
49	                await ctx.error(f"Invalid symbol {symbol} for exchange {exchange_id}")
50	                return None, None, None, None, f"Invalid symbol {symbol} for exchange {exchange_id}"
51	        except Exception as e:
52	            await ctx.error(f"Error validating symbol {symbol}: {str(e)}")
53	            return None, None, None, None, f"Error validating symbol {symbol}: {str(e)}"
54	
55	        # Fetch order book
56	        try:
57	            order_book = await exchange.fetch_order_book(symbol, limit=100)
58	        except ccxt.BaseError as e:
59	            await ctx.error(f"Failed to fetch order book for {symbol}: {str(e)}")
60	            return None, None, None, None, f"Failed to fetch order book for {symbol}: {str(e)}"
61	
62	        # Calculate mid-price
63	        bids = order_book.get('bids', [])
64	        asks = order_book.get('asks', [])
65	        if not bids or not asks:
66	            await ctx.error("Empty order book")
67	            return None, None, None, None, "Empty order book"
68	
69	        mid_price = (bids[0][0] + asks[0][0]) / 2
70	        price_range = mid_price * (depth_percentage / 100)
71	
72	        return exchange, order_book, mid_price, price_range, None
73	
74	    except Exception as e:
75	        await ctx.error(f"Error fetching order book data: {str(e)}")
76	        return None, None, None, None, f"Error fetching order book data: {str(e)}"
77	
78	@mcp.tool()
79	async def calculate_orderbook(exchange_id: str, symbol: str, depth_percentage: float = 1.0, ctx: Context = None) -> Dict:
80	    """
81	    Calculate the order book depth and imbalance for a given trading pair on a specified exchange.
82	    
83	    Args:
84	        exchange_id: The exchange identifier (e.g., 'binance', 'kraken')
85	        symbol: The trading pair (e.g., 'BTC/USDT')
86	        depth_percentage: Percentage range from mid-price to calculate depth and imbalance (default: 1.0%)
87	    
88	    Returns:
89	        Dictionary containing bid depth, ask depth, imbalance, mid-price, and timestamp.
90	    """
91	    exchange, order_book, mid_price, price_range, error = await fetch_order_book_data(exchange_id, symbol, depth_percentage, ctx)
92	    
93	    if error:
94	        return {"error": error}
95	
96	    try:
97	        # Calculate depth and imbalance, handling both [price, vol] and [price, vol, 0] formats
98	        bids = order_book.get('bids', [])
99	        asks = order_book.get('asks', [])
100	        bid_volume = sum(entry[1] for entry in bids if len(entry) >= 2 and entry[0] >= mid_price - price_range)
101	        ask_volume = sum(entry[1] for entry in asks if len(entry) >= 2 and entry[0] <= mid_price + price_range)
102	
103	        # Calculate imbalance: (bid_volume - ask_volume) / (bid_volume + ask_volume)
104	        total_volume = bid_volume + ask_volume
105	        if total_volume == 0:
106	            await ctx.error("Zero total volume in order book")
107	            return {"error": "Zero total volume in order book"}
108	
109	        imbalance = (bid_volume - ask_volume) / total_volume
110	
111	        return {
112	            "exchange": exchange_id,
113	            "symbol": symbol,
114	            "bid_depth": bid_volume,
115	            "ask_depth": ask_volume,
116	            "imbalance": imbalance,
117	            "mid_price": mid_price,
118	            "timestamp": order_book['timestamp'] or int(asyncio.get_event_loop().time() * 1000)
119	        }
120	
121	    except Exception as e:
122	        await ctx.error(f"Error calculating order book metrics: {str(e)}")
123	        return {"error": f"Error calculating order book metrics: {str(e)}"}
124	    finally:
125	        if exchange:
126	            await exchange.close()
127	
128	@mcp.tool()
129	async def compare_orderbook(symbol: str, depth_percentage: float = 1.0, exchanges: List[str] = None, ctx: Context = None) -> str:
130	    """
131	    Compare order book depth and imbalance for a trading pair across multiple exchanges, returning a Markdown table.
132	    
133	    Args:
134	        symbol: The trading pair (e.g., 'BTC/USDT')
135	        depth_percentage: Percentage range from mid-price to calculate depth and imbalance (default: 1.0%)
136	        exchanges: List of exchange IDs to compare (default: all supported exchanges)
137	    
138	    Returns:
139	        String containing a Markdown table with exchanges as rows and bid/ask depths and imbalance as columns.
140	    """
141	    # Use all supported exchanges if none specified
142	    exchanges = exchanges or SUPPORTED_EXCHANGES
143	
144	    # Validate inputs
145	    if not exchanges:
146	        await ctx.error("No exchanges specified")
147	        return json.dumps({"error": "No exchanges specified"})
148	
149	    invalid_exchanges = [ex for ex in exchanges if ex.lower() not in SUPPORTED_EXCHANGES]
150	    if invalid_exchanges:
151	        await ctx.error(f"Unsupported exchanges: {invalid_exchanges}")
152	        return json.dumps({"error": f"Unsupported exchanges: {invalid_exchanges}"})
153	
154	    if depth_percentage <= 0 or depth_percentage > 10:
155	        await ctx.error("Depth percentage must be between 0 and 10")
156	        return json.dumps({"error": "Depth percentage must be between 0 and 10"})
157	
158	    results = []
159	    for exchange_id in exchanges:
160	        result = await calculate_orderbook(exchange_id, symbol, depth_percentage, ctx)
161	        if "error" not in result:
162	            results.append(result)
163	
164	    # Create DataFrame for pivot table
165	    if not results:
166	        await ctx.error("No valid order book data retrieved")
167	        return json.dumps({"error": "No valid order book data retrieved"})
168	
169	    df = pd.DataFrame(results)
170	    pivot_table = pd.pivot_table(
171	        df,
172	        values=['bid_depth', 'ask_depth', 'imbalance'],
173	        index='exchange',
174	        aggfunc='first'
175	    )
176	
177	    # Convert pivot table to Markdown
178	    return pivot_table.to_markdown(floatfmt=(".2f", ".2f", ".4f"))
179	
180	if __name__ == "__main__":
181	    # Run the MCP server
182	    mcp.run()
183	    

