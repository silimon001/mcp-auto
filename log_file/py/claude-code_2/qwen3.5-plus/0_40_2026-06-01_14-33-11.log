830	@mcp.resource('http://graphiti/status')
831	async def get_status() -> StatusResponse:
832	    """Get the status of the Graphiti MCP server and Neo4j connection."""
833	    global graphiti_client
834	
835	    if graphiti_client is None:
836	        return {'status': 'error', 'message': 'Graphiti client not initialized'}
837	
838	    try:
839	        # We've already checked that graphiti_client is not None above
840	        assert graphiti_client is not None
841	
842	        # Use cast to help the type checker understand that graphiti_client is not None
843	        client = cast(Graphiti, graphiti_client)
844	
845	        # Test Neo4j connection
846	        await client.driver.verify_connectivity()
