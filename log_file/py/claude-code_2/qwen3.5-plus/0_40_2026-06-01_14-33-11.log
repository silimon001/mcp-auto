93	        "-json"
94	    ]
95	
96	    if file:
97	        command.extend(["-list", str(target)])
98	    else:
99	        command.extend(["-host", str(target)])
100	
101	    if top_ports:
102	        command.extend(["-top-ports", str(ports)])
103	    else:
104	        command.extend(["-port", str(ports)])
105	
106	    return run_command(command)
