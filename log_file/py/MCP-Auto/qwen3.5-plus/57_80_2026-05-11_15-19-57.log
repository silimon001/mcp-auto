@requires_graph_auth
async def search_by_subject(ctx: Context, subject: str, folder_id: str = "inbox") -> str:
    """
    Search for emails by subject

    Args:
        ctx: FastMCP Context
        subject: The subject text to search for
        folder_id: The folder ID to search in (default: inbox)

