e": "string", "description": "The record ID"},\n                    "data": {"type": "object", "description": "The data to update"}\n                },\n                "required": ["entity", "id", "data"]\n            }\n        ),\n        Tool(\n            name="BC_Delete_Item",\n            description="Removes an entity record from Business Central",\n            inputSchema={\n                "type": "object",\n                "properties": {\n                    "entity": {"type": "string", "description": "The entity name"},\n                    "id": {"type": "string", "description": "The record ID to delete"}\n                },\n                "required": ["entity", "id"]\n            }\n        )\n    ]\n\n\n@server.call_tool()\nasync def call_tool(name: str, arguments: dict):\n    """Handle tool calls"""\n    try:\n        if name == "BC_Get_Schema":\n            entity = arguments["entity"]\n            result = make_request("GET", f"{entity}/$metadata")\n            return [TextContent(type="text", text=str(result))]\n        \n        elif name == "BC_List_Items":\n            entity = arguments["entity"]\n            params = {}\n            if "filter" in arguments:\n                params["$filter"] = arguments["filter"]\n            if "top" in arguments:\n                params["$top"] = arguments["top"]\n            result = make_request("GET", entity)\n            return [TextContent(type="text", text=str(result))]\n        \n        elif name == "BC_Get_Items_By_Field":\n            entity = arguments["entity"]\n            field = arguments["field"]\n            value = arguments["value"]\n            filter_expr = f"{field} eq \'{value}\'"\n            result = make_request("GET", entity, data={"$filter": filter_expr})\n            return [TextContent(type="text", text=str(result))]\n        \n        elif name == "BC_Create_Item":\n            entity = arguments["entity"]\n            data = arguments["data"]\n            result = make_request("POST", entity, data=data)\n            return [TextContent(type="text", text=str(result))]\n        \n        elif name == "BC_Update_Item":\n            entity = arguments["entity"]\n            record_id = arguments["id"]\n            data = arguments["data"]\n            result = make_request("PATCH", f"{entity}({record_id})", data=data)\n            return [TextContent(type="text", text=str(result))]\n        \n        elif name == "BC_Delete_Item":\n            entity = arguments["entity"]\n            record_id = arguments["id"]\n            make_request("DELETE", f"{entity}({record_id})")\n            return [TextContent(type="text", text="Record deleted successfully")]\n        \n        else:\n            return [TextContent(type="text", text=f"Unknown tool: {name}")]\n    \n    except Exception as e:\n        return [TextContent(type="text", text=f"Error: {str(e)}")]\n\n\nasync def main():\n    """Main entry point"""\n    async with stdio_server() as (read_stream, write_stream):\n        await server.run(read_stream, write_stream, server.create_initialization_options())\n\n\nif __name__ == "__main__":\n    import asyncio\n    asyncio.run(main())\nEOF', 'timeout_ms': 60000}
