loop 10 | input=6255, output=152, reasoning=0 | Tool=execute_command, Args={'command': 'cat > /home/silimon/MCP-Auto/mcp_server/963838819_Sofias-ai_mcp-business-central-server/mcp_bc_server/__init__.py << \'EOF\'\n"""Business Central MCP Server"""\n__version__ = "0.1.0"\nEOF', 'timeout_ms': 30000}
loop 11 | input=6465, output=1665, reasoning=0 | Tool=execute_command, Args={'command': 'cat > /home/silimon/MCP-Auto/mcp_server/963838819_Sofias-ai_mcp-business-central-server/mcp_bc_server/__main__.py << \'EOF\'\n#!/usr/bin/env python3\n"""Business Central MCP Server - Main Entry Point"""\n\nimport os\nimport sys\nimport requests\nfrom mcp.server import Server\nfrom mcp.server.stdio import stdio_server\nfrom mcp.types import Tool, TextContent\n\n# Environment variables\nBC_URL_SERVER = os.environ.get("BC_URL_SERVER", "")\nBC_USER = os.environ.get("BC_USER", "")\nBC_PASS = os.environ.get("BC_PASS", "")\nBC_COMPANY = os.environ.get("BC_COMPANY", "")\n\n# Create the MCP server\nserver = Server("business-central-server")\n\n\ndef make_request(method, endpoint, data=None):\n    """Make an HTTP request to Business Central API"""\n    url = f"{BC_URL_SERVER}/companies/{BC_COMPANY}/{endpoint}"\n    auth = (BC_USER, BC_PASS)\n    \n    if method == "GET":\n        response = requests.get(url, auth=auth)\n    elif method == "POST":\n        response = requests.post(url, auth=auth, json=data)\n    elif method == "PATCH":\n        response = requests.patch(url, auth=auth, json=data)\n    elif method == "DELETE":\n        response = requests.delete(url, auth=auth)\n    else:\n        raise ValueError(f"Unsupported HTTP method: {method}")\n    \n    response.raise_for_status()\n    return response.json()\n\n\n@server.list_tools()\nasync def list_tools():\n    """List available tools"""\n    return [\n        Tool(\n            name="BC_Get_Schema",\n            description="Retrieves the schema of any Business Central entity including available fields",\n            inputSchema={\n                "type": "object",\n                "properties": {\n                    "entity": {"type": "string", "description": "The entity name (e.g., Customers, Items)"}\n                },\n                "required": ["entity"]\n            }\n        ),\n        Tool(\n            name="BC_List_Items",\n            description="Fetches a list of entities with optional filtering and pagination",\n            inputSchema={\n                "type": "object",\n                "properties": {\n                    "entity": {"type": "string", "description": "The entity name"},\n                    "filter": {"type": "string", "description": "Optional filter expression"},\n                    "top": {"type": "integer", "description": "Number of items to return"}\n                },\n                "required": ["entity"]\n            }\n        ),\n        Tool(\n            name="BC_Get_Items_By_Field",\n            description="Searches for entities based on a specific field value",\n            inputSchema={\n                "type": "object",\n                "properties": {\n                    "entity": {"type": "string", "description": "The entity name"},\n                    "field": {"type": "string", "description": "The field name to search on"},\n                    "value": {"type": "string", "description": "The value to search for"}\n                },\n                "required": ["entity", "field", "value"]\n            }\n        ),\n        Tool(\n            name="BC_Create_Item",\n            description="Creates a new entity record in Business Central",\n            inputSchema={\n                "type": "object",\n                "properties": {\n                    "entity": {"type": "string", "description": "The entity name"},\n                    "data": {"type": "object", "description": "The data to create"}\n                },\n                "required": ["entity", "data"]\n            }\n        ),\n        Tool(\n            name="BC_Update_Item",\n            description="Updates an existing entity record",\n            inputSchema={\n                "type": "object",\n                "properties": {\n                    "entity": {"type": "string", "description": "The entity name"},\n                    "id": {"type": "string", "description": "The record ID"},\n                    "data": {"type": "object", "description": "The data to update"}\n                },\n                "required": ["entity", "id", "data"]\n            }\n        ),\n        Tool(\n            name="BC_Delete_Item",\n            description="Removes an entity record from Business Central",\n            inputSchema={\n                "type": "object",\n                "properties": {\n                    "entity": {"type": "string", "description": "The entity name"},\n                    "id": {"type": "string", "description": "The record ID to delete"}\n                },\n                "required": ["entity", "id"]\n            }\n        )\n    ]\n\n\n@server.call_tool()\nasync def call_tool(name: str, arguments: dict):\n    """Handle tool calls"""\n    try:\n        if name == "BC_Get_Schema":\n            entity = arguments["entity"]\n            result = make_request("GET", f"{entity}/$metadata")\n            return [TextContent(type="text", text=str(result))]\n        \n        elif name == "BC_List_Items":\n            entity = arguments["entity"]\n            params = {}\n            if "filter" in arguments:\n                params["$filter"] = arguments["filter"]\n            if "top" in arguments:\n                params["$top"] = arguments["top"]\n            result = make_request("GET", entity)\n            return [TextContent(type="text", text=str(result))]\n        \n        elif name == "BC_Get_Items_By_Field":\n            entity = arguments["entity"]\n            field = arguments["field"]\n            value = arguments["value"]\n            filter_expr = f"{field} eq \'{value}\'"\n            result = make_request("GET", entity, data={"$filter": filter_expr})\n            return [TextContent(type="text", text=str(result))]\n        \n        elif name == "BC_Create_Item":\n            entity = arguments["entity"]\n            data = arguments["data"]\n            result = make_request("POST", entity, data=data)\n            return [TextContent(type="text", text=str(result))]\n        \n        elif name == "BC_Update_Item":\n            entity = arguments["entity"]\n            record_id = arguments["id"]\n            data = arguments["data"]\n            result = make_request("PATCH", f"{entity}({record_id})", data=data)\n            return [TextContent(type="text", text=str(result))]\n        \n        elif name == "BC_Delete_Item":\n            entity = arguments["entity"]\n            record_id = arguments["id"]\n            make_request("DELETE", f"{entity}({record_id})")\n            return [TextContent(type="text", text="Record deleted successfully")]\n        \n        else:\n            return [TextContent(type="text", text=f"Unknown tool: {name}")]\n    \n    except Exception as e:\n        return [TextContent(type="text", text=f"Error: {str(e)}")]\n\n\nasync def main():\n    """Main entry point"""\n    async with stdio_server() as (read_stream, write_stream):\n        await server.run(read_stream, write_stream, server.create_initialization_options())\n\n\nif __name__ == "__main__":\n    import asyncio\n    asyncio.run(main())\nEOF', 'timeout_ms': 60000}
