1	import { mkdir, readFile, stat, writeFile } from "node:fs/promises";
2	import { homedir } from "node:os";
3	import { dirname, join } from "node:path";
4	import { password } from "@inquirer/prompts";
5	import { decodeSuiPrivateKey } from "@mysten/sui/cryptography";
6	import { Ed25519Keypair } from "@mysten/sui/keypairs/ed25519";
7	import { Secp256k1Keypair } from "@mysten/sui/keypairs/secp256k1";
8	import { Secp256r1Keypair } from "@mysten/sui/keypairs/secp256r1";
9	import keytar from "keytar";
10	import { z } from "zod";
11	const SUI_MCP_SERVICE = "sui-mcp";
12	const SUI_MCP_DIRECTORY = ".sui-mcp";
13	const SuiMCPStateSchema = z.object({
14	    version: z.literal("v1").default("v1"),
15	    service: z.literal("sui-mcp").default("sui-mcp"),
16	    activeAddress: z.string().nullish().default(null),
17	    accounts: z
18	        .array(z.object({
19	        address: z.string(),
20	    }))
21	        .default([]),
22	});
23	function getStatePath() {
24	    return (process.env.SUI_MCP_STATE_PATH ??
25	        join(homedir(), SUI_MCP_DIRECTORY, "state.json"));
26	}
27	const SCHEMA_TO_KEYPAIR_CONSTRUCTOR = {
28	    ED25519: Ed25519Keypair,
29	    Secp256k1: Secp256k1Keypair,
30	    Secp256r1: Secp256r1Keypair,
31	    // Unsuppored keypairs:
32	    MultiSig: null,
33	    ZkLogin: null,
34	    Passkey: null,
35	};
36	export async function createNewAccount() {
37	    let privateKey = await password({
38	        message: "Private Key",
39	        mask: true,
40	    });
41	    if (!privateKey) {
42	        privateKey = Ed25519Keypair.generate().getSecretKey();
43	    }
44	    return await importAccount(privateKey);
45	}
46	export async function importAccount(privateKey) {
47	    const { state } = await getSuiMCPState();
48	    const { schema, secretKey } = decodeSuiPrivateKey(privateKey);
49	    const KeypairConstructor = SCHEMA_TO_KEYPAIR_CONSTRUCTOR[schema];
50	    if (!KeypairConstructor) {
51	        throw new Error(`Unsupported key scheme: ${schema}`);
52	    }
53	    const keypair = KeypairConstructor.fromSecretKey(secretKey);
54	    await keytar.setPassword(SUI_MCP_SERVICE, keypair.toSuiAddress(), privateKey);
55	    state.accounts.push({
56	        address: keypair.toSuiAddress(),
57	    });
58	    state.activeAddress = keypair.toSuiAddress();
59	    await setSuiMCPState(state);
60	    return { address: keypair.toSuiAddress() };
61	}
62	export async function deleteAccount(address) {
63	    const { state } = await getSuiMCPState();
64	    state.accounts = state.accounts.filter((account) => account.address !== address);
65	    if (state.activeAddress === address) {
66	        state.activeAddress = state.accounts[0]?.address ?? null;
67	    }
68	    await keytar.deletePassword(SUI_MCP_SERVICE, address);
69	    await setSuiMCPState(state);
70	}
71	export async function getSuiMCPState() {
72	    const statePath = getStatePath();
73	    try {
74	        if (!(await stat(statePath)).isFile()) {
75	            throw Error("State file does not exist or is not a file");
76	        }
77	    }
78	    catch {
79	        return {
80	            state: SuiMCPStateSchema.parse({}),
81	            exists: false,
82	        };
83	    }
84	    const state = SuiMCPStateSchema.parse(JSON.parse(await readFile(statePath, "utf8")));
85	    return { state, exists: true };
86	}
87	export async function setSuiMCPState(state) {
88	    const statePath = getStatePath();
89	    await mkdir(dirname(statePath), { recursive: true });
90	    await writeFile(statePath, JSON.stringify(state, null, 2));
91	}
92	export async function getKeypair(address) {
93	    const privateKey = await keytar.getPassword(SUI_MCP_SERVICE, address);
94	    if (!privateKey) {
95	        throw new Error(`Private key for address "${address}" not found`);
96	    }
97	    return Ed25519Keypair.fromSecretKey(privateKey);
98	}
99	//# sourceMappingURL=index.js.map

