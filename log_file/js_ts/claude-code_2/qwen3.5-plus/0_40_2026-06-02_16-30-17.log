FHIR resource URI (e.g., Patient/123)\" },\n        },\n        required: [\"uri\"],\n      },\n    },\n  ],\n}));\n\nserver.setRequestHandler(CallToolRequestSchema, async (request) => {\n  const { name, arguments: args } = request.params;\n\n  if (name === \"search_fhir\") {\n    const { resourceType, searchParams } = args as { resourceType: string; searchParams?: Record<string, string> };\n    const result = await fhirRequest(resourceType, searchParams);\n    return { content: [{ type: \"text\", text: JSON.stringify(result, null, 2) }] };\n  }\n\n  if (name === \"read_fhir\") {\n    const { uri } = args as { uri: string };\n    const result = await fhirRequest(uri);\n    return { content: [{ type: \"text\", text: JSON.stringify(result, null, 2) }] };\n  }\n\n  throw new Error(`Unknown tool: ${name}`);\n});\n\nserver.setRequestHandler(ListResourcesRequestSchema, async () => {\n  const capabilityStatement = await fhirRequest(\"metadata\");\n  const resources: Array<{ uri: string; name: string; description: string }> = [];\n  for (const resource of capabilityStatement.rest?.[0]?.resource || []) {\n    resources.push({\n      uri: `fhir://${resource.type}`,\n      name: resource.type,\n      description: `FHIR ${resource.type} resource`,\n    });\n  }\n  return { resources };\n});\n\nserver.setRequestHandler(ReadResourceRequestSchema, async (request) => {\n  const { uri } = request.params;\n  if (!uri.startsWith(\"fhir://\")) {\n    throw new Error(`Invalid URI: ${uri}`);\n  }\n  const resourceType = uri.replace(\"fhir://\", \"\").split(\"/\")[0];\n  const parts = uri.replace(\"fhir://\", \"\").split(\"/\");\n  const result = await fhirRequest(parts.join(\"/\"));\n  return {\n    contents: [{\n      uri,\n      mimeType: \"application/fhir+json\",\n      text: JSON.stringify(result, null, 2),\n    }],\n  };\n});\n\nasync function main() {\n  const transport = new StdioServerTransport();\n  await server.connect(transport);\n  console.error(\"FHIR MCP server running on stdio\");\n}\n\nmain().catch((error) => {\n  console.error(\"Server error:\", error);\n  process.exit(1);\n});\n"
}
