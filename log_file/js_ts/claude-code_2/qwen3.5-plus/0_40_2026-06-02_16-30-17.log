1	import { stat } from "node:fs/promises";
2	import path from "node:path";
3	import { SuiClient, getFullnodeUrl } from "@mysten/sui/client";
4	import fg from "fast-glob";
5	import { z } from "zod";
6	import { logger } from "../logger.js";
7	import { getSuiMCPState } from "../state/index.js";
8	export const optionalAddress = z
9	    .string()
10	    .trim()
11	    .optional()
12	    .describe("The address of the wallet you'd like to use. If empty, defaults to the current wallet.")
13	    .transform(async (address) => {
14	    const { state } = await getSuiMCPState();
15	    if (!address) {
16	        if (!state.activeAddress) {
17	            throw new Error("No address provided and no active address found");
18	        }
19	        return state.activeAddress;
20	    }
21	    return address;
22	});
23	export const optionalNetwork = z
24	    .string()
25	    .trim()
26	    .optional()
27	    .default("testnet")
28	    .describe("The network to use. Must be one of `mainnet`, `testnet`, `devnet`, or `localnet`. If empty, defaults to `testnet`.")
29	    .transform(async (network) => {
30	    if (!network) {
31	        // biome-ignore lint/style/noParameterAssign: Ehhh it's fine.
32	        network = "testnet";
33	    }
34	    if (!["mainnet", "testnet", "devnet", "localnet"].includes(network)) {
35	        throw new Error("Invalid network. Must be one of `mainnet`, `testnet`, `devnet`, or `localnet`");
36	    }
37	    return {
38	        alias: network,
39	        client: new SuiClient({
40	            url: getFullnodeUrl(network),
41	        }),
42	    };
43	});
44	export const moveDirectory = z
45	    .string()
46	    .startsWith("/")
47	    .describe("The directory of the Move package. Must be an absolute path, starting with /")
48	    .transform(async (directory) => {
49	    if (!(await stat(directory)).isDirectory()) {
50	        throw new Error("Directory does not exist");
51	    }
52	    const moveToml = (await fg(["**/Move.toml"], { cwd: directory })).sort((a, b) => a.length - b.length);
53	    if (moveToml.length === 0) {
54	        throw new Error("Move.toml not found");
55	    }
56	    if (moveToml.length > 1) {
57	        logger.warn("Multiple Move.toml files found, using the shortest one");
58	    }
59	    return path.join(directory, path.dirname(moveToml[0]));
60	});
61	//# sourceMappingURL=schema.js.map

