1	import fs from "node:fs/promises";
2	import { homedir } from "node:os";
3	import path from "node:path";
4	import { SIGNATURE_SCHEME_TO_FLAG } from "@mysten/sui/cryptography";
5	import { Ed25519Keypair } from "@mysten/sui/keypairs/ed25519";
6	import { Secp256k1Keypair } from "@mysten/sui/keypairs/secp256k1";
7	import { Secp256r1Keypair } from "@mysten/sui/keypairs/secp256r1";
8	import { fromBase64 } from "@mysten/sui/utils";
9	import yaml from "yaml";
10	import { z } from "zod";
11	const SUI_DIR = ".sui";
12	const SUI_CONFIG_DIR = "sui_config";
13	const SUI_CLIENT_CONFIG = "client.yaml";
14	const SUI_KEYSTORE_FILENAME = "sui.keystore";
15	function getSuiConfigDirectory() {
16	    return (process.env.SUI_CONFIG_DIR || path.join(homedir(), SUI_DIR, SUI_CONFIG_DIR));
17	}
18	const ClientConfigSchema = z.object({
19	    // TODO: Add schema for keystore, once we actually need to process it.
20	    keystore: z.any(),
21	    // NOTE: This omits some fields, but we only care about these ones:
22	    envs: z.array(z.object({ alias: z.string(), rpc: z.string() })),
23	    active_env: z.string(),
24	    active_address: z.string(),
25	});
26	export async function getSuiClientConfig() {
27	    const configDir = getSuiConfigDirectory();
28	    const configPath = path.join(configDir, SUI_CLIENT_CONFIG);
29	    const file = await fs.readFile(configPath, "utf8");
30	    const config = yaml.parse(file);
31	    return ClientConfigSchema.parse(config);
32	}
33	const KEYPAIR_CONSTRUCTORS = {
34	    [SIGNATURE_SCHEME_TO_FLAG.ED25519]: Ed25519Keypair,
35	    [SIGNATURE_SCHEME_TO_FLAG.Secp256k1]: Secp256k1Keypair,
36	    [SIGNATURE_SCHEME_TO_FLAG.Secp256r1]: Secp256r1Keypair,
37	};
38	export async function getSuiClientKeypairs() {
39	    const configDir = getSuiConfigDirectory();
40	    const keystorePath = path.join(configDir, SUI_KEYSTORE_FILENAME);
41	    const keystore = JSON.parse(await fs.readFile(keystorePath, "utf8"));
42	    return keystore.map((key) => {
43	        const bytes = fromBase64(key);
44	        const scheme = bytes[0];
45	        const KeyPair = KEYPAIR_CONSTRUCTORS[scheme];
46	        if (!KeyPair) {
47	            throw new Error(`Unsupported key scheme: ${scheme}`);
48	        }
49	        const kp = KeyPair.fromSecretKey(bytes.slice(1));
50	        return {
51	            address: kp.toSuiAddress(),
52	            secretKey: kp.getSecretKey(),
53	        };
54	    });
55	}
56	export async function hasSuiClientKeypairs() {
57	    try {
58	        const kps = await getSuiClientKeypairs();
59	        return kps.length > 0;
60	    }
61	    catch {
62	        return false;
63	    }
64	}
65	//# sourceMappingURL=suiConfig.js.map

