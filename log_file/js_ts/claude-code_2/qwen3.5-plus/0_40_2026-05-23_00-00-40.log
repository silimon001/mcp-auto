2	import { Hono } from "hono";
3	import { cors } from "hono/cors";
4	import { Octokit } from "octokit";
5	import { clientIdAlreadyApproved, parseRedirectApproval, renderApprovalDialog } from "./workers-oauth-utils";
6	
7	interface Env {
8	  GITHUB_CLIENT_ID: string;
9	  GITHUB_CLIENT_SECRET: string;
10	  COOKIE_ENCRYPTION_KEY: string;
11	  OAUTH_KV: KVNamespace;
12	  OAUTH_PROVIDER: OAuthHelpers;
13	  AI: any;
14	}
15	
16	// Context from the auth flow, encrypted & stored in the auth token
17	// Provided to the DurableMCP as this.props
18	export type Props = {
19	  login: string;
20	  name: string;
21	  email: string;
22	  accessToken: string;
23	  githubId: string;
24	};
