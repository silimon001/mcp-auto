192	  private saveTokensToEnv(): void {
193	    const tokenPath = path.join(__dirname, '..', '..', '.env');
194	    const envContent = fs.existsSync(tokenPath) ? fs.readFileSync(tokenPath, 'utf-8') : '';
195	    const envLines = envContent.split('\n');
196	
197	    const updateEnvVar = (name: string, value: string) => {
198	      const index = envLines.findIndex(line => line.startsWith(`${name}=`));
199	      if (index !== -1) {
200	        envLines[index] = `${name}=${value}`;
201	      } else {
202	        envLines.push(`${name}=${value}`);
203	      }
204	    };
