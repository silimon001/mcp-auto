        },
    };
    async execute({ date }) {
        const url = `https://api.fiscaldata.treasury.gov/services/api/fiscal_service/v1/accounting/dts/operating_cash_balance?filter=record_date:eq:${date}`;
        const response = await this.fetch(url);
        return response.data;
    }
}
