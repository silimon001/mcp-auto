8	config({ path: resolve(process.cwd(), ".env") });
9	
10	// 检查必要的环境变量
11	if (!process.env.FEISHU_APP_ID || !process.env.FEISHU_APP_SECRET) {
12	  console.error("错误: 请设置环境变量 FEISHU_APP_ID 和 FEISHU_APP_SECRET");
