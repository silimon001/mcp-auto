209	    // Atomic write: write to a sibling temp file, then rename. On POSIX rename
210	    // is atomic within the same filesystem, so a crash mid-write cannot leave
211	    // .env half-written or empty.
212	    const tmpPath = `${tokenPath}.tmp.${process.pid}`;
213	    try {
