13	def run_claude_stream(prompt_text: str, json_log_path: str):
14	    """
15	    流式运行 Claude，并实时写 JSONL
16	
17	    修复内容：
18	    1. 收到 result 后立即终止 Claude 进程
19	    2. 避免 readline 永久阻塞
20	    3. 后台线程持续消费 stderr，防止 pipe deadlock
21	    4. 增加超时保护
22	    5. 更稳健的异常处理
23	    """
24	
25	    import threading
26	    import queue
27	
28	    process = subprocess.Popen(
29	        [
30	            "claude-tap",
31	            "--",
32	            "--print",
33	            "--verbose",
34	            "--max-turns", "20",
35	            "--output-format", "stream-json",
36	            "--permission-mode", "bypassPermissions"
37	        ],
38	        stdin=subprocess.PIPE,
39	        stdout=subprocess.PIPE,
40	        stderr=subprocess.PIPE,
41	        text=True,
42	        encoding="utf-8",
43	        bufsize=1
44	    )
45	
