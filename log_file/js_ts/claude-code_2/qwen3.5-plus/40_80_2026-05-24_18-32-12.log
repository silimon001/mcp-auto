1	/**
2	 * @fileoverview Main entry point for the MCP (Model Context Protocol) Cursor integration.
3	 * This file sets up a server that handles code execution requests in isolated workspaces.
4	 * It implements the MCP protocol for communication between Cursor IDE and the execution environment.
5	 */
6	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
7	import { Server } from '@modelcontextprotocol/sdk/server/index.js';
8	import { ListToolsRequestSchema, CallToolRequestSchema } from '@modelcontextprotocol/sdk/types.js';
9	import { CursorInstanceManagerImpl } from './managers/CursorInstanceManager.js';
10	import { CursorToolHandler } from './handlers/CursorToolHandler.js';
11	import { CursorTools } from './tools/cursor-tools.js';
12	async function main() {
13	    const server = new Server({
14	        name: 'cursor-mcp',
15	        version: '1.0.0'
16	    }, {
17	        capabilities: {
18	            tools: {
19	                listChanged: true
20	            }
21	        }
22	    });
23	    const cursorManager = new CursorInstanceManagerImpl();
24	    const toolHandler = new CursorToolHandler(cursorManager);
25	    server.setRequestHandler(ListToolsRequestSchema, () => {
26	        return { tools: CursorTools };
27	    });
28	    server.setRequestHandler(CallToolRequestSchema, async (request) => {
29	        const { name, _meta } = request.params;
30	        const params = request.params.arguments || {};
31	        switch (name) {
32	            case 'open_cursor':
33	                return toolHandler.handleOpenCursor(params);
34	            case 'cursor_command':
35	                return toolHandler.handleCursorCommand(params);
36	            case 'open_cline_tab':
37	                return toolHandler.handleOpenClineTab(params);
38	            default:
39	                throw new Error(`Unknown tool: ${name}`);
40	        }
41	    });
42	    const transport = new StdioServerTransport();
43	    await server.connect(transport);
44	}
45	main().catch(error => {
46	    console.error('Server error:', error);
47	    process.exit(1);
48	});
49	

