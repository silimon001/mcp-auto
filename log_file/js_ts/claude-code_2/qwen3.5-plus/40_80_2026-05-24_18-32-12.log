13	def run_claude_stream(prompt_text: str, json_log_path: str):
14	    """
15	    流式运行 Claude，并实时写 JSONL
16	
17	    修复内容：
18	    1. 收到 result 后立即终止 Claude 进程
19	    2. 避免 readline 永久阻塞
20	    3. 后台线程持续消费 stderr，防止 pipe deadlock
21	    4. 增加超时保护
22	    5. 更稳健的异常处理
23	    """
24	
25	    import threading
26	    import queue
27	
28	    process = subprocess.Popen(
29	        [
30	            "claude",
31	            "--print",
32	            "--verbose",
33	            "--max-turns", "20",
34	            "--output-format", "stream-json",
35	            "--permission-mode", "bypassPermissions"
36	        ],
37	        stdin=subprocess.PIPE,
38	        stdout=subprocess.PIPE,
39	        stderr=subprocess.PIPE,
40	        text=True,
41	        encoding="utf-8",
42	        bufsize=1
43	    )
44	
45	    # =========================
46	    # 输入 prompt
47	    # =========================
48	    process.stdin.write(prompt_text)
49	    process.stdin.close()
50	
51	    events = []
52	    stderr_lines = []
53	
54	    # 用 queue 做线程安全通信
55	    stdout_queue = queue.Queue()
56	    stderr_queue = queue.Queue()
57	
58	    # =========================
59	    # 后台消费 stdout
60	    # =========================
61	    def read_stdout():
62	        try:
63	            for line in iter(process.stdout.readline, ''):
64	                stdout_queue.put(line)
65	        except Exception as e:
66	            stdout_queue.put(f"__ERROR__:{e}")
67	        finally:
68	            stdout_queue.put(None)
69	
70	    # =========================
71	    # 后台消费 stderr
72	    # =========================
73	    def read_stderr():
74	        try:
75	            for line in iter(process.stderr.readline, ''):
76	                stderr_queue.put(line)
77	                stderr_lines.append(line)
78	        except Exception as e:
79	            stderr_queue.put(f"__ERROR__:{e}")
80	        finally:
81	            stderr_queue.put(None)
82	
83	    stdout_thread = threading.Thread(target=read_stdout, daemon=True)
84	    stderr_thread = threading.Thread(target=read_stderr, daemon=True)
85	
86	    stdout_thread.start()
87	    stderr_thread.start()
88	
89	    got_result = False
90	
91	    # =========================
92	    # 主事件循环
93	    # =========================
94	    with open(json_log_path, "a", encoding="utf-8") as jf:
95	
96	        while True:
97	
98	            try:
99	                line = stdout_queue.get(timeout=1)
100	
101	            except queue.Empty:
102	
103	                # 已收到 result，则不再继续等待
104	                if got_result:
105	                    break
106	
107	                # 子进程退出
108	                if process.poll() is not None:
109	                    break
110	
111	                continue
112	
113	            # stdout EOF
114	            if line is None:
115	                break
116	
117	            line = line.strip()
118	
119	            if not line:
120	                continue
121	
122	            try:
123	                obj = json.loads(line)
124	
125	                obj["_received_at"] = datetime.now(
126	                    timezone.utc
127	                ).isoformat()
128	
129	                events.append(obj)
130	
131	                jf.write(
132	                    json.dumps(
133	                        obj,
134	                        ensure_ascii=False
135	                    ) + "\n"
136	                )
137	
138	                # 减少 flush 开销
139	                jf.flush()
140	
141	                # =========================
142	                # 收到最终 result
143	                # =========================
144	                if obj.get("type") == "result":
145	
146	                    got_result = True
147	
148	                    # 非常关键：
149	                    # 不再等待 Claude 主进程自然退出
150	                    try:
151	                        process.terminate()
152	                    except Exception:
153	                        pass
154	
155	                    break
156	
157	            except json.JSONDecodeError:
158	                continue
159	
160	            except Exception as e:
161	                print(f"⚠️ JSON parse error: {e}")
162	
163	    # =========================
164	    # 等待退出
165	    # =========================
166	    try:
167	        process.wait(timeout=5)
168	
169	    except subprocess.TimeoutExpired:
170	
171	        print("⚠️ Claude process timeout, killing...")
172	
173	        try:
174	            process.kill()
175	        except Exception:
176	            pass
177	
178	    # =========================
179	    # 确保线程结束
180	    # =========================
181	    stdout_thread.join(timeout=1)
182	    stderr_thread.join(timeout=1)
183	
184	    stderr = "".join(stderr_lines)
185	
186	    return events, stderr
187	
188	def render_content(obj):
189	    """
190	    把 Claude stream-json content 递归展开成纯 string
191	    """
192	    if obj is None:
193	        return ""
194	
195	    # str
196	    if isinstance(obj, str):
197	        return obj
198	
199	    # dict（核心：Claude node）
200	    if isinstance(obj, dict):
201	        t = obj.get("type")
202	
203	        # tool result wrapper
204	        if t == "text":
205	            return render_content(obj.get("text"))
206	
207	        if t == "tool_result":
208	            return render_content(obj.get("content"))
209	
210	        # fallback：尽量抽取 text
211	        if "text" in obj:
212	            return render_content(obj["text"])
213	
214	        return json.dumps(obj, ensure_ascii=False)
215	
216	    # list（递归 flatten）
217	    if isinstance(obj, list):
218	        return "\n".join(render_content(x) for x in obj)
219	
220	    # fallback
221	    return str(obj)
222	
223	
224	def collect_messages(events):
225	    """聚合事件，记录时间戳，并捕获 result 事件用于总结"""
226	    messages = {}
227	    order = []      # dict(system/user/result) 或 str(assistant msg_id)
228	
229	    for event in events:
230	        etype = event.get("type")
231	        ts = event.get("timestamp") or event.get("_received_at", datetime.now(timezone.utc).isoformat())
232	
233	        # -------- system --------
234	        if etype == "system":
235	            order.append({
236	                "type": "system",
237	                "content": f"[SYSTEM] {event.get('subtype', '')}",
238	                "timestamp": ts
239	            })
240	            continue
241	
242	        # -------- user --------
243	        if etype == "user":
244	            contents = event.get("message", {}).get("content", [])
245	            text = render_content(contents)
246	            order.append({
247	                "type": "user",
248	                "content": text,
249	                "timestamp": ts
250	            })
251	            continue
252	
253	        # -------- result (最终总结) --------
254	        if etype == "result":
255	            order.append({
256	                "type": "result",
257	                "timestamp": ts,
258	                "data": {
259	                    "subtype": event.get("subtype"),
260	                    "is_error": event.get("is_error"),
261	                    "num_turns": event.get("num_turns"),
262	                    "stop_reason": event.get("stop_reason"),
263	                    "total_cost_usd": event.get("total_cost_usd"),
264	                    "duration_ms": event.get("duration_ms"),
265	                    "duration_api_ms": event.get("duration_api_ms"),
266	                    "usage": event.get("usage", {}),
267	                    "errors": event.get("errors", []),
268	                    "terminal_reason": event.get("terminal_reason")
269	                }
270	            })
271	            continue
272	
273	        # -------- assistant --------
274	        if etype == "assistant":
275	            msg = event.get("message", {})
276	            msg_id = msg.get("id")
277	
278	            if msg_id not in messages:
279	                messages[msg_id] = {
280	                    "type": "assistant",
281	                    "texts": [],
282	                    "tools": [],
283	                    "tokens": None,
284	                    "timestamp": ts
285	                }
286	                order.append(msg_id)     # 保证顺序
287	
288	            entry = messages[msg_id]
289	
290	            for c in msg.get("content", []):
291	                ctype = c.get("type")
292	                if ctype == "text":
293	                    entry["texts"].append(c.get("text", ""))
294	                elif ctype == "tool_use":
295	                    entry["tools"].append({
296	                        "name": c.get("name"),
297	                        "input": c.get("input")
298	                    })
299	
300	            if msg.get("usage"):
301	                entry["tokens"] = {
302	                    "input": msg["usage"].get("input_tokens"),
303	                    "output": msg["usage"].get("output_tokens")
304	                }
305	
306	    return messages, order
307	
308	
309	def write_log(messages, order, log_file):
310	    """按轮次和时间戳输出，末尾附加任务结果总结"""
311	    turn = 0
312	    with open(log_file, "a", encoding="utf-8") as f:
313	        for item in order:
314	            # -------- 结果总结（直接输出，不改变轮次）--------
315	            if isinstance(item, dict) and item.get("type") == "result":
316	                ts = item.get("timestamp", "")
317	                data = item["data"]
318	
319	                f.write(f"\n{'=' * 60}\n")
320	                f.write(f"[RESULT] [TIMESTAMP {ts}]\n")
321	                f.write(f"  状态: {'❌ 失败' if data['is_error'] else '✅ 成功'}\n")
322	                f.write(f"  子类型: {data['subtype']}\n")
323	                f.write(f"  实际轮次: {data['num_turns']}\n")
324	                f.write(f"  停止原因: {data['stop_reason']}\n")
325	                f.write(f"  终端原因: {data['terminal_reason']}\n")
326	                f.write(f"  耗时: {data['duration_ms']} ms (API: {data['duration_api_ms']} ms)\n")
327	                f.write(f"  成本: ${data['total_cost_usd']:.6f}\n")
328	
329	                usage = data.get("usage", {})
330	                if usage:
331	                    f.write(f"  Token 使用:\n")
332	                    f.write(f"    - 输入: {usage.get('input_tokens', '?')}\n")
333	                    f.write(f"    - 输出: {usage.get('output_tokens', '?')}\n")
334	                    f.write(f"    - 缓存创建: {usage.get('cache_creation_input_tokens', '?')}\n")
335	                    f.write(f"    - 缓存读取: {usage.get('cache_read_input_tokens', '?')}\n")
336	
337	                errors = data.get("errors", [])
338	                if errors:
339	                    f.write(f"  错误信息:\n")
340	                    for err in errors:
341	                        f.write(f"    - {err}\n")
342	                f.write(f"{'=' * 60}\n")
343	                continue   # result 块输出完毕，跳过后续普通处理
344	
345	            # -------- system / user --------
346	            if isinstance(item, dict):
347	                role = item["type"].upper()
348	                ts = item.get("timestamp", "")
349	                f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
350	                f.write(f"[{role}]:\n{item['content']}\n")
351	                f.write("\n" + "-" * 60 + "\n")
352	                continue
353	
354	            # -------- assistant --------
355	            turn += 1
356	            msg = messages[item]
357	            ts = msg.get("timestamp", "")
358	            f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
359	
360	            text = "\n".join(msg["texts"]).strip()
361	            if text:
362	                f.write(f"[ASSISTANT]:\n{text}\n")
363	
364	            for tool in msg["tools"]:
365	                f.write(f"[ASSISTANT][TOOL]: {tool['name']}\n")
366	                f.write("[TOOL INPUT]:\n")
367	                f.write(json.dumps(tool["input"], indent=2, ensure_ascii=False))
368	                f.write("\n")
369	
370	            if msg["tokens"]:
371	                t = msg["tokens"]
372	                f.write(f"[TOKENS] input={t['input']} output={t['output']}\n")
373	
374	            f.write("\n" + "-" * 60 + "\n")
375	
376	def run_task(prompt_text: str, task_name, pos, count):
377	
378	    json_log_path = f"{LOG_DIR}/tmp_{task_name}.jsonl"
379	
380	    events, stderr = run_claude_stream(
381	        prompt_text,
382	        json_log_path
383	    )
384	
385	    messages, order = collect_messages(events)
386	    log_file = f"{LOG_DIR}/{pos}_{pos+count}_{timestamp}.log"
387	    write_log(messages, order, log_file)
388	
389	    if stderr:
390	        with open(log_file, "a") as f:
391	            f.write("\n[STDERR]\n")
392	            f.write(stderr)
393	
394	    print(f"✅ Done: {log_file}")
395	
