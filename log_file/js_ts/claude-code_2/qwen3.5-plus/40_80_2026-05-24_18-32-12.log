225	def collect_messages(events):
226	    """聚合事件，记录时间戳，并捕获 result 事件用于总结"""
227	    messages = {}
228	    order = []      # dict(system/user/result) 或 str(assistant msg_id)
229	
230	    for event in events:
231	        etype = event.get("type")
232	        ts = event.get("timestamp") or event.get("_received_at", datetime.now(timezone.utc).isoformat())
233	
234	        # -------- system --------
235	        if etype == "system":
236	            order.append({
237	                "type": "system",
238	                "content": f"[SYSTEM] {event.get('subtype', '')}",
239	                "timestamp": ts
240	            })
241	            continue
242	
243	        # -------- user --------
244	        if etype == "user":
245	            contents = event.get("message", {}).get("content", [])
246	            text = render_content(contents)
247	            order.append({
248	                "type": "user",
249	                "content": text,
250	                "timestamp": ts
251	            })
252	            continue
253	
254	        # -------- result (最终总结) --------
255	        if etype == "result":
256	            order.append({
257	                "type": "result",
258	                "timestamp": ts,
259	                "data": {
260	                    "subtype": event.get("subtype"),
261	                    "is_error": event.get("is_error"),
262	                    "num_turns": event.get("num_turns"),
263	                    "stop_reason": event.get("stop_reason"),
264	                    "total_cost_usd": event.get("total_cost_usd"),
265	                    "duration_ms": event.get("duration_ms"),
266	                    "duration_api_ms": event.get("duration_api_ms"),
267	                    "usage": event.get("usage", {}),
268	                    "errors": event.get("errors", []),
269	                    "terminal_reason": event.get("terminal_reason")
270	                }
271	            })
272	            continue
273	
274	        # -------- assistant --------
275	        if etype == "assistant":
276	            msg = event.get("message", {})
277	            msg_id = msg.get("id")
278	
279	            if msg_id not in messages:
280	                messages[msg_id] = {
281	                    "type": "assistant",
282	                    "texts": [],
283	                    "tools": [],
284	                    "tokens": None,
285	                    "timestamp": ts
286	                }
287	                order.append(msg_id)     # 保证顺序
288	
289	            entry = messages[msg_id]
290	
291	            for c in msg.get("content", []):
292	                ctype = c.get("type")
293	                if ctype == "text":
294	                    entry["texts"].append(c.get("text", ""))
295	                elif ctype == "tool_use":
296	                    entry["tools"].append({
297	                        "name": c.get("name"),
298	                        "input": c.get("input")
299	                    })
300	
301	            if msg.get("usage"):
302	                entry["tokens"] = {
303	                    "input": msg["usage"].get("input_tokens"),
304	                    "output": msg["usage"].get("output_tokens")
305	                }
306	
307	    return messages, order
308	
309	
310	def write_log(messages, order, log_file):
311	    """按轮次和时间戳输出，末尾附加任务结果总结"""
312	    turn = 0
313	    with open(log_file, "a", encoding="utf-8") as f:
314	        for item in order:
315	            # -------- 结果总结（直接输出，不改变轮次）--------
316	            if isinstance(item, dict) and item.get("type") == "result":
317	                ts = item.get("timestamp", "")
318	                data = item["data"]
319	
320	                f.write(f"\n{'=' * 60}\n")
321	                f.write(f"[RESULT] [TIMESTAMP {ts}]\n")
322	                f.write(f"  状态: {'❌ 失败' if data['is_error'] else '✅ 成功'}\n")
323	                f.write(f"  子类型: {data['subtype']}\n")
324	                f.write(f"  实际轮次: {data['num_turns']}\n")
325	                f.write(f"  停止原因: {data['stop_reason']}\n")
326	                f.write(f"  终端原因: {data['terminal_reason']}\n")
327	                f.write(f"  耗时: {data['duration_ms']} ms (API: {data['duration_api_ms']} ms)\n")
328	                f.write(f"  成本: ${data['total_cost_usd']:.6f}\n")
329	
330	                usage = data.get("usage", {})
331	                if usage:
332	                    f.write(f"  Token 使用:\n")
333	                    f.write(f"    - 输入: {usage.get('input_tokens', '?')}\n")
334	                    f.write(f"    - 输出: {usage.get('output_tokens', '?')}\n")
335	                    f.write(f"    - 缓存创建: {usage.get('cache_creation_input_tokens', '?')}\n")
336	                    f.write(f"    - 缓存读取: {usage.get('cache_read_input_tokens', '?')}\n")
337	
338	                errors = data.get("errors", [])
339	                if errors:
340	                    f.write(f"  错误信息:\n")
341	                    for err in errors:
342	                        f.write(f"    - {err}\n")
343	                f.write(f"{'=' * 60}\n")
344	                continue   # result 块输出完毕，跳过后续普通处理
345	
346	            # -------- system / user --------
347	            if isinstance(item, dict):
348	                role = item["type"].upper()
349	                ts = item.get("timestamp", "")
350	                f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
351	                f.write(f"[{role}]:\n{item['content']}\n")
352	                f.write("\n" + "-" * 60 + "\n")
353	                continue
354	
355	            # -------- assistant --------
356	            turn += 1
357	            msg = messages[item]
358	            ts = msg.get("timestamp", "")
359	            f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
360	
361	            text = "\n".join(msg["texts"]).strip()
362	            if text:
363	                f.write(f"[ASSISTANT]:\n{text}\n")
364	
365	            for tool in msg["tools"]:
366	                f.write(f"[ASSISTANT][TOOL]: {tool['name']}\n")
367	                f.write("[TOOL INPUT]:\n")
368	                f.write(json.dumps(tool["input"], indent=2, ensure_ascii=False))
369	                f.write("\n")
370	
371	            if msg["tokens"]:
372	                t = msg["tokens"]
373	                f.write(f"[TOKENS] input={t['input']} output={t['output']}\n")
374	
375	            f.write("\n" + "-" * 60 + "\n")
376	
377	def run_task(prompt_text: str, task_name, pos, count):
378	
379	    json_log_path = f"{LOG_DIR}/tmp_{task_name}.jsonl"
380	
381	    events, stderr = run_claude_stream(
382	        prompt_text,
383	        json_log_path
384	    )
385	
386	    messages, order = collect_messages(events)
387	    log_file = f"{LOG_DIR}/{pos}_{pos+count}_{timestamp}.log"
388	    write_log(messages, order, log_file)
389	
390	    if stderr:
391	        with open(log_file, "a") as f:
392	            f.write("\n[STDERR]\n")
393	            f.write(stderr)
394	
395	    print(f"✅ Done: {log_file}")
