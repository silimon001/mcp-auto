189	def render_content(obj):
190	    """
191	    把 Claude stream-json content 递归展开成纯 string
192	    """
193	    if obj is None:
194	        return ""
195	
196	    # str
197	    if isinstance(obj, str):
198	        return obj
199	
200	    # dict（核心：Claude node）
201	    if isinstance(obj, dict):
202	        t = obj.get("type")
203	
204	        # tool result wrapper
205	        if t == "text":
206	            return render_content(obj.get("text"))
207	
208	        if t == "tool_result":
209	            return render_content(obj.get("content"))
210	
211	        # fallback：尽量抽取 text
212	        if "text" in obj:
213	            return render_content(obj["text"])
214	
215	        return json.dumps(obj, ensure_ascii=False)
216	
217	    # list（递归 flatten）
218	    if isinstance(obj, list):
219	        return "\n".join(render_content(x) for x in obj)
220	
221	    # fallback
222	    return str(obj)
223	
