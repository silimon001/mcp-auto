6	 * 
7	 * This script is called by Claude Code hooks and handles:
8	 * - Safety checkpoints before bulk operations
9	 * - Optional changelog integration
10	 * - Smart batching to avoid checkpoint spam
11	 */
12	
13	import { fileURLToPath } from 'url';
14	import { dirname, join } from 'path';
15	import { promises as fsPromises } from 'fs';
16	import CheckpointManager from '../src/lib/checkpoint-manager.js';
17	import { program } from 'commander';
18	import { createRequire } from 'module';
19	
20	const __filename = fileURLToPath(import.meta.url);
21	const __dirname = dirname(__filename);
22	const require = createRequire(import.meta.url);
23	const packageJson = require('../package.json');
24	
25	program
26	  .name('claudepoint-hook')
27	  .description('ClaudePoint hook integration for Claude Code')
28	  .version(packageJson.version);
29	
30	program
31	  .option('--trigger <type>', 'Hook trigger type')
32	  .option('--tool <name>', 'Tool name that triggered the hook')
33	  .option('--debug', 'Enable debug output')
34	  .parse();
35	
36	const options = program.opts();
37	
38	async function logHookAttempt(projectDir, message, isError = false) {
39	  try {
40	    const logFile = join(projectDir, '.claudepoint', 'hooks.log');
41	    const timestamp = new Date().toISOString();
42	    const level = isError ? 'ERROR' : 'INFO';
43	    const logEntry = `[${timestamp}] ${level}: ${message}\n`;
44	    
45	    await fsPromises.appendFile(logFile, logEntry);
46	  } catch (error) {
47	    // Silently fail if logging fails - don't break the hook
48	  }
49	}
