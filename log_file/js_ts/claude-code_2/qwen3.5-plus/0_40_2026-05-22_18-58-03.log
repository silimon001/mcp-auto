96	# ==================== MCP 客户端管理器 ====================
97	class MCPClientManager:
98	    """管理多个 MCP 客户端连接与工具调用"""
99	    def __init__(self, logger: Logger):
100	        self.clients: Dict[str, Client] = {}
101	        self.logger = logger
102	        self.all_tools: List[Tool] = []
103	
104	    async def connect_servers(self, configs: dict):
105	        servers = configs.get("Servers", {})
106	        for name, server_config in servers.items():
107	            client = Client()
108	            try:
109	                await client.init(name, server_config)
110	            except Exception as e:
111	                self.logger.log(str(e), is_error=True)
112	                return
113	            self.clients[name] = client
114	            self.all_tools.extend(client.tools)
115	            self.logger.log(f"Client {name} initialized with tools: {[tool.name for tool in client.tools]}")
116	
117	    async def call_tool(self, server_name: str, tool_name: str, tool_args: dict) -> str:
118	        result = await self.clients[server_name].session.call_tool(tool_name, tool_args)
119	        response = result.content[0].text
120	        if tool_name == 'execute_command':
121	            response = simplify.simplify_log(response)
122	        return response
123	
124	    async def shutdown(self):
125	        for name, client in self.clients.items():
126	            try:
127	                self.logger.log(f"Shutting down client-server connect: {name}")
128	                await client.cleanup()
129	            except Exception as e:
130	                print(f"Error shutting down client-server connect {name}: {e}")
