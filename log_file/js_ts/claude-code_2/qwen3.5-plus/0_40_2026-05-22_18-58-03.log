1	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
2	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
3	import { CallToolRequestSchema, ListToolsRequestSchema, } from "@modelcontextprotocol/sdk/types.js";
4	import dotenv from "dotenv";
5	import { z } from "zod";
6	import { RaindropAPI } from "./lib/raindrop-api.js";
7	import { tools } from "./lib/tools.js";
8	import { CreateBookmarkSchema, SearchBookmarksSchema } from "./types/index.js";
9	dotenv.config();
10	const server = new Server({
11	    name: "raindrop-mcp",
12	    version: "1.0.0",
13	}, {
14	    capabilities: {
15	        tools: {},
16	    },
17	});
18	// ツール一覧の定義
19	server.setRequestHandler(ListToolsRequestSchema, async () => {
20	    return { tools };
21	});
22	// ツール実行のハンドリング
23	server.setRequestHandler(CallToolRequestSchema, async (request) => {
24	    const { name, arguments: args } = request.params;
25	    const token = process.env.RAINDROP_TOKEN;
26	    if (!token) {
27	        throw new Error("RAINDROP_TOKEN is not set");
28	    }
29	    const api = new RaindropAPI(token);
30	    try {
31	        if (name === "create-bookmark") {
32	            const { url, title, tags, collection } = CreateBookmarkSchema.parse(args);
33	            const bookmark = await api.createBookmark({
34	                link: url,
35	                title,
36	                tags,
37	                collection: { $id: collection || 0 },
38	            });
39	            return {
40	                content: [
41	                    {
42	                        type: "text",
43	                        text: `Bookmark created successfully: ${bookmark.item.link}`,
44	                    },
45	                ],
46	            };
47	        }
48	        if (name === "search-bookmarks") {
49	            const { query, tags, page, perpage, sort, collection, word } = SearchBookmarksSchema.parse(args);
50	            const searchParams = new URLSearchParams({
51	                search: query,
52	                ...(tags && { tags: tags.join(",") }),
53	                ...(page !== undefined && { page: page.toString() }),
54	                ...(perpage !== undefined && { perpage: perpage.toString() }),
55	                ...(sort && { sort }),
56	                ...(word !== undefined && { word: word.toString() }),
57	            });
58	            const collectionId = collection ?? 0;
59	            const results = await api.searchBookmarks(collectionId, searchParams);
60	            const formattedResults = results.items
61	                .map((item) => `
62	Title: ${item.title}
63	URL: ${item.link}
64	Tags: ${item.tags?.length ? item.tags.join(", ") : "No tags"}
65	Created: ${new Date(item.created).toLocaleString()}
66	Last Updated: ${new Date(item.lastUpdate).toLocaleString()}
67	---`)
68	                .join("\n");
69	            return {
70	                content: [
71	                    {
72	                        type: "text",
73	                        text: results.items.length > 0
74	                            ? `Found ${results.count} total bookmarks (showing ${results.items.length} on page ${page ?? 0 + 1}):\n${formattedResults}`
75	                            : "No bookmarks found matching your search.",
76	                    },
77	                ],
78	            };
79	        }
80	        if (name === "list-collections") {
81	            const collections = await api.listCollections();
82	            const formattedCollections = collections.items
83	                .map((item) => `
84	Name: ${item.title}
85	ID: ${item._id}
86	Count: ${item.count} bookmarks
87	Parent: ${item.parent?._id || "None"}
88	Created: ${new Date(item.created).toLocaleString()}
89	---`)
90	                .join("\n");
91	            return {
92	                content: [
93	                    {
94	                        type: "text",
95	                        text: collections.items.length > 0
96	                            ? `Found ${collections.items.length} collections:\n${formattedCollections}`
97	                            : "No collections found.",
98	                    },
99	                ],
100	            };
101	        }
102	        throw new Error(`Unknown tool: ${name}`);
103	    }
104	    catch (error) {
105	        if (error instanceof z.ZodError) {
106	            throw new Error(`Invalid arguments: ${error.errors
107	                .map((e) => `${e.path.join(".")}: ${e.message}`)
108	                .join(", ")}`);
109	        }
110	        throw error;
111	    }
112	});
113	// サーバー起動
114	async function main() {
115	    const transport = new StdioServerTransport();
116	    await server.connect(transport);
117	    console.error("Raindrop MCP Server running on stdio");
118	}
119	main().catch((error) => {
120	    console.error("Fatal error in main():", error);
121	    process.exit(1);
122	});
123	

