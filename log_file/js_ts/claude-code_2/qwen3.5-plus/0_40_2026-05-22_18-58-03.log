259	# ==================== 执行循环（状态机） ====================
260	class ExecutionLoop:
261	    """处理单个 README 的完整对话流程"""
262	    def __init__(self, config: Config, logger: Logger, mcp_manager: MCPClientManager,
263	                 llm_client: LLMClient, conv_manager: ConversationManager, prompt_manager: PromptManager):
264	        self.config = config
265	        self.logger = logger
266	        self.mcp_manager = mcp_manager
267	        self.llm_client = llm_client
268	        self.conv_manager = conv_manager
269	        self.prompt_manager = prompt_manager
270	
271	    async def run(self, prompt: str, query: str, readme_id: str, readme_path: str):
272	        """执行主对话循环"""
273	        self.llm_client.communicate_count = 0
274	        self.logger.log(f'Dealing with {readme_id} {readme_path} ...')
275	        self.logger.log(f'\n=========\n{query}\n==========\n')
276	
277	        # 初始化消息
278	        self.conv_manager.messages = []
279	        self.conv_manager.add_system_message(prompt)
280	        self.conv_manager.add_user_message(query)
281	
282	        while True:
283	            if self.llm_client.communicate_count >= self.config.max_chat_loop:
284	                break
285	
286	            # 阶段控制：第一次通信前插入分析 prompt 并设置工具
287	            if self.llm_client.communicate_count == 0:
288	                analyze_prompt = self.prompt_manager.load_prompts(['analyze'])
289	                self.conv_manager.add_system_message(analyze_prompt)
290	                self.conv_manager.set_active_tools(self.prompt_manager.get_tool_names_for_phase('analyze'))
291	
292	            # 调用 LLM
293	            tools = self.conv_manager.get_active_tool_messages()
294	            all_response = self.llm_client.communicate(self.conv_manager.messages, tools)
295	            usage = all_response['usage']
296	            self.logger.log('Token Usage: ' + json.dumps(usage, ensure_ascii=False))
297	
298	            response = all_response['response']
299	            self.conv_manager.add_assistant_message(response)
300	            content = response.get('content', '')
301	            self.logger.log('Response: ' + (content if content else '[tool_calls]'))
302	
303	            # 处理工具调用
304	            if response.get('tool_calls') is not None:
305	                for tool_call in response['tool_calls']:
306	                    tool_name = tool_call['function']['name']
307	                    tool_args = json.loads(tool_call['function']['arguments'])
308	                    server_name = "MCP-Auto"   # 固定服务器名（可根据实际情况调整）
309	                    self.logger.log(f"[Call Tool] Server: {server_name}, Tool: {tool_name}, Args: {tool_args}")
310	
311	                    # 自动化/用户确认逻辑
312	                    tool_validation = False
313	                    call_tool_result, tool_validation = await self._execute_tool_with_policy(
314	                        server_name, tool_name, tool_args, auto=self.config.auto_deploy)
315	
316	                    self.conv_manager.add_tool_result(tool_call['id'], call_tool_result)
317	                    self.logger.log('\n' + call_tool_result + '\n' + '-'*52 + '\n')
318	
319	                    # 根据工具调用结果进行阶段切换
320	                    if tool_validation:
321	                        await self._handle_phase_transition(tool_name, tool_args, call_tool_result)
322	
323	            else:
324	                # 检查任务完成标志
325	                if content and any(marker in content for marker in ["@@Task Done@@", "@@Task Failed@@", "@@Task Alert@@"]):
326	                    break
327	                # 继续对话
328	                self.conv_manager.add_user_message("come on!")
329	
330	    async def _execute_tool_with_policy(self, server_name: str, tool_name: str, tool_args: dict, auto: bool):
331	        """根据自动化策略执行工具调用"""
332	        command = tool_args.get('command', '')
333	        if 'pip ' in command and 'uv ' not in command:
334	            return "Don't use pip, use uv pip instead.", False
335	        if tool_name == 'need_use_these_tools':
336	            def _is_valid_tools_combination(tools: list) -> bool:
337	                """校验 tools 列表是否符合允许的组合"""
338	                if not isinstance(tools, list):
339	                    return False
340	
341	                length = len(tools)
342	                if length == 1:
343	                    return tools[0] in {'node', 'uv', 'none'}
344	                elif length == 2:
345	                    tool_set = set(tools)
346	                    return 'git' in tool_set and ('uv' in tool_set or 'node' in tool_set) and len(tool_set) == 2
347	                elif length == 3:
348	                    tool_set = set(tools)
349	                    return tool_set == {'git', 'uv', 'node'}
350	                else:
351	                    return False
352	            tools = tool_args.get('tools', [])
353	            if not _is_valid_tools_combination(tools):
354	                error_msg = 'tools must be one of: ["git","uv"], ["git","node"], ["node"], ["uv"], ["none"], ["git","uv","node"] (order does not matter)'
355	                return error_msg, False
356	
357	        if auto:
358	            result = await self.mcp_manager.call_tool(server_name, tool_name, tool_args)
359	            return result, True
360	        else:
361	            if input("(Y/N): ").strip().lower() == 'y':
362	                result = await self.mcp_manager.call_tool(server_name, tool_name, tool_args)
363	                return result, True
364	            else:
365	                return "Users refuse to use this tool; please reflect on this and choose the right tool.", False
366	
367	    async def _handle_phase_transition(self, tool_name: str, tool_args: dict, call_tool_result: str):
368	        """根据调用的工具名称切换阶段、插入系统 prompt 和工具集"""
369	        if tool_name == 'need_use_these_tools':
370	            # 进入部署阶段
371	            self.conv_manager.set_active_tools(self.prompt_manager.get_tool_names_for_phase('deploy'))
372	            deploy_prompt = self.prompt_manager.load_prompts(['deploy'])
373	            self.conv_manager.add_system_message(deploy_prompt)
374	            # 动态插入工具说明（原 call_tool_result 内容）
375	            tools_prompt = self.prompt_manager.load_prompts(json.loads(call_tool_result))
376	            self.conv_manager.add_system_message(tools_prompt)
377	
378	        elif tool_name == 'add_config':
379	            self.conv_manager.set_active_tools(self.prompt_manager.get_tool_names_for_phase('validate'))
380	            validate_prompt = self.prompt_manager.load_prompts(['validate'])
381	            self.conv_manager.add_system_message(validate_prompt)
382	
383	        elif tool_name == 'validate_config':
384	            self.conv_manager.set_active_tools(self.prompt_manager.get_tool_names_for_phase('fix'))
385	            # 可以插入额外的用户提示（被注释掉的部分）
