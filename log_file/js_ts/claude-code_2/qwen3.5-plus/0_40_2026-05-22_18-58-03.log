225	# ==================== Prompt 与工具动态管理器 ====================
226	class PromptManager:
227	    """负责从文件加载动态 prompt，并根据工具名返回对应的 prompt 内容"""
228	    def __init__(self, config: Config):
229	        self.config = config
230	
231	    def load_prompts(self, names: List[str]) -> str:
232	        """加载多个 prompt 文件内容并拼接"""
233	        combined = ""
234	        for name in names:
235	            prompt_path = self.config.prompt_dir / f"prompt_{name}.md"
236	            try:
237	                with open(prompt_path, "r", encoding="utf-8") as f:
238	                    content = f.read()
239	                if name == 'git' or name == 'deploy':
240	                    content = content.replace("{WORKSPACE}", str(self.config.cwd))
241	                elif name == 'uv':
242	                    content = content.replace("{HOME}", str(Path.home()))
243	                combined += content
244	            except Exception:
245	                pass
246	        return combined
247	
248	    def get_tool_names_for_phase(self, phase: str) -> List[str]:
249	        """根据阶段返回应激活的工具名称列表"""
250	        phase_tool_map = {
251	            'analyze': ['need_use_these_tools'],
252	            'deploy': ['add_config', 'execute_command'],
253	            'validate': ['validate_config'],
254	            'fix': ['update_and_validate_config', 'execute_command'],
255	        }
256	        return phase_tool_map.get(phase, [])
