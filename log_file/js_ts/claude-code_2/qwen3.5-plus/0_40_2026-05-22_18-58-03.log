5	
6	type RequestOptions = {
7	  method?: string;
8	  body?: unknown;
9	  headers?: Record<string, string>;
10	}
11	
12	async function parseResponseBody(response: Response): Promise<unknown> {
13	  const contentType = response.headers.get("content-type");
14	  if (contentType?.includes("application/json")) {
15	    return response.json();
16	  }
17	  return response.text();
18	}
19	
20	export async function ashraRequest(
21	  url: string,
22	  options: RequestOptions = {}
23	): Promise<unknown> {
24	  const headers: Record<string, string> = {
25	    "Accept": "application/vnd.ashra.v1+json",
26	    "Content-Type": "application/json",
27	    "User-Agent": USER_AGENT,
28	    ...options.headers,
29	  };
30	
31	  const response = await fetch(url, {
32	    method: options.method || "GET",
33	    headers,
34	    body: options.body ? JSON.stringify(options.body) : undefined,
35	  });
36	
37	  const responseBody = await parseResponseBody(response);
38	
39	  if (!response.ok) {
40	    throw createAshraError(response.status, responseBody);
41	  }
42	
