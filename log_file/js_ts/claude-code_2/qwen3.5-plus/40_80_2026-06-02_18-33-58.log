393	def add_extra_info(dataset_name: str, repo_id: str) -> str:
394	    """add repo info"""
395	    final_text = ''
396	    repo_info_path = MAIN_CWD / "data" / "dataset" / dataset_name / "repo_info.json"
397	    if repo_info_path.exists():
398	        with open(repo_info_path, 'r', encoding='utf-8') as f:
399	            repo_infos = json.load(f)
400	        for repo_info in repo_infos:
401	            if repo_info.get('id') == int(repo_id):
402	                info = {k: repo_info.get(k) for k in ["id", "description", "language", "size", "topic", "html_url"]}
403	                info['owner'] = repo_info.get('full_name').split('/')[0]
404	                info['name'] = repo_info.get('full_name').split('/')[1]
405	                final_text += f'\n=== REPO INFO START ===\n{info}\n=== REPO INFO END ===\n'
406	                break
407	    return final_text
