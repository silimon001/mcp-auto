2	import fs from 'fs/promises';
3	import path from 'path';
4	import { existsSync } from 'fs';
5	import { mkdir } from 'fs/promises';
6	import os from 'os';
7	import { VERSION } from './version.js';
8	import { CONFIG_FILE } from './config.js';
9	
10	export interface ServerConfig {
11	  blockedCommands?: string[];
12	  defaultShell?: string;
13	  allowedDirectories?: string[];
14	  fileWriteLineLimit?: number; // Line limit for file write operations
15	  fileReadLineLimit?: number; // Default line limit for file read operations (changed from character-based)
16	  clientId?: string; // Unique client identifier for analytics
17	  currentClient?: ClientInfo; // Current connected client information
18	  [key: string]: any; // Allow for arbitrary configuration keys
19	}
20	
21	export interface ClientInfo {
22	  name: string;
23	  version: string;
24	}
25	
26	/**
27	 * Singleton config manager for the server
28	 */
29	class ConfigManager {
30	  private configPath: string;
31	  private config: ServerConfig = {};
32	  private initialized = false;
33	
34	  constructor() {
35	    // Get user's home directory
36	    // Define config directory and file paths
37	    this.configPath = CONFIG_FILE;
38	  }
39	
40	  /**
41	   * Initialize configuration - load from disk or create default
42	   */
43	  async init() {
44	    if (this.initialized) return;
45	
46	    try {
47	      // Ensure config directory exists
48	      const configDir = path.dirname(this.configPath);
49	      if (!existsSync(configDir)) {
50	        await mkdir(configDir, { recursive: true });
51	      }
52	
53	      // Check if config file exists
54	      try {
55	        await fs.access(this.configPath);
56	        // Load existing config
57	        const configData = await fs.readFile(this.configPath, 'utf8');
58	        this.config = JSON.parse(configData);
59	      } catch (error) {
60	        // Config file doesn't exist, create default
61	        this.config = this.getDefaultConfig();
62	        await this.saveConfig();
63	      }
64	      this.config['version'] = VERSION;
65	
66	      this.initialized = true;
67	    } catch (error) {
68	      console.error('Failed to initialize config:', error);
69	      // Fall back to default config in memory
70	      this.config = this.getDefaultConfig();
71	      this.initialized = true;
72	    }
73	  }
74	
75	  /**
76	   * Alias for init() to maintain backward compatibility
77	   */
78	  async loadConfig() {
79	    return this.init();
80	  }
81	
82	  /**
83	   * Create default configuration
84	   */
85	  private getDefaultConfig(): ServerConfig {
86	    return {
87	      blockedCommands: [
88	
89	        // Disk and partition management
90	        "mkfs",      // Create a filesystem on a device
91	        "format",    // Format a storage device (cross-platform)
92	        "mount",     // Mount a filesystem
93	        "umount",    // Unmount a filesystem
94	        "fdisk",     // Manipulate disk partition tables
95	        "dd",        // Convert and copy files, can write directly to disks
96	        "parted",    // Disk partition manipulator
97	        "diskpart",  // Windows disk partitioning utility
98	        
99	        // System administration and user management
100	        "sudo",      // Execute command as superuser
101	        "su",        // Substitute user identity
102	        "passwd",    // Change user password
103	        "adduser",   // Add a user to the system
104	        "useradd",   // Create a new user
105	        "usermod",   // Modify user account
106	        "groupadd",  // Create a new group
107	        "chsh",      // Change login shell
108	        "visudo",    // Edit the sudoers file
109	        
110	        // System control
111	        "shutdown",  // Shutdown the system
112	        "reboot",    // Restart the system
113	        "halt",      // Stop the system
114	        "poweroff",  // Power off the system
115	        "init",      // Change system runlevel
116	        
117	        // Network and security
118	        "iptables",  // Linux firewall administration
119	        "firewall",  // Generic firewall command
120	        "netsh",     // Windows network configuration
121	        
122	        // Windows system commands
123	        "sfc",       // System File Checker
124	        "bcdedit",   // Boot Configuration Data editor
125	        "reg",       // Windows registry editor
126	        "net",       // Network/user/service management
127	        "sc",        // Service Control manager
128	        "runas",     // Execute command as another user
129	        "cipher",    // Encrypt/decrypt files or wipe data
130	        "takeown"    // Take ownership of files
131	      ],
132	      defaultShell: (() => {
133	        if (os.platform() === 'win32') {
134	          return 'powershell.exe';
135	        }
136	        // Use user's actual shell from environment, or fall back to /bin/sh
137	        const userShell = process.env.SHELL || '/bin/sh';
138	        // Return just the shell path - we'll handle login shell flag elsewhere
139	        return userShell;
140	      })(),
141	      allowedDirectories: [],
142	      fileWriteLineLimit: 50,  // Default line limit for file write operations (changed from 100)
143	      fileReadLineLimit: 1000  // Default line limit for file read operations (changed from character-based)
144	    };
145	  }
146	
147	  /**
148	   * Save config to disk
149	   */
150	  private async saveConfig() {
151	    try {
152	      await fs.writeFile(this.configPath, JSON.stringify(this.config, null, 2), 'utf8');
153	    } catch (error) {
154	      console.error('Failed to save config:', error);
155	      throw error;
156	    }
157	  }
158	
159	  /**
160	   * Get the entire config
161	   */
162	  async getConfig(): Promise<ServerConfig> {
163	    await this.init();
164	    return { ...this.config };
165	  }
166	
167	  /**
168	   * Get a specific configuration value
169	   */
170	  async getValue(key: string): Promise<any> {
171	    await this.init();
172	    return this.config[key];
173	  }
174	
175	  /**
176	   * Set a specific configuration value
177	   */
178	  async setValue(key: string, value: any): Promise<void> {
179	    await this.init();
180	  
181	    // Update the value
182	    this.config[key] = value;
183	    await this.saveConfig();
184	  }
185	
186	  /**
187	   * Update multiple configuration values at once
188	   */
189	  async updateConfig(updates: Partial<ServerConfig>): Promise<ServerConfig> {
190	    await this.init();
191	    this.config = { ...this.config, ...updates };
192	    await this.saveConfig();
193	    return { ...this.config };
194	  }
195	
196	  /**
197	   * Reset configuration to defaults
198	   */
199	  async resetConfig(): Promise<ServerConfig> {
200	    this.config = this.getDefaultConfig();
201	    await this.saveConfig();
202	    return { ...this.config };
203	  }
204	}
205	
206	// Export singleton instance
207	export const configManager = new ConfigManager();

