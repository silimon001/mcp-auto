2	import asyncio
3	import os
4	import json
5	from dotenv import load_dotenv
6	
7	from MCP_Client import Client
8	
9	async def test_server(name, config: dict):
10	    client = Client()
11	    try:
12	        await client.init(name, config)
13	        tools_str = ", ".join(t.name for t in client.tools)
14	        if tools_str == '':
15	            print(f"\n[Warning] The server {name} started successfully, but no tools were found.", flush=True)
16	        else:
17	            print(f"\n[OK] The server {name} started successfully, tools: {tools_str}\n", flush=True)
18	    except asyncio.CancelledError:
19	        print(f"[WARN] The server {name} init cancelled")
20	    except Exception as e:
21	        print(str(e))
22	    finally:
23	        await client.cleanup()
24	
25	
26	def normalize_key(key: str) -> str:
27	    return (
28	        key.lower()
29	        .replace("_", "")
30	        .replace("-", "")
31	        .replace(" ", "")
32	    )
33	
34	
35	def looks_like_server_config(obj: dict) -> bool:
36	    """
37	    判断是否像单个 MCP server 配置
38	    """
39	    return any(
40	        key in obj
41	        for key in ("command", "url", "transport")
42	    )
43	
44	
45	async def main(path: str, name: str):
46	    config_path = os.path.join(path)
47	
48	    with open(config_path, "r", encoding="utf-8") as f:
49	        configs = json.load(f)
50	
51	    if not isinstance(configs, dict):
52	        print("Invalid config format.")
53	        return
54	
55	    normalized = {
56	        normalize_key(k): v
57	        for k, v in configs.items()
58	    }
59	
60	    # 1. 标准格式
61	    servers = (
62	        normalized.get("servers")
63	        or normalized.get("mcpservers")
64	    )
65	
66	    # 2. fallback:
67	    #    整个文件本身就是 server map
68	    if servers is None:
69	        if all(
70	            isinstance(v, dict)
71	            for v in configs.values()
72	        ):
73	            servers = configs
74	
75	    # 3. fallback:
76	    #    整个文件本身是单个 server config
77	    if servers is None and looks_like_server_config(configs):
78	        servers = {
79	            name: configs
80	        }
81	
82	    if not isinstance(servers, dict):
83	        print("No server configuration found.")
84	        return
85	
86	    if name in servers:
87	        await test_server(name, servers[name])
88	    else:
89	        print(f"The server {name} does not exist.")
90	
91	
92	if __name__ == "__main__":
93	
94	    import sys
95	    if len(sys.argv) != 3:
96	        print("Usage: python script.py  <config_filename> <server_name>")
97	        sys.exit(1)
98	
99	    config_path = str(sys.argv[1])
100	    name = str(sys.argv[2])
101	
102	    anyio.run(lambda: main(config_path, name))
