302	// Initialize server first - this is now synchronous
303	initializeServer();
304	
305	// Handle incoming JSON-RPC messages via stdio
306	rl.on('line', async (line) => {
307	  try {
308	    // Debug log for received message
309	    sendLogMessage('debug', 'Received message', { length: line.length });
310	    debugLog('Received raw message', { message: line });
311	    
312	    let message;
313	    try {
314	      message = JSON.parse(line);
315	      debugLog('Parsed message', message);
316	    } catch (error) {
317	      sendLogMessage('error', 'Failed to parse JSON', { error: error.message, line });
318	      debugLog('Failed to parse JSON', { error: error.message, line });
319	      // Don't respond to parse errors - it could confuse clients
320	      return;
321	    }
322	    
323	    const { jsonrpc, id, method, params = {} } = message;
324	
325	    // No response for messages without ID - they are notifications
326	    if (id === undefined || id === null) {
327	      if (method === 'initialized' || method === 'notifications/initialized') {
328	        sendLogMessage('info', 'Received initialized notification');
329	        debugLog('Received initialized notification', { method });
330	        hasReceivedInitializedNotification = true;
331	      } else {
332	        sendLogMessage('info', `Received notification: ${method}`);
333	        debugLog('Received notification', { method });
334	      }
335	      return;
336	    }
337	
338	    if (jsonrpc !== "2.0") {
339	      const error = {
340	        code: -32600,
341	        message: "Invalid Request: jsonrpc version must be 2.0"
342	      };
343	      process.stdout.write(JSON.stringify({
344	        jsonrpc: "2.0",
345	        id, // Use the exact same ID from the request
346	        error
347	      }) + '\n');
348	      return;
349	    }
350	
351	    // Special handling for initialization sequence
352	    if (method === 'initialize') {
353	      debugLog('Received initialize request', { params, id });
354	      
355	      if (isInitialized) {
356	        debugLog('Server already initialized, rejecting request', { id });
357	        const error = {
358	          code: -32002,
359	          message: "Server already initialized"
360	        };
361	        process.stdout.write(JSON.stringify({
362	          jsonrpc: "2.0",
363	          id,
364	          error
365	        }) + '\n');
366	        return;
367	      }
368	
369	      // Log client capabilities for debugging
370	      sendLogMessage('info', 'Processing initialize request', {
371	        clientInfo: params.clientInfo,
372	        clientCapabilities: params.capabilities,
373	        clientProtocolVersion: params.protocolVersion
374	      });
375	
376	      // Log the protocol version
377	      debugLog("Client protocol version", { version: params.protocolVersion });
378	      
379	      // Accept any protocol version for now
380	      // Cursor is using a date-based version scheme "2024-11-05" rather than the expected "1.x.x"
381	
382	      // Log environment variables for debugging
383	      debugLog("Environment variables for initialization", {
384	        MCP_SERVER_NAME: process.env.MCP_SERVER_NAME,
385	        MCP_SERVER_VERSION: process.env.MCP_SERVER_VERSION,
386	        NODE_ENV: process.env.NODE_ENV
387	      });
388	
389	      // Server info and capabilities
390	      const serverInfo = {
391	        name: CONFIG.server.name,
392	        version: CONFIG.server.version,
393	        displayName: CONFIG.server.displayName,
394	        description: CONFIG.server.description,
395	        publisher: CONFIG.server.publisher
396	      };
397	      
398	      // Log server info for debugging
399	      debugLog("Responding with server info", serverInfo);
400	
401	      // Respond with server capabilities
402	      const response = {
403	        jsonrpc: "2.0",
404	        id, // Use the exact ID from the request
405	        result: {
406	          serverInfo: serverInfo,
407	          capabilities: {
408	            tools: {
409	              listChanged: false
410	            },
411	            resources: {
412	              listChanged: false,
413	              subscribe: false
414	            },
415	            prompts: {
416	              listChanged: false
417	            },
418	            logging: {
419	              levels: CONFIG.logging.levels
420	            }
421	          },
422	          protocolVersion: CONFIG.server.protocolVersion
423	        }
424	      };
425	
426	      // Log the complete response for debugging
427	      debugLog("Sending complete initialization response", response);
428	      
429	      // Send initialization response
430	      process.stdout.write(JSON.stringify(response) + '\n');
431	      isInitialized = true;
432	      sendLogMessage('info', 'Server initialized successfully');
433	      return;
434	    }
435	
436	    // All other messages require initialization
437	    if (!isInitialized) {
438	      const error = {
439	        code: -32002,
440	        message: "Server not initialized"
441	      };
442	      process.stdout.write(JSON.stringify({
443	        jsonrpc: "2.0",
444	        id, // Use the exact ID from the request
445	        error
446	      }) + '\n');
447	      return;
448	    }
449	
450	    // Handle standard MCP method requests
451	    debugLog('Processing method', { method, id });
452	    
453	    switch (method) {
454	      case 'listTools':
455	      case 'tools/list':
456	        // Return all available tools
457	        debugLog('Processing tools list request', { id });
458	        const tools = [
459	          {
460	            name: "memory.create",
461	            description: "Create a new memory entry",
462	            inputSchema: {
463	              type: "object",
464	              required: ["type", "content", "source", "confidence"],
465	              properties: {
466	                type: { type: "string", description: "Type of memory" },
467	                content: { type: "object", description: "Content to store" },
468	                source: { type: "string", description: "Source of the memory" },
469	                tags: { type: "array", items: { type: "string" }, description: "Optional tags" },
470	                confidence: { type: "number", description: "Confidence score between 0 and 1" }
471	              }
472	            }
473	          },
474	          {
475	            name: "memory.search",
476	            description: "Search for memories using semantic similarity",
477	            inputSchema: {
478	              type: "object",
479	              required: ["query"],
480	              properties: {
481	                query: { type: "string", description: "Search query" },
482	                type: { type: "string", description: "Optional type filter" },
483	                tags: { type: "array", items: { type: "string" }, description: "Optional tags filter" },
484	                limit: { type: "number", description: "Maximum number of results to return" }
485	              }
486	            }
487	          },
488	          {
489	            name: "memory.list",
490	            description: "List all memories",
491	            inputSchema: {
492	              type: "object",
493	              properties: {
494	                type: { type: "string", description: "Optional type filter" },
495	                tags: { type: "array", items: { type: "string" }, description: "Optional tags filter" }
496	              }
497	            }
498	          }
499	        ];
500	        // Format response according to MCP 2.0 protocol
501	        const toolsResponse = {
502	          jsonrpc: "2.0",
503	          id,
504	          result: {
505	            tools: tools
506	          }
507	        };
508	        
509	        debugLog('Sending tools response', toolsResponse);
510	        process.stdout.write(JSON.stringify(toolsResponse) + '\n');
511	        break;
512	
513	      case 'callTool':
514	      case 'tools/call':
515	        debugLog('Processing tool call', { method, id, params });
516	        // In the new protocol, arguments might be in params.input instead of params.arguments
517	        const toolName = params.name;
518	        const toolArgs = params.arguments || params.input || {};
519	        
520	        debugLog('Tool call details', { toolName, toolArgs });
521	        
522	        const name = toolName;
523	
524	        switch (name) {
525	          case 'memory.create':
526	            try {
527	              // Ensure database is initialized before creating memories
528	              if (!dbInitialized) {
529	                await initializeDatabase();
530	              }
531	              
532	              sendLogMessage('info', 'Creating new memory', { type: toolArgs.type });
533	              const { type, content, source, tags = [], confidence } = toolArgs;
534	              const textForEmbedding = prepareContentForEmbedding(content);
535	              const embedding = await generateEmbedding(textForEmbedding);
536	
537	              const query = `
538	                INSERT INTO memories (type, content, source, embedding, tags, confidence)
539	                VALUES ($1, $2::jsonb, $3, $4::vector, $5, $6)
540	                RETURNING *
541	              `;
542	
543	              const dbResult = await pool.query(query, [
544	                type,
545	                JSON.stringify(content),
546	                source,
547	                `[${embedding.join(',')}]`,
548	                tags,
549	                confidence
550	              ]);
551	
552	              sendLogMessage('info', 'Memory created successfully', { id: dbResult.rows[0].id });
553	              // Format response for tool call
554	              const createResponse = {
555	                jsonrpc: "2.0",
556	                id,
557	                result: {
558	                  tool: {
559	                    name: "memory.create",
560	                    output: dbResult.rows[0]
561	                  }
562	                }
563	              };
564	              
565	              debugLog('Sending memory create response', createResponse);
566	              process.stdout.write(JSON.stringify(createResponse) + '\n');
567	            } catch (error) {
568	              sendLogMessage('error', 'Failed to create memory', { error: error.message });
569	              process.stdout.write(JSON.stringify({
570	                jsonrpc: "2.0",
571	                id,
572	                error: {
573	                  code: -32000,
574	                  message: error.message
575	                }
576	              }) + '\n');
577	            }
578	            break;
579	
580	          case 'memory.search':
581	            try {
582	              // Ensure database is initialized before searching memories
583	              if (!dbInitialized) {
584	                await initializeDatabase();
585	              }
586	              
587	              const { query, type, tags, limit = CONFIG.search.defaultLimit } = toolArgs;
588	              sendLogMessage('info', 'Searching memories', { query, type, tags, limit });
589	              
590	              const embedding = await generateEmbedding(query);
591	              
592	              let sqlQuery = `
593	                SELECT *, 
594	                  1 - (embedding <=> $1::vector) as similarity
595	                FROM memories
596	                WHERE 1=1
597	              `;
598	              
599	              const queryParams = [`[${embedding.join(',')}]`];
600	              let paramCount = 1;
601	
602	              if (type) {
603	                paramCount++;
604	                sqlQuery += ` AND type = $${paramCount}`;
605	                queryParams.push(type);
606	              }
607	
608	              if (tags && tags.length > 0) {
609	                paramCount++;
610	                sqlQuery += ` AND tags && $${paramCount}`;
611	                queryParams.push(Array.isArray(tags) ? tags : tags.split(','));
612	              }
613	
614	              sqlQuery += `
615	                ORDER BY similarity DESC
616	                LIMIT $${paramCount + 1}
617	              `;
618	              queryParams.push(parseInt(limit));
619	
620	              const dbResult = await pool.query(sqlQuery, queryParams);
621	              sendLogMessage('info', 'Search completed', { resultCount: dbResult.rows.length });
622	              
623	              // Format response for search tool
624	              const searchResponse = {
625	                jsonrpc: "2.0",
626	                id,
627	                result: {
628	                  tool: {
629	                    name: "memory.search",
630	                    output: dbResult.rows
631	                  }
632	                }
633	              };
634	              
635	              debugLog('Sending memory search response', searchResponse);
636	              process.stdout.write(JSON.stringify(searchResponse) + '\n');
637	            } catch (error) {
638	              sendLogMessage('error', 'Search failed', { error: error.message });
639	              process.stdout.write(JSON.stringify({
640	                jsonrpc: "2.0",
641	                id,
642	                error: {
643	                  code: -32000,
644	                  message: error.message
645	                }
646	              }) + '\n');
647	            }
648	            break;
649	
650	          case 'memory.list':
651	            try {
652	              // Ensure database is initialized before listing memories
653	              if (!dbInitialized) {
654	                await initializeDatabase();
655	              }
656	              
657	              const { type, tags } = toolArgs || {};
658	              
659	              let sqlQuery = 'SELECT * FROM memories WHERE 1=1';
660	              const queryParams = [];
661	              let paramCount = 0;
662	
663	              if (type) {
664	                paramCount++;
665	                sqlQuery += ` AND type = $${paramCount}`;
666	                queryParams.push(type);
667	              }
668	
669	              if (tags && tags.length > 0) {
670	                paramCount++;
671	                sqlQuery += ` AND tags && $${paramCount}`;
672	                queryParams.push(Array.isArray(tags) ? tags : tags.split(','));
673	              }
674	
675	              sqlQuery += ' ORDER BY created_at DESC';
676	
677	              const dbResult = await pool.query(sqlQuery, queryParams);
678	              
679	              // Format response for list tool
680	              const listResponse = {
681	                jsonrpc: "2.0",
682	                id,
683	                result: {
684	                  tool: {
685	                    name: "memory.list",
686	                    output: dbResult.rows
687	                  }
688	                }
689	              };
690	              
691	              debugLog('Sending memory list response', listResponse);
692	              process.stdout.write(JSON.stringify(listResponse) + '\n');
693	            } catch (error) {
694	              sendLogMessage('error', `Error in memory.list: ${error.message}`);
695	              process.stdout.write(JSON.stringify({
696	                jsonrpc: "2.0",
697	                id,
698	                error: {
699	                  code: -32000,
700	                  message: error.message
701	                }
702	              }) + '\n');
703	            }
704	            break;
705	
706	          default:
707	            sendLogMessage('warn', 'Tool not found', { tool: name });
708	            process.stdout.write(JSON.stringify({
709	              jsonrpc: "2.0",
710	              id,
711	              error: {
712	                code: -32601,
713	                message: "Tool not found"
714	              }
715	            }) + '\n');
716	        }
717	        break;
718	
719	      case 'listResources':
720	      case 'resources/list':
721	        try {
722	          debugLog('Processing resources list request', { id });
723	          const resources = await handleListResources();
724	          const resourcesResponse = {
725	            jsonrpc: "2.0",
726	            id,
727	            result: {
728	              resources: resources
729	            }
730	          };
731	          
732	          debugLog('Sending resources response', resourcesResponse);
733	          process.stdout.write(JSON.stringify(resourcesResponse) + '\n');
734	        } catch (error) {
735	          sendLogMessage('error', 'Error listing resources', { error: error.message });
736	          process.stdout.write(JSON.stringify({
737	            jsonrpc: "2.0",
738	            id,
739	            error: {
740	              code: -32000,
741	              message: error.message
742	            }
743	          }) + '\n');
744	        }
745	        break;
746	
747	      case 'readResource':
748	      case 'resources/read':
749	        try {
750	          const { name: resourceName } = params;
751	          const { content, mimeType } = await handleReadResource(resourceName);
752	          const readResponse = {
753	            jsonrpc: "2.0",
754	            id,
755	            result: { 
756	              resource: {
757	                content, 
758	                mimeType
759	              }
760	            }
761	          };
762	          
763	          debugLog('Sending resource read response', readResponse);
764	          process.stdout.write(JSON.stringify(readResponse) + '\n');
765	        } catch (error) {
