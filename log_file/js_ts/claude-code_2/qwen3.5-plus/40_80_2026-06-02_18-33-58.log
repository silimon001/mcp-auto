161	// Helper function to prepare content for embedding
162	function prepareContentForEmbedding(content) {
163	  if (typeof content === 'string') return content;
164	  return JSON.stringify(content);
165	}
166	
167	// Helper function to generate embeddings
168	async function generateEmbedding(text) {
169	  try {
170	    const model = await getEmbedder();
171	    const output = await model(text, { pooling: 'mean', normalize: true });
172	    sendLogMessage('debug', 'Generated embedding', { textLength: text.length });
173	    return Array.from(output.data);
174	  } catch (error) {
175	    sendLogMessage('error', 'Failed to generate embedding', { error: error.message });
176	    throw error;
177	  }
178	}
