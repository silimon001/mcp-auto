409	def normalize_model_name(name: str) -> str:
410	    """
411	    将:
412	        qwen3.5-plus-2026-04-20
413	    归一化为:
414	        qwen3.5-plus
415	    """
416	
417	    return re.sub(r"-\d{4}-\d{2}-\d{2}$", "", name)
