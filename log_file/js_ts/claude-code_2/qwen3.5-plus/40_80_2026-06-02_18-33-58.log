50	// Function to write debug logs to file
51	function debugLog(message, data = {}) {
52	  const timestamp = new Date().toISOString();
53	  const logEntry = `[${timestamp}] ${message} ${JSON.stringify(data, null, 2)}\n`;
54	  try {
55	    fs_sync.appendFileSync(DEBUG_LOG_PATH, logEntry);
56	  } catch (error) {
57	    console.error(`Failed to write to debug log: ${error.message}`);
58	  }
