90	// Initialize BERT model for embeddings
91	let embedder;
92	let embedderInitializing = false;
93	let dbInitialized = false;
94	
95	// Helper function for MCP logging
96	function sendLogMessage(level, message, context = {}) {
97	  const logMessage = {
98	    jsonrpc: "2.0",
99	    method: "log",
100	    params: {
101	      level,
102	      message,
103	      timestamp: new Date().toISOString(),
104	      context
105	    }
106	  };
107	  
108	  try {
109	    process.stderr.write(JSON.stringify(logMessage) + '\n');
110	  } catch (error) {
111	    process.stderr.write(`Error sending log message: ${error.message}\n`);
112	  }
113	}
114	
115	// Lazy load embedder when needed
116	async function getEmbedder() {
117	  if (embedder) return embedder;
118	  
119	  if (!embedderInitializing) {
120	    embedderInitializing = true;
121	    try {
122	      sendLogMessage('info', 'Initializing embedder...', { model: CONFIG.embeddings.model });
123	      embedder = await pipeline('feature-extraction', CONFIG.embeddings.model);
124	      sendLogMessage('info', 'Embedder initialized successfully');
125	    } catch (error) {
126	      sendLogMessage('error', `Error initializing embedder: ${error.message}`, { stack: error.stack });
127	      embedderInitializing = false;
128	      throw error;
129	    }
130	  } else {
131	    // Wait for initialization to complete
132	    sendLogMessage('info', 'Waiting for embedder initialization...');
133	    while (!embedder) {
134	      await new Promise(resolve => setTimeout(resolve, 100));
135	    }
136	  }
137	  
138	  return embedder;
139	}
140	
141	// Initialize database - but don't wait for it
142	async function initializeDatabase() {
143	  if (dbInitialized) return;
144	  
145	  try {
146	    const migrationSQL = await fs.readFile(path.join(__dirname, '../migrations/init.sql'), 'utf8');
147	    await pool.query(migrationSQL);
148	    dbInitialized = true;
149	    sendLogMessage('info', 'Database initialized successfully');
150	  } catch (error) {
151	    sendLogMessage('error', `Error initializing database: ${error.message}`, { stack: error.stack });
152	    // Don't exit on database error - we might be able to handle some requests
153	  }
154	}
155	
156	// Start database initialization in the background
157	initializeDatabase().catch(err => {
158	  sendLogMessage('error', `Background database initialization failed: ${err.message}`);
159	});
