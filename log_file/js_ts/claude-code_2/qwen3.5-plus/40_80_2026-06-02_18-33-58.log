180	// Track initialization states
181	let isInitialized = false;
182	let hasReceivedInitializedNotification = false;
183	
184	// Initialize server
185	function initializeServer() {
186	  try {
187	    // Log startup immediately 
188	    debugLog('initializeServer() called', {
189	      pid: process.pid,
190	      nodeVersion: process.version,
191	      platform: process.platform,
192	      workingDir: process.cwd(),
193	      env: {
194	        PORT: process.env.PORT,
195	        DATABASE_URL: process.env.DATABASE_URL,
196	        MCP_SERVER_NAME: process.env.MCP_SERVER_NAME,
197	        MCP_SERVER_VERSION: process.env.MCP_SERVER_VERSION
198	      }
199	    });
200	    
201	    sendLogMessage('info', 'MCP Memory Server starting up', {
202	      pid: process.pid,
203	      nodeVersion: process.version,
204	      platform: process.platform
205	    });
206	    
207	    // Set up stdio handling
208	    process.stdin.setEncoding('utf8');
209	    process.stdout.setDefaultEncoding('utf8');
210	    
211	    // Prevent Node from exiting on stdin end
212	    process.stdin.on('end', () => {
213	      sendLogMessage('info', 'stdin end received, keeping process alive');
214	    });
215	    
216	    // Handle stdin errors
217	    process.stdin.on('error', (error) => {
218	      sendLogMessage('error', 'stdin error', { error: error.message });
219	    });
220	    
221	    // Handle stdout errors
222	    process.stdout.on('error', (error) => {
223	      sendLogMessage('error', 'stdout error', { error: error.message });
224	    });
225	    
226	    // Keep process alive and indicate readiness
227	    setInterval(() => {
228	      if (!isInitialized) {
229	        sendLogMessage('debug', 'Waiting for initialization...', { pid: process.pid });
230	      }
231	    }, 30000);
232	    
233	    // Start background tasks if needed, but don't wait for them
234	    
235	    // Resume stdin after all handlers are set up
236	    process.stdin.resume();
237	    
238	    sendLogMessage('info', 'Server ready for initialization requests');
239	    return true;
240	  } catch (error) {
241	    sendLogMessage('error', 'Server initialization failed', { 
242	      error: error.message,
243	      stack: error.stack
244	    });
245	    process.exit(1);
246	  }
247	}
