4	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
5	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
6	import {
7	  CallToolRequestSchema,
8	  ErrorCode,
9	  ListToolsRequestSchema,
10	  McpError,
11	} from "@modelcontextprotocol/sdk/types.js";
12	import "dotenv/config";
13	
14	import RunReportRequest = google.analytics.data.v1beta.RunReportRequest;
15	
16	// Validate environment variables
17	function validateEnvironment(): void {
18	  const requiredEnvVars = [
19	    "GOOGLE_CLIENT_EMAIL",
20	    "GOOGLE_PRIVATE_KEY",
21	    "GA_PROPERTY_ID",
22	  ];
23	
24	  const missingVars = requiredEnvVars.filter(
25	    (varName) => !process.env[varName],
26	  );
27	
28	  if (missingVars.length > 0) {
29	    throw new Error(
30	      `Missing required environment variables: ${missingVars.join(", ")}`,
31	    );
32	  }
33	}
34	
35	// Validate date format (YYYY-MM-DD)
36	function validateDateFormat(date: string): boolean {
37	  const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
38	  if (!dateRegex.test(date)) {
39	    return false;
40	  }
41	
42	  const parsedDate = new Date(date);
43	  return parsedDate.toISOString().split("T")[0] === date;
44	}
45	
46	// Validate date range
47	function validateDateRange(startDate: string, endDate: string): void {
48	  if (!validateDateFormat(startDate)) {
49	    throw new McpError(
50	      ErrorCode.InvalidParams,
51	      `Invalid startDate format. Expected YYYY-MM-DD, got: ${startDate}`,
52	    );
53	  }
54	
55	  if (!validateDateFormat(endDate)) {
56	    throw new McpError(
57	      ErrorCode.InvalidParams,
58	      `Invalid endDate format. Expected YYYY-MM-DD, got: ${endDate}`,
59	    );
60	  }
61	
62	  if (new Date(startDate) > new Date(endDate)) {
63	    throw new McpError(
64	      ErrorCode.InvalidParams,
65	      "startDate cannot be after endDate",
66	    );
67	  }
68	}
69	
70	// Initialize environment validation
71	validateEnvironment();
72	
73	// Initialize the Google Analytics Data client
74	const analyticsDataClient = new BetaAnalyticsDataClient({
75	  credentials: {
76	    client_email: process.env.GOOGLE_CLIENT_EMAIL as string,
77	    private_key: process.env.GOOGLE_PRIVATE_KEY as string,
78	  },
79	});
80	
81	const propertyId = process.env.GA_PROPERTY_ID as string;
82	
83	// Create the server
84	const server = new Server(
85	  {
86	    name: "google-analytics-server",
87	    version: "1.0.0",
88	  },
89	  {
90	    capabilities: {
91	      tools: {},
92	    },
93	  },
94	);
95	
96	// Validate and fetch analytics data
97	async function fetchAnalyticsData(
