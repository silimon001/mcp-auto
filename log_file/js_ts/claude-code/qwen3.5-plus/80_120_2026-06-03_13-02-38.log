99	    dateRanges: RunReportRequest["dateRanges"];
100	    dimensions?: RunReportRequest["dimensions"];
101	    metrics?: RunReportRequest["metrics"];
102	  },
103	) {
104	  try {
105	    const [response] = await analyticsDataClient.runReport({
106	      property: `properties/${propertyId}`,
107	      ...reportConfig,
108	    });
109	    return {
110	      content: [
111	        {
112	          type: "text",
113	          text: JSON.stringify(response, null, 2),
114	        },
115	      ],
