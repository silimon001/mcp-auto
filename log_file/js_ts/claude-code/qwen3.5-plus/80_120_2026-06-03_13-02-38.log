1	#!/usr/bin/env node
2	
3	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
4	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
5	
6	import { createRequire } from "node:module";
7	
8	// Import tools
9	import { kagiSearchFetch, searchToolConfig } from "./tools/search.js";
10	import { kagiSummarizer, summarizerToolConfig } from "./tools/summarizer.js";
11	
12	const require = createRequire(import.meta.url);
13	const { version } = require("../package.json");
14	
15	/**
16	 * Kagi MCP Server using kagi-ken package
17	 * Provides search and summarization capabilities compatible with official Kagi MCP
18	 */
19	class KagiKenMcpServer {
20	  constructor() {
21	    this.server = new McpServer({
22	      name: "kagi-ken-mcp",
23	      version: "1.0.0",
24	    });
25	    this.setupTools();
26	  }
27	
28	  /**
29	   * Register tools with the MCP server
30	   */
31	  setupTools() {
32	    // Register search tool
33	    this.server.registerTool(
34	      searchToolConfig.name,
35	      {
36	        title: "Kagi Search",
37	        description: searchToolConfig.description,
38	        inputSchema: searchToolConfig.inputSchema,
39	      },
40	      async (args) => await kagiSearchFetch(args),
41	    );
42	
43	    // Register summarizer tool
44	    this.server.registerTool(
45	      summarizerToolConfig.name,
46	      {
47	        title: "Kagi Summarizer",
48	        description: summarizerToolConfig.description,
49	        inputSchema: summarizerToolConfig.inputSchema,
50	      },
51	      async (args) => await kagiSummarizer(args),
52	    );
53	  }
54	
55	  /**
56	   * Start the MCP server
57	   */
58	  async start() {
59	    try {
60	      const transport = new StdioServerTransport();
61	      await this.server.connect(transport);
62	      console.error(`Kagi Ken MCP Server v${version} started successfully`);
63	    } catch (error) {
64	      console.error(`Failed to start Kagi Ken MCP Server v${version}:`, error);
65	      process.exit(1);
66	    }
67	  }
68	}
69	
70	// Handle uncaught exceptions
71	process.on("uncaughtException", (error) => {
72	  console.error("Uncaught exception:", error);
73	  process.exit(1);
74	});
75	
76	process.on("unhandledRejection", (reason, promise) => {
77	  console.error("Unhandled rejection at:", promise, "reason:", reason);
78	  process.exit(1);
79	});
80	
81	// Start the server
82	const server = new KagiKenMcpServer();
83	await server.start();
84	

