1	import { type FastMCP, UserError } from 'fastmcp';
2	import { ZodError } from 'zod';
3	import { GrowiApiError, isGrowiApiError } from '../../../commons/api/growi-api-error.js';
4	import { resolveAppName } from '../../../commons/utils/resolve-app-name.js';
5	import { suggestPathParamSchema } from './schema.js';
6	import { suggestPath } from './service.js';
7	
8	export function registerSuggestPathTool(server: FastMCP): void {
9	  server.addTool({
10	    name: 'suggestPath',
11	    description: 'Get suggested save paths for content in GROWI. Analyzes the content body and returns directory path candidates with grant (permission) constraints.',
12	    parameters: suggestPathParamSchema,
13	    annotations: {
14	      readOnlyHint: true,
15	      destructiveHint: false,
16	      idempotentHint: true,
17	      openWorldHint: true,
18	      title: 'Suggest Save Path',
19	    },
20	    execute: async (params) => {
21	      try {
22	        const validatedParams = suggestPathParamSchema.parse(params);
23	        const { appName, ...suggestPathParams } = validatedParams;
24	
25	        const resolvedAppName = resolveAppName(appName);
26	        const response = await suggestPath(suggestPathParams, resolvedAppName);
27	
28	        try {
29	          return JSON.stringify(response);
30	        } catch (jsonError) {
31	          throw new GrowiApiError('Failed to serialize API response', 500, { error: jsonError instanceof Error ? jsonError.message : String(jsonError) });
32	        }
33	      } catch (error) {
34	        if (error instanceof ZodError) {
35	          throw new UserError('Invalid parameters provided', {
36	            validationErrors: error.errors,
37	          });
38	        }
39	
40	        if (isGrowiApiError(error)) {
41	          throw new UserError(error.message, {
42	            statusCode: error.statusCode,
43	            details: error.details,
44	          });
45	        }
46	
47	        throw new UserError('The suggest path operation could not be completed. Please try again later.', {
48	          originalError: error instanceof Error ? error.message : String(error),
49	        });
50	      }
51	    },
52	  });
53	}
