4	import { GrowiApiError, isGrowiApiError } from '../../../commons/api/growi-api-error.js';
5	import { resolveAppName } from '../../../commons/utils/resolve-app-name.js';
6	import { searchPagesParamSchema } from './schema.js';
7	
8	export function registerSearchPagesTool(server: FastMCP): void {
9	  server.addTool({
10	    name: 'searchPages',
11	    description: 'Search pages in GROWI using Elasticsearch',
12	    parameters: searchPagesParamSchema,
13	    annotations: {
14	      readOnlyHint: true,
15	      destructiveHint: false,
16	      idempotentHint: true,
17	      openWorldHint: true,
18	      title: 'Search Pages',
19	    },
20	    execute: async (params, context) => {
21	      try {
22	        // Validate input using zod schema
23	        const { appName, ...searchPagesParams } = searchPagesParamSchema.parse(params);
24	        const resolvedAppName = resolveAppName(appName);
25	
26	        // Execute search using SDK
27	        const response = await apiv1.searchPages(searchPagesParams, { appName: resolvedAppName });
28	
29	        if (!response.data) {
30	          throw new GrowiApiError('Invalid response received from search API', 500, { response });
31	        }
32	
33	        try {
34	          return JSON.stringify(response.data);
35	        } catch (jsonError) {
36	          throw new GrowiApiError('Failed to serialize API response', 500, {
37	            error: jsonError instanceof Error ? jsonError.message : String(jsonError),
38	          });
39	        }
40	      } catch (error) {
41	        // Handle zod validation errors
42	        if (error instanceof ZodError) {
43	          throw new UserError('Invalid parameters provided', {
44	            validationErrors: error.errors,
45	          });
46	        }
47	
48	        // Convert GrowiApiError to UserError
49	        if (isGrowiApiError(error)) {
50	          throw new UserError(error.message, {
51	            statusCode: error.statusCode,
52	            details: error.details,
53	          });
54	        }
55	
56	        // Handle unexpected errors
57	        throw new UserError('The page search operation could not be completed. Please try again later.', {
58	          originalError: error instanceof Error ? error.message : String(error),
59	        });
60	      }
61	    },
62	  });
63	}
