1	import { axiosInstanceManager } from '@growi/sdk-typescript';
2	import { GrowiApiError } from '../../../commons/api/growi-api-error.js';
3	
4	export type SuggestPathParam = {
5	  body: string;
6	};
7	
8	export type PathSuggestion = {
9	  type: string;
10	  path: string;
11	  label: string;
12	  description: string;
13	  grant: number;
14	};
15	
16	export type SuggestPathResponse = {
17	  suggestions: PathSuggestion[];
18	};
19	
20	export const suggestPath = async (params: SuggestPathParam, appName: string): Promise<SuggestPathResponse> => {
21	  try {
22	    const instance = axiosInstanceManager.getAxiosInstance(appName);
23	
24	    const response = await instance.post<SuggestPathResponse>('/_api/v3/ai-tools/suggest-path', { body: params.body });
25	
26	    if (!response.data?.suggestions) {
27	      throw new GrowiApiError('Invalid response received from suggest-path API', 500, { response: response.data });
28	    }
29	
30	    return response.data;
31	  } catch (error) {
32	    if (error instanceof GrowiApiError) {
33	      throw error;
34	    }
35	
36	    const message = error instanceof Error ? error.message : String(error);
37	    const statusCode = error instanceof Error && 'response' in error
38	      ? (error as { response?: { status?: number } }).response?.status || 500
39	      : 500;
40	
41	    throw new GrowiApiError(`Failed to get path suggestions: ${message}`, statusCode, { originalError: error });
42	  }
43	};
44	

