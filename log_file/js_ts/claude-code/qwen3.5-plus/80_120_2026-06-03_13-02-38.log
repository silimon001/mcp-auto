1	import { search } from "kagi-ken";
2	import {
3	  formatError,
4	  formatSearchResults,
5	  getEnvironmentConfig,
6	} from "../utils/formatting.js";
7	import { z } from "zod";
8	
9	/**
10	 * Schema for search tool input validation
11	 */
12	export const searchInputSchema = {
13	  queries: z.array(z.string()).min(1).describe(
14	    "One or more concise, keyword-focused search queries. Include essential context within each query for standalone use.",
15	  ),
16	  limit: z.number().int().min(1).max(50).optional().describe(
17	    "Maximum number of search results per query (default: 10, max: 50)",
18	  ),
19	};
20	
21	/**
22	 * Kagi search tool implementation using kagi-ken package
23	 * Mirrors the functionality of the official Kagi MCP kagi_search_fetch tool
24	 *
25	 * @param {Object} args - Tool arguments
26	 * @param {Array<string>} args.queries - Array of search queries
27	 * @param {number} [args.limit=10] - Maximum number of search results per query
28	 * @returns {Promise<Object>} MCP tool response
29	 */
30	export async function kagiSearchFetch({ queries, limit = 10 }) {
31	  try {
32	    if (!queries || queries.length === 0) {
33	      throw new Error("Search called with no queries.");
34	    }
35	
36	    const { token } = getEnvironmentConfig();
37	
38	    // Execute searches concurrently (similar to ThreadPoolExecutor in original)
39	    const searchPromises = queries.map((query) => {
40	      if (typeof query !== "string" || query.trim() === "") {
41	        throw new Error("All queries must be non-empty strings");
42	      }
43	      return search(query.trim(), token, limit);
44	    });
45	
46	    // Wait for all searches to complete with 10 second timeout per search
47	    const results = await Promise.allSettled(
48	      searchPromises.map((promise) =>
49	        Promise.race([
50	          promise,
51	          new Promise((_, reject) =>
52	            setTimeout(() => reject(new Error("Search timeout")), 10000)
53	          ),
54	        ])
55	      ),
56	    );
57	
58	    // Process results and handle any failures
59	    const responses = [];
60	    const errors = [];
61	
62	    for (let i = 0; i < results.length; i++) {
63	      const result = results[i];
64	      if (result.status === "fulfilled") {
65	        responses.push(result.value);
66	      } else {
67	        errors.push(
68	          `Query "${queries[i]}": ${result.reason?.message || result.reason}`,
69	        );
70	        // Add empty response to maintain index alignment
71	        responses.push({ results: [] });
72	      }
73	    }
74	
75	    // Format results using the same formatting as official MCP
76	    const formattedResults = formatSearchResults(queries, responses);
77	
78	    // Include any errors in the response
79	    let finalResponse = formattedResults;
80	    if (errors.length > 0) {
81	      finalResponse += "\n\nErrors encountered:\n" + errors.join("\n");
82	    }
83	
84	    return {
85	      content: [
86	        {
87	          type: "text",
88	          text: finalResponse,
89	        },
90	      ],
91	    };
92	  } catch (error) {
93	    return {
94	      content: [
95	        {
96	          type: "text",
97	          text: formatError(error),
98	        },
99	      ],
100	    };
101	  }
102	}
103	
104	/**
105	 * Tool registration configuration for MCP server
106	 */
107	export const searchToolConfig = {
108	  name: "kagi_search_fetch",
109	  description: `
110	    Fetch web results based on one or more queries using the Kagi.com web search engine. Use for
111	    general search and when the user explicitly tells you to 'fetch' results/information. Results are
112	    from all queries given. They are numbered continuously, so that a user may be able to refer to a
113	    result by a specific number. Supports optional limit parameter to control results per query.
114	    `.replace(/\s+/gs, " ").trim(),
115	  inputSchema: searchInputSchema,
116	};
117	

