312	
313	    // Call the original method
314	    return super.sendMessage(message);
315	  }
316	
317	  async handleMessage(message) {
318	    // Log incoming message (command)
319	    this.commandCounter++;
320	    const logEntry = {
321	      timestamp: new Date().toISOString(),
322	      direction: 'COMMAND',
323	      commandNumber: this.commandCounter,
324	      message
325	    };
326	
327	    // Log to console
328	    logger.info(`Received command #${this.commandCounter}: ${message.method || 'unknown method'}`);
329	    logger.debug(`Command details: ${JSON.stringify(message)}`);
330	
331	    // Log to file
332	    fs.appendFileSync(logFile, JSON.stringify(logEntry) + '\n');
333	
334	    // Call the original method
335	    return super.handleMessage(message);
336	  }
337	}
