298	
299	  async sendMessage(message) {
300	    // Log outgoing message (response)
301	    const logEntry = {
302	      timestamp: new Date().toISOString(),
303	      direction: 'RESPONSE',
304	      message
305	    };
306	
307	    // Log to console
