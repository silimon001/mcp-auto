923	    const completers: Record<string, ArgumentValueCompleter> = {};
924	    const enums: Record<string, string[]> = {};
925	
926	    for (const argument of inputPrompt.arguments ?? []) {
927	      if (argument.complete) {
928	        completers[argument.name] = argument.complete;
929	      }
930	
931	      if (argument.enum) {
932	        enums[argument.name] = argument.enum;
933	      }
934	    }
935	
936	    const prompt = {
937	      ...inputPrompt,
938	      complete: async (name: string, value: string) => {
939	        if (completers[name]) {
940	          return await completers[name](value);
941	        }
942	
943	        if (enums[name]) {
944	          const fuse = new Fuse(enums[name], {
945	            keys: ["value"],
946	          });
947	
948	          const result = fuse.search(value);
949	
950	          return {
951	            total: result.length,
952	            values: result.map((item) => item.item),
953	          };
954	        }
955	
956	        return {
957	          values: [],
958	        };
959	      },
960	    };
961	
962	    this.#prompts.push(prompt);
963	  }
