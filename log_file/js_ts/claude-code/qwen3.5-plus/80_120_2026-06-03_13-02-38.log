9	  ErrorCode,
10	  ListToolsRequestSchema,
11	  McpError,
12	} from "@modelcontextprotocol/sdk/types.js";
13	import { exec } from "child_process";
14	import { access, readFile, writeFile } from "fs/promises";
15	import { createServer } from "http";
16	import { homedir, tmpdir } from "os";
17	import { dirname, join, resolve } from "path";
18	import { fileURLToPath } from "url";
19	import { promisify } from "util";
20	import { v4 as uuidv4 } from "uuid";
21	
22	const execAsync = promisify(exec);
23	
24	// Get the directory where this script is located
25	const __filename = fileURLToPath(import.meta.url);
26	const __dirname = dirname(__filename);
27	
28	// Hardcoded safe permissions - agents cannot modify these
29	// Allow network access for fetch/HTTP but no filesystem access
30	const HARDCODED_PERMISSIONS = ["net"];
31	
32	// Configuration interface
33	interface CodemodeConfig {
34	  proxyPort?: number;
35	  configDirectories?: string[];
36	}
37	
38	// Load configuration from codemode-config.json
39	async function loadCodemodeConfig(): Promise<CodemodeConfig> {
40	  try {
41	    const configPath = join(__dirname, "codemode-config.json");
42	    const configContent = await readFile(configPath, "utf-8");
43	    return JSON.parse(configContent);
44	  } catch (error) {
45	    console.error(
46	      "Warning: Could not load codemode-config.json, using defaults"
47	    );
48	    return {
49	      proxyPort: 3001,
50	      configDirectories: ["./"],
51	    };
52	  }
53	}
54	
55	// Expand tilde in paths
56	function expandPath(path: string): string {
57	  if (path.startsWith("~/")) {
58	    return join(homedir(), path.slice(2));
59	  }
60	  return resolve(path);
61	}
62	
63	// Check if Deno is installed
64	async function checkDenoInstalled(): Promise<boolean> {
65	  try {
66	    await execAsync("deno --version");
67	    return true;
68	  } catch (error) {
69	    return false;
70	  }
71	}
