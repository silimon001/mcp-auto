89	              }
90	            ]
91	          };
92	        }
93	      }
94	    );
95	
96	    // 列出文档
97	    this.server.tool(
98	      "list-documents",
99	      "获取指定空间或所有空间的文档列表",
100	      {
101	        spaceId: z.string().optional().describe("空间ID，不提供则返回所有空间的文档")
102	      },
103	      async ({ spaceId }: { spaceId?: string }) => {
104	        try {
105	          let allDocuments: any[] = [];
106	
107	          if (spaceId) {
108	            // 获取指定空间的文档
