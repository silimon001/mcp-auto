45	export class FeishuClient {
46	  private appId: string;
47	  private appSecret: string;
48	  private accessToken: string | null;
49	  private tokenExpireTime: number;
50	  private baseUrl: string;
51	
52	  constructor(appId?: string, appSecret?: string) {
53	    this.appId = appId || process.env.FEISHU_APP_ID || '';
54	    this.appSecret = appSecret || process.env.FEISHU_APP_SECRET || '';
55	    this.accessToken = null;
56	    this.tokenExpireTime = 0;
57	    this.baseUrl = 'https://open.feishu.cn/open-apis';
58	
59	    if (!this.appId || !this.appSecret) {
60	      console.error('错误: 未配置飞书应用凭证。请在.env文件中设置FEISHU_APP_ID和FEISHU_APP_SECRET。');
61	    }
62	  }
63	
64	  async getAccessToken(): Promise<string> {
65	    // 如果token还有效，直接返回
66	    if (this.accessToken && Date.now() < this.tokenExpireTime) {
67	      return this.accessToken;
68	    }
69	
70	    try {
71	      const response = await axios.post(`${this.baseUrl}/auth/v3/tenant_access_token/internal`, {
72	        app_id: this.appId,
73	        app_secret: this.appSecret
74	      });
75	
76	      if (response.data.code === 0) {
77	        const token = response.data.tenant_access_token;
78	        // 存储新token
79	        this.accessToken = token;
80	        // 设置过期时间（提前5分钟过期，以防刚好到期）
81	        this.tokenExpireTime = Date.now() + (response.data.expire * 1000) - (5 * 60 * 1000);
82	        return token;
83	      } else {
84	        throw new Error(`获取飞书Token失败: ${response.data.msg}`);
85	      }
86	    } catch (error) {
87	      console.error('获取飞书Token出错:', error instanceof Error ? error.message : String(error));
88	      throw error;
89	    }
90	  }
91	
92	  async request<T>(method: string, url: string, data: any = null, params: any = null): Promise<T> {
93	    try {
94	      const token = await this.getAccessToken();
95	      
96	      console.log(`发送请求: ${method} ${this.baseUrl}${url}`);
97	      console.log('请求参数:', params);
98	      console.log('请求数据:', data);
99	      console.log('请求头:', {
100	        'Authorization': `Bearer ${token}`,
101	        'Content-Type': 'application/json; charset=utf-8'
102	      });
103	      
104	      const response = await axios({
105	        method,
106	        url: `${this.baseUrl}${url}`,
107	        headers: {
108	          'Authorization': `Bearer ${token}`,
109	          'Content-Type': 'application/json; charset=utf-8'
110	        },
111	        data,
112	        params
113	      });
114	      
115	      console.log(`API响应状态码: ${response.status}`);
116	      
117	      if (response.data && response.data.code === 0) {
118	        console.log('API响应成功',response.data);
119	        return response.data.data as T;
120	      } else {
121	        const errorMsg = response.data?.msg || '未知错误';
122	        const errorCode = response.data?.code || -1;
123	        console.error(`API请求失败: 错误码 ${errorCode}, 错误信息: ${errorMsg}`);
124	        throw new Error(`API请求失败: ${errorMsg} (错误码: ${errorCode})`);
125	      }
126	    } catch (error) {
127	      if (axios.isAxiosError(error) && error.response) {
