1	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
2	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
3	import fs from "fs";
4	import path from "path";
5	import { z } from "zod";
6	
7	const COMPONENTS_DIR = path.join(
8	  path.dirname(new URL(import.meta.url).pathname),
9	  "src/components/"
10	);
11	
12	const latestPrompt = `You are a React and React Native expert. Generate COMPLETE and RUNNABLE code using only my design system components and tools sequentially: get_all_components_metadata, select_components, get_selected_components_docs. Requirements: no external component libraries, no HTML tags (<div>, <button>, <input>, etc), no StyleSheet, use TailwindCSS classes via className prop. Images must be from unsplash.com only. Import all components individually. Prefer VStack/HStack over Box component. Ensure screens are scrollable, responsive, and mobile-friendly.`;
13	
14	// Initializes an MCP server
15	const server = new McpServer({
16	  name: "use-gluestack-components",
17	  version: "1.0.0",
18	  systemPrompt: latestPrompt,
19	});
20	
21	function getAvailableComponents() {
22	  try {
23	    // Get all markdown files in the components directory
24	    const componentFiles = fs
25	      .readdirSync(COMPONENTS_DIR)
26	      .filter((file) => file.endsWith(".md"))
27	      .map((file) => file.replace(".md", ""));
28	
29	    return componentFiles;
30	
31	    return {
32	      content: [
33	        {
34	          type: "text",
35	          text: JSON.stringify(componentFiles),
36	        },
37	      ],
38	    };
39	  } catch (error) {
40	    console.error(`Error reading components directory: ${error.message}`);
41	
42	    return [];
43	
44	    return {
45	      content: [
46	        {
47	          type: "text",
48	          text: JSON.stringify([]),
49	        },
50	      ],
51	    };
52	  }
53	}
54	
55	function getComponentMetadata(componentName) {
56	  try {
57	    const docPath = path.join(
58	      COMPONENTS_DIR,
59	      `${componentName.toLowerCase()}.md`
60	    );
61	
62	    if (!fs.existsSync(docPath)) {
63	      return { title: componentName, description: "Component not found" };
64	    }
65	
66	    const docsContent = fs.readFileSync(docPath, "utf-8");
67	    const lines = docsContent.split("\n");
68	
69	    // Check if file starts with frontmatter
70	    if (lines[0].trim() !== "---") {
71	      return { title: componentName, description: "No description available" };
72	    }
73	
74	    // Extract only title and description
75	    const metadata = {
76	      title: componentName,
77	      description: "No description available",
78	    };
79	
80	    // Read until the closing frontmatter delimiter
81	    for (let i = 1; i < lines.length; i++) {
82	      const line = lines[i].trim();
83	
84	      if (line === "---") break;
85	
86	      if (line.startsWith("title:")) {
87	        metadata.title = line.split(":")[1].trim();
88	      } else if (line.startsWith("description:")) {
89	        metadata.description = line.split(":")[1].trim();
90	      }
91	    }
92	
93	    return metadata;
94	
95	    return {
96	      content: [
97	        {
98	          type: "text",
99	          text: JSON.stringify(metadata),
100	        },
101	      ],
102	    };
103	  } catch (error) {
104	    console.error(
105	      `Error reading metadata for ${componentName}: ${error.message}`
106	    );
107	
108	    return {
109	      title: componentName,
110	      description: "Error reading metadata",
111	    };
112	
113	    return {
114	      content: [
115	        {
116	          type: "text",
117	          text: JSON.stringify({
118	            title: componentName,
119	            description: "Error reading metadata",
120	          }),
121	        },
122	      ],
123	    };
124	  }
125	}
126	
127	function getAllComponentsMetadata() {
128	  const components = getAvailableComponents();
129	  const metadata = {};
130	
131	  components.forEach((component) => {
132	    const meta = getComponentMetadata(component);
133	    if (meta) {
134	      metadata[component] = meta;
135	    }
136	  });
137	
138	  return {
139	    content: [
140	      {
141	        type: "text",
142	        text: JSON.stringify(metadata, null, 2),
143	      },
144	    ],
145	  };
146	}
147	
148	function getComponentDocs(componentName) {
149	  try {
150	    const docPath = path.join(
151	      COMPONENTS_DIR,
152	      `${componentName.toLowerCase()}.md`
153	    );
154	
155	    // Check if the file exists
156	    if (!fs.existsSync(docPath)) {
157	      return `Documentation not found for component: ${componentName}`;
158	    }
159	
160	    // Read the markdown file
161	    const docsContent = fs.readFileSync(docPath, "utf-8");
162	
163	    return (
164	      docsContent || `Empty documentation file for component: ${componentName}`
165	    );
166	
167	    return {
168	      content: [
169	        {
170	          type: "text",
171	          text:
172	            docsContent ||
173	            `Empty documentation file for component: ${componentName}`,
174	        },
175	      ],
176	    };
177	  } catch (error) {
178	    return `Error retrieving documentation for ${componentName}: ${error.message}`;
179	  }
180	}
181	
182	function getSelectedComponentsDocs(componentNames) {
183	  const docsObject = {};
184	  console.log(
185	    `✅ Getting documentation for components: ${componentNames.join(", ")}`
186	  );
187	
188	  for (const componentName of componentNames) {
189	    docsObject[componentName] = getComponentDocs(componentName);
190	  }
191	
192	  return {
193	    content: [
194	      {
195	        type: "text",
196	        text: JSON.stringify(docsObject, null, 2),
197	      },
198	    ],
199	  };
200	}
201	
202	server.tool(
203	  "get_all_components_metadata",
204	  "Read and gives the metadata of all the components",
205	  {},
206	  () => getAllComponentsMetadata()
207	);
208	
209	server.tool(
210	  "select_components",
211	  "Selects the components you need",
212	  {
213	    selectedComponents: z
214	      .array(z.string())
215	      .describe("The names of the components"),
216	  },
217	  (input) => {
218	    console.log(
219	      `✅ Selected components: ${input.selectedComponents.join(", ")}`
220	    );
221	
222	    return {
223	      content: [
224	        {
225	          type: "text",
226	          text: `You have selected: ${input.selectedComponents.join(
227	            ", "
228	          )}. Now proceed to get full documentation for ALL these components at once using get_selected_components_docs.`,
229	        },
230	      ],
231	    };
232	  }
233	);
234	
235	server.tool(
236	  "get_selected_components_docs",
237	  "Read and gives the complete documentation of selected components",
238	  {
239	    component_names: z
240	      .array(z.string())
241	      .describe("The names of the components"),
242	  },
243	  (input) => getSelectedComponentsDocs(input.component_names)
244	);
245	
246	// Sets up the MCP server and establishes communication channel with the client using stdio transport
247	async function main() {
248	  const transport = new StdioServerTransport();
249	  await server.connect(transport);
250	  console.log("Use Gluestack Components MCP Server running on stdio");
251	}
252	
253	main().catch((error) => {
254	  console.error("Fatal error in main():", error);
255	  process.exit(1);
256	});
