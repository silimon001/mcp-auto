219	  private saveTokensToEnv(): void {
220	    const tokenPath = path.join(__dirname, '..', '..', '.env');
221	    const envContent = fs.existsSync(tokenPath) ? fs.readFileSync(tokenPath, 'utf-8') : '';
222	    const envLines = envContent.split('\n');
223	
224	    const updateEnvVar = (name: string, value: string) => {
225	      const index = envLines.findIndex(line => line.startsWith(`${name}=`));
226	      if (index !== -1) {
227	        envLines[index] = `${name}=${value}`;
228	      } else {
229	        envLines.push(`${name}=${value}`);
230	      }
