1	# microCMS Service Configuration
2	# Copy this file to .env and fill in your actual values
3	
4	# ============================================
5	# Single Service Mode (従来の設定方法)
6	# ============================================
7	# Your microCMS service id (without .microcms.io)
8	# Example: If your URL is https://my-blog.microcms.io, set this to "my-blog"
9	MICROCMS_SERVICE_ID=your-service-id
10	
11	# Your microCMS API key
12	# Get this from your microCMS dashboard
13	MICROCMS_API_KEY=your-api-key
14	
15	# ============================================
16	# Multi Service Mode (複数サービス対応)
17	# ============================================
18	# 複数のmicroCMSサービスに接続する場合は、以下の形式でJSON配列を設定します。
19	# MICROCMS_SERVICES が設定されている場合、上記の単一サービス設定より優先されます。
20	#
21	# 例: 2つのサービス (blog と shop) に接続する場合
22	# MICROCMS_SERVICES=[{"id":"blog","apiKey":"your-blog-api-key"},{"id":"shop","apiKey":"your-shop-api-key"}]
23	#
24	# 複数サービスモードでは、各ツール呼び出し時に serviceId パラメータを指定します。
25	# ツール名は単一サービスモードと同じ microcms_* 形式です。
26	# 設定済みサービスの一覧は microcms://services リソースで確認できます。
27	
28	# ============================================
29	# HTTP Transport (リモートMCPサーバーモード)
30	# ============================================
31	# トランスポートモード: "stdio"（デフォルト）または "http"
32	# MCP_TRANSPORT=http
33	
34	# HTTPサーバーのポート番号（デフォルト: 3000）
35	# MCP_HTTP_PORT=3000
36	
37	# HTTPサーバーのホスト（デフォルト: 0.0.0.0）
38	# MCP_HTTP_HOST=0.0.0.0
39	
40	# Bearer認証トークン（設定時のみ認証が有効になります）
41	# MCP_AUTH_TOKEN=your-secret-token
42	
43	# ============================================
44	# Notes
45	# ============================================
46	# - You can also pass these as command line arguments (single service mode only):
47	#   node dist/index.js --service-id your-service-id --api-key your-api-key
48	# - Command line arguments take precedence over environment variables.
49	

