1	#!/usr/bin/env node
2	
3	/**
4	 * This is a template MCP server that implements a tryon system.
5	 * It demonstrates core MCP concepts like resources and tools by allowing:
6	 * - Listing clothes as resources
7	 * - Reading individual clothes
8	 * - Submitting a tryon task via a tool
9	 * - Querying a tryon task via a tool
10	 */
11	
12	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
13	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
14	import { RestServerTransport } from "@chatmcp/sdk/server/rest.js";
15	import {
16	  CallToolRequestSchema,
17	  ListResourcesRequestSchema,
18	  ListToolsRequestSchema,
19	  ReadResourceRequestSchema,
20	  ListPromptsRequestSchema,
21	  GetPromptRequestSchema,
22	} from "@modelcontextprotocol/sdk/types.js";
23	import { HeyBeautyClient } from "./heybeauty.js";
24	import { getParamValue, getAuthValue } from "@chatmcp/sdk/utils/index.js";
25	
26	/**
27	 * Create an MCP server with capabilities for resources (to list/read clothes),
28	 * prompts (to tryon with user image and cloth image), and tools (to submit a tryon task).
29	 */
30	const server = new Server(
31	  {
32	    name: "heybeauty-mcp",
33	    version: "0.1.0",
34	  },
35	  {
36	    capabilities: {
37	      resources: {},
38	      tools: {},
39	      prompts: {},
40	    },
41	  }
42	);
43	
44	const heybeautyApiKey = getParamValue("HEYBEAUTY_API_KEY") || "";
45	
46	const mode = getParamValue("mode") || "stdio";
47	const port = getParamValue("port") || 9593;
48	const endpoint = getParamValue("endpoint") || "/rest";
49	
50	/**
51	 * Handler for listing available clothes as resources.
52	 * Each cloth is exposed as a resource with:
53	 * - A cloth:// URI scheme
54	 * - Plain text MIME type
55	 * - Human readable name and description (now including the cloth title)
56	 */
57	server.setRequestHandler(ListResourcesRequestSchema, async (request) => {
58	  try {
59	    const apiKey =
60	      getAuthValue(request, "HEYBEAUTY_API_KEY") || heybeautyApiKey;
61	    if (!apiKey) {
62	      throw new Error("HEYBEAUTY_API_KEY is not set");
63	    }
64	
65	    const client = new HeyBeautyClient({ apiKey });
66	    const clothes = await client.getClothes();
67	
68	    return {
69	      resources: clothes.map((clothe: any) => ({
70	        uri: `cloth:///${clothe.cloth_id}`,
71	        mimeType: "text/plain",
72	        name: clothe.title,
73	        description: `${clothe.description}`,
74	      })),
75	    };
76	  } catch (error: any) {
77	    throw new Error("get resources failed: " + error.message);
78	  }
79	});
80	
81	/**
82	 * Handler for reading the contents of a specific cloth.
83	 * Takes a cloth:// URI and returns the cloth content as plain text.
84	 */
85	server.setRequestHandler(ReadResourceRequestSchema, async (request) => {
86	  try {
87	    const apiKey =
88	      getAuthValue(request, "HEYBEAUTY_API_KEY") || heybeautyApiKey;
89	    if (!apiKey) {
90	      throw new Error("HEYBEAUTY_API_KEY is not set");
91	    }
92	
93	    const url = new URL(request.params.uri);
94	    const id = url.pathname.replace(/^\//, "");
95	
96	    const client = new HeyBeautyClient({ apiKey });
97	    const clothes = await client.getClothes();
98	    const cloth = clothes.find((clothe: any) => clothe.cloth_id == id);
99	
100	    if (!cloth) {
101	      throw new Error(`Cloth ${id} not found`);
102	    }
103	
104	    return {
105	      contents: [
106	        {
107	          uri: request.params.uri,
108	          mimeType: "text/plain",
109	          text: cloth.cloth_img_url,
110	        },
111	      ],
112	    };
113	  } catch (error: any) {
114	    throw new Error("read resource failed: " + error.message);
115	  }
116	});
117	
118	/**
119	 * Handler that lists available tools.
120	 * Exposes a single "submit_tryon_task" tool that lets clients submit a tryon task.
121	 * Exposes a single "query_tryon_task" tool that lets clients query a tryon task.
122	 */
123	server.setRequestHandler(ListToolsRequestSchema, async () => {
124	  return {
125	    tools: [
126	      {
127	        name: "submit_tryon_task",
128	        description:
129	          "Submit a tryon task with user image url and cloth image url",
130	        inputSchema: {
131	          type: "object",
132	          properties: {
133	            user_img_url: {
134	              type: "string",
135	              description: "User image url, should be a url of a picture",
136	            },
137	            cloth_img_url: {
138	              type: "string",
139	              description:
140	                "Cloth image url, should be a url of a picture, user input or get from the selected cloth resource",
141	            },
142	            cloth_id: {
143	              type: "string",
144	              description: "Cloth id, get from the selected cloth resource",
145	            },
146	            cloth_description: {
147	              type: "string",
148	              description:
149	                "Cloth description, user input or get from the selected cloth resource",
150	            },
151	          },
152	          required: ["user_img_url", "cloth_img_url"],
153	        },
154	      },
155	      {
156	        name: "query_tryon_task",
157	        description: "Query a tryon task with task id",
158	        inputSchema: {
159	          type: "object",
160	          properties: {
161	            task_id: {
162	              type: "string",
163	              description: "Task id, get from the submit_tryon_task tool",
164	            },
165	          },
166	          required: ["task_id"],
167	        },
168	      },
169	    ],
170	  };
171	});
172	
173	/**
174	 * Handler for the submit_tryon_task and query_tryon_task tools.
175	 * Submits a tryon task with the provided user image url, cloth image url, cloth id and cloth description, and returns success message.
176	 */
177	server.setRequestHandler(CallToolRequestSchema, async (request) => {
178	  try {
179	    const apiKey =
180	      getAuthValue(request, "HEYBEAUTY_API_KEY") || heybeautyApiKey;
181	    if (!apiKey) {
182	      throw new Error("HEYBEAUTY_API_KEY is not set");
183	    }
184	
185	    const client = new HeyBeautyClient({ apiKey });
186	
187	    switch (request.params.name) {
188	      case "submit_tryon_task": {
189	        const user_img_url = String(
190	          request.params.arguments?.user_img_url || ""
191	        );
192	        const cloth_img_url = String(
193	          request.params.arguments?.cloth_img_url || ""
194	        );
195	        const cloth_id = String(request.params.arguments?.cloth_id || "");
196	        const cloth_description = String(
197	          request.params.arguments?.cloth_description || ""
198	        );
199	
200	        if (!user_img_url) {
201	          throw new Error("user image is required");
202	        }
203	
204	        if (!cloth_img_url) {
205	          throw new Error("cloth image is required");
206	        }
207	
208	        const res = await client.submitTask({
209	          user_img_url,
210	          cloth_img_url,
211	          cloth_id,
212	          cloth_description,
213	        });
214	
215	        return {
216	          content: [
217	            {
218	              type: "text",
219	              text: JSON.stringify(res),
220	            },
221	          ],
222	        };
223	      }
224	
225	      case "query_tryon_task": {
226	        const task_id = String(request.params.arguments?.task_id);
227	        if (!task_id) {
228	          throw new Error("task id is required");
229	        }
230	
231	        const res = await client.queryTask({ task_id });
232	        return {
233	          content: [
234	            {
235	              type: "text",
236	              text: JSON.stringify(res),
237	            },
238	          ],
239	        };
240	      }
241	
242	      default:
243	        throw new Error("Unknown tool");
244	    }
245	  } catch (error: any) {
246	    throw new Error("call tool failed: " + error.message);
247	  }
248	});
249	
250	/**
251	 * Handler that lists available prompts.
252	 * Exposes a single "tryon_cloth" prompt that tryon with user uploaded image and cloth image.
253	 */
254	server.setRequestHandler(ListPromptsRequestSchema, async () => {
255	  return {
256	    prompts: [
257	      {
258	        name: "tryon_cloth",
259	        description: "Tryon with user image and cloth image",
260	      },
261	    ],
262	  };
263	});
264	
265	/**
266	 * Handler for the tryon_cloth prompt.
267	 * Returns a prompt that requests tryon with user image and cloth image.
268	 */
269	server.setRequestHandler(GetPromptRequestSchema, async (request) => {
270	  if (request.params.name !== "tryon_cloth") {
271	    throw new Error("Unknown prompt");
272	  }
273	
274	  return {
275	    messages: [
276	      {
277	        role: "user",
278	        content: {
279	          type: "text",
280	          text: `You are a helpful assistant that helps users try on clothes virtually. When a user provides their photo URL and either:
281	1. A clothing image URL they want to try on, or
282	2. Selects a clothing item from the available resources
283	
284	Here's how to handle each case:
285	
286	1. If the user provides their own clothing image URL:
287	   - Use the submit_tryon_task tool with:
288	     - user_img_url: The URL of the user's photo
289	     - cloth_img_url: The URL of the clothing image provided by the user
290	   - cloth_id and cloth_description can be left empty
291	
292	2. If the user selects a clothing item from resources:
293	   - Use the submit_tryon_task tool with:
294	     - user_img_url: The URL of the user's photo
295	     - cloth_img_url: The URL from the selected cloth resource
296	     - cloth_id: The ID from the selected cloth resource
297	     - cloth_description: The description from the selected cloth resource
298	
299	After submitting the task:
300	- Get the task_id from the response
301	- Use the query_tryon_task tool every 5 seconds to check the task status
302	- Continue checking until the task status is either "succeeded" or "failed"
