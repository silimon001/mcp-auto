146	                }
147	              }
148	            }
149	          }
150	          
151	          return {
152	            content: [
153	              {
154	                type: "text",
155	                text: JSON.stringify({ documents: allDocuments })
156	              }
157	            ]
158	          };
159	        } catch (error: any) {
160	          Logger.error(`获取文档列表失败:`, error);
161	          return {
162	            isError: true,
163	            content: [
164	              { 
165	                type: "text", 
166	                text: `获取文档列表失败: ${error.message || '未知错误'}` 
167	              }
168	            ]
