1	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
2	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
3	import { z } from "zod";
4	
5	const server = new McpServer({
6	  name: "Weather Server",
7	  version: "1.0.0"
8	});
9	
10	server.tool(
11	  'get-weather',
12	  'Tool to get the weather of a city',
13	  {
14	    city: z.string().describe("The name of the city to get the weather for")
15	  },
16	  async({ city }) => {
17	    try {
18	      const response = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${city}&count=10&language=en&format=json`);
19	      const data = await response.json();
20	      
21	      if (data.results.length === 0) {
22	        return {
23	          content: [
24	            {
25	              type: "text",
26	              text: `No results found for city: ${city}`
27	            }
28	          ]
29	        };
30	      }
31	      
32	      const { latitude, longitude } = data.results[0];
33	      const weatherResponse = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&hourly=temperature_2m,precipitation,apparent_temperature,relative_humidity_2m&forecast_days=1`);
34	      
35	      const weatherData = await weatherResponse.json();
36	      
37	      return {
38	        content: [
39	          {
40	            type: "text",
41	            text: JSON.stringify(weatherData, null, 2)
42	          }
43	        ]
44	      };
45	    } catch (error) {
46	      return {
47	        content: [
48	          {
49	            type: "text",
50	            text: `Error fetching weather data: ${error.message}`
51	          }
52	        ]
53	      };
54	    }
55	  }
56	);
57	
58	const transport = new StdioServerTransport();
59	server.connect(transport);
60	

