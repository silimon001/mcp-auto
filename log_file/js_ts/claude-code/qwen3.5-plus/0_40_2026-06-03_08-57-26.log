258	
259	function getTopNearestPositions(positions, latitude, longitude, size = 10) {
260	  return getOrderedPositionsByDistance(positions, latitude, longitude).slice(
261	    0,
262	    size
263	  );
264	}
265	
266	function getOrderedPositionsByDistance(positions, latitude, longitude) {
267	  return positions
268	    .map((position) => {
269	      const distanceInMeters = haversineDistanceInMeters(
270	        { lat: latitude, lon: longitude },
271	        position
272	      );
273	      return {
274	        ...position,
275	        distanceInMeters,
276	      };
277	    })
278	    .sort((a, b) => a.distanceInMeters - b.distanceInMeters);
279	}
280	
281	function haversineDistanceInMeters(position1, position2) {
282	  const toRadians = (degrees) => degrees * (Math.PI / 180);
283	
284	  const radiusOfEarth = 6371;
285	  const dLat = toRadians(position2.lat - position1.lat);
286	  const dLon = toRadians(position2.lon - position1.lon);
287	
288	  const a =
289	    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
290	    Math.cos(toRadians(position1.lat)) *
291	      Math.cos(toRadians(position2.lat)) *
292	      Math.sin(dLon / 2) *
293	      Math.sin(dLon / 2);
294	
295	  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
296	  return radiusOfEarth * c * 1000;
297	}
298	
299	async function main() {
300	  const serverType = process.env.MCP_SERVER_TYPE || "stdio";
301	  if (serverType === "http") {
302	    const app = express();
303	    app.use(express.json());
304	
305	    app.post("/mcp", async (req, res) => {
306	      console.log("Received POST MCP request");
307	      try {
308	        const server = getServer();
309	        const transport =
310	          new StreamableHTTPServerTransport({
311	            sessionIdGenerator: undefined,
312	          });
313	        res.on("close", () => {
314	          console.log("Request closed");
315	          transport.close();
316	          server.close();
317	        });
318	        await server.connect(transport);
319	        await transport.handleRequest(req, res, req.body);
320	      } catch (error) {
321	        console.error("Error handling MCP request:", error);
322	        if (!res.headersSent) {
323	          res.status(500).json({
324	            jsonrpc: "2.0",
325	            error: {
326	              code: -32603,
327	              message: "Internal server error",
328	            },
329	            id: null,
330	          });
331	        }
332	      }
333	    });
334	
335	    app.get("/mcp", async (req, res) => {
336	      console.log("Received GET MCP request");
337	      res.writeHead(405).end(
338	        JSON.stringify({
339	          jsonrpc: "2.0",
340	          error: {
341	            code: -32000,
342	            message: "Method not allowed.",
343	          },
344	          id: null,
345	        })
346	      );
347	    });
348	
349	    app.delete("/mcp", async (req, res) => {
350	      console.log("Received DELETE MCP request");
351	      res.writeHead(405).end(
352	        JSON.stringify({
353	          jsonrpc: "2.0",
354	          error: {
355	            code: -32000,
356	            message: "Method not allowed.",
357	          },
358	          id: null,
359	        })
360	      );
361	    });
362	
363	    const PORT = 3000;
364	    app.listen(PORT, () => {
365	      console.log(
366	        `MCP Stateless Streamable HTTP Server listening on port ${PORT}`
367	      );
368	    });
369	  } else {
370	    const server = getServer();
371	    const transport = new StdioServerTransport();
372	    await server.connect(transport);
373	    console.error("DNDzgz MCP Server running on stdio");
374	  }
375	}
376	
377	main().catch((error) => {
378	  console.error("Fatal error in main():", error);
379	  process.exit(1);
380	});
