273	    
274	    Logger.error = (...args: any[]) => {
275	      this.server.server.sendLoggingMessage({
276	        level: "error",
277	        data: args,
278	      });
279	      console.error(...args);
280	    };
281	
282	    Logger.log("服务器已连接，可以处理请求");
283	  }
284	}
