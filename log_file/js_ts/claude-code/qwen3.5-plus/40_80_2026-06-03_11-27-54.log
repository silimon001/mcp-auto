1	import { spawn } from 'child_process';
2	import { EventEmitter } from 'events';
3	import * as fs from 'fs';
4	import path from 'path';
5	import * as os from 'os';
6	export class ServerManager extends EventEmitter {
7	    process = null;
8	    config;
9	    isRunning = false;
10	    constructor(config) {
11	        super();
12	        this.config = this.validateConfig(config);
13	        process.on('exit', () => {
14	            this.killProcess();
15	        });
16	        process.on('SIGTERM', () => {
17	            this.killProcess();
18	        });
19	        process.on('SIGINT', () => {
20	            this.killProcess();
21	        });
22	    }
23	    killProcess() {
24	        if (this.process) {
25	            try {
26	                process.kill(-this.process.pid, 'SIGKILL');
27	            }
28	            catch (error) {
29	                // Ignore errors during force kill
30	            }
31	            this.process = null;
32	            this.isRunning = false;
33	        }
34	    }
35	    validateConfig(config) {
36	        if (!config.serverJarPath) {
37	            throw new Error('Server JAR path is required');
38	        }
39	        if (!config.port || config.port < 1 || config.port > 65535) {
40	            throw new Error('Invalid port number');
41	        }
42	        return {
43	            maxPlayers: config.maxPlayers || 20,
44	            port: config.port,
45	            serverJarPath: config.serverJarPath,
46	            memoryAllocation: config.memoryAllocation || '2G',
47	            username: config.username || 'MCPBot',
48	            version: config.version || '1.21'
49	        };
50	    }
51	    ensureEulaAccepted() {
52	        // Get the directory containing the server JAR
53	        const serverDir = path.dirname(this.config.serverJarPath);
54	        const eulaPath = path.join(serverDir, 'eula.txt');
55	        // Create or update eula.txt
56	        fs.writeFileSync(eulaPath, 'eula=true', 'utf8');
57	    }
58	    ensureServerProperties() {
59	        const serverDir = path.dirname(this.config.serverJarPath);
60	        const propsPath = path.join(serverDir, 'server.properties');
61	        let properties = '';
62	        if (fs.existsSync(propsPath)) {
63	            properties = fs.readFileSync(propsPath, 'utf8');
64	        }
65	        // Define our server properties for a simple plains world
66	        const serverProperties = {
67	            'online-mode': 'false',
68	            'level-type': 'flat',
69	            'spawn-protection': '0',
70	            'difficulty': 'peaceful', // No hostile mobs
71	            'spawn-monsters': 'false', // Disable monster spawning
72	            'spawn-animals': 'true', // Enable animal spawning
73	            'spawn-npcs': 'false', // Disable villagers
74	            'generate-structures': 'false', // Disable structures (villages, temples, etc)
75	            'allow-nether': 'false', // Disable nether
76	            'gamemode': 'creative', // Set creative mode for easier building
77	            'do-daylight-cycle': 'false',
78	            'max-players': this.config.maxPlayers.toString(),
79	            'server-port': this.config.port.toString(),
80	            'motd': 'Peaceful Plains Server'
81	        };
82	        // Update or create each property
83	        for (const [key, value] of Object.entries(serverProperties)) {
84	            const regex = new RegExp(`^${key}=.*$`, 'm');
85	            if (properties.match(regex)) {
86	                properties = properties.replace(regex, `${key}=${value}`);
87	            }
88	            else {
89	                properties += `\n${key}=${value}`;
90	            }
91	        }
92	        fs.writeFileSync(propsPath, properties.trim(), 'utf8');
93	    }
94	    normalizePath(p) {
95	        return path.normalize(p).toLowerCase();
96	    }
97	    expandHome(filepath) {
98	        if (filepath.startsWith("~/") || filepath === "~") {
99	            return path.join(os.homedir(), filepath.slice(1));
100	        }
101	        return filepath;
102	    }
103	    validateServerPath() {
104	        const expandedPath = this.expandHome(this.config.serverJarPath);
105	        const absolutePath = path.isAbsolute(expandedPath)
106	            ? path.resolve(expandedPath)
107	            : path.resolve(process.cwd(), expandedPath);
108	        if (!fs.existsSync(absolutePath)) {
109	            throw new Error(`Server JAR not found at path: ${absolutePath}`);
110	        }
111	        return absolutePath;
112	    }
113	    async start() {
114	        if (this.isRunning) {
115	            throw new Error('Server is already running');
116	        }
117	        return new Promise((resolve, reject) => {
118	            try {
