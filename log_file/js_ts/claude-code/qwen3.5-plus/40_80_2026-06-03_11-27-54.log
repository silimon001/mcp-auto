1	// MCP (Model Context Protocol) server implementation for OpenAI SDK knowledge
2	// This provides a standard interface for AI models to access structured knowledge
3	// MCP Protocol: https://modelcontextprotocol.io/
4	// MCP Specification: https://spec.modelcontextprotocol.io/
5	// ChatGPT Deep Research: https://platform.openai.com/docs/mcp
6	
7	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
8	import {
9	  CallToolRequestSchema,
10	  ListToolsRequestSchema,
11	} from "@modelcontextprotocol/sdk/types.js";
12	import { InputGuardrailTripwireTriggered } from "@openai/agents";
13	
14	import type { Env } from "@/env";
15	import { getVectorStore } from "@/storage/vector-store";
16	import { POLICY_MESSAGE } from "@/agents/guardrails/input-guardrails";
17	import { createMainAgent } from "@/agents/main-agent";
18	import { Logger } from "@/logger";
19	
20	export const SERVER_NAME = "openai-sdk-mcp";
21	
22	// MCP Server class implementing the Model Context Protocol
23	// Provides tools for searching OpenAI SDK knowledge and documentation
24	export class MCPServer {
25	  private server: Server;
26	  private env: Env;
27	
28	  constructor(env: Env) {
29	    this.env = env;
30	
31	    // Initialize MCP server with capabilities and metadata
32	    this.server = new Server(
33	      { name: SERVER_NAME, version: "1.0.0" },
34	      {
35	        capabilities: {
36	          tools: {}, // Enable tool calling capability
37	          resources: {}, // Enable resource access capability
38	        },
39	        instructions:
40	          "This MCP server helps developers to learn how to use OpenAI platform features and its SDKs. You can ask questions on how to call APIs, code examples using OpenAI Angents SDK for Python/TypeScript, and other questions on the platform features.",
41	      },
42	    );
43	
44	    // Initialize callback (currently no-op)
45	    this.server.oninitialized = () => {};
46	
47	    // Handle tool listing requests
48	    this.server.setRequestHandler(ListToolsRequestSchema, async () => {
49	      return { tools: buildTools(false) };
50	    });
51	
52	    // Handle tool execution requests
53	    // Route to appropriate tool implementation based on tool name
54	    this.server.setRequestHandler(CallToolRequestSchema, async (request) => {
55	      const { name, arguments: args } = request.params;
56	      if (!args) {
57	        throw new Error("Tool arguments are required");
58	      }
59	      switch (name) {
60	        case TOOL_ANSWER_OPENAI_QUESTIONS:
61	          return await this.callAnswerQuestion(args);
62	        case TOOL_LIST_OPENAI_RESOURCES:
63	          return await this.callListResources(args);
64	        case TOOL_CHATGPT_DR_SEARCH:
65	          return await this.callChatGPTDRSearch(args);
66	        case TOOL_CHATGPT_DR_FETCH:
67	          return await this.callChatGPTDRFetch(args);
68	        default:
69	          throw new Error(`Unknown tool: ${name}`);
70	      }
71	    });
72	  }
73	
74	  // Standard MCP search tool implementation
75	  // Uses RAG agent with web search fallback for comprehensive answers
76	  async callAnswerQuestion({ query, language }: Record<string, any>): Promise<{
77	    content: Array<{ type: string; text: string }>;
78	  }> {
79	    try {
80	      if (!this.env.OPENAI_API_KEY) {
81	        return {
82	          content: [
83	            { type: "text", text: "Error: OpenAI API key not configured" },
84	          ],
85	        };
86	      }
87	      try {
88	        // Use main agent which orchestrates RAG and web search
89	        const agent = createMainAgent(this.env);
90	        const result = await agent.generateResponse(query, language);
91	        return { content: [{ type: "text" as const, text: result }] };
92	      } catch (error) {
93	        // Handle input guardrail violations
94	        if (error instanceof InputGuardrailTripwireTriggered) {
95	          return {
96	            content: [{ type: "text" as const, text: POLICY_MESSAGE }],
97	          };
98	        }
99	        throw error;
100	      }
101	    } catch (error) {
102	      return {
103	        content: [
104	          {
105	            type: "text" as const,
106	            text: `Error searching documentation: ${error instanceof Error ? error.message : "Unknown error"}`,
107	          },
108	        ],
109	      };
110	    }
111	  }
112	
113	  async callListResources(args: Record<string, any>): Promise<{
114	    content: Array<{
115	      type: string;
116	      uri: string;
117	      name: string;
118	      description: string;
119	      mimeType: string;
120	    }>;
121	  }> {
122	    const { query, language, limit = 10 } = args;
123	    try {
124	      if (!this.env.OPENAI_API_KEY) {
125	        return { content: [] };
126	      }
127	
128	      // Use vector store for semantic search
129	      const vectorStore = await getVectorStore(this.env);
130	      const searchResults = await vectorStore.search(
131	        query,
132	        language,
133	        limit * 2,
134	      );
135	      const content = searchResults.slice(0, limit).map((result) => {
136	        return {
137	          type: "resource_link",
138	          uri:
139	            result.metadata?.url ||
140	            result.metadata?.sourceUrl ||
141	            "https://platform.openai.com/docs",
142	          name:
143	            result.metadata?.title ||
144	            result.metadata?.sourceTitle ||
145	            "OpenAI Documentation",
146	          description:
147	            result.content.substring(0, 500) +
148	            (result.content.length > 500 ? "..." : ""),
149	          mimeType: "text/plain",
150	        };
151	      });
152	      const response = { content };
153	      Logger.lazyDebug(() => `search result: ${JSON.stringify(response)}`);
154	      return response;
155	    } catch (error) {
156	      return { content: [] };
157	    }
158	  }
159	
160	  // ChatGPT Deep Research search tool implementation
161	  // Returns structured search results for research workflows
162	  // ChatGPT Deep Research: https://platform.openai.com/docs/mcp
163	  async callChatGPTDRSearch(
164	    args: Record<string, any>,
165	  ): Promise<{ results: ChatGPTDRSearchResult[] }> {
166	    const { query, limit = 10 } = args;
167	    try {
168	      if (!this.env.OPENAI_API_KEY) {
169	        return { results: [] };
170	      }
171	
172	      // Use vector store for semantic search
173	      const vectorStore = await getVectorStore(this.env);
174	      const searchResults = await vectorStore.search(query, limit);
175	
176	      // Format results for ChatGPT Deep Research connector
177	      // Each result includes id, title, text snippet, and url
178	      const results = searchResults.slice(0, limit).map((result) => {
179	        const url =
180	          result.metadata?.url ||
181	          result.metadata?.sourceUrl ||
182	          "https://platform.openai.com/docs";
183	        return {
184	          id: url,
185	          title:
186	            result.metadata?.title ||
187	            result.metadata?.sourceTitle ||
188	            "OpenAI Documentation",
189	          text:
190	            result.content.substring(0, 500) +
191	            (result.content.length > 500 ? "..." : ""),
192	          url,
193	        };
194	      });
195	      const response = { results };
196	      Logger.lazyDebug(() => `search result: ${JSON.stringify(response)}`);
197	      return response;
198	    } catch (error) {
199	      return { results: [] };
200	    }
201	  }
202	
203	  // ChatGPT Deep Research fetch tool implementation
204	  // Retrieves full document content by ID for detailed analysis
205	  // ChatGPT Deep Research: https://platform.openai.com/docs/mcp
206	  async callChatGPTDRFetch(
207	    args: Record<string, any>,
208	  ): Promise<ChatGPTDRFetchResult> {
209	    const { id, limit = 1 } = args;
210	    try {
211	      if (!this.env.OPENAI_API_KEY) {
212	        return {};
213	      }
214	
215	      // Search for document by URL/ID
216	      const vectorStore = await getVectorStore(this.env);
217	      const results = await vectorStore.search(`url:${id}`, limit);
218	
219	      // Find matching document by URL
220	      let matchingResult = results.find(
221	        (result) =>
222	          result.metadata?.url === id || result.metadata?.sourceUrl === id,
223	      );
224	      if (!matchingResult && results.length > 0) {
225	        matchingResult = results[0];
226	      }
227	      if (!matchingResult) {
228	        return {};
229	      }
230	
231	      // Return full document content with metadata
232	      const result = {
233	        id: id,
234	        title:
235	          matchingResult.metadata?.title ||
236	          matchingResult.metadata?.sourceTitle ||
237	          "OpenAI Documentation",
238	        text: matchingResult.content,
239	        url:
240	          matchingResult.metadata?.url ||
241	          matchingResult.metadata?.sourceUrl ||
242	          id,
243	        metadata: {
244	          source: "openai-docs",
245	          timestamp: new Date().toISOString(),
246	          originalMetadata: matchingResult.metadata,
247	        },
248	      };
249	      Logger.lazyDebug(() => `fetch result: ${JSON.stringify(result)}`);
250	      return result;
251	    } catch (error: any) {
252	      return { error: error.message };
253	    }
254	  }
255	}
