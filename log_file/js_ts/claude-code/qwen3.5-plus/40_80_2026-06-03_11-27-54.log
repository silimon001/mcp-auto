1	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
2	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
3	import { type Action, SolanaAgentKit } from "solana-agent-kit";
4	import { z } from "zod";
5	
6	// Define the raw shape type that MCP tools expect
7	type MinimalZodSchema = Pick<z.ZodTypeAny, "parse" | "optional" | "_def">;
8	
9	export type MCPSchemaShape = {
10	  [key: string]: MinimalZodSchema;
11	};
12	
13	// Type guards for Zod schema types
14	function isZodOptional(schema: z.ZodTypeAny): schema is z.ZodOptional<any> {
15	  return schema instanceof z.ZodOptional;
16	}
17	
18	function isZodObject(schema: z.ZodTypeAny): schema is z.ZodObject<any> {
19	  // Check both instanceof and the typeName property
20	  return (
21	    schema instanceof z.ZodObject || schema?._def?.typeName === "ZodObject"
22	  );
23	}
24	
25	/**
26	 * Converts a Zod object schema to a flat shape for MCP tools
27	 * @param schema The Zod schema to convert
28	 * @returns A flattened schema shape compatible with MCP tools
29	 * @throws Error if the schema is not an object type
30	 */
31	export function zodToMCPShape(schema: z.ZodTypeAny): {
32	  result: MCPSchemaShape;
33	  keys: string[];
34	} {
35	  if (!isZodObject(schema)) {
36	    throw new Error("MCP tools require an object schema at the top level");
37	  }
38	
39	  const shape: Record<string, z.ZodTypeAny> = schema.shape;
40	  const result: MCPSchemaShape = {};
41	
42	  for (const [key, value] of Object.entries(shape)) {
43	    result[key] = isZodOptional(value) ? value.unwrap() : value;
44	  }
45	
46	  return {
47	    result,
48	    keys: Object.keys(result),
49	  };
50	}
51	
52	/**
53	 * Creates an MCP server from a set of actions
54	 */
55	export function createMcpServer(
56	  actions: Record<string, Action>,
57	  solanaAgentKit: SolanaAgentKit,
58	  options: {
59	    name: string;
60	    version: string;
61	  },
62	) {
63	  // Create MCP server instance
64	  const server = new McpServer({
65	    name: options.name,
66	    version: options.version,
67	  });
68	
69	  // Convert each action to an MCP tool
70	  for (const [_key, action] of Object.entries(actions)) {
71	    const { result } = zodToMCPShape(action.schema);
72	    // @ts-ignore Type instantiation is excessively deep and possibly infinite.
73	    server.tool(action.name, action.description, result, async (params) => {
74	      try {
75	        // Execute the action handler with the params directly
76	        const result = await action.handler(solanaAgentKit, params);
77	
78	        // Format the result as MCP tool response
79	        return {
80	          content: [
81	            {
82	              type: "text" as const,
83	              text: JSON.stringify(result, null, 2),
84	            },
85	          ],
86	        } as const;
87	      } catch (error) {
88	        console.error("error", error);
89	        // Handle errors in MCP format
90	        return {
91	          isError: true,
92	          content: [
93	            {
94	              type: "text" as const,
95	              text:
96	                error instanceof Error
97	                  ? error.message
98	                  : "Unknown error occurred",
99	            },
100	          ],
101	        } as const;
102	      }
103	    });
104	
105	    // Add examples as prompts if they exist
106	    if (action.examples && action.examples.length > 0) {
107	      // @ts-ignore Type instantiation is excessively deep and possibly infinite.
108	      server.prompt(
109	        `${action.name}-examples`,
110	        {
111	          showIndex: z
112	            .string()
113	            .optional()
114	            .describe("Example index to show (number)"),
115	        },
116	        (args) => {
117	          const showIndex = args.showIndex
118	            ? parseInt(args.showIndex)
119	            : undefined;
120	          const examples = action.examples.flat();
121	          const selectedExamples =
122	            typeof showIndex === "number" ? [examples[showIndex]] : examples;
123	
124	          const exampleText = selectedExamples
125	            .map(
126	              (ex, idx) => `
127	Example ${idx + 1}:
128	Input: ${JSON.stringify(ex.input, null, 2)}
129	Output: ${JSON.stringify(ex.output, null, 2)}
130	Explanation: ${ex.explanation}
131	            `,
132	            )
133	            .join("\n");
134	
135	          return {
136	            messages: [
137	              {
138	                role: "user",
139	                content: {
140	                  type: "text",
141	                  text: `Examples for ${action.name}:\n${exampleText}`,
142	                },
143	              },
144	            ],
145	          };
146	        },
147	      );
148	    }
149	  }
150	
151	  return server;
152	}
153	
154	/**
155	 * Helper to start the MCP server with stdio transport
156	 *
157	 * @param actions - The actions to expose to the MCP server
158	 * @param solanaAgentKit - The Solana agent kit
159	 * @param options - The options for the MCP server
160	 * @returns The MCP server
161	 * @throws Error if the MCP server fails to start
162	 * @example
163	 * import { ACTIONS } from "./actions";
164	 * import { startMcpServer } from "./mcpWrapper";
165	 *
166	 * const solanaAgentKit = new SolanaAgentKit();
167	 *
168	 * startMcpServer(ACTIONS, solanaAgentKit, {
169	 *   name: "solana-actions",
170	 *   version: "1.0.0"
171	 * });
172	 */
173	export async function startMcpServer(
174	  actions: Record<string, Action>,
175	  solanaAgentKit: SolanaAgentKit,
176	  options: {
177	    name: string;
178	    version: string;
179	  },
180	) {
181	  try {
182	    const server = createMcpServer(actions, solanaAgentKit, options);
183	    const transport = new StdioServerTransport();
184	    await server.connect(transport);
185	    return server;
186	  } catch (error) {
187	    console.error("Error starting MCP server", error);
188	    throw error;
189	  }
190	}
