29	  async registerClient(
30	    userEmail: string,
31	    clientName: string,
32	    redirectUris: string[],
33	    scopes: string[] = ["mcp:read"],
34	  ): Promise<{ clientId: string; clientSecret: string }> {
35	    const clientId = `mcp_${crypto.randomUUID()}`;
36	    const clientSecret = `mcp_secret_${crypto.randomUUID().replace(/-/g, "")}${crypto.randomUUID().replace(/-/g, "")}`;
37	
38	    const encoder = new TextEncoder();
39	    const data = encoder.encode(clientSecret);
40	    const hashBuffer = await crypto.subtle.digest("SHA-256", data);
41	    const hashArray = Array.from(new Uint8Array(hashBuffer));
42	    const clientSecretHash = hashArray
43	      .map((b) => b.toString(16).padStart(2, "0"))
44	      .join("");
45	
46	    const now = new Date().toISOString();
47	    const id = crypto.randomUUID();
48	
49	    await this.db
50	      .insert(mcpClients)
51	      .values({
52	        id,
53	        clientId,
54	        clientSecretHash,
55	        clientName,
56	        redirectUris: JSON.stringify(redirectUris),
57	        scopes: JSON.stringify(scopes),
58	        userEmail,
59	        createdAt: now,
60	      })
61	      .run();
62	
63	    return { clientId, clientSecret };
64	  }
65	
66	  async validateClient(
67	    clientId: string,
68	    clientSecret?: string,
69	  ): Promise<MCPClient | null> {
70	    const result = await this.db
71	      .select()
72	      .from(mcpClients)
73	      .where(
74	        and(eq(mcpClients.clientId, clientId), eq(mcpClients.isActive, true)),
75	      )
76	      .get();
77	    if (!result) return null;
78	
79	    if (clientSecret) {
80	      const encoder = new TextEncoder();
81	      const data = encoder.encode(clientSecret);
82	      const hashBuffer = await crypto.subtle.digest("SHA-256", data);
83	      const hashArray = Array.from(new Uint8Array(hashBuffer));
84	      const providedHash = hashArray
85	        .map((b) => b.toString(16).padStart(2, "0"))
86	        .join("");
87	
88	      if (providedHash !== result.clientSecretHash) {
89	        return null;
90	      }
91	    }
92	
93	    return {
94	      clientId: result.clientId,
95	      clientName: result.clientName,
96	      redirectUris: JSON.parse(result.redirectUris),
97	      scopes: JSON.parse(result.scopes),
98	      userEmail: result.userEmail,
99	      createdAt: result.createdAt,
