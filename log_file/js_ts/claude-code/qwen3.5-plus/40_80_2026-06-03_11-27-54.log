193	    // Tool: search and replace in a note
194	    server.registerTool(
195	        'search-replace-note',
196	        {
197	            title: 'Search and Replace In Note',
198	            description: 'Search for text in a note and replace it.',
199	            annotations: {
200	                destructiveHint: true,
201	            },
202	            inputSchema: {
203	                filename: z.string().describe('The filename of the note to modify'),
204	                searchPattern: z.string().describe('The text or regex pattern to search for'),
205	                replaceText: z.string().describe('The text to replace matches with'),
206	                useRegex: z.boolean().default(false).describe('Whether to treat searchPattern as a regex'),
207	                caseSensitive: z.boolean().default(false).describe('Whether search should be case-sensitive'),
208	                replaceAll: z.boolean().default(true).describe('Whether to replace all matches or just the first one'),
209	            },
210	        },
211	        async ({ filename, searchPattern, replaceText, useRegex, caseSensitive, replaceAll }) => {
212	            try {
213	                // Read the current content
214	                const content = await readNoteAPI(filename);
215	                
216	                let searchRegex: RegExp;
217	                let regexInvalidFallback = false;
218	
219	                if (useRegex) {
220	                    try {
221	                        const flags = caseSensitive ? (replaceAll ? 'g' : '') : (replaceAll ? 'gi' : 'i');
222	                        searchRegex = new RegExp(searchPattern, flags);
223	                    } catch (error) {
224	                        // If regex is invalid, escape special characters and treat as literal
225	                        const escapedPattern = searchPattern.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
226	                        const flags = caseSensitive ? (replaceAll ? 'g' : '') : (replaceAll ? 'gi' : 'i');
227	                        searchRegex = new RegExp(escapedPattern, flags);
228	                        regexInvalidFallback = true;
229	                    }
230	                } else {
231	                    // Escape the search pattern for literal matching
232	                    const escapedPattern = searchPattern.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
233	                    const flags = caseSensitive ? (replaceAll ? 'g' : '') : (replaceAll ? 'gi' : 'i');
234	                    searchRegex = new RegExp(escapedPattern, flags);
235	                }
236	
237	                // Count matches before replacement
238	                const matches = content.match(searchRegex);
239	                const matchCount = matches ? matches.length : 0;
240	
241	                if (matchCount === 0) {
242	                    return {
243	                        content: [
244	                            {
245	                                type: 'text',
246	                                text: `No matches found for "${searchPattern}" in ${filename}`,
247	                            },
248	                        ],
249	                    };
250	                }
251	
252	                // Perform replacement
253	                const newContent = content.replace(searchRegex, replaceText);
254	                
255	                // Write back the modified content
256	                await writeNoteAPI(filename, newContent);
257	
258	                let resultMessage = `Successfully replaced ${matchCount} occurrence${matchCount === 1 ? '' : 's'} of "${searchPattern}" in ${filename}`;
259	                
260	                if (regexInvalidFallback) {
261	                    resultMessage += '\nNote: Invalid regex pattern was treated as literal text.';
262	                }
263	
264	                return {
265	                    content: [
266	                        {
267	                            type: 'text',
268	                            text: resultMessage,
269	                        },
270	                    ],
271	                };
272	            } catch (error) {
273	                console.error(`[MCP Tool: search-replace-note] Error modifying note ${filename}:`, error);
274	                return {
275	                    content: [
276	                        {
277	                            type: 'text',
278	                            text: `Failed to modify note: ${
279	                                error instanceof Error ? error.message : 'Unknown error'
280	                            }`,
281	                        },
282	                    ],
283	                    isError: true,
284	                };
285	            }
286	        }
287	    );
