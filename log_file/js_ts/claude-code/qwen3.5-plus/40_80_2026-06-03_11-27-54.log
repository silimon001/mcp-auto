27	export const mcpServerHandler = async (c: Context<{ Bindings: Env }>) => {
28	  const contentType = c.req.header("Content-Type");
29	  if (!contentType || !contentType.includes("application/json")) {
30	    return c.json(
31	      {
32	        jsonrpc: "2.0",
33	        error: {
34	          code: -32600,
35	          message: "Invalid Request",
36	          data: "Content-Type must be application/json",
37	        },
38	        id: null,
39	      },
40	      400,
41	    );
42	  }
43	  const request = (await c.req.json()) as JsonRpcRequest;
44	  const requestId = request.id ?? null;
45	  try {
46	    if (!request || typeof request !== "object") {
47	      return c.json(
48	        {
49	          jsonrpc: "2.0",
50	          error: { code: -32700, message: "Parse error" },
51	          id: null,
52	        },
53	        400,
54	      );
55	    }
56	
57	    if (request.jsonrpc !== "2.0") {
58	      return c.json(
59	        {
60	          jsonrpc: "2.0",
61	          error: { code: -32600, message: "Invalid Request" },
62	          id: requestId,
63	        },
64	        400,
65	      );
66	    }
67	
68	    if (request.method === "initialize") {
69	      const sessionId = crypto.randomUUID();
70	      c.header("Mcp-Session-Id", sessionId);
71	      c.header("Access-Control-Expose-Headers", "Mcp-Session-Id");
72	    }
73	
74	    const requestHeaders = c.req.header();
75	    const response = await new JsonRpcHandler(c.env).handleJsonRpcRequest(
76	      request,
77	      requestHeaders,
78	    );
79	    return c.json(response);
80	  } catch (error) {
81	    Logger.error("Error in /mcp endpoint:", error);
82	    return c.json(
83	      {
84	        jsonrpc: "2.0",
85	        error: {
86	          code: -32603,
87	          message: "Internal error",
88	          data: error instanceof Error ? error.message : "Unknown error",
89	        },
90	        id: requestId,
91	      },
92	      500,
93	    );
94	  }
95	};
96	
97	export const mcpOAuthRegisterHandler = async (
98	  c: Context<{ Bindings: Env }>,
99	) => {
100	  try {
101	    const { client_name, redirect_uris, scopes } = await c.req.json();
102	
103	    if (!client_name || !redirect_uris || !Array.isArray(redirect_uris)) {
104	      return c.json(
105	        { error: "client_name and redirect_uris are required" },
106	        400,
107	      );
108	    }
109	
110	    for (const uri of redirect_uris) {
111	      try {
112	        const url = new URL(uri);
113	        if (url.protocol !== "https:" && url.hostname !== "localhost") {
114	          return c.json(
115	            {
116	              error: `Invalid redirect URI: ${uri}. Must be HTTPS or localhost`,
117	            },
118	            400,
119	          );
120	        }
121	      } catch {
122	        return c.json({ error: `Invalid redirect URI: ${uri}` }, 400);
123	      }
124	    }
125	
126	    const mcpOAuth = new MCPOAuth(c.env);
127	    const result = await mcpOAuth.registerClient(
128	      "system@mcp-server.local",
129	      client_name,
130	      redirect_uris,
131	      scopes || ["mcp:read"],
132	    );
133	
134	    return c.json({
135	      client_id: result.clientId,
136	      client_secret: result.clientSecret,
137	      client_name,
138	      redirect_uris,
139	      scopes: scopes || ["mcp:read"],
140	    });
141	  } catch (error) {
142	    Logger.error("MCP client registration error", {
143	      error: (error as Error).message,
144	    });
145	    return c.json({ error: "Client registration failed" }, 500);
146	  }
147	};
148	
149	export const mcpOAuthAuthorizeHandler = async (
150	  c: Context<{ Bindings: Env }>,
151	) => {
152	  try {
153	    const clientId = c.req.query("client_id");
154	    const redirectUri = c.req.query("redirect_uri");
155	    const responseType = c.req.query("response_type");
156	    const scope = c.req.query("scope");
157	    const state = c.req.query("state");
158	    const codeChallenge = c.req.query("code_challenge");
159	    const codeChallengeMethod = c.req.query("code_challenge_method");
160	
161	    if (!clientId || !redirectUri || responseType !== "code") {
162	      return c.json({ error: "Invalid request parameters" }, 400);
163	    }
164	
165	    const mcpOAuth = new MCPOAuth(c.env);
166	    const client = await mcpOAuth.validateClient(clientId);
167	
168	    if (!client) {
169	      return c.json({ error: "Invalid client_id" }, 400);
170	    }
171	
172	    if (!client.redirectUris.includes(redirectUri)) {
173	      return c.json({ error: "Invalid redirect_uri" }, 400);
174	    }
175	
176	    const auth = new Auth(c.env);
177	    const user = await auth.getCurrentUser(c);
178	
179	    if (!user) {
180	      const mcpState = encodeURIComponent(
181	        JSON.stringify({
182	          client_id: clientId,
183	          redirect_uri: redirectUri,
184	          scope: scope || "mcp:read",
185	          state,
186	          code_challenge: codeChallenge,
187	          code_challenge_method: codeChallengeMethod,
188	          type: "mcp_oauth",
189	        }),
190	      );
191	      const authUrl = auth.buildGoogleAuthUrl({ mcpState });
192	      return c.redirect(authUrl);
193	    }
194	
195	    const scopes = scope ? scope.split(" ") : ["mcp:read"];
196	    return c.html(
197	      renderOAuthAuthorizePage({
198	        clientId,
199	        redirectUri,
200	        scope,
201	        state,
202	        codeChallenge,
203	        codeChallengeMethod,
204	        clientName: client.clientName,
205	        user,
206	        scopes,
207	      }),
208	    );
209	  } catch (error) {
210	    Logger.error("MCP OAuth authorize error", {
211	      error: (error as Error).message,
212	    });
213	    return c.json({ error: "Authorization failed" }, 500);
214	  }
215	};
216	
217	export const mcpOAuthConsentHandler = async (c: Context<{ Bindings: Env }>) => {
218	  try {
219	    const user = (c as any).get("user") as AuthUser;
220	    const formData = await c.req.formData();
221	
222	    const clientId = formData.get("client_id") as string;
223	    const redirectUri = formData.get("redirect_uri") as string;
224	    const scope = formData.get("scope") as string;
225	    const state = formData.get("state") as string;
226	    const action = formData.get("action") as string;
227	    const codeChallenge = formData.get("code_challenge") as string;
228	    const codeChallengeMethod = formData.get("code_challenge_method") as string;
229	
230	    if (action === "deny") {
231	      const errorUrl = new URL(redirectUri);
232	      errorUrl.searchParams.set("error", "access_denied");
233	      if (state) errorUrl.searchParams.set("state", state);
234	      return c.redirect(errorUrl.toString());
235	    }
236	
237	    const mcpOAuth = new MCPOAuth(c.env);
238	    const scopes = scope ? scope.split(" ") : ["mcp:read"];
239	
240	    const authCode = await mcpOAuth.generateAuthorizationCode(
241	      clientId,
242	      user.email,
243	      redirectUri,
244	      scopes,
245	      codeChallenge,
246	      codeChallengeMethod,
247	    );
248	
249	    const successUrl = new URL(redirectUri);
250	    successUrl.searchParams.set("code", authCode);
251	    if (state) successUrl.searchParams.set("state", state);
252	
253	    return c.redirect(successUrl.toString());
254	  } catch (error) {
255	    Logger.error("MCP OAuth consent error", {
256	      error: (error as Error).message,
257	    });
258	    return c.json({ error: "Consent processing failed" }, 500);
259	  }
260	};
261	
262	export const mcpOAuthTokenHandler = async (c: Context<{ Bindings: Env }>) => {
263	  try {
264	    const contentType = c.req.header("Content-Type");
265	    let grantType: string,
266	      code: string,
267	      redirectUri: string,
268	      clientId: string,
269	      clientSecret: string,
270	      codeVerifier: string;
271	
272	    if (contentType?.includes("application/x-www-form-urlencoded")) {
273	      const formData = await c.req.formData();
274	      grantType = formData.get("grant_type") as string;
275	      code = formData.get("code") as string;
276	      redirectUri = formData.get("redirect_uri") as string;
277	      clientId = formData.get("client_id") as string;
278	      clientSecret = formData.get("client_secret") as string;
279	      codeVerifier = formData.get("code_verifier") as string;
280	    } else {
281	      const body = await c.req.json();
282	      ({
283	        grant_type: grantType,
284	        code,
285	        redirect_uri: redirectUri,
286	        client_id: clientId,
287	        client_secret: clientSecret,
288	        code_verifier: codeVerifier,
289	      } = body);
290	    }
291	
292	    if (!clientId || !clientSecret) {
293	      const authHeader = c.req.header("Authorization");
294	      if (authHeader && authHeader.startsWith("Basic ")) {
295	        try {
296	          const base64Credentials = authHeader.slice(6); // Remove "Basic " prefix
297	          const credentials = atob(base64Credentials);
298	          const [headerClientId, headerClientSecret] = credentials.split(
299	            ":",
300	            2,
301	          );
302	
303	          if (headerClientId && headerClientSecret) {
304	            clientId = clientId || headerClientId;
305	            clientSecret = clientSecret || headerClientSecret;
306	          }
307	        } catch (error) {
308	          Logger.warn("Failed to parse Authorization header", {
309	            error: (error as Error).message,
310	          });
311	        }
312	      }
313	    }
314	
315	    Logger.lazyDebug(
316	      () =>
317	        `MCP OAuth token request ${JSON.stringify({
318	          grantType,
319	          clientId,
320	          redirectUri,
321	          hasCode: !!code,
322	          hasClientSecret: !!clientSecret,
323	          hasCodeVerifier: !!codeVerifier,
324	        })}`,
325	    );
326	
327	    if (grantType !== "authorization_code") {
328	      Logger.warn("Invalid grant type", { grantType });
329	      return c.json({ error: "unsupported_grant_type" }, 400);
330	    }
331	
332	    if (!code || !redirectUri || !clientId || !clientSecret) {
333	      Logger.warn("Missing required parameters", {
334	        hasCode: !!code,
335	        hasRedirectUri: !!redirectUri,
336	        hasClientId: !!clientId,
337	        hasClientSecret: !!clientSecret,
338	      });
339	      return c.json({ error: "invalid_request" }, 400);
340	    }
341	
342	    const mcpOAuth = new MCPOAuth(c.env);
343	
344	    const client = await mcpOAuth.validateClient(clientId, clientSecret);
345	    if (!client) {
346	      Logger.warn("Client validation failed", { clientId });
347	      return c.json({ error: "invalid_client" }, 401);
348	    }
349	
350	    Logger.lazyDebug(
351	      () =>
352	        `Client validated successfully ${JSON.stringify({
353	          clientId,
354	          clientName: client.clientName,
355	        })}`,
356	    );
357	
358	    const authResult = await mcpOAuth.validateAndConsumeAuthorizationCode(
359	      code,
360	      clientId,
361	      redirectUri,
362	      codeVerifier,
363	    );
364	    if (!authResult) {
365	      Logger.warn("Authorization code validation failed", {
366	        code,
367	        clientId,
368	        redirectUri,
369	        hasCodeVerifier: !!codeVerifier,
370	      });
371	      return c.json({ error: "invalid_grant" }, 400);
372	    }
373	
374	    Logger.lazyDebug(
375	      () =>
376	        `Authorization code validated successfully ${JSON.stringify({
377	          userEmail: authResult.userEmail,
378	          scopes: authResult.scopes,
379	        })}`,
380	    );
381	
382	    const accessToken = await mcpOAuth.generateMCPAccessToken(
383	      authResult.userEmail,
384	      clientId,
385	      authResult.scopes,
386	    );
387	
388	    Logger.info("MCP OAuth token generated successfully", {
389	      clientId,
390	      userEmail: authResult.userEmail,
391	    });
392	
393	    return c.json({
394	      access_token: accessToken,
395	      token_type: "Bearer",
396	      expires_in: 30 * 24 * 60 * 60,
397	      scope: authResult.scopes.join(" "),
398	    });
399	  } catch (error) {
400	    Logger.error("MCP OAuth token error", {
401	      error: (error as Error).message,
402	      stack: (error as Error).stack,
403	    });
404	    return c.json({ error: "server_error" }, 500);
405	  }
406	};
