93	  } catch (error) {
94	    const message =
95	      error instanceof Error ? error.message : "Unknown JSON parse error";
96	    throw new Error(`Invalid Rollbar config file "${filePath}": ${message}`);
97	  }
98	
99	  const multi = RollbarMcpConfigSchema.safeParse(json);
100	  if (multi.success) {
101	    const sharedApiBase = normalizeApiBase(multi.data.apiBase);
102	    return multi.data.projects.map((p) => ({
103	      name: p.name,
104	      token: p.token,
105	      apiBase: sharedApiBase,
106	    }));
107	  }
108	
109	  const shorthand = RollbarMcpConfigShorthandSchema.safeParse(json);
110	  if (shorthand.success) {
111	    const apiBase = normalizeApiBase(shorthand.data.apiBase);
112	    return [
113	      {
114	        name: "default",
115	        token: shorthand.data.token,
116	        apiBase,
117	      },
118	    ];
119	  }
120	
121	  throw new Error(
122	    `Invalid Rollbar config file "${filePath}": expected either a single-project config like { "token": "..." } or a multi-project config like { "projects": [...] }.`,
123	  );
124	}
125	
126	function exitWithError(message: string): never {
127	  console.error(message);
128	  process.exit(1);
129	  return undefined as never;
130	}
131	
132	function loadConfig(): ProjectConfig[] {
133	  // 1. ROLLBAR_CONFIG_FILE env var
134	  const configFileEnv = process.env.ROLLBAR_CONFIG_FILE?.trim();
135	  if (configFileEnv) {
136	    const resolved = path.isAbsolute(configFileEnv)
137	      ? configFileEnv
138	      : path.resolve(process.cwd(), configFileEnv);
139	    try {
140	      const projects = loadProjectsFromFile(resolved);
141	      if (projects) {
142	        return projects;
143	      }
144	    } catch (error) {
145	      return exitWithError(
146	        error instanceof Error ? error.message : "Invalid Rollbar config file",
147	      );
148	    }
149	    return exitWithError(
150	      `Error: ROLLBAR_CONFIG_FILE="${configFileEnv}" was not found.`,
151	    );
152	  }
153	
154	  // 2. .rollbar-mcp.json in process.cwd()
155	  const cwdPath = path.join(process.cwd(), ".rollbar-mcp.json");
156	  try {
157	    const fromCwd = loadProjectsFromFile(cwdPath);
158	    if (fromCwd) return fromCwd;
159	  } catch (error) {
160	    return exitWithError(
161	      error instanceof Error ? error.message : "Invalid Rollbar config file",
162	    );
163	  }
164	
165	  // 3. ~/.rollbar-mcp.json
166	  const homePath = path.join(homedir(), ".rollbar-mcp.json");
167	  try {
168	    const fromHome = loadProjectsFromFile(homePath);
169	    if (fromHome) return fromHome;
170	  } catch (error) {
171	    return exitWithError(
172	      error instanceof Error ? error.message : "Invalid Rollbar config file",
173	    );
174	  }
175	
176	  // 4. ROLLBAR_ACCESS_TOKEN env var — synthesize single project
177	  const token = process.env.ROLLBAR_ACCESS_TOKEN?.trim();
178	  if (token && token.length > 0) {
179	    const apiBase = resolveApiBaseFromEnv();
180	    if (apiBase === null) {
181	      return exitWithError(
182	        "Error: ROLLBAR_API_BASE must be a valid HTTP(S) URL when using ROLLBAR_ACCESS_TOKEN.",
183	      );
184	    }
185	    return [
186	      {
187	        name: "default",
188	        token,
189	        apiBase,
190	      },
191	    ];
192	  }
193	
194	  return exitWithError(
195	    "Error: No Rollbar configuration found. Set ROLLBAR_ACCESS_TOKEN, or create .rollbar-mcp.json (in cwd or home), or set ROLLBAR_CONFIG_FILE.",
196	  );
197	}
198	
199	export const PROJECTS: ProjectConfig[] = loadConfig();
200	
201	export function resolveProject(name: string | undefined): ProjectConfig {
202	  if (PROJECTS.length === 1 && name === undefined) {
203	    return PROJECTS[0];
204	  }
205	  if (name === undefined) {
206	    throw new Error(
207	      `Multiple projects configured. Specify a project name. Available: ${PROJECTS.map((p) => p.name).join(", ")}`,
208	    );
209	  }
210	  const found = PROJECTS.find((p) => p.name === name);
211	  if (!found) {
212	    throw new Error(
213	      `Unknown project "${name}". Available: ${PROJECTS.map((p) => p.name).join(", ")}`,
214	    );
215	  }
216	  return found;
217	}
218	
219	export function getUserAgent(toolName: string): string {
220	  return `rollbar-mcp-server/${packageJson.version} (tool: ${toolName})`;
221	}
