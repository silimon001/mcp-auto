119	        code,
120	        clientId,
121	        userEmail,
122	        redirectUri,
123	        scopes: JSON.stringify(scopes),
124	        codeChallenge,
125	        codeChallengeMethod,
126	        expiresAt,
127	        createdAt: now,
128	      })
129	      .run();
130	
131	    return code;
132	  }
133	
134	  async validateAndConsumeAuthorizationCode(
135	    code: string,
136	    clientId: string,
137	    redirectUri: string,
138	    codeVerifier?: string,
139	  ): Promise<{ userEmail: string; scopes: string[] } | null> {
140	    const result = await this.db
141	      .select()
142	      .from(mcpAuthorizationCodes)
143	      .where(
144	        and(
145	          eq(mcpAuthorizationCodes.code, code),
146	          eq(mcpAuthorizationCodes.clientId, clientId),
147	          eq(mcpAuthorizationCodes.redirectUri, redirectUri),
148	        ),
149	      )
150	      .get();
151	    if (!result) {
152	      Logger.lazyDebug(
153	        () =>
154	          `Authorization code not found ${JSON.stringify({
155	            code,
156	            clientId,
157	            redirectUri,
158	          })}`,
159	      );
160	      return null;
161	    }
162	
163	    if (result.usedAt) {
164	      Logger.lazyDebug(
165	        () =>
166	          `Authorization code already used ${JSON.stringify({
167	            code,
168	            usedAt: result.usedAt,
169	          })}`,
170	      );
171	      return null;
172	    }
173	
174	    if (new Date(result.expiresAt) < new Date()) {
175	      Logger.lazyDebug(
176	        () =>
177	          `Authorization code expired ${JSON.stringify({
178	            code,
179	            expiresAt: result.expiresAt,
180	          })}`,
181	      );
182	      return null;
183	    }
184	
185	    if (result.codeChallenge && result.codeChallengeMethod === "S256") {
186	      if (!codeVerifier) {
187	        Logger.lazyDebug(
188	          () =>
189	            `PKCE code verifier missing ${JSON.stringify({
190	              code,
191	              hasCodeChallenge: !!result.codeChallenge,
192	            })}`,
193	        );
194	        return null;
195	      }
196	
197	      try {
198	        const encoder = new TextEncoder();
199	        const data = encoder.encode(codeVerifier);
200	        const hashBuffer = await crypto.subtle.digest("SHA-256", data);
201	        const hashArray = Array.from(new Uint8Array(hashBuffer));
202	        const hash = btoa(String.fromCharCode(...hashArray))
203	          .replace(/\+/g, "-")
204	          .replace(/\//g, "_")
205	          .replace(/=/g, "");
206	
207	        Logger.lazyDebug(
208	          () =>
209	            `PKCE verification ${JSON.stringify({
210	              codeChallenge: result.codeChallenge,
211	              computedHash: hash,
212	              codeVerifierLength: codeVerifier.length,
213	            })}`,
214	        );
215	
216	        if (hash !== result.codeChallenge) {
217	          Logger.warn("PKCE code challenge verification failed", {
218	            expected: result.codeChallenge,
219	            computed: hash,
220	            codeVerifierLength: codeVerifier.length,
221	          });
222	          return null;
223	        }
224	      } catch (error) {
225	        Logger.error("PKCE verification error", {
226	          error: (error as Error).message,
227	        });
228	        return null;
229	      }
230	    }
231	
232	    await this.db
233	      .update(mcpAuthorizationCodes)
234	      .set({
235	        usedAt: new Date().toISOString(),
236	      })
237	      .where(eq(mcpAuthorizationCodes.code, code))
238	      .run();
239	
240	    Logger.lazyDebug(
241	      () =>
242	        `Authorization code consumed successfully ${JSON.stringify({
243	          code,
244	          userEmail: result.userEmail,
245	        })}`,
246	    );
247	
248	    return {
249	      userEmail: result.userEmail,
250	      scopes: JSON.parse(result.scopes),
251	    };
252	  }
253	
254	  async generateMCPAccessToken(
255	    userEmail: string,
256	    clientId: string,
257	    _scopes: string[],
258	  ): Promise<string> {
259	    try {
260	      const auth = new Auth(this.env);
261	      const existingToken = await auth.findMCPTokenByClientId(
262	        userEmail,
263	        clientId,
264	      );
265	      if (existingToken) {
266	        Logger.lazyDebug(
267	          () =>
268	            `Reusing existing MCP access token ${JSON.stringify({
269	              userEmail,
270	              clientId,
271	              tokenId: existingToken.id,
272	            })}`,
273	        );
274	        await auth.updateTokenLastUsed(existingToken.id);
275	        await auth.revokeToken(existingToken.id, userEmail);
276	      }
277	
278	      const clientName = await this.getClientName(clientId);
279	      const tokenName = clientName
280	        ? `OAuth: ${clientName}`
281	        : `OAuth: ${clientId}`;
282	      const expiresInDays = 365;
283	
284	      Logger.lazyDebug(
285	        () =>
286	          `Generating MCP access token ${JSON.stringify({
287	            userEmail,
288	            clientId,
289	            clientName,
290	            tokenName,
291	            reusingExisting: !!existingToken,
292	          })}`,
293	      );
294	
295	      const result = await auth.generateApiToken(
296	        userEmail,
297	        tokenName,
298	        expiresInDays,
299	        true,
300	      );
301	
302	      Logger.lazyDebug(
303	        () =>
304	          `MCP access token generated successfully ${JSON.stringify({
305	            userEmail,
306	            clientId,
307	            tokenId: result.tokenRecord.id,
308	          })}`,
309	      );
310	
311	      return result.token;
312	    } catch (error) {
313	      Logger.error("Failed to generate MCP access token", {
314	        error: (error as Error).message,
315	        userEmail,
316	        clientId,
317	      });
318	      throw error;
319	    }
320	  }
321	
