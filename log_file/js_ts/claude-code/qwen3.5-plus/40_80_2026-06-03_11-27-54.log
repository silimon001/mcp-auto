1	import { startStdioServer } from './server/stdio';
2	import { startSseServer } from './server/sse';
3	import dotenv from 'dotenv';
4	import { log } from './utils/logger';
5	
6	// Load environment variables from .env file
7	dotenv.config();
8	
9	/**
10	 * Main entry point
11	 */
12	async function main(): Promise<void> {
13	  // Parse command-line arguments
14	  const args = process.argv.slice(2);
15	  const isStdio = args.includes('--stdio');
16	  const isSse = args.includes('--sse');
17	  
18	  // Get the SSE port from environment variable or use default
19	  const ssePort = process.env.SERVER_PORT ? parseInt(process.env.SERVER_PORT, 10) : 3001;
20	  
21	  // Start the appropriate server
22	  if (isStdio) {
23	    log.info('Starting GameBoy MCP server in stdio mode');
24	    await startStdioServer();
25	  } else if (isSse) {
26	    log.info(`Starting GameBoy MCP server in SSE mode on port ${ssePort}`);
27	    await startSseServer(ssePort);
28	  } else {
29	    // Default to stdio mode
30	    log.info('No mode specified, defaulting to stdio mode');
31	    await startStdioServer();
32	  }
33	}
34	
35	// Run the main function
36	main().catch(error => {
37	  log.error(`Error: ${error}`);
38	  process.exit(1);
39	});
