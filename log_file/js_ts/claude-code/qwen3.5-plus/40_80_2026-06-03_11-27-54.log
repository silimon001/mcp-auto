209	      ? new Date(Date.now() + expiresInDays * 24 * 60 * 60 * 1000).toISOString()
210	      : null;
211	
212	    const tokenRecord: ApiToken = {
213	      id: tokenId,
214	      user_email: userEmail,
215	      name,
216	      created_at: now,
217	      expires_at: expiresAt || undefined,
218	      last_used_at: undefined,
219	      is_revoked: false,
220	    };
221	
222	    await this.db
223	      .insert(apiTokens)
224	      .values({
225	        id: tokenId,
226	        userEmail,
227	        tokenHash,
228	        name,
229	        createdAt: now,
230	        expiresAt,
231	        isRevoked: false,
232	      })
233	      .run();
234	
235	    return { token, tokenRecord };
236	  }
237	
238	  async validateApiToken(
239	    token: string,
240	  ): Promise<{ valid: boolean; userEmail?: string; tokenId?: string }> {
241	    if (!token.startsWith("mcp_")) {
242	      return { valid: false };
243	    }
244	
245	    const encoder = new TextEncoder();
246	    const data = encoder.encode(token);
247	    const hashBuffer = await crypto.subtle.digest("SHA-256", data);
248	    const hashArray = Array.from(new Uint8Array(hashBuffer));
249	    const tokenHash = hashArray
250	      .map((b) => b.toString(16).padStart(2, "0"))
251	      .join("");
252	
253	    const result = await this.db
254	      .select({
255	        id: apiTokens.id,
256	        user_email: apiTokens.userEmail,
257	        expires_at: apiTokens.expiresAt,
258	        is_revoked: apiTokens.isRevoked,
259	      })
260	      .from(apiTokens)
261	      .where(eq(apiTokens.tokenHash, tokenHash))
262	      .get();
263	
264	    if (!result || result.is_revoked) {
265	      return { valid: false };
266	    }
267	
268	    if (
269	      result.expires_at &&
270	      new Date(result.expires_at as string) < new Date()
271	    ) {
272	      return { valid: false };
273	    }
274	
275	    return {
276	      valid: true,
277	      userEmail: result.user_email as string,
278	      tokenId: result.id as string,
279	    };
280	  }
281	
282	  async listUserTokens(userEmail: string): Promise<ApiToken[]> {
283	    const results = await this.db
284	      .select({
285	        id: apiTokens.id,
286	        user_email: apiTokens.userEmail,
287	        name: apiTokens.name,
288	        created_at: apiTokens.createdAt,
289	        expires_at: apiTokens.expiresAt,
290	        last_used_at: apiTokens.lastUsedAt,
291	        is_revoked: apiTokens.isRevoked,
292	      })
293	      .from(apiTokens)
294	      .where(
295	        and(eq(apiTokens.userEmail, userEmail), eq(apiTokens.isRevoked, false)),
296	      )
297	      .orderBy(desc(apiTokens.createdAt))
298	      .all();
299	    return results as ApiToken[];
300	  }
301	
302	  async revokeToken(tokenId: string, userEmail: string): Promise<boolean> {
303	    const result = await this.db
304	      .update(apiTokens)
305	      .set({ isRevoked: true })
306	      .where(and(eq(apiTokens.id, tokenId), eq(apiTokens.userEmail, userEmail)))
307	      .run();
308	    return result.success ?? false;
309	  }
310	
311	  async updateTokenLastUsed(tokenId: string): Promise<void> {
312	    await this.db
313	      .update(apiTokens)
314	      .set({ lastUsedAt: new Date().toISOString() })
315	      .where(eq(apiTokens.id, tokenId))
316	      .run();
317	  }
318	
319	  async findMCPTokenByClientId(
320	    userEmail: string,
321	    clientId: string,
322	  ): Promise<ApiToken | null> {
323	    const tokenName = `MCP OAuth Connection: ${clientId}`;
324	    const result = await this.db
325	      .select({
326	        id: apiTokens.id,
327	        user_email: apiTokens.userEmail,
328	        name: apiTokens.name,
329	        created_at: apiTokens.createdAt,
330	        expires_at: apiTokens.expiresAt,
331	        last_used_at: apiTokens.lastUsedAt,
332	        is_revoked: apiTokens.isRevoked,
333	      })
334	      .from(apiTokens)
335	      .where(
336	        and(
337	          eq(apiTokens.userEmail, userEmail),
338	          eq(apiTokens.name, tokenName),
339	          eq(apiTokens.isRevoked, false),
340	        ),
341	      )
342	      .orderBy(desc(apiTokens.createdAt))
343	      .limit(1)
344	      .get();
345	    if (!result) return null;
346	
347	    if (
348	      result.expires_at &&
349	      new Date(result.expires_at as string) < new Date()
350	    ) {
351	      return null;
352	    }
353	
354	    return result as unknown as ApiToken;
355	  }
356	}
