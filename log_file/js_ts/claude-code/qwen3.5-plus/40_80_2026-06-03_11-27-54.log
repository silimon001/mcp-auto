269	  // Main JSON-RPC request handler
270	  // Processes MCP protocol requests over HTTP transport
271	  async handleJsonRpcRequest(
272	    request: JsonRpcRequest,
273	    requestHeaders: Record<string, string>,
274	  ): Promise<JsonRpcResponse> {
275	    Logger.info(`MCP request: ${JSON.stringify(request, null, 2)}`);
276	
277	    // Detect ChatGPT Deep Research client by user-agent
