281	    const requestId = request.id ?? null;
282	
283	    try {
284	      // Validate JSON-RPC 2.0 format
285	      if (request.jsonrpc !== "2.0") {
286	        return this.createErrorResponse(
287	          JSON_RPC_ERRORS.INVALID_REQUEST,
288	          requestId,
289	        );
290	      }
291	
292	      // Route to appropriate handler based on method
293	      switch (request.method) {
294	        case "initialize":
295	          return await this.handleInitialize(request);
296	        case "notifications/initialized":
297	          if (request.id === undefined || request.id === null) {
298	            return { jsonrpc: "2.0", result: null, id: null };
299	          }
300	          return await this.handleInitialize(request);
301	        case "list_tools":
302	        case "tools/list":
303	          return await this.handleListTools(request, { isChatGPTDeepResearch });
304	        case "call_tool":
305	        case "tools/call":
306	          return await this.handleCallTool(request, { isChatGPTDeepResearch });
307	        case "list_resources":
308	        case "resources/list":
309	          return await this.handleListResources(request);
310	        case "read_resource":
311	        case "resources/read":
312	          return await this.handleReadResource(request);
313	        default:
314	          return this.createErrorResponse(
315	            JSON_RPC_ERRORS.METHOD_NOT_FOUND,
316	            requestId,
317	          );
318	      }
319	    } catch (error) {
320	      Logger.error("Error handling JSON-RPC request:", error);
321	      return this.createErrorResponse(
322	        {
323	          code: JSON_RPC_ERRORS.INTERNAL_ERROR.code,
324	          message: JSON_RPC_ERRORS.INTERNAL_ERROR.message,
325	          data: error instanceof Error ? error.message : "Unknown error",
326	        },
327	        requestId,
328	      );
329	    }
330	  }
