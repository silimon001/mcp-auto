1	import { ACTIONS, SolanaAgentKit } from "solana-agent-kit";
2	import { startMcpServer } from "solana-agent-kit/src/mcp";
3	import * as dotenv from "dotenv";
4	
5	// Redirect logs to stderr instead of stdout
6	const logToStderr = (message: string) => {
7	  process.stderr.write(`[Solana MCP] ${message}\n`);
8	};
9	
10	// Load environment variables
11	dotenv.config();
12	
13	// Verify that required environment variables are set
14	if (!process.env.SOLANA_PRIVATE_KEY || !process.env.RPC_URL) {
15	    logToStderr("Error: SOLANA_PRIVATE_KEY and RPC_URL must be defined in .env file");
16	    process.exit(1);
17	}
18	
19	// Initialize the Solana Agent Kit
20	logToStderr("Initializing Solana MCP Server...");
21	
22	// Create agent instance
23	const agent = new SolanaAgentKit(
24	    process.env.SOLANA_PRIVATE_KEY!,
25	    process.env.RPC_URL!,
26	    {
27	        OPENAI_API_KEY: process.env.OPENAI_API_KEY || "",
28	    },
29	);
30	
31	logToStderr(`✅ Connected to Solana via ${process.env.RPC_URL}`);
32	logToStderr(`💰 Wallet: ${agent.wallet_address.toString()}`);
33	
34	// Define a subset of DeFi actions for the MCP following the Record<string, Action> format
35	const mcp_actions = {
36	    // Core wallet operations
37	    "get_wallet": ACTIONS.WALLET_ADDRESS_ACTION,
38	    "check_balance": ACTIONS.BALANCE_ACTION,
39	    "transfer_sol": ACTIONS.TRANSFER_ACTION,
40	    "list_tokens": ACTIONS.BALANCE_ACTION, // For token balances
41	    
42	    // Market data and trading
43	    "fetch_price": ACTIONS.FETCH_PRICE_ACTION,
44	    "trade_tokens": ACTIONS.TRADE_ACTION,
45	    "get_tps": ACTIONS.GET_TPS_ACTION,
46	    
47	    // Token operations
48	    "get_token_data": ACTIONS.GET_TOKEN_DATA_ACTION,
49	    
50	    // Uncomment additional actions as needed
51	    // "get_asset": ACTIONS.GET_ASSET_ACTION,
52	    // "deploy_token": ACTIONS.DEPLOY_TOKEN_ACTION,
53	};
54	
55	logToStderr(`🚀 Starting Solana MCP Server...`);
56	logToStderr(`📊 Available DeFi actions: ${Object.keys(mcp_actions).length}`);
57	
58	try {
59	    // Start the MCP server with defined actions
60	    startMcpServer(mcp_actions, agent, { 
61	        name: "solana-mcp", 
62	        version: "1.0.0" 
63	    });
64	    logToStderr(`✨ Solana MCP Server started. Ready to perform DeFi operations on Solana!`);
65	} catch (error) {
66	    logToStderr(`❌ Error starting MCP Server: ${error}`);
67	    process.exit(1);
68	} 

