363	    // Tool: full-text search across notes with concise output and paging
364	    server.registerTool(
365	        'search-notes',
366	        {
367	            title: 'Search Notes',
368	            description: 'Full-text search across notes with concise output and paging',
369	            annotations: {
370	                readOnlyHint: true,
371	            },
372	            inputSchema: {
373	                query: z.string().describe('Search query (supports javascript regex patterns)'),
374	                searchType: z
375	                    .enum(['content', 'title', 'both'])
376	                    .default('both')
377	                    .describe('Where to search: content, title (filename), or both'),
378	                caseSensitive: z.boolean().default(false).describe('Whether search should be case-sensitive'),
379	                maxResults: z.number().default(10).describe('Maximum number of results to return per page'),
380	                page: z.number().default(1).describe('Page number for pagination (1-based)'),
381	                contextLines: z
382	                    .number()
383	                    .default(1)
384	                    .describe('Number of lines of context to show around each match (reduced default for conciseness)'),
385	                concise: z.boolean().default(true).describe('Return concise output optimized for LLM consumption'),
386	                enableCaching: z
387	                    .boolean()
388	                    .default(true)
389	                    .describe('Enable content caching with modification time validation'),
390	            },
391	        },
392	        async ({
393	            query,
394	            searchType,
395	            caseSensitive,
396	            maxResults,
397	            page,
398	            contextLines,
399	            concise,
400	            enableCaching,
401	        }) => {
402	            try {
403	                const notes = await listNotesAPI();
404	                const searchResults = [];
405	                const flags = caseSensitive ? 'g' : 'gi';
406	                let searchRegex;
407	                let regexInvalidFallback = false;
408	
409	                try {
410	                    searchRegex = new RegExp(query, flags);
411	                } catch (error) {
412	                    // If regex is invalid, escape special characters and treat as literal
413	                    const escapedQuery = query.replace(/[.*+?^${}()|[\\]\\]/g, '\\$&');
414	                    searchRegex = new RegExp(escapedQuery, flags);
415	                    regexInvalidFallback = true;
416	                }
417	
418	                for (const note of notes) {
419	                    const noteResults: SearchResult = {
420	                        filename: note.name,
421	                        permission: note.perm,
422	                        matches: [],
423	                        score: 0,
424	                    };
425	
426	                    // Search in title/filename
427	                    if (searchType === 'title' || searchType === 'both') {
428	                        const titleMatches = Array.from(note.name.matchAll(searchRegex));
429	                        if (titleMatches.length > 0) {
430	                            noteResults.matches.push({
431	                                type: 'title',
432	                                line: 0,
433	                                content: note.name,
434	                                matchCount: titleMatches.length,
435	                            });
436	                        }
437	                    }
438	
439	                    // Search in content
440	                    if (searchType === 'content' || searchType === 'both') {
441	                        try {
442	                            const content = await getCachedNoteContent(note.name, enableCaching);
443	                            const lines = content.split('\n');
444	
445	                            lines.forEach((line, lineIndex) => {
446	                                const lineMatches = Array.from(line.matchAll(searchRegex));
447	                                if (lineMatches.length > 0) {
448	                                    // Get context lines only if not in concise mode or if contextLines > 0
449	                                    let contextText = '';
450	                                    if (!concise && contextLines > 0) {
451	                                        const startLine = Math.max(0, lineIndex - contextLines);
452	                                        const endLine = Math.min(lines.length - 1, lineIndex + contextLines);
453	                                        contextText = lines.slice(startLine, endLine + 1).join('\n');
454	                                    }
455	
456	                                    noteResults.matches.push({
457	                                        type: 'content',
458	                                        line: lineIndex + 1,
459	                                        content: line.trim(), // Trim whitespace for conciseness
460	                                        context: contextText,
461	                                        matchCount: lineMatches.length,
462	                                        startLine:
463	                                            contextLines > 0
464	                                                ? Math.max(0, lineIndex - contextLines) + 1
465	                                                : undefined,
466	                                        endLine:
467	                                            contextLines > 0
468	                                                ? Math.min(lines.length - 1, lineIndex + contextLines) + 1
469	                                                : undefined,
470	                                    });
471	                                }
472	                            });
473	                        } catch (error) {
474	                            console.error(`[MCP Tool: search-notes] Failed to read note ${note.name}:`, error);
475	                            // Continue with other notes
476	                        }
477	                    }
478	
479	                    if (noteResults.matches.length > 0) {
480	                        // Calculate total score for ranking
481	                        const totalMatches = noteResults.matches.reduce(
482	                            (sum, match) => sum + match.matchCount,
483	                            0
484	                        );
485	                        noteResults.score = totalMatches;
486	                        searchResults.push(noteResults);
487	                    }
488	                }
489	
490	                // Sort by relevance (score)
491	                searchResults.sort((a, b) => b.score - a.score);
492	
493	                // Calculate pagination
494	                const totalResults = searchResults.length;
495	                const totalPages = Math.ceil(totalResults / maxResults);
496	                const startIndex = (page - 1) * maxResults;
497	                const endIndex = Math.min(startIndex + maxResults, totalResults);
498	                const paginatedResults = searchResults.slice(startIndex, endIndex);
499	
500	                // Format results
501	                if (totalResults === 0) {
502	                    return {
503	                        content: [
504	                            {
505	                                type: 'text',
506	                                text: `No matches found for "${query}" in ${
507	                                    searchType === 'both' ? 'titles or content' : searchType
508	                                }.`,
509	                            },
510	                        ],
511	                    };
512	                }
513	
514	                const totalMatches = searchResults.reduce((sum, result) => sum + result.score, 0);
515	
516	                let output = '';
517	                let fallbackMessage = '';
518	
519	                if (regexInvalidFallback) {
520	                    fallbackMessage = `Warning: Your regex query "${query}" was invalid and was treated as a literal search.\n`;
521	                }
522	
523	                // Header with pagination info
524	                if (concise) {
525	                    output = `${fallbackMessage}SEARCH: "${query}" | Results: ${totalResults} notes, ${totalMatches} matches | Page ${page}/${totalPages}\n\n`;
526	                } else {
527	                    output = `${fallbackMessage}Found ${totalMatches} matches in ${totalResults} notes (showing page ${page} of ${totalPages}):\n\n`;
528	                }
529	
530	                // Results
531	                paginatedResults.forEach((result, index) => {
532	                    const resultNum = startIndex + index + 1;
533	                    const totalNoteMatches = result.matches.reduce((sum, match) => sum + match.matchCount, 0);
534	
535	                    if (concise) {
536	                        output += `${resultNum}. ${result.filename} (${totalNoteMatches}x)\n`;
537	
538	                        // Show only first few matches in concise mode
539	                        const maxMatchesToShow = 3;
540	                        const matchesToShow = result.matches.slice(0, maxMatchesToShow);
541	
542	                        matchesToShow.forEach((match) => {
543	                            if (match.type === 'title') {
544	                                output += `  • Title match\n`;
545	                            } else {
546	                                // Truncate long lines for conciseness
547	                                const truncatedContent =
548	                                    match.content.length > 100
549	                                        ? match.content.substring(0, 97) + '...'
550	                                        : match.content;
551	                                output += `  • L${match.line}: ${truncatedContent}\n`;
552	                            }
553	                        });
554	
555	                        if (result.matches.length > maxMatchesToShow) {
556	                            output += `  • ... ${result.matches.length - maxMatchesToShow} more matches\n`;
557	                        }
558	                    } else {
559	                        output += `📄 **${result.filename}** (${totalNoteMatches} matches, ${result.permission})\n`;
560	
561	                        result.matches.forEach((match) => {
562	                            if (match.type === 'title') {
563	                                output += `  📝 Title: "${match.content}"\n`;
564	                            } else {
565	                                output += `  Line ${match.line}: "${match.content}"\n`;
566	                                if (contextLines > 0 && match.context) {
567	                                    const contextWithHighlight = match.context
568	                                        .split('\n')
569	                                        .map((line: string, idx: number) => {
570	                                            const actualLineNum = (match.startLine || 0) + idx;
571	                                            const prefix = actualLineNum === match.line ? '→' : ' ';
572	                                            return `    ${prefix} ${actualLineNum}: ${line}`;
573	                                        })
574	                                        .join('\n');
575	                                    output += `${contextWithHighlight}\n`;
576	                                }
577	                            }
578	                        });
579	                    }
580	                    output += '\n';
581	                });
582	
583	                // Pagination footer
584	                if (totalPages > 1) {
585	                    if (concise) {
586	                        output += `---\nPage ${page}/${totalPages}`;
587	                        if (page < totalPages) output += ` | Next: page=${page + 1}`;
588	                        if (page > 1) output += ` | Prev: page=${page - 1}`;
589	                    } else {
590	                        output += `Page ${page} of ${totalPages}`;
591	                        if (page < totalPages) output += ` | Use page=${page + 1} for next results`;
592	                        if (page > 1) output += ` | Use page=${page - 1} for previous results`;
593	                    }
594	                }
595	
596	                return {
597	                    content: [
598	                        {
599	                            type: 'text',
600	                            text: output,
601	                        },
602	                    ],
603	                };
604	            } catch (error) {
605	                console.error(`[MCP Tool: search-notes] Error:`, error);
606	                return {
607	                    content: [
608	                        {
609	                            type: 'text',
610	                            text: `Failed to search notes: ${
611	                                error instanceof Error ? error.message : 'Unknown error'
612	                            }`,
613	                        },
614	                    ],
615	                    isError: true,
616	                };
617	            }
618	        }
619	    );
