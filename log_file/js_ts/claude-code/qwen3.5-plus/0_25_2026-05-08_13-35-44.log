1	#!/usr/bin/env node
2	
3	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
4	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
5	import { z } from "zod";
6	import { spawn, exec } from "node:child_process";
7	import { promisify } from "node:util";
8	
9	// Store active terminals
10	const terminals = new Map();
11	let terminalCounter = 0;
12	
13	// Helper function to execute AppleScript for iTerm
14	async function executeITermScript(script) {
15	  const execPromise = promisify(exec);
16	
17	  // Simple launch script
18	  const launchScript = `
19	    tell application "iTerm"
20	      activate
21	    end tell
22	  `;
23	
24	  try {
25	    // First try to launch/activate iTerm
26	    await execPromise(`osascript -e '${launchScript}'`);
27	
28	    // Wait a brief moment
29	    await new Promise((resolve) => setTimeout(resolve, 1000));
30	
31	    // Now execute the actual script with iTerm instead of iTerm2
32	    const modifiedScript = script.replace(/iTerm2/g, "iTerm");
33	    const { stdout } = await execPromise(`osascript -e '${modifiedScript}'`);
34	    return stdout.trim();
35	  } catch (error) {
36	    console.error("iTerm AppleScript error:", error);
37	    throw error;
38	  }
39	}
40	
41	// Create server instance
42	const server = new McpServer({
43	  name: "terminal",
44	  version: "1.0.0",
45	});
46	
47	// Register terminal tools
48	server.tool("open-terminal", "Open a new terminal instance", {}, async () => {
49	  const terminalId = `terminal-${terminalCounter++}`;
50	
51	  // Create both GUI terminal and background process for output collection
52	  const shell = process.platform === "win32" ? "cmd.exe" : "/bin/bash";
53	  const terminal = spawn(shell, [], {
54	    stdio: ["pipe", "pipe", "pipe"],
55	    shell: true,
56	  });
57	
58	  const output = [];
59	
60	  terminal.stdout.on("data", (data) => {
61	    output.push(data.toString());
62	  });
63	
64	  terminal.stderr.on("data", (data) => {
65	    output.push(data.toString());
66	  });
67	
68	  // Create iTerm window
69	  const script = `
70	    tell application "iTerm2"
71	      activate
72	      tell current window
73	        create tab with default profile
74	        tell current session
75	          write text "echo Terminal ${terminalId} ready"
76	        end tell
77	      end tell
78	    end tell
79	  `;
80	
81	  try {
82	    await executeITermScript(script);
83	    terminals.set(terminalId, {
84	      process: terminal,
85	      output,
86	      id: terminalId,
87	    });
88	
89	    return {
90	      content: [
91	        {
92	          type: "text",
93	          text: `Terminal opened with ID: ${terminalId}`,
94	        },
95	      ],
96	    };
97	  } catch (error) {
98	    terminal.kill(); // Clean up background process if iTerm fails
99	    throw error;
100	  }
101	});
102	
103	server.tool(
104	  "execute-command",
105	  "Execute a command in a specific terminal",
106	  {
107	    terminalId: z.string().describe("ID of the terminal to execute command in"),
108	    command: z.string().describe("Command to execute"),
109	  },
110	  async ({ terminalId, command }) => {
111	    const terminal = terminals.get(terminalId);
112	    if (!terminal) {
113	      return {
114	        content: [
115	          {
116	            type: "text",
117	            text: `Terminal ${terminalId} not found`,
118	          },
119	        ],
120	      };
121	    }
122	
123	    // Execute in both GUI and background process
124	    terminal.process.stdin.write(command + "\n");
125	
126	    const script = `
127	      tell application "iTerm2"
128	        tell current session of current window
129	          write text "${command.replace(/"/g, '\\"')}"
130	        end tell
131	      end tell
132	    `;
133	
134	    try {
135	      await executeITermScript(script);
136	      // Give some time for the command to execute and output to be collected
137	      await new Promise((resolve) => setTimeout(resolve, 100));
138	
139	      return {
140	        content: [
141	          {
142	            type: "text",
143	            text: `Command executed in ${terminalId}`,
144	          },
145	        ],
146	      };
147	    } catch (error) {
148	      return {
149	        content: [
150	          {
151	            type: "text",
152	            text: `Failed to execute in GUI terminal but command ran in background: ${error.message}`,
153	          },
154	        ],
155	      };
156	    }
157	  }
158	);
159	
160	server.tool(
161	  "read-output",
162	  "Read the output from a specific terminal",
163	  {
164	    terminalId: z.string().describe("ID of the terminal to read output from"),
165	  },
166	  async ({ terminalId }) => {
167	    const terminal = terminals.get(terminalId);
168	    if (!terminal) {
169	      return {
170	        content: [
171	          {
172	            type: "text",
173	            text: `Terminal ${terminalId} not found`,
174	          },
175	        ],
176	      };
177	    }
178	
179	    const output = terminal.output.join("");
180	    terminal.output.length = 0; // Clear the output buffer
181	
182	    return {
183	      content: [
184	        {
185	          type: "text",
186	          text: output || "No output available",
187	        },
188	      ],
189	    };
190	  }
191	);
192	
193	server.tool(
194	  "close-terminal",
195	  "Close a specific terminal",
196	  {
197	    terminalId: z.string().describe("ID of the terminal to close"),
198	  },
199	  async ({ terminalId }) => {
200	    const terminal = terminals.get(terminalId);
201	    if (!terminal) {
202	      return {
203	        content: [
204	          {
205	            type: "text",
206	            text: `Terminal ${terminalId} not found`,
207	          },
208	        ],
209	      };
210	    }
211	
212	    // Close both GUI and background process
213	    terminal.process.kill();
214	
215	    const script = `
216	      tell application "iTerm2"
217	        close current window
218	      end tell
219	    `;
220	
221	    try {
222	      await executeITermScript(script);
223	    } catch (error) {
224	      console.error("Failed to close iTerm window:", error);
225	    }
226	
227	    terminals.delete(terminalId);
228	
229	    // Safely decrement the terminal counter
230	    terminalCounter = Math.max(0, terminalCounter - 1);
231	
232	    return {
233	      content: [
234	        {
235	          type: "text",
236	          text: `Terminal ${terminalId} closed`,
237	        },
238	      ],
239	    };
240	  }
241	);
242	
243	server.tool(
244	  "list-terminals",
245	  "List all active terminals and their information",
246	  {},
247	  async () => {
248	    const activeTerminals = Array.from(terminals.entries()).map(([id]) => id);
249	    const count = terminals.size;
250	
251	    return {
252	      content: [
253	        {
254	          type: "text",
255	          text: `Number of active terminals: ${count}\nActive terminal IDs: ${
256	            activeTerminals.join(", ") || "None"
257	          }`,
258	        },
259	      ],
260	    };
261	  }
262	);
263	
264	async function main() {
265	  const transport = new StdioServerTransport();
266	  await server.connect(transport);
267	  console.error("Terminal MCP Server running on stdio");
268	}
269	
270	main().catch((error) => {
271	  console.error("Fatal error in main():", error);
272	  process.exit(1);
273	});
274	

