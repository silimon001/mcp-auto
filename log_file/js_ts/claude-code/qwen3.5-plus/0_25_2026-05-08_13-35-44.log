7	// 1. Declare root project folder as constant
8	const PROJECT_ROOT = "/Users/azer/code";
9	// 2. Function to list all projects under root project folder
10	function listProjects() {
11	    try {
12	        const entries = fs.readdirSync(PROJECT_ROOT, { withFileTypes: true });
13	        return entries
14	            .filter((entry) => entry.isDirectory() && !entry.name.startsWith("."))
15	            .map((dir) => dir.name);
16	    }
17	    catch (error) {
18	        console.error(`Error listing projects: ${error}`);
19	        return [];
20	    }
21	}
22	// 3. Function to list all jsx/tsx files under given subfolder
23	function listReactFiles(subFolder) {
24	    const folderPath = path.join(PROJECT_ROOT, subFolder);
25	    const reactFiles = [];
26	    function scanDirectory(directory) {
27	        try {
28	            const entries = fs.readdirSync(directory, { withFileTypes: true });
29	            for (const entry of entries) {
30	                const fullPath = path.join(directory, entry.name);
31	                if (entry.isDirectory()) {
32	                    scanDirectory(fullPath);
33	                }
34	                else if (entry.isFile() &&
35	                    (entry.name.endsWith(".jsx") || entry.name.endsWith(".tsx"))) {
36	                    reactFiles.push(fullPath);
37	                }
38	            }
39	        }
40	        catch (error) {
41	            console.error(`Error scanning directory ${directory}: ${error}`);
42	        }
43	    }
44	    scanDirectory(folderPath);
45	    return reactFiles;
46	}
47	// 4. Function to analyze a React file
48	function analyzeReactFileContents(filePath) {
49	    try {
50	        const fileContent = fs.readFileSync(filePath, "utf8");
51	        const fileName = path.basename(filePath);
52	        return analyzeReactFile(fileName, fileContent);
53	    }
54	    catch (error) {
55	        console.error(`Error analyzing file ${filePath}: ${error}`);
56	        return null;
57	    }
58	}
59	// 5. Function to generate markdown from analysis result
60	function generateComponentMarkdown(analysisResult) {
61	    if (!analysisResult ||
62	        !analysisResult.components ||
63	        analysisResult.components.length === 0) {
64	        return "**No components found**";
65	    }
66	    let markdown = "";
67	    for (const component of analysisResult.components) {
68	        markdown += `## ${component.name}\n\n`;
69	        if (component.wrapperFn) {
70	            markdown += `*Wrapped with: ${component.wrapperFn}*\n\n`;
71	        }
72	        markdown += "### Props\n\n";
73	        if (!component.props || Object.keys(component.props).length === 0) {
74	            markdown += "*No props*\n\n";
75	        }
76	        else {
77	            markdown += "| Prop | Type | Optional | Default |\n";
78	            markdown += "|------|------|----------|--------|\n";
79	            for (const [propName, propDetails] of Object.entries(component.props)) {
80	                const type = formatPropType(propDetails);
81	                // @ts-ignore
82	                const optional = propDetails.optional ? "✓" : "✗";
83	                // @ts-ignore
84	                const defaultValue = propDetails.defaultValue
85	                    ? // @ts-ignore
86	                        `\`${propDetails.defaultValue}\``
87	                    : "";
88	                markdown += `| \`${propName}\` | ${type} | ${optional} | ${defaultValue} |\n`;
89	            }
90	            markdown += "\n";
91	        }
92	    }
93	    return markdown;
94	}
95	// Helper function to format prop types for markdown
96	function formatPropType(propDetails) {
97	    const { type } = propDetails;
98	    if (type === "array" && propDetails.elementType) {
99	        return `${type}<${formatPropType(propDetails.elementType)}>`;
100	    }
101	    else if (type === "object" && propDetails.props) {
102	        return propDetails.typeName ? `\`${propDetails.typeName}\`` : "`object`";
103	    }
104	    else if (type === "function") {
105	        return "`function`";
106	    }
107	    return `\`${type}\``;
108	}
109	// 6. Function to generate documentation for all components in a folder
110	function generateProjectDocs(projectName) {
111	    const reactFiles = listReactFiles(projectName);
112	    if (reactFiles.length === 0) {
113	        return `# ${projectName}\n\nNo React components found.`;
114	    }
115	    let markdown = `# ${projectName} Components\n\n`;
116	    for (const filePath of reactFiles) {
117	        const relativePath = path.relative(PROJECT_ROOT, filePath);
118	        markdown += `\n---\n\n# File: ${relativePath}\n\n`;
119	        const analysis = analyzeReactFileContents(filePath);
120	        if (analysis) {
121	            markdown += generateComponentMarkdown(analysis);
122	        }
123	        else {
124	            markdown += "*Error analyzing file*\n\n";
125	        }
126	    }
127	    return markdown;
128	}
129	const server = new Server({
