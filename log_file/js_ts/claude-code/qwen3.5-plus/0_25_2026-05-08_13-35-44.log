1	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
2	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
3	import {
4	  CallToolRequestSchema,
5	  ListToolsRequestSchema,
6	} from "@modelcontextprotocol/sdk/types.js";
7	import { AshraError, isAshraError } from "./common/errors.js";
8	import { z } from "zod";
9	import { zodToJsonSchema } from "zod-to-json-schema";
10	
11	import * as prompts from "./operations/prompt.js";
12	import { CreatePromptRequestSchema } from "./common/types.js";
13	
14	const server = new Server(
15	  {
16	    name: "ashra-mcp-server",
17	    version: "0.0.1",
18	  },
19	  {
20	    capabilities: {
21	      tools: {},
22	    },
23	  }
24	);
25	
26	function formatAshraError(error: AshraError): string {
27	  let message = `Ashra API Error: ${error.message}`;
28	  return message;
29	}
30	
31	server.setRequestHandler(ListToolsRequestSchema, async () => {
32	  return {
33	    tools: [
34	      {
35	        name: "create_prompt",
36	        description: "Create a single prompt in Ashra",
37	        inputSchema: zodToJsonSchema(CreatePromptRequestSchema),
38	      },
39	    ],
40	  };
41	});
42	
43	server.setRequestHandler(CallToolRequestSchema, async (request) => {
44	  try {
45	    if (!request.params.arguments) {
46	      throw new Error("Arguments are required");
47	    }
48	
49	    switch (request.params.name) {
50	      case "create_prompt": {
51	        const args = CreatePromptRequestSchema.parse(request.params.arguments);
52	        const prompt = await prompts.Create(args);
53	        return {
54	          content: [{ type: "text", text: JSON.stringify(prompt, null, 2) }],
55	        };
56	      }
57	      default:
58	        throw new Error(`Unknown tool: ${request.params.name}`);
59	    }
60	  } catch (error) {
61	    if (error instanceof z.ZodError) {
62	      throw new Error(`Invalid input: ${JSON.stringify(error.errors)}`);
63	    }
64	    if (isAshraError(error)) {
65	      throw new Error(formatAshraError(error));
66	    }
67	    throw error;
68	  }
69	});
70	
71	async function runServer() {
72	  const transport = new StdioServerTransport();
73	  await server.connect(transport);
74	  console.error("Ashra MCP Server running on stdio");
75	}
76	
77	runServer().catch((error) => {
78	  console.error("Fatal error in main():", error);
79	  process.exit(1);
80	});
81	

