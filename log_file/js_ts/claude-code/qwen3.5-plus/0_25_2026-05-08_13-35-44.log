279	    async def _cleanup_server_process(self):
280	        if self.process and self._server_process_started:
281	            print("[CLEANUP] Terminating MCP server process...")
282	
283	            try:
284	                self.process.terminate()
285	
286	                # 等待优雅退出
287	                try:
288	                    self.process.wait(timeout=5)
289	                except subprocess.TimeoutExpired:
290	                    print("[CLEANUP] Force killing MCP server...")
291	                    self.process.kill()
292	
293	            except Exception as e:
294	                print(f"[WARN] Failed to terminate process: {e}")
295	
296	            finally:
297	                self.process = None
298	                self._server_process_started = False
299	
300	    async def cleanup(self):
301	        """清理所有资源，确保正确释放"""
302	        try:
303	            await self.exit_stack.aclose()
304	        except Exception as e:
305	            print(f"[WARN] Cleanup error: {e}")
306	        finally:
307	            await self._cleanup_server_process()
308	            self.session = None
