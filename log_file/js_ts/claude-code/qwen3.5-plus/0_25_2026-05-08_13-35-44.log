7	// @updateURL    https://raw.githubusercontent.com/aicu-icu/xhs-mcp-server/refs/heads/main/loader.user.js
8	// @match        https://www.xiaohongshu.com/*
9	// @run-at       document-end
10	// @grant        none
11	// ==/UserScript==
12	
13	(function() {
14	    'use strict';
15	
16	    console.log('[XHS-MCP-Server] 开始加载...');
17	
18	    async function loadWithEval(url) {
19	        console.log(`[XHS-MCP-Server] 正在加载(eval): ${url}`);
20	        const response = await fetch(url);
21	        if (!response.ok) throw new Error(`HTTP ${response.status}`);
22	        const code = await response.text();
23	        eval(code);
24	        console.log(`[XHS-MCP-Server] 加载完成: ${url}`);
25	    }
26	
27	    function loadScript(url) {
28	        console.log(`[XHS-MCP-Server] 正在加载(script): ${url}`);
29	        return new Promise((resolve, reject) => {
30	            const script = document.createElement('script');
31	            script.src = url;
32	            script.onload = () => {
33	                console.log(`[XHS-MCP-Server] 加载完成: ${url}`);
34	                resolve();
35	            };
36	            script.onerror = () => {
37	                console.error(`[XHS-MCP-Server] 加载失败: ${url}`);
38	                reject(new Error('Script load failed'));
39	            };
40	            document.head.appendChild(script);
41	        });
42	    }
43	
44	    async function main() {
45	        await loadWithEval('https://raw.githubusercontent.com/aicu-icu/xhs-mcp-server/refs/heads/main/data-js/latest.js');
46	        await loadScript('https://broxy.dev/assets/broxy-v1.user.js');
47	        console.log('[XHS-MCP-Server] 所有脚本加载完成');
48	    }
49	
50	    main();
51	})();
