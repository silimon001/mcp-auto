64	def wait_for_port(host: str, port: int, timeout: int = 30, interval: float = 0.5) -> bool:
65	    """
66	    等待某个 TCP 端口可连接，最多等待 timeout 秒
67	    :param host: 主机
68	    :param port: 端口
69	    :param timeout: 最大等待时间（秒）
70	    :param interval: 每次重试间隔（秒）
71	    :return: True if port is ready, False if timeout
72	    """
73	    start_time = time.time()
74	    while time.time() - start_time < timeout:
75	        try:
76	            with socket.create_connection((host, port), timeout=1):
77	                return True
78	        except (ConnectionRefusedError, OSError):
79	            time.sleep(interval)
80	    return False
