82	def start_process(command: str, args: List[str] = None, env: dict = None, cwd: str = None,
83	                  wait_url: str = None, wait_timeout: int = 30):
84	    """
85	    启动一个长期运行的进程（如服务器），等待服务可用后继续执行
86	    :param command: 可执行文件
87	    :param args: 参数列表
88	    :param env: 环境变量字典
89	    :param cwd: 工作目录
90	    :param wait_url: 等待服务的 URL，例如 "http://localhost:5173/mcp"
91	    :param wait_timeout: 最多等待服务启动的秒数
92	    :return: Popen 对象
93	    """
94	    if isinstance(command, tuple):
95	        command = command[0]
96	
97	    cmd_list = [command] + (args or [])
98	
99	    process = subprocess.Popen(
100	        cmd_list,
101	        env=({**get_default_environment(), **env} if env is not None else get_default_environment()),
102	        cwd=cwd,
103	        stdout=subprocess.PIPE,
104	        stderr=subprocess.PIPE,
105	        text=True
106	    )
107	    
108	    import fcntl
109	    def make_non_blocking(file):
110	        """将文件描述符设置为非阻塞"""
111	        fd = file.fileno()
112	        flags = fcntl.fcntl(fd, fcntl.F_GETFL)
113	        fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)
114	
115	    # 将 stdout 和 stderr 设置为非阻塞
116	    make_non_blocking(process.stdout)
117	    make_non_blocking(process.stderr)
118	
119	    # 等待服务器端口就绪
120	    if wait_url:
121	        from urllib.parse import urlparse
122	        parsed = urlparse(wait_url)
123	        host = parsed.hostname or "localhost"
124	        port = parsed.port or 8000
125	        print(f"Waiting for server {host}:{port} to be ready...")
126	        if wait_for_port(host, port, timeout=wait_timeout):
127	            print("Server is ready!")
128	        else:
129	            print("Timeout waiting for server to start")
130	
131	    # 非阻塞读取缓冲区中已有的 stdout/stderr
132	    try:
133	        stdout = process.stdout.read() or ""
134	    except Exception:
135	        stdout = ""
136	    try:
137	        stderr = process.stderr.read() or ""
138	    except Exception:
139	        stderr = ""
140	
141	    if stdout:
142	        print("=== STDOUT ===")
143	        print(stdout, end="")
144	    if stderr:
145	        print("=== STDERR ===")
146	        print(stderr, end="")
147	
148	    return process
