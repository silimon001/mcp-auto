36	def get_default_environment() -> dict[str, str]:
37	    """
38	    Returns a default environment object including only environment variables deemed
39	    safe to inherit.
40	    """
41	    env: dict[str, str] = {}
42	
43	    for key in DEFAULT_INHERITED_ENV_VARS:
44	        value = os.environ.get(key)
45	        if value is None:
46	            continue  # pragma: no cover
47	
48	        if value.startswith("()"):  # pragma: no cover
49	            # Skip functions, which are a security risk
50	            continue  # pragma: no cover
51	
52	        env[key] = value
53	
54	    env['UV_DEFAULT_INDEX'] = 'https://pypi.tuna.tsinghua.edu.cn/simple'
55	
56	    return env
