171	});
172	server.setRequestHandler(CallToolRequestSchema, async (request) => {
173	    if (request.params.name === "analyze-react") {
174	        // @ts-ignore
175	        const files = request.params.arguments.files;
176	        const result = analyzeReactFile("MyComponent.tsx", files);
177	        return { toolResult: result };
178	    }
