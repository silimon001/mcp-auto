4	export class CommandExecutor {
5	    private allowedCommands: string[] = [];
6	    private asyncExecution: boolean = true;
7	    private executionDelay: number = 0;
8	    private backgroundExecutor: BackgroundTaskExecutor;
9	
10	    constructor() {
11	        console.log('CommandExecutor constructor called');
12	        this.updateAllowedCommands();
13	        this.updateAsyncConfig();
14	        console.log('Creating BackgroundTaskExecutor...');
15	        this.backgroundExecutor = new BackgroundTaskExecutor();
16	        console.log('CommandExecutor initialized with async config:', {
17	            asyncExecution: this.asyncExecution,
18	            executionDelay: this.executionDelay,
19	        });
20	    }
21	
22	    public async executeCommand(command: string, args?: any[]): Promise<any> {
23	        if (!this.isCommandAllowed(command)) {
24	            throw new Error(`Command '${command}' is not allowed`);
25	        }
26	
27	        if (this.asyncExecution) {
28	            // 异步模式：立即返回成功，提交到后台执行器
29	            const taskId = this.backgroundExecutor.submitTask(command, args, this.executionDelay);
30	            const stats = this.backgroundExecutor.getTaskStats();
31	
32	            return {
33	                success: true,
34	                async: true,
35	                taskId: taskId,
36	                message: `命令 '${command}' 已提交到后台执行${this.executionDelay > 0 ? `，将在 ${this.executionDelay}ms 后执行` : ''}`,
37	                command: command,
38	                arguments: args,
39	                executionDelay: this.executionDelay,
40	                queueLength: stats.pending + stats.running,
41	                taskStats: stats,
42	            };
43	        } else {
44	            // 同步模式：等待执行完成
45	            try {
46	                const result = await vscode.commands.executeCommand(command, ...(args || []));
47	                return {
48	                    success: true,
49	                    async: false,
50	                    result: result,
51	                    command: command,
52	                    arguments: args,
53	                };
54	            } catch (error) {
55	                return {
56	                    success: false,
57	                    async: false,
58	                    error: error instanceof Error ? error.message : String(error),
59	                    command: command,
60	                    arguments: args,
61	                };
62	            }
63	        }
64	    }
65	
66	    public getBackgroundTaskStats() {
67	        return this.backgroundExecutor.getTaskStats();
68	    }
69	
70	    public getBackgroundTask(taskId: string) {
71	        return this.backgroundExecutor.getTask(taskId);
72	    }
73	
74	    public getAllBackgroundTasks() {
75	        return this.backgroundExecutor.getAllTasks();
76	    }
77	
78	    public cancelBackgroundTask(taskId: string): boolean {
79	        return this.backgroundExecutor.cancelTask(taskId);
80	    }
81	
82	    public clearCompletedTasks(): number {
83	        return this.backgroundExecutor.clearCompletedTasks();
84	    }
85	
86	    public clearAllTasks(): number {
87	        return this.backgroundExecutor.clearAllTasks();
88	    }
89	
90	    public async getAvailableCommands(): Promise<string[]> {
91	        try {
92	            const commands = await vscode.commands.getCommands();
93	            const filtered =
94	                this.allowedCommands.length > 0 ? commands.filter(cmd => this.isCommandAllowed(cmd)) : commands;
95	
96	            return filtered.sort();
97	        } catch (error) {
98	            console.error('Failed to get available commands:', error);
99	            return [];
100	        }
101	    }
102	
103	
104	
105	    private isCommandAllowed(command: string): boolean {
106	        if (this.allowedCommands.length === 0) {
107	            return true;
108	        }
109	
110	        return this.allowedCommands.some(allowed => {
111	            if (allowed.endsWith('*')) {
112	                const prefix = allowed.slice(0, -1);
113	                return command.startsWith(prefix);
114	            }
115	            return command === allowed;
116	        });
117	    }
118	
119	    public updateAllowedCommands() {
120	        const config = vscode.workspace.getConfiguration('vscode-internal-command-mcp-server');
121	        this.allowedCommands = config.get<string[]>('allowedCommands', []);
122	    }
123	
124	    public updateAsyncConfig() {
125	        const config = vscode.workspace.getConfiguration('vscode-internal-command-mcp-server');
126	        const oldAsyncExecution = this.asyncExecution;
127	        const oldExecutionDelay = this.executionDelay;
128	
129	        // 检查配置值
130	        const rawAsyncExecution = config.get('asyncExecution');
131	        const rawExecutionDelay = config.get('executionDelay');
132	
133	        console.log('Raw config values:', {
134	            asyncExecution: rawAsyncExecution,
135	            executionDelay: rawExecutionDelay,
136	            configSection: 'vscode-internal-command-mcp-server',
137	        });
138	
139	        this.asyncExecution = config.get<boolean>('asyncExecution', true);
140	        this.executionDelay = config.get<number>('executionDelay', 0);
141	
142	        console.log(
143	            `Async config updated: asyncExecution=${oldAsyncExecution}->${this.asyncExecution}, executionDelay=${oldExecutionDelay}->${this.executionDelay}`,
144	        );
145	
146	        // 如果异步执行被禁用，清理待处理的任务
147	        if (!this.asyncExecution && this.backgroundExecutor) {
148	            const stats = this.backgroundExecutor.getTaskStats();
149	            if (stats.pending > 0) {
150	                console.log(`Async execution disabled, clearing ${stats.pending} pending tasks`);
151	                vscode.window.showWarningMessage(`异步执行已禁用，将清除 ${stats.pending} 个待处理任务`);
152	                this.backgroundExecutor.clearAllTasks();
153	            }
154	        }
155	    }
156	
157	    public getAllowedCommands(): string[] {
158	        return [...this.allowedCommands];
159	    }
160	
161	    public getAsyncConfig(): { asyncExecution: boolean; executionDelay: number } {
162	        return {
163	            asyncExecution: this.asyncExecution,
164	            executionDelay: this.executionDelay,
165	        };
166	    }
167	
168	
169	}
