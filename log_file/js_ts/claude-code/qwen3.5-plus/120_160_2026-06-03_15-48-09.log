170	    public async start(): Promise<boolean> {
171	        if (this.isRunning) {
172	            return true;
173	        }
174	
175	        try {
176	            // 获取配置
177	            const config = vscode.workspace.getConfiguration('vscode-internal-command-mcp-server');
178	            const host = config.get<string>('host', 'localhost');
179	            const port = config.get<number>('port', 8080);
180	
181	            // 启动 FastMCP 服务器（支持 HTTP Streaming 和 SSE）
182	            const server = this.server as any;
183	            await server.start({
184	                transportType: 'httpStream',
185	                httpStream: {
186	                    port: port,
187	                    host: host,
188	                    endpoint: '/mcp',
189	                },
190	            });
191	
192	            this.isRunning = true;
193	            this.updateStatusBar();
194	
195	            // 显示启动成功消息
196	            const mcpInfo = `🚀 VSCode internal command MCP 已启动
197	• 地址: http://${host}:${port}/mcp
198	• 协议: Model Context Protocol (MCP) with SSE
199	• 传输: HTTP Streaming (text/event-stream)
200	• 健康检查: http://${host}:${port}/health
201	• 可用工具: 3 个
202	• 状态: 运行中 🟢`;
203	
204	            vscode.window
205	                .showInformationMessage(mcpInfo, '查看详情', '测试工具', '复制地址', '插件源码')
206	                .then(selection => {
207	                    if (selection === '查看详情') {
208	                        vscode.commands.executeCommand('vscode-internal-command-mcp-server.showStatus');
209	                    } else if (selection === '测试工具') {
