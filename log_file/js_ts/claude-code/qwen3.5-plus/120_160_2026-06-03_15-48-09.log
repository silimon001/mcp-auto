1	#!/usr/bin/env node
2	
3	/**
4	 * ClaudePoint Hook Helper
5	 * Integrates with Claude Code hooks for automatic checkpoint creation
6	 * 
7	 * This script is called by Claude Code hooks and handles:
8	 * - Safety checkpoints before bulk operations
9	 * - Optional changelog integration
10	 * - Smart batching to avoid checkpoint spam
11	 */
12	
13	import { fileURLToPath } from 'url';
14	import { dirname, join } from 'path';
15	import { promises as fsPromises } from 'fs';
16	import CheckpointManager from '../src/lib/checkpoint-manager.js';
17	import { program } from 'commander';
18	import { createRequire } from 'module';
19	
20	const __filename = fileURLToPath(import.meta.url);
21	const __dirname = dirname(__filename);
22	const require = createRequire(import.meta.url);
23	const packageJson = require('../package.json');
24	
25	program
26	  .name('claudepoint-hook')
27	  .description('ClaudePoint hook integration for Claude Code')
28	  .version(packageJson.version);
29	
30	program
31	  .option('--trigger <type>', 'Hook trigger type')
32	  .option('--tool <name>', 'Tool name that triggered the hook')
33	  .option('--debug', 'Enable debug output')
34	  .parse();
35	
36	const options = program.opts();
37	
38	async function logHookAttempt(projectDir, message, isError = false) {
39	  try {
40	    const logFile = join(projectDir, '.claudepoint', 'hooks.log');
41	    const timestamp = new Date().toISOString();
42	    const level = isError ? 'ERROR' : 'INFO';
43	    const logEntry = `[${timestamp}] ${level}: ${message}\n`;
44	    
45	    await fsPromises.appendFile(logFile, logEntry);
46	  } catch (error) {
47	    // Silently fail if logging fails - don't break the hook
48	  }
49	}
50	
51	async function findProjectDirectory() {
52	  // Strategy 1: Use env var if set
53	  if (process.env.CLAUDEPOINT_PROJECT_DIR) {
54	    return process.env.CLAUDEPOINT_PROJECT_DIR;
55	  }
56	  
57	  // Strategy 2: Look for .claudepoint directory starting from cwd
58	  let currentDir = process.cwd();
59	  const root = '/';
60	  
61	  while (currentDir !== root) {
62	    const checkpointDir = join(currentDir, '.claudepoint');
63	    try {
64	      await fsPromises.access(checkpointDir);
65	      return currentDir; // Found .claudepoint directory
66	    } catch (error) {
67	      // Continue searching
68	    }
69	    
70	    currentDir = dirname(currentDir);
71	  }
72	  
73	  // Strategy 3: Fallback to cwd
74	  return process.cwd();
75	}
76	
77	async function main() {
78	  try {
79	    // Get project directory with smart detection
80	    const projectDir = await findProjectDirectory();
81	    const manager = new CheckpointManager(projectDir);
82	    
83	    await logHookAttempt(projectDir, `Hook triggered: ${options.trigger} for tool ${options.tool}`);
84	    
85	    if (options.debug) {
86	      console.error(`[claudepoint-hook] Project dir: ${projectDir}`);
87	      console.error(`[claudepoint-hook] Trigger: ${options.trigger}`);
88	      console.error(`[claudepoint-hook] Tool: ${options.tool}`);
89	    }
90	
91	    // Check if ClaudePoint is set up in this project
92	    const checkpointsDir = join(projectDir, '.claudepoint');
93	    try {
94	      await fsPromises.access(checkpointsDir);
95	    } catch (error) {
96	      await logHookAttempt(projectDir, 'ClaudePoint not set up in this project, skipping hook');
97	      if (options.debug) {
98	        console.error('[claudepoint-hook] ClaudePoint not set up in this project, exiting');
99	      }
100	      return; // Silently exit if ClaudePoint isn't set up
101	    }
102	
103	    // Load hooks configuration
104	    const hooksConfig = await manager.loadHooksConfig();
105	    
106	    if (!hooksConfig.enabled) {
107	      await logHookAttempt(projectDir, 'Hooks are disabled in this project, skipping');
108	      if (options.debug) {
109	        console.error('[claudepoint-hook] Hooks disabled, exiting');
110	      }
111	      return;
112	    }
113	
114	    // Handle different trigger types
115	    switch (options.trigger) {
116	      case 'before_bulk_edit':
117	        await handleBeforeBulkEdit(manager, hooksConfig, options, projectDir);
118	        break;
119	      
120	      case 'before_major_write':
121	        await handleBeforeMajorWrite(manager, hooksConfig, options, projectDir);
122	        break;
123	      
124	      case 'before_bash_commands':
125	        await handleBeforeBashCommands(manager, hooksConfig, options, projectDir);
126	        break;
127	      
128	      case 'before_file_operations':
129	        await handleBeforeFileOperations(manager, hooksConfig, options, projectDir);
130	        break;
131	      
132	      default:
133	        if (options.debug) {
134	          console.error(`[claudepoint-hook] Unknown trigger: ${options.trigger}`);
135	        }
136	    }
137	
138	  } catch (error) {
139	    try {
140	      const projectDir = await findProjectDirectory();
141	      await logHookAttempt(projectDir, `Hook failed: ${error.message}`, true);
142	    } catch (logError) {
143	      // Ignore logging errors
144	    }
145	    
146	    if (options.debug) {
147	      console.error('[claudepoint-hook] Error:', error.message);
148	      console.error('[claudepoint-hook] Stack:', error.stack);
149	    }
150	    process.exit(1);
151	  }
152	}
153	
154	async function handleBeforeBulkEdit(manager, config, options, projectDir) {
155	  const trigger = config.triggers?.before_bulk_edit;
156	  
157	  if (!trigger?.enabled) {
158	    await logHookAttempt(projectDir, `Trigger before_bulk_edit is disabled, skipping`);
159	    if (options.debug) {
160	      console.error('[claudepoint-hook] before_bulk_edit trigger disabled');
161	    }
162	    return;
163	  }
164	
165	  // Create safety checkpoint
166	  const description = `Safety checkpoint before ${options.tool || 'bulk edit'}`;
167	  
168	  try {
169	    await logHookAttempt(projectDir, `Creating safety checkpoint: ${description}`);
170	    await manager.ensureDirectories();
171	    const result = await manager.create(null, description, false); // Don't force, respect anti-spam
172	    
173	    if (result.success) {
174	      await logHookAttempt(projectDir, `Successfully created checkpoint: ${result.name}`);
175	      if (options.debug) {
176	        console.error(`[claudepoint-hook] Created safety checkpoint: ${result.name}`);
177	      }
178	      
179	      // Add changelog entry if enabled
180	      if (config.auto_changelog) {
181	        await manager.logToChangelog(
182	          'SAFETY_CHECKPOINT',
183	          `Created safety checkpoint before ${options.tool || 'bulk operation'}`,
184	          `Automatic checkpoint created by ClaudePoint hooks`
185	        );
186	      }
187	    } else if (result.noChanges) {
188	      if (options.debug) {
189	        console.error(`[claudepoint-hook] No changes detected, skipping checkpoint`);
190	      }
191	      // This is not an error - just no changes to checkpoint
192	    } else if (result.tooRecent) {
193	      await logHookAttempt(projectDir, `Skipping checkpoint - too recent: ${result.error}`);
194	      if (options.debug) {
195	        console.error(`[claudepoint-hook] ${result.error}`);
196	      }
197	      // This is not an error - just anti-spam protection
198	    } else {
199	      if (options.debug) {
200	        console.error(`[claudepoint-hook] Failed to create checkpoint: ${result.error}`);
201	      }
202	    }
203	  } catch (error) {
204	    if (options.debug) {
205	      console.error('[claudepoint-hook] Error creating checkpoint:', error.message);
206	    }
207	  }
208	}
209	
210	async function handleBeforeMajorWrite(manager, config, options, projectDir) {
211	  const trigger = config.triggers?.before_major_write;
212	  
213	  if (!trigger?.enabled) {
214	    return;
215	  }
216	
217	  // Similar logic to bulk edit but for major file writes
218	  await handleBeforeBulkEdit(manager, config, options);
219	}
220	
221	async function handleBeforeBashCommands(manager, config, options, projectDir) {
222	  const trigger = config.triggers?.before_bash_commands;
