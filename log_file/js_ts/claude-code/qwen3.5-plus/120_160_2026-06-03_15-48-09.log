1077	          console.log(chalk.yellow('   Creating new Claude Code settings file'));
1078	        }
1079	        
1080	        // Merge hooks with existing settings
1081	        if (!existingSettings.hooks) {
1082	          existingSettings.hooks = {};
1083	        }
1084	        if (!existingSettings.hooks.PreToolUse) {
1085	          existingSettings.hooks.PreToolUse = {};
1086	        }
1087	        
1088	        // Add ClaudePoint hooks with proper structure
1089	        if (!Array.isArray(existingSettings.hooks.PreToolUse)) {
1090	          existingSettings.hooks.PreToolUse = [];
1091	        }
1092	        
1093	        // Remove existing claudepoint hooks to avoid duplicates
1094	        existingSettings.hooks.PreToolUse = existingSettings.hooks.PreToolUse.filter(hook => 
1095	          !hook.hooks || !hook.hooks.some(h => h.command && h.command.includes('claudepoint-hook'))
1096	        );
1097	        
1098	        // Add new hooks
