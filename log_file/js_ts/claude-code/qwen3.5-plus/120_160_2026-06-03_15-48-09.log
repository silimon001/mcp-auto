336	                    for err in errors:
337	                        f.write(f"    - {err}\n")
338	                f.write(f"{'=' * 60}\n")
339	                continue   # result 块输出完毕，跳过后续普通处理
340	
341	            # -------- system / user --------
342	            if isinstance(item, dict):
343	                role = item["type"].upper()
344	                ts = item.get("timestamp", "")
345	                f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
346	                f.write(f"[{role}]:\n{item['content']}\n")
347	                f.write("\n" + "-" * 60 + "\n")
348	                continue
349	
350	            # -------- assistant --------
351	            turn += 1
352	            msg = messages[item]
353	            ts = msg.get("timestamp", "")
354	            f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
355	
356	            text = "\n".join(msg["texts"]).strip()
357	            if text:
358	                f.write(f"[ASSISTANT]:\n{text}\n")
359	
360	            for tool in msg["tools"]:
361	                f.write(f"[ASSISTANT][TOOL]: {tool['name']}\n")
362	                f.write("[TOOL INPUT]:\n")
363	                f.write(json.dumps(tool["input"], indent=2, ensure_ascii=False))
364	                f.write("\n")
365	
366	            if msg["tokens"]:
367	                t = msg["tokens"]
368	                f.write(f"[TOKENS] input={t['input']} output={t['output']}\n")
369	
370	            f.write("\n" + "-" * 60 + "\n")
371	
372	def run_task(prompt_text: str, task_name, pos, count):
373	
374	    json_log_path = f"{LOG_DIR}/tmp_{task_name}.jsonl"
375	
376	    events, stderr = run_claude_stream(
377	        prompt_text,
378	        json_log_path
379	    )
380	
381	    messages, order = collect_messages(events)
382	    log_file = f"{LOG_DIR}/{pos}_{pos+count}_{timestamp}.log"
383	    write_log(messages, order, log_file)
384	
385	    if stderr:
386	        with open(log_file, "a") as f:
387	            f.write("\n[STDERR]\n")
388	            f.write(stderr)
389	
390	    print(f"✅ Done: {log_file}")
391	
392	# ==================== 工具函数 ====================
393	def add_extra_info(dataset_name: str, repo_id: str) -> str:
394	    """add repo info"""
395	    final_text = ''
396	    repo_info_path = MAIN_CWD / "data" / "dataset" / dataset_name / "repo_info.json"
397	    if repo_info_path.exists():
398	        with open(repo_info_path, 'r', encoding='utf-8') as f:
399	            repo_infos = json.load(f)
400	        for repo_info in repo_infos:
401	            if repo_info.get('id') == int(repo_id):
402	                info = {k: repo_info.get(k) for k in ["id", "description", "language", "size", "topic", "html_url"]}
403	                info['owner'] = repo_info.get('full_name').split('/')[0]
404	                info['name'] = repo_info.get('full_name').split('/')[1]
405	                final_text += f'\n=== REPO INFO START ===\n{info}\n=== REPO INFO END ===\n'
406	                break
407	    return final_text
408	
409	def normalize_model_name(name: str) -> str:
410	    """
411	    将:
412	        qwen3.5-plus-2026-04-20
413	    归一化为:
414	        qwen3.5-plus
415	    """
416	
417	    return re.sub(r"-\d{4}-\d{2}-\d{2}$", "", name)
