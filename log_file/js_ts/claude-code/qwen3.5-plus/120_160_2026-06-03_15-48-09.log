438	  async handleRestoreClaudepoint(args) {
439	    const { claudepoint, dry_run = false } = args || {};
440	    
441	    try {
442	      const checkpoints = await this.manager.getCheckpoints();
443	      const targetCheckpoint = checkpoints.find(cp => 
444	        cp.name === claudepoint || cp.name.includes(claudepoint)
445	      );
446	
447	      if (!targetCheckpoint) {
448	        const available = checkpoints.slice(0, 5).map(cp => `  - ${cp.name}`).join('\n');
449	        return {
450	          content: [
451	            {
452	              type: 'text',
453	              text: `🚨 Claudepoint not found: ${claudepoint}\n\nAvailable claudepoints:\n${available}`
454	            }
455	          ]
456	        };
457	      }
458	
459	      if (dry_run) {
460	        const currentFiles = await this.manager.getProjectFiles();
461	        const filesToDelete = currentFiles.filter(f => !targetCheckpoint.files.includes(f));
462	        
463	        let output = `🔍 DRY RUN - Would restore: ${targetCheckpoint.name}\n`;
464	        output += `   📝 Description: ${targetCheckpoint.description}\n`;
465	        output += `   📅 Date: ${new Date(targetCheckpoint.timestamp).toLocaleString()}\n`;
466	        output += `   📁 Files: ${targetCheckpoint.fileCount}\n`;
467	        
468	        if (filesToDelete.length > 0) {
469	          output += `   🗑️  Would delete ${filesToDelete.length} files that didn't exist in checkpoint\n`;
470	        }
471	        
472	        output += '\nUse restore_claudepoint without dry_run to proceed.';
473	        
474	        return {
475	          content: [
476	            {
477	              type: 'text',
478	              text: output
479	            }
480	          ]
481	        };
