211	                    } else if (selection === '复制地址') {
212	                        vscode.env.clipboard.writeText(`http://${host}:${port}/mcp`);
213	                        vscode.window.showInformationMessage('FastMCP 服务器地址已复制到剪贴板');
214	                    } else if (selection === '插件源码') {
