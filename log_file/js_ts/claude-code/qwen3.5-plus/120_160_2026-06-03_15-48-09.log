1046	        }
1047	      };
1048	      
1049	      // Add hooks for each enabled trigger with proper structure
1050	      Object.entries(defaultHooksConfig.triggers).forEach(([triggerName, triggerConfig]) => {
1051	        if (triggerConfig.enabled && triggerConfig.tools) {
1052	          triggerConfig.tools.forEach(tool => {
1053	            claudeHooksConfig.hooks.PreToolUse.push({
1054	              matcher: tool,
1055	              hooks: [{
