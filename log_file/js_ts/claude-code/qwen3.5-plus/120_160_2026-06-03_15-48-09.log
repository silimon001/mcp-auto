40	// Configure MCP server based on scope
41	async function configureMCPServer(scope = 'project') {
42	  try {
43	    // For project scope, we need to use Claude Code CLI
44	    if (scope === 'project') {
45	      // Check if we're in a Claude Code environment
46	      const { execSync } = await import('child_process');
47	      try {
48	        // Try to add MCP server via Claude CLI
49	        execSync(`claude mcp add claudepoint --command claudepoint`, { stdio: 'inherit' });
50	        return { success: true, scope: 'project' };
51	      } catch (error) {
52	        // Fall back to manual instruction
53	        return { 
54	          success: false, 
55	          manual: true,
56	          instructions: 'Run in Claude Code: claude mcp add claudepoint --command claudepoint'
57	        };
58	      }
59	    }
60	    
61	    // For user/global scope, modify config file
62	    const configPath = scope === 'user' 
63	      ? path.join(os.homedir(), '.claude', 'mcp_servers.json')
64	      : path.join(os.homedir(), 'Library', 'Application Support', 'Claude', 'claude_desktop_config.json');
65	    
66	    let config = {};
67	    try {
68	      const configData = await fsPromises.readFile(configPath, 'utf8');
69	      config = JSON.parse(configData);
70	    } catch {
71	      // File doesn't exist, create new
72	    }
73	    
74	    if (!config.mcpServers) {
75	      config.mcpServers = {};
76	    }
77	    
78	    // Check for existing claudepoint entries
79	    const existingKeys = Object.keys(config.mcpServers).filter(key => 
80	      key === 'claudepoint' || key.startsWith('claudepoint_')
81	    );
82	    
83	    if (existingKeys.length > 0) {
84	      return { alreadyConfigured: true, scope, existingKeys };
85	    }
86	    
87	    // Get the full path to claudepoint binary
88	    const { execSync } = await import('child_process');
89	    let claudepointPath;
90	    try {
91	      claudepointPath = execSync('which claudepoint', { encoding: 'utf8' }).trim();
92	    } catch {
93	      // Fallback - try common paths
94	      const commonPaths = [
95	        '/usr/local/bin/claudepoint',
96	        '/opt/homebrew/bin/claudepoint',
97	        path.join(os.homedir(), '.npm-global/bin/claudepoint')
98	      ];
99	      claudepointPath = commonPaths.find(p => {
100	        try {
101	          require('fs').accessSync(p);
102	          return true;
103	        } catch {
104	          return false;
105	        }
106	      }) || 'claudepoint';
107	    }
108	    
109	    config.mcpServers.claudepoint = {
110	      command: claudepointPath,
111	      args: []
112	    };
113	    
114	    await fsPromises.mkdir(path.dirname(configPath), { recursive: true });
115	    await fsPromises.writeFile(configPath, JSON.stringify(config, null, 2));
116	    
117	    return { success: true, scope, configPath };
118	  } catch (error) {
119	    return { success: false, error: error.message };
120	  }
121	}
