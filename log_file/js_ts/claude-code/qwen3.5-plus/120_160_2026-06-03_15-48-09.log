21	// Progress bar animation function
22	async function showProgressBar(message, steps) {
23	  const spinner = ora(message).start();
24	  const totalSteps = steps.length;
25	  
26	  for (let i = 0; i < totalSteps; i++) {
27	    const step = steps[i];
28	    spinner.text = `${message} [${i + 1}/${totalSteps}] ${step.text}`;
29	    
30	    if (step.action) {
31	      await step.action();
32	    }
33	    
34	    await new Promise(resolve => setTimeout(resolve, step.delay || 300));
35	  }
36	  
37	  return spinner;
38	}
