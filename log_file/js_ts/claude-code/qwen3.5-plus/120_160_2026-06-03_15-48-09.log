123	// Configure hooks based on scope
124	async function configureHooks(scope = 'project', triggers = ['before_bulk_edit']) {
125	  try {
126	    const settingsPath = scope === 'project'
127	      ? path.join(process.cwd(), '.claude', 'settings.json')
128	      : path.join(os.homedir(), '.claude', 'settings.json');
129	    
130	    let settings = {};
131	    try {
132	      const data = await fsPromises.readFile(settingsPath, 'utf8');
133	      settings = JSON.parse(data);
134	    } catch {
135	      // File doesn't exist
136	    }
137	    
138	    if (!settings.hooks) {
139	      settings.hooks = {};
140	    }
141	    
142	    if (!Array.isArray(settings.hooks.PreToolUse)) {
143	      settings.hooks.PreToolUse = [];
144	    }
145	    
146	    // Remove existing claudepoint hooks
147	    settings.hooks.PreToolUse = settings.hooks.PreToolUse.filter(hook => 
148	      !hook.hooks || !hook.hooks.some(h => h.command && h.command.includes('claudepoint-hook'))
149	    );
150	    
151	    // Add hooks for specified triggers
152	    const toolMap = {
153	      'before_bulk_edit': ['MultiEdit'],
154	      'before_major_write': ['Write'],
155	      'before_bash_commands': ['Bash'],
156	      'before_file_operations': ['*']
157	    };
158	    
159	    triggers.forEach(trigger => {
160	      const tools = toolMap[trigger] || [];
161	      tools.forEach(tool => {
162	        settings.hooks.PreToolUse.push({
163	          matcher: tool,
164	          hooks: [{
165	            type: 'command',
166	            command: `claudepoint-hook --trigger ${trigger} --tool ${tool}`
167	          }]
168	        });
169	      });
170	    });
171	    
172	    await fsPromises.mkdir(path.dirname(settingsPath), { recursive: true });
173	    await fsPromises.writeFile(settingsPath, JSON.stringify(settings, null, 2));
174	    
175	    return { success: true, scope, settingsPath };
176	  } catch (error) {
177	    return { success: false, error: error.message };
178	  }
179	}
