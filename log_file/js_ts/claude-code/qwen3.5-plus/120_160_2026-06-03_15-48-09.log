230	  async handleCreateClaudepoint(args) {
231	    const { name, description } = args || {};
232	    
233	    console.error(`[claudepoint] Creating claudepoint: name=${name}, desc=${description}`);
234	    console.error(`[claudepoint] Working in: ${process.cwd()}`);
235	    
236	    try {
237	      // Add timeout protection
238	      const timeoutPromise = new Promise((_, reject) => {
239	        setTimeout(() => reject(new Error('Operation timed out after 10 seconds')), 10000);
240	      });
241	      
242	      const operationPromise = (async () => {
243	        await this.manager.ensureDirectories();
244	        console.error(`[claudepoint] Getting project files...`);
245	        const files = await this.manager.getProjectFiles();
246	        console.error(`[claudepoint] Found ${files.length} files`);
247	        return files;
248	      })();
249	      
250	      const files = await Promise.race([operationPromise, timeoutPromise]);
251	      
252	      if (files.length === 0) {
253	        return {
254	          content: [
255	            {
256	              type: 'text',
257	              text: '🚨 No files found to deploy! Make sure you\'re in a project directory and run setup first.'
258	            }
259	          ]
260	        };
261	      }
262	
263	      const result = await this.manager.create(name, description);
264	      
265	      if (result.success) {
266	        const successMsg = this.manager.getRandomMessage(this.manager.successMessages);
267	        return {
268	          content: [
269	            {
270	              type: 'text',
271	              text: `${successMsg}\n   💾 Name: ${result.name}\n   📁 Files: ${result.fileCount}\n   📊 Size: ${result.size}\n   📝 Description: ${result.description || 'Manual claudepoint'}`
272	            }
273	          ]
274	        };
275	      } else if (result.noChanges) {
276	        return {
277	          content: [
278	            {
279	              type: 'text',
280	              text: '🤔 Codebase is stable // No changes detected since last claudepoint'
281	            }
282	          ]
283	        };
284	      } else {
285	        return {
286	          content: [
287	            {
288	              type: 'text',
289	              text: `🚨 Deploy failed: ${result.error}`
290	            }
291	          ]
292	        };
293	      }
294	    } catch (error) {
295	      return {
296	        content: [
297	          {
298	            type: 'text',
299	            text: `🚨 Error deploying claudepoint: ${error.message}`
300	          }
301	        ]
302	      };
303	    }
304	  }
