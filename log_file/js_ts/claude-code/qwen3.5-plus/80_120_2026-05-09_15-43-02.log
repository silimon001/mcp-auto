1	#!/usr/bin/env node --experimental-strip-types
2	
3	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
4	import { setupServer } from "../src/server.ts";
5	
6	async function main() {
7		const blueskyToken = process.env.BLUESKY_APP_KEY;
8		const blueskyIdentifier = process.env.BLUESKY_IDENTIFIER;
9		const serviceUrl = process.env.BLUESKY_SERVICE_URL;
10	
11		if (!blueskyToken || !blueskyIdentifier) {
12			console.error("BLUESKY_APP_KEY and BLUESKY_IDENTIFIER must be set");
13			process.exit(1);
14		}
15	
16		const server = new McpServer({
17			name: "Bluesky MCP Server",
18			version: "1.0.0",
19		});
20	
21		await setupServer({
22			server,
23			credentials: {
24				appKey: blueskyToken,
25				identifier: blueskyIdentifier,
26				...(serviceUrl && { serviceUrl }),
27			},
28			mode: "local",
29		});
30	}
31	
32	main().catch((error) => {
33		console.error("Unhandled error:", error);
34		process.exit(1);
35	});
