372	    with open('mcp_server_config/config.json', 'w', encoding='utf-8') as f:
373	        f.write('{\n\n}')
374	
375	    with open('claude_code/prompt_workflow.md', 'r', encoding='utf-8') as f:
376	        task_prompt = f.read()
377	
378	    task_prompt = task_prompt.replace("{WORKSPACE}", os.getcwd())
379	    print(task_prompt)
380	
381	    from glob import glob
382	    # 获取待处理的 README 文件列表
383	    readme_dir = Path.cwd() / "data" / "dataset" / dataset_name / "sampled_validated_readme"
384	    readme_files = sorted(glob(str(readme_dir / "*.md")), key=os.path.getsize)
385	    
386	    pos = 80
