345	# ==================== 工具函数 ====================
346	def add_extra_info(dataset_name: str, repo_id: str) -> str:
347	    """从数据集读取仓库额外信息"""
348	    final_text = ''
349	    repo_info_path = Path.cwd() / "data" / "dataset" / dataset_name / "repo_info.json"
350	    if repo_info_path.exists():
351	        with open(repo_info_path, 'r', encoding='utf-8') as f:
352	            repo_infos = json.load(f)
353	        for repo_info in repo_infos:
354	            if repo_info.get('id') == int(repo_id):
355	                info = {k: repo_info.get(k) for k in ["id", "description", "language", "size", "topic", "html_url"]}
356	                info['owner'] = repo_info.get('full_name').split('/')[0]
357	                info['name'] = repo_info.get('full_name').split('/')[1]
358	                final_text += f'\n=== REPO INFO START ===\n{info}\n=== REPO INFO END ===\n'
359	                break
360	    return final_text
361	
