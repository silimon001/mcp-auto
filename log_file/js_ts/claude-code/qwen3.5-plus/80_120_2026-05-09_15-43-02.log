407	function parseStationsData(rawData: string): Record<string, StationData> {
408	  const result: Record<string, StationData> = {};
409	  const dataArray = rawData.split('|');
410	  const dataList: string[][] = [];
411	  for (let i = 0; i < Math.floor(dataArray.length / 10); i++) {
412	    dataList.push(dataArray.slice(i * 10, i * 10 + 10));
413	  }
414	  for (const group of dataList) {
415	    let station: Partial<StationData> = {};
416	    StationDataKeys.forEach((key, index) => {
417	      station[key] = group[index];
418	    });
419	    if (!station.station_code) {
420	      continue;
421	    }
422	    result[station.station_code!] = station as StationData;
423	  }
424	  return result;
425	}
