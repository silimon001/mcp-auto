54	export async function getActions(jwt: string): Promise<any | null> {
55	  try {
56	    const url = `${envs.ACTIONKIT_BASE_URL}/projects/${envs.PROJECT_ID}/actions?limit_to_available=false`;
57	    const response = await fetch(url, {
58	      method: "GET",
59	      headers: {
60	        "Content-Type": "application/json",
61	        Authorization: `Bearer ${jwt}`,
62	      },
63	    });
64	
65	    await handleResponseErrors(response);
66	    return await response.json();
67	  } catch (error) {
68	    console.error("Could not make ActionKit POST request: " + error);
69	    return null;
70	  }
71	}
