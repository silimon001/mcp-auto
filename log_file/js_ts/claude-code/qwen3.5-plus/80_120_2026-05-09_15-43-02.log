427	function extractPrices(
428	  yp_info: string,
429	  seat_discount_info: string,
430	  ticketData: TicketData | InterlineTicketData
431	): Price[] {
432	  const PRICE_STR_LENGTH = 10;
433	  const DISCOUNT_STR_LENGTH = 5;
434	  const prices: Price[] = [];
435	  const discounts: { [key: string]: number } = {};
436	  for (let i = 0; i < seat_discount_info.length / DISCOUNT_STR_LENGTH; i++) {
437	    const discount_str = seat_discount_info.slice(
438	      i * DISCOUNT_STR_LENGTH,
439	      (i + 1) * DISCOUNT_STR_LENGTH
440	    );
441	    discounts[discount_str[0]] = parseInt(discount_str.slice(1), 10);
442	  }
443	
444	  for (let i = 0; i < yp_info.length / PRICE_STR_LENGTH; i++) {
445	    const price_str = yp_info.slice(
446	      i * PRICE_STR_LENGTH,
447	      (i + 1) * PRICE_STR_LENGTH
448	    );
449	    var seat_type_code;
450	    if (parseInt(price_str.slice(6, 10), 10) >= 3000){ // 根据12306的js逆向出来的，不懂。
451	      seat_type_code = 'W'; // 为无座
452	    }
453	    else if(!Object.keys(SEAT_TYPES).includes(price_str[0])){
454	      seat_type_code = 'H'; // 其他坐席
455	    }
456	    else{
457	      seat_type_code = price_str[0];
458	    }
459	    const seat_type = SEAT_TYPES[seat_type_code as keyof typeof SEAT_TYPES];
460	    const price = parseInt(price_str.slice(1, 6), 10) / 10;
461	    const discount = seat_type_code in discounts ? discounts[seat_type_code] : null;
462	    prices.push({
463	      seat_name: seat_type.name,
464	      short: seat_type.short,
465	      seat_type_code,
466	      num: ticketData[
467	        `${seat_type.short}_num` as keyof (TicketData | InterlineTicketData)
468	      ],
469	      price,
470	      discount,
471	    });
472	  }
473	  return prices;
474	}
475	
476	function extractDWFlags(dw_flag_str: string): string[] {
477	  const dwFlagList = dw_flag_str.split('#');
478	  let result = [];
479	  if ('5' == dwFlagList[0]) {
480	    result.push(DW_FLAGS[0]);
481	  }
482	  if (dwFlagList.length > 1 && '1' == dwFlagList[1]) {
483	    result.push(DW_FLAGS[1]);
484	  }
485	  if (dwFlagList.length > 2) {
486	    if ('Q' == dwFlagList[2].substring(0, 1)) {
487	      result.push(DW_FLAGS[2]);
488	    } else if ('R' == dwFlagList[2].substring(0, 1)) {
489	      result.push(DW_FLAGS[3]);
490	    }
491	  }
492	  if (dwFlagList.length > 5 && 'D' == dwFlagList[5]) {
493	    result.push(DW_FLAGS[4]);
494	  }
495	  if (dwFlagList.length > 6 && 'z' != dwFlagList[6]) {
496	    result.push(DW_FLAGS[5]);
497	  }
498	  if (dwFlagList.length > 7 && 'z' != dwFlagList[7]) {
499	    result.push(DW_FLAGS[6]);
500	  }
501	  return result;
502	}
