48	        new winston.transports.File({
49	            filename: path.join(logsDir, 'error.log'),
50	            level: 'error',
51	            maxsize: 5242880, // 5MB
52	            maxFiles: 5,
53	        }),
54	        // Combined logs
55	        new winston.transports.File({
56	            filename: path.join(logsDir, 'combined.log'),
57	            maxsize: 5242880, // 5MB
58	            maxFiles: 5,
59	        }),
60	    ],
61	});
62	// Add console transport in development, but only for stderr
63	if (process.env.NODE_ENV !== 'production') {
64	    logger.add(new winston.transports.Console({
65	        format: winston.format.combine(winston.format.colorize(), winston.format.simple()),
66	        stderrLevels: ['error', 'warn', 'info', 'debug'], // Send all logs to stderr
67	    }));
