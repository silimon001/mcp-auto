14	    'DROPBOX_REDIRECT_URI',
15	    'TOKEN_ENCRYPTION_KEY'
16	];
17	// Function to validate environment variables
18	export function validateConfig() {
19	    for (const envVar of requiredEnvVars) {
20	        if (!process.env[envVar]) {
21	            throw new McpError(ErrorCode.InvalidParams, `Missing required environment variable: ${envVar}`);
22	        }
23	    }
24	}
25	// Skip validation during setup
26	const isSetup = process.argv[1]?.endsWith('setup.js');
27	if (!isSetup) {
28	    validateConfig();
29	}
30	// Create logs directory if it doesn't exist
31	// Use a fixed path for tests instead of import.meta.url
32	const logsDir = path.join(process.cwd(), 'logs');
33	try {
34	    fs.mkdirSync(logsDir, { recursive: true });
35	}
36	catch (error) {
37	    const fsError = error;
38	    console.error('Failed to create logs directory:', fsError);
39	    throw new McpError(ErrorCode.InternalError, `Failed to create logs directory at ${logsDir}: ${fsError.message}`);
40	}
41	// Configure Winston logger
42	const logger = winston.createLogger({
43	    level: process.env.LOG_LEVEL || 'info',
