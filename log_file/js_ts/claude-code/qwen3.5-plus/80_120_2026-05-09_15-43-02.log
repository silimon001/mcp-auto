  "content": "#!/usr/bin/env node\nimport { Server } from '@modelcontextprotocol/sdk/server/index.js';\nimport { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';\nimport {\n  CallToolRequestSchema,\n  ListToolsRequestSchema,\n  Tool,\n} from '@modelcontextprotocol/sdk/types.js';\nimport { graphql, buildSchema, introspectionFromSchema } from 'graphql';\nimport fetch from 'node-fetch';\n\ninterface GraphQLOperation {\n  name: string;\n  type: 'query' | 'mutation';\n  args: Record<string, any>;\n  description?: string;\n}\n\ninterface IntrospectionResult {\n  __schema: {\n    queryType?: { name: string };\n    mutationType?: { name: string };\n    types: any[];\n  };\n}\n\nclass GraphQLMCPServer {\n  private server: Server;\n  private endpoint: string;\n  private apiKey?: string;\n  private enableMutations: boolean = false;\n  private whitelistedQueries?: string[];\n  private whitelistedMutations?: string[];\n  private operations: GraphQLOperation[] = [];\n  private schema?: any;\n\n  constructor() {\n    this.endpoint = process.env.GRAPHQL_API_ENDPOINT || 'https://countries.trevorblades.com/graphql';\n    this.apiKey = process.env.GRAPHQL_API_KEY;\n    this.enableMutations = process.env.ENABLE_MUTATIONS === 'true';\n\n    const whitelistQueries = process.env.WHITELISTED_QUERIES;\n    if (whitelistQueries) {\n      try {\n        this.whitelistedQueries = JSON.parse(whitelistQueries);\n      } catch {\n        this.whitelistedQueries = whitelistQueries.split(',').map(s => s.trim());\n      }\n    }\n\n    const whitelistMutations = process.env.WHITELISTED_MUTATIONS;\n    if (whitelistMutations) {\n      try {\n        this.whitelistedMutations = JSON.parse(whitelistMutation);\n      } catch {\n        this.whitelistedMutations = whitelistMutations.split(',').map(s => s.trim());\n      }\n    }\n\n    this.server = new Server(\n      {\n        name: 'graphql-mcp',\n        version: '1.0.0',\n      },\n      {\n        capabilities: {\n          tools: {},\n        },\n      }\n    );\n\n    this.setupHandlers();\n  }\n\n  private setupHandlers() {\n    this.server.setRequestHandler(ListToolsRequestSchema, async () => {\n      await this.introspectSchema();\n      return { tools: this.operations.map(op => this.operationToTool(op)) };\n    });\n\n    this.server.setRequestHandler(CallToolRequestSchema, async (request) => {\n      const operationName = request.params.name;\n      const args = request.params.arguments || {};\n\n      const operation = this.operations.find(op => op.name === operationName);\n      if (!operation) {\n        throw new Error(`Operation ${operationName} not found`);\n      }\n\n      const result = await this.executeOperation(operation, args);\n      return {\n        content: [\n          {\n            type: 'text',\n            text: JSON.stringify(result, null, 2),\n          },\n        ],\n      };\n    });\n  }\n\n  private operationToTool(operation: GraphQLOperation): Tool {\n    const tool: Tool = {\n      name: operation.name,\n      description: operation.description || `Execute GraphQL ${operation.type}: ${operation.name}`,\n      inputSchema: {\n        type: 'object',\n        properties: this.argsToSchema(operation.args),\n        required: Object.keys(operation.args).filter(key => operation.args[key].required),\n      },\n    };\n    return tool;\n  }\n\n  private argsToSchema(args: Record<string, any>): Record<string, any> {\n    const schema: Record<string, any> = {};\n    for (const [key, value] of Object.entries(args)) {\n      schema[key] = {\n        type: this.graphqlTypeToJsonType(value.type),\n        description: value.description || '',\n      };\n    }\n    return schema;\n  }\n\n  private graphqlTypeToJsonType(graphqlType: string): string {\n    const type = graphqlType.replace(/[!\\[\\]]/g, '');\n    switch (type) {\n      case 'String':\n        return 'string';\n      case 'Int':\n      case 'Float':\n        return 'number';\n      case 'Boolean':\n        return 'boolean';\n      case 'ID':\n        return 'string';\n      default:\n        return 'object';\n    }\n  }\n\n  private async introspectSchema() {\n    if (this.operations.length > 0) return;\n\n    const introspectionQuery = `\n      query IntrospectionQuery {\n        __schema {\n          queryType { name }\n          mutationType { name }\n          types {\n            ... on ObjectType {\n              name\n              fields {\n                name\n                description\n                args {\n                  name\n                  description\n                  type {\n                    name\n                    kind\n                    ofType {\n                      name\n                      kind\n                      ofType {\n                        name\n                        kind\n                        ofType {\n                          name\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n            ... on InputObjectType {\n              name\n              inputFields {\n                name\n                description\n                type {\n                  name\n                  kind\n                  ofType {\n                    name\n                    kind\n                    ofType {\n                      name\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    `;\n\n    try {\n      const response = await fetch(this.endpoint, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          ...(this.apiKey && { 'X-API-Key': this.apiKey }),\n        },\n        body: JSON.stringify({ query: introspectionQuery }),\n      });\n\n      const result = await response.json() as IntrospectionResult;\n\n      if (result.errors) {\n        console.error('Introspection errors:', JSON.stringify(result.errors));\n        return;\n      }\n\n      const schema = result.__schema;\n      const queryTypeName = schema.queryType?.name || 'Query';\n      const mutationTypeName = schema.mutationType?.name || 'Mutation';\n\n      const queryType = schema.types.find(t => t.name === queryTypeName);\n      if (queryType && queryType.fields) {\n        for (const field of queryType.fields) {\n          if (!this.whitelistedQueries || this.whitelistedQueries.includes(field.name)) {\n            this.operations.push({\n              name: field.name,\n              type: 'query',\n              args: this.extractArgs(field.args),\n              description: field.description || `Query: ${field.name}`,\n            });\n          }\n        }\n      }\n\n      if (this.enableMutations) {\n        const mutationType = schema.types.find(t => t.name === mutationTypeName);\n        if (mutationType && mutationType.fields) {\n          for (const field of mutationType.fields) {\n            if (!this.whitelistedMutations || this.whitelistedMutations.includes(field.name)) {\n              this.operations.push({\n                name: `mutation_${field.name}`,\n                type: 'mutation',\n                args: this.extractArgs(field.args),\n                description: `Mutation: ${field.name}`,\n              });\n            }\n          }\n        }\n      }\n\n    } catch (error) {\n      console.error('Failed to introspect schema:', error);\n    }\n  }\n\n  private extractArgs(args: any[]): Record<string, any> {\n    const result: Record<string, any> = {};\n    for (const arg of args || []) {\n      result[arg.name] = {\n        type: this.getTypeName(arg.type),\n        description: arg.description || '',\n        required: arg.type.kind === 'NON_NULL',\n      };\n    }\n    return result;\n  }\n\n  private getTypeName(type: any): string {\n    if (!type) return 'String';\n    if (type.ofType) {\n      return this.getTypeName(type.ofType);\n    }\n    return type.name || 'String';\n  }\n\n  private async executeOperation(operation: GraphQLOperation, args: Record<string, any>): Promise<any> {\n    let query: string;\n\n    if (operation.type === 'mutation') {\n      const mutationName = operation.name.replace('mutation_', '');\n      const argNames = Object.keys(args);\n      const argDefinitions = argNames.map(name => `$${name}: ${this.getArgType(args[name])}`).join(', ');\n      const argUsages = argNames.map(name => `${name}: $${name}`).join(', ');\n      query = `\n        mutation ${mutationName}(${argDefinitions}) {\n          ${mutationName}(${argUsages}) {\n            ${this.buildSelectionSet()}\n          }\n        }\n      `;\n    } else {\n      const argNames = Object.keys(args);\n      const argDefinitions = argNames.map(name => `$${name}: ${this.getArgType(args[name])}`).join(', ');\n      const argUsages = argNames.map(name => `${name}: $${name}`).join(', ');\n      query = `\n        query ${operation.name}(${argDefinitions}) {\n          ${operation.name}(${argUsages}) {\n            ${this.buildSelectionSet()}\n          }\n        }\n      `;\n    }\n\n    const response = await fetch(this.endpoint, {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        ...(this.apiKey && { 'X-API-Key': this.apiKey }),\n      },\n      body: JSON.stringify({ query, variables: args }),\n    });\n\n    const result = await response.json();\n    return result;\n  }\n\n  private getArgType(value: any): string {\n    if (value.required) {\n      return `${value.type}!`;\n    }\n    return value.type;\n  }\n\n  private buildSelectionSet(): string {\n    return '__typename\\n... on Query {\\n  __typename\\n}\\n';\n  }\n\n  async run() {\n    const transport = new StdioServerTransport();\n    await this.server.connect(transport);\n    console.error('GraphQL MCP Server running on stdio');\n  }\n}\n\nconst server = new GraphQLMCPServer();\nserver.run().catch(console.error);\n"
}
