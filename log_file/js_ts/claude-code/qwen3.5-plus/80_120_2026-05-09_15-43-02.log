370	    os.makedirs('mcp_server', exist_ok=True)
371	    os.makedirs('mcp_server_config', exist_ok=True)
372	    with open('mcp_server_config/config.json', 'w', encoding='utf-8') as f:
373	        f.write('{\n\n}')
374	
375	    with open('claude_code/prompt_workflow.md', 'r', encoding='utf-8') as f:
376	        task_prompt = f.read()
377	
378	    task_prompt = task_prompt.replace("{WORKSPACE}", os.getcwd())
379	    print(task_prompt)
380	
381	    from glob import glob
382	    # 获取待处理的 README 文件列表
383	    readme_dir = Path.cwd() / "data" / "dataset" / dataset_name / "sampled_validated_readme"
384	    readme_files = sorted(glob(str(readme_dir / "*.md")), key=os.path.getsize)
385	    
386	    pos = 80
387	    count = 40
388	
389	    for readme_path in readme_files[pos:pos+count]:
390	        readme_path = Path(readme_path)
391	        filename_parts = readme_path.stem.split('_')
392	        repo_id = filename_parts[0]
393	        repo_name = '_'.join(filename_parts[1:]).replace('_README', '')
394	
395	        with open(readme_path, 'r', encoding='utf-8') as f:
396	            readme_content = f.read()
397	
398	        extra_info = add_extra_info(dataset_name, repo_id)
399	
400	        query = f'''\n=== README.md START ===\n{readme_content}\n=== README.md END ===\n{extra_info}'''
401	
402	        all_prompt = task_prompt + query
403	
404	        print(all_prompt)
