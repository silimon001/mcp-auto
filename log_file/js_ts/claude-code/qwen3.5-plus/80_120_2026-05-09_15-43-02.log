293	function formatTicketsInfo(ticketsInfo: TicketInfo[]): string {
294	  if (ticketsInfo.length === 0) {
295	    return '没有查询到相关车次信息';
296	  }
297	  let result = '车次 | 出发站 -> 到达站 | 出发时间 -> 到达时间 | 历时\n';
298	  ticketsInfo.forEach((ticketInfo) => {
299	    let infoStr = '';
300	    infoStr += `${ticketInfo.start_train_code}(实际车次train_no: ${ticketInfo.train_no}) ${ticketInfo.from_station}(telecode: ${ticketInfo.from_station_telecode}) -> ${ticketInfo.to_station}(telecode: ${ticketInfo.to_station_telecode}) ${ticketInfo.start_time} -> ${ticketInfo.arrive_time} 历时：${ticketInfo.lishi}`;
301	    ticketInfo.prices.forEach((price) => {
302	      infoStr += `\n- ${price.seat_name}: ${
303	        price.num.match(/^\d+$/) ? price.num + '张' : price.num
304	      }剩余 ${price.price}元`;
305	    });
306	    result += `${infoStr}\n`;
307	  });
308	  return result;
309	}
