42	def run_claude_stream(prompt_text: str, json_log_path: str):
43	    """
44	    流式运行 Claude，并实时写 JSONL
45	    """
46	
47	    process = subprocess.Popen(
48	        [
49	            "claude",
50	            "--print",
51	            "--verbose",
52	            "--max-turns", "20",
53	            "--output-format", "stream-json",
54	            "--permission-mode", "bypassPermissions"
55	        ],
56	        stdin=subprocess.PIPE,
57	        stdout=subprocess.PIPE,
58	        stderr=subprocess.PIPE,
59	        text=True,
60	        encoding="utf-8",
61	        bufsize=1
62	    )
63	
64	    process.stdin.write(prompt_text)
65	    process.stdin.close()
66	
67	    events = []
68	
69	    got_result = False
70	
71	    with open(json_log_path, "a", encoding="utf-8") as jf:
72	
73	        while True:
74	
75	            # 读取一行
76	            line = process.stdout.readline()
77	
78	            # EOF
79	            if not line:
80	
81	                # 进程已退出
82	                if process.poll() is not None:
83	                    break
84	
85	                continue
86	
87	            line = line.strip()
88	
89	            if not line:
90	                continue
91	
92	            try:
93	                obj = json.loads(line)
94	
95	                obj["_received_at"] = datetime.now(
96	                    timezone.utc
97	                ).isoformat()
98	
99	                events.append(obj)
100	
101	                jf.write(
102	                    json.dumps(
103	                        obj,
104	                        ensure_ascii=False
105	                    ) + "\n"
106	                )
107	
108	                jf.flush()
109	
110	                # 收到最终 result
