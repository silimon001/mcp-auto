268	// Tool handlers
269	async function handleCreateProject(args) {
270	  const { projectName } = CreateProjectSchema.parse(args);
271	  const id = uuidv4();
272	  const name = projectName || `Project ${id.slice(0, 8)}`;
273	
274	  db.prepare('INSERT INTO projects (id, name) VALUES (?, ?)').run(id, name);
275	
276	  return { content: [{ type: 'text', text: JSON.stringify({ project_id: id }) }] };
277	}
278	
279	async function handleAddTask(args) {
280	  const { project_id, description, dependencies, priority, status } = AddTaskSchema.parse(args);
281	
282	  const id = uuidv4();
283	  const stmt = db.prepare('INSERT INTO tasks (id, project_id, description, priority, status) VALUES (?, ?, ?, ?, ?)');
284	  stmt.run(id, project_id, description, priority || 'medium', status || 'todo');
285	
286	  if (dependencies && dependencies.length > 0) {
287	    const depStmt = db.prepare('INSERT INTO task_dependencies (task_id, depends_on_id) VALUES (?, ?)');
288	    for (const depId of dependencies) {
289	      depStmt.run(id, depId);
290	    }
291	  }
292	
293	  const task = db.prepare('SELECT * FROM tasks WHERE id = ?').get(id);
294	  return { content: [{ type: 'text', text: JSON.stringify(task) }] };
295	}
296	
297	async function handleListTasks(args) {
298	  const { project_id, status, include_subtasks } = ListTasksSchema.parse(args);
299	
300	  let query = 'SELECT * FROM tasks WHERE project_id = ?';
301	  const params = [project_id];
302	
303	  if (status) {
304	    query += ' AND status = ?';
305	    params.push(status);
306	  }
307	
308	  if (!include_subtasks) {
309	    query += ' AND parent_id IS NULL';
310	  }
311	
312	  const tasks = db.prepare(query).all(...params);
313	  return { content: [{ type: 'text', text: JSON.stringify(tasks) }] };
314	}
315	
316	async function handleShowTask(args) {
317	  const { project_id, task_id } = ShowTaskSchema.parse(args);
318	
319	  const task = db.prepare('SELECT * FROM tasks WHERE id = ? AND project_id = ?').get(task_id, project_id);
320	
321	  if (!task) {
322	    return { content: [{ type: 'text', text: JSON.stringify({ error: 'Task not found' }) }] };
323	  }
324	
325	  const dependencies = db.prepare('SELECT depends_on_id FROM task_dependencies WHERE task_id = ?').all(task_id);
326	  const subtasks = db.prepare('SELECT * FROM tasks WHERE parent_id = ?').all(task_id);
327	
328	  const fullTask = {
329	    ...task,
330	    dependencies: dependencies.map(d => d.depends_on_id),
331	    subtasks,
332	  };
333	
334	  return { content: [{ type: 'text', text: JSON.stringify(fullTask) }] };
335	}
336	
337	async function handleSetTaskStatus(args) {
338	  const { project_id, task_ids, status } = SetTaskStatusSchema.parse(args);
339	
340	  const stmt = db.prepare('UPDATE tasks SET status = ? WHERE id = ? AND project_id = ?');
341	  let updatedCount = 0;
342	
343	  for (const taskId of task_ids) {
344	    const result = stmt.run(status, taskId, project_id);
345	    updatedCount += result.changes;
346	  }
347	
348	  return { content: [{ type: 'text', text: JSON.stringify({ success: true, updated_count: updatedCount }) }] };
349	}
350	
351	async function handleExpandTask(args) {
352	  const { project_id, task_id, subtask_descriptions, force } = ExpandTaskSchema.parse(args);
353	
354	  const parent = db.prepare('SELECT * FROM tasks WHERE id = ? AND project_id = ?').get(task_id, project_id);
355	
356	  if (!parent) {
357	    return { content: [{ type: 'text', text: JSON.stringify({ error: 'Parent task not found' }) }] };
358	  }
359	
360	  if (force) {
361	    db.prepare('DELETE FROM tasks WHERE parent_id = ?').run(task_id);
362	  }
363	
364	  const insertStmt = db.prepare('INSERT INTO tasks (id, project_id, description, priority, status, parent_id) VALUES (?, ?, ?, ?, ?, ?)');
365	
366	  for (const desc of subtask_descriptions) {
367	    const subtaskId = uuidv4();
368	    insertStmt.run(subtaskId, project_id, desc, 'medium', 'todo', task_id);
369	  }
370	
371	  const updatedTask = db.prepare('SELECT * FROM tasks WHERE id = ?').get(task_id);
372	  const subtasks = db.prepare('SELECT * FROM tasks WHERE parent_id = ?').all(task_id);
373	
374	  return { content: [{ type: 'text', text: JSON.stringify({ ...updatedTask, subtasks }) }] };
375	}
376	
377	async function handleGetNextTask(args) {
378	  const { project_id } = GetNextTaskSchema.parse(args);
379	
380	  // Get all todo tasks without completed dependencies
381	  const tasks = db.prepare(`
382	    SELECT t.* FROM tasks t
383	    WHERE t.project_id = ?
384	    AND t.status = 'todo'
385	    AND t.parent_id IS NULL
386	    ORDER BY
387	      CASE t.priority WHEN 'high' THEN 1 WHEN 'medium' THEN 2 WHEN 'low' THEN 3 END,
388	      t.created_at
389	  `).all(project_id);
390	
391	  for (const task of tasks) {
392	    const deps = db.prepare('SELECT depends_on_id FROM task_dependencies WHERE task_id = ?').all(task.id);
393	    if (deps.length === 0) {
394	      // No dependencies, can be done
395	      const fullTask = { ...task, dependencies: [], subtasks: [] };
396	      return { content: [{ type: 'text', text: JSON.stringify(fullTask) }] };
397	    }
398	
399	    // Check if all dependencies are done
400	    let allDepsDone = true;
401	    for (const dep of deps) {
402	      const depTask = db.prepare('SELECT status FROM tasks WHERE id = ?').get(dep.depends_on_id);
403	      if (!depTask || depTask.status !== 'done') {
404	        allDepsDone = false;
405	        break;
406	      }
407	    }
408	
409	    if (allDepsDone) {
410	      const fullTask = { ...task, dependencies: deps.map(d => d.depends_on_id), subtasks: [] };
411	      return { content: [{ type: 'text', text: JSON.stringify(fullTask) }] };
412	    }
413	  }
414	
415	  return { content: [{ type: 'text', text: JSON.stringify(null) }] };
416	}
417	
418	async function handleExportProject(args) {
419	  const { project_id } = ExportProjectSchema.parse(args);
420	
421	  const project = db.prepare('SELECT * FROM projects WHERE id = ?').get(project_id);
422	  if (!project) {
423	    return { content: [{ type: 'text', text: JSON.stringify({ error: 'Project not found' }) }] };
424	  }
425	
426	  const tasks = db.prepare('SELECT * FROM tasks WHERE project_id = ?').all(project_id);
427	  const dependencies = db.prepare('SELECT * FROM task_dependencies').all();
428	
429	  const exportData = {
430	    project,
431	    tasks,
432	    dependencies,
433	  };
434	
435	  return { content: [{ type: 'text', text: JSON.stringify(exportData) }] };
436	}
437	
438	async function handleImportProject(args) {
439	  const { project_data, new_project_name } = ImportProjectSchema.parse(args);
440	
441	  const data = JSON.parse(project_data);
442	  const newProjectId = uuidv4();
443	  const projectName = new_project_name || data.project.name || `Imported ${newProjectId.slice(0, 8)}`;
444	
445	  // Create new project
446	  db.prepare('INSERT INTO projects (id, name) VALUES (?, ?)').run(newProjectId, projectName);
447	
448	  // Map old task IDs to new task IDs
449	  const idMap = {};
450	
451	  // Insert tasks
452	  for (const task of data.tasks) {
453	    const newTaskId = uuidv4();
454	    idMap[task.id] = newTaskId;
455	
456	    db.prepare(`
457	      INSERT INTO tasks (id, project_id, description, priority, status, parent_id)
458	      VALUES (?, ?, ?, ?, ?, ?)
459	    `).run(newTaskId, newProjectId, task.description, task.priority, task.status, task.parent_id ? idMap[task.parent_id] : null);
460	  }
461	
462	  // Insert dependencies
463	  for (const dep of data.dependencies) {
464	    if (idMap[dep.task_id] && idMap[dep.depends_on_id]) {
465	      db.prepare('INSERT INTO task_dependencies (task_id, depends_on_id) VALUES (?, ?)').run(
466	        idMap[dep.task_id],
467	        idMap[dep.depends_on_id]
468	      );
469	    }
470	  }
471	
472	  return { content: [{ type: 'text', text: JSON.stringify({ project_id: newProjectId }) }] };
473	}
474	
475	async function handleUpdateTask(args) {
476	  const { project_id, task_id, description, priority, dependencies } = UpdateTaskSchema.parse(args);
477	
478	  const task = db.prepare('SELECT * FROM tasks WHERE id = ? AND project_id = ?').get(task_id, project_id);
479	  if (!task) {
480	    return { content: [{ type: 'text', text: JSON.stringify({ error: 'Task not found' }) }] };
481	  }
482	
483	  // Update fields
484	  if (description !== undefined) {
485	    db.prepare('UPDATE tasks SET description = ? WHERE id = ?').run(description, task_id);
486	  }
487	  if (priority !== undefined) {
488	    db.prepare('UPDATE tasks SET priority = ? WHERE id = ?').run(priority, task_id);
489	  }
490	
491	  // Update dependencies
492	  if (dependencies !== undefined) {
493	    db.prepare('DELETE FROM task_dependencies WHERE task_id = ?').run(task_id);
494	    const depStmt = db.prepare('INSERT INTO task_dependencies (task_id, depends_on_id) VALUES (?, ?)');
495	    for (const depId of dependencies) {
496	      depStmt.run(task_id, depId);
497	    }
498	  }
499	
500	  const updatedTask = db.prepare('SELECT * FROM tasks WHERE id = ?').get(task_id);
501	  const deps = db.prepare('SELECT depends_on_id FROM task_dependencies WHERE task_id = ?').all(task_id);
502	  const subtasks = db.prepare('SELECT * FROM tasks WHERE parent_id = ?').all(task_id);
503	
504	  return { content: [{ type: 'text', text: JSON.stringify({ ...updatedTask, dependencies: deps.map(d => d.depends_on_id), subtasks }) }] };
505	}
506	
507	async function handleDeleteTask(args) {
508	  const { project_id, task_ids } = DeleteTaskSchema.parse(args);
509	
510	  const stmt = db.prepare('DELETE FROM tasks WHERE id = ? AND project_id = ?');
511	  let deletedCount = 0;
512	
513	  for (const taskId of task_ids) {
514	    const result = stmt.run(taskId, project_id);
515	    deletedCount += result.changes;
516	  }
517	
518	  return { content: [{ type: 'text', text: JSON.stringify({ success: true, deleted_count: deletedCount }) }] };
519	}
520	
521	async function handleDeleteProject(args) {
522	  const { project_id } = DeleteProjectSchema.parse(args);
523	
524	  const result = db.prepare('DELETE FROM projects WHERE id = ?').run(project_id);
525	
526	  return { content: [{ type: 'text', text: JSON.stringify({ success: true }) }] };
527	}
528	
529	// Create MCP server
530	const server = new Server(
531	  {
532	    name: 'mcp-task-manager-server',
533	    version: '1.0.0',
534	  },
535	  {
536	    capabilities: {
537	      tools: {},
538	    },
539	  }
540	);
541	
542	// List tools handler
543	server.setRequestHandler(ListToolsRequestSchema, async () => {
544	  return { tools };
545	});
546	
547	// Call tool handler
548	server.setRequestHandler(CallToolRequestSchema, async (request) => {
549	  const { name, arguments: args } = request.params;
550	
551	  try {
552	    switch (name) {
553	      case 'createProject':
554	        return await handleCreateProject(args || {});
555	      case 'addTask':
556	        return await handleAddTask(args || {});
557	      case 'listTasks':
558	        return await handleListTasks(args || {});
559	      case 'showTask':
560	        return await handleShowTask(args || {});
561	      case 'setTaskStatus':
562	        return await handleSetTaskStatus(args || {});
563	      case 'expandTask':
564	        return await handleExpandTask(args || {});
565	      case 'getNextTask':
566	        return await handleGetNextTask(args || {});
567	      case 'exportProject':
568	        return await handleExportProject(args || {});
569	      case 'importProject':
570	        return await handleImportProject(args || {});
571	      case 'updateTask':
572	        return await handleUpdateTask(args || {});
573	      case 'deleteTask':
574	        return await handleDeleteTask(args || {});
575	      case 'deleteProject':
576	        return await handleDeleteProject(args || {});
577	      default:
578	        return { content: [{ type: 'text', text: `Unknown tool: ${name}` }] };
579	    }
580	  } catch (error) {
581	    return { content: [{ type: 'text', text: JSON.stringify({ error: error.message }) }] };
582	  }
583	});
584	
585	// Start server
586	async function main() {
587	  const transport = new StdioServerTransport();
588	  await server.connect(transport);
589	  console.error('MCP Task Manager Server running on stdio');
590	}
591	
592	main().catch((error) => {
593	  console.error('Fatal error:', error);
594	  process.exit(1);
595	});
