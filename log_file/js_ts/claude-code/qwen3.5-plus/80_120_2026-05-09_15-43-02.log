1028	async function getStations(): Promise<Record<string, StationData>> {
1029	  const html = await make12306Request<string>(WEB_URL);
1030	  if (html == null) {
1031	    throw new Error('Error: get 12306 web page failed.');
1032	  }
1033	  const match = html.match('.(/script/core/common/station_name.+?.js)');
1034	  if (match == null) {
1035	    throw new Error('Error: get station name js file failed.');
1036	  }
1037	  const stationNameJSFilePath = match[0];
1038	  const stationNameJS = await make12306Request<string>(
1039	    new URL(stationNameJSFilePath, WEB_URL)
1040	  );
1041	  if (stationNameJS == null) {
1042	    throw new Error('Error: get station name js file failed.');
1043	  }
1044	  const rawData = eval(stationNameJS.replace('var station_names =', ''));
1045	  const stationsData = parseStationsData(rawData);
1046	  // 加上缺失的车站信息
1047	  for (const station of MISSING_STATIONS) {
1048	    if (!stationsData[station.station_code]) {
1049	      stationsData[station.station_code] = station;
1050	    }
1051	  }
1052	  return stationsData;
1053	}
