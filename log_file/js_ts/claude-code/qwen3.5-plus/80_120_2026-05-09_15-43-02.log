257	def write_log(messages, order, log_file):
258	    """按轮次和时间戳输出，末尾附加任务结果总结"""
259	    turn = 0
260	    with open(log_file, "a", encoding="utf-8") as f:
261	        for item in order:
262	            # -------- 结果总结（直接输出，不改变轮次）--------
263	            if isinstance(item, dict) and item.get("type") == "result":
264	                ts = item.get("timestamp", "")
265	                data = item["data"]
266	
267	                f.write(f"\n{'=' * 60}\n")
268	                f.write(f"[RESULT] [TIMESTAMP {ts}]\n")
269	                f.write(f"  状态: {'❌ 失败' if data['is_error'] else '✅ 成功'}\n")
270	                f.write(f"  子类型: {data['subtype']}\n")
271	                f.write(f"  实际轮次: {data['num_turns']}\n")
272	                f.write(f"  停止原因: {data['stop_reason']}\n")
273	                f.write(f"  终端原因: {data['terminal_reason']}\n")
274	                f.write(f"  耗时: {data['duration_ms']} ms (API: {data['duration_api_ms']} ms)\n")
275	                f.write(f"  成本: ${data['total_cost_usd']:.6f}\n")
276	
277	                usage = data.get("usage", {})
278	                if usage:
279	                    f.write(f"  Token 使用:\n")
280	                    f.write(f"    - 输入: {usage.get('input_tokens', '?')}\n")
281	                    f.write(f"    - 输出: {usage.get('output_tokens', '?')}\n")
282	                    f.write(f"    - 缓存创建: {usage.get('cache_creation_input_tokens', '?')}\n")
283	                    f.write(f"    - 缓存读取: {usage.get('cache_read_input_tokens', '?')}\n")
284	
285	                errors = data.get("errors", [])
286	                if errors:
287	                    f.write(f"  错误信息:\n")
288	                    for err in errors:
289	                        f.write(f"    - {err}\n")
290	                f.write(f"{'=' * 60}\n")
291	                continue   # result 块输出完毕，跳过后续普通处理
292	
293	            # -------- system / user --------
294	            if isinstance(item, dict):
295	                role = item["type"].upper()
296	                ts = item.get("timestamp", "")
297	                f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
298	                f.write(f"[{role}]:\n{item['content']}\n")
299	                f.write("\n" + "-" * 60 + "\n")
300	                continue
301	
302	            # -------- assistant --------
303	            turn += 1
304	            msg = messages[item]
305	            ts = msg.get("timestamp", "")
306	            f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
307	
308	            text = "\n".join(msg["texts"]).strip()
309	            if text:
310	                f.write(f"[ASSISTANT]:\n{text}\n")
311	
312	            for tool in msg["tools"]:
313	                f.write(f"[ASSISTANT][TOOL]: {tool['name']}\n")
314	                f.write("[TOOL INPUT]:\n")
315	                f.write(json.dumps(tool["input"], indent=2, ensure_ascii=False))
316	                f.write("\n")
317	
318	            if msg["tokens"]:
319	                t = msg["tokens"]
320	                f.write(f"[TOKENS] input={t['input']} output={t['output']}\n")
321	
322	            f.write("\n" + "-" * 60 + "\n")
323	
324	def run_task(prompt_text: str, task_name, pos, count):
325	
326	    json_log_path = f"{LOG_DIR}/tmp_{task_name}.jsonl"
327	
328	    events, stderr = run_claude_stream(
329	        prompt_text,
330	        json_log_path
331	    )
332	
333	    messages, order = collect_messages(events)
334	    log_file = f"{LOG_DIR}/{pos}_{pos+count}_{timestamp}.log"
335	    write_log(messages, order, log_file)
336	
337	    if stderr:
338	        with open(log_file, "a") as f:
339	            f.write("\n[STDERR]\n")
340	            f.write(stderr)
341	
342	    print(f"✅ Done: {log_file}")
343	
344	
345	# ==================== 工具函数 ====================
346	def add_extra_info(dataset_name: str, repo_id: str) -> str:
347	    """从数据集读取仓库额外信息"""
348	    final_text = ''
349	    repo_info_path = Path.cwd() / "data" / "dataset" / dataset_name / "repo_info.json"
350	    if repo_info_path.exists():
351	        with open(repo_info_path, 'r', encoding='utf-8') as f:
352	            repo_infos = json.load(f)
353	        for repo_info in repo_infos:
354	            if repo_info.get('id') == int(repo_id):
355	                info = {k: repo_info.get(k) for k in ["id", "description", "language", "size", "topic", "html_url"]}
356	                info['owner'] = repo_info.get('full_name').split('/')[0]
357	                info['name'] = repo_info.get('full_name').split('/')[1]
358	                final_text += f'\n=== REPO INFO START ===\n{info}\n=== REPO INFO END ===\n'
359	                break
360	    return final_text
361	
