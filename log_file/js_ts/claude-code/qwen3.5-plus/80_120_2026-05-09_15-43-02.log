504	function checkDate(date: string): boolean {
505	  const timeZone = 'Asia/Shanghai';
506	  const nowInShanghai = toZonedTime(new Date(), timeZone);
507	  nowInShanghai.setHours(0, 0, 0, 0);
508	  const inputInShanghai = toZonedTime(new Date(date), timeZone);
509	  inputInShanghai.setHours(0, 0, 0, 0);
510	  return inputInShanghai >= nowInShanghai;
511	}
