182	    return ticketInfo.ticketList[0].dw_flag.includes('智能动车组')
183	      ? true
184	      : false;
185	  },
186	};
187	function parseCookies(cookies: Array<string>): Record<string, string> {
188	  const cookieRecord: Record<string, string> = {};
189	  cookies.forEach((cookie) => {
190	    // 提取键值对部分（去掉 Path、HttpOnly 等属性）
191	    const keyValuePart = cookie.split(';')[0];
192	    // 分割键和值
193	    const [key, value] = keyValuePart.split('=');
194	    // 存入对象
195	    if (key && value) {
196	      cookieRecord[key.trim()] = value.trim();
197	    }
198	  });
199	  return cookieRecord;
200	}
201	
202	function formatCookies(cookies: Record<string, string>): string {
203	  return Object.entries(cookies)
204	    .map(([key, value]) => `${key}=${value}`)
205	    .join('; ');
206	}
