160	    async def init(self, name: str, config: dict):
161	        type = config.get("type", "stdio")
162	        
163	        if type == "stdio":
164	            await self.init_stdio(config)
165	        elif type == "sse":
166	            await self.init_sse(config)
167	        elif type == "streamable_http":
168	            await self.init_streamable_http(config)
169	        else:
170	            raise Exception(f"[FAIL] server {name}: Unknown transport type '{type}'")       
171	
172	    async def init_stdio(self, config: dict):
173	        server_params = StdioServerParameters(
174	            command=get_safe_value(config, "command"),
175	            args=get_safe_value(config, "args"),
176	            env=get_safe_value(config, "env"),
177	            cwd=get_safe_value(config, "cwd"))
178	        stdio_transport = await self.exit_stack.enter_async_context(stdio_client(server_params))
179	        read_stream, write_stream = stdio_transport
180	        self.session = await self.exit_stack.enter_async_context(ClientSession(read_stream, write_stream))
181	        
182	        await self.session.initialize()
