136	def render_content(obj):
137	    """
138	    把 Claude stream-json content 递归展开成纯 string
139	    """
140	    if obj is None:
141	        return ""
142	
143	    # str
144	    if isinstance(obj, str):
145	        return obj
146	
147	    # dict（核心：Claude node）
148	    if isinstance(obj, dict):
149	        t = obj.get("type")
150	
151	        # tool result wrapper
152	        if t == "text":
153	            return render_content(obj.get("text"))
154	
155	        if t == "tool_result":
156	            return render_content(obj.get("content"))
157	
158	        # fallback：尽量抽取 text
159	        if "text" in obj:
160	            return render_content(obj["text"])
161	
162	        return json.dumps(obj, ensure_ascii=False)
163	
164	    # list（递归 flatten）
165	    if isinstance(obj, list):
166	        return "\n".join(render_content(x) for x in obj)
167	
168	    # fallback
169	    return str(obj)
