205	            self.process = start_process(command,args,env,cwd,url)
206	            self._server_process_started = True
207	
208	        try:
209	            sse_transport = await self.exit_stack.enter_async_context(sse_client(url=url, headers=headers))
210	            read_stream, write_stream = sse_transport
211	            self.session = await self.exit_stack.enter_async_context(ClientSession(read_stream, write_stream))
212	        
213	            await self.session.initialize()
