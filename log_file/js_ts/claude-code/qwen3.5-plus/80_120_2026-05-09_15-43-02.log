177	    for event in events:
178	        etype = event.get("type")
179	        ts = event.get("timestamp") or event.get("_received_at", datetime.now(timezone.utc).isoformat())
180	
181	        # -------- system --------
182	        if etype == "system":
183	            order.append({
184	                "type": "system",
185	                "content": f"[SYSTEM] {event.get('subtype', '')}",
186	                "timestamp": ts
187	            })
188	            continue
189	
190	        # -------- user --------
191	        if etype == "user":
192	            contents = event.get("message", {}).get("content", [])
193	            text = render_content(contents)
194	            order.append({
195	                "type": "user",
196	                "content": text,
197	                "timestamp": ts
198	            })
199	            continue
200	
201	        # -------- result (最终总结) --------
202	        if etype == "result":
203	            order.append({
204	                "type": "result",
205	                "timestamp": ts,
206	                "data": {
207	                    "subtype": event.get("subtype"),
208	                    "is_error": event.get("is_error"),
209	                    "num_turns": event.get("num_turns"),
210	                    "stop_reason": event.get("stop_reason"),
211	                    "total_cost_usd": event.get("total_cost_usd"),
212	                    "duration_ms": event.get("duration_ms"),
213	                    "duration_api_ms": event.get("duration_api_ms"),
214	                    "usage": event.get("usage", {}),
215	                    "errors": event.get("errors", []),
216	                    "terminal_reason": event.get("terminal_reason")
217	                }
218	            })
219	            continue
220	
221	        # -------- assistant --------
222	        if etype == "assistant":
223	            msg = event.get("message", {})
224	            msg_id = msg.get("id")
225	
226	            if msg_id not in messages:
227	                messages[msg_id] = {
228	                    "type": "assistant",
229	                    "texts": [],
230	                    "tools": [],
231	                    "tokens": None,
232	                    "timestamp": ts
233	                }
234	                order.append(msg_id)     # 保证顺序
235	
236	            entry = messages[msg_id]
237	
238	            for c in msg.get("content", []):
239	                ctype = c.get("type")
240	                if ctype == "text":
241	                    entry["texts"].append(c.get("text", ""))
242	                elif ctype == "tool_use":
243	                    entry["tools"].append({
244	                        "name": c.get("name"),
245	                        "input": c.get("input")
246	                    })
247	
248	            if msg.get("usage"):
249	                entry["tokens"] = {
250	                    "input": msg["usage"].get("input_tokens"),
251	                    "output": msg["usage"].get("output_tokens")
252	                }
253	
254	    return messages, order
