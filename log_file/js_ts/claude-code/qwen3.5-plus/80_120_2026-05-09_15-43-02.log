513	async function make12306Request<T>(
514	  url: string | URL,
515	  scheme: URLSearchParams = new URLSearchParams(),
516	  headers: Record<string, string> = {}
517	): Promise<T | null> {
518	  try {
519	    const response = await axios.get(url + '?' + scheme.toString(), {
520	      headers: headers,
521	    });
522	    return (await response.data) as T;
523	  } catch (error) {
524	    console.error('Error making 12306 request:', error);
525	    return null;
526	  }
527	}
