42	def run_claude_stream(prompt_text: str, json_log_path: str):
43	    """
44	    流式运行 Claude，并实时写 JSONL
45	    """
46	
47	    process = subprocess.Popen(
48	        [
49	            "claude",
50	            "--print",
51	            "--verbose",
52	            "--max-turns", "20",
53	            "--output-format", "stream-json",
54	            "--permission-mode", "bypassPermissions"
55	        ],
56	        stdin=subprocess.PIPE,
57	        stdout=subprocess.PIPE,
58	        stderr=subprocess.PIPE,
59	        text=True,
60	        encoding="utf-8",
61	        bufsize=1
62	    )
63	
64	    process.stdin.write(prompt_text)
65	    process.stdin.close()
66	
67	    events = []
68	
69	    got_result = False
70	
71	    with open(json_log_path, "a", encoding="utf-8") as jf:
72	
73	        while True:
74	
75	            # 读取一行
76	            line = process.stdout.readline()
77	
78	            # EOF
79	            if not line:
80	
81	                # 进程已退出
82	                if process.poll() is not None:
83	                    break
84	
85	                continue
86	
87	            line = line.strip()
88	
89	            if not line:
90	                continue
91	
92	            try:
93	                obj = json.loads(line)
94	
95	                obj["_received_at"] = datetime.now(
96	                    timezone.utc
97	                ).isoformat()
98	
99	                events.append(obj)
100	
101	                jf.write(
102	                    json.dumps(
103	                        obj,
104	                        ensure_ascii=False
105	                    ) + "\n"
106	                )
107	
108	                jf.flush()
109	
110	                # 收到最终 result
111	                if obj.get("type") == "result":
112	                    got_result = True
113	
114	            except json.JSONDecodeError:
115	                continue
116	
117	            # 已收到 result 且进程结束
118	            if got_result and process.poll() is not None:
119	                break
120	
121	    # 防止卡死
122	    try:
123	        stderr = process.stderr.read()
124	    except:
125	        stderr = ""
126	
127	    # 最多等5秒
128	    try:
129	        process.wait(timeout=120)
130	    except subprocess.TimeoutExpired:
131	        print("⚠️ Claude process timeout, killing...")
132	        process.kill()
133	
134	    return events, stderr
135	
136	def render_content(obj):
137	    """
138	    把 Claude stream-json content 递归展开成纯 string
139	    """
140	    if obj is None:
141	        return ""
142	
143	    # str
144	    if isinstance(obj, str):
145	        return obj
146	
147	    # dict（核心：Claude node）
148	    if isinstance(obj, dict):
149	        t = obj.get("type")
150	
151	        # tool result wrapper
152	        if t == "text":
153	            return render_content(obj.get("text"))
154	
155	        if t == "tool_result":
156	            return render_content(obj.get("content"))
157	
158	        # fallback：尽量抽取 text
159	        if "text" in obj:
160	            return render_content(obj["text"])
161	
162	        return json.dumps(obj, ensure_ascii=False)
163	
164	    # list（递归 flatten）
165	    if isinstance(obj, list):
166	        return "\n".join(render_content(x) for x in obj)
167	
168	    # fallback
169	    return str(obj)
170	
