220	      const mutationTypeName = schema.mutationType?.name || 'Mutation';
221	
222	      const queryType = schema.types.find(t => t.name === queryTypeName);
223	      if (queryType && queryType.fields) {
224	        for (const field of queryType.fields) {
225	          if (!this.whitelistedQueries || this.whitelistedQueries.includes(field.name)) {
226	            this.operations.push({
227	              name: field.name,
228	              type: 'query',
229	              args: this.extractArgs(field.args),
230	              description: field.description || `Query: ${field.name}`,
231	            });
232	          }
233	        }
234	      }
235	
236	      if (this.enableMutations) {
237	        const mutationType = schema.types.find(t => t.name === mutationTypeName);
238	        if (mutationType && mutationType.fields) {
239	          for (const field of mutationType.fields) {
240	            if (!this.whitelistedMutations || this.whitelistedMutations.includes(field.name)) {
241	              this.operations.push({
242	                name: `mutation_${field.name}`,
243	                type: 'mutation',
244	                args: this.extractArgs(field.args),
245	                description: `Mutation: ${field.name}`,
246	              });
247	            }
248	          }
249	        }
250	      }
251	
252	    } catch (error) {
253	      console.error('Failed to introspect schema:', error);
254	    }
255	  }
256	
257	  private extractArgs(args: any[]): Record<string, any> {
258	    const result: Record<string, any> = {};
259	    for (const arg of args || []) {
260	      result[arg.name] = {
261	        type: this.getTypeName(arg.type),
262	        description: arg.description || '',
263	        required: arg.type.kind === 'NON_NULL',
264	      };
265	    }
266	    return result;
267	  }
268	
269	  private getTypeName(type: any): string {
270	    if (!type) return 'String';
271	    if (type.ofType) {
272	      return this.getTypeName(type.ofType);
273	    }
274	    return type.name || 'String';
275	  }
276	
277	  private async executeOperation(operation: GraphQLOperation, args: Record<string, any>): Promise<any> {
278	    let query: string;
279	
280	    if (operation.type === 'mutation') {
281	      const mutationName = operation.name.replace('mutation_', '');
282	      const argNames = Object.keys(args);
283	      const argDefinitions = argNames.map(name => `$${name}: ${this.getArgType(args[name])}`).join(', ');
284	      const argUsages = argNames.map(name => `${name}: $${name}`).join(', ');
285	      query = `
286	        mutation ${mutationName}(${argDefinitions}) {
287	          ${mutationName}(${argUsages}) {
288	            ${this.buildSelectionSet()}
289	          }
290	        }
291	      `;
292	    } else {
293	      const argNames = Object.keys(args);
294	      const argDefinitions = argNames.map(name => `$${name}: ${this.getArgType(args[name])}`).join(', ');
295	      const argUsages = argNames.map(name => `${name}: $${name}`).join(', ');
296	      query = `
297	        query ${operation.name}(${argDefinitions}) {
298	          ${operation.name}(${argUsages}) {
299	            ${this.buildSelectionSet()}
300	          }
301	        }
302	      `;
303	    }
304	
305	    const response = await fetch(this.endpoint, {
306	      method: 'POST',
307	      headers: {
308	        'Content-Type': 'application/json',
309	        ...(this.apiKey && { 'X-API-Key': this.apiKey }),
310	      },
311	      body: JSON.stringify({ query, variables: args }),
312	    });
313	
314	    const result = await response.json();
315	    return result;
316	  }
317	
318	  private getArgType(value: any): string {
319	    if (value.required) {
320	      return `${value.type}!`;
321	    }
322	    return value.type;
323	  }
324	
325	  private buildSelectionSet(): string {
326	    return '__typename\n... on Query {\n  __typename\n}\n';
327	  }
