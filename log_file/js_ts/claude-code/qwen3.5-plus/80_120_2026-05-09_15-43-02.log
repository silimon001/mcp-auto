1	import subprocess
2	import json
3	import os
4	from datetime import datetime, timezone
5	from pathlib import Path
6	from dataset_setting import dataset_name, framework_name
7	from dotenv import load_dotenv
8	
9	LOG_DIR = Path(os.getcwd()) / "log_file" / dataset_name / framework_name / 'qwen3.5-plus'
10	LOG_DIR.mkdir(parents=True, exist_ok=True)
11	
12	timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
13	
14	def load_anthropic_env(env_path: str):
15	    """
16	    加载指定 .env 文件中的 Anthropic 环境变量
17	    """
18	    env_file = Path(env_path)
19	
20	    if not env_file.exists():
21	        raise FileNotFoundError(f".env file not found: {env_file}")
22	
23	    load_dotenv(dotenv_path=env_file, override=True)
24	
25	    required_vars = [
26	        "ANTHROPIC_BASE_URL",
27	        "ANTHROPIC_API_KEY",
28	        "ANTHROPIC_MODEL"
29	    ]
30	
31	    missing = [v for v in required_vars if not os.getenv(v)]
32	
33	    if missing:
34	        raise ValueError(
35	            f"Missing required environment variables: {missing}"
36	        )
37	
38	    print("✅ Anthropic environment loaded")
39	    for var in required_vars:
40	        print(f"{var} = {os.getenv(var)}")
41	
42	def run_claude_stream(prompt_text: str, json_log_path: str):
43	    """
44	    流式运行 Claude，并实时写 JSONL
45	    """
46	
47	    process = subprocess.Popen(
48	        [
49	            "claude",
50	            "--print",
51	            "--verbose",
52	            "--max-turns", "20",
53	            "--output-format", "stream-json",
54	            "--permission-mode", "bypassPermissions"
55	        ],
56	        stdin=subprocess.PIPE,
57	        stdout=subprocess.PIPE,
58	        stderr=subprocess.PIPE,
59	        text=True,
60	        encoding="utf-8",
61	        bufsize=1
62	    )
63	
64	    process.stdin.write(prompt_text)
65	    process.stdin.close()
66	
67	    events = []
68	
69	    got_result = False
70	
71	    with open(json_log_path, "a", encoding="utf-8") as jf:
72	
73	        while True:
74	
75	            # 读取一行
76	            line = process.stdout.readline()
77	
78	            # EOF
79	            if not line:
80	
81	                # 进程已退出
82	                if process.poll() is not None:
83	                    break
84	
85	                continue
86	
87	            line = line.strip()
88	
89	            if not line:
90	                continue
91	
92	            try:
93	                obj = json.loads(line)
94	
95	                obj["_received_at"] = datetime.now(
96	                    timezone.utc
97	                ).isoformat()
98	
99	                events.append(obj)
100	
101	                jf.write(
102	                    json.dumps(
103	                        obj,
104	                        ensure_ascii=False
105	                    ) + "\n"
106	                )
107	
108	                jf.flush()
109	
110	                # 收到最终 result
111	                if obj.get("type") == "result":
112	                    got_result = True
113	
114	            except json.JSONDecodeError:
115	                continue
116	
117	            # 已收到 result 且进程结束
118	            if got_result and process.poll() is not None:
119	                break
120	
121	    # 防止卡死
122	    try:
123	        stderr = process.stderr.read()
124	    except:
125	        stderr = ""
126	
127	    # 最多等5秒
128	    try:
129	        process.wait(timeout=120)
130	    except subprocess.TimeoutExpired:
131	        print("⚠️ Claude process timeout, killing...")
132	        process.kill()
133	
134	    return events, stderr
135	
136	def render_content(obj):
137	    """
138	    把 Claude stream-json content 递归展开成纯 string
139	    """
140	    if obj is None:
141	        return ""
142	
143	    # str
144	    if isinstance(obj, str):
145	        return obj
146	
147	    # dict（核心：Claude node）
148	    if isinstance(obj, dict):
149	        t = obj.get("type")
150	
151	        # tool result wrapper
152	        if t == "text":
153	            return render_content(obj.get("text"))
154	
155	        if t == "tool_result":
156	            return render_content(obj.get("content"))
157	
158	        # fallback：尽量抽取 text
159	        if "text" in obj:
160	            return render_content(obj["text"])
161	
162	        return json.dumps(obj, ensure_ascii=False)
163	
164	    # list（递归 flatten）
165	    if isinstance(obj, list):
166	        return "\n".join(render_content(x) for x in obj)
167	
168	    # fallback
169	    return str(obj)
170	
171	
172	def collect_messages(events):
173	    """聚合事件，记录时间戳，并捕获 result 事件用于总结"""
174	    messages = {}
175	    order = []      # dict(system/user/result) 或 str(assistant msg_id)
176	
177	    for event in events:
178	        etype = event.get("type")
179	        ts = event.get("timestamp") or event.get("_received_at", datetime.now(timezone.utc).isoformat())
180	
181	        # -------- system --------
182	        if etype == "system":
183	            order.append({
184	                "type": "system",
185	                "content": f"[SYSTEM] {event.get('subtype', '')}",
186	                "timestamp": ts
187	            })
188	            continue
189	
190	        # -------- user --------
191	        if etype == "user":
192	            contents = event.get("message", {}).get("content", [])
193	            text = render_content(contents)
194	            order.append({
195	                "type": "user",
196	                "content": text,
197	                "timestamp": ts
198	            })
199	            continue
200	
201	        # -------- result (最终总结) --------
202	        if etype == "result":
203	            order.append({
204	                "type": "result",
205	                "timestamp": ts,
206	                "data": {
207	                    "subtype": event.get("subtype"),
208	                    "is_error": event.get("is_error"),
209	                    "num_turns": event.get("num_turns"),
210	                    "stop_reason": event.get("stop_reason"),
211	                    "total_cost_usd": event.get("total_cost_usd"),
212	                    "duration_ms": event.get("duration_ms"),
213	                    "duration_api_ms": event.get("duration_api_ms"),
214	                    "usage": event.get("usage", {}),
215	                    "errors": event.get("errors", []),
216	                    "terminal_reason": event.get("terminal_reason")
217	                }
218	            })
219	            continue
220	
221	        # -------- assistant --------
222	        if etype == "assistant":
223	            msg = event.get("message", {})
224	            msg_id = msg.get("id")
225	
226	            if msg_id not in messages:
227	                messages[msg_id] = {
228	                    "type": "assistant",
229	                    "texts": [],
230	                    "tools": [],
231	                    "tokens": None,
232	                    "timestamp": ts
233	                }
234	                order.append(msg_id)     # 保证顺序
235	
236	            entry = messages[msg_id]
237	
238	            for c in msg.get("content", []):
239	                ctype = c.get("type")
240	                if ctype == "text":
241	                    entry["texts"].append(c.get("text", ""))
242	                elif ctype == "tool_use":
243	                    entry["tools"].append({
244	                        "name": c.get("name"),
245	                        "input": c.get("input")
246	                    })
247	
248	            if msg.get("usage"):
249	                entry["tokens"] = {
250	                    "input": msg["usage"].get("input_tokens"),
251	                    "output": msg["usage"].get("output_tokens")
252	                }
253	
254	    return messages, order
255	
256	
257	def write_log(messages, order, log_file):
258	    """按轮次和时间戳输出，末尾附加任务结果总结"""
259	    turn = 0
260	    with open(log_file, "a", encoding="utf-8") as f:
261	        for item in order:
262	            # -------- 结果总结（直接输出，不改变轮次）--------
263	            if isinstance(item, dict) and item.get("type") == "result":
264	                ts = item.get("timestamp", "")
265	                data = item["data"]
266	
267	                f.write(f"\n{'=' * 60}\n")
268	                f.write(f"[RESULT] [TIMESTAMP {ts}]\n")
269	                f.write(f"  状态: {'❌ 失败' if data['is_error'] else '✅ 成功'}\n")
270	                f.write(f"  子类型: {data['subtype']}\n")
271	                f.write(f"  实际轮次: {data['num_turns']}\n")
272	                f.write(f"  停止原因: {data['stop_reason']}\n")
273	                f.write(f"  终端原因: {data['terminal_reason']}\n")
274	                f.write(f"  耗时: {data['duration_ms']} ms (API: {data['duration_api_ms']} ms)\n")
275	                f.write(f"  成本: ${data['total_cost_usd']:.6f}\n")
276	
277	                usage = data.get("usage", {})
278	                if usage:
279	                    f.write(f"  Token 使用:\n")
280	                    f.write(f"    - 输入: {usage.get('input_tokens', '?')}\n")
281	                    f.write(f"    - 输出: {usage.get('output_tokens', '?')}\n")
282	                    f.write(f"    - 缓存创建: {usage.get('cache_creation_input_tokens', '?')}\n")
283	                    f.write(f"    - 缓存读取: {usage.get('cache_read_input_tokens', '?')}\n")
284	
285	                errors = data.get("errors", [])
286	                if errors:
287	                    f.write(f"  错误信息:\n")
288	                    for err in errors:
289	                        f.write(f"    - {err}\n")
290	                f.write(f"{'=' * 60}\n")
291	                continue   # result 块输出完毕，跳过后续普通处理
292	
293	            # -------- system / user --------
294	            if isinstance(item, dict):
295	                role = item["type"].upper()
296	                ts = item.get("timestamp", "")
297	                f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
298	                f.write(f"[{role}]:\n{item['content']}\n")
299	                f.write("\n" + "-" * 60 + "\n")
300	                continue
301	
302	            # -------- assistant --------
303	            turn += 1
304	            msg = messages[item]
305	            ts = msg.get("timestamp", "")
306	            f.write(f"\n[TURN {turn}] [TIMESTAMP {ts}]\n")
307	
308	            text = "\n".join(msg["texts"]).strip()
309	            if text:
310	                f.write(f"[ASSISTANT]:\n{text}\n")
311	
312	            for tool in msg["tools"]:
313	                f.write(f"[ASSISTANT][TOOL]: {tool['name']}\n")
314	                f.write("[TOOL INPUT]:\n")
315	                f.write(json.dumps(tool["input"], indent=2, ensure_ascii=False))
316	                f.write("\n")
317	
318	            if msg["tokens"]:
319	                t = msg["tokens"]
320	                f.write(f"[TOKENS] input={t['input']} output={t['output']}\n")
321	
322	            f.write("\n" + "-" * 60 + "\n")
323	
324	def run_task(prompt_text: str, task_name, pos, count):
325	
326	    json_log_path = f"{LOG_DIR}/tmp_{task_name}.jsonl"
327	
328	    events, stderr = run_claude_stream(
329	        prompt_text,
330	        json_log_path
331	    )
332	
333	    messages, order = collect_messages(events)
334	    log_file = f"{LOG_DIR}/{pos}_{pos+count}_{timestamp}.log"
335	    write_log(messages, order, log_file)
336	
337	    if stderr:
338	        with open(log_file, "a") as f:
339	            f.write("\n[STDERR]\n")
340	            f.write(stderr)
341	
342	    print(f"✅ Done: {log_file}")
343	
344	
345	# ==================== 工具函数 ====================
346	def add_extra_info(dataset_name: str, repo_id: str) -> str:
347	    """从数据集读取仓库额外信息"""
348	    final_text = ''
349	    repo_info_path = Path.cwd() / "data" / "dataset" / dataset_name / "repo_info.json"
350	    if repo_info_path.exists():
351	        with open(repo_info_path, 'r', encoding='utf-8') as f:
352	            repo_infos = json.load(f)
353	        for repo_info in repo_infos:
354	            if repo_info.get('id') == int(repo_id):
355	                info = {k: repo_info.get(k) for k in ["id", "description", "language", "size", "topic", "html_url"]}
356	                info['owner'] = repo_info.get('full_name').split('/')[0]
357	                info['name'] = repo_info.get('full_name').split('/')[1]
358	                final_text += f'\n=== REPO INFO START ===\n{info}\n=== REPO INFO END ===\n'
359	                break
360	    return final_text
361	
362	
