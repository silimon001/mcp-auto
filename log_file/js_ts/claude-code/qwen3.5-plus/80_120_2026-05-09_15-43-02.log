14	def load_anthropic_env(env_path: str):
15	    """
16	    加载指定 .env 文件中的 Anthropic 环境变量
17	    """
18	    env_file = Path(env_path)
19	
20	    if not env_file.exists():
21	        raise FileNotFoundError(f".env file not found: {env_file}")
22	
23	    load_dotenv(dotenv_path=env_file, override=True)
24	
25	    required_vars = [
26	        "ANTHROPIC_BASE_URL",
27	        "ANTHROPIC_API_KEY",
28	        "ANTHROPIC_MODEL"
29	    ]
30	
31	    missing = [v for v in required_vars if not os.getenv(v)]
32	
33	    if missing:
34	        raise ValueError(
35	            f"Missing required environment variables: {missing}"
36	        )
37	
38	    print("✅ Anthropic environment loaded")
39	    for var in required_vars:
40	        print(f"{var} = {os.getenv(var)}")
41	
42	def run_claude_stream(prompt_text: str, json_log_path: str):
43	    """
44	    流式运行 Claude，并实时写 JSONL
45	    """
46	
47	    process = subprocess.Popen(
48	        [
49	            "claude",
50	            "--print",
51	            "--verbose",
52	            "--max-turns", "20",
53	            "--output-format", "stream-json",
54	            "--permission-mode", "bypassPermissions"
55	        ],
56	        stdin=subprocess.PIPE,
57	        stdout=subprocess.PIPE,
58	        stderr=subprocess.PIPE,
59	        text=True,
60	        encoding="utf-8",
61	        bufsize=1
62	    )
63	
64	    process.stdin.write(prompt_text)
65	    process.stdin.close()
66	
67	    events = []
68	
69	    got_result = False
70	
71	    with open(json_log_path, "a", encoding="utf-8") as jf:
72	
73	        while True:
74	
75	            # 读取一行
76	            line = process.stdout.readline()
77	
78	            # EOF
79	            if not line:
80	
81	                # 进程已退出
82	                if process.poll() is not None:
83	                    break
84	
85	                continue
86	
87	            line = line.strip()
88	
89	            if not line:
90	                continue
91	
92	            try:
93	                obj = json.loads(line)
94	
95	                obj["_received_at"] = datetime.now(
96	                    timezone.utc
97	                ).isoformat()
98	
99	                events.append(obj)
100	
101	                jf.write(
102	                    json.dumps(
103	                        obj,
104	                        ensure_ascii=False
105	                    ) + "\n"
106	                )
107	
108	                jf.flush()
109	
110	                # 收到最终 result
111	                if obj.get("type") == "result":
112	                    got_result = True
113	
114	            except json.JSONDecodeError:
115	                continue
116	
117	            # 已收到 result 且进程结束
118	            if got_result and process.poll() is not None:
119	                break
120	
121	    # 防止卡死
122	    try:
123	        stderr = process.stderr.read()
124	    except:
125	        stderr = ""
126	
127	    # 最多等5秒
128	    try:
129	        process.wait(timeout=120)
130	    except subprocess.TimeoutExpired:
131	        print("⚠️ Claude process timeout, killing...")
132	        process.kill()
133	
134	    return events, stderr
135	
136	def render_content(obj):
137	    """
138	    把 Claude stream-json content 递归展开成纯 string
139	    """
140	    if obj is None:
141	        return ""
142	
143	    # str
144	    if isinstance(obj, str):
145	        return obj
146	
147	    # dict（核心：Claude node）
148	    if isinstance(obj, dict):
149	        t = obj.get("type")
150	
151	        # tool result wrapper
152	        if t == "text":
153	            return render_content(obj.get("text"))
154	
155	        if t == "tool_result":
156	            return render_content(obj.get("content"))
157	
158	        # fallback：尽量抽取 text
159	        if "text" in obj:
160	            return render_content(obj["text"])
161	
162	        return json.dumps(obj, ensure_ascii=False)
163	
164	    # list（递归 flatten）
165	    if isinstance(obj, list):
166	        return "\n".join(render_content(x) for x in obj)
167	
168	    # fallback
169	    return str(obj)
170	
171	
172	def collect_messages(events):
173	    """聚合事件，记录时间戳，并捕获 result 事件用于总结"""
174	    messages = {}
175	    order = []      # dict(system/user/result) 或 str(assistant msg_id)
176	
177	    for event in events:
178	        etype = event.get("type")
179	        ts = event.get("timestamp") or event.get("_received_at", datetime.now(timezone.utc).isoformat())
180	
181	        # -------- system --------
182	        if etype == "system":
183	            order.append({
184	                "type": "system",
185	                "content": f"[SYSTEM] {event.get('subtype', '')}",
186	                "timestamp": ts
187	            })
188	            continue
189	
190	        # -------- user --------
191	        if etype == "user":
192	            contents = event.get("message", {}).get("content", [])
193	            text = render_content(contents)
194	            order.append({
195	                "type": "user",
196	                "content": text,
197	                "timestamp": ts
198	            })
199	            continue
200	
201	        # -------- result (最终总结) --------
202	        if etype == "result":
203	            order.append({
204	                "type": "result",
205	                "timestamp": ts,
206	                "data": {
207	                    "subtype": event.get("subtype"),
208	                    "is_error": event.get("is_error"),
209	                    "num_turns": event.get("num_turns"),
210	                    "stop_reason": event.get("stop_reason"),
211	                    "total_cost_usd": event.get("total_cost_usd"),
212	                    "duration_ms": event.get("duration_ms"),
213	                    "duration_api_ms": event.get("duration_api_ms"),
214	                    "usage": event.get("usage", {}),
215	                    "errors": event.get("errors", []),
216	                    "terminal_reason": event.get("terminal_reason")
217	                }
218	            })
219	            continue
220	
221	        # -------- assistant --------
222	        if etype == "assistant":
223	            msg = event.get("message", {})
224	            msg_id = msg.get("id")
225	
226	            if msg_id not in messages:
227	                messages[msg_id] = {
228	                    "type": "assistant",
229	                    "texts": [],
230	                    "tools": [],
231	                    "tokens": None,
232	                    "timestamp": ts
233	                }
234	                order.append(msg_id)     # 保证顺序
235	
236	            entry = messages[msg_id]
237	
238	            for c in msg.get("content", []):
239	                ctype = c.get("type")
240	                if ctype == "text":
241	                    entry["texts"].append(c.get("text", ""))
242	                elif ctype == "tool_use":
243	                    entry["tools"].append({
244	                        "name": c.get("name"),
245	                        "input": c.get("input")
246	                    })
247	
248	            if msg.get("usage"):
249	                entry["tokens"] = {
250	                    "input": msg["usage"].get("input_tokens"),
251	                    "output": msg["usage"].get("output_tokens")
252	                }
253	
254	    return messages, order
255	
