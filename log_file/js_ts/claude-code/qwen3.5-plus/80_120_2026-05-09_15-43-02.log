  "content": "#!/usr/bin/env node\nimport { Server } from '@modelcontextprotocol/sdk/server/index.js';\nimport { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';\nimport {\n  CallToolRequestSchema,\n  ListToolsRequestSchema,\n} from '@modelcontextprotocol/sdk/types.js';\nimport Database from 'better-sqlite3';\nimport { v4 as uuidv4 } from 'uuid';\nimport { z } from 'zod';\n\nconst DB_PATH = process.env.DATABASE_PATH || './data/taskmanager.db';\n\n// Initialize database\nconst db = new Database(DB_PATH);\n\n// Create tables\ndb.exec(`\n  CREATE TABLE IF NOT EXISTS projects (\n    id TEXT PRIMARY KEY,\n    name TEXT NOT NULL,\n    created_at TEXT DEFAULT CURRENT_TIMESTAMP\n  );\n\n  CREATE TABLE IF NOT EXISTS tasks (\n    id TEXT PRIMARY KEY,\n    project_id TEXT NOT NULL,\n    description TEXT NOT NULL,\n    priority TEXT DEFAULT 'medium',\n    status TEXT DEFAULT 'todo',\n    parent_id TEXT,\n    created_at TEXT DEFAULT CURRENT_TIMESTAMP,\n    FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE,\n    FOREIGN KEY (parent_id) REFERENCES tasks(id) ON DELETE CASCADE\n  );\n\n  CREATE TABLE IF NOT EXISTS task_dependencies (\n    task_id TEXT NOT NULL,\n    depends_on_id TEXT NOT NULL,\n    PRIMARY KEY (task_id, depends_on_id),\n    FOREIGN KEY (task_id) REFERENCES tasks(id) ON DELETE CASCADE,\n    FOREIGN KEY (depends_on_id) REFERENCES tasks(id) ON DELETE CASCADE\n  );\n`);\n\n// Tool schemas\nconst CreateProjectSchema = z.object({\n  projectName: z.string().max(255).optional(),\n});\n\nconst AddTaskSchema = z.object({\n  project_id: z.string().uuid(),\n  description: z.string().min(1).max(1024),\n  dependencies: z.array(z.string()).max(50).optional(),\n  priority: z.enum(['high', 'medium', 'low']).optional().default('medium'),\n  status: z.enum(['todo', 'in-progress', 'review', 'done']).optional().default('todo'),\n});\n\nconst ListTasksSchema = z.object({\n  project_id: z.string().uuid(),\n  status: z.enum(['todo', 'in-progress', 'review', 'done']).optional(),\n  include_subtasks: z.boolean().optional().default(false),\n});\n\nconst ShowTaskSchema = z.object({\n  project_id: z.string().uuid(),\n  task_id: z.string(),\n});\n\nconst SetTaskStatusSchema = z.object({\n  project_id: z.string().uuid(),\n  task_ids: z.array(z.string()).min(1).max(100),\n  status: z.enum(['todo', 'in-progress', 'review', 'done']),\n});\n\nconst ExpandTaskSchema = z.object({\n  project_id: z.string().uuid(),\n  task_id: z.string(),\n  subtask_descriptions: z.array(z.string().min(1).max(512)).min(1).max(20),\n  force: z.boolean().optional().default(false),\n});\n\nconst GetNextTaskSchema = z.object({\n  project_id: z.string().uuid(),\n});\n\nconst ExportProjectSchema = z.object({\n  project_id: z.string().uuid(),\n  format: z.enum(['json']).optional().default('json'),\n});\n\nconst ImportProjectSchema = z.object({\n  project_data: z.string(),\n  new_project_name: z.string().max(255).optional(),\n});\n\nconst UpdateTaskSchema = z.object({\n  project_id: z.string().uuid(),\n  task_id: z.string().uuid(),\n  description: z.string().min(1).max(1024).optional(),\n  priority: z.enum(['high', 'medium', 'low']).optional(),\n  dependencies: z.array(z.string()).max(50).optional(),\n});\n\nconst DeleteTaskSchema = z.object({\n  project_id: z.string().uuid(),\n  task_ids: z.array(z.string()).min(1).max(100),\n});\n\nconst DeleteProjectSchema = z.object({\n  project_id: z.string().uuid(),\n});\n\n// Tool definitions\nconst tools = [\n  {\n    name: 'createProject',\n    description: 'Creates a new, empty project.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        projectName: { type: 'string', maxLength: 255 },\n      },\n    },\n  },\n  {\n    name: 'addTask',\n    description: 'Adds a new task to a project.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_id: { type: 'string' },\n        description: { type: 'string' },\n        dependencies: { type: 'array', items: { type: 'string' } },\n        priority: { type: 'string', enum: ['high', 'medium', 'low'] },\n        status: { type: 'string', enum: ['todo', 'in-progress', 'review', 'done'] },\n      },\n      required: ['project_id', 'description'],\n    },\n  },\n  {\n    name: 'listTasks',\n    description: 'Lists tasks for a project, with optional filtering and subtask inclusion.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_id: { type: 'string' },\n        status: { type: 'string', enum: ['todo', 'in-progress', 'review', 'done'] },\n        include_subtasks: { type: 'boolean' },\n      },\n      required: ['project_id'],\n    },\n  },\n  {\n    name: 'showTask',\n    description: 'Retrieves full details for a specific task, including dependencies and direct subtasks.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_id: { type: 'string' },\n        task_id: { type: 'string' },\n      },\n      required: ['project_id', 'task_id'],\n    },\n  },\n  {\n    name: 'setTaskStatus',\n    description: 'Updates the status of one or more tasks.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_id: { type: 'string' },\n        task_ids: { type: 'array', items: { type: 'string' } },\n        status: { type: 'string', enum: ['todo', 'in-progress', 'review', 'done'] },\n      },\n      required: ['project_id', 'task_ids', 'status'],\n    },\n  },\n  {\n    name: 'expandTask',\n    description: 'Breaks a parent task into subtasks, optionally replacing existing ones.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_id: { type: 'string' },\n        task_id: { type: 'string' },\n        subtask_descriptions: { type: 'array', items: { type: 'string' } },\n        force: { type: 'boolean' },\n      },\n      required: ['project_id', 'task_id', 'subtask_descriptions'],\n    },\n  },\n  {\n    name: 'getNextTask',\n    description: 'Identifies the next actionable task based on status, dependencies, priority, and creation date.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_id: { type: 'string' },\n      },\n      required: ['project_id'],\n    },\n  },\n  {\n    name: 'exportProject',\n    description: 'Exports complete project data as a JSON string.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_id: { type: 'string' },\n        format: { type: 'string', enum: ['json'] },\n      },\n      required: ['project_id'],\n    },\n  },\n  {\n    name: 'importProject',\n    description: 'Creates a new project from an exported JSON string.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_data: { type: 'string' },\n        new_project_name: { type: 'string' },\n      },\n      required: ['project_data'],\n    },\n  },\n  {\n    name: 'updateTask',\n    description: 'Updates specific details (description, priority, dependencies) of an existing task.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_id: { type: 'string' },\n        task_id: { type: 'string' },\n        description: { type: 'string' },\n        priority: { type: 'string', enum: ['high', 'medium', 'low'] },\n        dependencies: { type: 'array', items: { type: 'string' } },\n      },\n      required: ['project_id', 'task_id'],\n    },\n  },\n  {\n    name: 'deleteTask',\n    description: 'Deletes one or more tasks (and their subtasks/dependency links via cascade).',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_id: { type: 'string' },\n        task_ids: { type: 'array', items: { type: 'string' } },\n      },\n      required: ['project_id', 'task_ids'],\n    },\n  },\n  {\n    name: 'deleteProject',\n    description: 'Permanently deletes a project and ALL associated data.',\n    inputSchema: {\n      type: 'object',\n      properties: {\n        project_id: { type: 'string' },\n      },\n      required: ['project_id'],\n    },\n  },\n];\n\n// Tool handlers\nasync function handleCreateProject(args) {\n  const { projectName } = CreateProjectSchema.parse(args);\n  const id = uuidv4();\n  const name = projectName || `Project ${id.slice(0, 8)}`;\n\n  db.prepare('INSERT INTO projects (id, name) VALUES (?, ?)').run(id, name);\n\n  return { content: [{ type: 'text', text: JSON.stringify({ project_id: id }) }] };\n}\n\nasync function handleAddTask(args) {\n  const { project_id, description, dependencies, priority, status } = AddTaskSchema.parse(args);\n\n  const id = uuidv4();\n  const stmt = db.prepare('INSERT INTO tasks (id, project_id, description, priority, status) VALUES (?, ?, ?, ?, ?)');\n  stmt.run(id, project_id, description, priority || 'medium', status || 'todo');\n\n  if (dependencies && dependencies.length > 0) {\n    const depStmt = db.prepare('INSERT INTO task_dependencies (task_id, depends_on_id) VALUES (?, ?)');\n    for (const depId of dependencies) {\n      depStmt.run(id, depId);\n    }\n  }\n\n  const task = db.prepare('SELECT * FROM tasks WHERE id = ?').get(id);\n  return { content: [{ type: 'text', text: JSON.stringify(task) }] };\n}\n\nasync function handleListTasks(args) {\n  const { project_id, status, include_subtasks } = ListTasksSchema.parse(args);\n\n  let query = 'SELECT * FROM tasks WHERE project_id = ?';\n  const params = [project_id];\n\n  if (status) {\n    query += ' AND status = ?';\n    params.push(status);\n  }\n\n  if (!include_subtasks) {\n    query += ' AND parent_id IS NULL';\n  }\n\n  const tasks = db.prepare(query).all(...params);\n  return { content: [{ type: 'text', text: JSON.stringify(tasks) }] };\n}\n\nasync function handleShowTask(args) {\n  const { project_id, task_id } = ShowTaskSchema.parse(args);\n\n  const task = db.prepare('SELECT * FROM tasks WHERE id = ? AND project_id = ?').get(task_id, project_id);\n\n  if (!task) {\n    return { content: [{ type: 'text', text: JSON.stringify({ error: 'Task not found' }) }] };\n  }\n\n  const dependencies = db.prepare('SELECT depends_on_id FROM task_dependencies WHERE task_id = ?').all(task_id);\n  const subtasks = db.prepare('SELECT * FROM tasks WHERE parent_id = ?').all(task_id);\n\n  const fullTask = {\n    ...task,\n    dependencies: dependencies.map(d => d.depends_on_id),\n    subtasks,\n  };\n\n  return { content: [{ type: 'text', text: JSON.stringify(fullTask) }] };\n}\n\nasync function handleSetTaskStatus(args) {\n  const { project_id, task_ids, status } = SetTaskStatusSchema.parse(args);\n\n  const stmt = db.prepare('UPDATE tasks SET status = ? WHERE id = ? AND project_id = ?');\n  let updatedCount = 0;\n\n  for (const taskId of task_ids) {\n    const result = stmt.run(status, taskId, project_id);\n    updatedCount += result.changes;\n  }\n\n  return { content: [{ type: 'text', text: JSON.stringify({ success: true, updated_count: updatedCount }) }] };\n}\n\nasync function handleExpandTask(args) {\n  const { project_id, task_id, subtask_descriptions, force } = ExpandTaskSchema.parse(args);\n\n  const parent = db.prepare('SELECT * FROM tasks WHERE id = ? AND project_id = ?').get(task_id, project_id);\n\n  if (!parent) {\n    return { content: [{ type: 'text', text: JSON.stringify({ error: 'Parent task not found' }) }] };\n  }\n\n  if (force) {\n    db.prepare('DELETE FROM tasks WHERE parent_id = ?').run(task_id);\n  }\n\n  const insertStmt = db.prepare('INSERT INTO tasks (id, project_id, description, priority, status, parent_id) VALUES (?, ?, ?, ?, ?, ?)');\n\n  for (const desc of subtask_descriptions) {\n    const subtaskId = uuidv4();\n    insertStmt.run(subtaskId, project_id, desc, 'medium', 'todo', task_id);\n  }\n\n  const updatedTask = db.prepare('SELECT * FROM tasks WHERE id = ?').get(task_id);\n  const subtasks = db.prepare('SELECT * FROM tasks WHERE parent_id = ?').all(task_id);\n\n  return { content: [{ type: 'text', text: JSON.stringify({ ...updatedTask, subtasks }) }] };\n}\n\nasync function handleGetNextTask(args) {\n  const { project_id } = GetNextTaskSchema.parse(args);\n\n  // Get all todo tasks without completed dependencies\n  const tasks = db.prepare(`\n    SELECT t.* FROM tasks t\n    WHERE t.project_id = ?\n    AND t.status = 'todo'\n    AND t.parent_id IS NULL\n    ORDER BY\n      CASE t.priority WHEN 'high' THEN 1 WHEN 'medium' THEN 2 WHEN 'low' THEN 3 END,\n      t.created_at\n  `).all(project_id);\n\n  for (const task of tasks) {\n    const deps = db.prepare('SELECT depends_on_id FROM task_dependencies WHERE task_id = ?').all(task.id);\n    if (deps.length === 0) {\n      // No dependencies, can be done\n      const fullTask = { ...task, dependencies: [], subtasks: [] };\n      return { content: [{ type: 'text', text: JSON.stringify(fullTask) }] };\n    }\n\n    // Check if all dependencies are done\n    let allDepsDone = true;\n    for (const dep of deps) {\n      const depTask = db.prepare('SELECT status FROM tasks WHERE id = ?').get(dep.depends_on_id);\n      if (!depTask || depTask.status !== 'done') {\n        allDepsDone = false;\n        break;\n      }\n    }\n\n    if (allDepsDone) {\n      const fullTask = { ...task, dependencies: deps.map(d => d.depends_on_id), subtasks: [] };\n      return { content: [{ type: 'text', text: JSON.stringify(fullTask) }] };\n    }\n  }\n\n  return { content: [{ type: 'text', text: JSON.stringify(null) }] };\n}\n\nasync function handleExportProject(args) {\n  const { project_id } = ExportProjectSchema.parse(args);\n\n  const project = db.prepare('SELECT * FROM projects WHERE id = ?').get(project_id);\n  if (!project) {\n    return { content: [{ type: 'text', text: JSON.stringify({ error: 'Project not found' }) }] };\n  }\n\n  const tasks = db.prepare('SELECT * FROM tasks WHERE project_id = ?').all(project_id);\n  const dependencies = db.prepare('SELECT * FROM task_dependencies').all();\n\n  const exportData = {\n    project,\n    tasks,\n    dependencies,\n  };\n\n  return { content: [{ type: 'text', text: JSON.stringify(exportData) }] };\n}\n\nasync function handleImportProject(args) {\n  const { project_data, new_project_name } = ImportProjectSchema.parse(args);\n\n  const data = JSON.parse(project_data);\n  const newProjectId = uuidv4();\n  const projectName = new_project_name || data.project.name || `Imported ${newProjectId.slice(0, 8)}`;\n\n  // Create new project\n  db.prepare('INSERT INTO projects (id, name) VALUES (?, ?)').run(newProjectId, projectName);\n\n  // Map old task IDs to new task IDs\n  const idMap = {};\n\n  // Insert tasks\n  for (const task of data.tasks) {\n    const newTaskId = uuidv4();\n    idMap[task.id] = newTaskId;\n\n    db.prepare(`\n      INSERT INTO tasks (id, project_id, description, priority, status, parent_id)\n      VALUES (?, ?, ?, ?, ?, ?)\n    `).run(newTaskId, newProjectId, task.description, task.priority, task.status, task.parent_id ? idMap[task.parent_id] : null);\n  }\n\n  // Insert dependencies\n  for (const dep of data.dependencies) {\n    if (idMap[dep.task_id] && idMap[dep.depends_on_id]) {\n      db.prepare('INSERT INTO task_dependencies (task_id, depends_on_id) VALUES (?, ?)').run(\n        idMap[dep.task_id],\n        idMap[dep.depends_on_id]\n      );\n    }\n  }\n\n  return { content: [{ type: 'text', text: JSON.stringify({ project_id: newProjectId }) }] };\n}\n\nasync function handleUpdateTask(args) {\n  const { project_id, task_id, description, priority, dependencies } = UpdateTaskSchema.parse(args);\n\n  const task = db.prepare('SELECT * FROM tasks WHERE id = ? AND project_id = ?').get(task_id, project_id);\n  if (!task) {\n    return { content: [{ type: 'text', text: JSON.stringify({ error: 'Task not found' }) }] };\n  }\n\n  // Update fields\n  if (description !== undefined) {\n    db.prepare('UPDATE tasks SET description = ? WHERE id = ?').run(description, task_id);\n  }\n  if (priority !== undefined) {\n    db.prepare('UPDATE tasks SET priority = ? WHERE id = ?').run(priority, task_id);\n  }\n\n  // Update dependencies\n  if (dependencies !== undefined) {\n    db.prepare('DELETE FROM task_dependencies WHERE task_id = ?').run(task_id);\n    const depStmt = db.prepare('INSERT INTO task_dependencies (task_id, depends_on_id) VALUES (?, ?)');\n    for (const depId of dependencies) {\n      depStmt.run(task_id, depId);\n    }\n  }\n\n  const updatedTask = db.prepare('SELECT * FROM tasks WHERE id = ?').get(task_id);\n  const deps = db.prepare('SELECT depends_on_id FROM task_dependencies WHERE task_id = ?').all(task_id);\n  const subtasks = db.prepare('SELECT * FROM tasks WHERE parent_id = ?').all(task_id);\n\n  return { content: [{ type: 'text', text: JSON.stringify({ ...updatedTask, dependencies: deps.map(d => d.depends_on_id), subtasks }) }] };\n}\n\nasync function handleDeleteTask(args) {\n  const { project_id, task_ids } = DeleteTaskSchema.parse(args);\n\n  const stmt = db.prepare('DELETE FROM tasks WHERE id = ? AND project_id = ?');\n  let deletedCount = 0;\n\n  for (const taskId of task_ids) {\n    const result = stmt.run(taskId, project_id);\n    deletedCount += result.changes;\n  }\n\n  return { content: [{ type: 'text', text: JSON.stringify({ success: true, deleted_count: deletedCount }) }] };\n}\n\nasync function handleDeleteProject(args) {\n  const { project_id } = DeleteProjectSchema.parse(args);\n\n  const result = db.prepare('DELETE FROM projects WHERE id = ?').run(project_id);\n\n  return { content: [{ type: 'text', text: JSON.stringify({ success: true }) }] };\n}\n\n// Create MCP server\nconst server = new Server(\n  {\n    name: 'mcp-task-manager-server',\n    version: '1.0.0',\n  },\n  {\n    capabilities: {\n      tools: {},\n    },\n  }\n);\n\n// List tools handler\nserver.setRequestHandler(ListToolsRequestSchema, async () => {\n  return { tools };\n});\n\n// Call tool handler\nserver.setRequestHandler(CallToolRequestSchema, async (request) => {\n  const { name, arguments: args } = request.params;\n\n  try {\n    switch (name) {\n      case 'createProject':\n        return await handleCreateProject(args || {});\n      case 'addTask':\n        return await handleAddTask(args || {});\n      case 'listTasks':\n        return await handleListTasks(args || {});\n      case 'showTask':\n        return await handleShowTask(args || {});\n      case 'setTaskStatus':\n        return await handleSetTaskStatus(args || {});\n      case 'expandTask':\n        return await handleExpandTask(args || {});\n      case 'getNextTask':\n        return await handleGetNextTask(args || {});\n      case 'exportProject':\n        return await handleExportProject(args || {});\n      case 'importProject':\n        return await handleImportProject(args || {});\n      case 'updateTask':\n        return await handleUpdateTask(args || {});\n      case 'deleteTask':\n        return await handleDeleteTask(args || {});\n      case 'deleteProject':\n        return await handleDeleteProject(args || {});\n      default:\n        return { content: [{ type: 'text', text: `Unknown tool: ${name}` }] };\n    }\n  } catch (error) {\n    return { content: [{ type: 'text', text: JSON.stringify({ error: error.message }) }] };\n  }\n});\n\n// Start server\nasync function main() {\n  const transport = new StdioServerTransport();\n  await server.connect(transport);\n  console.error('MCP Task Manager Server running on stdio');\n}\n\nmain().catch((error) => {\n  console.error('Fatal error:', error);\n  process.exit(1);\n});\n"
