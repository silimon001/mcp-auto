64	          return result;
65	        }
66	      }
67	
68	      console.error(`[${requestId}] ToolResult: ${toolName} — no handler matched`);
69	      return {
70	        content: [{ type: 'text', text: `Unknown tool: ${toolName}` }],
71	        isError: true,
72	      };
73	    } catch (error) {
74	      console.error(`[${requestId}] ToolError: ${toolName} ${Date.now() - start}ms — ${error.message}`);
