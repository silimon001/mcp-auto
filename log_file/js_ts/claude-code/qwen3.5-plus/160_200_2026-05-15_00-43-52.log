15	OAUTH_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
16	OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
17	OAUTH_REVOCATION_URL=https://oauth2.googleapis.com/revoke
