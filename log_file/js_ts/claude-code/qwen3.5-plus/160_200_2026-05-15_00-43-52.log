  "content": "import { McpServer } from \"@modelcontextprotocol/sdk/server/mcp.js\";\nimport { StdioServerTransport } from \"@modelcontextprotocol/sdk/server/stdio.js\";\nimport { z } from \"zod\";\nimport fetch from \"node-fetch\";\nimport dotenv from \"dotenv\";\n\n// Load environment variables from .env file\ndotenv.config();\n\nconst GAMMA_API_URL = \"https://api.gamma.app/public-api/v0.1/generate\";\nconst GAMMA_API_KEY = process.env.GAMMA_API_KEY;\n\nif (!GAMMA_API_KEY) {\n  console.error(\"FATAL: GAMMA_API_KEY environment variable is not set. Please set it in your .env file.\");\n  process.exit(1);\n}\n\nasync function generatePresentation(params: {\n  inputText: string;\n  tone?: string;\n  audience?: string;\n  textAmount?: \"short\" | \"medium\" | \"long\";\n  textMode?: \"generate\" | \"summarize\";\n  numCards?: number;\n  imageModel?: string;\n  imageStyle?: string;\n  editorMode?: string;\n  additionalInstructions?: string;\n}): Promise<{ success: boolean; data?: any; error?: string }> {\n  try {\n    const requestBody: any = {\n      prompt: params.inputText,\n    };\n\n    if (params.tone) requestBody.tone = params.tone;\n    if (params.audience) requestBody.audience = params.audience;\n    if (params.textAmount) requestBody.text_amount = params.textAmount;\n    if (params.textMode) requestBody.text_mode = params.textMode;\n    if (params.numCards) requestBody.num_cards = params.numCards;\n    if (params.imageModel) requestBody.image_model = params.imageModel;\n    if (params.imageStyle) requestBody.image_style = params.imageStyle;\n    if (params.editorMode) requestBody.editor_mode = params.editorMode;\n    if (params.additionalInstructions) requestBody.additional_instructions = params.additionalInstructions;\n\n    const response = await fetch(GAMMA_API_URL, {\n      method: \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        \"Authorization\": `Bearer ${GAMMA_API_KEY}`,\n      },\n      body: JSON.stringify(requestBody),\n    });\n\n    if (!response.ok) {\n      const errorText = await response.text();\n      return { success: false, error: `Gamma API error: ${response.status} - ${errorText}` };\n    }\n\n    const data = await response.json();\n    return { success: true, data };\n  } catch (error) {\n    return { success: false, error: `Request failed: ${error instanceof Error ? error.message : String(error)}` };\n  }\n}\n\nconst server = new McpServer({\n  name: \"gamma-presentation\",\n  version: \"1.0.0\",\n  capabilities: {\n    resources: {},\n    tools: {},\n  },\n});\n\nserver.tool(\n  \"generate-presentation\",\n  \"Generate a presentation using the Gamma API. Takes a topic/prompt and optional parameters for customization. Returns a link to the generated presentation.\",\n  {\n    inputText: z.string().describe(\"The main topic or prompt for the presentation (required)\"),\n    tone: z.string().optional().describe(\"Optional tone of the presentation, e.g., 'humorous and sarcastic', 'professional', 'casual'\"),\n    audience: z.string().optional().describe(\"Optional target audience, e.g., 'students', 'developers', 'executives'\"),\n    textAmount: z.enum([\"short\", \"medium\", \"long\"]).optional().describe(\"Optional amount of text per slide\"),\n    textMode: z.enum([\"generate\", \"summarize\"]).optional().describe(\"Optional mode: 'generate' creates new content, 'summarize' summarizes provided content\"),\n    numCards: z.number().min(1).max(20).optional().describe(\"Optional number of slides/cards (1-20)\"),\n    imageModel: z.string().optional().describe(\"Optional image model to use\"),\n    imageStyle: z.string().optional().describe(\"Optional image style, e.g., 'photographic', 'illustration'\"),\n    editorMode: z.string().optional().describe(\"Optional editor mode\"),\n    additionalInstructions: z.string().optional().describe(\"Optional additional instructions for the generation\"),\n  },\n  async (params) => {\n    const result = await generatePresentation(params);\n\n    if (result.success && result.data) {\n      const presentationUrl = result.data.url || result.data.presentation_url || \"Unknown URL\";\n      return {\n        content: [\n          {\n            type: \"text\",\n            text: `Presentation generated successfully!\\n\\nLink: ${presentationUrl}`,\n          },\n        ],\n      };\n    } else {\n      return {\n        content: [\n          {\n            type: \"text\",\n            text: `Error generating presentation: ${result.error}`,\n          },\n        ],\n        isError: true,\n      };\n    }\n  },\n);\n\nasync function main() {\n  const transport = new StdioServerTransport();\n  await server.connect(transport);\n  console.error(\"Gamma MCP Server running on stdio\");\n}\n\nmain().catch((error) => {\n  console.error(\"Fatal error:\", error);\n  process.exit(1);\n});\n"
}
