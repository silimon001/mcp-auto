1	#!/usr/bin/env node
2	
3	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
4	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
5	import {
6	  CallToolRequestSchema,
7	  ListToolsRequestSchema,
8	  Tool,
9	} from "@modelcontextprotocol/sdk/types.js";
10	import axios from 'axios';
11	import dotenv from 'dotenv';
12	import crypto from 'crypto';
13	
14	// Redirect all console output to stderr
15	const originalConsole = { ...console };
16	console.log = (...args) => originalConsole.error(...args);
17	console.info = (...args) => originalConsole.error(...args);
18	console.warn = (...args) => originalConsole.error(...args);
19	
20	dotenv.config();
21	
22	const GONG_API_URL = 'https://api.gong.io/v2';
23	const GONG_ACCESS_KEY = process.env.GONG_ACCESS_KEY;
24	const GONG_ACCESS_SECRET = process.env.GONG_ACCESS_SECRET;
25	
26	// Check for required environment variables
27	if (!GONG_ACCESS_KEY || !GONG_ACCESS_SECRET) {
28	  console.error("Error: GONG_ACCESS_KEY and GONG_ACCESS_SECRET environment variables are required");
29	  process.exit(1);
30	}
31	
32	// Type definitions
33	interface GongCall {
34	  id: string;
35	  title: string;
36	  scheduled?: string;
37	  started?: string;
38	  duration?: number;
39	  direction?: string;
40	  system?: string;
41	  scope?: string;
42	  media?: string;
43	  language?: string;
44	  url?: string;
45	}
46	
47	interface GongTranscript {
48	  speakerId: string;
49	  topic?: string;
50	  sentences: Array<{
51	    start: number;
52	    text: string;
53	  }>;
54	}
55	
56	interface GongListCallsResponse {
57	  calls: GongCall[];
58	}
59	
60	interface GongRetrieveTranscriptsResponse {
61	  transcripts: GongTranscript[];
62	}
63	
64	interface GongListCallsArgs {
65	  [key: string]: string | undefined;
66	  fromDateTime?: string;
67	  toDateTime?: string;
68	}
69	
70	interface GongRetrieveTranscriptsArgs {
71	  callIds: string[];
72	}
73	
74	// Gong API Client
75	class GongClient {
76	  private accessKey: string;
77	  private accessSecret: string;
78	
79	  constructor(accessKey: string, accessSecret: string) {
80	    this.accessKey = accessKey;
81	    this.accessSecret = accessSecret;
82	  }
83	
84	  private async generateSignature(method: string, path: string, timestamp: string, params?: unknown): Promise<string> {
85	    const stringToSign = `${method}\n${path}\n${timestamp}\n${params ? JSON.stringify(params) : ''}`;
86	    const encoder = new TextEncoder();
87	    const keyData = encoder.encode(this.accessSecret);
88	    const messageData = encoder.encode(stringToSign);
89	    
90	    const cryptoKey = await crypto.subtle.importKey(
91	      'raw',
92	      keyData,
93	      { name: 'HMAC', hash: 'SHA-256' },
94	      false,
95	      ['sign']
96	    );
97	    
98	    const signature = await crypto.subtle.sign(
99	      'HMAC',
100	      cryptoKey,
101	      messageData
102	    );
103	    
104	    return btoa(String.fromCharCode(...new Uint8Array(signature)));
105	  }
106	
107	  private async request<T>(method: string, path: string, params?: Record<string, string | undefined>, data?: Record<string, unknown>): Promise<T> {
108	    const timestamp = new Date().toISOString();
109	    const url = `${GONG_API_URL}${path}`;
110	    
111	    const response = await axios({
112	      method,
113	      url,
114	      params,
115	      data,
116	      headers: {
117	        'Content-Type': 'application/json',
118	        'Authorization': `Basic ${Buffer.from(`${this.accessKey}:${this.accessSecret}`).toString('base64')}`,
119	        'X-Gong-AccessKey': this.accessKey,
120	        'X-Gong-Timestamp': timestamp,
121	        'X-Gong-Signature': await this.generateSignature(method, path, timestamp, data || params)
122	      }
123	    });
124	
125	    return response.data as T;
126	  }
127	
128	  async listCalls(fromDateTime?: string, toDateTime?: string): Promise<GongListCallsResponse> {
129	    const params: GongListCallsArgs = {};
130	    if (fromDateTime) params.fromDateTime = fromDateTime;
131	    if (toDateTime) params.toDateTime = toDateTime;
132	
133	    return this.request<GongListCallsResponse>('GET', '/calls', params);
134	  }
135	
136	  async retrieveTranscripts(callIds: string[]): Promise<GongRetrieveTranscriptsResponse> {
137	    return this.request<GongRetrieveTranscriptsResponse>('POST', '/calls/transcript', undefined, {
138	      filter: {
139	        callIds,
140	        includeEntities: true,
141	        includeInteractionsSummary: true,
142	        includeTrackers: true
143	      }
144	    });
145	  }
146	}
147	
148	const gongClient = new GongClient(GONG_ACCESS_KEY, GONG_ACCESS_SECRET);
149	
150	// Tool definitions
151	const LIST_CALLS_TOOL: Tool = {
152	  name: "list_calls",
153	  description: "List Gong calls with optional date range filtering. Returns call details including ID, title, start/end times, participants, and duration.",
154	  inputSchema: {
155	    type: "object",
156	    properties: {
157	      fromDateTime: {
158	        type: "string",
159	        description: "Start date/time in ISO format (e.g. 2024-03-01T00:00:00Z)"
160	      },
161	      toDateTime: {
162	        type: "string",
163	        description: "End date/time in ISO format (e.g. 2024-03-31T23:59:59Z)"
164	      }
165	    }
166	  }
167	};
168	
169	const RETRIEVE_TRANSCRIPTS_TOOL: Tool = {
170	  name: "retrieve_transcripts",
171	  description: "Retrieve transcripts for specified call IDs. Returns detailed transcripts including speaker IDs, topics, and timestamped sentences.",
172	  inputSchema: {
173	    type: "object",
174	    properties: {
175	      callIds: {
176	        type: "array",
177	        items: { type: "string" },
178	        description: "Array of Gong call IDs to retrieve transcripts for"
179	      }
180	    },
181	    required: ["callIds"]
182	  }
183	};
184	
185	// Server implementation
186	const server = new Server(
187	  {
188	    name: "example-servers/gong",
189	    version: "0.1.0",
190	  },
191	  {
192	    capabilities: {
193	      tools: {},
194	    },
195	  },
196	);
197	
198	// Type guards
199	function isGongListCallsArgs(args: unknown): args is GongListCallsArgs {
200	  return (
201	    typeof args === "object" &&
202	    args !== null &&
203	    (!("fromDateTime" in args) || typeof (args as GongListCallsArgs).fromDateTime === "string") &&
204	    (!("toDateTime" in args) || typeof (args as GongListCallsArgs).toDateTime === "string")
205	  );
206	}
207	
208	function isGongRetrieveTranscriptsArgs(args: unknown): args is GongRetrieveTranscriptsArgs {
209	  return (
210	    typeof args === "object" &&
211	    args !== null &&
212	    "callIds" in args &&
213	    Array.isArray((args as GongRetrieveTranscriptsArgs).callIds) &&
214	    (args as GongRetrieveTranscriptsArgs).callIds.every(id => typeof id === "string")
215	  );
216	}
217	
218	// Tool handlers
219	server.setRequestHandler(ListToolsRequestSchema, async () => ({
220	  tools: [LIST_CALLS_TOOL, RETRIEVE_TRANSCRIPTS_TOOL],
221	}));
222	
223	server.setRequestHandler(CallToolRequestSchema, async (request: { params: { name: string; arguments?: unknown } }) => {
224	  try {
225	    const { name, arguments: args } = request.params;
226	
227	    if (!args) {
228	      throw new Error("No arguments provided");
229	    }
230	
231	    switch (name) {
232	      case "list_calls": {
233	        if (!isGongListCallsArgs(args)) {
234	          throw new Error("Invalid arguments for list_calls");
235	        }
236	        const { fromDateTime, toDateTime } = args;
237	        const response = await gongClient.listCalls(fromDateTime, toDateTime);
238	        return {
239	          content: [{ 
240	            type: "text", 
241	            text: JSON.stringify(response, null, 2)
242	          }],
243	          isError: false,
244	        };
245	      }
246	
247	      case "retrieve_transcripts": {
248	        if (!isGongRetrieveTranscriptsArgs(args)) {
249	          throw new Error("Invalid arguments for retrieve_transcripts");
250	        }
251	        const { callIds } = args;
252	        const response = await gongClient.retrieveTranscripts(callIds);
253	        return {
254	          content: [{ 
255	            type: "text", 
256	            text: JSON.stringify(response, null, 2)
257	          }],
258	          isError: false,
259	        };
260	      }
261	
262	      default:
263	        return {
264	          content: [{ type: "text", text: `Unknown tool: ${name}` }],
265	          isError: true,
266	        };
267	    }
268	  } catch (error) {
269	    return {
270	      content: [
271	        {
272	          type: "text",
273	          text: `Error: ${error instanceof Error ? error.message : String(error)}`,
274	        },
275	      ],
276	      isError: true,
277	    };
278	  }
279	});
280	
281	async function runServer() {
282	  const transport = new StdioServerTransport();
283	  await server.connect(transport);
284	}
285	
286	runServer().catch((error) => {
287	  console.error("Fatal error running server:", error);
288	  process.exit(1);
289	}); 

