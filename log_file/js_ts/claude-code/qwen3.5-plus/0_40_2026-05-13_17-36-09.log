30	    console.log("启动飞书MCP服务器...");
31	    await server.startHttp(port);
32	  } catch (error) {
33	    console.error("服务器启动失败:", error);
34	    process.exit(1);
35	  }
36	}
37	
38	// 启动服务器
39	startServer(); 

