52	
53	  async getPreferences(): Promise<BookPreferences> {
54	    if (!this.preferences) {
55	      this.preferences = await this.ctx.storage.get<BookPreferences>("preferences");
56	      
57	      if (!this.preferences) {
58	        this.preferences = {
