104	        throw new Error(response.data.msg || i18n.t('rpaService.error.startJobFailed'));
105	      }
106	      return response.data;
107	    } catch (error: any) {
108	      throw new Error(`${i18n.t('rpaService.error.startJobFailed')}: ${error.message}`);
109	    }
