16	  process.exit(1);
17	}
18	
19	export async function startServer(): Promise<void> {
20	  const port = parseInt(process.env.PORT || '7777', 10);
21	  
22	  // 创建服务器实例
23	  const server = new FeishuMcpServer(
24	    process.env.FEISHU_APP_ID as string,
25	    process.env.FEISHU_APP_SECRET as string
26	  );
27	  
28	  try {
