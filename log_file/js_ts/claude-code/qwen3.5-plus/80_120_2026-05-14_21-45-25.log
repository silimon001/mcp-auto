1	#!/usr/bin/env node
2	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
3	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
4	import { CallToolRequestSchema, ListToolsRequestSchema, } from "@modelcontextprotocol/sdk/types.js";
5	import { google } from 'googleapis';
6	import { z } from "zod";
7	import { zodToJsonSchema } from "zod-to-json-schema";
8	import { OAuth2Client } from 'google-auth-library';
9	import fs from 'fs';
10	import path from 'path';
11	import { fileURLToPath } from 'url';
12	import http from 'http';
13	import open from 'open';
14	import os from 'os';
15	const __dirname = path.dirname(fileURLToPath(import.meta.url));
16	// Configuration paths
17	const CONFIG_DIR = path.join(os.homedir(), '.calendar-mcp');
18	const OAUTH_PATH = process.env.CALENDAR_OAUTH_PATH || path.join(CONFIG_DIR, 'gcp-oauth.keys.json');
19	const CREDENTIALS_PATH = process.env.CALENDAR_CREDENTIALS_PATH || path.join(CONFIG_DIR, 'credentials.json');
20	// OAuth2 configuration
21	let oauth2Client;
22	async function loadCredentials() {
23	    try {
24	        // Create config directory if it doesn't exist
25	        if (!fs.existsSync(CONFIG_DIR)) {
26	            fs.mkdirSync(CONFIG_DIR, { recursive: true });
27	        }
28	        // Check for OAuth keys in current directory first, then in config directory
29	        const localOAuthPath = path.join(process.cwd(), 'gcp-oauth.keys.json');
30	        let oauthPath = OAUTH_PATH;
31	        if (fs.existsSync(localOAuthPath)) {
32	            // If found in current directory, copy to config directory
33	            fs.copyFileSync(localOAuthPath, OAUTH_PATH);
34	            console.log('OAuth keys found in current directory, copied to global config.');
35	        }
36	        if (!fs.existsSync(OAUTH_PATH)) {
37	            console.error('Error: OAuth keys file not found. Please place gcp-oauth.keys.json in current directory or', CONFIG_DIR);
38	            process.exit(1);
39	        }
40	        const keysContent = JSON.parse(fs.readFileSync(OAUTH_PATH, 'utf8'));
41	        const keys = keysContent.installed || keysContent.web;
42	        if (!keys) {
43	            console.error('Error: Invalid OAuth keys file format. File should contain either "installed" or "web" credentials.');
44	            process.exit(1);
45	        }
46	        oauth2Client = new OAuth2Client(keys.client_id, keys.client_secret, 'http://localhost:3000/oauth2callback');
47	        if (fs.existsSync(CREDENTIALS_PATH)) {
48	            const credentials = JSON.parse(fs.readFileSync(CREDENTIALS_PATH, 'utf8'));
49	            oauth2Client.setCredentials(credentials);
50	        }
51	    }
52	    catch (error) {
53	        console.error('Error loading credentials:', error);
54	        process.exit(1);
55	    }
56	}
57	async function authenticate() {
58	    const server = http.createServer();
59	    server.listen(3000);
60	    return new Promise((resolve, reject) => {
61	        const authUrl = oauth2Client.generateAuthUrl({
62	            access_type: 'offline',
63	            scope: ['https://www.googleapis.com/auth/calendar'],
64	        });
65	        console.log('Please visit this URL to authenticate:', authUrl);
66	        open(authUrl);
67	        server.on('request', async (req, res) => {
68	            if (!req.url?.startsWith('/oauth2callback'))
69	                return;
70	            const url = new URL(req.url, 'http://localhost:3000');
71	            const code = url.searchParams.get('code');
72	            if (!code) {
73	                res.writeHead(400);
74	                res.end('No code provided');
75	                reject(new Error('No code provided'));
76	                return;
77	            }
78	            try {
79	                const { tokens } = await oauth2Client.getToken(code);
80	                oauth2Client.setCredentials(tokens);
81	                fs.writeFileSync(CREDENTIALS_PATH, JSON.stringify(tokens));
82	                res.writeHead(200);
83	                res.end('Authentication successful! You can close this window.');
84	                server.close();
85	                resolve();
86	            }
87	            catch (error) {
88	                res.writeHead(500);
89	                res.end('Authentication failed');
90	                reject(error);
91	            }
92	        });
93	    });
94	}
95	// Schema definitions
96	const CreateEventSchema = z.object({
97	    summary: z.string().describe("Event title"),
98	    start: z.object({
99	        dateTime: z.string().describe("Start time (ISO format)"),
100	        timeZone: z.string().optional().describe("Time zone"),
101	    }),
102	    end: z.object({
103	        dateTime: z.string().describe("End time (ISO format)"),
104	        timeZone: z.string().optional().describe("Time zone"),
105	    }),
106	    description: z.string().optional().describe("Event description"),
107	    location: z.string().optional().describe("Event location"),
108	});
109	const GetEventSchema = z.object({
110	    eventId: z.string().describe("ID of the event to retrieve"),
111	});
112	const UpdateEventSchema = z.object({
113	    eventId: z.string().describe("ID of the event to update"),
114	    summary: z.string().optional().describe("New event title"),
115	    start: z.object({
116	        dateTime: z.string().describe("New start time (ISO format)"),
117	        timeZone: z.string().optional().describe("Time zone"),
118	    }).optional(),
119	    end: z.object({
120	        dateTime: z.string().describe("New end time (ISO format)"),
121	        timeZone: z.string().optional().describe("Time zone"),
122	    }).optional(),
123	    description: z.string().optional().describe("New event description"),
124	    location: z.string().optional().describe("New event location"),
125	});
126	const DeleteEventSchema = z.object({
127	    eventId: z.string().describe("ID of the event to delete"),
128	});
129	const ListEventsSchema = z.object({
130	    timeMin: z.string().describe("Start of time range (ISO format)"),
131	    timeMax: z.string().describe("End of time range (ISO format)"),
132	    maxResults: z.number().optional().describe("Maximum number of events to return"),
133	    orderBy: z.enum(['startTime', 'updated']).optional().describe("Sort order"),
134	});
135	// Main function
136	async function main() {
137	    await loadCredentials();
138	    if (process.argv[2] === 'auth') {
139	        await authenticate();
140	        console.log('Authentication completed successfully');
141	        process.exit(0);
142	    }
143	    // Initialize Google Calendar API
144	    const calendar = google.calendar({ version: 'v3', auth: oauth2Client });
145	    const calendarId = 'primary';
146	    // Server implementation
147	    const server = new Server({
148	        name: "google-calendar",
149	        version: "1.0.0",
150	        capabilities: {
151	            tools: {},
152	        },
153	    });
154	    // Tool handlers
155	    server.setRequestHandler(ListToolsRequestSchema, async () => ({
156	        tools: [
157	            {
158	                name: "create_event",
159	                description: "Creates a new event in Google Calendar",
160	                inputSchema: zodToJsonSchema(CreateEventSchema),
161	            },
162	            {
163	                name: "get_event",
164	                description: "Retrieves details of a specific event",
165	                inputSchema: zodToJsonSchema(GetEventSchema),
166	            },
167	            {
168	                name: "update_event",
169	                description: "Updates an existing event",
170	                inputSchema: zodToJsonSchema(UpdateEventSchema),
171	            },
172	            {
173	                name: "delete_event",
174	                description: "Deletes an event from the calendar",
175	                inputSchema: zodToJsonSchema(DeleteEventSchema),
176	            },
177	            {
178	                name: "list_events",
179	                description: "Lists events within a specified time range",
180	                inputSchema: zodToJsonSchema(ListEventsSchema),
181	            },
182	        ],
183	    }));
184	    server.setRequestHandler(CallToolRequestSchema, async (request) => {
185	        const { name, arguments: args } = request.params;
186	        try {
187	            switch (name) {
188	                case "create_event": {
189	                    const validatedArgs = CreateEventSchema.parse(args);
190	                    const response = await calendar.events.insert({
191	                        calendarId,
192	                        requestBody: validatedArgs,
193	                    });
194	                    return {
195	                        content: [
196	                            {
197	                                type: "text",
198	                                text: `Event created with ID: ${response.data.id}\n` +
199	                                    `Title: ${validatedArgs.summary}\n` +
200	                                    `Start: ${validatedArgs.start.dateTime}\n` +
201	                                    `End: ${validatedArgs.end.dateTime}`,
202	                            },
203	                        ],
204	                    };
205	                }
206	                case "get_event": {
207	                    const validatedArgs = GetEventSchema.parse(args);
208	                    const response = await calendar.events.get({
209	                        calendarId,
210	                        eventId: validatedArgs.eventId,
211	                    });
212	                    return {
213	                        content: [
214	                            {
215	                                type: "text",
216	                                text: JSON.stringify(response.data, null, 2),
217	                            },
218	                        ],
219	                    };
220	                }
221	                case "update_event": {
222	                    const validatedArgs = UpdateEventSchema.parse(args);
223	                    const { eventId, ...updates } = validatedArgs;
224	                    const response = await calendar.events.patch({
225	                        calendarId,
226	                        eventId,
227	                        requestBody: updates,
228	                    });
229	                    return {
230	                        content: [
231	                            {
232	                                type: "text",
233	                                text: `Event updated: ${eventId}\n` +
234	                                    `New title: ${updates.summary || '(unchanged)'}\n` +
235	                                    `New start: ${updates.start?.dateTime || '(unchanged)'}\n` +
236	                                    `New end: ${updates.end?.dateTime || '(unchanged)'}`,
237	                            },
238	                        ],
239	                    };
240	                }
241	                case "delete_event": {
242	                    const validatedArgs = DeleteEventSchema.parse(args);
243	                    await calendar.events.delete({
244	                        calendarId,
245	                        eventId: validatedArgs.eventId,
246	                    });
247	                    return {
248	                        content: [
249	                            {
250	                                type: "text",
251	                                text: `Event deleted: ${validatedArgs.eventId}`,
252	                            },
253	                        ],
254	                    };
255	                }
256	                case "list_events": {
257	                    const validatedArgs = ListEventsSchema.parse(args);
258	                    const response = await calendar.events.list({
259	                        calendarId,
260	                        timeMin: validatedArgs.timeMin,
