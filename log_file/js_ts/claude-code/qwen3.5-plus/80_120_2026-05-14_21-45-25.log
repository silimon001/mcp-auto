1	import { FastMCP } from "fastmcp";
2	import { logger } from './core/logger.js';
3	import { allTools } from './tools/index.js';
4	// Initialize the FastMCP server
5	const server = new FastMCP({
6	    name: "GrepApp Search Server",
7	    version: "1.0.0",
8	    instructions: `This server provides a tool to search for code snippets across public repositories using the grep.app API.
9	
10	Usage Example:
11	call searchCode '{"query": "your search query", "langFilter": "TypeScript"}'`
12	});
13	// Register all tools
14	for (const tool of allTools) {
15	    server.addTool(tool);
16	}
17	// Register server event handlers for logging
18	server.on('connect', (event) => {
19	    const sessionIdentifier = Math.random().toString(36).substring(2, 10);
20	    logger.info('Client connected via stdio', { sessionIdentifier });
21	    // Log when roots change
22	    event.session.on('rootsChanged', (rootsEvent) => {
23	        logger.debug('Roots changed', { roots: rootsEvent.roots });
24	    });
25	    // Log session errors
26	    event.session.on('error', (errorEvent) => {
27	        logger.error('Session error', { error: errorEvent.error });
28	    });
29	});
30	server.on('disconnect', (event) => {
31	    logger.info('Client disconnected from stdio');
32	});
33	// Start the server in stdio mode
34	logger.info('Starting FastMCP server in stdio mode');
35	server.start({
36	    transportType: "stdio"
37	}).then(() => {
38	    logger.info('FastMCP server started successfully in stdio mode');
39	}).catch(error => {
40	    logger.error('Failed to start FastMCP server in stdio mode', { error });
41	    process.exit(1);
42	});
43	//# sourceMappingURL=server-stdio.js.map

