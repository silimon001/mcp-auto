84	  private async generateSignature(method: string, path: string, timestamp: string, params?: unknown): Promise<string> {
85	    const stringToSign = `${method}\n${path}\n${timestamp}\n${params ? JSON.stringify(params) : ''}`;
86	    const encoder = new TextEncoder();
87	    const keyData = encoder.encode(this.accessSecret);
88	    const messageData = encoder.encode(stringToSign);
89	    
90	    const cryptoKey = await crypto.subtle.importKey(
91	      'raw',
92	      keyData,
93	      { name: 'HMAC', hash: 'SHA-256' },
94	      false,
95	      ['sign']
96	    );
97	    
98	    const signature = await crypto.subtle.sign(
99	      'HMAC',
100	      cryptoKey,
101	      messageData
102	    );
103	    
104	    return btoa(String.fromCharCode(...new Uint8Array(signature)));
105	  }
