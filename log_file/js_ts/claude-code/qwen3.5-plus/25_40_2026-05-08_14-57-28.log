107	  private async request<T>(method: string, path: string, params?: Record<string, string | undefined>, data?: Record<string, unknown>): Promise<T> {
108	    const timestamp = new Date().toISOString();
109	    const url = `${GONG_API_URL}${path}`;
110	    
111	    const response = await axios({
112	      method,
113	      url,
114	      params,
115	      data,
116	      headers: {
