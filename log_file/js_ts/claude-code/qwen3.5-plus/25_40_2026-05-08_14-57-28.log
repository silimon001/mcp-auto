111	              allDocuments = (response.items || []).map(node => ({
112	                id: node.node_token,
113	                name: node.title || 'Untitled',
114	                type: node.obj_type || 'Unknown',
115	                spaceId: spaceId
116	              }));
117	            } catch (error: any) {
118	              if (error.message?.includes('权限')) {
119	                return {
120	                  isError: true,
121	                  content: [{ type: "text", text: `无权访问空间(${spaceId})的文档` }]
122	                };
123	              }
124	              throw error;
125	            }
126	          } else {
127	            // 获取所有空间的文档
128	            const spacesResponse = await feishuClient.getSpaces();
129	            const spaces = spacesResponse.items || [];
130	            
131	            for (const space of spaces) {
132	              try {
133	                const response = await feishuClient.getNodes(space.space_id);
134	                const documents = (response.items || []).map(node => ({
135	                  id: node.node_token,
136	                  name: node.title || 'Untitled',
137	                  type: node.obj_type || 'Unknown',
138	                  spaceId: space.space_id,
139	                  spaceName: space.name
140	                }));
141	                allDocuments = [...allDocuments, ...documents];
142	              } catch (error: any) {
143	                // 跳过无法访问的空间
144	                if (!error.message?.includes('权限')) {
145	                  Logger.error(`获取空间(${space.space_id})的文档列表失败:`, error);
146	                }
147	              }
148	            }
149	          }
150	          
151	          return {
152	            content: [
153	              {
154	                type: "text",
155	                text: JSON.stringify({ documents: allDocuments })
156	              }
157	            ]
158	          };
159	        } catch (error: any) {
160	          Logger.error(`获取文档列表失败:`, error);
161	          return {
162	            isError: true,
163	            content: [
164	              { 
165	                type: "text", 
166	                text: `获取文档列表失败: ${error.message || '未知错误'}` 
167	              }
168	            ]
169	          };
170	        }
171	      }
172	    );
173	  }
