118	        'Authorization': `Basic ${Buffer.from(`${this.accessKey}:${this.accessSecret}`).toString('base64')}`,
119	        'X-Gong-AccessKey': this.accessKey,
120	        'X-Gong-Timestamp': timestamp,
121	        'X-Gong-Signature': await this.generateSignature(method, path, timestamp, data || params)
122	      }
123	    });
