1	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
2	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
3	import {
4	  CallToolRequest,
5	  CallToolRequestSchema,
6	  ListToolsRequestSchema,
7	} from "@modelcontextprotocol/sdk/types.js";
8	import dotenv from "dotenv";
9	import { z } from "zod";
10	import { RaindropAPI } from "./lib/raindrop-api.js";
11	import { tools } from "./lib/tools.js";
12	import { CreateBookmarkSchema, SearchBookmarksSchema } from "./types/index.js";
13	
14	dotenv.config();
15	
16	const server = new Server(
17	  {
18	    name: "raindrop-mcp",
19	    version: "1.0.0",
20	  },
21	  {
22	    capabilities: {
23	      tools: {},
24	    },
25	  },
26	);
27	
28	// ツール一覧の定義
29	server.setRequestHandler(ListToolsRequestSchema, async () => {
30	  return { tools };
31	});
32	
33	// ツール実行のハンドリング
34	server.setRequestHandler(
35	  CallToolRequestSchema,
36	  async (request: CallToolRequest) => {
37	    const { name, arguments: args } = request.params;
38	    const token = process.env.RAINDROP_TOKEN;
39	    if (!token) {
40	      throw new Error("RAINDROP_TOKEN is not set");
41	    }
42	
43	    const api = new RaindropAPI(token);
44	
45	    try {
46	      if (name === "create-bookmark") {
47	        const { url, title, tags, collection } =
48	          CreateBookmarkSchema.parse(args);
49	
50	        const bookmark = await api.createBookmark({
51	          link: url,
52	          title,
53	          tags,
54	          collection: { $id: collection || 0 },
55	        });
56	
57	        return {
58	          content: [
59	            {
60	              type: "text",
61	              text: `Bookmark created successfully: ${bookmark.item.link}`,
62	            },
63	          ],
64	        };
65	      }
66	
67	      if (name === "search-bookmarks") {
68	        const { query, tags, page, perpage, sort, collection, word } =
69	          SearchBookmarksSchema.parse(args);
70	
71	        const searchParams = new URLSearchParams({
72	          search: query,
73	          ...(tags && { tags: tags.join(",") }),
74	          ...(page !== undefined && { page: page.toString() }),
75	          ...(perpage !== undefined && { perpage: perpage.toString() }),
76	          ...(sort && { sort }),
77	          ...(word !== undefined && { word: word.toString() }),
78	        });
79	
80	        const collectionId = collection ?? 0;
81	        const results = await api.searchBookmarks(collectionId, searchParams);
82	
83	        const formattedResults = results.items
84	          .map(
85	            (item) => `
86	Title: ${item.title}
87	URL: ${item.link}
88	Tags: ${item.tags?.length ? item.tags.join(", ") : "No tags"}
89	Created: ${new Date(item.created).toLocaleString()}
90	Last Updated: ${new Date(item.lastUpdate).toLocaleString()}
91	---`,
92	          )
93	          .join("\n");
94	
95	        return {
96	          content: [
97	            {
98	              type: "text",
99	              text:
100	                results.items.length > 0
101	                  ? `Found ${results.count} total bookmarks (showing ${
102	                      results.items.length
103	                    } on page ${page ?? 0 + 1}):\n${formattedResults}`
104	                  : "No bookmarks found matching your search.",
105	            },
106	          ],
107	        };
108	      }
109	
110	      if (name === "list-collections") {
111	        const collections = await api.listCollections();
112	
113	        const formattedCollections = collections.items
114	          .map(
115	            (item) => `
116	Name: ${item.title}
117	ID: ${item._id}
118	Count: ${item.count} bookmarks
119	Parent: ${item.parent?._id || "None"}
120	Created: ${new Date(item.created).toLocaleString()}
121	---`,
122	          )
123	          .join("\n");
124	
125	        return {
126	          content: [
127	            {
128	              type: "text",
129	              text:
130	                collections.items.length > 0
131	                  ? `Found ${collections.items.length} collections:\n${formattedCollections}`
132	                  : "No collections found.",
133	            },
134	          ],
135	        };
136	      }
137	
138	      throw new Error(`Unknown tool: ${name}`);
139	    } catch (error) {
140	      if (error instanceof z.ZodError) {
141	        throw new Error(
142	          `Invalid arguments: ${error.errors
143	            .map((e) => `${e.path.join(".")}: ${e.message}`)
144	            .join(", ")}`,
145	        );
146	      }
147	      throw error;
148	    }
149	  },
150	);
151	
152	// サーバー起動
153	async function main() {
154	  const transport = new StdioServerTransport();
155	  await server.connect(transport);
156	  console.error("Raindrop MCP Server running on stdio");
157	}
158	
159	main().catch((error) => {
160	  console.error("Fatal error in main():", error);
161	  process.exit(1);
162	});
