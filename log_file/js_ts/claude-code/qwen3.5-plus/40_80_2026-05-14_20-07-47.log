1	#!/usr/bin/env node
2	import { Server } from '@modelcontextprotocol/sdk/server/index.js';
3	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
4	import {
5	  CallToolRequestSchema,
6	  ErrorCode,
7	  ListToolsRequestSchema,
8	  McpError
9	} from '@modelcontextprotocol/sdk/types.js';
10	
11	import { analyzeDatabase } from './tools/analyze.js';
12	import { getSetupInstructions } from './tools/setup.js';
13	import { debugDatabase } from './tools/debug.js';
14	
15	const TOOL_DEFINITIONS = [
16	  {
17	    name: 'analyze_database',
18	    description: 'Analyze PostgreSQL database configuration and performance',
19	    inputSchema: {
20	      type: 'object',
21	      properties: {
22	        connectionString: {
23	          type: 'string',
24	          description: 'PostgreSQL connection string'
25	        },
26	        analysisType: {
27	          type: 'string',
28	          enum: ['configuration', 'performance', 'security'],
29	          description: 'Type of analysis to perform'
30	        }
31	      },
32	      required: ['connectionString']
33	    }
34	  },
35	  {
36	    name: 'get_setup_instructions',
37	    description: 'Get step-by-step PostgreSQL setup instructions',
38	    inputSchema: {
39	      type: 'object',
40	      properties: {
41	        version: {
42	          type: 'string',
43	          description: 'PostgreSQL version to install'
44	        },
45	        platform: {
46	          type: 'string',
47	          enum: ['linux', 'macos', 'windows'],
48	          description: 'Operating system platform'
49	        },
50	        useCase: {
51	          type: 'string',
52	          enum: ['development', 'production'],
53	          description: 'Intended use case'
54	        }
55	      },
56	      required: ['platform']
57	    }
58	  },
59	  {
60	    name: 'debug_database',
61	    description: 'Debug common PostgreSQL issues',
62	    inputSchema: {
63	      type: 'object',
64	      properties: {
65	        connectionString: {
66	          type: 'string',
67	          description: 'PostgreSQL connection string'
68	        },
69	        issue: {
70	          type: 'string',
71	          enum: [
72	            'connection',
73	            'performance',
74	            'locks',
75	            'replication'
76	          ],
77	          description: 'Type of issue to debug'
78	        },
79	        logLevel: {
80	          type: 'string',
81	          enum: ['info', 'debug', 'trace'],
82	          default: 'info',
83	          description: 'Logging detail level'
84	        }
85	      },
86	      required: ['connectionString', 'issue']
87	    }
88	  }
89	];
90	
91	class PostgreSQLServer {
92	  private server: Server;
93	
94	  constructor() {
95	    this.server = new Server(
96	      {
97	        name: 'postgresql-mcp-server',
98	        version: '0.1.0',
99	      },
100	      {
101	        capabilities: {
102	          tools: {
103	            analyze_database: TOOL_DEFINITIONS[0],
104	            get_setup_instructions: TOOL_DEFINITIONS[1],
105	            debug_database: TOOL_DEFINITIONS[2]
106	          },
107	        },
108	      }
109	    );
110	
111	    this.setupToolHandlers();
112	    
113	    // Error handling
114	    this.server.onerror = (error) => console.error('[MCP Error]', error);
115	    process.on('SIGINT', async () => {
116	      await this.server.close();
117	      process.exit(0);
118	    });
119	  }
120	
121	  private setupToolHandlers(): void {
122	    this.server.setRequestHandler(ListToolsRequestSchema, async () => ({
123	      tools: TOOL_DEFINITIONS
124	    }));
125	
126	    this.server.setRequestHandler(CallToolRequestSchema, async (request) => {
127	      try {
128	        switch (request.params.name) {
129	          case 'analyze_database': {
130	            const { connectionString, analysisType } = request.params.arguments as {
131	              connectionString: string;
132	              analysisType?: 'configuration' | 'performance' | 'security';
133	            };
134	            const result = await analyzeDatabase(connectionString, analysisType);
135	            return {
136	              content: [
137	                {
138	                  type: 'text',
139	                  text: JSON.stringify(result, null, 2)
140	                }
141	              ]
142	            };
143	          }
144	
145	          case 'get_setup_instructions': {
146	            const { platform, version, useCase } = request.params.arguments as {
147	              platform: 'linux' | 'macos' | 'windows';
148	              version?: string;
149	              useCase?: 'development' | 'production';
150	            };
151	            const instructions = getSetupInstructions(platform, version, useCase);
152	            return {
153	              content: [
154	                {
155	                  type: 'text',
156	                  text: [
157	                    '# Installation Steps',
158	                    ...instructions.steps,
159	                    '',
160	                    '# Configuration',
161	                    ...instructions.configuration,
162	                    '',
163	                    '# Post-Installation Steps',
164	                    ...instructions.postInstall
165	                  ].join('\n')
166	                }
167	              ]
168	            };
169	          }
170	
171	          case 'debug_database': {
172	            const { connectionString, issue, logLevel } = request.params.arguments as {
173	              connectionString: string;
174	              issue: 'connection' | 'performance' | 'locks' | 'replication';
175	              logLevel?: 'info' | 'debug' | 'trace';
176	            };
177	            const result = await debugDatabase(connectionString, issue, logLevel);
178	            return {
179	              content: [
180	                {
181	                  type: 'text',
182	                  text: JSON.stringify(result, null, 2)
183	                }
184	              ]
185	            };
186	          }
187	
188	          default:
189	            throw new McpError(
190	              ErrorCode.MethodNotFound,
191	              `Unknown tool: ${request.params.name}`
192	            );
193	        }
194	      } catch (error) {
195	        return {
196	          content: [
197	            {
198	              type: 'text',
199	              text: `Error: ${error instanceof Error ? error.message : String(error)}`
200	            }
201	          ],
202	          isError: true
203	        };
204	      }
205	    });
206	  }
207	
208	  async run() {
209	    const transport = new StdioServerTransport();
210	    await this.server.connect(transport);
211	    console.error('PostgreSQL MCP server running on stdio');
212	  }
213	}
214	
215	const server = new PostgreSQLServer();
216	server.run().catch(console.error);
217	

