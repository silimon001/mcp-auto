35	        if (projectId) {
36	            const projectDir = path.join(this.projectsDir, projectId);
37	            await fs.mkdir(projectDir, { recursive: true });
38	            return path.join(projectDir, `${id}.json`);
39	        }
40	        return path.join(this.contextsDir, `${id}.json`);
41	    }
