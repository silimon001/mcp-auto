1	#!/usr/bin/env node
2	import { Application } from './Application.js';
3	import yargs from 'yargs';
4	import { hideBin } from 'yargs/helpers';
5	import * as fs from 'fs';
6	const argv = yargs(hideBin(process.argv))
7	    .option('server-jar', {
8	    alias: 'j',
9	    type: 'string',
10	    description: 'Absolute path to the Minecraft server JAR file',
11	    demandOption: true
12	})
13	    .scriptName('minecraft-mcp')
14	    .help()
15	    .parseSync();
16	if (!fs.existsSync(argv.serverJar)) {
17	    process.exit(1);
18	}
19	const app = new Application({
20	    serverJarPath: argv.serverJar
21	});
22	const cleanup = async () => {
23	    try {
24	        await app.stop();
25	        process.exit(0);
26	    }
27	    catch (error) {
28	        process.exit(1);
29	    }
30	};
31	process.on('SIGINT', cleanup);
32	process.on('SIGTERM', cleanup);
33	process.on('uncaughtException', async (error) => {
34	    await cleanup();
35	});
36	process.on('unhandledRejection', async (error) => {
37	    await cleanup();
38	});
39	app.start().catch(() => {
40	    process.exit(1);
41	});
