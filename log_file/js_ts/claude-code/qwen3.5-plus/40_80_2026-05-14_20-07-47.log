237	      });
238	
239	      const content = result.content[0];
240	      let results: any[] = [];
241	      
242	      if (content.type === "text") {
243	        const data = extractJsonFromResponse(content.text);
244	        console.log("data", data);
245	        results = Array.isArray(data) ? data : [];
246	      }
247	
248	      return widget({
