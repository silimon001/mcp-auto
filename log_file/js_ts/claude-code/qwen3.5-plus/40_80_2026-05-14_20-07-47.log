427	def add_extra_info(dataset_name: str, repo_id: str) -> str:
428	    """从数据集读取仓库额外信息"""
429	    final_text = ''
430	    repo_info_path = Path.cwd() / "data" / "dataset" / dataset_name / "repo_info.json"
431	    if repo_info_path.exists():
432	        with open(repo_info_path, 'r', encoding='utf-8') as f:
433	            repo_infos = json.load(f)
434	        for repo_info in repo_infos:
435	            if repo_info.get('id') == int(repo_id):
