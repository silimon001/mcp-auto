258	        }),
259	      });
260	    } catch (err) {
261	      return error(`Error executing SQL query: ${err instanceof Error ? err.message : String(err)}`)
262	    }
263	  }
264	);
265	
266	// ============================================================================
267	// PROJECT INFORMATION TOOLS
268	// ============================================================================
269	
270	// Get project URL
