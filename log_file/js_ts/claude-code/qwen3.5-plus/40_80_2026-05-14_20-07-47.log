21	        raise FileNotFoundError(f".env file not found: {env_file}")
22	
23	    load_dotenv(dotenv_path=env_file, override=True)
24	
25	    required_vars = [
26	        "ANTHROPIC_BASE_URL",
27	        "ANTHROPIC_API_KEY",
28	        "ANTHROPIC_MODEL"
29	    ]
30	
31	    missing = [v for v in required_vars if not os.getenv(v)]
32	
33	    if missing:
34	        raise ValueError(
35	            f"Missing required environment variables: {missing}"
36	        )
37	
