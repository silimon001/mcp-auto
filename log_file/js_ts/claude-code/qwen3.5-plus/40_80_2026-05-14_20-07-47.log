209	            window.bringToTop()
210	            await new Promise(resolve => setTimeout(resolve, 50))
211	            
212	            // Perform the operation
213	            const result = await operation()
214	            
215	            // Restore previous window if there was one
216	            if (activeWindow && activeWindow.handle !== window.handle) {
217	                activeWindow.bringToTop()
218	            }
219	            
220	            return result
221	        } catch (error) {
222	            // Ensure we restore the previous window even if operation fails
223	            if (activeWindow && activeWindow.handle !== window.handle) {
224	                activeWindow.bringToTop()
