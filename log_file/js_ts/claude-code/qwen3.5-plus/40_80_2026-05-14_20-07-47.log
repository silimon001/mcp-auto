1	import { MCPClient } from "mcp-use/client"; // No langchain!
2	import { error, MCPServer, object, text, widget } from "mcp-use/server";
3	import z from "zod/v4";
4	// Get Supabase Personal Access Token from environment
5	const SUPABASE_ACCESS_TOKEN = process.env.ACCESS_TOKEN;
6	
7	if (!SUPABASE_ACCESS_TOKEN) {
8	  throw new Error(
9	    "Missing ACCESS_TOKEN environment variable.\n" +
10	    "Generate one at: https://supabase.com/dashboard/account/tokens"
11	  );
12	}
13	
14	// Create MCP client connected to Supabase's official MCP server
15	const client = new MCPClient({
16	  mcpServers: {
17	    supabase: {
18	      url: `https://mcp.supabase.com/mcp?project_ref=${process.env.MCP_USE_OAUTH_SUPABASE_PROJECT_ID}`,
19	      headers: {
20	        Authorization: `Bearer ${SUPABASE_ACCESS_TOKEN}`,
21	      },
22	    }
23	  }
24	});
25	
26	await client.createAllSessions();
27	
28	const supabaseClient = client.getSession("supabase");
29	
30	// Note: Supabase client session is ready for tool calls
31	console.log("Supabase MCP Analytics Server initialized");
32	
33	// Helper function to extract JSON from Supabase's untrusted-data wrapper
34	function extractJsonFromResponse(text: string): any[] {
35	  console.log("Extracting JSON from text, length:", text.length);
36	  
37	  try {
38	    // First try direct JSON parse
39	    const directParse = JSON.parse(text);
40	    console.log("Direct parse successful, type:", typeof directParse, "isArray:", Array.isArray(directParse));
41	    
42	    // If it's already an array, return it
43	    if (Array.isArray(directParse)) {
44	      return directParse;
45	    }
46	    
47	    // If it's a string (double-encoded), we need to extract from wrapper
48	    if (typeof directParse === 'string') {
49	      console.log("Result is a string, extracting from wrapper...");
50	      text = directParse;
51	      // Fall through to extraction logic below
52	    } else {
53	      // It's some other type, just return it wrapped in array
54	      return [directParse];
55	    }
56	  } catch (directError) {
57	    console.log("Direct parse failed, will try extraction");
58	  }
59	  
60	  // Look for JSON within untrusted-data tags
61	  console.log("Looking for untrusted-data tags in text...");
62	  
63	  // The opening tag appears twice: once in the description and once as actual tag
64	  // We need to find the LAST occurrence followed by actual content
65	  // Pattern: find opening tag followed by newline and JSON array
66	  const dataMatch = text.match(/<untrusted-data-([a-f0-9-]+)>\s*(\[[\s\S]+?)\s*<\/untrusted-data-\1>/);
67	  
68	  if (dataMatch && dataMatch[2]) {
69	    const uuid = dataMatch[1];
70	    const content = dataMatch[2];
71	    console.log("Found data with UUID:", uuid);
72	    console.log("Extracted content length:", content.length);
73	    console.log("Extracted content preview:", content.substring(0, 100));
74	    try {
75	      const parsed = JSON.parse(content);
76	      console.log("Parsed successfully, items:", Array.isArray(parsed) ? parsed.length : 'not array');
77	      return Array.isArray(parsed) ? parsed : [parsed];
78	    } catch (parseError) {
79	      console.log("Failed to parse extracted JSON:", parseError);
80	      return [];
81	    }
82	  }
83	  
84	  console.log("No untrusted-data match found");
85	  return [];
86	}
87	
88	const server = new MCPServer({
89	  name: "Supabase Widgets",
90	  version: "1.0.0",
91	  description: "A Supabase MCP server with Apps SDK widgets",
92	});
93	
94	// ============================================================================
95	// DATABASE SCHEMA TOOLS
96	// ============================================================================
97	
98	// List all tables
99	server.tool(
100	  {
101	    name: "list-tables",
102	    description: "List all tables in your Supabase database",
103	    schema: z.object({
104	      schemas: z.array(z.string()).optional().describe("Schemas to include (default: all)"),
105	    }),
106	    widget: {
107	      name: "schema-explorer",
108	      invoking: "Loading database tables...",
109	      invoked: "Tables loaded successfully",
110	    },
111	    annotations: { readOnlyHint: true }
112	  },
113	  async ({ schemas }) => {
114	    try {
115	
116	      const result = await supabaseClient?.callTool("list_tables", {
117	        schemas: ["public"]
118	      });   
119	
120	      const content = result?.content[0];
121	      console.log("content", content);
122	      let tables: any[] = [];
123	      
124	      if (content?.type === "text") {
125	        const data = extractJsonFromResponse(content?.text ?? "");
126	        tables = Array.isArray(data) ? data : [];
127	      }
128	
129	      return widget({
130	        props: {
131	          tables,
132	          schemas: schemas || ["public"],
133	        },
134	        output: object({
135	          tables: tables.map((table) => ({
136	            name: table.name,
137	          })),
138	        })
139	      });
140	      } catch (err) {
141	        return error(`Error listing tables: ${err instanceof Error ? err.message : String(err)}`)
142	      }
143	  }
144	);
145	
146	// Show table data
147	server.tool(
148	  {
149	    name: "show-table",
150	    description: "Display data from a specific table",
151	    schema: z.object({
152	      tableName: z.string().describe("Name of the table to display"),
153	      schema: z.string().default("public").describe("Schema name"),
154	      limit: z.number().default(100).describe("Maximum number of rows to fetch"),
155	    }),
156	    widget: {
157	      name: "table-viewer",
158	      invoking: "Loading table data...",
159	      invoked: "Table data loaded",
160	    },
161	    annotations: { readOnlyHint: true }
162	  },
163	  async ({ tableName, schema, limit }) => {
164	    try {
165	      if (!supabaseClient) {
166	        throw new Error("Supabase client not initialized");
167	      }
168	
169	      // Fetch table data using SQL query
170	      const query = `SELECT * FROM ${schema}.${tableName} LIMIT ${limit}`;
171	      const result = await supabaseClient.callTool("execute_sql", {
172	        query,
173	      });
174	      console.log("query", Object.keys(result.content[0]));
175	
176	      console.log("result", result);
177	
178	      const content = result.content[0];
179	      let rows: any[] = [];
180	      
181	      if (content.type === "text") {
182	        console.log("Raw content.text preview:", content.text.substring(0, 300));
183	        const data = extractJsonFromResponse(content.text);
184	        console.log("data", data);
185	        rows = Array.isArray(data) ? data : [];
186	      }
187	
188	      // Extract column names from first row
189	      const columns = rows.length > 0 ? Object.keys(rows[0]) : [];
190	
191	      return widget({
192	        props: {
193	          tableName,
194	          schema,
195	          rows,
196	          columns,
197	          totalRows: rows.length,
198	          projectRef: process.env.MCP_USE_OAUTH_SUPABASE_PROJECT_ID,
199	        },
200	        output: object({
201	          tableName,
202	          schema,
203	          columns,
204	          totalRows: rows.length,
205	          projectRef: process.env.MCP_USE_OAUTH_SUPABASE_PROJECT_ID,
206	        }),
207	      });
208	    } catch (err) {
209	      return error(`Error loading table data: ${err instanceof Error ? err.message : String(err)}`)
210	    }
211	  }
212	);
213	
214	// Execute SQL query
215	server.tool(
216	  {
217	    name: "execute-sql",
218	    description: "Execute read-only SQL queries on your Supabase database",
219	    schema: z.object({
220	      query: z.string().describe("SQL query to execute"),
221	    }),
222	    widget: {
223	      name: "query-results",
224	      invoking: "Executing SQL query...",
225	      invoked: "Query completed",
226	    },
227	    annotations: { readOnlyHint: true }
228	  },
