167	    private async withRetry<T>(
168	        operation: () => Promise<T>,
169	        window: Window,
170	        options: { requireFocus?: boolean } = {}
171	    ): Promise<T> {
172	        const { requireFocus = false } = options
173	        let lastError: Error | undefined
174	
175	        for (let attempt = 1; attempt <= MAX_RETRIES; attempt++) {
176	            try {
177	                // Verify window is valid
178	                if (!await this.isWindowResponding(window)) {
179	                    throw new Error('Window is not responding')
180	                }
181	
182	                // Focus window if required
183	                if (requireFocus) {
184	                    await this.focusWindow(window)
185	                }
186	
187	                // Execute the operation
188	                return await operation()
189	            } catch (error) {
190	                lastError = error as Error
191	                console.error(`Operation failed (attempt ${attempt}/${MAX_RETRIES}):`, error)
192	                
193	                if (attempt < MAX_RETRIES) {
194	                    await new Promise(resolve => setTimeout(resolve, RETRY_DELAY))
195	                }
196	            }
197	        }
198	
199	        throw lastError || new Error('Operation failed after retries')
200	    }
