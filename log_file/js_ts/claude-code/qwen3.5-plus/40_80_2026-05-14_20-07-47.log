1	import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
2	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
3	import Logger from './logger.js';
4	import { loadResources } from './resources.js';
5	import { loadPrompts } from './prompts.js';
6	import fs from 'fs/promises';
7	import path from 'path';
8	import { getPromptsDir, parseMetadata } from './prompts.js';
9	
10	// Server configuration
11	const SERVER_CONFIG = {
12	  name: 'Sensei',
13	  version: '0.0.1',
14	};
15	
16	/**
17	 * Initialize and start the MCP server
18	 */
19	export async function startServer(): Promise<void> {
20	  const span = Logger.span('startServer');
21	
22	  try {
23	    // Get the prompts directory
24	    const promptsDir = await getPromptsDir();
25	
26	    // Load the sensei prompt content to use as server instructions
27	    const senseiPromptPath = path.join(promptsDir, 'sensei.txt');
28	    let senseiInstructions = '';
29	
30	    try {
31	      const rawContent = await fs.readFile(senseiPromptPath, 'utf-8');
32	      // Parse the content to remove metadata
33	      const { content } = parseMetadata(rawContent);
34	
35	      // Use the content without metadata as server instructions
36	      senseiInstructions = content;
37	
38	      Logger.info('Loaded sensei prompt for server instructions', {
39	        path: senseiPromptPath,
40	        contentLength: senseiInstructions.length,
41	      });
42	    } catch (error) {
43	      Logger.warn('Failed to load sensei prompt for server instructions', {
44	        path: senseiPromptPath,
45	        error: (error as Error).message,
46	      });
47	    }
48	
49	    // Create the MCP server with instructions
50	    const server = new McpServer(SERVER_CONFIG, {
51	      instructions: senseiInstructions,
52	    });
53	
54	    Logger.info('Starting Sensei server', {
55	      name: SERVER_CONFIG.name,
56	      version: SERVER_CONFIG.version,
57	      hasInstructions: senseiInstructions.length > 0,
58	    });
59	
60	    // Load resources
61	    const resourceMap = await loadResources(server);
62	    Logger.info(`Resources loaded`, { count: resourceMap.size });
63	
64	    // Load prompts
65	    await loadPrompts(server, resourceMap);
66	
67	    // Start receiving messages on stdin and sending messages on stdout
68	    const transport = new StdioServerTransport();
69	    await server.connect(transport);
70	
71	    Logger.info('Sensei server connected and ready');
72	    span.end('success');
73	  } catch (error) {
74	    Logger.error('Failed to start server', error);
75	    span.end('error');
76	    throw error;
77	  }
78	}
79	

