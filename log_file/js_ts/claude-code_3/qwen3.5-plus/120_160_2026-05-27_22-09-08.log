242	        },
243	      },
244	      {
245	        name: "delete_entry",
246	        description: "Delete rows/records from a PostgreSQL table that match specified conditions. Use this tool to remove data from your database tables. Example: Delete all inactive users or users who haven't logged in since January 1, 2024.",
247	        inputSchema: {
248	          type: "object",
249	          properties: {
250	            tableName: { 
