66	function formatDiff(original: string, updated: string): string {
67	  const originalLines = original.split('\n')
68	  const newLines = updated.split('\n')
69	
70	  // Find the range of lines that changed
71	  let startLine = -1
72	  let endLine = -1
73	
74	  for (let i = 0; i < Math.max(originalLines.length, newLines.length); i++) {
75	    if (originalLines[i] !== newLines[i]) {
76	      if (startLine === -1) startLine = i
77	      endLine = i
78	    }
79	  }
80	
81	  if (startLine === -1) {
82	    throw new Error('Could not generate a diff for changes to the file')
83	  }
84	
85	  // Generate diff with context
86	  const displayStart = Math.max(0, startLine - CONTEXT_LINES)
87	  const displayEnd = Math.min(originalLines.length - 1, endLine + CONTEXT_LINES)
88	  const diffLines: string[] = []
89	  for (let i = displayStart; i <= displayEnd; i++) {
90	    const oldLine = originalLines[i] || ''
91	    const newLine = newLines[i] || ''
92	
93	    if (i < startLine || i > endLine) {
94	      // Context line
95	      diffLines.push(`  ${oldLine}`)
96	    } else if (oldLine !== newLine) {
97	      // Changed line
98	      if (oldLine) diffLines.push(`- ${oldLine}`)
99	      if (newLine) diffLines.push(`+ ${newLine}`)
100	    } else {
101	      // Unchanged line within change range
102	      diffLines.push(`  ${oldLine}`)
103	    }
104	  }
105	
106	  return `The following diff was applied to the file:
107	
108	\`\`\`\n${diffLines.join('\n')}\n\`\`\``
109	}
