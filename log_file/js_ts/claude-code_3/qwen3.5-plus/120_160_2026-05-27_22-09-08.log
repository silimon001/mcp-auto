17	    allow_multiple_matches: z.boolean().optional().describe('Allow multiple matches to be replaced. If false, throws error when multiple matches found (default: true)'),
18	  }),
19	  description: 'Search and replace with intelligent whitespace handling and automation-friendly multiple match resolution. Tries exact match first, falls back to flexible whitespace matching only when no matches found.',
20	  isReadOnly: false,
21	  isEnabled: env.DEBUG,
22	  fromArgs: ([filePath, oldString, newString]) => ({
23	    file_path: filePath, old_string: oldString, new_string: newString,
24	  }),
25	  handler: (args) => {
26	    const { file_path: filePath, old_string: oldString, new_string: newString, allow_multiple_matches: allowMultiple = true } = args
27	    const fullPath = util.resolve(filePath)
28	    const content = util.readFile(fullPath)
29	
30	    // Validate that the replacement would actually change something
31	    if (oldString.includes(newString)) {
32	      throw new Error(`Redundant replacement: old_string already contains new_string. Old: "${oldString}", New: "${newString}"`)
33	    }
34	    // Core strategies: exact match + whitespace flexibility (matching Cursor's capability)
35	    const patterns = [oldString, createCursorLikePattern(oldString)]
36	    // Try each strategy until one works
37	    for (const pattern of patterns) {
38	      const parts = content.split(pattern)
39	      const matches = parts.length - 1
40	      if (!matches) {
41	        continue
42	      }
43	      if (matches > 1 && !allowMultiple) {
44	        throw new Error(`Multiple matches found (${matches}) for "${oldString}" in ${filePath}. Set allow_multiple_matches=true to allow replacing first occurrence, or make your search string more specific.`)
45	      }
46	      const newContent = parts.join(newString)
47	      util.writeFile(fullPath, newContent)
48	      return formatDiff(content, newContent)
49	    }
50	    throw new Error(`Could not find the specified text in ${filePath}`)
51	  },
52	})
53	
54	// Helper function for Cursor-like whitespace handling
55	function createCursorLikePattern(text: string) {
56	  // Match Cursor's whitespace handling: flexible with spaces/tabs, preserve structure
57	  return new RegExp(_.escapeRegExp(text)
58	    .replace(/\s+/g, '\\s+')           // Any whitespace sequence becomes flexible
59	    .replace(/^\s*/, '\\s*')           // Optional leading whitespace
60	    .replace(/\s*$/, '\\s*')           // Optional trailing whitespace
61	  , 'gm')
62	}
