391	      },
392	      totalThoughts: {
393	        type: "integer",
394	        description: "Estimated total thoughts needed",
395	        minimum: 1
396	      },
397	      isRevision: {
398	        type: "boolean",
399	        description: "Whether this revises previous thinking"
400	      },
401	      revisesThought: {
402	        type: "integer",
403	        description: "Which thought is being reconsidered",
404	        minimum: 1
405	      },
