1	#!/usr/bin/env -S node --experimental-strip-types
2	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js'
3	
4	import { getMcpHttpMode, getMcpPort, getSocketApiToken } from './lib/env.ts'
5	
6	import { createConfiguredServer, setStaticApiKey } from './lib/depscore-tool.ts'
7	import { getApiKeyInteractively } from './lib/http-helpers.ts'
8	import { startHttpServer } from './lib/http-server.ts'
9	import { logger } from './lib/logger.ts'
10	import {
11	  hasAnyOAuthConfig,
12	  loadOAuthMetadata,
13	  setOauthEnabled,
14	} from './lib/oauth.ts'
15	import { VERSION } from './lib/version.ts'
16	
17	// Re-export the module's public surface so existing consumers (tests,
18	// downstream importers) continue to work after the split.
19	export {
20	  buildSocketHeaders,
21	  getApiKeyInteractively,
22	  getForwardedHeaderValue,
23	  getRequestBaseUrl,
24	  getRequestHeaderValue,
25	  parseJsonObject,
26	  writeJson,
27	  writeOAuthError,
28	} from './lib/http-helpers.ts'
29	export { createConfiguredServer } from './lib/depscore-tool.ts'
30	export {
31	  authenticateRequest,
32	  buildProtectedResourceMetadata,
33	  getProtectedResourceMetadataUrl,
34	  loadOAuthMetadata,
35	  splitScopes,
36	  verifyAccessToken,
37	} from './lib/oauth.ts'
38	
39	// MCP_HTTP_MODE / MCP_PORT resolved via fleet-canonical helpers in
40	// @socketsecurity/lib/env/socket. `--http` CLI flag still overrides
41	// the env-driven default.
42	const useHttp = getMcpHttpMode() || process.argv.includes('--http')
43	const port = getMcpPort()
44	
45	const oauthEnabledResult = useHttp ? setOauthEnabled() : undefined
46	const oauthEnabled = Boolean(oauthEnabledResult)
47	
48	if (useHttp && hasAnyOAuthConfig && !oauthEnabled) {
49	  logger.error(
50	    'Incomplete OAuth configuration for HTTP mode. Set SOCKET_OAUTH_ISSUER, SOCKET_OAUTH_INTROSPECTION_CLIENT_ID, and SOCKET_OAUTH_INTROSPECTION_CLIENT_SECRET together.',
51	  )
52	  process.exit(1)
53	}
54	
55	// Resolve the API token via the fleet-canonical helper. Accepts (in
56	// priority order) SOCKET_API_TOKEN → SOCKET_CLI_API_TOKEN →
57	// SOCKET_CLI_API_KEY → SOCKET_SECURITY_API_TOKEN → SOCKET_SECURITY_API_KEY.
58	// Centralizing the fallback chain in @socketsecurity/lib means every
59	// fleet binary (cli, mcp, sdk consumers) accepts the same set of
60	// names; adding/removing an alias is a one-line change upstream.
61	let apiKey = getSocketApiToken() || ''
62	
63	// Stdio mode cannot prompt — stdin is the MCP protocol channel — so we
64	// require the env var. HTTP mode can prompt on stderr or rely entirely
65	// on OAuth.
66	if (!apiKey && !(useHttp && oauthEnabled)) {
67	  if (useHttp) {
68	    logger.error('SOCKET_API_TOKEN environment variable is not set')
69	    apiKey = await getApiKeyInteractively()
70	  } else {
71	    logger.error(
72	      'SOCKET_API_TOKEN environment variable is required in stdio mode',
73	    )
74	    logger.error(
75	      'Please set SOCKET_API_TOKEN (or one of the legacy aliases) and try again',
76	    )
77	    process.exit(1)
78	  }
79	}
80	
81	setStaticApiKey(apiKey)
82	
83	if (oauthEnabled && oauthEnabledResult) {
84	  try {
85	    await loadOAuthMetadata()
86	    logger.info(
87	      `Enabled OAuth-backed MCP auth with issuer ${oauthEnabledResult.issuer}`,
88	    )
89	  } catch (error) {
90	    logger.error(
91	      `Failed to initialize OAuth metadata: ${error instanceof Error ? error.message : String(error)}`,
92	    )
93	    process.exit(1)
94	  }
95	}
96	
97	if (useHttp) {
98	  startHttpServer(port)
99	} else {
100	  logger.info('Starting in stdio mode')
101	  const server = createConfiguredServer()
102	  const transport = new StdioServerTransport()
103	  server
104	    .connect(transport)
105	    .then(() => {
106	      logger.info(`Socket MCP server version ${VERSION} started successfully`)
107	    })
108	    .catch((error: Error) => {
109	      logger.error(`Failed to start Socket MCP server: ${error.message}`)
110	      process.exit(1)
111	    })
112	}
113	

