100	function getFunctionSignature(func: Function): string {
101	  try {
102	    const str = func.toString()
103	    const match = str.match(/\(([^)]*)\)/)
104	    if (match?.[1]) {
105	      const params = match[1].split(',').map(p => p.trim().split('=')[0]?.trim()).filter(Boolean)
106	      return `(${params.join(', ')})`
107	    }
108	    return '(...)'
109	  } catch {
110	    return '(...)'
111	  }
112	}
113	
114	function getClassSignature(cls: Function): string {
115	  try {
116	    const match = cls.toString().match(/constructor\s*\(([^)]*)\)/)
117	    if (match?.[1]) {
118	      const params = match[1].split(',').map(p => p.trim().split('=')?.[0]?.trim()).filter(p => p)
119	      return `(${params.join(', ')})`
120	    }
121	    return getFunctionSignature(cls)
122	  } catch {
123	    return '(...)'
124	  }
125	}
