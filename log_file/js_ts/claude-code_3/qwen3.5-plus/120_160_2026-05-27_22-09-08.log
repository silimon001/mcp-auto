39	const MAX_VALUE_LENGTH = 300
40	
41	function dumpValue(value: any): string {
42	  const type = typeof value
43	  const output: string[] = []
44	  if (type === 'object' && value !== null) {
45	    const keys = Object.keys(value).sort()
46	    if (keys.length > 0) {
47	      if (_.isArray(value)) {
48	        const elementType = typeof value[0]
49	        output.push(`${elementType}[${value.length}]`)
50	      } else if (_.isPlainObject(value)) {
51	        output.push('object')
52	      } else {
53	        output.push(`object (${value.constructor.name})`)
54	      }
55	      keys.forEach((key) => {
56	        if (!key.startsWith('_')) {
57	          output.push(`${key}: ${dump(value[key])}`)
58	        }
59	      })
60	      return output.join('\n')
61	    }
62	  }
63	  return dump(value)
64	}
65	
66	function dump(value: any): string {
67	  const type = typeof value
68	  if (type === 'function') {
69	    if (isClass(value)) {
70	      return `class ${getClassSignature(value)}`
71	    }
72	    return `function ${getFunctionSignature(value)}`
73	  }
74	  if (_.isArray(value)) {
75	    const json = JSON.stringify(value)
76	    if (json.length <= MAX_VALUE_LENGTH) {
77	      return json
78	    }
79	    const type = typeof value[0]
80	    return `${type}[${value.length}]`
81	  }
82	  if (_.isPlainObject(value)) {
83	    const json = JSON.stringify(value)
84	    if (json.length <= MAX_VALUE_LENGTH) {
85	      return json
86	    }
87	    const keys = Object.keys(value)
88	    return `object (${keys.length} properties)`
89	  }
90	  if (type === 'object' && value !== null) {
91	    return value.constructor.name
92	  }
93	  return JSON.stringify(value)
94	}
95	
96	function isClass(func: Function): boolean {
97	  return func.toString().startsWith('class ')
98	}
