27	class SequentialThinkingServer {
28	  private thoughtHistory: ThoughtData[] = [];
29	  private branches: Record<string, ThoughtData[]> = {};
30	  private currentQuery?: string;
31	  private currentSessionId: string = '';
32	
33	  constructor() {
34	    // Initialize Recall integration
35	    this.initializeRecall();
36	    // Generate initial session ID
37	    this.generateNewSessionId();
38	  }
39	
40	  private generateNewSessionId(): string {
41	    this.currentSessionId = `session-${Date.now()}-${Math.floor(Math.random() * 10000)}`;
42	    logger.error(chalk.blue(`🔄 Created new session ID: ${this.currentSessionId}`));
43	    return this.currentSessionId;
44	  }
45	
46	  private clearSession(): void {
47	    logger.error(chalk.blue(`🧹 Clearing session data for ${this.currentSessionId}`));
48	    this.thoughtHistory = [];
49	    this.branches = {};
50	    this.currentQuery = undefined;
51	    this.generateNewSessionId();
52	  }
53	
54	  private async initializeRecall(): Promise<void> {
55	    try {
56	      await recallIntegration.initializeBucket();
57	      logger.error(chalk.green('🔄 Recall integration initialized for sequential thinking logs'));
58	    } catch (error: any) {
59	      logger.error(chalk.yellow(`⚠️ Recall initialization failed: ${error.message}`));
60	      logger.error(chalk.yellow('Sequential thinking will still work but logs won\'t be stored in Recall'));
61	    }
62	  }
63	
64	  private validateThoughtData(input: unknown): ThoughtData {
65	    const data = input as Record<string, unknown>;
66	
67	    if (!data.thought || typeof data.thought !== 'string') {
68	      throw new Error('Invalid thought: must be a string');
69	    }
70	    if (!data.thoughtNumber || typeof data.thoughtNumber !== 'number') {
71	      throw new Error('Invalid thoughtNumber: must be a number');
72	    }
73	    if (!data.totalThoughts || typeof data.totalThoughts !== 'number') {
74	      throw new Error('Invalid totalThoughts: must be a number');
75	    }
76	    if (typeof data.nextThoughtNeeded !== 'boolean') {
77	      throw new Error('Invalid nextThoughtNeeded: must be a boolean');
78	    }
79	
80	    return {
81	      thought: data.thought,
82	      thoughtNumber: data.thoughtNumber,
83	      totalThoughts: data.totalThoughts,
84	      nextThoughtNeeded: data.nextThoughtNeeded,
85	      isRevision: data.isRevision as boolean | undefined,
86	      revisesThought: data.revisesThought as number | undefined,
87	      branchFromThought: data.branchFromThought as number | undefined,
88	      branchId: data.branchId as string | undefined,
89	      needsMoreThoughts: data.needsMoreThoughts as boolean | undefined,
90	    };
91	  }
92	
93	  private formatThought(thoughtData: ThoughtData): string {
94	    const { thoughtNumber, totalThoughts, thought, isRevision, revisesThought, branchFromThought, branchId } = thoughtData;
95	
96	    let prefix = '';
97	    let context = '';
98	
99	    if (isRevision) {
100	      prefix = chalk.yellow('🔄 Revision');
101	      context = ` (revising thought ${revisesThought})`;
102	    } else if (branchFromThought) {
103	      prefix = chalk.green('🌿 Branch');
104	      context = ` (from thought ${branchFromThought}, ID: ${branchId})`;
105	    } else {
106	      prefix = chalk.blue('💭 Thought');
107	      context = '';
108	    }
109	
110	    const header = `${prefix} ${thoughtNumber}/${totalThoughts}${context}`;
111	    const border = '─'.repeat(Math.max(header.length, thought.length) + 4);
112	
113	    return `
114	┌${border}┐
115	│ ${header} │
116	├${border}┤
117	│ ${thought.padEnd(border.length - 2)} │
118	└${border}┘`;
119	  }
120	
121	  private async storeSessionToRecall(): Promise<{ txHash?: string, success: boolean, key: string } | undefined> {
122	    if (this.thoughtHistory.length === 0) return undefined;
123	    
124	    try {
125	      logger.error(chalk.blue(`🔍 Debug: Attempting to store session ${this.currentSessionId} with ${this.thoughtHistory.length} thoughts to Recall`));
126	      const status = await recallIntegration.getStatusInfo();
127	      logger.error(chalk.blue(`🔍 Debug: Recall status before storing session: ${JSON.stringify(status, null, 2)}`));
128	      
129	      // Store the session with all accumulated thoughts
130	      logger.error(chalk.blue(`🔍 Debug: Storing complete thought history with ${this.thoughtHistory.length} thoughts`));
131	      
132	      // Create a deep clone of the thoughts to prevent any reference issues
133	      const thoughtsToStore = this.thoughtHistory.map(thought => ({
134	        ...thought,
135	        thought: thought.thought,  // Explicitly copy the thought text
136	        thoughtNumber: thought.thoughtNumber,
137	        totalThoughts: thought.totalThoughts,
138	        nextThoughtNeeded: thought.nextThoughtNeeded,
139	        // Include other properties if present
140	        isRevision: thought.isRevision,
141	        revisesThought: thought.revisesThought,
142	        branchFromThought: thought.branchFromThought,
143	        branchId: thought.branchId,
144	        needsMoreThoughts: thought.needsMoreThoughts,
145	        // Add the session ID for tracking
146	        sessionId: this.currentSessionId
147	      }));
148	      
149	      // Log each thought for debugging
150	      thoughtsToStore.forEach((thought, index) => {
151	        logger.error(chalk.blue(`🔍 Debug: Thought ${index + 1}: ${JSON.stringify({
152	          thought: thought.thought.substring(0, 50) + (thought.thought.length > 50 ? '...' : ''),
153	          thoughtNumber: thought.thoughtNumber,
154	          totalThoughts: thought.totalThoughts,
155	          nextThoughtNeeded: thought.nextThoughtNeeded,
156	          sessionId: thought.sessionId
157	        })}`));
158	      });
159	      
160	      const storeResult = await recallIntegration.storeSession(
161	        thoughtsToStore,
162	        { 
163	          query: this.currentQuery || 'No query provided',
164	          sessionId: this.currentSessionId
165	        }
166	      );
167	      
168	      if (storeResult?.success) {
169	        logger.error(chalk.green(`✅ Debug: Successfully stored session with result: ${JSON.stringify(storeResult, null, 2)}`));
170	      } else {
171	        logger.error(chalk.yellow(`⚠️ Debug: Store session returned unsuccessful result`));
172	      }
173	      
174	      return storeResult;
175	    } catch (error: any) {
176	      logger.error(chalk.red(`❌ Error handling session storage: ${error.message}`));
177	      logger.error(chalk.red(`Stack trace: ${error.stack}`));
178	      return undefined;
179	    }
180	  }
181	
182	  public async processThought(input: unknown, query?: string): Promise<{ content: Array<{ type: string; text: string }>; isError?: boolean }> {
183	    try {
184	      const validatedInput = this.validateThoughtData(input);
185	
186	      // Save the query if provided and not already set
187	      if (query && !this.currentQuery) {
188	        this.currentQuery = query;
189	        logger.error(chalk.blue(`🔍 Set query: "${query.substring(0, 50)}${query.length > 50 ? '...' : ''}"`));
190	      }
191	
192	      if (validatedInput.thoughtNumber > validatedInput.totalThoughts) {
193	        validatedInput.totalThoughts = validatedInput.thoughtNumber;
194	      }
195	
196	      // Add to our local thought history
197	      this.thoughtHistory.push(validatedInput);
198	      logger.error(chalk.blue(`📝 Added thought #${validatedInput.thoughtNumber} to memory (now have ${this.thoughtHistory.length} thoughts)`));
199	
200	      if (validatedInput.branchFromThought && validatedInput.branchId) {
201	        if (!this.branches[validatedInput.branchId]) {
202	          this.branches[validatedInput.branchId] = [];
203	        }
204	        this.branches[validatedInput.branchId].push(validatedInput);
205	      }
206	
207	      const formattedThought = this.formatThought(validatedInput);
208	      logger.error(formattedThought);
209	
210	      // If this is the last thought (nextThoughtNeeded is false), store the complete session
211	      let sessionInfo;
212	      if (!validatedInput.nextThoughtNeeded) {
213	        logger.error(chalk.blue(`🔍 Debug: Final thought received (${validatedInput.thoughtNumber}/${validatedInput.totalThoughts}), storing complete session to Recall`));
214	        
215	        // Log the number of thoughts we have in memory before storage
216	        logger.error(chalk.blue(`📊 Debug: Thought history contains ${this.thoughtHistory.length} thoughts before storage`));
217	        
218	        // Store all thoughts at once
219	        sessionInfo = await this.storeSessionToRecall();
220	        
221	        // Direct logger output for debugging Recall transactions
222	        if (sessionInfo) {
223	          // Get the bucketAddress for the portal URL
224	          const recallStatus = await recallIntegration.getStatusInfo();
225	          const portalUrl = `https://portal.recall.network/buckets/${recallStatus.bucketAddress}?path=${sessionInfo.key}`;
226	          
227	          logger.error(chalk.magenta(`
228	╔═════════════════════════════════════════════════════════
229	║ 📊 RECALL SESSION QUEUED
230	║ Key: ${sessionInfo.key}
231	║ Success: ${sessionInfo.success ? '✅' : '❌'}
232	║ Transaction: ${sessionInfo.txHash || 'Pending'}
233	║ 
234	║ 🔗 View in Recall Portal:
235	║ ${portalUrl}
236	╚═════════════════════════════════════════════════════════
237	`));
238	          
239	          // After successful storage, clear the session data to prepare for a new sequence
240	          if (sessionInfo.success) {
241	            // Clear the session data
242	            this.clearSession();
243	            logger.error(chalk.green(`✅ Session data cleared, ready for new thoughts`));
244	          }
245	        } else {
246	          logger.error(chalk.yellow(`⚠️ Warning: No session info returned from storeSessionToRecall!`));
247	        }
248	      } else {
249	        logger.error(chalk.blue(`🔍 Debug: Non-final thought #${validatedInput.thoughtNumber} added to memory, waiting for more thoughts`));
250	      }
251	
252	      // Build the response with recall information if available
253	      const response = {
254	        thoughtNumber: validatedInput.thoughtNumber,
255	        totalThoughts: validatedInput.totalThoughts,
256	        nextThoughtNeeded: validatedInput.nextThoughtNeeded,
257	        branches: Object.keys(this.branches),
258	        thoughtHistoryLength: this.thoughtHistory.length,
259	        // Include the complete thought history data
260	        thoughtHistory: this.thoughtHistory
261	      };
262	
263	      // Add a separate field specifically for Claude to see the Recall info
264	      const recallStatus = await recallIntegration.getStatusInfo();
265	      const responseWithRecall = {
266	        ...response,
267	        recallInfo: sessionInfo ? {
268	          txHash: sessionInfo?.txHash,
269	          success: sessionInfo?.success,
270	          key: sessionInfo?.key,
271	          operation: 'session',
272	          stored: true,
273	          pendingTransactionCount: recallIntegration.isInitialized() ? 
274	            (await recallIntegration.getStatusInfo()).pendingThoughts : 0,
275	          // Add the URL for viewing the session in the Recall portal
276	          viewUrl: `https://portal.recall.network/buckets/${recallStatus.bucketAddress}?path=${sessionInfo.key}`
277	        } : {
278	          stored: false,
279	          reason: validatedInput.nextThoughtNeeded ? 
280	            "Session not complete yet - storing in memory only" : 
281	            "Recall storage pending or unavailable",
282	          thoughtsInMemory: this.thoughtHistory.length,
283	          isSessionComplete: !validatedInput.nextThoughtNeeded
284	        }
285	      };
286	
287	      return {
288	        content: [{
289	          type: "text",
290	          text: JSON.stringify(responseWithRecall, null, 2)
291	        }]
292	      };
293	    } catch (error) {
294	      return {
295	        content: [{
296	          type: "text",
297	          text: JSON.stringify({
298	            error: error instanceof Error ? error.message : String(error),
299	            status: 'failed'
300	          }, null, 2)
301	        }],
302	        isError: true
303	      };
304	    }
305	  }
306	}
