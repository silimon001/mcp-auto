9	const ID = 'search_replace'
10	const searchReplace = defineTool({
11	  id: ID,
12	  name: `${env.OVERRIDE_S_R ? '': 'better_'}${ID}`,
13	  schema: z.object({
14	    file_path: z.string().min(1).describe('Path to the file (supports relative and absolute paths)'),
15	    old_string: z.string().min(1).describe('Exact text to replace (must be unique in file)'),
