259	                description: "String representation of the condition value. Will be compared using equality (=) operator."
260	              },
261	            },
262	          },
263	          required: ["tableName", "conditions"],
264	        },
265	      },
266	    ],
267	  };
268	});
269	
270	// Call tool handler for SQL operations
271	server.setRequestHandler(CallToolRequestSchema, async (request) => {
272	  if (request.params.name === "query") {
273	    const sql = request.params.arguments?.sql as string;
274	
275	    const client = await pool.connect();
276	    try {
277	      await client.query("BEGIN TRANSACTION READ ONLY");
278	      const result = await client.query(sql);
279	
280	      return {
281	        content: [{ type: "text", text: JSON.stringify(result.rows, null, 2) }],
282	        isError: false,
283	      };
284	    } catch (error) {
285	      throw error;
286	    } finally {
287	      await client.query("ROLLBACK");
288	      client.release();
289	    }
290	  }
291	
292	  if (request.params.name === "create_table") {
293	    const { tableName, columns } = request.params.arguments as {
294	      tableName: string;
295	      columns: { name: string; type: string }[];
296	    };
297	
298	    const columnDefinitions = columns
299	      .map((col) => `${col.name} ${col.type}`)
300	      .join(", ");
301	
302	    const client = await pool.connect();
303	    try {
304	      const createTableQuery = `CREATE TABLE ${tableName} (${columnDefinitions})`;
305	      await client.query(createTableQuery);
306	
307	      return {
308	        content: [
309	          {
310	            type: "text",
311	            text: `Table "${tableName}" created successfully with columns: ${columns
312	              .map((col) => `${col.name} (${col.type})`)
313	              .join(", ")}`,
314	          },
315	        ],
316	        isError: false,
317	      };
318	    } catch (error) {
319	      throw error;
320	    } finally {
321	      client.release();
322	    }
323	  }
324	
325	  if (request.params.name === "insert_entry") {
326	    const { tableName, values } = request.params.arguments as {
327	      tableName: string;
328	      values: Record<string, string>;
329	    };
330	
331	    const columns = Object.keys(values).join(", ");
332	    const placeholders = Object.keys(values)
333	      .map((_, index) => `$${index + 1}`)
334	      .join(", ");
335	    const valuesArray = Object.values(values);
336	
337	    const client = await pool.connect();
338	    try {
339	      const insertQuery = `INSERT INTO ${tableName} (${columns}) VALUES (${placeholders}) RETURNING *`;
340	      const result = await client.query(insertQuery, valuesArray);
341	
342	      return {
343	        content: [
344	          {
345	            type: "text",
346	            text: `Inserted into table "${tableName}": ${JSON.stringify(
347	              result.rows[0],
348	              null,
349	              2
350	            )}`,
351	          },
352	        ],
353	        isError: false,
354	      };
355	    } catch (error) {
356	      throw error;
357	    } finally {
358	      client.release();
359	    }
360	  }
361	
362	  if (request.params.name === "delete_table") {
363	    const { tableName } = request.params.arguments as {
364	      tableName: string;
365	    };
366	
367	    const client = await pool.connect();
368	    try {
369	      const deleteTableQuery = `DROP TABLE IF EXISTS ${tableName}`;
370	      await client.query(deleteTableQuery);
371	      return {
372	        content: [
373	          {
374	            type: "text",
375	            text: `Table "${tableName}" deleted successfully`,
376	          },
377	        ],
378	        isError: false,
379	      };
380	    } catch (error) {
381	      throw error;
382	    } finally {
383	      client.release();
384	    }
385	  }
386	
387	  if (request.params.name === "update_entry") {
388	    const { tableName, values, conditions } = request.params.arguments as {
389	      tableName: string;
390	      values: Record<string, string>;
391	      conditions: Record<string, string>;
392	    };
393	
394	    const setClauses = Object.entries(values)
395	      .map(([key, _], index) => `${key} = $${index + 1}`)
396	      .join(", ");
397	    const whereClauses = Object.entries(conditions)
398	      .map(([key, _], index) => `${key} = $${Object.keys(values).length + index + 1}`)
399	      .join(" AND ");
400	    const queryParams = [...Object.values(values), ...Object.values(conditions)];
401	
402	    const client = await pool.connect();
403	    try {
404	      const updateQuery = `UPDATE ${tableName} SET ${setClauses} WHERE ${whereClauses} RETURNING *`;
405	      const result = await client.query(updateQuery, queryParams);
406	
407	      return {
408	        content: [
409	          {
410	            type: "text",
411	            text: `Updated entry in table "${tableName}": ${JSON.stringify(result.rows, null, 2)}`,
412	          },
413	        ],
414	        isError: false,
415	      };
416	    } catch (error) {
417	      throw error;
418	    } finally {
419	      client.release();
420	    }
421	  }
422	
423	  if (request.params.name === "delete_entry") {
424	    const { tableName, conditions } = request.params.arguments as {
425	      tableName: string;
426	      conditions: Record<string, string>;
427	    };
428	
429	    const whereClauses = Object.entries(conditions)
430	      .map(([key, _], index) => `${key} = $${index + 1}`)
431	      .join(" AND ");
432	    const queryParams = Object.values(conditions);
433	
434	    const client = await pool.connect();
435	    try {
436	      const deleteQuery = `DELETE FROM ${tableName} WHERE ${whereClauses} RETURNING *`;
437	      const result = await client.query(deleteQuery, queryParams);
438	
439	      return {
440	        content: [
441	          {
442	            type: "text",
443	            text: `Deleted entry from table "${tableName}": ${JSON.stringify(result.rows, null, 2)}`,
444	          },
445	        ],
446	        isError: false,
447	      };
448	    } catch (error) {
449	      throw error;
450	    } finally {
451	      client.release();
452	    }
453	  }
454	
455	  throw new Error(`Unknown tool: ${request.params.name}`);
456	});
457	
