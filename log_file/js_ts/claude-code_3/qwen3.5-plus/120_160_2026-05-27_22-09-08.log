12	import { UpdateOneTool } from "./tools/mongodb/UpdateOneTool.js";
13	import { DeleteOneTool } from "./tools/mongodb/DeleteOneTool.js";
14	import { CreateIndexTool } from "./tools/mongodb/CreateIndexTool.js";
15	import { DropIndexTool } from "./tools/mongodb/DropIndexTool.js";
16	import { ListIndexesTool } from "./tools/mongodb/ListIndexesTool.js";
17	
18	// Define environment variable schema using zod
19	const EnvSchema = z.object({
20	  MONGO_URI: z.string().optional(),
21	  MONGO_DB_NAME: z.string().default('test'),
22	  MONGO_MAX_POOL_SIZE: z.coerce.number().default(10),
23	  MONGO_ALLOWED_DATABASES: z.string().optional().transform(val => val ? val.split(',') : undefined),
24	  MONGO_ALLOWED_COLLECTIONS: z.string().optional().transform(val => val ? val.split(',') : undefined),
25	  DEBUG: z.string().optional().transform(val => val === 'true'),
26	});
27	
28	// Client and DB variables
29	let client: MongoClient;
30	let db: Db;
31	
32	// Connect to MongoDB
33	async function connectToMongoDB(databaseUrl: string): Promise<Db> {
34	  try {
35	    // Get database name from connection URL if possible
36	    const dbName = process.env.MONGO_DB_NAME || 'test';
37	    const env = EnvSchema.parse(process.env);
38	    
39	    // MongoDB connection options
40	    const options = {
41	      maxPoolSize: env.MONGO_MAX_POOL_SIZE,
42	    };
43	
44	    client = new MongoClient(databaseUrl, options);
45	    await client.connect();
46	    
47	    db = client.db(dbName);
48	    
49	    if (env.DEBUG) {
50	      console.error(`Connected to MongoDB database: ${dbName}`);
51	    }
52	    
53	    return db;
54	  } catch (error) {
55	    console.error("Error connecting to MongoDB:", error);
56	    process.exit(1);
57	  }
58	}
59	
60	// Cleanup function to close MongoDB connection
61	async function closeMongoDB() {
62	  if (client) {
63	    try {
64	      await client.close();
65	      if (EnvSchema.parse(process.env).DEBUG) {
66	        console.error("MongoDB connection closed");
67	      }
68	    } catch (error) {
69	      console.error("Error closing MongoDB connection:", error);
70	    }
71	  }
72	}
73	
74	async function main() {
75	  try {
76	    // Get MongoDB URI from command line argument or env variable
77	    const mongoUri = process.argv[2] || process.env.MONGO_URI;
78	    
79	    if (!mongoUri) {
80	      console.error("MongoDB URI is required. Please provide it as a command line argument or set the MONGO_URI environment variable.");
81	      process.exit(1);
82	    }
83	    
84	    // Connect to MongoDB
85	    db = await connectToMongoDB(mongoUri);
86	    
87	    const env = EnvSchema.parse(process.env);
88	    
89	    // Initialize MCP server
90	    const server = new Server(
91	      {
92	        name: "MongoDB MCP Server",
93	        version: "1.0.2"
94	      },
95	      {
96	        capabilities: {
97	          resources: {},
98	          tools: {
99	            list: true,
100	            call: true,
101	          },
102	        },
103	      }
104	    );
105	    
106	    // Create tools
107	    const tools = [
108	      new ListCollectionsTool(),
109	      new FindTool(),
110	      new InsertOneTool(),
111	      new UpdateOneTool(),
112	      new DeleteOneTool(),
113	      new CreateIndexTool(),
114	      new DropIndexTool(),
115	      new ListIndexesTool(),
116	    ];
117	    
118	    // Set up request handlers
119	    server.setRequestHandler(ListToolsRequestSchema, async () => {
120	      // Get schemas from all tools
121	      const schemas = tools.map(tool => ({
122	        name: tool.getName(),
123	        description: tool.getDescription(),
124	        inputSchema: tool.inputSchema,
125	      }));
126	      
127	      return { tools: schemas, _meta: {} };
128	    });
129	    
130	    server.setRequestHandler(CallToolRequestSchema, async (request) => {
131	      const name = request.params.name;
132	      const args = request.params.arguments ?? {};
133	      
134	      // Check database and collection access based on env vars
135	      if (args && typeof args === 'object' && 'collection' in args) {
136	        const collection = String(args.collection || "");
137	        
138	        // Check if collection is allowed
139	        if (env.MONGO_ALLOWED_COLLECTIONS && 
140	            !env.MONGO_ALLOWED_COLLECTIONS.includes(collection)) {
141	          return { 
142	            toolResult: {
143	              content: [
144	                {
145	                  type: "text",
146	                  text: `Access to collection '${collection}' is not allowed`
147	                }
148	              ],
149	              isError: true
150	            }
151	          };
152	        }
153	      }
154	      
155	      // Create tool map
156	      const toolMap = {
157	        "mcp__listCollections": new ListCollectionsTool(),
158	        "mcp__find": new FindTool(),
159	        "mcp__insertOne": new InsertOneTool(),
160	        "mcp__updateOne": new UpdateOneTool(),
161	        "mcp__deleteOne": new DeleteOneTool(),
162	        "mcp__createIndex": new CreateIndexTool(),
163	        "mcp__dropIndex": new DropIndexTool(),
164	        "mcp__indexes": new ListIndexesTool(),
165	      };
166	      
167	      const tool = toolMap[name as keyof typeof toolMap];
168	      
169	      if (!tool) {
170	        return {
171	          toolResult: {
172	            content: [
173	              {
174	                type: "text",
175	                text: `Tool '${name}' not found`
176	              }
177	            ],
178	            isError: true
179	          }
180	        };
181	      }
182	      
183	      try {
184	        // Execute the tool
185	        // Ensure args has the required collection property for tools that need it
186	        if (name.includes('find') || name.includes('insert') || name.includes('update') || 
187	            name.includes('delete') || name.includes('createIndex') || name.includes('dropIndex') || 
188	            name.includes('indexes')) {
189	          // Make sure collection is set if not already
190	          if (!args.collection) {
191	            return { 
192	              toolResult: {
193	                content: [
194	                  {
195	                    type: "text",
196	                    text: `Collection name is required for tool '${name}'`
197	                  }
198	                ],
199	                isError: true
200	              }
201	            };
202	          }
203	        }
204	        
205	        const result = await tool.execute(args as any);
206	        return { toolResult: result };
207	      } catch (error) {
208	        console.error(`Error executing tool ${name}:`, error);
209	        return { 
210	          toolResult: {
211	            content: [
212	              {
213	                type: "text",
214	                text: error instanceof Error ? error.message : String(error)
215	              }
216	            ],
217	            isError: true
218	          }
219	        };
220	      }
221	    });
222	    
223	    // Set up transport
224	    const transport = new StdioServerTransport();
225	    await server.connect(transport);
226	    
227	    console.error("MongoDB MCP server running on stdio");
228	    
229	    // Set up process handlers for cleanup
230	    process.on('SIGINT', async () => {
231	      await closeMongoDB();
232	      process.exit(0);
233	    });
234	    
235	    process.on('SIGTERM', async () => {
236	      await closeMongoDB();
