252	              description: "Name of the table to delete records from. Example: 'users'"
253	            },
254	            conditions: {
255	              type: "object",
256	              description: "Key-value pairs that specify which rows to delete (WHERE clause conditions). Only rows matching ALL conditions will be deleted. Example: {\"status\": \"inactive\", \"last_login_before\": \"2024-01-01\"}",
257	              additionalProperties: { 
