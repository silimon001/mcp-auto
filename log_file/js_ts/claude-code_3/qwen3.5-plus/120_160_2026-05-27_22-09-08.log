6	export function activate(context: vscode.ExtensionContext) {
7	    console.log('🚀 VSCode internal command MCP extension is now active');
8	    vscode.window.showInformationMessage(`🚀 VSCode internal command MCP extension is now active`);
9	
10	    const mcpServer = new FastMcpServer(context);
11	    const serverManager = new ServerManager(mcpServer);
12	    const taskProvider = new CommandTaskProvider();
13	
14	    const startServer = vscode.commands.registerCommand('vscode-internal-command-mcp-server.startServer', async () => {
15	        await serverManager.startServer();
16	    });
17	
18	    const stopServer = vscode.commands.registerCommand('vscode-internal-command-mcp-server.stopServer', async () => {
19	        await serverManager.stopServer();
20	    });
21	
22	    const showStatus = vscode.commands.registerCommand('vscode-internal-command-mcp-server.showStatus', async () => {
23	        await serverManager.showStatus();
24	    });
25	
26	    const executeCommand = vscode.commands.registerCommand(
27	        'vscode-internal-command-mcp-server.executeCommand',
28	        async () => {
29	            await serverManager.executeCommand();
30	        },
31	    );
32	
33	    const testMcpTools = vscode.commands.registerCommand(
34	        'vscode-internal-command-mcp-server.testMcpTools',
35	        async () => {
36	            await serverManager.testMcpTools();
37	        },
38	    );
39	
40	    // 注册任务提供者
41	    const taskProviderDisposable = vscode.tasks.registerTaskProvider(CommandTaskProvider.taskType, taskProvider);
42	
43	    context.subscriptions.push(
44	        startServer,
45	        stopServer,
46	        showStatus,
47	        executeCommand,
48	        testMcpTools,
49	        mcpServer,
50	        taskProviderDisposable,
51	    );
52	
53	    vscode.workspace.onDidChangeConfiguration(e => {
54	        if (e.affectsConfiguration('vscode-internal-command-mcp-server')) {
55	            console.log('Configuration changed, updating MCP server...');
56	
57	            // 先更新配置
58	            mcpServer.updateConfiguration();
59	
60	            // 显示配置更新通知
61	            const config = vscode.workspace.getConfiguration('vscode-internal-command-mcp-server');
62	            const asyncExecution = config.get<boolean>('asyncExecution', true);
63	            const executionDelay = config.get<number>('executionDelay', 0);
64	
65	            vscode.window.showInformationMessage(
66	                `MCP 配置已更新: 异步执行=${asyncExecution ? '开启' : '关闭'}, 延时=${executionDelay}ms`,
67	            );
68	        }
69	    });
70	
71	    serverManager.initialize();
72	}
73	
74	export function deactivate() {
75	    console.log('VSCode internal command MCP extension is now deactivated');
