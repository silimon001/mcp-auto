42	  OAUTH_TOKEN_URL?: string;
43	  OAUTH_REVOCATION_URL?: string;
44	  OAUTH_REDIRECT_URI: string;
45	  OAUTH_REDIRECT_ALLOWLIST: string[];
46	  OAUTH_REDIRECT_ALLOW_ALL: boolean;
47	  OAUTH_EXTRA_AUTH_PARAMS?: string;
48	
49	  // Provider-specific (generic names for template compatibility)
50	  PROVIDER_CLIENT_ID?: string;
51	  PROVIDER_CLIENT_SECRET?: string;
52	  PROVIDER_API_URL?: string;
53	  PROVIDER_ACCOUNTS_URL?: string;
54	
55	  // Spotify-specific
56	  SPOTIFY_CLIENT_ID?: string;
57	  SPOTIFY_CLIENT_SECRET?: string;
58	  SPOTIFY_API_URL: string;
59	  SPOTIFY_ACCOUNTS_URL: string;
60	  SPOTIFY_SCOPES: string;
61	  /** Include raw JSON in tool content (for debugging) */
62	  SPOTIFY_INCLUDE_JSON_IN_CONTENT: boolean;
63	
64	  // Storage
65	  RS_TOKENS_FILE?: string;
66	  RS_TOKENS_ENC_KEY?: string;
67	
68	  // Rate limiting
69	  RPS_LIMIT: number;
70	  CONCURRENCY_LIMIT: number;
71	
72	  // Logging
73	  LOG_LEVEL: 'debug' | 'info' | 'warning' | 'error';
74	};
75	
76	function parseBoolean(value: unknown): boolean {
77	  return String(value || 'false').toLowerCase() === 'true';
78	}
79	
80	function parseNumber(value: unknown, defaultValue: number): number {
81	  const num = Number(value);
82	  return Number.isFinite(num) ? num : defaultValue;
83	}
84	
85	function parseStringArray(value: unknown): string[] {
86	  return String(value || '')
87	    .split(',')
88	    .map((s) => s.trim())
89	    .filter(Boolean);
90	}
91	
92	/**
93	 * Determine auth strategy from env.
94	 * Priority: AUTH_STRATEGY > AUTH_ENABLED > default
95	 */
96	function parseAuthStrategy(env: Record<string, unknown>): AuthStrategyType {
97	  const explicit = (env.AUTH_STRATEGY as string)?.toLowerCase();
98	  if (explicit && ['oauth', 'bearer', 'api_key', 'custom', 'none'].includes(explicit)) {
99	    return explicit as AuthStrategyType;
100	  }
101	
102	  // Fallback: if AUTH_ENABLED is true, default to OAuth
103	  if (parseBoolean(env.AUTH_ENABLED)) {
104	    return 'oauth';
105	  }
106	
107	  // Check if SPOTIFY_CLIENT_ID is set → default to oauth for Spotify
108	  if (env.SPOTIFY_CLIENT_ID && env.SPOTIFY_CLIENT_SECRET) {
109	    return 'oauth';
110	  }
111	
112	  // Check if API_KEY is set → default to api_key
113	  if (env.API_KEY) {
114	    return 'api_key';
115	  }
116	
117	  // Check if BEARER_TOKEN is set → default to bearer
118	  if (env.BEARER_TOKEN) {
119	    return 'bearer';
120	  }
121	
122	  return 'none';
123	}
124	
125	// Default Spotify OAuth scopes
126	const DEFAULT_SPOTIFY_SCOPES = [
127	  'user-read-playback-state',
128	  'user-modify-playback-state',
129	  'user-read-currently-playing',
130	  'playlist-read-private',
131	  'playlist-read-collaborative',
132	  'playlist-modify-public',
133	  'playlist-modify-private',
134	  'user-library-read',
135	  'user-library-modify',
136	].join(' ');
137	
138	/**
139	 * Parse environment variables into a unified config object
140	 * Works for both process.env (Node.js) and Workers env bindings
141	 */
142	export function parseConfig(env: Record<string, unknown>): UnifiedConfig {
143	  const authStrategy = parseAuthStrategy(env);
144	
145	  // Use Spotify credentials for OAuth if OAUTH_CLIENT_ID not explicitly set
146	  const oauthClientId =
147	    (env.OAUTH_CLIENT_ID as string) || (env.SPOTIFY_CLIENT_ID as string);
148	  const oauthClientSecret =
149	    (env.OAUTH_CLIENT_SECRET as string) || (env.SPOTIFY_CLIENT_SECRET as string);
150	  const spotifyScopes = String(
151	    env.SPOTIFY_SCOPES || env.OAUTH_SCOPES || DEFAULT_SPOTIFY_SCOPES,
152	  );
153	
154	  return {
155	    HOST: String(env.HOST || '127.0.0.1'),
156	    PORT: parseNumber(env.PORT, 3000),
157	    NODE_ENV: (env.NODE_ENV as UnifiedConfig['NODE_ENV']) || 'development',
158	
159	    MCP_TITLE: String(env.MCP_TITLE || 'Spotify MCP'),
160	    MCP_INSTRUCTIONS: String(
161	      env.MCP_INSTRUCTIONS ||
162	        'Control Spotify playback, manage playlists, and search music. Use player_status to check device availability before control actions.',
163	    ),
164	    MCP_VERSION: String(env.MCP_VERSION || '1.0.0'),
165	    MCP_PROTOCOL_VERSION: String(env.MCP_PROTOCOL_VERSION || '2025-06-18'),
166	    MCP_ACCEPT_HEADERS: parseStringArray(env.MCP_ACCEPT_HEADERS),
167	
168	    // Auth Strategy
169	    AUTH_STRATEGY: authStrategy,
170	    AUTH_ENABLED: authStrategy === 'oauth' || parseBoolean(env.AUTH_ENABLED),
171	    AUTH_REQUIRE_RS: parseBoolean(env.AUTH_REQUIRE_RS),
172	    AUTH_ALLOW_DIRECT_BEARER: parseBoolean(env.AUTH_ALLOW_DIRECT_BEARER),
173	    AUTH_RESOURCE_URI: env.AUTH_RESOURCE_URI as string | undefined,
174	    AUTH_DISCOVERY_URL: env.AUTH_DISCOVERY_URL as string | undefined,
175	
176	    // API Key auth
177	    API_KEY: env.API_KEY as string | undefined,
178	    API_KEY_HEADER: String(env.API_KEY_HEADER || 'x-api-key'),
179	
180	    // Bearer token auth
181	    BEARER_TOKEN: env.BEARER_TOKEN as string | undefined,
182	
183	    // Custom headers
184	    CUSTOM_HEADERS: env.CUSTOM_HEADERS as string | undefined,
185	
186	    // OAuth - use Spotify credentials as fallback
187	    OAUTH_CLIENT_ID: oauthClientId?.trim(),
188	    OAUTH_CLIENT_SECRET: oauthClientSecret?.trim(),
189	    OAUTH_SCOPES: spotifyScopes,
190	    OAUTH_AUTHORIZATION_URL: String(
191	      env.OAUTH_AUTHORIZATION_URL || 'https://accounts.spotify.com/authorize',
192	    ),
193	    OAUTH_TOKEN_URL: String(
194	      env.OAUTH_TOKEN_URL || 'https://accounts.spotify.com/api/token',
195	    ),
196	    OAUTH_REVOCATION_URL: env.OAUTH_REVOCATION_URL as string | undefined,
197	    OAUTH_REDIRECT_URI: String(env.OAUTH_REDIRECT_URI || 'alice://oauth/callback'),
198	    OAUTH_REDIRECT_ALLOWLIST: parseStringArray(env.OAUTH_REDIRECT_ALLOWLIST),
199	    OAUTH_REDIRECT_ALLOW_ALL: parseBoolean(env.OAUTH_REDIRECT_ALLOW_ALL),
200	    OAUTH_EXTRA_AUTH_PARAMS: env.OAUTH_EXTRA_AUTH_PARAMS as string | undefined,
201	
202	    // Provider-specific (for template compatibility)
203	    PROVIDER_CLIENT_ID: (env.SPOTIFY_CLIENT_ID as string | undefined)?.trim(),
204	    PROVIDER_CLIENT_SECRET: (env.SPOTIFY_CLIENT_SECRET as string | undefined)?.trim(),
205	    PROVIDER_API_URL: String(env.SPOTIFY_API_URL || 'https://api.spotify.com/v1'),
206	    PROVIDER_ACCOUNTS_URL: String(
207	      env.SPOTIFY_ACCOUNTS_URL || 'https://accounts.spotify.com',
208	    ),
209	
210	    // Spotify-specific
211	    SPOTIFY_CLIENT_ID: (env.SPOTIFY_CLIENT_ID as string | undefined)?.trim(),
212	    SPOTIFY_CLIENT_SECRET: (env.SPOTIFY_CLIENT_SECRET as string | undefined)?.trim(),
213	    SPOTIFY_API_URL: String(env.SPOTIFY_API_URL || 'https://api.spotify.com/v1'),
214	    SPOTIFY_ACCOUNTS_URL: String(
215	      env.SPOTIFY_ACCOUNTS_URL || 'https://accounts.spotify.com',
216	    ),
217	    SPOTIFY_SCOPES: spotifyScopes,
218	    SPOTIFY_INCLUDE_JSON_IN_CONTENT: parseBoolean(env.SPOTIFY_INCLUDE_JSON_IN_CONTENT),
219	
220	    RS_TOKENS_FILE: env.RS_TOKENS_FILE as string | undefined,
221	    RS_TOKENS_ENC_KEY: env.RS_TOKENS_ENC_KEY as string | undefined,
222	
223	    RPS_LIMIT: parseNumber(env.RPS_LIMIT, 10),
224	    CONCURRENCY_LIMIT: parseNumber(env.CONCURRENCY_LIMIT, 5),
225	
226	    LOG_LEVEL: (env.LOG_LEVEL as UnifiedConfig['LOG_LEVEL']) || 'info',
227	  };
228	}
229	
230	export function resolveConfig(): UnifiedConfig {
231	  return parseConfig(process.env as Record<string, unknown>);
232	}
