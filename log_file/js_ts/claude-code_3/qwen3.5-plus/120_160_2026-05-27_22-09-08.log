233	  private getMimeType(filePath: string): string {
234	    const ext = path.extname(filePath).toLowerCase();
235	    const mimeTypes: Record<string, string> = {
236	      ".jpg": "image/jpeg",
237	      ".jpeg": "image/jpeg",
238	      ".png": "image/png",
239	      ".gif": "image/gif",
240	      ".webp": "image/webp",
241	    };
242	    return mimeTypes[ext] || "image/jpeg";
