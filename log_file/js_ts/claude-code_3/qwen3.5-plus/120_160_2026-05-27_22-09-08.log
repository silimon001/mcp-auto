8	async function start() {
9	  const server = new FastMCP({
10	    name: `${pkg.author}/${pkg.name}`,
11	    version: pkg.version,
12	  })
13	  // Register all tools & resources
14	  for (const tool of Object.values(tools)) {
15	    if (!tool.isEnabled) {
16	      continue
17	    }
18	    if (tool.isResource) {
19	      // Register as resource
20	      server.addResource({
21	        uri: `resource://${tool.name}`,
22	        name: tool.description,
23	        mimeType: 'text/plain',
24	        load: () => cli.runTool(tool, []).then(text => ({ text })),
25	      })
26	    } else {
27	      // Register as tool with enhanced logging
28	      server.addTool({
29	        annotations: {
30	          openWorldHint: false, // This tool doesn't interact with external systems
31	          readOnlyHint: tool.isReadOnly,
32	          title: tool.name,
33	        },
34	        name: tool.name,
35	        description: tool.description,
36	        parameters: tool.schema,
37	        execute: (args) => cli.runTool(tool, args),
38	      })
39	    }
40	  }
41	
42	  if (env.TRANSPORT === 'http') {
43	    await server.start({
44	      transportType: 'httpStream',
45	      httpStream: {
46	        port: env.PORT,
47	      },
48	    })
49	  } else {
50	    await server.start({
51	      transportType: 'stdio',
52	    })
53	
54	    logger.log('Started new server', { transport: env.TRANSPORT })
55	  }
56	}
