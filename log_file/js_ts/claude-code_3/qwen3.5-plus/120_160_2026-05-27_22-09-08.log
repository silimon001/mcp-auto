1	#!/usr/bin/env node
2	
3	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
4	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
5	import { StreamableHTTPServerTransport } from "@modelcontextprotocol/sdk/server/streamableHttp.js";
6	import { createServer } from "http";
7	import { Command } from "commander";
8	import { ImageGenerator } from "./services/image-generator.js";
9	import { createGenerateImageTool } from "./tools/generate-image.js";
10	import { createEditImageTool } from "./tools/edit-image.js";
11	
12	/** Default HTTP server port */
13	const DEFAULT_PORT = 5000;
14	
15	// Parse CLI arguments using commander
16	const program = new Command()
17	  .option("--transport <stdio|http>", "transport type", "stdio")
18	  .option("--port <number>", "port for HTTP transport", DEFAULT_PORT.toString())
19	  .option("--apiKey <key>", "Google API key for image generation")
20	  .option("--model <pro|normal>", "Fixed model to use for all operations (optional)")
21	  .allowUnknownOption()
22	  .parse(process.argv);
23	
24	const cliOptions = program.opts<{
25	  transport: string;
26	  port: string;
27	  apiKey?: string;
28	  model?: "pro" | "normal";
29	}>();
30	
31	// Validate transport option
32	const allowedTransports = ["stdio", "http"];
33	if (!allowedTransports.includes(cliOptions.transport)) {
34	  console.error(
35	    `Invalid --transport value: '${cliOptions.transport}'. Must be one of: stdio, http.`
36	  );
37	  process.exit(1);
38	}
39	
40	// Transport configuration
41	const TRANSPORT_TYPE = (cliOptions.transport || "stdio") as "stdio" | "http";
42	
43	// Disallow incompatible flags based on transport
44	const passedPortFlag = process.argv.includes("--port");
45	
46	if (TRANSPORT_TYPE === "stdio" && passedPortFlag) {
47	  console.error("The --port flag is not allowed when using --transport stdio.");
48	  process.exit(1);
49	}
50	
51	// HTTP port configuration
52	const CLI_PORT = (() => {
53	  const parsed = parseInt(cliOptions.port, 10);
54	  return isNaN(parsed) ? undefined : parsed;
55	})();
56	
57	// Get API key from CLI or environment
58	const apiKey = cliOptions.apiKey || process.env.GOOGLE_API_KEY;
59	
60	// Get fixed model from CLI if provided
61	const fixedModel = cliOptions.model;
62	
63	// Function to create a new server instance with all tools registered
64	function createServerInstance() {
65	  const generator = new ImageGenerator(apiKey);
66	  const server = new McpServer({
67	    name: "nanobanana-mcp",
68	    version: "1.1.0",
69	  });
70	
71	  // Create and register tools
72	  const generateImageTool = createGenerateImageTool(generator, fixedModel);
73	  const editImageTool = createEditImageTool(generator, fixedModel);
74	
75	  server.registerTool(
76	    generateImageTool.name,
77	    {
78	      title: "Generate Image",
79	      description: generateImageTool.description,
80	      inputSchema: generateImageTool.inputSchema.shape,
81	      outputSchema: undefined,
82	    },
83	    generateImageTool.handler
84	  );
85	
86	  server.registerTool(
87	    editImageTool.name,
88	    {
89	      title: "Edit Image",
90	      description: editImageTool.description,
91	      inputSchema: editImageTool.inputSchema.shape,
92	      outputSchema: undefined,
93	    },
94	    editImageTool.handler
95	  );
96	
97	  return server;
98	}
99	
100	async function main() {
101	  const transportType = TRANSPORT_TYPE;
102	
103	  if (transportType === "http") {
104	    // Get initial port from environment or use default
105	    const initialPort = CLI_PORT ?? DEFAULT_PORT;
106	    let actualPort = initialPort;
107	
108	    // Set up HTTP server
109	    const httpServer = createServer(async (req, res) => {
110	      const pathname = new URL(req.url || "/", "http://localhost").pathname;
111	
112	      try {
113	        if (pathname === "/mcp" && req.method === "POST") {
114	          // Create new server instance for each request
115	          const requestServer = createServerInstance();
116	
117	          // Create a new transport for each request to prevent request ID collisions
118	          const transport = new StreamableHTTPServerTransport({
119	            sessionIdGenerator: undefined,
120	            enableJsonResponse: true,
121	          });
122	
123	          res.on("close", () => {
124	            transport.close();
125	            requestServer.close();
126	          });
127	
128	          await requestServer.connect(transport);
129	          await transport.handleRequest(req, res);
130	        } else {
131	          res.writeHead(404, { "Content-Type": "application/json" });
132	          res.end(JSON.stringify({ error: "Not found", status: 404 }));
133	        }
134	      } catch (error) {
135	        console.error("Error handling request:", error);
136	        if (!res.headersSent) {
137	          res.writeHead(500, { "Content-Type": "application/json" });
138	          res.end(JSON.stringify({ error: "Internal Server Error", status: 500 }));
139	        }
140	      }
141	    });
142	
143	    // Function to attempt server listen with port fallback
144	    const startServer = (port: number, maxAttempts = 10) => {
145	      httpServer.once("error", (err: NodeJS.ErrnoException) => {
146	        if (err.code === "EADDRINUSE" && port < initialPort + maxAttempts) {
147	          console.warn(`Port ${port} is in use, trying port ${port + 1}...`);
148	          startServer(port + 1, maxAttempts);
149	        } else {
150	          console.error(`Failed to start server: ${err.message}`);
151	          process.exit(1);
152	        }
153	      });
154	
155	      httpServer.listen(port, () => {
156	        actualPort = port;
157	        console.error(
158	          `Nanobanana MCP Server running on ${transportType.toUpperCase()} at http://localhost:${actualPort}/mcp`
159	        );
160	      });
161	    };
162	
163	    // Start the server with initial port
164	    startServer(initialPort);
165	  } else {
166	    // Stdio transport
167	    const server = createServerInstance();
168	    const transport = new StdioServerTransport();
169	    await server.connect(transport);
170	    console.error(`Nanobanana MCP Server running on stdio`);
171	  }
172	}
173	
174	main().catch((error) => {
175	  console.error("Fatal error in main():", error);
176	  process.exit(1);
177	});
178	

