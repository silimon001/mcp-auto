5	/**
6	 * Supported aspect ratios for image generation
7	 */
8	export type AspectRatio = "1:1" | "2:3" | "3:2" | "3:4" | "4:3" | "4:5" | "5:4" | "9:16" | "16:9" | "21:9";
9	
10	/**
11	 * Service for generating and editing images using Google Gemini API
12	 */
13	export class ImageGenerator {
14	  private ai: GoogleGenAI;
15	
16	  constructor(apiKey?: string) {
17	    const key = apiKey || process.env.GOOGLE_API_KEY;
18	    if (!key) {
19	      throw new Error(
20	        "Google API key is required. Set GOOGLE_API_KEY environment variable or provide it in constructor."
21	      );
22	    }
23	    this.ai = new GoogleGenAI({ apiKey: key });
24	  }
25	
26	  /**
27	   * Generates an image based on a text prompt
28	   * @param prompt - Text description of the image to generate
29	   * @param outputPath - Optional path where the generated image will be saved
30	   * @param model - Model to use ('pro' or 'normal', default: 'pro')
31	   * @param referenceImagesPaths - Optional array of reference image paths
32	   * @param aspectRatio - Optional aspect ratio for the image (default: '16:9')
33	   * @returns Path to the generated image or base64 string if no output path provided
34	   */
35	  async generateImage(
36	    prompt: string,
37	    outputPath: string | undefined,
38	    model: "pro" | "normal" = "pro",
39	    referenceImagesPaths?: string[],
40	    aspectRatio: AspectRatio = "16:9"
41	  ): Promise<string> {
42	    const modelName =
43	      model === "pro" ? "gemini-3-pro-image-preview" : "gemini-2.5-flash-image";
44	
45	    // Build contents array
46	    const contents: any[] = [{ text: prompt }];
47	
48	    // Add reference images if provided
49	    if (referenceImagesPaths && referenceImagesPaths.length > 0) {
50	      for (const imagePath of referenceImagesPaths) {
51	        const imageData = this.readImageAsBase64(imagePath);
52	        const mimeType = this.getMimeType(imagePath);
53	        contents.push({
54	          inlineData: {
55	            mimeType,
56	            data: imageData,
57	          },
58	        });
59	      }
60	    }
61	
62	    const response = await this.ai.models.generateContent({
63	      model: modelName,
64	      contents: contents,
65	      config: {
66	        responseModalities: ["TEXT", "IMAGE"],
67	        imageConfig: { aspectRatio },
68	      },
69	    });
70	
71	    // Extract and save the image
