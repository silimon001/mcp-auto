79	                guests: { type: 'number', description: 'Number of guests', default: 1 },
80	                budget: { type: 'number', description: 'Maximum budget per night in USD', optional: true }
81	              },
82	              required: ['city', 'checkIn', 'checkOut']
83	            }
84	          },
85	          {
86	            name: 'get_exchange_rate',
87	            description: 'Get current currency exchange rates',
88	            inputSchema: {
89	              type: 'object',
