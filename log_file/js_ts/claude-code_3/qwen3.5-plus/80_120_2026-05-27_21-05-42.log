1	import { StreamableHTTPServerTransport } from '@modelcontextprotocol/sdk/server/streamableHttp.js';
2	import { randomUUID } from 'crypto';
3	import express, { Request, Response } from 'express';
4	import { createMcpServer, CreateMcpServerParams } from '../utils/create-mcp-server';
5	import { InMemoryEventStore } from '@modelcontextprotocol/sdk/examples/shared/inMemoryEventStore.js';
6	import { addToUserSessions, getUserSessions, removeFromUserSessions } from '../utils/user-sessions';
7	
8	export const streamableHttpRouter = express.Router();
9	
10	const transports: Map<string, StreamableHTTPServerTransport> = new Map<
11	  string,
12	  StreamableHTTPServerTransport
13	>();
14	
15	streamableHttpRouter.post('/', async (req, res) => {
16	  const sessionId = req.headers['mcp-session-id'] as string | undefined;
17	  const mode = req.query.mode as CreateMcpServerParams['mode'];
18	
19	  let transport: StreamableHTTPServerTransport;
20	
21	  try {
22	    if (sessionId && transports.has(sessionId)) {
23	      // Reuse existing transport
24	      transport = transports.get(sessionId)!;
25	    } else if (!sessionId) {
26	      // New initialization request
27	      const eventStore = new InMemoryEventStore();
28	
29	      transport = new StreamableHTTPServerTransport({
30	        sessionIdGenerator: () => randomUUID(),
31	        eventStore, // Enable resumability
32	        onsessioninitialized: sessionId => {
33	          console.log(`⚡️ Session initialized with ID: ${sessionId}`);
34	
35	          // Store the transport by session ID when session is initialized
36	          // This avoids race conditions where requests might come in before the session is stored
37	          transports.set(sessionId, transport);
38	
39	          const userId = req.userId;
40	          const chatId = req.headers['x-chat-id'] as string | undefined;
41	
42	          addToUserSessions({ userId, chatId, sessionId });
43	        },
44	      });
45	
46	      transport.onclose = () => {
47	        if (transport.sessionId) {
48	          console.log(
49	            `Transport closed for session ${transport.sessionId}, removing from transports map`
50	          );
51	          transports.delete(transport.sessionId);
52	        }
53	      };
54	
55	      const { mcpServer } = await createMcpServer({
56	        userAccessToken: req.token!,
57	        apps: req.query.apps
58	          ? (req.query.apps as string).split(',').map(app => app.trim())
59	          : undefined,
60	        mode,
61	      });
62	
63	      // Connect the transport to the MCP server BEFORE handling the request
64	      // so responses can flow back through the same transport
65	      await mcpServer.connect(transport);
66	
67	      await transport.handleRequest(req, res, req.body);
68	      return;
69	    } else {
70	      res.status(400).json({
71	        jsonrpc: '2.0',
72	        error: {
73	          code: -32000,
74	          message: 'Bad Request: No valid session ID provided',
75	        },
76	        id: null,
77	      });
78	      return;
79	    }
80	
81	    console.log(`Connected to MCP server`);
82	    // Handle the request with existing transport - no need to reconnect
83	    // The existing transport is already connected to the server
84	    await transport.handleRequest(req, res, req.body);
85	  } catch (error) {
86	    console.error('Error handling MCP request:', error);
87	    if (!res.headersSent) {
88	      res.status(500).json({
89	        jsonrpc: '2.0',
90	        error: {
91	          code: -32603,
92	          message: 'Internal server error',
93	        },
94	        id: null,
95	      });
96	    }
97	  }
98	});
99	
100	// Handle GET requests for SSE streams (using built-in support from StreamableHTTP)
101	streamableHttpRouter.get('/', async (req: Request, res: Response) => {
102	  const sessionId = req.headers['mcp-session-id'] as string | undefined;
103	  if (!sessionId) {
104	    res.status(400).json({
105	      jsonrpc: '2.0',
106	      error: {
107	        code: -32000,
108	        message: 'Bad Request: No valid session ID provided',
109	      },
110	      id: req?.body?.id,
111	    });
112	    return;
113	  }
114	
115	  try {
116	    // Check for Last-Event-ID header for resumability
117	    const lastEventId = req.headers['last-event-id'] as string | undefined;
118	    if (lastEventId) {
119	      console.log(`Client reconnecting with Last-Event-ID: ${lastEventId}`);
120	    } else {
121	      console.log(`Establishing new SSE stream for session ${sessionId}`);
122	    }
123	
124	    const transport = transports.get(sessionId);
125	    await transport!.handleRequest(req, res);
126	  } catch (error) {
127	    console.error('Error handling MCP GET request:', error);
128	    if (!res.headersSent) {
129	      res.status(500).send('Error processing MCP GET request');
130	    }
131	  }
132	});
133	
134	// Handle DELETE requests for session termination (according to MCP spec)
135	streamableHttpRouter.delete('/', async (req: Request, res: Response) => {
136	  const sessionId = req.headers['mcp-session-id'] as string | undefined;
137	  if (!sessionId || !transports.has(sessionId)) {
138	    res.status(400).json({
139	      jsonrpc: '2.0',
140	      error: {
141	        code: -32000,
142	        message: 'Bad Request: No valid session ID provided',
143	      },
144	      id: req?.body?.id,
145	    });
146	    return;
147	  }
148	
149	  console.error(`Received session termination request for session ${sessionId}`);
150	
