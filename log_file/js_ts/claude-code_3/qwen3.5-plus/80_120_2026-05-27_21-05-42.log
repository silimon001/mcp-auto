91	                from: { type: 'string', description: 'Source currency code (e.g., USD)' },
92	                to: { type: 'string', description: 'Target currency code (e.g., EUR)' },
93	                amount: { type: 'number', description: 'Amount to convert', default: 1 }
94	              },
95	              required: ['from', 'to']
96	            }
97	          },
98	          {
99	            name: 'get_weather_forecast',
100	            description: 'Get weather forecast for travel dates',
101	            inputSchema: {
102	              type: 'object',
103	              properties: {
104	                city: { type: 'string', description: 'City name' },
105	                country: { type: 'string', description: 'Country name' },
