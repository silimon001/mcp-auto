1	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
2	import { createMcpServer } from "../server/server.js";
3	import { logger } from "../utils/logger.js";
4	export async function runStdioServer() {
5	    const server = createMcpServer();
6	    const transport = new StdioServerTransport();
7	    logger.info("Starting MCP stdio server...");
8	    await server.connect(transport);
9	    logger.info("MCP stdio server started successfully");
10	    let isShuttingDown = false;
11	    const shutdown = async () => {
12	        if (isShuttingDown)
13	            return;
14	        isShuttingDown = true;
15	        logger.info("Gracefully shutting down MCP stdio server...");
16	        try {
17	            await transport.close();
18	        }
19	        catch (error) {
20	            logger.error("Error closing transport:", error);
21	        }
22	        logger.info("MCP stdio server shut down completed.");
23	        process.exit(0);
24	    };
25	    // Handle termination signals
26	    process.on("SIGINT", shutdown);
27	    process.on("SIGTERM", shutdown);
28	    process.on("uncaughtException", (err) => {
29	        logger.error("Uncaught exception:", err);
30	        shutdown();
31	    });
32	    process.on("unhandledRejection", (reason, promise) => {
33	        logger.error("Unhandled Rejection at:", promise, "reason:", reason);
34	        shutdown();
35	    });
36	}
37	export async function startStdioServer() {
38	    try {
39	        await runStdioServer();
40	    }
41	    catch (error) {
42	        logger.error("Failed to start stdio server:", error);
43	        process.exit(1);
44	    }
45	}
