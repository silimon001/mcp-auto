1	#!/usr/bin/env node
2	
3	import { axiosInstanceManager } from '@growi/sdk-typescript';
4	import { FastMCP } from 'fastmcp';
5	import config from './config/default.js';
6	import type { GrowiAppConfig } from './config/types.js';
7	
8	const server = new FastMCP({
9	  name: 'growi-mcp-server',
10	  version: '1.0.0',
11	});
12	
13	/**
14	 * Initialize Axios instances for all GROWI apps.
15	 */
16	const setupAxiosInstance = async (apps: Map<string, GrowiAppConfig>): Promise<void> => {
17	  Array.from(apps.values()).map((app) => {
18	    axiosInstanceManager.addAxiosInstance({
19	      appName: app.name,
20	      baseURL: app.baseUrl,
21	      token: app.apiToken,
22	    });
23	  });
24	};
25	
26	async function main(): Promise<void> {
27	  setupAxiosInstance(config.growi.apps);
28	
29	  try {
30	    // Loaders are imported dynamically so that the module will be garbage collected
31	    const { loadTools } = await import('./tools/index.js');
32	    const { loadResources } = await import('./resources/index.js');
33	    const { loadPrompts } = await import('./prompts/index.js');
34	    await loadTools(server);
35	    await loadResources(server);
36	    await loadPrompts(server);
37	
38	    await server.start({
39	      transportType: 'stdio',
40	    });
41	  } catch (error) {
42	    console.error('Failed to start server:', error instanceof Error ? error.message : String(error));
43	    process.exit(1);
44	  }
45	}
46	
47	main().catch((error) => {
48	  console.error('Unhandled error:', error instanceof Error ? error.message : String(error));
49	  process.exit(1);
50	});
