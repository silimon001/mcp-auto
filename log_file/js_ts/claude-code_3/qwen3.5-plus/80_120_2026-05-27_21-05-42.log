22			server,
23			credentials: {
24				appKey: blueskyToken,
25				identifier: blueskyIdentifier,
26				...(serviceUrl && { serviceUrl }),
27			},
28			mode: "local",
29		});
30	}
31	
32	main().catch((error) => {
