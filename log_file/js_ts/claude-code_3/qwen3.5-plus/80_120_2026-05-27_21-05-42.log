332	export function createProxyApiTool(integrations: Integration[]): ExtendedTool {
333	  const integrationNames = integrations.map((i) => i.type);
334	
335	  return {
336	    name: "CALL_API_REQUEST",
337	    description: `Call an API if no tool is available for an integration that matches the user's request. Always follow the following guidelines:
338	- Before using this tool, respond with a plan that outlines the requests that you will need to make to fulfill the user's goal.
339	- If you find that you need to make multiple requests to fulfill the user's goal, you can use this tool multiple times.
340	- If there are errors, don't give up! Try to fix them by using the response to look at the error and adjust the request body accordingly.`,
341	    integrationName: "general",
342	    integrationId: undefined,
343	    requiredFields: ["integration", "url", "httpMethod"],
344	    isOpenApiTool: false,
345	    inputSchema: {
346	      type: "object",
347	      properties: {
348	        integration: {
349	          type: "string",
350	          description: "The name of the integration to use for this request.",
351	          enum: integrationNames,
352	        },
353	        url: {
354	          type: "string",
355	          description:
356	            "Use the full URL when specifying the `url` parameter, including the base URL. It should NEVER be a relative path - always a full URL.",
357	        },
358	        httpMethod: {
359	          type: "string",
360	          enum: ["GET", "POST", "PUT", "PATCH", "DELETE"],
361	        },
362	        queryParams: {
363	          type: "object",
364	          additionalProperties: true,
365	        },
366	        headers: {
367	          type: "object",
368	          additionalProperties: {
369	            type: "string",
370	          },
371	          description: "Do not include any Authorization headers.",
372	        },
373	        body: {
374	          type: "object",
375	          additionalProperties: true,
376	        },
377	      },
378	      required: ["integration", "url", "httpMethod"],
379	      additionalProperties: false,
380	    },
381	  };
382	}
