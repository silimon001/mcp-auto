227	    return {
228	      content: [
229	        {
230	          type: 'text',
231	          text: JSON.stringify(budget, null, 2)
232	        }
233	      ]
234	    };
235	  }
236	
237	  private async calculateBudget(params: any): Promise<any> {
238	    // This would combine flight, accommodation, and other costs
239	    // Implementation depends on your specific requirements
240	    return {
241	      totalBudget: 2500,
242	      breakdown: {
243	        flights: 800,
244	        accommodation: 1200,
245	        food: 350,
246	        activities: 150
247	      },
248	      currency: 'USD'
249	    };
250	  }
251	
252	  async run() {
253	    const transport = new StdioServerTransport();
254	    await this.server.connect(transport);
255	    console.error('Travel MCP server running on stdio');
256	  }
257	}
258	
