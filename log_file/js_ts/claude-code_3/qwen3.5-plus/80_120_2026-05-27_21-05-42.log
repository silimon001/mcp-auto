1	import { CLARITY_API_TOKEN } from "./constants.js";
2	
3	// Get configuration from environment variables or command-line arguments
4	export const getConfigValue = (name: string, fallback?: string): string | undefined => {
5	  // Check command line args first (format: --name=value or --name value)
6	  const argIndex = process.argv.findIndex((arg) => arg.startsWith(`--${name}`));
7	  if (argIndex !== -1) {
8	    const arg = process.argv[argIndex];
9	    if (arg.includes("=")) {
10	      return arg.split("=")[1];
11	    }
12	    // --name value format: return next argument if it exists and isn't another flag
13	    const nextArgIndex = argIndex + 1;
14	    if (nextArgIndex < process.argv.length) {
15	      const nextArg = process.argv[nextArgIndex];
16	      if (nextArg && !nextArg.startsWith("--")) {
17	        return nextArg;
18	      }
19	    }
20	  }
21	
22	  // Then check environment variables
23	  if (process.env[name] || process.env[name.toUpperCase()]) {
24	    return process.env[name] || process.env[name.toUpperCase()];
25	  }
26	
27	  return fallback;
28	};
29	
30	export const tryAsync = async (input: string | URL | Request, init?: RequestInit | undefined): Promise<any> => {
31	  // Use provided token or fallback to environment/command-line variables
32	  // Check if we have the necessary credentials
33	  if (!CLARITY_API_TOKEN) {
34	    return {
35	      content: [
36	        {
37	          type: "text",
38	          text: "No Clarity API token provided. Please provide a token via the 'token' parameter, CLARITY_API_TOKEN environment variable, or --clarity_api_token command-line argument.",
39	        },
40	      ],
41	    };
42	  }
43	
44	  try {
45	    const response = await fetch(input, init);
46	
47	    if (!response.ok) {
48	      throw new Error(`Endpoint request failed with status: ${input} ${response.status}`);
49	    }
50	
51	    const data = await response.json();
52	
53	    return {
54	      content: [
55	        {
56	          type: "text",
57	          text: JSON.stringify(data, null, 2),
58	        },
59	      ],
60	    };
61	  } catch (error) {
62	    console.error("Error during fetch:", error);
63	    return {
64	      content: [
65	        {
66	          type: "text",
67	          text: "An error occurred while fetching the data.",
68	        },
69	      ],
70	    };
71	  }
72	};
