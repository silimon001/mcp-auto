1	import { z } from "zod";
2	import axios from "axios";
3	
4	// RapidAPI configuration
5	const RAPIDAPI_KEY = process.env.RAPIDAPI_KEY;
6	const RAPIDAPI_HOST = "twitter154.p.rapidapi.com";
7	
8	/**
9	 * Registers Twitter search tools with the MCP server
10	 * @param {McpServer} server - The MCP server instance
11	 */
12	export function registerTwitterTools(server) {
13	  // Create a reusable search function
14	  const performTwitterSearch = async (query, section, limit) => {
15	    // Check for API key
16	    if (!RAPIDAPI_KEY) {
17	      throw new Error("RAPIDAPI_KEY environment variable is not set");
18	    }
19	    
20	    // Log the query for debugging
21	    console.error(`TWITTER SEARCH: ${query}`);
22	    
23	    // Track all fetched tweets
24	    let allTweets = [];
25	    let continuationToken = null;
26	    
27	    // RapidAPI has a max of 20 per request, so we'll need to paginate
28	    const maxPerRequest = 20;
29	    const requestsNeeded = Math.ceil(limit / maxPerRequest);
30	    
31	    // Make requests until we hit the limit or run out of results
32	    for (let i = 0; i < requestsNeeded; i++) {
33	      // Build the query parameters
34	      const params = new URLSearchParams({
35	        query: query,
36	        section: section,
37	        limit: Math.min(maxPerRequest, limit - allTweets.length).toString()
38	      });
39	      
40	      // Add continuation token if available
41	      if (continuationToken) {
42	        params.append('continuation_token', continuationToken);
43	      }
44	      
45	      // Make the API request
46	      const response = await axios({
47	        method: 'GET',
48	        url: `https://twitter154.p.rapidapi.com/search/search?${params.toString()}`,
49	        headers: {
50	          'x-rapidapi-key': RAPIDAPI_KEY,
51	          'x-rapidapi-host': RAPIDAPI_HOST
52	        }
53	      });
54	      
55	      // Extract tweets and continuation token
56	      const newTweets = response.data.results || [];
57	      allTweets = [...allTweets, ...newTweets];
58	      
59	      // Store continuation token for next request
60	      continuationToken = response.data.continuation_token;
61	      
62	      // Stop if we don't have a continuation token or reached our limit
63	      if (!continuationToken || allTweets.length >= limit) {
64	        break;
65	      }
66	    }
67	    
68	    // Return only up to the requested limit
69	    return allTweets.slice(0, limit);
70	  };
71	
72	  // Add Twitter search tool
73	  server.tool("searchTwitter",
74	    { 
75	      query: z.string().min(1, "Search query is required"),
76	      section: z.enum(["latest", "top"]).optional().default("latest"),
77	      limit: z.number().int().positive().optional().default(20)
78	    },
79	    async ({ query, section, limit }) => {
80	      try {
81	        // Use the search function with the query directly
82	        const tweets = await performTwitterSearch(query, section, limit);
83	        
84	        // Format the response
85	        return {
86	          content: [{ 
87	            type: "text", 
88	            text: formatTwitterResults(query, tweets, section)
89	          }]
90	        };
91	      } catch (error) {
92	        console.error('Error searching Twitter:', error);
93	        return {
94	          content: [{ 
95	            type: "text", 
96	            text: `Error searching Twitter: ${error.message}`
97	          }]
98	        };
99	      }
100	    }
101	  );
102	}
103	
104	/**
105	 * Format Twitter search results into a professional, clean response
106	 * @param {string} query - The search query
107	 * @param {Array} tweets - Array of tweet objects
108	 * @param {string} section - The section searched (latest or top)
109	 * @returns {string} Formatted results
110	 */
111	function formatTwitterResults(query, tweets, section) {
112	  if (!tweets || tweets.length === 0) {
113	    return `No tweets found for query: ${query}`;
114	  }
115	  
116	  let output = [];
117	  
118	
119	  
120	  tweets.forEach((tweet, index) => {
121	    // Create clear separation between tweets
122	    output.push(`## [${index + 1}] Tweet by @${tweet.user.username}`);
123	    
124	    // User information
125	    let userInfo = `**User:** ${tweet.user.name} (@${tweet.user.username})`;
126	    if (tweet.user.is_blue_verified) {
127	      userInfo += ` [Verified]`;
128	    } else if (tweet.user.is_verified) {
129	      userInfo += ` [Verified]`;
130	    }
131	    output.push(userInfo);
132	    
133	    // User stats if available
134	    if (tweet.user) {
135	      const userStats = [];
136	      if (tweet.user.follower_count !== undefined) userStats.push(`${tweet.user.follower_count} followers`);
137	      if (tweet.user.following_count !== undefined) userStats.push(`${tweet.user.following_count} following`);
138	      if (userStats.length > 0) {
139	        output.push(`**Account stats:** ${userStats.join(', ')}`);
140	      }
141	    }
142	    
143	    // Tweet content
144	    output.push(`\n**Content:** ${tweet.text}\n`);
145	    
146	    // Engagement metrics
147	    let metrics = [];
148	    metrics.push(`${tweet.favorite_count} likes`);
149	    metrics.push(`${tweet.retweet_count} retweets`);
150	    metrics.push(`${tweet.reply_count} replies`);
151	    
152	    // Add quotes and bookmarks if available
153	    if (tweet.quote_count) metrics.push(`${tweet.quote_count} quotes`);
154	    if (tweet.bookmark_count) metrics.push(`${tweet.bookmark_count} bookmarks`);
155	    
156	    // Add view count if available
157	    if (tweet.views) metrics.push(`${tweet.views} views`);
158	    
159	    output.push(`**Engagement:** ${metrics.join(' | ')}`);
160	    
161	    // Creation date - fix the Invalid Date issue
162	    try {
163	      // Try parsing the date properly
164	      const date = new Date(tweet.created_at || tweet.creation_date);
165	      const formattedDate = !isNaN(date.getTime()) ? 
166	        `${date.toLocaleDateString('en-GB')} ${date.toLocaleTimeString('en-GB')}` : 
167	        'Date unavailable';
168	      output.push(`**Posted:** ${formattedDate}`);
169	    } catch (e) {
170	      output.push(`**Posted:** Date format error`);
171	    }
172	    
173	   
174	    
175	    // Add reply info if it's a reply
176	    if (tweet.in_reply_to_status_id_str) {
177	      output.push(`**Reply to:** https://twitter.com/status/${tweet.in_reply_to_status_id_str}`);
178	    }
179	    
180	    // Add media if available
181	    if (tweet.media && tweet.media.length > 0) {
182	      output.push(`**Media:** ${tweet.media.length} attachment(s)`);
183	      tweet.media.forEach(media => {
184	        output.push(`  - ${media.media_url_https || media.media_url}`);
185	      });
186	    }
187	    
188	    // Add video info if available
189	    if ((tweet.extended_entities && 
190	         tweet.extended_entities.media && 
191	         tweet.extended_entities.media.some(m => m.type === "video" || m.type === "animated_gif")) || 
192	        tweet.video_url) {
193	      output.push(`**Video:** ${tweet.video_url || "Multiple formats available"}`);
194	    }
195	    
196	    // Add tweet URL - construct a proper URL
197	    const tweetId = tweet.id_str || tweet.tweet_id;
198	    if (tweetId && tweet.user && tweet.user.username) {
199	      output.push(`**URL:** https://twitter.com/${tweet.user.username}/status/${tweetId}`);
200	    } else {
201	      output.push(`**URL:** Unable to construct URL (missing id or username)`);
202	    }
203	    
204	    
205	    
206	    // Add separator between tweets
207	    output.push('\n---\n');
208	  });
209	  
210	 
211	  
212	  return output.join('\n');
213	} 

