6	async function main() {
7		const blueskyToken = process.env.BLUESKY_APP_KEY;
8		const blueskyIdentifier = process.env.BLUESKY_IDENTIFIER;
9		const serviceUrl = process.env.BLUESKY_SERVICE_URL;
10	
11		if (!blueskyToken || !blueskyIdentifier) {
12			console.error("BLUESKY_APP_KEY and BLUESKY_IDENTIFIER must be set");
