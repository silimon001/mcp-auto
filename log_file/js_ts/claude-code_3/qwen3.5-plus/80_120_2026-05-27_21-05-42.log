50	  private setupToolHandlers() {
51	    // List available tools
52	    this.server.setRequestHandler(ListToolsRequestSchema, async () => {
53	      return {
54	        tools: [
55	          {
56	            name: 'search_flights',
57	            description: 'Search for flight prices and schedules',
58	            inputSchema: {
59	              type: 'object',
60	              properties: {
61	                origin: { type: 'string', description: 'Origin city/airport code' },
62	                destination: { type: 'string', description: 'Destination city/airport code' },
63	                departDate: { type: 'string', description: 'Departure date (YYYY-MM-DD)' },
64	                returnDate: { type: 'string', description: 'Return date (YYYY-MM-DD)', optional: true },
65	                passengers: { type: 'number', description: 'Number of passengers', default: 1 }
66	              },
67	              required: ['origin', 'destination', 'departDate']
68	            }
69	          },
70	          {
71	            name: 'search_accommodation',
72	            description: 'Search for hotels and accommodations',
73	            inputSchema: {
74	              type: 'object',
75	              properties: {
76	                city: { type: 'string', description: 'City name' },
77	                checkIn: { type: 'string', description: 'Check-in date (YYYY-MM-DD)' },
