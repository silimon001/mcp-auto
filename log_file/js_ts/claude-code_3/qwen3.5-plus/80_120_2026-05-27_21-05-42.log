384	export async function performProxyApiRequest(
385	  args: ProxyApiRequestToolArgs,
386	  jwt: string
387	): Promise<any> {
388	  const queryStr = args.queryParams
389	    ? `?${new URLSearchParams(
390	        Object.entries(args.queryParams).reduce((acc, [key, value]) => {
391	          acc[key] = String(value);
392	          return acc;
393	        }, {} as Record<string, string>)
394	      ).toString()}`
395	    : "";
396	
397	  const url = `${envs.PROXY_BASE_URL}/projects/${envs.PROJECT_ID}/sdk/proxy/${args.integration}`;
398	
399	  const response = await fetch(url, {
400	    method: args.httpMethod,
401	    body:
402	      args.httpMethod.toUpperCase() === "GET"
403	        ? undefined
404	        : JSON.stringify(args.body),
405	    headers: {
406	      Authorization: `Bearer ${jwt}`,
407	      "Content-Type": "application/json",
408	      "X-Paragon-Proxy-Url": `${args.url}${queryStr}`,
409	      ...(args.integration === "slack"
410	        ? { "X-Paragon-Use-Slack-Token-Type": "user" }
411	        : {}),
412	      ...args.headers,
413	    },
414	  });
415	
416	  await handleResponseErrors(response);
417	
418	  return await response.text();
419	}
