210	  }
211	
212	  private async handleGetWeatherForecast(args: any) {
213	    const result = await this.weatherService.getWeatherForecast(args);
214	    return {
215	      content: [
216	        {
217	          type: 'text',
218	          text: JSON.stringify(result, null, 2)
219	        }
220	      ]
221	    };
222	  }
223	
224	  private async handleCalculateTripBudget(args: any) {
225	    // Combine data from multiple services
