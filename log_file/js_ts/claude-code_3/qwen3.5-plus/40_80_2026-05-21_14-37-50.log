268	// Read resource implementation
269	async function handleReadResource(resourceName) {
270	  try {
271	    // Ensure database is initialized before reading resources
272	    if (!dbInitialized) {
273	      await initializeDatabase();
274	    }
275	
276	    if (resourceName === "memory://types") {
277	      const result = await pool.query("SELECT DISTINCT type FROM memories");
278	      const types = result.rows.map(row => row.type);
279	      return { content: JSON.stringify(types), mimeType: "application/json" };
280	    } else if (resourceName === "memory://tags") {
281	      const result = await pool.query("SELECT DISTINCT unnest(tags) as tag FROM memories");
282	      const tags = result.rows.map(row => row.tag);
283	      return { content: JSON.stringify(tags), mimeType: "application/json" };
284	    } else if (resourceName.startsWith("memory://type/")) {
285	      const type = resourceName.substring("memory://type/".length);
286	      const result = await pool.query("SELECT * FROM memories WHERE type = $1", [type]);
287	      return { content: JSON.stringify(result.rows), mimeType: "application/json" };
288	    } else {
289	      throw new Error(`Unknown resource: ${resourceName}`);
290	    }
291	  } catch (error) {
292	    sendLogMessage('error', `Error reading resource ${resourceName}`, { error: error.message });
293	    throw error;
294	  }
295	}
