1	#!/usr/bin/env node
2	
3	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
4	
5	import { mainCommand, initCommand } from "./commands/index.js";
6	import { createServer } from "./server.js";
7	
8	mainCommand.addCommand(initCommand);
9	
10	mainCommand.action(async () => {
11	  const accessToken = process.env.GUMROAD_ACCESS_TOKEN;
12	  const baseUrl = process.env.GUMROAD_BASE_URL;
13	
14	  if (!accessToken) {
15	    console.error("Please set GUMROAD_ACCESS_TOKEN environment variable.");
16	    process.exit(1);
17	  }
18	
19	  const transport = new StdioServerTransport();
20	  const { server, cleanup } = createServer(accessToken, baseUrl);
21	  await server.connect(transport);
22	
23	  process.on("SIGINT", async () => {
24	    await cleanup();
25	    await server.close();
26	    process.exit(0);
27	  });
28	});
29	
30	mainCommand.parseAsync().catch((error) => {
31	  console.error("Server error:", error);
32	  process.exit(1);
33	});
