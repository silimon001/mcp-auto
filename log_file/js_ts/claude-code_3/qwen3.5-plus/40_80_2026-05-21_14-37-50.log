21	  search: z.number().optional().default(1).describe("검색 범위: 1=법령명(기본값), 2=본문검색"),
22	  sort: z.enum(["lasc", "ldes", "dasc", "ddes", "nasc", "ndes", "efasc", "efdes"]).optional().default("lasc").describe("정렬 옵션: lasc=법령명 오름차순, ldes=법령명 내림차순, dasc=공포일자 오름차순, ddes=공포일자 내림차순 등"),
23	});
24	
25	const GetLawDetailsSchema = z.object({
