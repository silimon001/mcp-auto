1	import { CursorInstance, Window } from '../types/cursor.js'
2	import path from 'path'
3	import { spawn } from 'child_process'
4	import { v4 as uuidv4 } from 'uuid'
5	import { WindowsApiService } from '../services/WindowsApiService.js'
6	
7	const DEFAULT_CURSOR_PATH = path.join(process.env.LOCALAPPDATA || '', 'Programs', 'cursor', 'Cursor.exe')
8	
9	export interface CursorInstanceManager {
10	    create(workspacePath?: string): Promise<CursorInstance>
11	    get(id: string): CursorInstance | undefined
12	    sendKeyToInstance(id: string, virtualKey: number): Promise<void>
13	    openCommandPalette(id: string): Promise<void>
14	    openClineTab(id: string): Promise<void>
15	    list(): CursorInstance[]
16	    remove(id: string): boolean
17	    sendCharToInstance(id: string, char: string): Promise<void>
18	}
19	
20	export class CursorInstanceManagerImpl implements CursorInstanceManager {
21	    private windowsApi: WindowsApiService
22	    private instances: Map<string, CursorInstance>
23	
24	    constructor() {
25	        this.windowsApi = new WindowsApiService()
26	        this.instances = new Map()
27	    }
28	
29	    async create(workspacePath?: string): Promise<CursorInstance> {
30	        const id = uuidv4()
31	        const cursorProcess = spawn(DEFAULT_CURSOR_PATH, workspacePath ? [workspacePath] : [], {
32	            detached: false,
33	            stdio: ['ignore', 'pipe', 'pipe'],
34	            windowsHide: false,
35	            env: {
36	                ...process.env,
37	                ELECTRON_ENABLE_LOGGING: '1',
38	                ELECTRON_ENABLE_STACK_DUMPING: '1'
39	            }
40	        })
41	
42	        const instance: CursorInstance = {
43	            id,
44	            process: cursorProcess,
45	            window: undefined,
46	            isActive: true,
47	            createdAt: new Date(),
48	            workspacePath
49	        }
50	
51	        this.instances.set(id, instance)
52	
53	        // Create a promise that resolves when the window is found or rejects on error
54	        const windowPromise = new Promise<Window>((resolve, reject) => {
55	            let errorOutput = ''
56	            let attempts = 0
57	            const maxAttempts = 10
58	            const checkInterval = 500 // ms
59	
60	            // Handle process events
61	            cursorProcess.on('error', (error: Error) => {
62	                console.error('Process error:', error)
63	                instance.isActive = false
64	                reject(new Error(`Failed to start Cursor process: ${error.message}`))
65	            })
66	
67	            // Log stdout and stderr
68	            cursorProcess.stdout?.on('data', (data: Buffer) => {
69	                const output = data.toString()
70	                console.log('Process stdout for instance', id + ':', output)
71	            })
72	
73	            cursorProcess.stderr?.on('data', (data: Buffer) => {
74	                const error = data.toString()
75	                console.error('Process stderr for instance', id + ':', error)
76	                errorOutput += error
77	
78	                // Check for specific error conditions
79	                if (error.includes('Cannot find module')) {
80	                    const moduleName = error.match(/Cannot find module '([^']+)'/)?.[1]
81	                    if (moduleName) {
82	                        reject(new Error(`Cursor is missing required module: ${moduleName}. Please ensure Cursor is installed correctly with all dependencies.`))
83	                    }
84	                }
85	            })
86	
87	            cursorProcess.on('exit', (code: number | null) => {
88	                console.log('Process exited for instance', id, 'with code:', code)
89	                instance.isActive = false
90	                this.instances.delete(id)
91	
92	                // Provide more helpful error message based on exit code
93	                if (code === 0) {
94	                    reject(new Error('Cursor process exited normally but window was not created. This may indicate a configuration issue.'))
95	                } else {
96	                    reject(new Error(`Cursor process exited with code ${code}. Error output: ${errorOutput}`))
97	                }
98	            })
99	
100	            // Check for window periodically
101	            const checkWindow = async () => {
102	                if (!instance.isActive) {
103	                    return // Stop checking if process is no longer active
104	                }
105	
106	                try {
107	                    const window = await this.windowsApi.findWindowByProcessId(cursorProcess.pid!, { initialCreation: true })
108	                    if (window) {
109	                        resolve(window)
110	                        return
111	                    }
112	                } catch (error) {
113	                    console.warn('Error checking for window:', error)
114	                }
115	
116	                attempts++
117	                if (attempts >= maxAttempts) {
118	                    reject(new Error('Failed to find Cursor window after maximum attempts. The process may have failed to start properly.'))
119	                } else {
120	                    setTimeout(checkWindow, checkInterval)
121	                }
122	            }
123	
124	            // Start checking for window
125	            checkWindow()
126	        })
127	
