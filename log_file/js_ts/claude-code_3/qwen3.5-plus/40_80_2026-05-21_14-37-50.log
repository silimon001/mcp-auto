1	import { McpError } from '@modelcontextprotocol/sdk/types.js'
2	import { ResultSchema, RequestSchema } from '@modelcontextprotocol/sdk/types.js'
3	import type { z } from 'zod'
4	import { CursorInstanceManager } from '../types/cursor.js'
5	
6	type ToolResponse = z.infer<typeof ResultSchema>
7	type ChainContext = z.infer<typeof RequestSchema>['params']
8	
9	export class CursorToolHandler {
10	    constructor(private cursorManager: CursorInstanceManager) {}
11	
12	    async handleOpenCursor(params: any, chainContext?: ChainContext): Promise<ToolResponse> {
13	        try {
14	            const instance = await this.cursorManager.create(params.workspacePath);
15	            
16	            const response = {
17	                instanceId: instance.id,
18	                status: "success"
19	            };
20	
21	            return {
22	                content: [{
23	                    type: "text",
24	                    text: JSON.stringify(response)
25	                }],
26	                chainContext: {
27	                    instanceId: instance.id,
28	                    toolName: "open_cursor"
29	                }
30	            };
31	        } catch (error: any) {
32	            throw new McpError(500, `Failed to launch Cursor: ${error?.message || 'Unknown error'}`);
33	        }
34	    }
35	
36	    async handleCursorCommand(params: any, chainContext?: ChainContext): Promise<ToolResponse> {
37	        try {
38	            const instanceId = params.instanceId || chainContext?.instanceId;
39	            if (!instanceId) {
40	                throw new McpError(400, "Instance ID is required");
41	            }
42	
43	            const { command } = params;
44	            await this.cursorManager.openCommandPalette(instanceId);
45	            await new Promise(resolve => setTimeout(resolve, 500));
46	            
47	            const response = {
48	                status: "success",
49	                command: command,
50	                result: "Command executed successfully"
51	            };
52	
53	            return {
54	                content: [{
55	                    type: "text",
56	                    text: JSON.stringify(response)
57	                }],
58	                chainContext: {
59	                    instanceId,
60	                    toolName: "cursor_command",
61	                    lastCommand: command
62	                }
63	            };
64	        } catch (error: any) {
65	            throw new McpError(500, `Failed to execute command: ${error?.message || 'Unknown error'}`);
66	        }
67	    }
68	
69	    async handleOpenClineTab(params: any, chainContext?: ChainContext): Promise<ToolResponse> {
70	        try {
71	            const instanceId = params.instanceId || chainContext?.instanceId;
72	            if (!instanceId) {
73	                throw new McpError(400, "Instance ID is required");
74	            }
75	
76	            await this.cursorManager.openClineTab(instanceId);
77	            
78	            const response = {
79	                status: "success",
80	                instanceId: instanceId,
81	                tabId: `cline-${Date.now()}`
82	            };
83	
84	            return {
85	                content: [{
86	                    type: "text",
87	                    text: JSON.stringify(response)
88	                }],
89	                chainContext: {
90	                    instanceId,
91	                    toolName: "open_cline_tab",
92	                    tabId: response.tabId
93	                }
94	            };
95	        } catch (error: any) {
96	            throw new McpError(500, `Failed to open Cline tab: ${error?.message || 'Unknown error'}`);
97	        }
98	    }
99	} 

