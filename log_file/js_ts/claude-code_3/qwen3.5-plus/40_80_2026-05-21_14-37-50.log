1	import { GameBoyButton } from './types';
2	import * as fs from 'fs';
3	import * as path from 'path';
4	import { createCanvas, Canvas } from 'canvas';
5	import { log } from './utils/logger';
6	
7	// Import the serverboy library
8	const Gameboy = require('serverboy');
9	
10	export class GameBoyEmulator {
11	  private gameboy: any;
12	  private canvas: Canvas;
13	  private romLoaded: boolean = false;
14	  private romPath?: string;
15	
16	  constructor() {
17	    this.gameboy = new Gameboy();
18	    // Create a canvas for rendering the screen
19	    this.canvas = createCanvas(160, 144);
20	  }
21	
22	  /**
23	   * Load a ROM file
24	   * @param romPath Path to the ROM file
25	   */
26	  public loadRom(romPath: string): void {
27	    try {
28	      const rom = fs.readFileSync(romPath);
29	      this.gameboy.loadRom(rom);
30	      this.romLoaded = true;
31	      this.romPath = romPath;
32	      log.info(`ROM loaded: ${path.basename(romPath)}`);
33	    } catch (error) {
34	      log.error(`Error loading ROM: ${error}`);
35	      throw new Error(`Failed to load ROM: ${error}`);
36	    }
37	  }
38	
39	  /**
40	   * Press a button on the GameBoy
41	   * @param button Button to press
42	   */
43	  public pressButton(button: GameBoyButton, durationFrames: number = 1): void {
44	    if (!this.romLoaded) {
45	      throw new Error('No ROM loaded');
46	    }
47	
48	    // Map our button enum to serverboy's keymap
49	    const buttonMap: Record<GameBoyButton, number> = {
50	      [GameBoyButton.UP]: Gameboy.KEYMAP.UP,
51	      [GameBoyButton.DOWN]: Gameboy.KEYMAP.DOWN,
52	      [GameBoyButton.LEFT]: Gameboy.KEYMAP.LEFT,
53	      [GameBoyButton.RIGHT]: Gameboy.KEYMAP.RIGHT,
54	      [GameBoyButton.A]: Gameboy.KEYMAP.A,
55	      [GameBoyButton.B]: Gameboy.KEYMAP.B,
56	      [GameBoyButton.START]: Gameboy.KEYMAP.START,
57	      [GameBoyButton.SELECT]: Gameboy.KEYMAP.SELECT
58	    };
59	
60	    for (let i=0; i < durationFrames; i++) {
61	      this.gameboy.pressKeys([buttonMap[button]]);
62	      this.gameboy.doFrame();
63	    }
64	
65	    // for now: advance one frame so we dont "hold" the button all the time.
66	    this.gameboy.doFrame();
67	  }
68	
69	  /**
70	   * Advance the emulation by one frame
71	   */
72	  public doFrame(): void {
73	    if (!this.romLoaded) {
74	      throw new Error('No ROM loaded');
75	    }
76	    this.gameboy.doFrame();
77	  }
78	
79	  /**
80	   * Get the current screen as a base64 encoded PNG
81	   * @returns Base64 encoded PNG image
82	   */
83	  public getScreenAsBase64(): string {
84	    if (!this.romLoaded) {
85	      throw new Error('No ROM loaded');
86	    }
87	
88	    // Get the raw screen data
89	    const screenData = this.gameboy.getScreen();
90	    
91	    // Draw to canvas
92	    const ctx = this.canvas.getContext('2d');
93	    const imageData = ctx.createImageData(160, 144);
94	    
95	    for (let i = 0; i < screenData.length; i++) {
96	      imageData.data[i] = screenData[i];
97	    }
98	    
99	    ctx.putImageData(imageData, 0, 0);
100	    
101	    // Convert to base64 PNG
102	    return this.canvas.toDataURL('image/png').split(',')[1];
103	  }
104	
105	  /**
106	   * Get the current ROM path
107	   * @returns Current ROM path or undefined if no ROM is loaded
108	   */
109	  public getRomPath(): string | undefined {
110	    return this.romPath;
111	  }
112	
113	  /**
114	   * Check if a ROM is loaded
115	   * @returns True if a ROM is loaded, false otherwise
116	   */
117	  public isRomLoaded(): boolean {
118	    return this.romLoaded;
119	  }
120	}
