249	// List resources implementation
250	async function handleListResources() {
251	  try {
252	    return [
253	      {
254	        name: "memory://types",
255	        description: "Lists all available memory types"
256	      },
257	      {
258	        name: "memory://tags",
259	        description: "Lists all available memory tags"
260	      }
261	    ];
262	  } catch (error) {
263	    sendLogMessage('error', 'Error in listResources', { error: error.message });
264	    throw error;
265	  }
