8	import type { Transport } from '../contracts/transport.js'
9	import type { McpContext } from '../../types/context.js'
10	import type { JsonRpcResponse } from '../../types/jsonrpc.js'
11	
12	export default class FakeTransport implements Transport {
13	  sentMessages: JsonRpcResponse[] = []
14	  bindBouncerCallbacks: ((ctx: McpContext) => void)[] = []
15	  bindAuthCallbacks: ((ctx: McpContext) => void)[] = []
16	
17	  send(message: JsonRpcResponse): void {
18	    this.sentMessages.push(message)
19	  }
20	
21	  bindBouncer?(ctx: McpContext): void {
22	    this.bindBouncerCallbacks.forEach((callback) => callback(ctx))
23	  }
24	
25	  bindAuth?(ctx: McpContext): void {
26	    this.bindAuthCallbacks.forEach((callback) => callback(ctx))
27	  }
28	
29	  clear(): void {
30	    this.sentMessages = []
31	    this.bindBouncerCallbacks = []
32	    this.bindAuthCallbacks = []
33	  }
34	
35	  getLastMessage(): JsonRpcResponse | undefined {
36	    return this.sentMessages[this.sentMessages.length - 1]
37	  }
38	}
