8	import type { Transport } from '../contracts/transport.js'
9	import type { JsonRpcResponse } from '../../types/jsonrpc.js'
10	import type { Readable, Writable } from 'node:stream'
11	
12	import { ReadBuffer, serializeMessage } from '../../utils/stdio.js'
13	import { EventEmitter } from 'node:events'
14	
15	export default class StdioTransport extends EventEmitter implements Transport {
16	  #stdin: Readable = process.stdin
17	  #stdout: Writable = process.stdout
18	  #readBuffer: ReadBuffer = new ReadBuffer()
19	
20	  ondata = (chunk: Buffer) => {
21	    this.#readBuffer.append(chunk)
22	    this.processReadBuffer()
23	  }
24	
25	  constructor() {
26	    super()
27	    this.#stdin.on('data', this.ondata)
28	  }
29	
30	  async processReadBuffer() {
31	    while (true) {
32	      try {
33	        const message = this.#readBuffer.readMessage()
34	        if (message === null) {
35	          break
36	        }
37	
38	        this.emit('mcp:stdio:transport:message', message)
39	      } catch (error) {}
40	    }
41	  }
42	
43	  send(message: JsonRpcResponse) {
44	    this.#stdout.write(serializeMessage(message))
45	  }
46	}
47	

