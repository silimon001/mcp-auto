8	import type { InitializeResult } from '../../types/jsonrpc.js'
9	import type { McpContext } from '../../types/context.js'
10	import type { Method } from '../../types/method.js'
11	
12	import { ErrorCode } from '../../enums/error.js'
13	import JsonRpcException from '../exceptions/jsonrpc_exception.js'
14	import Response from '../../response.js'
15	
16	export default class Initialize implements Method {
17	  handle(ctx: McpContext) {
18	    if (ctx.request.method !== 'initialize') {
19	      throw new JsonRpcException(
20	        'Invalid request method for initialize handler',
21	        ErrorCode.InvalidRequest,
22	        ctx.request.id
23	      )
24	    }
25	    const requestedVersion = ctx.request.params.protocolVersion ?? null
26	
27	    if (requestedVersion !== null && !ctx.supportedProtocolVersions.includes(requestedVersion)) {
28	      throw new JsonRpcException(
29	        'Unsupported protocol version',
30	        ErrorCode.InvalidParams,
31	        ctx.request.id,
32	        {
33	          supported: ctx.supportedProtocolVersions,
34	          requested: requestedVersion,
35	        }
36	      )
37	    }
38	
39	    const protocolVersion = requestedVersion ?? ctx.supportedProtocolVersions[0]
40	
41	    const result: InitializeResult = {
42	      protocolVersion,
43	      capabilities: ctx.serverCapabilities,
44	      serverInfo: {
45	        name: ctx.serverName,
46	        version: ctx.serverVersion,
47	      },
48	      instructions: ctx.instructions,
49	    }
50	
51	    return Response.toJsonRpc({ id: ctx.request.id, result })
52	  }
53	}
