44	        logError(`2. Use ${chalk.cyan('npx @auth0/auth0-mcp-server session')} to check your current session details`);
45	        return false;
46	    }
47	    // Check if domain exists
48	    const domain = await keychain.getDomain();
49	    if (!domain) {
50	        logError(`${chalk.red('Authorization Error:')} No Auth0 domain found in configuration`);
51	        logError(`${chalk.bold('Recommended actions:')}`);
