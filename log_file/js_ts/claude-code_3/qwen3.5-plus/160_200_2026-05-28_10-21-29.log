8	import type { CallToolResult, ContentBlock } from '../../types/jsonrpc.js'
9	import type { Method } from '../../types/method.js'
10	import type { ToolContext, ResourceContext } from '../../types/context.js'
11	import type { Content } from '../contracts/content.js'
12	
13	import { ErrorCode } from '../../enums/error.js'
14	import JsonRpcException from '../exceptions/jsonrpc_exception.js'
15	import Response from '../../response.js'
16	import ErrorContent from '../contents/error.js'
17	import ResourceLink from '../contents/resource_link.js'
18	import EmbeddedResource from '../contents/embedded_resource.js'
19	import Structured from '../contents/structured.js'
20	
21	import applicationService from '@adonisjs/core/services/app'
22	
23	export default class CallTool implements Method {
24	  async handle(ctx: ToolContext, app = applicationService) {
25	    const params = ctx.request.params
26	
27	    if (!params?.name) {
28	      throw new JsonRpcException(
29	        `The tool name is required.`,
30	        ErrorCode.InvalidParams,
31	        ctx.request.id
32	      )
33	    }
34	
35	    const entry = ctx.tools[params.name]
36	
37	    if (!entry) {
38	      throw new JsonRpcException(
39	        `The tool ${params.name} was not found.`,
40	        ErrorCode.InvalidParams,
41	        ctx.request.id
42	      )
43	    }
44	
45	    let Tool
46	    try {
47	      const module = await import(entry.path)
48	      Tool = module.default
49	    } catch (error: any) {
50	      throw new JsonRpcException(
51	        `Failed to import tool ${params.name}: ${error.message}`,
52	        ErrorCode.InternalError,
53	        ctx.request.id
54	      )
55	    }
56	
57	    ;(ctx as any).args = params.arguments ?? {}
58	
59	    const tool = await app.container.make(Tool)
60	
61	    let contents: Content[] | Content
62	    try {
63	      contents = await app.container.call(tool, 'handle', [ctx])
64	    } catch (error) {
65	      if (error instanceof JsonRpcException) {
66	        throw error
67	      }
68	      contents = error
69	    }
70	
71	    let data: Content[]
72	    if (!Array.isArray(contents)) {
73	      data = [contents]
74	    } else {
75	      data = contents
76	    }
77	
78	    let isError = false
79	    const result: CallToolResult = { content: [] }
80	    for await (const obj of data) {
81	      if (obj instanceof ResourceLink || obj instanceof EmbeddedResource) {
82	        await obj.preProcess(ctx as unknown as ResourceContext)
83	      }
84	
85	      if (obj instanceof Structured) {
86	        result.structuredContent = obj.structuredContent
87	      } else if (obj instanceof ErrorContent) {
88	        isError = true
89	        result.content.push(await obj.toTool(tool))
90	      } else {
91	        result.content.push((await obj.toTool(tool)) as ContentBlock)
92	      }
93	    }
94	
95	    if (isError) {
96	      result.isError = true
97	    }
98	
99	    return Response.toJsonRpc({ id: ctx.request.id, result })
100	  }
101	}
