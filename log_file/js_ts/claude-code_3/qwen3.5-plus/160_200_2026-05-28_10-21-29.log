51	/**
52	 * Parse command line arguments to get the API keys
53	 * @returns {Object} Object containing both API keys
54	 * @throws {Error} If required API keys are not provided
55	 */
56	function parseArgs() {
57	  const args = process.argv.slice(2);
58	  let shodanApiKey = '';
59	  let virusTotalApiKey = '';
60	
61	  for (let i = 0; i < args.length; i++) {
62	    if (args[i] === '--shodan-api-key' && i + 1 < args.length) {
63	      shodanApiKey = args[i + 1];
64	      i++; // Skip next argument as it's the value
65	    }
66	    if (args[i] === '--virustotal-api-key' && i + 1 < args.length) {
67	      virusTotalApiKey = args[i + 1];
68	      i++; // Skip next argument as it's the value
69	    }
70	  }
71	
72	  if (!shodanApiKey) {
73	    console.error("❌ --shodan-api-key parameter is required");
74	    console.error("Usage: npm start -- --shodan-api-key YOUR_SHODAN_API_KEY --virustotal-api-key YOUR_VIRUSTOTAL_API_KEY");
75	    process.exit(1);
76	  }
77	
78	  if (!virusTotalApiKey) {
79	    console.warn("⚠️ --virustotal-api-key parameter is not provided. VirusTotal tools will be unavailable.");
80	  }
81	
82	  return { shodanApiKey, virusTotalApiKey };
83	}
