107	        logger,
108	        argv.transport
109	      );
110	      logger.info('Server instance created successfully');
111	    } catch (error) {
112	      logger.error('Failed to create server instance:', error as any);
113	      throw error;
114	    }
115	
116	    logger.info('Starting server...');
117	    try {
118	      await server.start();
119	      logger.info('✓ Server started successfully');
120	      logger.info(`✓ Server is running and ready to accept connections on port ${argv.port}`);
121	      
122	      // Keep the process alive - important for containerized deployments
123	      // The server will continue running until explicitly stopped
124	      setInterval(() => {
125	        // Periodic heartbeat to ensure process stays alive
126	        // This helps detect if the process is still responsive
127	        if (process.uptime() % 60 === 0) {
128	          logger.debug(`Server heartbeat: uptime ${Math.floor(process.uptime())}s`);
129	        }
130	      }, 10000); // Every 10 seconds
131	      
132	    } catch (error) {
133	      logger.error('Failed to start server:', error as any);
134	      process.exit(1);
135	    }
136	    
137	    // Handle shutdown gracefully
