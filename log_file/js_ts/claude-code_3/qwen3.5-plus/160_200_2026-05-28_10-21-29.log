6	 */
7	
8	import type { JsonRpcRequest, JsonRpcResponse } from '../types/jsonrpc.js'
9	
10	/**
11	 * Buffers a continuous stdio stream into discrete JSON-RPC messages.
12	 */
13	export class ReadBuffer {
14	  #buffer?: Buffer
15	
16	  append(chunk: Buffer): void {
17	    this.#buffer = this.#buffer ? Buffer.concat([this.#buffer, chunk]) : chunk
18	  }
19	
20	  readMessage(): JsonRpcRequest | null {
21	    if (!this.#buffer) {
22	      return null
23	    }
24	
25	    const index = this.#buffer.indexOf('\n')
26	    if (index === -1) {
27	      return null
28	    }
29	
30	    const line = this.#buffer.toString('utf8', 0, index).replace(/\r$/, '')
31	    this.#buffer = this.#buffer.subarray(index + 1)
32	    return deserializeMessage(line)
33	  }
34	
35	  clear(): void {
36	    this.#buffer = undefined
37	  }
38	}
39	
40	export function deserializeMessage(line: string): JsonRpcRequest | null {
41	  return JSON.parse(line)
42	}
43	
44	export function serializeMessage(message: JsonRpcResponse): string {
45	  return JSON.stringify(message) + '\n'
46	}
47	

