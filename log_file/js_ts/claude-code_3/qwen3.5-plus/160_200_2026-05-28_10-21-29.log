26	const validateAuthorization = async () => {
27	    // Check if token exists
28	    const token = await keychain.getToken();
29	    if (!token) {
30	        logError(`${chalk.red('Authorization Error:')} No valid authorization token found`);
31	        logError(`${chalk.bold('Recommended actions:')}`);
32	        logError(`1. Run ${chalk.cyan('npx @auth0/auth0-mcp-server init')} to authorize with Auth0`);
33	        logError(`2. Use ${chalk.cyan('npx @auth0/auth0-mcp-server session')} to check your current session status`);
