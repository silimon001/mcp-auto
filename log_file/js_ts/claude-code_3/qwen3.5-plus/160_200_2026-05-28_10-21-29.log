982	/**
983	 * Helper function to make API requests to Shodan
984	 * Handles authentication and error handling for all Shodan API calls
985	 * 
986	 * @template T The expected response type
987	 * @param {string} endpoint The API endpoint to call
988	 * @param {Record<string, string | number>} params Query parameters to include
989	 * @returns {Promise<T>} The API response parsed as type T
990	 * @throws {Error} If the API request fails
991	 */
992	async function shodanApiRequest<T>(endpoint: string, params: Record<string, string | number> = {}, method: string = "GET"): Promise<T> {
993	  // Always include the API key
994	  const queryParams = new URLSearchParams();
995	  
996	  // Add all params
997	  Object.entries(params).forEach(([key, value]) => {
998	    queryParams.append(key, String(value));
999	  });
1000	  
1001	  // Add API key
1002	  queryParams.append('key', shodanApiKey);
1003	
1004	  const url = `${API_BASE_URL}${endpoint}?${queryParams}`;
1005	  
1006	  try {
1007	    const response = await fetch(url, { method });
1008	    
1009	    if (!response.ok) {
1010	      const errorText = await response.text();
1011	      throw new Error(`Shodan API error (${response.status}): ${errorText}`);
1012	    }
1013	    
1014	    return await response.json() as T;
1015	  } catch (error) {
1016	    console.error(`Error making request to ${endpoint}:`, error);
1017	    throw error;
1018	  }
1019	}
