92	    // Add current working directory path
93	    searchPaths.push(join(process.cwd(), "daraja_docs_v3"));
94	
95	    let foundPath: string | null = null;
96	    for (const searchPath of searchPaths) {
97	      if (existsSync(join(searchPath, CONFIG.INDEX_FILE))) {
98	        foundPath = searchPath;
99	        break;
100	      }
101	    }
102	
103	    if (!foundPath) {
104	      throw new Error(
105	        `Could not find documentation directory with ${CONFIG.INDEX_FILE}. ` +
