5	import packageJson from "../package.json" with { type: "json" };
6	
7	import { UmbracoToolFactory } from "./umb-management-api/tools/tool-factory.js";
8	
9	import { UmbracoManagementClient } from "@umb-management-client";
10	import { checkUmbracoVersion, configureApiClient, initializeUmbracoFetch, getServerConfig, handleCliCommands, createCollectionConfigLoader } from "@umbraco-cms/mcp-server-sdk";
11	import { loadServerConfig, clearConfigCache, allModes, allModeNames, allSliceNames } from "./config/index.js";
12	import { availableCollections } from "./umb-management-api/tools/collection-registry.js";
13	import { setUmbracoVersion, setAllowFilePathUploads } from "./umb-management-api/runtime-context.js";
14	
15	const main = async () => {
16	  // Node/stdio environment supports filesystem access; enable filePath uploads.
17	  setAllowFilePathUploads(true);
18	
19	  // Clear config cache to ensure fresh config for each server start
20	  clearConfigCache();
21	
22	  // Load and validate configuration
23	  const serverConfig = await loadServerConfig(true); // true = stdio mode (no logging)
24	  const config = serverConfig.umbraco;
25	
26	  // Initialize fetch client with configuration
27	  initializeUmbracoFetch(config.auth);
28	
29	  // Configure API client for SDK helpers (executeVoidApiCall, etc.)
30	  configureApiClient(() => UmbracoManagementClient.getClient());
31	
32	  // Create an MCP server
33	  const server = new McpServer({
34	    name: "Umbraco CMS Developer MCP Server",
35	    version: packageJson.version,
36	  });
37	  const client = UmbracoManagementClient.getClient();
38	
39	  const user = await client.getUserCurrent();
40	
41	  // Handle CLI introspection flags (--list-tools, --describe-tool, --generate-context)
42	  // This runs after auth so we have the real user for tool filtering
43	  const rawConfig = await getServerConfig(true);
44	  const configLoader = createCollectionConfigLoader({
45	    modeRegistry: allModes,
46	    allModeNames,
47	    allSliceNames,
48	  });
49	  const filterConfig = configLoader.loadFromConfig(config);
50	  handleCliCommands(availableCollections, {
51	    cliFlags: rawConfig.cliFlags,
52	    serverName: "Umbraco CMS Developer MCP Server",
53	    serverVersion: packageJson.version,
54	    user,
55	    filterConfig,
56	    serverConfig: config,
57	  });
58	
59	  // Check Umbraco version compatibility (logs result internally) and capture the
60	  // version so collection registrations can gate tools whose endpoints were
61	  // introduced in newer Umbraco releases.
62	  const serverInfo = await client.getServerInformation();
63	  setUmbracoVersion(serverInfo.version);
64	  await checkUmbracoVersion({
65	    mcpVersion: packageJson.version,
66	    client: { getServerInformation: async () => serverInfo }
67	  });
68	
69	  UmbracoToolFactory(server, user, config);
70	
71	  // Start receiving messages on stdin and sending messages on stdout
72	  const transport = new StdioServerTransport();
73	  await server.connect(transport);
74	};
75	
76	main().catch((error) => {
77	  console.error("Error:", error);
78	  process.exit(1);
79	});
