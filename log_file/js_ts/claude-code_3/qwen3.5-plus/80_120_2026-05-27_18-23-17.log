1	import process from 'process';
2	import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
3	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
4	import { registerTools } from '../tools';
5	import { HttpClient } from '../utils/httpClient';
6	import { CyberfraudService } from '../services/cyberfraudService';
7	import { CodeDefenderService } from '../services/codeDefenderService';
8	import { MCP_VERSION } from '../utils/constants';
9	
10	export function createServer() {
11	    const server = new McpServer(
12	        {
13	            name: 'HUMAN Security MCP Server',
14	            version: MCP_VERSION,
15	        },
16	        {
17	            capabilities: {
18	                tools: {},
19	            },
20	        },
21	    );
22	
23	    // Conditionally create services based on available tokens
24	    const cyberfraudToken = process.env.HUMAN_CYBERFRAUD_API_TOKEN;
25	    const codeDefenderToken = process.env.HUMAN_CODE_DEFENDER_API_TOKEN;
26	
27	    const services: {
28	        cyberfraudService?: CyberfraudService;
29	        codeDefenderService?: CodeDefenderService;
30	    } = {};
31	
32	    if (cyberfraudToken) {
33	        const cyberfraudHttpClient = new HttpClient(cyberfraudToken);
34	        services.cyberfraudService = new CyberfraudService(cyberfraudHttpClient);
35	        console.error('Cyberfraud service initialized');
36	    }
37	
38	    if (codeDefenderToken) {
39	        const codeDefenderHttpClient = new HttpClient(codeDefenderToken);
40	        services.codeDefenderService = new CodeDefenderService(codeDefenderHttpClient);
41	        console.error('Code Defender service initialized');
42	    }
43	
44	    if (!cyberfraudToken && !codeDefenderToken) {
45	        console.error('Warning: No API tokens found. No services will be available.');
46	    }
47	
48	    registerTools(server, services);
49	
50	    return {
51	        start: () => {
52	            const transport = new StdioServerTransport();
53	            server.connect(transport).then(() => {
54	                console.error('MCP server started...');
55	            });
56	
57	            const shutdown = () => {
58	                server.close().then(() => {
59	                    console.error('MCP server shut down.');
60	                });
61	            };
62	
63	            process.on('SIGINT', shutdown);
64	            process.on('SIGTERM', shutdown);
65	        },
66	    };
67	}
