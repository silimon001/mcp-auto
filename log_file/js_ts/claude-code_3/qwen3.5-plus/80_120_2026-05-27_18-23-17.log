346	  private async listServersWithTools() {
347	    const code = `
348	// Fetch all available MCP servers and their tools
349	const proxyPort = ${this.config.proxyPort};
350	
351	try {
352	  // Get list of servers
353	  const serversResponse = await fetch(\`http://localhost:\${proxyPort}/mcp/servers\`);
354	  if (!serversResponse.ok) {
355	    throw new Error(\`Failed to fetch servers: \${serversResponse.statusText}\`);
356	  }
357	
358	  const servers = await serversResponse.json();
359	
360	  if (servers.length === 0) {
361	    console.log(JSON.stringify({
362	      summary: { totalServers: 0, successfulServers: 0, totalTools: 0 },
363	      servers: [],
364	      message: "No MCP servers configured"
365	    }, null, 2));
366	    Deno.exit(0);
367	  }
368	
369	  const serversWithTools = [];
370	
371	  for (const serverName of servers) {
372	    try {
373	      const toolsResponse = await fetch(\`http://localhost:\${proxyPort}/mcp/\${serverName}/tools\`);
374	      if (!toolsResponse.ok) {
375	        serversWithTools.push({
376	          server: serverName,
377	          status: 'error',
378	          error: \`Failed to fetch tools: \${toolsResponse.statusText}\`,
379	          tools: []
380	        });
381	        continue;
382	      }
383	
384	      const toolsResult = await toolsResponse.json();
385	      const tools = toolsResult.tools || [];
386	
387	      serversWithTools.push({
388	        server: serverName,
389	        status: 'success',
390	        toolCount: tools.length,
391	        tools: tools.map(tool => ({
392	          name: tool.name,
393	          description: tool.description,
394	          inputSchema: tool.inputSchema
395	        }))
396	      });
397	
398	    } catch (error) {
399	      serversWithTools.push({
400	        server: serverName,
401	        status: 'error',
402	        error: error.message,
403	        tools: []
404	      });
405	    }
406	  }
407	
408	  const successfulServers = serversWithTools.filter(s => s.status === 'success').length;
409	  const totalTools = serversWithTools.reduce((sum, s) => sum + (s.toolCount || 0), 0);
410	
411	  // Output only structured JSON data
412	  console.log(JSON.stringify({
413	    summary: {
414	      totalServers: servers.length,
415	      successfulServers: successfulServers,
416	      totalTools: totalTools
417	    },
418	    servers: serversWithTools
419	  }, null, 2));
420	
421	} catch (error) {
422	  console.log(JSON.stringify({
423	    error: \`Failed to fetch MCP server information: \${error.message}\`,
424	    summary: { totalServers: 0, successfulServers: 0, totalTools: 0 },
425	    servers: []
426	  }, null, 2));
427	  Deno.exit(1);
428	}
429	`;
