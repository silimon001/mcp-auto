1	import express from 'express';
2	import { SSEServerTransport } from '@modelcontextprotocol/sdk/server/sse.js';
3	import { createMcpServer, CreateMcpServerParams } from '../utils/create-mcp-server';
4	
5	/**
6	 * MCP Over SSE is deprecated
7	 * See: https://modelcontextprotocol.io/specification/2025-03-26/basic/transports#streamable-http
8	 *
9	 * After now, we should only support streamable-http (/mcp) and remove the /sse endpoint.
10	 */
11	
12	export const sseRouter = express.Router();
13	
14	const transports: Map<string, SSEServerTransport> = new Map<string, SSEServerTransport>();
15	
16	sseRouter.get('/', async (req, res) => {
17	  try {
18	    const token = req.token;
19	    const sessionId = req.query.sessionId as string | undefined;
20	    const apps = req.query.apps
21	      ? (req.query.apps as string).split(',').map(app => app.trim())
22	      : undefined;
23	    const mode = req.query.mode as CreateMcpServerParams['mode'];
24	
25	    // Handle existing session
26	    if (sessionId) {
27	      const transport = transports.get(sessionId);
28	
29	      if (!transport) {
30	        return res.status(404).json({ error: 'Session not found' });
31	      }
32	
33	      console.log('Client reconnecting with sessionId:', sessionId);
34	      return;
35	    }
36	
37	    // Create new session
38	    const transport = new SSEServerTransport(`/sse/messages?token=${token}`, res);
39	
40	    transports.set(transport.sessionId, transport);
41	
42	    const { mcpServer } = await createMcpServer({
43	      userAccessToken: req.token!,
44	      apps,
45	      mode,
46	    });
47	
48	    await mcpServer.connect(transport);
49	
50	    console.log('Client Connected:', transport.sessionId);
51	
52	    // Handle connection cleanup
53	    const cleanup = async () => {
54	      console.log('Client Disconnected:', transport.sessionId);
55	      transports.delete(transport.sessionId);
56	      await mcpServer.close();
57	    };
58	
59	    res.on('close', cleanup);
60	    res.on('error', cleanup);
61	  } catch (error) {
62	    console.error('Error in SSE GET handler:', error);
63	    return res.status(500).json({ error: 'Internal server error' });
64	  }
65	});
66	
67	sseRouter.post('/messages', async (req, res) => {
68	  try {
69	    const sessionId = req.query.sessionId as string;
70	
71	    if (!sessionId) {
72	      console.error('No sessionId provided in POST /messages request');
73	      return res.status(400).json({ error: 'Session ID required' });
74	    }
75	
76	    const transport = transports.get(sessionId);
77	    if (!transport) {
78	      console.error(`No transport found for sessionId: ${sessionId}`);
79	      return res.status(404).json({ error: 'Session not found' });
80	    }
81	
82	    await transport.handlePostMessage(req, res, req.body);
83	  } catch (error) {
84	    console.error('Error in SSE POST handler:', error);
85	    return res.status(500).json({ error: 'Internal server error' });
86	  }
87	});
