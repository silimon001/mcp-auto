265	          errorMessage += "- Avoiding infinite loops or blocking operations\n";
266	        } else if (error.stderr && error.stderr.includes("permission")) {
267	          errorMessage +=
268	            "Permission denied. This MCP server only allows network access (--allow-net).\n";
269	          errorMessage += "The following operations are NOT permitted:\n";
270	          errorMessage += "- File system access (reading/writing files)\n";
271	          errorMessage += "- Environment variable access\n";
272	          errorMessage += "- System command execution\n";
273	          errorMessage += "- Plugin loading\n";
