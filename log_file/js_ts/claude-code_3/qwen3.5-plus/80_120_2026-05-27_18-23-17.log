1	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
2	import { createMcpServer } from "../server/server.js";
3	import { logger } from "../utils/logger.js";
4	
5	export async function runStdioServer() {
6	  const server = createMcpServer();
7	  const transport = new StdioServerTransport();
8	
9	  logger.info("Starting MCP stdio server...");
10	  await server.connect(transport);
11	  logger.info("MCP stdio server started successfully");
12	
13	  let isShuttingDown = false;
14	
15	  const shutdown = async () => {
16	    if (isShuttingDown) return;
17	    isShuttingDown = true;
18	
19	    logger.info("Gracefully shutting down MCP stdio server...");
20	    try {
21	      await transport.close();
22	    } catch (error) {
23	      logger.error("Error closing transport:", error);
24	    }
25	
26	    logger.info("MCP stdio server shut down completed.");
27	    process.exit(0);
28	  };
29	
30	  // Handle termination signals
31	  process.on("SIGINT", shutdown);
32	  process.on("SIGTERM", shutdown);
33	
34	  process.on("uncaughtException", (err) => {
35	    logger.error("Uncaught exception:", err);
36	    shutdown();
37	  });
38	
39	  process.on("unhandledRejection", (reason, promise) => {
40	    logger.error("Unhandled Rejection at:", promise, "reason:", reason);
