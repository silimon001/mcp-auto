1	import { Agent as BskyAgent, CredentialSession } from "@atproto/api";
2	import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
3	// no additional types needed here
4	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
5	import { createTools, type ToolDefinition } from "./tools.ts";
6	
7	export interface BlueskyCredentials {
8		identifier: string;
9		appKey: string;
10		serviceUrl?: string;
11	}
12	
13	export interface LocalSetupServerOptions {
14		server: McpServer;
15		credentials: BlueskyCredentials;
16		mode: "local";
17	}
18	
19	export interface RemoteSetupServerOptions {
20		server: McpServer;
21		getAgent: () => BskyAgent;
22		userIdentifier: string;
23		mode: "remote";
24	}
25	
26	export type SetupServerOptions =
27		| LocalSetupServerOptions
28		| RemoteSetupServerOptions;
29	
30	export async function setupServer(opts: SetupServerOptions): Promise<void> {
31		if (opts.mode === "local") {
32			await setupLocalServer(opts.server, opts.credentials);
33		} else {
34			setupRemoteServer(opts.server, opts.getAgent, opts.userIdentifier);
35		}
36	}
37	
38	/**
39	 * Perform local server setup: login, register tools, and connect transport.
40	 */
41	async function setupLocalServer(
42		server: McpServer,
43		credentials: BlueskyCredentials,
44	): Promise<void> {
45		const {
46			identifier,
47			appKey,
48			serviceUrl = "https://bsky.social",
49		} = credentials;
50	
51		let agent: BskyAgent | undefined;
52		let loginPromise: Promise<BskyAgent> | undefined;
53	
54		async function ensureAgent(): Promise<BskyAgent> {
55			if (agent) return agent;
56			if (!loginPromise) {
57				const session = new CredentialSession(new URL(serviceUrl));
58				const result = new BskyAgent(session);
59				loginPromise = result.login({ identifier, password: appKey }).then(() => {
60					agent = result;
61					return result;
62				});
63			}
64			return loginPromise;
65		}
66	
67		const agentGetter = () =>
68			({
69				ensureLogin: ensureAgent,
70				isDeferred: true,
71			} as unknown as BskyAgent);
72	
73		registerBlueskyTools(server, agentGetter, identifier, ensureAgent);
74	
75		const transport = new StdioServerTransport();
76		await server.connect(transport);
77	}
78	
79	/**
80	 * Perform remote server setup: register tools using provided agent.
81	 */
82	function setupRemoteServer(
83		server: McpServer,
84		getAgent: () => BskyAgent,
85		userIdentifier: string,
86	): void {
87		registerBlueskyTools(server, getAgent, userIdentifier);
88	}
89	
90	export function registerBlueskyTools(
91		server: McpServer,
92		getAgent: () => BskyAgent,
93		userIdentifier: string,
94		ensureAgent?: () => Promise<BskyAgent>,
95	): void {
96		const tools: ToolDefinition[] = createTools(getAgent, userIdentifier, ensureAgent);
97		for (const tool of tools) {
98			if (tool.schema === undefined) {
99				server.tool(tool.name, tool.description, (extra) => tool.callback(extra));
100			} else {
101				server.tool(tool.name, tool.description, tool.schema, (args, extra) =>
102					tool.callback(args, extra),
103				);
104			}
105		}
106	}
