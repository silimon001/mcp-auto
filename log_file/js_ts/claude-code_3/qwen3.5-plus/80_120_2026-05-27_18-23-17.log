4	export const getConfigValue = (name: string, fallback?: string): string | undefined => {
5	  // Check command line args first (format: --name=value or --name value)
6	  const argIndex = process.argv.findIndex((arg) => arg.startsWith(`--${name}`));
7	  if (argIndex !== -1) {
8	    const arg = process.argv[argIndex];
9	    if (arg.includes("=")) {
10	      return arg.split("=")[1];
11	    }
12	    // --name value format: return next argument if it exists and isn't another flag
13	    const nextArgIndex = argIndex + 1;
14	    if (nextArgIndex < process.argv.length) {
15	      const nextArg = process.argv[nextArgIndex];
16	      if (nextArg && !nextArg.startsWith("--")) {
17	        return nextArg;
18	      }
19	    }
20	  }
21	
22	  // Then check environment variables
23	  if (process.env[name] || process.env[name.toUpperCase()]) {
24	    return process.env[name] || process.env[name.toUpperCase()];
25	  }
26	
27	  return fallback;
28	};
