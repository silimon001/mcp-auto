64	class DbxServer {
65	  private server: Server;
66	
67	  constructor() {
68	    this.server = new Server(
69	      {
70	        name: 'dbx-mcp-server',
71	        version: '0.1.0',
72	      },
73	      {
74	        capabilities: {
75	          resources: {
76	            types: ["dbx-file", "dbx-folder"],
77	          },
78	          tools: {
79	            tools: toolDefinitions
80	          },
81	          prompts: {
82	            listChanged: true
83	          }
84	        },
85	      }
86	    );
87	
88	    this.setupHandlers();
89	    this.setupPromptHandlers();
90	
91	    // Error handling
92	    this.server.onerror = (error: Error & { code?: string }) => {
93	      log.error('Server error:', { 
94	        error: error.message, 
95	        code: error.code,
96	        stack: error.stack 
97	      });
98	    };
99	  }
100	
101	  private setupPromptHandlers() {
102	    this.server.setRequestHandler(ListPromptsRequestSchema, handleListPrompts);
103	    this.server.setRequestHandler(GetPromptRequestSchema, handleGetPrompt);
104	  }
105	
106	  private setupHandlers() {
107	    // Resource handlers
108	    this.server.setRequestHandler(ListResourcesRequestSchema, handleListResources);
109	    this.server.setRequestHandler(ReadResourceRequestSchema, handleReadResource);
110	    this.server.setRequestHandler(ListResourceTemplatesRequestSchema, async () => ({
111	      resourceTemplates
112	    }));
113	
114	    // Tool handlers
115	    this.server.setRequestHandler(ListToolsRequestSchema, async () => ({
116	      tools: toolDefinitions
117	    }));
118	
119	    this.server.setRequestHandler(CallToolRequestSchema, async (request) => {
120	      // Verify authentication
121	      if (!config.dropbox.accessToken && !await getValidAccessToken()) {
122	        throw new McpError(
123	          ErrorCode.InvalidRequest,
124	          'No valid access token available. Please authenticate first.'
125	        );
126	      }
127	
128	      // Log request (without sensitive data)
129	      log.info('Tool request:', { 
130	        tool: request.params.name,
131	        args: this.sanitizeArgs(request.params.arguments)
132	      });
133	
134	      // Handle tool requests
135	      const result = await (async () => {
136	        switch (request.params.name) {
137	          case 'list_files':
138	            return await dbxApi.listFiles(String(request.params.arguments?.path || ''));
139	          case 'upload_file':
140	            return await dbxApi.uploadFile(
141	              String(request.params.arguments?.path),
142	              String(request.params.arguments?.content)
143	            );
144	          case 'download_file':
145	            return await dbxApi.downloadFile(String(request.params.arguments?.path));
146	          case 'safe_delete_item':
147	            return await dbxApi.safeDeleteItem({
148	              path: String(request.params.arguments?.path),
149	              userId: String(request.params.arguments?.userId),
150	              skipConfirmation: Boolean(request.params.arguments?.skipConfirmation),
151	              retentionDays: Number(request.params.arguments?.retentionDays || config.safety.retentionDays),
152	              reason: String(request.params.arguments?.reason || ''),
153	              permanent: Boolean(request.params.arguments?.permanent)
154	            });
155	          case 'delete_item':
156	            // Legacy delete operation - logs a warning and uses safe delete with default settings
157	            log.warn('Legacy delete operation used', { path: request.params.arguments?.path });
158	            return await dbxApi.safeDeleteItem({
159	              path: String(request.params.arguments?.path),
160	              userId: 'legacy_user',
161	              skipConfirmation: true,
162	              permanent: true
163	            });
164	          case 'create_folder':
165	            return await dbxApi.createFolder(String(request.params.arguments?.path));
166	          case 'copy_item':
167	            return await dbxApi.copyItem(
168	              String(request.params.arguments?.from_path),
169	              String(request.params.arguments?.to_path)
170	            );
171	          case 'move_item':
172	            return await dbxApi.moveItem(
173	              String(request.params.arguments?.from_path),
174	              String(request.params.arguments?.to_path)
175	            );
176	          case 'get_file_metadata':
177	            return await dbxApi.getFileMetadata(String(request.params.arguments?.path));
178	          case 'search_file_db': {
179	            const searchOptions: SearchOptions = {
180	              query: String(request.params.arguments?.query),
181	              path: String(request.params.arguments?.path || ''),
182	              maxResults: Number(request.params.arguments?.max_results || 20),
183	              fileExtensions: request.params.arguments?.file_extensions as string[] | undefined,
184	              fileCategories: request.params.arguments?.file_categories as string[] | undefined,
185	              dateRange: request.params.arguments?.date_range as { start: string; end: string } | undefined,
186	              includeContentMatch: Boolean(request.params.arguments?.include_content_match),
187	              sortBy: (request.params.arguments?.sort_by as SearchOptions['sortBy']) || 'relevance',
188	              order: (request.params.arguments?.order as SearchOptions['order']) || 'desc'
189	            };
190	            return await dbxApi.searchFiles(searchOptions);
191	          }
192	          case 'get_sharing_link':
193	            return await dbxApi.getSharingLink(String(request.params.arguments?.path));
194	          case 'get_account_info':
195	            return await dbxApi.getAccountInfo();
196	          case 'get_file_content':
197	            return await dbxApi.getFileContent(String(request.params.arguments?.path));
198	          default:
199	            throw new McpError(
200	              ErrorCode.MethodNotFound,
201	              `Unknown tool: ${request.params.name}`
202	            );
203	        }
204	      })();
205	
206	      return {
207	        content: result.content,
208	        _meta: {}
209	      };
210	    });
211	  }
212	
213	  private sanitizeArgs(args: any): any {
214	    if (!args) return args;
215	    const sanitized = { ...args };
216	    // Remove sensitive data from logs
217	    if (sanitized.content) sanitized.content = '[CONTENT]';
218	    return sanitized;
219	  }
220	
221	  async run() {
222	    try {
223	      const transport = new StdioServerTransport();
224	      log.info('Connecting to transport...');
225	      await this.server.connect(transport);
226	      log.info('Dbx MCP server running on stdio');
227	    } catch (error) {
228	      log.error('Error connecting server:', { 
229	        error: error instanceof Error ? error.message : 'Unknown error',
230	        stack: error instanceof Error ? error.stack : undefined
231	      });
232	      throw error;
233	    }
234	  }
235	}
236	
237	export default DbxServer;
