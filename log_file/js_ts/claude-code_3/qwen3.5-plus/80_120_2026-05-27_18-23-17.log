35	// Validate date format (YYYY-MM-DD)
36	function validateDateFormat(date: string): boolean {
37	  const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
38	  if (!dateRegex.test(date)) {
39	    return false;
40	  }
41	
42	  const parsedDate = new Date(date);
43	  return parsedDate.toISOString().split("T")[0] === date;
44	}
45	
46	// Validate date range
47	function validateDateRange(startDate: string, endDate: string): void {
48	  if (!validateDateFormat(startDate)) {
49	    throw new McpError(
50	      ErrorCode.InvalidParams,
51	      `Invalid startDate format. Expected YYYY-MM-DD, got: ${startDate}`,
52	    );
53	  }
54	
55	  if (!validateDateFormat(endDate)) {
56	    throw new McpError(
57	      ErrorCode.InvalidParams,
58	      `Invalid endDate format. Expected YYYY-MM-DD, got: ${endDate}`,
59	    );
60	  }
61	
62	  if (new Date(startDate) > new Date(endDate)) {
63	    throw new McpError(
64	      ErrorCode.InvalidParams,
65	      "startDate cannot be after endDate",
66	    );
67	  }
68	}
69	
70	// Initialize environment validation
71	validateEnvironment();
