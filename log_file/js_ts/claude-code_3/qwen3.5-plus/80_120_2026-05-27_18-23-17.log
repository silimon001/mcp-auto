269	export async function handleResponseErrors(response: Response): Promise<void> {
270	  if (!response.ok) {
271	    let bodyText = "";
272	    try {
273	      bodyText = await response.text();
274	    } catch {}
275	
276	    const parsedBody = parseJsonOrNull(bodyText);
277	    const message = determineMessage(parsedBody, bodyText);
278	
279	    if (message.includes("Integration not enabled for user.")) {
280	      throw new UserNotConnectedError("Integration not enabled for user.");
281	    }
282	
283	    throw new Error(
284	      `HTTP error; status: ${response.status}; message: ${message}`
285	    );
286	  }
287	
288	  function parseJsonOrNull(text: string): unknown | null {
289	    if (!text) return null;
290	    try {
291	      return JSON.parse(text);
292	    } catch {
293	      return null;
294	    }
295	  }
296	
297	  function hasMessageString(val: unknown | null): val is { message: string } {
298	    return (
299	      typeof val === "object" &&
300	      val !== null &&
301	      "message" in (val as Record<string, unknown>) &&
302	      typeof (val as Record<string, unknown>).message === "string"
303	    );
304	  }
305	
306	  function safeStringify(value: unknown): string {
307	    try {
308	      const seen = new WeakSet<object>();
309	      return JSON.stringify(value, (_key, val: unknown) => {
310	        if (typeof val === "object" && val !== null) {
311	          const obj = val as object;
312	          if (seen.has(obj)) return "[Circular]";
313	          seen.add(obj);
314	        }
315	        return val as unknown;
316	      });
317	    } catch {
318	      return String(value);
319	    }
320	  }
321	
322	  function determineMessage(
323	    parsed: unknown | null,
324	    fallbackText: string
325	  ): string {
326	    if (hasMessageString(parsed)) return parsed.message;
327	    if (parsed !== null) return safeStringify(parsed);
328	    return fallbackText;
329	  }
330	}
