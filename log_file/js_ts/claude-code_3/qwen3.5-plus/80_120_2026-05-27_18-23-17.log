1	import { Agent as BskyAgent, CredentialSession } from "@atproto/api";
2	import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
3	// no additional types needed here
4	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
5	import { createTools, type ToolDefinition } from "./tools.ts";
6	
7	export interface BlueskyCredentials {
8		identifier: string;
9		appKey: string;
10		serviceUrl?: string;
11	}
12	
13	export interface LocalSetupServerOptions {
14		server: McpServer;
15		credentials: BlueskyCredentials;
16		mode: "local";
17	}
18	
19	export interface RemoteSetupServerOptions {
20		server: McpServer;
21		getAgent: () => BskyAgent;
22		userIdentifier: string;
23		mode: "remote";
24	}
25	
26	export type SetupServerOptions =
27		| LocalSetupServerOptions
28		| RemoteSetupServerOptions;
29	
30	export async function setupServer(opts: SetupServerOptions): Promise<void> {
31		if (opts.mode === "local") {
32			await setupLocalServer(opts.server, opts.credentials);
33		} else {
34			setupRemoteServer(opts.server, opts.getAgent, opts.userIdentifier);
35		}
36	}
37	
38	/**
39	 * Perform local server setup: login, register tools, and connect transport.
40	 */
41	async function setupLocalServer(
42		server: McpServer,
43		credentials: BlueskyCredentials,
44	): Promise<void> {
45		const {
46			identifier,
47			appKey,
48			serviceUrl = "https://bsky.social",
49		} = credentials;
50		const session = new CredentialSession(new URL(serviceUrl));
51		const login = await session.login({ identifier, password: appKey });
52		if (!login.success) throw new Error("Bluesky login failed");
53	
54		const agent = new BskyAgent(session);
55		const agentGetter = () => agent;
56		registerBlueskyTools(server, agentGetter, identifier);
57	
58		const transport = new StdioServerTransport();
59		await server.connect(transport);
60	}
61	
62	/**
63	 * Perform remote server setup: register tools using provided agent.
64	 */
65	function setupRemoteServer(
66		server: McpServer,
67		getAgent: () => BskyAgent,
68		userIdentifier: string,
69	): void {
70		registerBlueskyTools(server, getAgent, userIdentifier);
71	}
72	
73	export function registerBlueskyTools(
74		server: McpServer,
75		getAgent: () => BskyAgent,
76		userIdentifier: string,
77	): void {
78		const tools: ToolDefinition[] = createTools(getAgent, userIdentifier);
79		for (const tool of tools) {
80			if (tool.schema === undefined) {
81				server.tool(tool.name, tool.description, (extra) => tool.callback(extra));
82			} else {
83				server.tool(tool.name, tool.description, tool.schema, (args, extra) =>
84					tool.callback(args, extra),
85				);
86			}
87		}
88	}
