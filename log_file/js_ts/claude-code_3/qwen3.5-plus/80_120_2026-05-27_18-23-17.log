1	import { Request, Response, NextFunction } from 'express';
2	import jwt from 'jsonwebtoken';
3	
4	interface TokenPayload {
5	  id: string;
6	  [key: string]: any;
7	}
8	
9	export const authMiddleware = (req: Request, res: Response, next: NextFunction) => {
10	  const queryToken = req.query.token as string;
11	
12	  const authHeader = req.headers.authorization;
13	  const headerToken = authHeader?.startsWith('Bearer ') ? authHeader.substring(7) : null;
14	
15	  const userAccessToken = queryToken || headerToken;
16	
17	  if (!userAccessToken) {
18	    return res.status(401).json({ error: 'Unauthorized: No token provided' });
19	  }
20	
21	  try {
22	    const decoded = jwt.decode(userAccessToken) as TokenPayload;
23	
24	    if (!decoded || !decoded.id) {
25	      return res.status(401).json({ error: 'Unauthorized: Invalid token format' });
26	    }
27	
28	    // token is the standard access token on membrane
29	    req.token = userAccessToken;
30	
31	    // userId is the id of the user in your database
32	    req.userId = decoded.id;
33	
34	    next();
35	  } catch (error) {
36	    return res.status(401).json({ error: 'Unauthorized: Invalid token' });
37	  }
38	};
39	

