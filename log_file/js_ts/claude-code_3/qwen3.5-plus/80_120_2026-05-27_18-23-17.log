275	          errorMessage += "Module import failed. Remember:\n";
276	          errorMessage += "- Use https:// URLs for remote imports\n";
277	          errorMessage += "- Deno uses ES modules, not CommonJS\n";
278	          errorMessage += "- Check module URL spelling and availability\n";
