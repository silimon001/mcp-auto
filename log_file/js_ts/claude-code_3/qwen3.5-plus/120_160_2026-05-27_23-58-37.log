88	    }
89	
90	    public async getAvailableCommands(): Promise<string[]> {
91	        try {
92	            const commands = await vscode.commands.getCommands();
93	            const filtered =
94	                this.allowedCommands.length > 0 ? commands.filter(cmd => this.isCommandAllowed(cmd)) : commands;
95	
96	            return filtered.sort();
97	        } catch (error) {
98	            console.error('Failed to get available commands:', error);
99	            return [];
100	        }
101	    }
102	
103	
104	
105	    private isCommandAllowed(command: string): boolean {
106	        if (this.allowedCommands.length === 0) {
107	            return true;
108	        }
109	
110	        return this.allowedCommands.some(allowed => {
111	            if (allowed.endsWith('*')) {
112	                const prefix = allowed.slice(0, -1);
113	                return command.startsWith(prefix);
114	            }
115	            return command === allowed;
116	        });
117	    }
118	
119	    public updateAllowedCommands() {
120	        const config = vscode.workspace.getConfiguration('vscode-internal-command-mcp-server');
121	        this.allowedCommands = config.get<string[]>('allowedCommands', []);
122	    }
123	
124	    public updateAsyncConfig() {
125	        const config = vscode.workspace.getConfiguration('vscode-internal-command-mcp-server');
126	        const oldAsyncExecution = this.asyncExecution;
127	        const oldExecutionDelay = this.executionDelay;
128	
129	        // 检查配置值
130	        const rawAsyncExecution = config.get('asyncExecution');
131	        const rawExecutionDelay = config.get('executionDelay');
132	
133	        console.log('Raw config values:', {
134	            asyncExecution: rawAsyncExecution,
135	            executionDelay: rawExecutionDelay,
136	            configSection: 'vscode-internal-command-mcp-server',
137	        });
138	
139	        this.asyncExecution = config.get<boolean>('asyncExecution', true);
140	        this.executionDelay = config.get<number>('executionDelay', 0);
141	
142	        console.log(
143	            `Async config updated: asyncExecution=${oldAsyncExecution}->${this.asyncExecution}, executionDelay=${oldExecutionDelay}->${this.executionDelay}`,
144	        );
145	
146	        // 如果异步执行被禁用，清理待处理的任务
147	        if (!this.asyncExecution && this.backgroundExecutor) {
148	            const stats = this.backgroundExecutor.getTaskStats();
149	            if (stats.pending > 0) {
150	                console.log(`Async execution disabled, clearing ${stats.pending} pending tasks`);
151	                vscode.window.showWarningMessage(`异步执行已禁用，将清除 ${stats.pending} 个待处理任务`);
152	                this.backgroundExecutor.clearAllTasks();
153	            }
154	        }
155	    }
156	
157	    public getAllowedCommands(): string[] {
158	        return [...this.allowedCommands];
159	    }
160	
