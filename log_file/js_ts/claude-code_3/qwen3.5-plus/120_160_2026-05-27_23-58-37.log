55	const EXPECTED_ENV_HASH: string | null = process.env.ENV_FILE_HASH || null; // Optional integrity hash
56	
57	// Load secrets with priority: external env > .env file
58	const loadSecrets = (): void => {
59	  if (secretLoaded) return;
