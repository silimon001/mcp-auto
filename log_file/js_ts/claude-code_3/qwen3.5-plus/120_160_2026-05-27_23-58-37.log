1	#!/usr/bin/env node
2	
3	/**
4	 * FeiShu MCP Server Entry Point
5	 *
6	 * This file serves as the main entry point for the entire service,
7	 * responsible for initializing and launching the MCP server.
8	 * Supports two operational modes: Standard I/O (stdio) and HTTP.
9	 */
10	
11	import { getServerConfig } from '@/config.js';
12	import { FeiShuMcpServer } from '@/server/mcp-server.js';
13	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
14	
15	/**
16	 * Initialize and start the server
17	 *
18	 * Determines which mode to use based on environment variables or command-line arguments:
19	 * - stdio mode: Used in CLI environments, communicates via standard input/output
20	 * - HTTP mode: Launches a web server exposing API endpoints
21	 */
22	async function startServer() {
23	  // Determine if stdio mode should be used
24	  const isStdioMode =
25	    process.env.NODE_ENV === 'cli' || process.argv.includes('--stdio');
26	  // Retrieve server configuration
27	  const config = getServerConfig(isStdioMode);
28	  // Instantiate the server
29	  const server = new FeiShuMcpServer(config);
30	
31	  if (isStdioMode) {
32	    // stdio mode: Communication via standard input/output
33	    const transport = new StdioServerTransport();
34	    await server.connect(transport);
35	  } else {
36	    // HTTP mode: Launch web server
37	    console.log(
38	      `Initializing FeiShu MCP Server (HTTP mode) on port ${config.port}...`,
39	    );
40	    await server.startHttpServer(config.port);
41	  }
42	}
43	
44	/**
45	 * Determine if this file is being executed directly
46	 *
47	 * Distinguishes between direct execution and being imported as a module
48	 * @returns {boolean} True if file is executed directly
49	 */
50	function isDirectRun() {
51	  return import.meta.url === `file://${process.argv[1]}`;
52	}
53	
54	// Launch server if this file is executed directly
55	if (isDirectRun()) {
56	  startServer().catch((error) => {
57	    console.error('Failed to start server:', error);
58	    process.exit(1);
59	  });
60	}
