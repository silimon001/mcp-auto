1	import { serve } from '@hono/node-server';
2	import { config } from './config/env.js';
3	import { stopContextCleanup } from './core/context.js';
4	import { buildHttpApp } from './http/app.js';
5	import { buildAuthApp } from './http/auth-app.js';
6	import { FileTokenStore } from './shared/storage/file.js';
7	import { MemorySessionStore } from './shared/storage/memory.js';
8	import { initializeStorage } from './shared/storage/singleton.js';
9	import { logger } from './utils/logger.js';
10	
11	// Store references for graceful shutdown
12	let tokenStore: FileTokenStore | null = null;
13	let sessionStore: MemorySessionStore | null = null;
14	
15	async function main(): Promise<void> {
16	  try {
17	    // Initialize storage singleton with encryption
18	    tokenStore = new FileTokenStore(config.RS_TOKENS_FILE, config.RS_TOKENS_ENC_KEY);
19	    sessionStore = new MemorySessionStore();
20	    initializeStorage(tokenStore, sessionStore);
21	
22	    const app = buildHttpApp();
23	    serve({ fetch: app.fetch, port: config.PORT, hostname: config.HOST });
24	
25	    // OAuth Authorization Server (runs on PORT+1 if auth enabled)
26	    if (config.AUTH_ENABLED) {
27	      const authApp = buildAuthApp();
28	      serve({
29	        fetch: authApp.fetch,
30	        port: Number(config.PORT) + 1,
31	        hostname: config.HOST,
32	      });
33	    }
34	
35	    await logger.info('server', {
36	      message: `MCP server started on http://${config.HOST}:${config.PORT}`,
37	      environment: config.NODE_ENV,
38	      authEnabled: config.AUTH_ENABLED,
39	      tokenEncryption: Boolean(config.RS_TOKENS_ENC_KEY),
40	    });
41	  } catch (error) {
42	    console.error('Failed to start server:', error);
43	    await logger.error('server', {
44	      message: 'Server startup failed',
45	      error: (error as Error).message,
46	    });
47	    process.exit(1);
48	  }
49	}
50	
51	function gracefulShutdown(signal: string): void {
52	  void logger.info('server', { message: `Received ${signal}, shutting down` });
53	
54	  // Stop cleanup intervals
55	  stopContextCleanup();
56	
57	  // Flush token store to disk and stop its cleanup
58	  if (tokenStore) {
59	    tokenStore.flush();
60	    tokenStore.stopCleanup();
61	  }
62	
63	  // Stop session store cleanup
64	  if (sessionStore) {
65	    sessionStore.stopCleanup();
66	  }
67	
68	  process.exit(0);
69	}
70	
71	process.on('SIGINT', () => gracefulShutdown('SIGINT'));
72	process.on('SIGTERM', () => gracefulShutdown('SIGTERM'));
73	
74	void main();
75	

