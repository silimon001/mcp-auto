137	        totalThoughts: thought.totalThoughts,
138	        nextThoughtNeeded: thought.nextThoughtNeeded,
139	        // Include other properties if present
140	        isRevision: thought.isRevision,
141	        revisesThought: thought.revisesThought,
142	        branchFromThought: thought.branchFromThought,
143	        branchId: thought.branchId,
144	        needsMoreThoughts: thought.needsMoreThoughts,
145	        // Add the session ID for tracking
146	        sessionId: this.currentSessionId
147	      }));
148	      
149	      // Log each thought for debugging
150	      thoughtsToStore.forEach((thought, index) => {
151	        logger.error(chalk.blue(`🔍 Debug: Thought ${index + 1}: ${JSON.stringify({
152	          thought: thought.thought.substring(0, 50) + (thought.thought.length > 50 ? '...' : ''),
153	          thoughtNumber: thought.thoughtNumber,
154	          totalThoughts: thought.totalThoughts,
155	          nextThoughtNeeded: thought.nextThoughtNeeded,
156	          sessionId: thought.sessionId
157	        })}`));
158	      });
159	      
160	      const storeResult = await recallIntegration.storeSession(
161	        thoughtsToStore,
162	        { 
163	          query: this.currentQuery || 'No query provided',
164	          sessionId: this.currentSessionId
165	        }
166	      );
167	      
168	      if (storeResult?.success) {
169	        logger.error(chalk.green(`✅ Debug: Successfully stored session with result: ${JSON.stringify(storeResult, null, 2)}`));
170	      } else {
171	        logger.error(chalk.yellow(`⚠️ Debug: Store session returned unsuccessful result`));
172	      }
173	      
174	      return storeResult;
175	    } catch (error: any) {
176	      logger.error(chalk.red(`❌ Error handling session storage: ${error.message}`));
177	      logger.error(chalk.red(`Stack trace: ${error.stack}`));
178	      return undefined;
179	    }
180	  }
