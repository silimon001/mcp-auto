  "content": "#!/usr/bin/env node\nimport { McpServer } from \"@modelcontextprotocol/sdk/server/mcp.js\";\nimport { StdioServerTransport } from \"@modelcontextprotocol/sdk/server/stdio.js\";\nimport { z } from \"zod\";\nimport * as fs from \"fs\";\nimport * as path from \"path\";\n\n// RPG Maker MZ file structures\nconst DEFAULT_MAP_DATA = {\n  displayName: \"\",\n  width: 0,\n  height: 0,\n  scrollType: 0,\n  data: [],\n  events: [],\n  tilemap: [],\n  tileset: { id: 1, mode: 0 },\n  parallaxName: \"\",\n  parallaxLoopHorz: false,\n  parallaxLoopVert: false,\n  parallaxShow: false,\n  parallaxLoopHorzAuto: false,\n  parallaxLoopVertAuto: false,\n  parallaxSx: 0,\n  parallaxSy: 0,\n  battleback1Name: \"\",\n  battleback2Name: \"\",\n  specifyBattleback: false,\n  autoplayBgm: false,\n  bgm: { name: \"\", pan: 0, pitch: 0, volume: 0 },\n  autoplayBgs: false,\n  bgs: { name: \"\", pan: 0, pitch: 0, volume: 0 },\n  distanceRunSwitch: false,\n  tilesetId: 0,\n  displayX: 0,\n  displayY: 0,\n  interpreted: false,\n  eventCount: 0,\n  progressValue: 0,\n};\n\nconst DEFAULT_ACTOR = {\n  id: 0,\n  nickname: \"\",\n  name: \"\",\n  classId: 1,\n  initialLevel: 1,\n  maxLevel: 99,\n  nickname: \"\",\n  profile: \"\",\n  attackAnimationId: 0,\n  attackAnimationType: 0,\n  params: [[1, 500, 0, 0, 0, 0, 0, 0]],\n  traits: [],\n  note: \"\",\n};\n\nconst DEFAULT_CLASS = {\n  id: 0,\n  name: \"\",\n  description: \"\",\n  position: 0,\n  attackAnimations: [],\n  learning: [],\n  params: [[1, 500, 0, 0, 0, 0, 0, 0]],\n  traits: [],\n  note: \"\",\n};\n\nconst DEFAULT_SKILL = {\n  id: 0,\n  name: \"\",\n  description: \"\",\n  scope: 0,\n  speed: 0,\n  successRate: 100,\n  damage: { type: 0, elementId: 0, variance: 20, effect: 0, formula: \"0\" },\n  stypeId: 0,\n  mpCost: 0,\n  tpCost: 0,\n  message1: \"\",\n  message2: \"\",\n  requiredWtypeId1: 0,\n  requiredWtypeId2: 0,\n  traits: [],\n  note: \"\",\n};\n\nconst DEFAULT_ITEM = {\n  id: 0,\n  name: \"\",\n  description: \"\",\n  scope: 0,\n  speed: 0,\n  successRate: 100,\n  damage: { type: 0, elementId: 0, variance: 20, effect: 0, formula: \"0\" },\n  effects: [],\n  occasion: 0,\n  consumable: true,\n  price: 0,\n  stypeId: 0,\n  stypeId2: 0,\n  stypeId3: 0,\n  traits: [],\n  note: \"\",\n};\n\nfunction ensureProjectStructure(projectPath: string): boolean {\n  const dirs = [\n    path.join(projectPath, \"data\"),\n    path.join(projectPath, \"img\", \"characters\"),\n    path.join(projectPath, \"img\", \"faces\"),\n    path.join(projectPath, \"img\", \"tilesets\"),\n    path.join(projectPath, \"img\", \"battlebacks1\"),\n    path.join(projectPath, \"img\", \"battlebacks2\"),\n    path.join(projectPath, \"img\", \"enemies\"),\n    path.join(projectPath, \"img\", \"sv_actors\"),\n    path.join(projectPath, \"img\", \"pictures\"),\n    path.join(projectPath, \"audio\", \"bgm\"),\n    path.join(projectPath, \"audio\", \"bgs\"),\n    path.join(projectPath, \"audio\", \"se\"),\n    path.join(projectPath, \"audio\", \"me\"),\n    path.join(projectPath, \"movies\"),\n    path.join(projectPath, \"plugins\"),\n  ];\n  for (const dir of dirs) {\n    fs.mkdirSync(dir, { recursive: true });\n  }\n  return true;\n}\n\nfunction initProjectFiles(projectPath: string, gameTitle: string): void {\n  ensureProjectStructure(projectPath);\n  const rpgProject = {\n    rpgFormat: 5,\n    windowsWidth: 816,\n    windowsHeight: 624,\n    disableMultiTouch: false,\n    attackMotions: true,\n    encounterStep: 20,\n    emergencyShift: 25,\n    partyMembers: [1],\n    testBattlers: [],\n    testTroopId: 0,\n    escapeRatio: 1.5,\n    battleback1Name: \"\",\n    battleback2Name: \"\",\n    battlerHue: 0,\n    title1Name: \"\",\n    title2Name: \"\",\n    optDrawTitleCopyright: false,\n    optDrawTitleGraphic: true,\n    optUseVehicles: true,\n    optFollowers: true,\n    optSlipDeath: true,\n    optFloorDeath: true,\n    optDisplayTp: true,\n    optExtraExp: false,\n    optKeyItemMenu: 1,\n    optGoldSeparator: 2,\n    optFloorHeal: 1,\n    optPartyAgreement: 1,\n    optAutoSave: false,\n    optMediasEnable: true,\n    optUsableAllSkills: false,\n    optFollowersErase: false,\n    optKeyItemEat: false,\n    optUsableMax: false,\n    gameTitle: gameTitle,\n    authorName: \"\",\n    partyName: \"\",\n    optChaoticGathering: false,\n    optBattleTestBgm: false,\n    optPlaytestPopup: true,\n    optRemoveCommonEvEvents: false,\n    pluginCommands: [],\n    pluginNames: [],\n  };\n  fs.writeFileSync(path.join(projectPath, \"Game.rpgproject\"), JSON.stringify(rpgProject, null, 2));\n\n  const database = {\n    actors: [],\n    classes: [],\n    skills: [],\n    items: [],\n    weapons: [],\n    armors: [],\n    enemies: [],\n    troop: [],\n    states: [],\n    animations: [],\n    tilesets: [],\n    commonEvents: [],\n    system: {\n      mapId: 1,\n      battleTestId: 0,\n      battleTestFlag: 0,\n      battleTestBgm: { name: \"\", volume: 90, pitch: 100, pan: 0 },\n      battleTestBgs: { name: \"\", volume: 90, pitch: 100, pan: 0 },\n      battleTestTroopId: 1,\n      battleTestFlag: 0,\n      startMapId: 1,\n      startX: 3,\n      startY: 3,\n      title1Name: \"\",\n      title2Name: \"\",\n      optDrawTitleCopyright: false,\n      optDrawTitleGraphic: true,\n      optUseVehicles: true,\n      optFollowers: true,\n      optSlipDeath: true,\n      optFloorDeath: true,\n      optDisplayTp: true,\n      optExtraExp: false,\n      optKeyItemMenu: 1,\n      optGoldSeparator: 2,\n      optFloorHeal: 1,\n      optPartyAgreement: 1,\n      optAutoSave: false,\n      optMediasEnable: true,\n      optUsableAllSkills: false,\n      optFollowersErase: false,\n      optKeyItemEat: false,\n      optUsableMax: false,\n      magicSkillId: 0,\n      attackMotions: true,\n      versionId: 0,\n      shopGoods: [],\n      features: [],\n      swapActors: false,\n      terms: {\n        basic: [\"HP\", \"MP\", \"TP\", \"EXP\", \"Gold\", \"HP\", \"MP\", \"TP\"],\n        params: [\"Max HP\", \"Max MP\", \"Attack\", \"Defense\", \"MATK\", \"MDEF\", \"AGI\", \"LUK\"],\n        extra: [\"Level\", \"Last Level\", \"Target\", \"Weapon\"],\n        commands: { fight: \"Fight\", escape: \"Escape\", attack: \"Attack\", guard: \"Guard\", item: \"Items\", skill: \"Skills\", equip: \"Equip\" },\n      },\n      windowTone: [0, 0, 0, 0],\n      windowOpacity: 255,\n    },\n    animations: [],\n    tilesets: [],\n    commonEvents: [],\n    switches: [],\n    variables: [],\n  };\n\n  // Write empty database files\n  const dataTypes = [\"actors\", \"classes\", \"skills\", \"items\", \"weapons\", \"armors\", \"enemies\", \"troops\", \"states\", \"animations\", \"tilesets\", \"commonEvents\", \"system\", \"switches\", \"variables\"];\n  for (const type of dataTypes) {\n    const fileName = type === \"troops\" ? \"Troops.json\" : type.charAt(0).toUpperCase() + type.slice(1) + \".json\";\n    const content = database[type as keyof typeof database] || [];\n    fs.writeFileSync(path.join(projectPath, \"data\", fileName), JSON.stringify(content, null, 2));\n  }\n\n  // Write map data for map 1\n  const map1Data = {\n    ...DEFAULT_MAP_DATA,\n    displayName: \"Map 1\",\n    width: 16,\n    height: 12,\n  };\n  fs.writeFileSync(path.join(projectPath, \"Map001.json\"), JSON.stringify(map1Data, null, 2));\n}\n\nfunction getProjectPath(args: Record<string, unknown>): string {\n  return (args.project_path as string) || \"\";\n}\n\n// Create the MCP server\nconst server = new McpServer({\n  name: \"rpgmaker-mz\",\n  version: \"1.0.0\",\n});\n\n// ============ Project Management Tools ============\n\nserver.tool(\n  \"create_project\",\n  \"Create a new RPG Maker MZ project\",\n  {\n    project_path: z.string().describe(\"Path where the project will be created\"),\n    game_title: z.string().default(\"My RPG\").describe(\"Title of the game\"),\n  },\n  async ({ project_path, game_title }) => {\n    try {\n      ensureProjectStructure(project_path);\n      initProjectFiles(project_path, game_title);\n      return {\n        content: [{ type: \"text\", text: `Project created successfully at ${project_path} with title \"${game_title}\"` }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error creating project: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\nserver.tool(\n  \"list_projects\",\n  \"List all projects in a directory\",\n  {\n    directory: z.string().default(\"./\").describe(\"Directory to search for projects\"),\n  },\n  async ({ directory }) => {\n    try {\n      const entries = fs.readdirSync(directory, { withFileTypes: true })\n        .filter(e => e.isDirectory())\n        .map(e => path.join(directory, e.name))\n        .filter(p => fs.existsSync(path.join(p, \"Game.rpgproject\")));\n      return {\n        content: [{ type: \"text\", text: entries.length > 0 ? entries.join(\"\\n\") : \"No projects found.\" }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error listing projects: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\nserver.tool(\n  \"read_project_info\",\n  \"Read project information\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n  },\n  async ({ project_path }) => {\n    try {\n      const gameRpgproject = path.join(project_path, \"Game.rpgproject\");\n      if (!fs.existsSync(gameRpgproject)) {\n        return { content: [{ type: \"text\", text: \"No Game.rpgproject found at specified path.\" }], isError: true };\n      }\n      const data = JSON.parse(fs.readFileSync(gameRpgproject, \"utf-8\"));\n      return {\n        content: [{ type: \"text\", text: JSON.stringify(data, null, 2) }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error reading project: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\nserver.tool(\n  \"generate_project_context\",\n  \"Generate context documentation for a project\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n    include_maps: z.boolean().default(true).describe(\"Include map information\"),\n    include_events: z.boolean().default(true).describe(\"Include event information\"),\n    include_plugins: z.boolean().default(true).describe(\"Include plugin information\"),\n  },\n  async ({ project_path, include_maps, include_events, include_plugins }) => {\n    try {\n      let context = `# Project Context: ${project_path}\\n\\n`;\n      const projectFile = path.join(project_path, \"Game.rpgproject\");\n      if (fs.existsSync(projectFile)) {\n        const project = JSON.parse(fs.readFileSync(projectFile, \"utf-8\"));\n        context += `## Game Title\\n${project.gameTitle || \"Untitled\"}\\n\\n`;\n      }\n      const dataDir = path.join(project_path, \"data\");\n      if (fs.existsSync(dataDir)) {\n        context += \"## Database Contents\\n\";\n        const files = fs.readdirSync(dataDir);\n        context += files.join(\", \") + \"\\n\\n\";\n      }\n      if (include_maps) {\n        const mapFiles = fs.readdirSync(project_path).filter(f => f.startsWith(\"Map\") && f.endsWith(\".json\"));\n        context += `## Maps (${mapFiles.length})\\n${mapFiles.join(\", \")}\\n\\n`;\n      }\n      return {\n        content: [{ type: \"text\", text: context }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error generating context: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\nserver.tool(\n  \"analyze_project_structure\",\n  \"Analyze the structure of a project\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n  },\n  async ({ project_path }) => {\n    try {\n      const structure: Record<string, string[]> = {};\n      function walkDir(dir: string, base: string) {\n        const entries = fs.readdirSync(dir, { withFileTypes: true });\n        const files = entries.filter(e => e.isFile()).map(e => e.name);\n        const dirs = entries.filter(e => e.isDirectory());\n        if (files.length > 0) structure[path.relative(base, dir) || \".\"] = files;\n        for (const d of dirs) {\n          walkDir(path.join(dir, d.name), base);\n        }\n      }\n      walkDir(project_path, project_path);\n      return {\n        content: [{ type: \"text\", text: JSON.stringify(structure, null, 2) }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error analyzing structure: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\nserver.tool(\n  \"extract_game_design_patterns\",\n  \"Extract game design patterns from a project\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n  },\n  async ({ project_path }) => {\n    try {\n      const patterns: string[] = [];\n      const dataDir = path.join(project_path, \"data\");\n      if (fs.existsSync(dataDir)) {\n        const actors = JSON.parse(fs.readFileSync(path.join(dataDir, \"Actors.json\"), \"utf-8\") || \"[]\");\n        patterns.push(`Actors: ${actors.length}`);\n        const skills = JSON.parse(fs.readFileSync(path.join(dataDir, \"Skills.json\"), \"utf-8\") || \"[]\");\n        patterns.push(`Skills: ${skills.length}`);\n        const items = JSON.parse(fs.readFileSync(path.join(dataDir, \"Items.json\"), \"utf-8\") || \"[]\");\n        patterns.push(`Items: ${items.length}`);\n        const enemies = JSON.parse(fs.readFileSync(path.join(dataDir, \"Enemies.json\"), \"utf-8\") || \"[]\");\n        patterns.push(`Enemies: ${enemies.length}`);\n        const troops = JSON.parse(fs.readFileSync(path.join(dataDir, \"Troops.json\"), \"utf-8\") || \"[]\");\n        patterns.push(`Troops: ${troops.length}`);\n        const commonEvents = JSON.parse(fs.readFileSync(path.join(dataDir, \"CommonEvents.json\"), \"utf-8\") || \"[]\");\n        patterns.push(`Common Events: ${commonEvents.length}`);\n      }\n      return {\n        content: [{ type: \"text\", text: patterns.join(\"\\n\") }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error extracting patterns: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\n// ============ Map Editing Tools ============\n\nserver.tool(\n  \"create_map\",\n  \"Create a new map in a project\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n    map_id: z.number().describe(\"Map ID\"),\n    name: z.string().default(\"New Map\").describe(\"Map name\"),\n    width: z.number().default(25).describe(\"Map width\"),\n    height: z.number().default(20).describe(\"Map height\"),\n    tileset_id: z.number().default(1).describe(\"Tileset ID\"),\n  },\n  async ({ project_path, map_id, name, width, height, tileset_id }) => {\n    try {\n      const mapData = {\n        ...DEFAULT_MAP_DATA,\n        displayName: name,\n        width,\n        height,\n        tilesetId: tileset_id,\n        data: new Array(width * height).fill(0),\n        events: [],\n      };\n      const mapIdStr = String(map_id).padStart(3, \"0\");\n      fs.writeFileSync(path.join(project_path, `Map${mapIdStr}.json`), JSON.stringify(mapData, null, 2));\n      return {\n        content: [{ type: \"text\", text: `Map ${map_id} \"${name}\" created (${width}x${height}).` }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error creating map: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\nserver.tool(\n  \"list_maps\",\n  \"List all maps in a project\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n  },\n  async ({ project_path }) => {\n    try {\n      const files = fs.readdirSync(project_path);\n      const mapFiles = files.filter(f => /^Map\\d{3}\\.json$/.test(f));\n      const maps = mapFiles.map(f => {\n        const content = JSON.parse(fs.readFileSync(path.join(project_path, f), \"utf-8\"));\n        return `${f}: ${content.displayName || \"Untitled\"} (${content.width}x${content.height})`;\n      });\n      return {\n        content: [{ type: \"text\", text: maps.length > 0 ? maps.join(\"\\n\") : \"No maps found.\" }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error listing maps: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\nserver.tool(\n  \"read_map\",\n  \"Read map data\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n    map_id: z.number().describe(\"Map ID\"),\n  },\n  async ({ project_path, map_id }) => {\n    try {\n      const mapIdStr = String(map_id).padStart(3, \"0\");\n      const mapFile = path.join(project_path, `Map${mapIdStr}.json`);\n      if (!fs.existsSync(mapFile)) {\n        return { content: [{ type: \"text\", text: `Map ${map_id} not found.` }], isError: true };\n      }\n      const content = JSON.parse(fs.readFileSync(mapFile, \"utf-8\"));\n      return {\n        content: [{ type: \"text\", text: JSON.stringify(content, null, 2) }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error reading map: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\nserver.tool(\n  \"update_map_tile\",\n  \"Update a tile on a map\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n    map_id: z.number().describe(\"Map ID\"),\n    x: z.number().describe(\"X coordinate\"),\n    y: z.number().describe(\"Y coordinate\"),\n    tile_id: z.number().describe(\"Tile ID to set\"),\n    layer: z.number().default(0).describe(\"Tile layer (0-3)\"),\n  },\n  async ({ project_path, map_id, x, y, tile_id, layer }) => {\n    try {\n      const mapIdStr = String(map_id).padStart(3, \"0\");\n      const mapFile = path.join(project_path, `Map${mapIdStr}.json`);\n      if (!fs.existsSync(mapFile)) {\n        return { content: [{ type: \"text\", text: `Map ${map_id} not found.` }], isError: true };\n      }\n      const mapData = JSON.parse(fs.readFileSync(mapFile, \"utf-8\"));\n      const width = mapData.width;\n      const layers = mapData.data || [];\n      // RPG Maker MZ stores tile data as flat array: layers * width * height\n      const totalTiles = width * mapData.height;\n      const idx = layer * totalTiles + y * width + x;\n      if (layers.length <= idx) {\n        layers.length = idx + 1;\n      }\n      layers[idx] = tile_id;\n      mapData.data = layers;\n      fs.writeFileSync(mapFile, JSON.stringify(mapData, null, 2));\n      return {\n        content: [{ type: \"text\", text: `Tile at (${x}, ${y}) layer ${layer} updated to ${tile_id}.` }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error updating tile: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\n// ============ Event Editing Tools ============\n\nserver.tool(\n  \"add_event\",\n  \"Add an event to a map\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n    map_id: z.number().describe(\"Map ID\"),\n    event_id: z.number().describe(\"Event ID\"),\n    name: z.string().default(\"New Event\").describe(\"Event name\"),\n    x: z.number().describe(\"X coordinate\"),\n    y: z.number().describe(\"Y coordinate\"),\n  },\n  async ({ project_path, map_id, event_id, name, x, y }) => {\n    try {\n      const mapIdStr = String(map_id).padStart(3, \"0\");\n      const mapFile = path.join(project_path, `Map${mapIdStr}.json`);\n      if (!fs.existsSync(mapFile)) {\n        return { content: [{ type: \"text\", text: `Map ${map_id} not found.` }], isError: true };\n      }\n      const mapData = JSON.parse(fs.readFileSync(mapFile, \"utf-8\"));\n      const event = {\n        id: event_id,\n        name,\n        note: \"\",\n        pages: [\n          {\n            condition: { switch1Id: 0, switch2Id: 0, variableId: 0, variableValue: 0 },\n            list: [\n              { code: 0, indent: 0, parameters: [] },\n            ],\n            span: 0,\n            trigger: 0,\n          },\n        ],\n        positionType: 0,\n        priorityType: 0,\n        directions: [{ tripName: \"\" }],\n        x,\n        y,\n      };\n      if (!mapData.events) mapData.events = [];\n      const existingIdx = mapData.events.findIndex((e: { id: number }) => e.id === event_id);\n      if (existingIdx >= 0) {\n        mapData.events[existingIdx] = event;\n      } else {\n        mapData.events.push(event);\n      }\n      mapData.eventCount = mapData.events.length;\n      fs.writeFileSync(mapFile, JSON.stringify(mapData, null, 2));\n      return {\n        content: [{ type: \"text\", text: `Event ${event_id} \"${name}\" added at (${x}, ${y}).` }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error adding event: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\nserver.tool(\n  \"add_event_command\",\n  \"Add an event command to an event page\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n    map_id: z.number().describe(\"Map ID\"),\n    event_id: z.number().describe(\"Event ID\"),\n    page_index: z.number().default(0).describe(\"Page index\"),\n    code: z.number().describe(\"Command code (e.g. 101=Show Text, 201=Movement)\"),\n    parameters: z.array(z.any()).default([]).describe(\"Command parameters\"),\n    indent: z.number().default(0).describe(\"Indent level\"),\n    before: z.number().default(-1).describe(\"Insert before this command index (-1=append)\"),\n  },\n  async ({ project_path, map_id, event_id, page_index, code, parameters, indent, before }) => {\n    try {\n      const mapIdStr = String(map_id).padStart(3, \"0\");\n      const mapFile = path.join(project_path, `Map${mapIdStr}.json`);\n      if (!fs.existsSync(mapFile)) {\n        return { content: [{ type: \"text\", text: `Map ${map_id} not found.` }], isError: true };\n      }\n      const mapData = JSON.parse(fs.readFileSync(mapFile, \"utf-8\"));\n      const event = mapData.events?.find((e: { id: number }) => e.id === event_id);\n      if (!event) {\n        return { content: [{ type: \"text\", text: `Event ${event_id} not found.` }], isError: true };\n      }\n      const page = event.pages[page_index];\n      if (!page) {\n        return { content: [{ type: \"text\", text: `Page ${page_index} not found.` }], isError: true };\n      }\n      const command = { code, indent, parameters };\n      if (before >= 0 && before < page.list.length) {\n        page.list.splice(before, 0, command);\n      } else {\n        page.list.push(command);\n      }\n      fs.writeFileSync(mapFile, JSON.stringify(mapData, null, 2));\n      return {\n        content: [{ type: \"text\", text: `Command code ${code} added to event ${event_id} page ${page_index}.` }],\n      };\n    } catch (error) {\n      return {\n        content: [{ type: \"text\", text: `Error adding event command: ${error instanceof Error ? error.message : String(error)}` }],\n        isError: true,\n      };\n    }\n  }\n);\n\n// ============ Database Editing Tools ============\n\nserver.tool(\n  \"add_actor\",\n  \"Add an actor to the database\",\n  {\n    project_path: z.string().describe(\"Path to the RPG Maker MZ project\"),\n    id: z.number().describe(\"Actor ID\"),\n    name: z.string().default(\"New Actor\").describe(\"Actor name\")