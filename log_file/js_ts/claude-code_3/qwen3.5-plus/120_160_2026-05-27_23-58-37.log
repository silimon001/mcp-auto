9	// Subscription plan levels in order of increasing access
10	const SUBSCRIPTION_LEVELS = {
11	  "Basic": 0,
12	  "Hobbyist": 1,
13	  "Startup": 2,
14	  "Standard": 3,
15	  "Professional": 4,
16	  "Enterprise": 5
17	}
