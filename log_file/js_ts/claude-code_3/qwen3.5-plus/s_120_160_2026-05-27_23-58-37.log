loop 19 | Tool=Write, Args={"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/vscode-internal-command-mcp-server/test_client.js","content":"#!/usr/bin/env node\n\"use strict\";\n// Test client for verifying the MCP server\nconst { Client } = require('@modelcontextprotocol/sdk/client/index.js');\nconst { StreamableHTTPClientTransport } = require('@modelcontextprotocol/sdk/client/streamableHttp.js');\n\nasync function main() {\n    const url = new URL('http://localhost:8080/mcp');\n    const transport = new StreamableHTTPClientTransport(url, {\n        requestInit: {\n            headers: {\n                'Content-Type': 'application/json',\n                'Accept': 'application/json, text/event-stream',\n            },\n        },\n    });\n\n    const client = new Client({\n        name: 'test-client',\n        version: '1.0.0',\n    });\n\n    try {\n        await client.connect(transport);\n        console.log('Connected successfully!');\n\n        // List tools\n        const tools = await client.listTools();\n        console.log('\\n=== Available Tools ===');\n        for (const tool of tools.tools) {\n            console.log(`- ${tool.name}: ${tool.description}`);\n            console.log(`  Input schema: ${JSON.stringify(tool.inputSchema, null, 2)}`);\n        }\n\n        // Call list_vscode_commands tool\n        console.log('\\n=== Calling list_vscode_commands ===');\n        const result = await client.callTool({ name: 'list_vscode_commands', arguments: {} });\n        console.log(result.content[0].text);\n\n        console.log('\\n✅ Server is working correctly!');\n    } catch (err) {\n        console.error('Error:', err.message);\n        process.exit(1);\n    } finally {\n        await transport.close();\n    }\n}\n\nmain();\n"}
