loop 9 | Tool=Write, Args={"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/vscode-internal-command-mcp-server/standalone_server.js","content":"#!/usr/bin/env node\n\"use strict\";\nconst { FastMCP } = require('fastmcp');\nconst z = require('zod');\n\n// Standalone MCP server for vscode-internal-command-mcp-server\n// This runs outside of VSCode with mocked VSCode APIs\n\nconst PORT = parseInt(process.env.PORT || '8080', 10);\nconst HOST = process.env.HOST || 'localhost';\n\nclass MockCommandExecutor {\n    constructor() {\n        this.asyncExecution = true;\n        this.executionDelay = 500;\n        this.taskCounter = 0;\n        this.backgroundTasks = new Map();\n        this.taskStats = { total: 0, pending: 0, running: 0, completed: 0, failed: 0, cancelled: 0 };\n    }\n\n    async executeCommand(command, args = []) {\n        if (this.asyncExecution) {\n            const taskId = `bg_task_${this.taskCounter++}_${Date.now()}`;\n            const task = {\n                id: taskId,\n                command,\n                arguments: args,\n                status: 'pending',\n                createdAt: new Date().toISOString(),\n                scheduledFor: Date.now() + this.executionDelay,\n            };\n            this.backgroundTasks.set(taskId, task);\n            this.taskStats.total++;\n            this.taskStats.pending++;\n\n            setTimeout(() => {\n                task.status = 'completed';\n                this.taskStats.pending--;\n                this.taskStats.completed++;\n                console.log(`[MockExecutor] Task ${taskId} completed: ${command}`);\n            }, this.executionDelay);\n\n            return {\n                success: true,\n                async: true,\n                taskId,\n                message: `Command '${command}' submitted for background execution${this.executionDelay > 0 ? `, will execute in ${this.executionDelay}ms` : ''}`,\n                command,\n                arguments: args,\n                executionDelay: this.executionDelay,\n                queueLength: this.taskStats.pending + this.taskStats.running,\n                taskStats: { ...this.taskStats },\n            };\n        } else {\n            return {\n                success: true,\n                async: false,\n                message: `Command '${command}' executed (mock, no VSCode)`,\n                command,\n                arguments: args,\n            };\n        }\n    }\n\n    async getAvailableCommands() {\n        // Return a list of common VSCode commands as a mock\n        return [\n            'editor.action.formatDocument',\n            'editor.action.clipboardCopyAction',\n            'editor.action.clipboardPasteAction',\n            'editor.action.selectAll',\n            'editor.action.deleteLines',\n            'editor.action.commentLine',\n            'workbench.action.files.save',\n            'workbench.action.files.saveAll',\n            'workbench.action.newWindow',\n            'workbench.action.closeWindow',\n            'workbench.action.find',\n            'workbench.action.replaceInFiles',\n            'workbench.view.explorer',\n            'workbench.view.search',\n            'workbench.view.scm',\n            'workbench.view.debug',\n            'workbench.extensions.action.installExtensions',\n            'workbench.action.openSettings',\n            'workbench.action.showCommands',\n            'workbench.action.terminal.new',\n        ];\n    }\n\n    async getWorkspaceInfo() {\n        return {\n            name: process.env.WORKSPACE_NAME || 'standalone-workspace',\n            folders: process.env.WORKSPACE_FOLDER\n                ? [{ name: 'workspace', uri: `file://${process.env.WORKSPACE_FOLDER}` }]\n                : [],\n            activeEditor: process.env.ACTIVE_EDITOR || 'no-active-editor',\n        };\n    }\n}\n\nasync function main() {\n    const executor = new MockCommandExecutor();\n\n    const server = new FastMCP({\n        name: 'vscode-internal-command-mcp-server',\n        version: '0.0.2',\n        instructions: 'Standalone MCP Server - VSCode Internal Command executor (no VSCode required). Supports command execution and workspace queries.',\n        health: {\n            enabled: true,\n            path: '/health',\n            message: 'VSCode internal command MCP is running (standalone mode)',\n            status: 200,\n        },\n    });\n\n    // Tool 1: execute_vscode_command\n    server.addTool({\n        name: 'execute_vscode_command',\n        description: 'Execute VSCode internal command',\n        parameters: z.object({\n            command: z.string().describe('VSCode command ID'),\n            arguments: z.array(z.string()).optional().describe('Command arguments'),\n        }),\n        execute: async (args) => {\n            try {\n                const { command, arguments: cmdArgs } = args;\n                const result = await executor.executeCommand(command, cmdArgs || []);\n                return {\n                    content: [{ type: 'text', text: `Command execution result: ${JSON.stringify(result, null, 2)}` }],\n                };\n            } catch (error) {\n                return {\n                    content: [{ type: 'text', text: `Command execution failed: ${error.message}` }],\n                    isError: true,\n                };\n            }\n        },\n    });\n\n    // Tool 2: list_vscode_commands\n    server.addTool({\n        name: 'list_vscode_commands',\n        description: 'List available VSCode commands',\n        parameters: z.object({}),\n        execute: async () => {\n            try {\n                const commands = await executor.getAvailableCommands();\n                return {\n                    content: [{\n                        type: 'text',\n                        text: `Available commands (${commands.length}):\\n${commands.slice(0, 20).join('\\n')}${commands.length > 20 ? '\\n...(more)' : ''}`,\n                    }],\n                };\n            } catch (error) {\n                return {\n                    content: [{ type: 'text', text: `Failed to get command list: ${error.message}` }],\n                    isError: true,\n                };\n            }\n        },\n    });\n\n    // Tool 3: get_workspace_info\n    server.addTool({\n        name: 'get_workspace_info',\n        description: 'Get workspace information',\n        parameters: z.object({}),\n        execute: async () => {\n            try {\n                const info = await executor.getWorkspaceInfo();\n                return {\n                    content: [{ type: 'text', text: `Workspace info:\\n${JSON.stringify(info, null, 2)}` }],\n                };\n            } catch (error) {\n                return {\n                    content: [{ type: 'text', text: `Failed to get workspace info: ${error.message}` }],\n                    isError: true,\n                };\n            }\n        },\n    });\n\n    server.on('connect', (event) => {\n        console.log(`[MCP Server] Client connected: ${event.session?.id || 'unknown'}`);\n    });\n\n    server.on('disconnect', (event) => {\n        console.log(`[MCP Server] Client disconnected: ${event.session?.id || 'unknown'}`);\n    });\n\n    console.log(`[MCP Server] Starting on http://${HOST}:${PORT}/mcp ...`);\n\n    await server.start({\n        transportType: 'httpStream',\n        httpStream: {\n            port: PORT,\n            host: HOST,\n            endpoint: '/mcp',\n        },\n    });\n\n    console.log(`[MCP Server] Started successfully on http://${HOST}:${PORT}/mcp`);\n    console.log(`[MCP Server] Health check: http://${HOST}:${PORT}/health`);\n}\n\nmain().catch((err) => {\n    console.error('[MCP Server] Failed to start:', err);\n    process.exit(1);\n});\n"}
