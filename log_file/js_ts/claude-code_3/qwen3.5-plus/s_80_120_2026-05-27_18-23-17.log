loop 14 | Tool=Edit, Args={"replace_all":false,"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/896258038_laulauland_bluesky-context-server/packages/server/src/server.ts","old_string":"async function setupLocalServer(\n\tserver: McpServer,\n\tcredentials: BlueskyCredentials,\n): Promise<void> {\n\tconst {\n\t\tidentifier,\n\t\tappKey,\n\t\tserviceUrl = \"https://bsky.social\",\n\t} = credentials;\n\tconst session = new CredentialSession(new URL(serviceUrl));\n\tconst login = await session.login({ identifier, password: appKey });\n\tif (!login.success) throw new Error(\"Bluesky login failed\");\n\n\tconst agent = new BskyAgent(session);\n\tconst agentGetter = () => agent;\n\tregisterBlueskyTools(server, agentGetter, identifier);\n\n\tconst transport = new StdioServerTransport();\n\tawait server.connect(transport);\n}","new_string":"async function setupLocalServer(\n\tserver: McpServer,\n\tcredentials: BlueskyCredentials,\n): Promise<void> {\n\tconst {\n\t\tidentifier,\n\t\tappKey,\n\t\tserviceUrl = \"https://bsky.social\",\n\t} = credentials;\n\n\tlet agent: BskyAgent | undefined;\n\tlet loginPromise: Promise<BskyAgent> | undefined;\n\n\tasync function ensureAgent(): Promise<BskyAgent> {\n\t\tif (agent) return agent;\n\t\tif (!loginPromise) {\n\t\t\tconst session = new CredentialSession(new URL(serviceUrl));\n\t\t\tconst result = new BskyAgent(session);\n\t\t\tloginPromise = result.login({ identifier, password: appKey }).then(() => {\n\t\t\t\tagent = result;\n\t\t\t\treturn result;\n\t\t\t});\n\t\t}\n\t\treturn loginPromise;\n\t}\n\n\tconst agentGetter = () =>\n\t\t({\n\t\t\tensureLogin: ensureAgent,\n\t\t\tisDeferred: true,\n\t\t} as unknown as BskyAgent);\n\n\tregisterBlueskyTools(server, agentGetter, identifier, ensureAgent);\n\n\tconst transport = new StdioServerTransport();\n\tawait server.connect(transport);\n}"}
