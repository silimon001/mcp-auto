200	    async def _handle_sse_event(
201	        self,
202	        sse: ServerSentEvent,
203	        read_stream_writer: StreamWriter,
204	        original_request_id: RequestId | None = None,
205	        resumption_callback: Callable[[str], Awaitable[None]] | None = None,
206	        is_initialization: bool = False,
207	    ) -> bool:
208	        """Handle an SSE event, returning True if the response is complete."""
209	        if sse.event == "message":
210	            # Handle priming events (empty data with ID) for resumability
211	            if not sse.data:
212	                # Call resumption callback for priming events that have an ID
213	                if sse.id and resumption_callback:
214	                    await resumption_callback(sse.id)
215	                return False
216	            try:
217	                message = JSONRPCMessage.model_validate_json(sse.data)
218	                logger.debug(f"SSE message: {message}")
219	
220	                # Extract protocol version from initialization response
221	                if is_initialization:
222	                    self._maybe_extract_protocol_version_from_message(message)
223	
224	                # If this is a response and we have original_request_id, replace it
225	                if original_request_id is not None and isinstance(message.root, JSONRPCResponse | JSONRPCError):
226	                    message.root.id = original_request_id
227	
228	                session_message = SessionMessage(message)
229	                await read_stream_writer.send(session_message)
230	
231	                # Call resumption token callback if we have an ID
232	                if sse.id and resumption_callback:
233	                    await resumption_callback(sse.id)
234	
235	                # If this is a response or error return True indicating completion
236	                # Otherwise, return False to continue listening
237	                return isinstance(message.root, JSONRPCResponse | JSONRPCError)
238	
239	            except Exception as exc:  # pragma: no cover
240	                logger.exception("Error parsing SSE message")
241	                await read_stream_writer.send(exc)
242	                return False
243	        else:  # pragma: no cover
244	            logger.warning(f"Unknown SSE event: {sse.event}")
245	            return False
