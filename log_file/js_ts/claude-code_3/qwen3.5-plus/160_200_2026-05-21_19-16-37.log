387	            # Extract protocol version from initialization response
388	            if is_initialization:
389	                self._maybe_extract_protocol_version_from_message(message)
390	
391	            session_message = SessionMessage(message)
392	            await read_stream_writer.send(session_message)
393	        except Exception as exc:  # pragma: no cover
394	            logger.exception("Error parsing JSON response")
395	            await read_stream_writer.send(exc)
