522	function setupGitCommitProtection(): void {
523	  logStep('🔒', 'Setting up git commit protection...');
524	  
525	  const gitHooksDir = path.join(process.cwd(), '.git', 'hooks');
526	  const preCommitPath = path.join(gitHooksDir, 'pre-commit');
527	  
528	  // Check if .git directory exists
529	  if (!fs.existsSync(path.join(process.cwd(), '.git'))) {
530	    logWarning('Not a git repository - skipping commit protection setup');
531	    return;
532	  }
533	  
534	  // Create hooks directory if it doesn't exist
535	  fs.mkdirSync(gitHooksDir, { recursive: true });
536	  
537	  const preCommitContent = `#!/usr/bin/env bash
538	
539	# Pre-commit hook to prevent Claude from committing directly
540	AUTHOR_EMAIL=$(git config user.email)
541	
542	if [ "$AUTHOR_EMAIL" = "claude@anthropic.com" ]; then
543	    echo "🚫 ERROR: Claude Code Assistant cannot commit directly to this repository."
544	    echo "   Please use explicit commit instructions or create a feature branch."
545	    echo "   Current author: $AUTHOR_EMAIL"
546	    echo ""
547	    echo "   To allow this commit, either:"
548	    echo "   1. Use explicit commit instructions in your prompt"
549	    echo "   2. Create a feature branch first"
550	    echo "   3. Temporarily change git user: git config user.email 'your@email.com'"
551	    exit 1
552	fi
553	
554	exit 0`;
555	
556	  fs.writeFileSync(preCommitPath, preCommitContent);
557	  
558	  // Make the hook executable
559	  try {
560	    fs.chmodSync(preCommitPath, 0o755);
561	    logSuccess('Git commit protection configured');
562	  } catch (error) {
563	    logWarning(`Failed to make pre-commit hook executable: ${error}`);
564	  }
565	  
566	  // Set up git commit template
567	  const gitMessagePath = path.join(process.cwd(), '.gitmessage');
568	  const gitMessageContent = `# Commit Template for ZMCPTools
569	# 
570	# Please specify the author and purpose:
571	# 
572	# [FEATURE/FIX/DOCS/REFACTOR]: Brief description
573	# 
574	# Detailed description:
575	# - What was changed
576	# - Why it was changed
577	# - How to test the changes
578	#
579	# Author: [Specify if not original author]
580	# Co-authored-by: Claude <claude@anthropic.com> (if applicable)
581	#
582	# ⚠️  This commit should only be made with explicit instructions`;
583	
584	  fs.writeFileSync(gitMessagePath, gitMessageContent);
585	  
586	  try {
587	    execSync('git config commit.template .gitmessage', { stdio: 'pipe' });
588	    execSync('git config user.useConfigOnly true', { stdio: 'pipe' });
589	    logSuccess('Git commit template configured');
590	  } catch (error) {
591	    logWarning(`Failed to configure git commit template: ${error}`);
592	  }
593	}
