183	        anyio.create_task_group() as tg,
184	        process,
185	    ):
186	        tg.start_soon(stdout_reader)
187	        tg.start_soon(stdin_writer)
188	        try:
189	            yield read_stream, write_stream
190	        finally:
191	            # MCP spec: stdio shutdown sequence
192	            # 1. Close input stream to server
193	            # 2. Wait for server to exit, or send SIGTERM if it doesn't exit in time
194	            # 3. Send SIGKILL if still not exited
195	            if process.stdin:  # pragma: no branch
