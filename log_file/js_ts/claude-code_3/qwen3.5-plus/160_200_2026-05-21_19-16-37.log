436	async function addMcpServer(packageManager?: { name: string; installCommand: string; linkCommand: string; unlinkCommand: string }): Promise<boolean> {
437	  logStep('🔌', 'Adding MCP server to Claude Code...');
438	  
439	  try {
440	    // Use stdio transport (no OAuth required for local development)
441	    const mcpCommand = `claude mcp add claude-mcp-tools -s local -e MCPTOOLS_DATA_DIR="${path.join(os.homedir(), '.mcptools', 'data')}" -- claude-mcp-server`;
442	    
443	    try {
444	      // Try to add the server
445	      execSync(mcpCommand, { 
446	        stdio: 'pipe' 
447	      });
448	      logSuccess('MCP server added to Claude Code with stdio transport (default)');
449	    } catch (addError) {
450	      // If it fails (likely because server already exists), remove and re-add
451	      logStep('🔄', 'MCP server already exists, updating configuration...');
452	      
453	      try {
454	        execSync(`claude mcp remove claude-mcp-tools`, { stdio: 'pipe' });
455	      } catch (removeError) {
456	        // Ignore remove errors (server might not exist)
457	      }
458	      
459	      // Re-add with new configuration
460	      execSync(mcpCommand, { 
461	        stdio: 'pipe' 
462	      });
463	      logSuccess('MCP server configuration updated with stdio transport (default)');
464	    }
465	    
466	    return true;
467	    
468	  } catch (error) {
469	    logError(`Failed to add MCP server: ${error}`);
470	    logWarning(`You can manually add it with: claude mcp add claude-mcp-tools -s local -e MCPTOOLS_DATA_DIR="${path.join(os.homedir(), '.mcptools', 'data')}" -- claude-mcp-server`);
471	    return false;
472	  }
473	}
