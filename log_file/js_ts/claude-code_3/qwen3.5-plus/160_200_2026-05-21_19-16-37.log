262	async def _terminate_process_tree(process: Process | FallbackProcess, timeout_seconds: float = 2.0) -> None:
263	    """
264	    Terminate a process and all its children using platform-specific methods.
265	
266	    Unix: Uses os.killpg() for atomic process group termination
267	    Windows: Uses Job Objects via pywin32 for reliable child process cleanup
268	
269	    Args:
270	        process: The process to terminate
271	        timeout_seconds: Timeout in seconds before force killing (default: 2.0)
272	    """
273	    if sys.platform == "win32":  # pragma: no cover
274	        await terminate_windows_process_tree(process, timeout_seconds)
275	    else:  # pragma: no cover
276	        # FallbackProcess should only be used for Windows compatibility
277	        assert isinstance(process, Process)
278	        await terminate_posix_process_tree(process, timeout_seconds)
