495	function updateGitignore(): void {
496	  logStep('📄', 'Updating .gitignore...');
497	  
498	  const gitignorePath = path.join(process.cwd(), '.gitignore');
499	  const treesummaryEntry = '.treesummary/';
500	  
501	  if (fs.existsSync(gitignorePath)) {
502	    const content = fs.readFileSync(gitignorePath, 'utf8');
503	    
504	    // Check if .treesummary/ is already in .gitignore
505	    if (!content.includes(treesummaryEntry)) {
506	      // Add .treesummary/ to .gitignore
507	      const updatedContent = content + (content.endsWith('\n') ? '' : '\n') + 
508	        '\n# Project analysis cache\n' + treesummaryEntry + '\n';
509	      fs.writeFileSync(gitignorePath, updatedContent);
510	      logSuccess('Added .treesummary/ to .gitignore');
511	    } else {
512	      logSuccess('.treesummary/ already in .gitignore');
513	    }
514	  } else {
515	    // Create .gitignore with .treesummary/ entry
516	    const gitignoreContent = '# Project analysis cache\n.treesummary/\n';
517	    fs.writeFileSync(gitignorePath, gitignoreContent);
518	    logSuccess('Created .gitignore with .treesummary/');
519	  }
520	}
