1	#!/usr/bin/env node
2	/**
3	 * SurrealDB MCP Server
4	 *
5	 * This MCP server provides a standardized interface for AI assistants to interact with a SurrealDB database.
6	 * It implements tools for common SurrealDB operations including:
7	 * - Executing raw SurrealQL queries
8	 * - Selecting, creating, updating, and deleting records
9	 * - Merging and patching data
10	 * - Upserting records
11	 * - Inserting multiple records
12	 * - Creating graph relations between records
13	 */
14	// Redirect console.log and console.error to ensure no logs go to stdout
15	console.log = (...args) => process.stderr.write(args.join(" ") + "\n");
16	console.error = (...args) => process.stderr.write(args.join(" ") + "\n");
17	// MCP SDK Imports
18	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
19	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
20	import { ListToolsRequestSchema, CallToolRequestSchema, ListResourcesRequestSchema, ListResourceTemplatesRequestSchema, ListPromptsRequestSchema, McpError, ErrorCode, } from "@modelcontextprotocol/sdk/types.js";
21	// SurrealDB Import
22	import { Surreal, RecordId } from "surrealdb"; // Import RecordId
23	import { inspect } from "util";
24	// Custom logger that writes to stderr to avoid interfering with JSON-RPC communication
25	const logger = {
26	    info: (...args) => {
27	        const timestamp = new Date().toISOString();
28	        process.stderr.write(`${timestamp} [surrealdb] [info] ${args.map((arg) => (typeof arg === "string" ? arg : inspect(arg))).join(" ")}\n`);
29	    },
30	    error: (...args) => {
31	        const timestamp = new Date().toISOString();
32	        process.stderr.write(`${timestamp} [surrealdb] [error] ${args.map((arg) => (typeof arg === "string" ? arg : inspect(arg))).join(" ")}\n`);
33	    },
34	};
35	// --- Database Configuration ---
36	// Read configuration from environment variables provided by MCP host
37	const DB_ENDPOINT = process.env.SURREALDB_URL;
38	const DB_NAMESPACE = process.env.SURREALDB_NS;
39	const DB_DATABASE = process.env.SURREALDB_DB;
40	const DB_USER = process.env.SURREALDB_USER;
41	const DB_PASS = process.env.SURREALDB_PASS;
42	// -----------------------------
43	// Validate that all required environment variables are set
44	if (!DB_ENDPOINT || !DB_NAMESPACE || !DB_DATABASE || !DB_USER || !DB_PASS) {
45	    logger.error("FATAL ERROR: Missing one or more required SurrealDB environment variables (SURREALDB_URL, SURREALDB_NS, SURREALDB_DB, SURREALDB_USER, SURREALDB_PASS)");
46	    process.exit(1);
47	}
48	// Instantiate the SurrealDB client
49	const db = new Surreal();
50	/**
51	 * Create an MCP server instance.
52	 * Capabilities will be added as tools are implemented.
53	 */
54	// Create server instance
55	const server = new Server({
56	    name: "surrealdb-mcp-server",
57	    version: "0.1.10", // Updated to match current package version
58	}, {
59	    // Declare tool capability
60	    capabilities: {
61	        tools: {}, // This enables tool-related handlers like ListTools and CallTool
62	        resources: {}, // Add resources capability
63	        prompts: {}, // Add prompts capability
64	    },
65	});
66	// --- MCP Request Handlers ---
67	// Handler for listing resources (required by MCP protocol)
68	server.setRequestHandler(ListResourcesRequestSchema, async () => {
69	    logger.info("Handling ListResources request");
70	    return {
71	        resources: [], // Return empty array as we don't have any resources
72	    };
73	});
74	// Handler for listing resource templates (required by MCP protocol)
75	server.setRequestHandler(ListResourceTemplatesRequestSchema, async () => {
76	    logger.info("Handling ListResourceTemplates request");
77	    return {
78	        resourceTemplates: [], // Return empty array as we don't have any resource templates
79	    };
80	});
81	// Handler for listing prompts (required by MCP protocol)
82	server.setRequestHandler(ListPromptsRequestSchema, async () => {
83	    logger.info("Handling ListPrompts request");
