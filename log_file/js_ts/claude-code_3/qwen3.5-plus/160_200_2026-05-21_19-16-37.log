600	@asynccontextmanager
601	async def streamable_http_client(
602	    url: str,
603	    *,
604	    http_client: httpx.AsyncClient | None = None,
605	    terminate_on_close: bool = True,
606	) -> AsyncGenerator[
607	    tuple[
608	        MemoryObjectReceiveStream[SessionMessage | Exception],
609	        MemoryObjectSendStream[SessionMessage],
610	        GetSessionIdCallback,
611	    ],
612	    None,
613	]:
614	    """
615	    Client transport for StreamableHTTP.
616	
617	    Args:
618	        url: The MCP server endpoint URL.
619	        http_client: Optional pre-configured httpx.AsyncClient. If None, a default
620	            client with recommended MCP timeouts will be created. To configure headers,
621	            authentication, or other HTTP settings, create an httpx.AsyncClient and pass it here.
622	        terminate_on_close: If True, send a DELETE request to terminate the session
623	            when the context exits.
624	
625	    Yields:
626	        Tuple containing:
627	            - read_stream: Stream for reading messages from the server
628	            - write_stream: Stream for sending messages to the server
629	            - get_session_id_callback: Function to retrieve the current session ID
630	
631	    Example:
632	        See examples/snippets/clients/ for usage patterns.
633	    """
634	    read_stream_writer, read_stream = anyio.create_memory_object_stream[SessionMessage | Exception](0)
635	    write_stream, write_stream_reader = anyio.create_memory_object_stream[SessionMessage](0)
636	
637	    # Determine if we need to create and manage the client
638	    client_provided = http_client is not None
639	    client = http_client
640	
641	    if client is None:
642	        # Create default client with recommended MCP timeouts
643	        client = create_mcp_http_client()
644	
645	    transport = StreamableHTTPTransport(url)
646	
647	    async with anyio.create_task_group() as tg:
648	        try:
649	            logger.debug(f"Connecting to StreamableHTTP endpoint: {url}")
650	
651	            async with contextlib.AsyncExitStack() as stack:
652	                # Only manage client lifecycle if we created it
653	                if not client_provided:
654	                    await stack.enter_async_context(client)
655	
656	                def start_get_stream() -> None:
657	                    tg.start_soon(transport.handle_get_stream, client, read_stream_writer)
658	
659	                tg.start_soon(
660	                    transport.post_writer,
661	                    client,
662	                    write_stream_reader,
663	                    read_stream_writer,
664	                    write_stream,
665	                    start_get_stream,
666	                    tg,
667	                )
668	
669	                try:
670	                    yield (
671	                        read_stream,
672	                        write_stream,
673	                        transport.get_session_id,
674	                    )
675	                finally:
676	                    if transport.session_id and terminate_on_close:
677	                        await transport.terminate_session(client)
678	                    tg.cancel_scope.cancel()
679	        finally:
680	            await read_stream_writer.aclose()
681	            await write_stream.aclose()
682	
