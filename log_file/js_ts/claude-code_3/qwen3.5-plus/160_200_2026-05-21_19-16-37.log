7	/**
8	 * Represents detailed information about a service running on a host
9	 * This is returned as part of the host information lookup
10	 */
11	export interface ShodanHostService {
12	  /** The port number the service is running on */
13	  port: number;
14	  
15	  /** The transport protocol (tcp/udp) */
16	  transport: string;
17	  
18	  /** Name of the software/product running the service (if detected) */
19	  product?: string;
20	  
21	  /** Version of the software/product (if detected) */
22	  version?: string;
23	  
24	  /** Common Platform Enumeration (CPE) identifiers for the service */
25	  cpe?: string[];
26	  
27	  /** Raw banner data or response received from the service */
28	  data?: string;
29	
30	  /** Vulnerabilities found in this service */
31	  vulns?: ShodanVulnerability[];
32	}
33	
34	/**
35	 * Comprehensive host information returned by Shodan
36	 * Contains everything Shodan knows about a specific IP address
37	 */
38	export interface ShodanHostInfo {
39	  /** String representation of the IP address */
40	  ip_str: string;
41	  
42	  /** City where the host is located (if known) */
43	  city?: string;
44	  
45	  /** Full country name where the host is located */
46	  country_name?: string;
47	  
48	  /** Organization (usually ISP or company) that owns the IP address */
49	  org?: string;
50	  
51	  /** Internet Service Provider (ISP) that owns the IP address */
52	  isp?: string;
53	  
54	  /** Autonomous System Number (ASN) the IP belongs to */
55	  asn?: string;
56	  
57	  /** List of hostnames that resolve to this IP address */
58	  hostnames?: string[];
59	  
60	  /** List of open ports discovered on the host */
61	  ports?: number[];
62	  
63	  /** List of tags associated with the host (e.g., "cloud", "database") */
64	  tags?: string[];
65	  
66	  /** Timestamp of when Shodan last scanned this host */
67	  last_update?: string;
68	  
69	  /** Detailed information about each service discovered on the host */
70	  data?: ShodanHostService[];
