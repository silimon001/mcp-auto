39	export function registerTools(server: McpServer, container: IServiceContainer) {
40	  const hasYoutubeKey = !!process.env.YOUTUBE_API_KEY;
41	  const toolsToRegister: ToolConstructor[] = [];
42	
43	  if (hasYoutubeKey) {
44	    // Register all standard YouTube tools
45	    toolsToRegister.push(...(TOOL_CLASSES as ToolConstructor[]));
46	
47	    // Register analytics tools if connection string is present
48	    if (process.env.MDB_MCP_CONNECTION_STRING) {
49	      toolsToRegister.push(FindConsistentOutlierChannelsTool);
50	    }
51	  } else {
52	    // Only register tools that don't require the API key
53	    toolsToRegister.push(GetTranscriptsTool);
54	  }
55	
56	  for (const ToolClass of toolsToRegister) {
57	    // Instantiate with DI container
58	    const toolInstance = new ToolClass(container);
59	
60	    const humanReadableTitle = toolInstance.name
61	      .replace(/([A-Z])/g, " $1")
62	      .replace(/^./, (str: string) => str.toUpperCase());
63	
64	    // Register with MCP Server
65	    server.registerTool(
66	      toolInstance.name,
67	      {
68	        description: toolInstance.description,
69	        inputSchema: toolInstance.schema,
70	        annotations: {
71	          title: humanReadableTitle,
72	          readOnlyHint: true,
73	          idempotentHint: true,
74	        },
75	      },
76	      // eslint-disable-next-line @typescript-eslint/no-unsafe-argument
77	      (async (
78	        args: z.infer<typeof toolInstance.schema>
79	      ): Promise<CallToolResult> => {
80	        try {
81	          return await toolInstance.execute(args);
82	        } catch (err) {
83	          return formatError(err);
84	        }
85	        // eslint-disable-next-line @typescript-eslint/no-explicit-any
86	      }) as any
87	    );
88	  }
89	}
90	

