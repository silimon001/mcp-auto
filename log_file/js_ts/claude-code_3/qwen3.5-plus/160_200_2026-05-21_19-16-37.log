406	# ==================== 主函数 ====================
407	async def main():
408	
409	    test_flag = True
410	
411	    API_KEY = ''
412	
413	    if test_flag:
414	        API_KEY = os.getenv("QWEN_TMP_KEY")
415	    else:
416	        API_KEY = os.getenv("QWEN_MCP_AUTO_KEY")
417	
