875	async function initializeDatabase(): Promise<void> {
876	  logStep('🗄️', 'Initializing database with migrations...');
877	  
878	  try {
879	    // Ensure data directory exists
880	    fs.mkdirSync(INSTALL_PATHS.DATA_DIR, { recursive: true });
881	    
882	    // Import and initialize DatabaseManager to run migrations
883	    const { DatabaseManager } = await import('../database/drizzle.js');
884	    const db = new DatabaseManager();
885	    
886	    // Initialize will automatically run migrations
887	    await db.initialize();
888	    
889	    // Verify tables exist
890	    const result = db.db.prepare("SELECT name FROM sqlite_master WHERE type='table'").all();
891	    if (result.length === 0) {
892	      throw new Error('No tables created after migration');
893	    }
894	    
895	    // Close the database
896	    db.close();
897	    
898	    logSuccess('Database initialized with migrations');
899	    
900	  } catch (error) {
901	    logWarning(`Database initialization failed: ${error}`);
902	    logWarning('Database will be initialized on first use');
903	    
904	    // Don't fail the installation - database can be initialized later
905	    // This allows the installation to continue even if database setup fails
906	  }
907	}
