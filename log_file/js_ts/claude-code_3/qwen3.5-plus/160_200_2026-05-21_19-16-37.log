407	        try:
408	            event_source = EventSource(response)
409	            async for sse in event_source.aiter_sse():  # pragma: no branch
410	                # Track last event ID for potential reconnection
411	                if sse.id:
412	                    last_event_id = sse.id
413	
414	                # Track retry interval from server
415	                if sse.retry is not None:
416	                    retry_interval_ms = sse.retry
417	
418	                is_complete = await self._handle_sse_event(
419	                    sse,
420	                    ctx.read_stream_writer,
421	                    resumption_callback=(ctx.metadata.on_resumption_token_update if ctx.metadata else None),
422	                    is_initialization=is_initialization,
