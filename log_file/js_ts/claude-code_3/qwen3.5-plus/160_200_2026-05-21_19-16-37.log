368	
369	  // Synchronous transaction wrapper with better retry logic and deadlock prevention
370	  transaction<T>(fn: (db: BetterSQLite3Database<typeof allTables>) => T, retries = 5): T {
371	    let lastError: Error | undefined;
372	    
373	    for (let attempt = 0; attempt <= retries; attempt++) {
374	      try {
375	        // Use immediate transaction for better concurrency
376	        return this.drizzleDb.transaction((tx) => {
377	          return fn(tx);
378	        });
379	      } catch (error) {
380	        lastError = error as Error;
381	        
382	        if (attempt < retries && this.isRetryableError(error)) {
383	          // Exponential backoff with jitter to prevent thundering herd
384	          const baseDelay = Math.min(50 * Math.pow(2, attempt), 2000);
385	          const jitter = Math.random() * 100;
386	          const delay = baseDelay + jitter;
387	          
388	          this.logger.warn(`Transaction failed, retrying in ${Math.round(delay)}ms`, { 
389	            attempt: attempt + 1, 
390	            totalAttempts: retries + 1,
391	            error: (error as Error).message,
392	            errorCode: this.getErrorCode(error)
393	          });
394	          
395	          // Synchronous sleep for better-sqlite3 compatibility
396	          this.sleep(delay);
397	          continue;
398	        }
399	        break;
400	      }
401	    }
402	    
403	    this.logger.error('Transaction failed after all retries', {
404	      attempts: retries + 1,
405	      finalError: lastError?.message,
406	      errorCode: lastError ? this.getErrorCode(lastError) : 'unknown'
407	    });
408	    throw lastError || new Error('Transaction failed with unknown error');
409	  }
410	
411	  // Async transaction wrapper that uses connection pooling
412	  async transactionAsync<T>(fn: (db: BetterSQLite3Database<typeof allTables>) => T, retries = 5): Promise<T> {
413	    let lastError: Error | undefined;
414	    
415	    for (let attempt = 0; attempt <= retries; attempt++) {
416	      try {
417	        // Use Promise wrapper to make it properly async
418	        return await new Promise<T>((resolve, reject) => {
419	          try {
420	            const result = this.drizzleDb.transaction((tx) => {
421	              return fn(tx);
422	            });
423	            resolve(result);
424	          } catch (error) {
425	            reject(error);
426	          }
427	        });
428	      } catch (error) {
429	        lastError = error as Error;
430	        
431	        if (attempt < retries && this.isRetryableError(error)) {
432	          // Exponential backoff with jitter to prevent thundering herd
433	          const baseDelay = Math.min(50 * Math.pow(2, attempt), 2000);
434	          const jitter = Math.random() * 100;
435	          const delay = baseDelay + jitter;
436	          
437	          this.logger.warn(`Async transaction failed, retrying in ${Math.round(delay)}ms`, { 
438	            attempt: attempt + 1, 
439	            totalAttempts: retries + 1,
440	            error: (error as Error).message,
441	            errorCode: this.getErrorCode(error)
442	          });
443	          
444	          // Non-blocking async delay
445	          await this.asyncSleep(delay);
446	          continue;
447	        }
448	        break;
449	      }
450	    }
451	    
452	    this.logger.error('Async transaction failed after all retries', {
453	      attempts: retries + 1,
454	      finalError: lastError?.message,
455	      errorCode: lastError ? this.getErrorCode(lastError) : 'unknown'
456	    });
457	    throw lastError || new Error('Async transaction failed with unknown error');
458	  }
459	
460	  private isRetryableError(error: any): boolean {
461	    const message = error.message?.toLowerCase() || '';
462	    const code = error.code || '';
463	    
464	    // SQLite error codes that are retryable
465	    const retryableCodes = ['SQLITE_BUSY', 'SQLITE_LOCKED', 'SQLITE_PROTOCOL'];
466	    
467	    return retryableCodes.includes(code) ||
468	           message.includes('database is locked') || 
469	           message.includes('busy') || 
470	           message.includes('timeout') ||
471	           message.includes('deadlock') ||
472	           message.includes('lock timeout') ||
473	           message.includes('cannot commit');
474	  }
475	  
476	  private getErrorCode(error: any): string {
477	    return error.code || error.errno || 'UNKNOWN';
478	  }
479	  
480	  private sleep(ms: number): void {
481	    const start = Date.now();
482	    while (Date.now() - start < ms) {
483	      // Busy wait for synchronous sleep in Node.js
484	    }
485	  }
486	
487	  private async asyncSleep(ms: number): Promise<void> {
488	    return new Promise(resolve => setTimeout(resolve, ms));
489	  }
