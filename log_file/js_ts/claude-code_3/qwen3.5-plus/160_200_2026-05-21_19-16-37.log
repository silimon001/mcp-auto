303	// Handler for executing tool calls
304	server.setRequestHandler(CallToolRequestSchema, async (request) => {
305	    switch (request.params.name) {
306	        case "query": {
307	            // Validate input arguments
308	            const queryString = request.params.arguments?.query_string;
309	            if (typeof queryString !== "string" || !queryString.trim()) {
310	                throw new McpError(ErrorCode.InvalidParams, "Missing or invalid 'query_string' argument.");
311	            }
312	            try {
313	                logger.info(`Executing query tool with: ${queryString}`);
314	                // Execute the query using the globally connected db instance
315	                const result = await db.query(queryString);
316	                logger.info("Query executed successfully via tool.");
317	                // Return the result (SurrealDB returns an array of results per query)
318	                return {
319	                    content: [
320	                        {
321	                            type: "text",
322	                            // Convert result to JSON string for transport
323	                            text: JSON.stringify(result, null, 2),
324	                        },
325	                    ],
326	                };
327	            }
328	            catch (e) {
329	                logger.error(`Error executing query tool:`, e); // Log full error object
330	                // Rethrow as an MCPError for the client
331	                throw new McpError(ErrorCode.InternalError, `SurrealDB query failed: ${e instanceof Error ? e.message : String(e)}`);
332	            }
333	        }
334	        case "select": {
335	            // Validate input arguments
336	            const table = request.params.arguments?.table;
337	            const id = request.params.arguments?.id; // Optional
338	            if (typeof table !== "string" || !table.trim()) {
339	                throw new McpError(ErrorCode.InvalidParams, "Missing or invalid 'table' argument.");
