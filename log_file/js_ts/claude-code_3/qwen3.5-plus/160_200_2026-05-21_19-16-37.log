756	// Connection singleton for shared database access
757	class DatabaseConnectionManager {
758	  private static instance: DatabaseManager | null = null;
759	  private static isInitializing = false;
760	  private static initPromise: Promise<DatabaseManager> | null = null;
761	  
762	  static async getInstance(config?: DatabaseConfig): Promise<DatabaseManager> {
763	    // If we already have an instance, return it
764	    if (DatabaseConnectionManager.instance && DatabaseConnectionManager.instance.isInitialized()) {
765	      return DatabaseConnectionManager.instance;
766	    }
767	    
768	    // If we're already initializing, wait for it
769	    if (DatabaseConnectionManager.isInitializing && DatabaseConnectionManager.initPromise) {
770	      return await DatabaseConnectionManager.initPromise;
771	    }
772	    
773	    // Initialize new instance
774	    DatabaseConnectionManager.isInitializing = true;
775	    DatabaseConnectionManager.initPromise = this.createInstance(config);
776	    
777	    try {
778	      DatabaseConnectionManager.instance = await DatabaseConnectionManager.initPromise;
779	      return DatabaseConnectionManager.instance;
780	    } finally {
781	      DatabaseConnectionManager.isInitializing = false;
782	      DatabaseConnectionManager.initPromise = null;
783	    }
784	  }
785	  
786	  private static async createInstance(config?: DatabaseConfig): Promise<DatabaseManager> {
787	    const instance = new DatabaseManager(config);
788	    await instance.initialize();
789	    return instance;
790	  }
791	  
792	  static reset(): void {
793	    if (DatabaseConnectionManager.instance) {
794	      DatabaseConnectionManager.instance.close();
795	      DatabaseConnectionManager.instance = null;
796	    }
797	    DatabaseConnectionManager.isInitializing = false;
798	    DatabaseConnectionManager.initPromise = null;
799	  }
800	}
801	
802	// Export for shared database access
803	export { DatabaseConnectionManager };
804	
805	// Export a default instance for convenience
806	export default DatabaseManager;

