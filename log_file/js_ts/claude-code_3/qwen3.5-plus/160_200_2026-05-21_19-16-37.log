601	  // Health check method
602	  async healthCheck(): Promise<{ status: 'healthy' | 'unhealthy'; details: Record<string, any> }> {
603	    try {
604	      // Test basic connectivity
605	      const result = this.sqlite.prepare('SELECT 1 as test').get() as { test: number };
606	      
607	      if (result.test !== 1) {
608	        throw new Error('Basic connectivity test failed');
609	      }
610	
611	      // Check WAL mode
612	      const walMode = this.sqlite.pragma('journal_mode', { simple: true }) as string;
613	      
614	      // Check foreign keys
615	      const foreignKeys = this.sqlite.pragma('foreign_keys', { simple: true }) as number;
616	
617	      return {
618	        status: 'healthy',
619	        details: {
620	          initialized: this.initialized,
621	          walMode,
622	          foreignKeysEnabled: foreignKeys === 1,
623	        }
624	      };
625	    } catch (error) {
626	      this.logger.error('Health check failed', error);
627	      return {
628	        status: 'unhealthy',
629	        details: {
630	          error: (error as Error).message,
631	          initialized: this.initialized,
632	        }
633	      };
634	    }
635	  }
636	
637	  // Connection pool management methods
638	  async getPooledConnection(): Promise<Database.Database> {
639	    if (!this.connectionPool) {
640	      throw new Error('Connection pooling is not enabled');
641	    }
642	    return await this.connectionPool.getConnection();
643	  }
644	
645	  releasePooledConnection(connection: Database.Database): void {
646	    if (!this.connectionPool) {
647	      this.logger.warn('Attempted to release connection when pooling is not enabled');
648	      return;
649	    }
650	    this.connectionPool.releaseConnection(connection);
651	  }
652	
653	  getConnectionPoolStats() {
654	    if (!this.connectionPool) {
655	      return { enabled: false };
656	    }
657	    return { enabled: true, ...this.connectionPool.getStats() };
658	  }
659	
660	  // Enhanced transaction wrapper using connection pooling when available
661	  async transactionWithPool<T>(fn: (db: BetterSQLite3Database<typeof allTables>) => T | Promise<T>, retries = 5): Promise<T> {
662	    if (!this.config.enableConnectionPooling || !this.connectionPool) {
663	      // Fall back to regular transaction if pooling is disabled
664	      return this.transaction(fn, retries);
665	    }
666	
667	    let connection: Database.Database | null = null;
668	    let lastError: Error | undefined;
669	    
670	    for (let attempt = 0; attempt <= retries; attempt++) {
671	      try {
672	        connection = await this.connectionPool.getConnection();
673	        const pooledDrizzle = drizzle(connection, { schema: allTables });
674	        
675	        const result = await new Promise<T>((resolve, reject) => {
676	          try {
677	            const txResult = pooledDrizzle.transaction((tx) => {
678	              return fn(tx);
679	            });
680	            resolve(txResult);
681	          } catch (error) {
682	            reject(error);
683	          }
684	        });
685	        
686	        this.connectionPool.releaseConnection(connection);
687	        return result;
688	      } catch (error) {
689	        if (connection) {
690	          this.connectionPool.releaseConnection(connection);
691	        }
692	        
693	        lastError = error as Error;
694	        
695	        if (attempt < retries && this.isRetryableError(error)) {
696	          const baseDelay = Math.min(50 * Math.pow(2, attempt), 2000);
697	          const jitter = Math.random() * 100;
698	          const delay = baseDelay + jitter;
699	          
700	          this.logger.warn(`Pooled transaction failed, retrying in ${Math.round(delay)}ms`, { 
701	            attempt: attempt + 1, 
702	            totalAttempts: retries + 1,
703	            error: (error as Error).message,
704	            errorCode: this.getErrorCode(error)
705	          });
706	          
707	          await this.asyncSleep(delay);
708	          continue;
709	        }
710	        break;
711	      }
712	    }
713	    
714	    this.logger.error('Pooled transaction failed after all retries', {
715	      attempts: retries + 1,
716	      finalError: lastError?.message,
717	      errorCode: lastError ? this.getErrorCode(lastError) : 'unknown'
718	    });
719	    throw lastError || new Error('Pooled transaction failed with unknown error');
720	  }
721	
722	  close(): void {
723	    try {
724	      this.logger.info('Closing DrizzleManager...');
725	      
726	      // Stop periodic checkpointing
727	      if (this.checkpointInterval) {
728	        clearInterval(this.checkpointInterval);
729	        this.checkpointInterval = undefined;
730	      }
731	      
732	      // Final WAL checkpoint before closing
733	      if (this.config.wal && this.isMainProcess) {
734	        try {
735	          this.checkpointWal();
736	        } catch (error) {
737	          this.logger.warn('Final WAL checkpoint failed during close', error);
738	        }
739	      }
740	      
741	      // Close connection pool
742	      if (this.connectionPool) {
743	        this.connectionPool.close();
744	        this.logger.info('Connection pool closed');
745	      }
746	      
747	      this.sqlite.close();
748	      this.initialized = false;
749	      this.logger.info('DrizzleManager closed successfully');
750	    } catch (error) {
751	      this.logger.error('Error closing DrizzleManager', error);
752	    }
753	  }
754	}
