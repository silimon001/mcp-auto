504	  private startPeriodicCheckpointing(): void {
505	    if (this.checkpointInterval) {
506	      clearInterval(this.checkpointInterval);
507	    }
508	    
509	    this.checkpointInterval = setInterval(() => {
510	      try {
511	        this.checkpointWal();
512	      } catch (error) {
513	        this.logger.warn('Periodic WAL checkpoint failed', error);
514	      }
515	    }, this.config.checkpointIntervalMs);
516	    
517	    this.logger.debug('Started periodic WAL checkpointing', {
518	      intervalMs: this.config.checkpointIntervalMs
519	    });
520	  }
