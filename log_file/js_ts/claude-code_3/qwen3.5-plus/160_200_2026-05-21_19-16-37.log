397	    async def _handle_sse_response(
398	        self,
399	        response: httpx.Response,
400	        ctx: RequestContext,
401	        is_initialization: bool = False,
402	    ) -> None:
403	        """Handle SSE response from the server."""
404	        last_event_id: str | None = None
405	        retry_interval_ms: int | None = None
