476	                async for sse in event_source.aiter_sse():
477	                    if sse.id:  # pragma: no branch
478	                        reconnect_last_event_id = sse.id
479	                    if sse.retry is not None:
480	                        reconnect_retry_ms = sse.retry
481	
482	                    is_complete = await self._handle_sse_event(
483	                        sse,
484	                        ctx.read_stream_writer,
485	                        original_request_id,
486	                        ctx.metadata.on_resumption_token_update if ctx.metadata else None,
487	                    )
488	                    if is_complete:
