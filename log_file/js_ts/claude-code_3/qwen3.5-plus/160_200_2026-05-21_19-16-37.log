494	      if (result.test !== 1) {
495	        throw new Error('Database connectivity test failed');
496	      }
497	      this.logger.debug('Database connection verified');
498	    } catch (error) {
499	      this.logger.error('Database connection verification failed', error);
500	      throw error;
501	    }
502	  }
