247	    async def handle_get_stream(
248	        self,
249	        client: httpx.AsyncClient,
250	        read_stream_writer: StreamWriter,
251	    ) -> None:
252	        """Handle GET stream for server-initiated messages with auto-reconnect."""
253	        last_event_id: str | None = None
254	        retry_interval_ms: int | None = None
255	        attempt: int = 0
256	
257	        while attempt < MAX_RECONNECTION_ATTEMPTS:  # pragma: no branch
258	            try:
259	                if not self.session_id:
260	                    return
261	
262	                headers = self._prepare_headers()
263	                if last_event_id:
264	                    headers[LAST_EVENT_ID] = last_event_id  # pragma: no cover
265	
266	                async with aconnect_sse(
267	                    client,
268	                    "GET",
269	                    self.url,
270	                    headers=headers,
271	                ) as event_source:
272	                    event_source.response.raise_for_status()
273	                    logger.debug("GET SSE connection established")
274	
275	                    async for sse in event_source.aiter_sse():
276	                        # Track last event ID for reconnection
277	                        if sse.id:
278	                            last_event_id = sse.id  # pragma: no cover
279	                        # Track retry interval from server
280	                        if sse.retry is not None:
281	                            retry_interval_ms = sse.retry  # pragma: no cover
282	
283	                        await self._handle_sse_event(sse, read_stream_writer)
