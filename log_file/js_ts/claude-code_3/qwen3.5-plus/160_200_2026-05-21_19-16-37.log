219	def _get_executable_command(command: str) -> str:
220	    """
221	    Get the correct executable command normalized for the current platform.
222	
223	    Args:
224	        command: Base command (e.g., 'uvx', 'npx')
225	
226	    Returns:
227	        str: Platform-appropriate command
228	    """
229	    if sys.platform == "win32":  # pragma: no cover
230	        return get_windows_executable_command(command)
231	    else:
232	        return command  # pragma: no cover
