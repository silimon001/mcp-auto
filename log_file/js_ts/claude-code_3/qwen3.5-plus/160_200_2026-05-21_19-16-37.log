38	// Connection pool for managing multiple database connections
39	class ConnectionPool {
40	  private connections: Database.Database[] = [];
41	  private availableConnections: Database.Database[] = [];
42	  private busyConnections = new Set<Database.Database>();
43	  private readonly maxConnections: number;
44	  private readonly dbPath: string;
45	  private readonly config: DatabaseConfig;
46	  private readonly logger: Logger;
47	
48	  constructor(dbPath: string, config: DatabaseConfig, logger: Logger) {
49	    this.dbPath = dbPath;
50	    this.config = config;
51	    this.logger = logger;
52	    this.maxConnections = config.connectionPoolSize || 5;
53	  }
54	
55	  async getConnection(): Promise<Database.Database> {
56	    // Try to get an available connection first
57	    if (this.availableConnections.length > 0) {
58	      const conn = this.availableConnections.pop()!;
59	      this.busyConnections.add(conn);
60	      return conn;
61	    }
62	
63	    // Create new connection if under limit
64	    if (this.connections.length < this.maxConnections) {
65	      const conn = this.createConnection();
66	      this.connections.push(conn);
67	      this.busyConnections.add(conn);
68	      return conn;
69	    }
70	
71	    // Wait for a connection to become available
72	    return new Promise((resolve) => {
73	      const checkForConnection = () => {
74	        if (this.availableConnections.length > 0) {
75	          const conn = this.availableConnections.pop()!;
76	          this.busyConnections.add(conn);
77	          resolve(conn);
78	        } else {
79	          setTimeout(checkForConnection, 10);
80	        }
81	      };
82	      checkForConnection();
83	    });
84	  }
85	
86	  releaseConnection(connection: Database.Database): void {
87	    if (this.busyConnections.has(connection)) {
88	      this.busyConnections.delete(connection);
89	      this.availableConnections.push(connection);
90	    }
91	  }
92	
93	  private createConnection(): Database.Database {
94	    const conn = new Database(this.dbPath, {
95	      verbose: this.config.verbose ? ((message?: unknown) => this.logger.debug(String(message))) : undefined,
96	      timeout: this.config.timeout,
97	      fileMustExist: false,
98	    });
99	
100	    this.initializeConnectionPragmas(conn);
101	    return conn;
102	  }
103	
104	  private initializeConnectionPragmas(connection: Database.Database): void {
105	    try {
106	      // Enhanced WAL configuration for maximum concurrency
107	      if (this.config.wal) {
108	        connection.pragma('journal_mode = WAL');
109	        connection.pragma('wal_autocheckpoint = 1000'); // Checkpoint every 1000 pages
110	        connection.pragma('wal_checkpoint_timeout = 10000'); // 10 second timeout
111	        connection.pragma('wal_synchronous = NORMAL'); // Balance safety and performance
112	      }
113	      
114	      // Critical concurrency settings with optimized values
115	      connection.pragma(`busy_timeout = ${this.config.busyTimeoutMs || 30000}`);
116	      connection.pragma('synchronous = NORMAL'); // NORMAL instead of FULL for better performance
117	      connection.pragma('cache_size = -131072'); // 128MB cache (larger for better performance)
118	      connection.pragma('temp_store = MEMORY');
119	      connection.pragma('foreign_keys = ON');
120	      
121	      // Enhanced performance optimizations for concurrency
122	      connection.pragma('mmap_size = 536870912'); // 512MB memory-mapped I/O (increased)
123	      connection.pragma('page_size = 4096'); // Optimal page size
124	      connection.pragma('cache_spill = OFF'); // Keep cache in memory
125	      connection.pragma('locking_mode = NORMAL'); // Allow shared access (crucial for concurrency)
126	      
127	      // Additional concurrency improvements
128	      connection.pragma('read_uncommitted = ON'); // Allow dirty reads for better concurrency
129	      connection.pragma('recursive_triggers = ON');
130	      connection.pragma('defer_foreign_keys = ON'); // Defer FK checks to end of transaction
131	      connection.pragma('optimize'); // Auto-optimize statistics
132	
133	      this.logger.debug('Connection-level SQLite pragmas configured', {
134	        connectionId: connection.name || 'unnamed',
135	        walMode: this.config.wal,
136	        busyTimeout: this.config.busyTimeoutMs,
137	        cacheSize: '128MB',
138	        mmapSize: '512MB'
139	      });
140	    } catch (error) {
141	      this.logger.error('Failed to configure connection pragmas', error);
142	      throw error;
143	    }
144	  }
145	
146	  close(): void {
147	    [...this.connections].forEach(conn => {
148	      try {
149	        conn.close();
150	      } catch (error) {
151	        this.logger.warn('Error closing connection', error);
152	      }
153	    });
154	    this.connections.length = 0;
155	    this.availableConnections.length = 0;
156	    this.busyConnections.clear();
157	  }
158	
159	  getStats() {
160	    return {
161	      total: this.connections.length,
162	      available: this.availableConnections.length,
163	      busy: this.busyConnections.size,
164	      maxConnections: this.maxConnections
165	    };
166	  }
167	}
