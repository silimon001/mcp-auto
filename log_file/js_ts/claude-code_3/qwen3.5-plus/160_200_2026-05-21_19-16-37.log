524	    async def post_writer(
525	        self,
526	        client: httpx.AsyncClient,
527	        write_stream_reader: StreamReader,
528	        read_stream_writer: StreamWriter,
529	        write_stream: MemoryObjectSendStream[SessionMessage],
530	        start_get_stream: Callable[[], None],
531	        tg: TaskGroup,
532	    ) -> None:
533	        """Handle writing requests to the server."""
534	        try:
535	            async with write_stream_reader:
536	                async for session_message in write_stream_reader:
537	                    message = session_message.message
538	                    metadata = (
539	                        session_message.metadata
540	                        if isinstance(session_message.metadata, ClientMessageMetadata)
541	                        else None
542	                    )
