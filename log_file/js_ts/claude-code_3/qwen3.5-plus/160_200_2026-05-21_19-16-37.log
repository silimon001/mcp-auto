7	
8	import type { McpConfig } from './types/config.js'
9	import type { JsonRpcRequest } from './types/jsonrpc.js'
10	import type {
11	  ToolList,
12	  ResourceList,
13	  PromptList,
14	  Method as MethodInterface,
15	} from './types/method.js'
16	import type { Transport } from './server/contracts/transport.js'
17	import type { LoggerService, EmitterService } from '@adonisjs/core/types'
18	
19	import { createError } from '@adonisjs/core/exceptions'
20	import { ErrorCode } from './enums/error.js'
21	import ServerContext from './server/context.js'
22	import JsonRpcException from './server/exceptions/jsonrpc_exception.js'
23	
24	type Services = {
25	  logger: LoggerService
26	  emitter: EmitterService
27	}
28	
29	export default class Server {
30	  #logger?: LoggerService
31	  #emitter?: EmitterService
32	  #transport?: Transport
33	
34	  config: McpConfig
35	  name: string = 'AdonisJS MCP Server'
36	  version: string = '1.0.0'
37	  instructions: string = 'This MCP server lets AI agents interact with our AdonisJS application.'
38	
39	  supportedProtocolVersion: string[] = ['2025-11-25', '2025-06-18']
40	
41	  capabilities: Record<string, any> = {
42	    tools: {
43	      listChanged: false,
44	    },
45	    resources: {
46	      listChanged: false,
47	    },
48	    prompts: {
49	      listChanged: false,
50	    },
51	  }
52	
53	  tools: ToolList = {}
54	  resources: ResourceList = {}
55	  resourceTemplates: ResourceList = {}
56	  prompts: PromptList = {}
57	
58	  maxPaginationLength: number = 50
59	  defaultPaginationLength: number = 15
60	
61	  methods = {
62	    'initialize': () => import('./server/methods/initialize.js'),
63	    'tools/list': () => import('./server/methods/list_tools.js'),
64	    'tools/call': () => import('./server/methods/call_tool.js'),
65	    'resources/list': () => import('./server/methods/list_resources.js'),
66	    'resources/read': () => import('./server/methods/read_resource.js'),
67	    'resources/templates/list': () => import('./server/methods/list_resource_templates.js'),
68	    'prompts/list': () => import('./server/methods/list_prompts.js'),
69	    'prompts/get': () => import('./server/methods/get_prompt.js'),
70	    'completion/complete': () => import('./server/methods/completion.js'),
71	    'ping': () => import('./server/methods/ping.js'),
72	  }
73	
74	  constructor(config: McpConfig, services?: Services) {
75	    this.config = config
76	
77	    if (config.name) {
78	      this.name = config.name
79	    }
80	
81	    if (config.version) {
82	      this.version = config.version
83	    }
84	
85	    if (config.instructions) {
86	      this.instructions = config.instructions
87	    }
88	
89	    if (config.maxPaginationLength) {
90	      this.maxPaginationLength = config.maxPaginationLength
91	    }
92	
93	    if (config.defaultPaginationLength) {
94	      this.defaultPaginationLength = config.defaultPaginationLength
95	    }
96	
97	    if (config.completions) {
98	      this.addCapability('completions')
99	    }
100	
101	    this.#logger = services?.logger
102	    this.#emitter = services?.emitter
103	  }
104	
105	  addCapability(key: string, value: boolean = true) {
106	    if (key.includes('.')) {
107	      const [root, child] = key.split('.')
108	      let existing = this.capabilities[root] ?? {}
109	
110	      existing[child] = value
111	      this.capabilities[root] = existing
112	
113	      return
114	    }
115	
116	    this.capabilities[key] = {}
117	  }
118	
119	  addTool(item: ToolList) {
120	    this.tools = { ...this.tools, ...item }
121	  }
122	  addResource(item: ResourceList) {
123	    this.resources = { ...this.resources, ...item }
124	  }
125	  addResourceTemplate(item: ResourceList) {
126	    this.resourceTemplates = { ...this.resourceTemplates, ...item }
127	  }
128	  addPrompt(item: PromptList) {
129	    this.prompts = { ...this.prompts, ...item }
130	  }
131	
132	  async connect(transport: Transport) {
133	    this.#transport = transport
134	  }
135	
136	  async handle(jsonRequest: JsonRpcRequest) {
137	    this.#emitter?.emit('mcp:request', jsonRequest)
138	
139	    // INGORE NOTIFICATIONS FOR NOW
140	    if (jsonRequest.method.startsWith('notifications/')) {
141	      return null
142	    }
143	
144	    const mcpContext = this.createContext(jsonRequest)
145	
146	    if (!this.#transport) {
147	      throw createError('No transport connected.', 'E_NO_TRANSPORT_CONNECTED', 500)
148	    } else {
149	      this.#transport.bindBouncer?.(mcpContext)
150	      this.#transport.bindAuth?.(mcpContext)
151	    }
152	
153	    try {
154	      if (Object.keys(this.methods).includes(jsonRequest.method)) {
155	        const lazyMethod = this.methods[jsonRequest.method as keyof typeof this.methods]
156	        const { default: MethodClass } = await lazyMethod()
157	        // Cast the dynamically imported class to a constructor of the Method interface
158	        const instance = new (MethodClass as unknown as { new (...args: any[]): MethodInterface })()
159	
160	        // Ensure the instance is treated as MethodInterface when calling handle to satisfy TS
161	        const response = await (instance as unknown as MethodInterface).handle(mcpContext)
162	
163	        this.#emitter?.emit('mcp:response', response)
164	        this.#transport.send(response)
165	      } else {
166	        const jsonRpcException = new JsonRpcException(
167	          `The method ${jsonRequest.method} was not found.`,
168	          ErrorCode.MethodNotFound,
169	          jsonRequest.id
170	        )
171	        throw jsonRpcException
172	      }
173	    } catch (error: unknown) {
174	      let response
175	      if (error instanceof JsonRpcException) {
176	        response = error.toJsonRpcResponse()
177	        this.#logger?.error(response, error.message)
178	      } else {
179	        response = new JsonRpcException('Internal error', ErrorCode.InternalError, jsonRequest.id, {
180	          error: {
181	            name: (error as Error).name,
182	            message: (error as Error).message,
183	          },
184	        }).toJsonRpcResponse()
185	        this.#logger?.error(error)
186	      }
187	
188	      this.#emitter?.emit('mcp:response', response)
189	      return this.#transport.send(response)
190	    }
191	  }
192	
193	  createContext(jsonRpcRequest: JsonRpcRequest) {
194	    return new ServerContext({
195	      supportedProtocolVersions: this.supportedProtocolVersion,
196	      serverCapabilities: this.capabilities,
197	      serverName: this.name,
198	      serverVersion: this.version,
199	      instructions: this.instructions,
200	      maxPaginationLength: this.maxPaginationLength,
201	      defaultPaginationLength: this.defaultPaginationLength,
202	      tools: this.tools,
203	      resources: this.resources,
204	      resourceTemplates: this.resourceTemplates,
205	      prompts: this.prompts,
206	      jsonRpcRequest,
207	    })
208	  }
209	}
