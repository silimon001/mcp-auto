557	  // Schema migration helpers
558	  async runSchemaMigration(migrationSql: string, version: string): Promise<void> {
559	    try {
560	      this.logger.info(`Running schema migration: ${version}`);
561	      
562	      // Check if migration already applied
563	      const existingMigration = this.sqlite
564	        .prepare('SELECT hash FROM __drizzle_migrations WHERE hash = ?')
565	        .get(version);
566	      
567	      if (existingMigration) {
568	        this.logger.info(`Migration ${version} already applied, skipping`);
569	        return;
570	      }
571	
572	      // Run the migration within a transaction
573	      this.transaction((tx) => {
574	        tx.run(sql.raw(migrationSql));
575	        // Mark migration as applied
576	        this.sqlite
577	          .prepare('INSERT INTO __drizzle_migrations (hash, created_at) VALUES (?, ?)')
578	          .run(version, Date.now());
579	      });
580	
581	      this.logger.info(`Schema migration ${version} completed successfully`);
582	    } catch (error) {
583	      this.logger.error(`Schema migration ${version} failed`, error);
584	      throw error;
585	    }
586	  }
587	
588	  async getAppliedMigrations(): Promise<string[]> {
589	    try {
590	      const migrations = this.sqlite
591	        .prepare('SELECT hash FROM __drizzle_migrations ORDER BY created_at')
592	        .all() as Array<{ hash: string }>;
593	      
594	      return migrations.map(m => m.hash);
595	    } catch (error) {
596	      this.logger.debug('No migrations table found or error reading migrations', error);
597	      return [];
598	    }
599	  }
