8	import type { ApplicationService } from '@adonisjs/core/types'
9	import type { RouteGroup } from '@adonisjs/core/http'
10	import type { McpConfig } from '../src/types/config.js'
11	import type { JsonRpcRequest, JsonRpcResponse } from '../src/types/jsonrpc.js'
12	
13	import { join } from 'node:path'
14	import { pathToFileURL } from 'node:url'
15	import { fsReadAll } from '@adonisjs/core/helpers'
16	import string from '@adonisjs/core/helpers/string'
17	import { UriTemplate } from '../src/utils/uri_template.js'
18	import McpServer from '../src/server.js'
19	
20	export default class McpProvider {
21	  constructor(protected app: ApplicationService) {}
22	
23	  register() {
24	    this.app.container.singleton('jrmc.mcp', async () => {
25	      const config = this.app.config.get<McpConfig>('mcp', {})
26	      const logger = await this.app.container.make('logger')
27	      const emitter = await this.app.container.make('emitter')
28	
29	      return new McpServer(config, { logger, emitter })
30	    })
31	  }
32	
33	  async start() {
34	    const router = await this.app.container.make('router')
35	    const McpController = () => import('../src/server/controllers/mcp_controller.js')
36	
37	    router.mcp = (pattern: string = '/mcp') => {
38	      return router.group(() => {
39	        router.post(pattern, [McpController, 'post'])
40	      })
41	    }
42	
43	    await this.registerTools()
44	    await this.registerResources()
45	    await this.registerPrompts()
46	  }
47	
48	  async registerTools() {
49	    this.registerMethods('tool')
50	  }
51	
52	  async registerResources() {
53	    this.registerMethods('resource')
54	  }
55	
56	  async registerPrompts() {
57	    this.registerMethods('prompt')
58	  }
59	
60	  async registerMethods(type: 'tool' | 'resource' | 'prompt') {
61	    const server = await this.app.container.make('jrmc.mcp')
62	    const mcpPath = this.app.makePath(
63	      this.app.rcFile.directories['mcp'] || 'app/mcp/',
64	      `${string.plural(type)}/`
65	    )
66	    const files = await fsReadAll(mcpPath, {
67	      filter: (filePath) =>
68	        !filePath.endsWith('.map') &&
69	        (filePath.includes(`_${type}.ts`) || filePath.includes(`_${type}.js`)),
70	    })
71	
72	    await Promise.all(
73	      files.map(async (file) => {
74	        const path = pathToFileURL(join(mcpPath, file)).href
75	        const { default: Method } = await import(path)
76	        const instance = new Method()
77	        const entry = { path, json: instance.toJson() }
78	
79	        switch (type) {
80	          case 'tool':
81	            server.addTool({
82	              [instance.name]: entry,
83	            })
84	            break
85	          case 'resource':
86	            if (UriTemplate.isTemplate(instance.uri)) {
87	              server.addResourceTemplate({
88	                [instance.uri]: entry,
89	              })
90	            } else {
91	              server.addResource({
92	                [instance.uri]: entry,
93	              })
94	            }
95	            break
96	          case 'prompt':
97	            server.addPrompt({
98	              [instance.name]: entry,
99	            })
100	            break
101	        }
102	      })
103	    )
104	  }
105	}
106	
107	declare module '@adonisjs/core/http' {
108	  interface Router {
109	    mcp: (pattern?: string) => RouteGroup
110	  }
111	}
112	
113	declare module '@adonisjs/core/types' {
