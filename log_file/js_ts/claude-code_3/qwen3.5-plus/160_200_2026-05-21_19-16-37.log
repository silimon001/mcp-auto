133	# ==================== LLM 客户端 ====================
134	class LLMClient:
135	    """封装与 LLM 的通信"""
136	    def __init__(self, config: Config, logger: Logger):
137	        self.config = config
138	        self.logger = logger
139	        self.communicate_count = 0
140	
141	    @staticmethod
142	    def _delete_reasoning(msg: dict) -> dict:
143	        """移除 reasoning_content 字段"""
144	        if 'reasoning_content' in msg:
145	            return {k: v for k, v in msg.items() if k != 'reasoning_content'}
146	        return msg
147	
148	    def communicate(self, messages: List[dict], tools: List[dict]) -> dict:
149	        """发送请求并返回解析后的响应和用量"""
150	        response = None
151	        if self.config.base_url == 'https://dashscope.aliyuncs.com/compatible-mode/v1':
152	            session = OpenAI(
153	                api_key=self.config.api_key,
154	                base_url=self.config.base_url,
155	            )
156	            response = session.chat.completions.create(
157	                model=self.config.model,
158	                messages=messages,
159	                tools=tools,
160	                stream=self.config.is_streaming,
161	                temperature=0.1, # (0, 2]
162	                tool_choice="auto",
163	                extra_body={"enable_thinking": self.config.enable_thinking}
164	            )
165	            usage = response.usage.to_dict()
166	            choices = response.choices[0].message.to_dict()
167	        else:
168	            # 预留其他 API 适配位置
169	            raise NotImplementedError("Unsupported base_url")
170	
171	        self.communicate_count += 1
172	        self.logger.log(f"--- Communicate Count: {self.communicate_count} ---")
173	        return {
174	            'usage': usage,
175	            'response': self._delete_reasoning(choices)
176	        }
