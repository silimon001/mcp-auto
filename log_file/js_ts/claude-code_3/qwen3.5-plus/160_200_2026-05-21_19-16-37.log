422	    model_name = 'qwen3.5-plus'
423	    config = Config(pos, count, model_name, enable_logging=True)
424	    config.set_llm(
425	        model=model_name,
426	        base_url='https://dashscope.aliyuncs.com/compatible-mode/v1',
427	        api_key=API_KEY,
428	        is_streaming=False,
429	        enable_thinking=True
430	    )
