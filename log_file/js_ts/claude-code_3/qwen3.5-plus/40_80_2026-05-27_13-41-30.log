# Rate Limiting Configuration
GITHUB_RATE_LIMIT_PER_MINUTE=300
FORUM_RATE_LIMIT_PER_MINUTE=100
EMBEDDING_BATCH_SIZE=100
COLLECTION_BATCH_SIZE=50
MAX_RETRY_ATTEMPTS=3
BASE_RETRY_DELAY_MS=1000

