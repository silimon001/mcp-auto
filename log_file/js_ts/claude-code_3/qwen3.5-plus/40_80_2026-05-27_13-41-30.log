1	// Main Express server for SilverBullet MCP
2	
3	import express from 'express';
4	import { randomUUID } from 'node:crypto';
5	import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
6	import { StreamableHTTPServerTransport } from '@modelcontextprotocol/sdk/server/streamableHttp.js';
7	
8	import { PORT, validateConfiguration, logConfiguration, logStartupSuccess } from './config.js';
9	import { mcpAuthMiddleware } from './middleware.js';
10	import { configureMcpServerInstance } from './mcp-server.js';
11	
12	const app = express();
13	app.use(express.json());
14	
15	// Map to store transports by session ID
16	const transports: { [sessionId: string]: StreamableHTTPServerTransport } = {};
17	// Map to store MCP server instances by session ID
18	const mcpServers: { [sessionId: string]: McpServer } = {};
19	
20	// Default route - no authentication required
21	app.get('/', (req, res) => {
22	    res.json({
23	        service: 'SilverBullet MCP Server',
24	        version: '0.1.0',
25	        status: 'running',
26	        authentication: 'required for /mcp routes',
27	        timestamp: new Date().toISOString(),
28	    });
29	});
30	
31	// Apply auth middleware to all /mcp routes only
32	app.use('/mcp', mcpAuthMiddleware);
33	
34	// Handle POST requests for client-to-server communication
35	app.post('/mcp', async (req, res) => {
36	    const sessionId = req.headers['mcp-session-id'] as string | undefined;
37	    
38	    let transport: StreamableHTTPServerTransport;
39	    let mcpServer: McpServer;
40	
41	    if (sessionId && transports[sessionId] && mcpServers[sessionId]) {
42	        transport = transports[sessionId];
43	        mcpServer = mcpServers[sessionId];
44	    } else {
45	        // Create new session
46	        const newSessionId = randomUUID();
47	
48	        transport = new StreamableHTTPServerTransport({
49	            sessionIdGenerator: () => newSessionId,
50	            onsessioninitialized: (sId) => {
51	                transports[sId] = transport;
52	                mcpServers[sId] = mcpServer;
53	            },
54	        });
55	
56	        mcpServer = new McpServer({
57	            name: 'SilverBullet MCP',
58	            version: '0.1.0',
59	        });
60	        configureMcpServerInstance(mcpServer);
61	
62	        transport.onclose = () => {
63	            if (transport.sessionId) {
64	                delete transports[transport.sessionId];
65	                delete mcpServers[transport.sessionId];
66	                mcpServer.close();
67	            }
68	        };
69	
70	        await mcpServer.connect(transport);
71	    }
72	
73	    try {
74	        await transport.handleRequest(req, res, req.body);
75	    } catch (error) {
76	        console.error(`[POST /mcp] Error handling MCP request:`, error);
77	        if (!res.headersSent) {
78	            res.status(500).json({
79	                jsonrpc: '2.0',
80	                error: {
81	                    code: -32603,
82	                    message: 'Internal server error during request handling.',
83	                },
84	                id: req.body?.id || null,
85	            });
86	        }
87	    }
88	});
89	
90	// Reusable handler for GET and DELETE requests
91	const handleSessionRequest = async (
92	    req: express.Request,
93	    res: express.Response
94	) => {
95	    const sessionId = req.headers['mcp-session-id'] as string | undefined;
96	
97	    if (!sessionId || !transports[sessionId]) {
98	        res.status(400).send('Invalid or missing session ID');
99	        return;
100	    }
101	
102	    const transport = transports[sessionId];
103	    try {
104	        await transport.handleRequest(req, res);
105	    } catch (error) {
106	        console.error(`[handleSessionRequest] Error handling session event:`, error);
107	        if (!res.headersSent) {
108	            res.status(500).send('Internal server error during session event handling.');
109	        } else {
110	            res.end();
111	        }
112	    }
113	};
114	
115	// Handle GET requests for server-to-client notifications via SSE
116	app.get('/mcp', (req, res) => {
117	    handleSessionRequest(req, res);
118	
119	    // Send periodic SSE comment heartbeats to keep the connection alive.
120	    // Lines starting with ':' are SSE comments — ignored by clients but
121	    // prevent idle-timeout disconnects from proxies and HTTP clients.
122	    const heartbeat = setInterval(() => {
123	        if (!res.writableEnded) {
124	            res.write(': heartbeat\n\n');
125	        } else {
126	            clearInterval(heartbeat);
127	        }
128	    }, 30_000);
129	    res.on('close', () => clearInterval(heartbeat));
130	    res.on('error', () => clearInterval(heartbeat));
131	});
132	
133	// Handle DELETE requests for session termination
134	app.delete('/mcp', async (req: express.Request, res: express.Response) => {
135	    const sessionId = req.headers['mcp-session-id'] as string | undefined;
136	
137	    if (!sessionId || !transports[sessionId]) {
138	        res.status(400).send('Invalid or missing session ID for DELETE');
139	        return;
140	    }
141	
142	    const transport = transports[sessionId];
143	    const mcpServer = mcpServers[sessionId];
144	
145	    try {
146	        await transport.handleRequest(req, res);
147	    } catch (error) {
148	        console.error(`[DELETE /mcp] Error during DELETE handling:`, error);
149	        if (!res.headersSent) {
150	            res.status(500).send('Internal server error during session termination.');
151	        }
152	    } finally {
153	        if (mcpServer) {
154	            mcpServer.close();
155	        }
156	        if (transport) {
157	            transport.close();
158	        }
159	        if (sessionId) {
160	            delete transports[sessionId];
161	            delete mcpServers[sessionId];
162	        }
163	        if (!res.headersSent) {
164	            res.status(204).send();
165	        } else if (!res.writableEnded) {
166	            res.end();
167	        }
168	    }
169	});
170	
171	// Validate configuration and start server
172	validateConfiguration();
173	logConfiguration();
174	
175	app.listen(PORT, () => {
176	    logStartupSuccess();
177	});
