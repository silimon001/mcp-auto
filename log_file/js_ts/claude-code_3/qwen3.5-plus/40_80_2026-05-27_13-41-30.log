405	    async getVirtualKeyForChar(char: string): Promise<number> {
406	        const upperChar = char.toUpperCase()
407	        if (upperChar === ' ') return VirtualKeys.SPACE
408	        if (upperChar === ':') return VirtualKeys.COLON
409	        if (upperChar >= 'A' && upperChar <= 'Z') {
410	            return VirtualKeys[upperChar as keyof typeof VirtualKeys]
411	        }
