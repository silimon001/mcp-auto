76	      console.log("Parsed successfully, items:", Array.isArray(parsed) ? parsed.length : 'not array');
77	      return Array.isArray(parsed) ? parsed : [parsed];
78	    } catch (parseError) {
79	      console.log("Failed to parse extracted JSON:", parseError);
80	      return [];
81	    }
82	  }
83	  
84	  console.log("No untrusted-data match found");
85	  return [];
86	}
