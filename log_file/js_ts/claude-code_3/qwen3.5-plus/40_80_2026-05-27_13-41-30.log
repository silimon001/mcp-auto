[USER]:
1	/**
2	 * @fileoverview Main entry point for the MCP (Model Context Protocol) Cursor integration.
3	 * This file sets up a server that handles code execution requests in isolated workspaces.
4	 * It implements the MCP protocol for communication between Cursor IDE and the execution environment.
5	 */
6	
7	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js'
8	import { Server } from '@modelcontextprotocol/sdk/server/index.js'
9	import { ListToolsRequestSchema, CallToolRequestSchema } from '@modelcontextprotocol/sdk/types.js'
10	import { CursorInstanceManagerImpl } from './managers/CursorInstanceManager.js'
11	import { CursorToolHandler } from './handlers/CursorToolHandler.js'
12	import { CursorTools } from './tools/cursor-tools.js'
13	
14	async function main() {
15	    const server = new Server(
16	        {
17	            name: 'cursor-mcp',
18	            version: '1.0.0'
19	        },
20	        {
21	            capabilities: {
22	                tools: {
23	                    listChanged: true
24	                }
25	            }
26	        }
27	    )
28	
29	    const cursorManager = new CursorInstanceManagerImpl()
30	    const toolHandler = new CursorToolHandler(cursorManager)
31	
32	    server.setRequestHandler(ListToolsRequestSchema, () => {
33	        return { tools: CursorTools }
34	    })
35	
36	    server.setRequestHandler(CallToolRequestSchema, async (request) => {
37	        const { name, _meta } = request.params
38	        const params = request.params.arguments || {}
39	        
40	        switch (name) {
41	            case 'open_cursor':
42	                return toolHandler.handleOpenCursor(params)
43	            case 'cursor_command':
44	                return toolHandler.handleCursorCommand(params)
45	            case 'open_cline_tab':
46	                return toolHandler.handleOpenClineTab(params)
47	            default:
48	                throw new Error(`Unknown tool: ${name}`)
49	        }
50	    })
51	
52	    const transport = new StdioServerTransport()
53	    await server.connect(transport)
54	}
55	
56	main().catch(error => {
57	    console.error('Server error:', error)
58	    process.exit(1)
59	})

