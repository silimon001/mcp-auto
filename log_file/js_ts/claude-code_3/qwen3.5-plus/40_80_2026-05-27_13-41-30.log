414	    env.ENVIRONMENT === "development" &&
415	    env.DISABLE_ADMIN_AUTH_FOR_LOCAL_DEV === "true"
416	  ) {
417	    const mockUser: AuthUser = {
418	      email: "local-dev@example.com",
