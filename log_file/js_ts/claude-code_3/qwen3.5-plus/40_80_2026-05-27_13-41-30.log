33	// Helper function to extract JSON from Supabase's untrusted-data wrapper
34	function extractJsonFromResponse(text: string): any[] {
35	  console.log("Extracting JSON from text, length:", text.length);
36	  
37	  try {
38	    // First try direct JSON parse
39	    const directParse = JSON.parse(text);
40	    console.log("Direct parse successful, type:", typeof directParse, "isArray:", Array.isArray(directParse));
41	    
42	    // If it's already an array, return it
43	    if (Array.isArray(directParse)) {
44	      return directParse;
45	    }
46	    
47	    // If it's a string (double-encoded), we need to extract from wrapper
48	    if (typeof directParse === 'string') {
49	      console.log("Result is a string, extracting from wrapper...");
50	      text = directParse;
51	      // Fall through to extraction logic below
52	    } else {
53	      // It's some other type, just return it wrapped in array
54	      return [directParse];
55	    }
56	  } catch (directError) {
57	    console.log("Direct parse failed, will try extraction");
58	  }
59	  
60	  // Look for JSON within untrusted-data tags
61	  console.log("Looking for untrusted-data tags in text...");
62	  
63	  // The opening tag appears twice: once in the description and once as actual tag
64	  // We need to find the LAST occurrence followed by actual content
65	  // Pattern: find opening tag followed by newline and JSON array
66	  const dataMatch = text.match(/<untrusted-data-([a-f0-9-]+)>\s*(\[[\s\S]+?)\s*<\/untrusted-data-\1>/);
67	  
68	  if (dataMatch && dataMatch[2]) {
69	    const uuid = dataMatch[1];
70	    const content = dataMatch[2];
71	    console.log("Found data with UUID:", uuid);
72	    console.log("Extracted content length:", content.length);
