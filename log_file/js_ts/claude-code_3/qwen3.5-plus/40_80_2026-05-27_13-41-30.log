167	    private async withRetry<T>(
168	        operation: () => Promise<T>,
169	        window: Window,
170	        options: { requireFocus?: boolean } = {}
171	    ): Promise<T> {
172	        const { requireFocus = false } = options
173	        let lastError: Error | undefined
174	
175	        for (let attempt = 1; attempt <= MAX_RETRIES; attempt++) {
176	            try {
177	                // Verify window is valid
178	                if (!await this.isWindowResponding(window)) {
179	                    throw new Error('Window is not responding')
180	                }
181	
182	                // Focus window if required
183	                if (requireFocus) {
