551	// Tool 16: Window Control
552	server.addTool({
553	  name: "windowControl",
554	  description: "Control a window (focus, move, resize, minimize, restore).",
555	  parameters: z.object({
556	    action: z
557	      .enum(["focus", "move", "resize", "minimize", "restore"])
558	      .describe("Action to perform"),
559	    windowTitle: z
560	      .string()
561	      .optional()
562	      .describe("Window title to target (uses active window if not provided)"),
563	    x: z.number().optional().describe("X coordinate for move action"),
564	    y: z.number().optional().describe("Y coordinate for move action"),
565	    width: z.number().optional().describe("Width for resize action"),
566	    height: z.number().optional().describe("Height for resize action"),
567	  }),
568	  execute: async ({ action, windowTitle, x, y, width, height }) => {
569	    if (!nutjsAvailable) {
570	      // Limited functionality without nutjs
571	      if (action === "focus" && windowTitle) {
572	        try {
573	          child_process.execSync(
574	            `osascript -e 'tell application "${windowTitle}" to activate'`
575	          );
576	          return `Attempted to focus application: "${windowTitle}"`;
577	        } catch (e) {
578	          throw new Error(`Failed to focus application: ${e}`);
579	        }
580	      } else {
581	        throw new Error("Window control requires nutjs to be fully loaded");
582	      }
583	    }
584	
585	    let targetWindow: any;
586	
587	    if (windowTitle) {
588	      const windows = await getWindows();
589	      targetWindow = await Promise.all(
590	        windows.map(async (win: any) => ({
591	          window: win,
592	          title: await win.getTitle(),
593	        }))
594	      ).then(
595	        (windowsWithTitles) =>
596	          windowsWithTitles.find((w) => w.title.includes(windowTitle))?.window
597	      );
598	
599	      if (!targetWindow) {
600	        throw new Error(
601	          `Window with title containing "${windowTitle}" not found`
602	        );
603	      }
604	    } else {
605	      targetWindow = await getActiveWindow();
606	    }
607	
608	    const windowName = await targetWindow.getTitle();
609	
610	    switch (action) {
611	      case "focus":
612	        await targetWindow.focus();
613	        return `Focused window: "${windowName}"`;
614	
615	      case "move":
616	        if (x === undefined || y === undefined) {
617	          throw new Error("Move action requires x and y coordinates");
618	        }
619	        await targetWindow.move(new Point(x, y));
620	        return `Moved window "${windowName}" to (${x}, ${y})`;
621	
622	      case "resize":
623	        if (width === undefined || height === undefined) {
624	          throw new Error("Resize action requires width and height");
625	        }
626	        await targetWindow.resize(new Size(width, height));
627	        return `Resized window "${windowName}" to ${width}x${height}`;
628	
629	      case "minimize":
630	        await targetWindow.minimize();
631	        return `Minimized window: "${windowName}"`;
632	
633	      case "restore":
634	        await targetWindow.restore();
635	        return `Restored window: "${windowName}"`;
636	
637	      default:
638	        throw new Error(`Unknown action: ${action}`);
639	    }
640	  },
641	});
