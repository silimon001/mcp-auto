186	
187	                // Execute the operation
188	                return await operation()
189	            } catch (error) {
190	                lastError = error as Error
191	                console.error(`Operation failed (attempt ${attempt}/${MAX_RETRIES}):`, error)
192	                
193	                if (attempt < MAX_RETRIES) {
194	                    await new Promise(resolve => setTimeout(resolve, RETRY_DELAY))
