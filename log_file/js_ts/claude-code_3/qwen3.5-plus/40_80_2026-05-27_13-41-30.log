358	export async function requireAdminAuth(c: Context, next: () => Promise<void>) {
359	  const env = c.env as Env;
360	
361	  if (
362	    env.ENVIRONMENT === "development" &&
363	    env.DISABLE_ADMIN_AUTH_FOR_LOCAL_DEV === "true"
364	  ) {
365	    const mockUser: AuthUser = {
366	      email: "dev-admin@example.com",
367	      name: "Dev Admin User",
368	    };
369	    (c as any).set("user", mockUser);
370	    return next();
371	  }
372	
373	  const auth = new Auth(env);
374	  const user = await auth.getCurrentUser(c);
375	
376	  if (!user) {
377	    return c.redirect("/auth/login?redirect=" + encodeURIComponent(c.req.url));
378	  }
379	
380	  if (!auth.isAdminEmail(user.email)) {
381	    return c.json({ error: "Access denied. Admin privileges required." }, 403);
382	  }
383	
384	  (c as any).set("user", user);
385	  return next();
386	}
