134	    private async verifyWindow(window: Window, options: { initialCreation?: boolean } = {}): Promise<boolean> {
135	        return this.withTimeout(async () => {
136	            try {
137	                // Check if window still exists
138	                const windows = windowManager.getWindows()
139	                const exists = windows.some(w => w.handle === window.handle)
140	                
141	                if (!exists) return false
142	
143	                // During initial creation, we only check if the window exists
144	                if (options.initialCreation) {
145	                    return true
146	                }
147	
148	                // For established windows, verify it's managed by us
149	                if (!this.isManagedWindow(window.processId)) {
