244	
245	    const encoder = new TextEncoder();
246	    const data = encoder.encode(token);
247	    const hashBuffer = await crypto.subtle.digest("SHA-256", data);
248	    const hashArray = Array.from(new Uint8Array(hashBuffer));
249	    const tokenHash = hashArray
250	      .map((b) => b.toString(16).padStart(2, "0"))
251	      .join("");
252	
253	    const result = await this.db
254	      .select({
255	        id: apiTokens.id,
