73	export async function performOpenApiAction(
74	  action: ExtendedTool,
75	  actionParams: { params: any; body: any },
76	  jwt: string
77	): Promise<any | null> {
78	  const request = openApiRequests[action.name];
79	  if (!request) {
80	    throw new Error(`No request found for action ${action.name}`);
81	  }
82	
83	  const resolvedRequestPath = `${
84	    request.baseUrl ? request.baseUrl : ""
85	  }${request.path.replace(
86	    /\{(\w+)\}/g,
87	    (_match: string, p1: string) => actionParams.params[p1]
88	  )}`;
89	
90	  let url = `${envs.PROXY_BASE_URL}/projects/${envs.PROJECT_ID}/sdk/proxy/${action.integrationName}`;
91	  const urlParams = new URLSearchParams(
92	    request.params
93	      .filter((param) => param.in === "query")
94	      .filter((param) => actionParams.params[param.name])
95	      .map((param) => [param.name, actionParams.params[param.name]])
96	  );
97	
98	  const response = await fetch(url, {
99	    method: request.method,
100	    headers: {
101	      "Content-Type": "application/json",
102	      Authorization: `Bearer ${jwt}`,
103	      "X-Paragon-Proxy-Url": resolvedRequestPath.concat(
104	        `?${urlParams.toString()}`
105	      ),
106	      "X-Paragon-Use-Raw-Response": "true",
107	    },
108	    body:
109	      request.method.toLowerCase() === OpenAPIV3.HttpMethods.GET
110	        ? undefined
111	        : JSON.stringify(actionParams.body),
112	  });
113	  await handleResponseErrors(response);
114	  return await response.text();
115	}
