473	  private async getMcpServers() {
474	    const allServers = new Set<string>();
475	
476	    for (const configDir of this.config.configDirectories || []) {
477	      const expandedDir = expandPath(configDir);
478	      const mcpConfigPath = join(expandedDir, ".mcp.json");
479	
480	      try {
481	        await access(mcpConfigPath);
482	        const config = JSON.parse(await readFile(mcpConfigPath, "utf-8"));
483	        const serverNames = Object.keys(config.mcpServers || {}).filter(
484	          (name) => name !== "codemode"
485	        );
486	
487	        for (const serverName of serverNames) {
488	          allServers.add(serverName);
489	        }
490	      } catch {
491	        // Silently skip directories without .mcp.json
492	      }
493	    }
494	
495	    return Array.from(allServers);
496	  }
