141	export function getSigningKey(): string {
142	  if (envs.SIGNING_KEY_PATH) {
143	    try {
144	      return fs
145	        .readFileSync(envs.SIGNING_KEY_PATH, "utf8")
146	        .replaceAll("\\n", "\n");
147	    } catch (error) {
148	      console.error("Error reading signing key file:", error);
149	      throw new Error("Failed to read signing key file");
150	    }
151	  }
152	
153	  if (!envs.SIGNING_KEY) {
154	    throw new Error("Neither SIGNING_KEY nor SIGNING_KEY_PATH is set");
155	  }
156	
157	  return envs.SIGNING_KEY.replaceAll("\\n", "\n");
158	}
