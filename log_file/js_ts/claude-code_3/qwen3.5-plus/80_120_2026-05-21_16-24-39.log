2	import jwt from "jsonwebtoken";
3	import { SSEServerTransport } from "@modelcontextprotocol/sdk/server/sse.js";
4	
5	import { createAccessTokenStore, getAccessTokenById } from "./access-tokens";
6	import { registerTools } from "./tools";
7	import { ExtendedTool, Integration, TransportPayload } from "./type";
8	import {
9	  envs,
10	  Logger,
11	  signJwt,
12	  getSigningKey,
13	  getAllIntegrations,
14	  createProxyApiTool,
15	} from "./utils";
16	import { Server } from "@modelcontextprotocol/sdk/server/index.js";
17	import { loadCustomOpenApiTools } from "./openapi";
18	import { getCustomTools } from "./custom-tools";
19	
20	let transports: Record<string, TransportPayload> = {};
21	const server = new Server({
22	  name: "paragon-mcp",
23	  version: "1.0.0",
24	});
25	let extraTools: Array<ExtendedTool> = [];
26	let integrations: Array<Integration> = await getAllIntegrations(
27	  signJwt({ userId: envs.PROJECT_ID })
28	);
29	if (envs.ENABLE_CUSTOM_OPENAPI_ACTIONS) {
30	  extraTools = await loadCustomOpenApiTools(integrations);
31	}
32	if (envs.ENABLE_PROXY_API_TOOL) {
33	  extraTools = extraTools.concat(
34	    createProxyApiTool(
35	      integrations.filter((i) => {
36	        if (envs.LIMIT_TO_INTEGRATIONS) {
37	          return envs.LIMIT_TO_INTEGRATIONS.includes(i.type);
38	        }
39	        return true;
40	      })
41	    )
42	  );
43	}
44	if (envs.ENABLE_CUSTOM_TOOL) {
45	  extraTools = extraTools.concat(getCustomTools());
46	}
47	registerTools({ server, extraTools, transports });
48	
49	async function main() {
50	  createAccessTokenStore();
51	
52	  const app = express();
53	
54	  app.use("/static", express.static("static"));
55	
56	  app.get("/sse", async (req, res) => {
57	    let currentJwt = req.headers.authorization;
58	
59	    if (currentJwt && currentJwt.startsWith("Bearer ")) {
60	      currentJwt = currentJwt.slice(7).trim();
61	    } else if (envs.NODE_ENV === "development" && req.query.user) {
62	      // In development, allow `user=` query parameter to be used
63	      currentJwt = signJwt({ userId: req.query.user as string });
64	    } else {
65	      return res.status(401).send("Unauthorized");
66	    }
67	
68	    const transport = new SSEServerTransport("/messages", res);
69	    transports[transport.sessionId] = { transport, currentJwt };
70	
71	    Logger.debug(
72	      "Connected clients:",
73	      Object.keys(transports).map((key) => ({
74	        sessionId: key,
75	        user: jwt.decode(transports[key].currentJwt)?.sub,
76	      }))
77	    );
78	
79	    res.on("close", () => {
80	      Logger.debug("Client disconnected: ", transport.sessionId);
81	      delete transports[transport.sessionId];
82	    });
83	
84	    await server.connect(transport);
85	  });
86	
87	  app.post("/messages", async (req, res) => {
88	    const sessionId = req.query.sessionId as string;
89	    const transportPayload = transports[sessionId];
90	
91	    if (sessionId && transportPayload) {
92	      try {
93	        return await transportPayload.transport.handlePostMessage(req, res);
94	      } catch (err) {
95	        if (!res.headersSent) {
96	          return res.status(500).send(err instanceof Error ? err.message : err);
97	        }
98	      }
99	    }
100	
101	    console.error("No transport found for sessionId", sessionId);
102	    return res.status(404).json({ error: "No transport found for sessionId" });
103	  });
104	
105	  app.get("/setup", async (req, res) => {
106	    const tokenId = req.query.token;
107	    if (!tokenId || typeof tokenId !== "string") {
108	      return res.status(400).json({ error: "Invalid token" });
109	    }
110	
111	    const token = getAccessTokenById(tokenId);
112	    if (!token) {
113	      return res.status(400).json({ error: "Invalid token" });
114	    }
115	
116	    try {
117	      jwt.verify(token, getSigningKey());
118	    } catch (error) {
119	      return res.status(400).json({ error: "Invalid token" });
120	    }
121	
122	    const decoded = jwt.decode(token, { complete: true });
123	    if (!decoded?.payload || typeof decoded.payload === "string") {
124	      return res.status(400).json({ error: "Invalid token" });
125	    }
126	
127	    const payload = decoded.payload.payload;
128	    const tokenInfo = {
129	      projectId: payload.projectId,
130	      loginToken: payload.loginToken,
131	      integrationName: payload.integrationName,
132	    };
133	
134	    return res.status(200).type("text/html").send(`
135	      <html>
136	        <head>
137	          <script src="${envs.CONNECT_SDK_CDN_URL}"></script>
138	          <script id="token-info" type="application/json">${JSON.stringify(
139	            tokenInfo
140	          )}</script>
141	          <script type="text/javascript" src="/static/js/index.js"></script>
142	        </head>
143	        <body>
144	        </body>
145	      </html>
146	    `);
147	  });
148	
149	  app.listen(Number(envs.PORT));
150	  console.log(`Server is running on`, `http://localhost:${envs.PORT}`);
151	}
152	
153	const handleShutdown = async () => {
154	  console.log("Closing all transports...");
155	  await Promise.all(
156	    Object.values(transports).map(async (transport) => {
157	      await transport.transport.close();
158	    })
159	  );
160	  await server.close();
161	  for (const key in transports) {
162	    delete transports[key];
163	  }
164	  process.exit(0);
165	};
