1	import { IntegrationAppClient } from '@integration-app/sdk';
2	import { fetchAllWithPagination } from './fetch-with-pagination';
3	
4	export function getAllConnections({
5	  apps,
6	  membrane,
7	}: {
8	  apps?: string[];
9	  membrane: IntegrationAppClient;
10	}) {
11	  const fetchFn = async ({ cursor }: { cursor?: string }) => {
12	    if (apps && apps.length > 0) {
13	      // If specific apps are requested, fetch connections for all apps in parallel
14	      const connectionPromises = apps.map(app =>
15	        membrane.connections.find({
16	          integrationKey: app,
17	        })
18	      );
19	
20	      const connectionsResults = await Promise.all(connectionPromises);
21	      const allConnections = connectionsResults.flatMap(result => result.items);
22	
23	      return { items: allConnections, cursor: undefined };
24	    } else {
25	      // If no apps specified, fetch all connections
26	      const connections = await membrane.connections.find({});
27	      return connections;
28	    }
29	  };
30	  return fetchAllWithPagination(fetchFn);
31	}
32	

