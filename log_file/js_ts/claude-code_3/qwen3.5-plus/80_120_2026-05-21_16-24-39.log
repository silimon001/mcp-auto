1	# GraphQL MCP Server Environment Variables
2	
3	# GraphQL API Endpoint URL (required)
4	GRAPHQL_API_ENDPOINT=https://countries.trevorblades.com/graphql
5	
6	# API Key for authentication (optional)
7	# For Bearer token, just include the token value without "Bearer" prefix
8	GRAPHQL_API_KEY=
9	
10	# Enable debug logging (optional, default: false)
11	DEBUG=true
12	
13	# Cache time-to-live in milliseconds (optional, default: 3600000 - 1 hour)
14	# CACHE_TTL=3600000
15	
16	# Enable mutations (optional, default: false)
17	# For security, mutations are disabled by default
18	# ENABLE_MUTATIONS=false
19	
20	# Optional whitelist of queries to expose (comma-separated or JSON array string)
21	# If not specified, all queries from schema will be available
22	# JSON array format (note the quotes are escaped):
23	# WHITELISTED_QUERIES=[\"countries\",\"continent\",\"languages\"]
24	# or comma-separated list format (simpler for .env files):
25	# WHITELISTED_QUERIES=countries,continent,languages
