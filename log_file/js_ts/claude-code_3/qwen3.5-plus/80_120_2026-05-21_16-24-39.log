1	import { McpServer, RegisteredTool } from '@modelcontextprotocol/sdk/server/mcp.js';
2	import { getActionsForAllConnectedApp } from './membrane/get-actions-for-all-connected-app';
3	import { Action, IntegrationAppClient } from '@integration-app/sdk/dist';
4	import { MockIntegrationAppClient } from './mocks/mock-integration-app-client';
5	import { isTestEnvironment } from './constants';
6	import { zodFromJsonSchema } from './json-schema-to-zod';
7	import { ZodRawShape } from 'zod';
8	import pkg from '../../../package.json';
9	import { getActionsByKeys } from './membrane/get-actions-by-keys';
10	
11	/**
12	 * Register a tool to the MCP server while adding some standardization
13	 */
14	function addServerTool({
15	  mcpServer,
16	  action,
17	  membrane,
18	}: {
19	  mcpServer: McpServer;
20	  action: Action;
21	  membrane: IntegrationAppClient;
22	}) {
23	  const toolParametersSchema = zodFromJsonSchema(
24	    action.inputSchema || {
25	      type: 'object',
26	      properties: undefined,
27	    }
28	  ) as unknown as ZodRawShape;
29	
30	  const integrationKey = action.integration?.key;
31	  const integrationName = action.integration?.name;
32	
33	  if (!integrationKey || !integrationName) {
34	    return;
35	  }
36	
37	  /**
38	   * Include integration name/key to avoid collisions
39	   * use underscore to make it easier to tell the integration key fo the tool
40	   */
41	  let toolName = `${integrationKey}_${action.key}`;
42	  let toolDescription = `${integrationName}: ${action.name}`;
43	
44	  const tool = mcpServer.registerTool(
45	    toolName,
46	    {
47	      title: toolDescription,
48	      description: toolDescription,
49	      inputSchema: toolParametersSchema,
50	    },
51	    async args => {
52	      const result = await membrane
53	        .actionInstance({
54	          autoCreate: true,
55	          integrationKey,
56	          parentKey: action.key,
57	        })
58	        .run(args);
59	
60	      return {
61	        content: [
62	          {
63	            type: 'text',
64	            text: result.output ? JSON.stringify(result.output) : 'No output',
65	          },
66	        ],
67	      };
68	    }
69	  );
70	
71	  return { tool, toolName };
72	}
73	
74	export interface CreateMcpServerParams {
75	  userAccessToken: string;
76	  apps?: string[];
77	  mode?: 'dynamic' | 'static';
78	}
79	
80	export const createMcpServer = async ({
81	  userAccessToken,
82	  apps,
83	  mode = 'static',
84	}: CreateMcpServerParams) => {
85	  const mcpServer = new McpServer(
86	    {
87	      name: 'Membrane MCP Server',
88	      version: pkg.version,
89	      description: pkg.description,
90	    },
91	    {
92	      capabilities: {
93	        tools: {
94	          listChanged: true,
95	        },
96	      },
97	    }
98	  );
99	
100	  let membrane: IntegrationAppClient;
101	
102	  if (isTestEnvironment) {
103	    membrane = new MockIntegrationAppClient(userAccessToken) as any;
104	  } else {
105	    membrane = new IntegrationAppClient({ token: userAccessToken });
106	  }
107	
108	  /**
109	   * Get actions for all connected apps on membrane
110	   *
111	   * If `apps` is provided, MCP server only return tools for the specified apps
112	   */
113	  const actions = await getActionsForAllConnectedApp({ membrane, apps });
114	
115	  if (mode === 'static') {
116	    for (const action of actions) {
117	      addServerTool({ mcpServer, action, membrane });
118	    }
119	  }
120	
121	  if (mode === 'dynamic') {
122	    const registeredTools: Record<string, RegisteredTool> = {};
123	    const enabledTools: string[] = [];
124	
125	    mcpServer.registerTool(
126	      'enable-tools',
127	      {
128	        title: 'Enable Tools',
129	        description: 'Enable a list of tools for the session',
130	        inputSchema: zodFromJsonSchema({
131	          type: 'object',
132	          properties: {
133	            tools: {
134	              type: 'array',
135	              items: {
136	                type: 'string',
137	              },
138	            },
139	          },
140	        }),
141	      },
142	
143	      async args => {
144	        console.log('>>> Enabling tools', args.tools);
145	
146	        // Disable all enabled tools
147	        for (const tool of enabledTools) {
148	          registeredTools[tool]?.disable();
149	        }
150	
151	        // Enable new tools
152	        for (const tool of args.tools) {
153	          /**
154	           * There are cases where the tool client is trying to enable is not a registered tool.
155	           * In that case, we need to get the action from membrane, register it and enable it.
156	           */
157	          const isToolRegistered = registeredTools[tool];
158	
159	          if (isToolRegistered) {
160	            registeredTools[tool].enable();
161	            enabledTools.push(tool);
162	          } else {
163	            const actions = await getActionsByKeys(
164	              membrane,
165	              args.tools.map((toolKey: string) => {
166	                const [integrationKey, actionKey] = toolKey.split('_');
167	
168	                return {
169	                  key: actionKey,
170	                  integrationKey,
171	                };
172	              })
173	            );
174	
175	            for (const action of actions) {
176	              if (action) {
177	                const addedTool = addServerTool({ mcpServer, action, membrane });
178	                if (addedTool) {
179	                  registeredTools[addedTool.toolName] = addedTool.tool;
180	                  addedTool.tool.enable();
181	                  enabledTools.push(addedTool.toolName);
182	                }
183	              }
184	            }
185	          }
186	        }
187	
188	        return {
189	          content: [
190	            {
191	              type: 'text',
192	              text: 'Tools enabled',
193	            },
194	          ],
195	        };
196	      }
197	    );
198	
199	    for (const action of actions) {
200	      const addToolResult = addServerTool({ mcpServer, action, membrane });
201	
202	      if (addToolResult) {
203	        registeredTools[addToolResult.toolName] = addToolResult.tool;
204	        addToolResult.tool.disable();
205	      }
206	
207	      /**
208	       * TODO: Add resources to the server
209	       */
210	    }
211	  }
212	
213	  return { mcpServer };
214	};
