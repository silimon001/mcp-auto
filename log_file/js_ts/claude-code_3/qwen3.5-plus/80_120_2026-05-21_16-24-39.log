434	  private startHttpProxy() {
435	    const httpServer = createServer(async (req, res) => {
436	      res.setHeader("Access-Control-Allow-Origin", "*");
437	      res.setHeader("Content-Type", "application/json");
438	
439	      try {
440	        if (req.url === "/mcp/servers") {
441	          const servers = await this.getMcpServers();
442	          res.end(JSON.stringify(servers));
443	        } else if (req.url?.startsWith("/mcp/") && req.url.includes("/tools")) {
444	          const serverName = req.url.split("/")[2];
445	          if (!serverName) throw new Error("Server name required");
446	          const tools = await this.listToolsForServer(serverName);
447	          res.end(JSON.stringify(tools));
448	        } else if (req.url === "/mcp/call" && req.method === "POST") {
449	          let body = "";
450	          req.on("data", (chunk) => (body += chunk));
451	          req.on("end", async () => {
452	            const { server, tool, args } = JSON.parse(body);
453	            const result = await this.callToolOnServer(server, tool, args);
454	            res.end(JSON.stringify(result));
455	          });
456	        } else {
457	          res.writeHead(404);
458	          res.end(JSON.stringify({ error: "Not found" }));
459	        }
460	      } catch (error: any) {
461	        res.writeHead(500);
462	        res.end(JSON.stringify({ error: error.message }));
463	      }
464	    });
465	
466	    httpServer.listen(this.config.proxyPort, () => {
467	      console.error(
468	        `MCP proxy running on http://localhost:${this.config.proxyPort}`
469	      );
470	    });
471	  }
