1	#!/usr/bin/env node
2	import { Server } from '@modelcontextprotocol/sdk/server/index.js';
3	import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
4	import { CallToolRequestSchema, ListToolsRequestSchema } from '@modelcontextprotocol/sdk/types.js';
5	import fetch from 'node-fetch';
6	// Create an MCP server with only tools capability (trigger 'query-data' call).
7	const server = new Server({
8	    name: 'agentql-mcp',
9	    version: '1.0.1',
10	}, {
11	    capabilities: {
12	        tools: {},
13	    },
14	});
15	const EXTRACT_TOOL_NAME = 'extract-web-data';
16	const AGENTQL_API_KEY = process.env.AGENTQL_API_KEY;
17	if (!AGENTQL_API_KEY) {
18	    console.error('Error: AGENTQL_API_KEY environment variable is required');
19	    process.exit(1);
20	}
21	// Handler that lists available tools.
22	server.setRequestHandler(ListToolsRequestSchema, async () => {
23	    return {
24	        tools: [
25	            {
26	                name: EXTRACT_TOOL_NAME,
27	                description: 'Extracts structured data as JSON from a web page given a URL using a Natural Language description of the data.',
28	                inputSchema: {
29	                    type: 'object',
30	                    properties: {
31	                        url: {
32	                            type: 'string',
33	                            description: 'The URL of the public webpage to extract data from',
34	                        },
35	                        prompt: {
36	                            type: 'string',
37	                            description: 'Natural Language description of the data to extract from the page',
38	                        },
39	                    },
40	                    required: ['url', 'prompt'],
41	                },
42	            },
43	        ],
44	    };
45	});
46	// Handler for the 'extract-web-data' tool.
47	server.setRequestHandler(CallToolRequestSchema, async (request) => {
48	    switch (request.params.name) {
49	        case EXTRACT_TOOL_NAME: {
50	            const url = String(request.params.arguments?.url);
51	            const prompt = String(request.params.arguments?.prompt);
52	            if (!url || !prompt) {
53	                throw new Error("Both 'url' and 'prompt' are required");
54	            }
55	            const endpoint = 'https://api.agentql.com/v1/query-data';
56	            const response = await fetch(endpoint, {
57	                method: 'POST',
58	                headers: {
59	                    'X-API-Key': `${AGENTQL_API_KEY}`,
60	                    'X-TF-Request-Origin': 'mcp-server',
61	                    'Content-Type': 'application/json',
62	                },
63	                body: JSON.stringify({
64	                    url: url,
65	                    prompt: prompt,
66	                    params: {
67	                        wait_for: 0,
68	                        is_scroll_to_bottom_enabled: false,
69	                        mode: 'fast',
70	                        is_screenshot_enabled: false,
71	                    },
72	                }),
73	            });
74	            if (!response.ok) {
75	                throw new Error(`AgentQL API error: ${response.statusText}\n${await response.text()}`);
76	            }
77	            const json = (await response.json());
78	            return {
79	                content: [
80	                    {
81	                        type: 'text',
82	                        text: JSON.stringify(json.data, null, 2),
83	                    },
84	                ],
85	            };
86	        }
87	        default:
88	            throw new Error(`Unknown tool: '${request.params.name}'`);
89	    }
90	});
91	// Start the server using stdio transport.
92	async function main() {
93	    const transport = new StdioServerTransport();
94	    await server.connect(transport);
95	}
96	main().catch((error) => {
97	    console.error('Server error:', error);
98	    process.exit(1);
99	});
