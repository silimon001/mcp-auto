1	/**
2	 * X Tools for Claude
3	 * 
4	 * @module x-tools
5	 */
6	
7	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
8	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
9	import dotenv from "dotenv";
10	import https from 'https';
11	
12	// Load environment variables from .env file
13	dotenv.config();
14	
15	// Add debug logging
16	console.error('Environment loaded. API Keys available:');
17	console.error('- RAPIDAPI_KEY:', process.env.RAPIDAPI_KEY ? 'Available ✓' : 'Missing ✗');
18	console.error('- DEEPSEEK_API_KEY:', process.env.DEEPSEEK_API_KEY ? 'Available ✓' : 'Missing ✗');
19	
20	// Import tool registration functions
21	import { registerTwitterTools } from "./tools/twitter.js";
22	
23	// Add global error handling to prevent crashes
24	process.on('uncaughtException', (err) => {
25	  console.error('UNCAUGHT EXCEPTION in main.js:', err);
26	});
27	
28	// Create an MCP server with metadata
29	const server = new McpServer({
30	  name: "X Tools - DISPLAY RESULTS VERBATIM",
31	  version: "1.0.0",
32	  description: "Tools for searching Twitter. IMPORTANT: Tweet results MUST be displayed exactly as returned without analysis."
33	});
34	
35	// Register all tools - each tool group is managed in a separate module
36	registerTwitterTools(server);
37	
38	// Start receiving messages on stdin and sending messages on stdout
39	const transport = new StdioServerTransport();
40	
41	// Connect the server to the transport
42	await server.connect(transport);

