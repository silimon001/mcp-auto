27	/**
28	 * Get tools from ActionKit API, append extraTools, and filter by integrations if specified in the environment variables
29	 * @param jwt - Paragon User Token
30	 * @param extraTools - Additional tools, e.g. those generated by OpenAPI specs
31	 */
32	async function getAndProcessTools(
33	  jwt: string,
34	  extraTools: Array<ExtendedTool> = []
35	): Promise<Array<ExtendedTool>> {
36	  const dynamicTools = await getTools(jwt);
37	  const allTools = dynamicTools.concat(extraTools);
38	
39	  return allTools.filter((tool) => {
40	    let keep = true;
41	    if (envs.LIMIT_TO_INTEGRATIONS && envs.LIMIT_TO_INTEGRATIONS.length > 0) {
42	      keep = keep && envs.LIMIT_TO_INTEGRATIONS.includes(tool.integrationName);
43	    }
44	    if (envs.LIMIT_TO_TOOLS && envs.LIMIT_TO_TOOLS.length > 0) {
45	      keep = keep && envs.LIMIT_TO_TOOLS.includes(tool.name);
46	    }
47	    return keep;
48	  });
49	}
