5	  // Check command line args first (format: --name=value or --name value)
6	  const argIndex = process.argv.findIndex((arg) => arg.startsWith(`--${name}`));
7	  if (argIndex !== -1) {
8	    const arg = process.argv[argIndex];
9	    if (arg.includes("=")) {
10	      return arg.split("=")[1];
11	    }
12	    // --name value format: return next argument if it exists and isn't another flag
13	    const nextArgIndex = argIndex + 1;
14	    if (nextArgIndex < process.argv.length) {
