51	export function registerTools({
52	  server,
53	  extraTools = [],
54	  transports,
55	}: {
56	  server: Server;
57	  extraTools?: Array<ExtendedTool>;
58	  transports: Record<string, TransportPayload>;
59	}) {
60	  server.registerCapabilities({
61	    tools: {
62	      listChanged: true,
63	    },
64	  });
65	
66	  server.setRequestHandler(
67	    ListToolsRequestSchema,
68	    async (_params, { sessionId }) => {
69	      if (!sessionId || !transports[sessionId]) {
70	        throw new Error(`No session found by ID: ${sessionId}`);
71	      }
72	      const sessionData = transports[sessionId];
73	
74	      if (sessionData.cachedTools) {
75	        return { tools: sessionData.cachedTools };
76	      }
77	
78	      const filteredTools = await getAndProcessTools(sessionData.currentJwt, extraTools);
79	      transports[sessionId].cachedTools = filteredTools;
80	      return { tools: filteredTools };
81	    }
82	  );
83	
84	  server.setRequestHandler(
85	    CallToolRequestSchema,
86	    async (request, { sessionId }) => {
87	      if (!sessionId || !transports[sessionId]) {
88	        throw new Error(`No session found by ID: ${sessionId}`);
89	      }
90	      const { name, arguments: args } = request.params;
91	      const sessionData = transports[sessionId];
92	      if (!sessionData.cachedTools) {
93	        sessionData.cachedTools = await getAndProcessTools(sessionData.currentJwt, extraTools);
94	      }
95	      const dynamicTools = sessionData.cachedTools;
96	      const tool = dynamicTools.find((t) => t.name === name);
97	      if (!tool) {
98	        throw new Error(`Tool not found: ${name}`);
99	      }
100	
101	      try {
102	        const validate = ajv.compile(tool.inputSchema);
103	        const valid = validate(args);
104	
105	        if (!valid) {
106	          return {
107	            content: [
108	              {
109	                type: "text" as const,
110	                text: JSON.stringify({
111	                  error: "Validation error",
112	                  details: validate.errors,
113	                }),
114	              },
115	            ],
116	            isError: true,
117	          };
118	        }
119	
120	        let response;
121	        if (tool.isOpenApiTool) {
122	          response = await performOpenApiAction(
123	            tool,
124	            args as { params: any; body: any },
125	            transports[sessionId].currentJwt
126	          );
127	        } else if (tool.name === "CALL_API_REQUEST") {
128	          response = await performProxyApiRequest(
129	            args as ProxyApiRequestToolArgs,
130	            transports[sessionId].currentJwt
131	          );
132	        } else if (tool.name.split("_")[0] === "CUSTOM") {
133	          response = await performCustomAction(
134	            tool.name,
135	            args,
136	            transports[sessionId].currentJwt
137	          );
138	        } else {
139	          response = await performAction(
140	            tool.name,
141	            args,
142	            transports[sessionId].currentJwt
143	          );
144	        }
145	
146	        if (response === null) {
147	          return {
148	            content: [
149	              {
150	                type: "text" as const,
151	                text: JSON.stringify({
152	                  error: `Failed to execute tool: ${tool.name}`,
153	                }),
154	              },
155	            ],
156	            isError: true,
157	          };
158	        }
159	
160	        return {
161	          content: [{ type: "text" as const, text: JSON.stringify(response) }],
162	        };
163	      } catch (error: any | JsonResponseError | UserNotConnectedError) {
164	        if (error instanceof UserNotConnectedError) {
