512	  private async getOrCreateMcpClient(serverName: string) {
513	    if (!this.mcpClients.has(serverName)) {
514	      const serverConfig = await this.findServerConfig(serverName);
515	
516	      if (!serverConfig) {
517	        throw new Error(
518	          `Server '${serverName}' not found in any config directory`
519	        );
520	      }
521	
522	      // Create MCP client with stdio transport (handles process spawning internally)
523	      const transport = new StdioClientTransport({
524	        command: serverConfig.command,
525	        args: serverConfig.args,
526	      });
527	
528	      const client = new Client(
529	        {
530	          name: "deno-mcp-proxy",
531	          version: "1.0.0",
532	        },
533	        {
534	          capabilities: {},
535	        }
536	      );
537	
538	      // Connect the client
539	      await client.connect(transport);
540	
541	      this.mcpClients.set(serverName, client);
542	    }
543	
544	    return this.mcpClients.get(serverName)!;
545	  }
546	
547	  private async findServerConfig(serverName: string) {
548	    for (const configDir of this.config.configDirectories || []) {
549	      const expandedDir = expandPath(configDir);
550	      const mcpConfigPath = join(expandedDir, ".mcp.json");
551	
552	      try {
553	        await access(mcpConfigPath);
554	        const config = JSON.parse(await readFile(mcpConfigPath, "utf-8"));
555	
556	        if (config.mcpServers && config.mcpServers[serverName]) {
557	          return config.mcpServers[serverName];
558	        }
559	      } catch {
560	        // Silently skip directories without .mcp.json or invalid JSON
561	      }
562	    }
563	
564	    return null;
565	  }
