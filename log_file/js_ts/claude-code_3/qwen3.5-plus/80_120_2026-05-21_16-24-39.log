160	export function signJwt({
161	  userId,
162	  personaId,
163	  integrationId,
164	  integrationName,
165	  projectId,
166	  loginToken,
167	}: LinkConnectionProps): string {
168	  const currentTime = Math.floor(Date.now() / 1000);
169	  const signingKey = getSigningKey();
170	
171	  return jwt.sign(
172	    {
173	      payload: {
174	        ...(personaId && { personaId }),
175	        ...(integrationId && { integrationId }),
176	        ...(integrationName && { integrationName }),
177	        ...(projectId && { projectId }),
178	        ...(loginToken && { loginToken }),
179	      },
180	      sub: userId,
181	      iat: currentTime,
182	      exp: currentTime + 60 * 60 * 24 * 7, // 1 week from now
183	    },
184	    signingKey,
185	    {
186	      algorithm: "RS256",
187	    }
188	  );
189	}
