195	export async function getTools(jwt: string): Promise<Array<ExtendedTool>> {
196	  const tools: Array<ExtendedTool> = [];
197	  const actionPayload = await getActions(jwt);
198	  const actions = actionPayload.actions;
199	
200	  for (const integration of Object.keys(actions)) {
201	    for (const action of actions[integration]) {
202	      const tool: ExtendedTool = {
203	        isOpenApiTool: false,
204	        name: action["function"]["name"],
205	        description: action["function"]["description"],
206	        inputSchema: action["function"]["parameters"],
207	        integrationName: integration,
208	        requiredFields: action["function"]["parameters"]["required"],
209	      };
210	      tools.push(tool);
211	    }
212	  }
213	  return tools;
214	}
