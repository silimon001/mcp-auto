loop 22 | Tool=Write, Args={"file_path":"/home/silimon/MCP-Auto/mcp_server/xhs_mcp_server_aicu-icu_xhs-mcp-server/server.js","content":"#!/usr/bin/env node\n\nimport { Server } from \"@modelcontextprotocol/sdk/server/index.js\";\nimport { StdioServerTransport } from \"@modelcontextprotocol/sdk/server/stdio.js\";\nimport {\n  ListToolsRequestSchema,\n  CallToolRequestSchema,\n} from \"@modelcontextprotocol/sdk/types.js\";\nimport axios from \"axios\";\n\nconst XHS_BASE = \"https://edith.xiaohongshu.com/api/sns/web/v1\";\nconst XHS_BASE_V2 = \"https://edith.xiaohongshu.com/api/sns/web/v2\";\n\nfunction getHeaders() {\n  const cookie = process.env.XHS_COOKIE || \"\";\n  return {\n    \"Content-Type\": \"application/json;charset=UTF-8\",\n    \"Origin\": \"https://www.xiaohongshu.com\",\n    \"Referer\": \"https://www.xiaohongshu.com/\",\n    \"User-Agent\": \"Mozilla/5.0 (Linux; Android 6.0; Nexus 5 Build/MRA58N) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Mobile Safari/537.36\",\n    ...(cookie ? { Cookie: cookie } : {}),\n  };\n}\n\nasync function xhsGet(path, params = {}) {\n  const url = `https://edith.xiaohongshu.com${path}`;\n  const res = await axios.get(url, { params, headers: getHeaders(), timeout: 15000 });\n  return res.data;\n}\n\nasync function xhsPost(path, data = {}) {\n  const url = `https://edith.xiaohongshu.com${path}`;\n  const res = await axios.post(url, data, { headers: getHeaders(), timeout: 15000 });\n  return res.data;\n}\n\nfunction createSearchId() {\n  return Math.random().toString(36).substring(2, 15) +\n    Math.random().toString(36).substring(2, 15);\n}\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n\nconst tools = [\n  {\n    name: \"getNoteDetail\",\n    description: \"获取指定笔记的详细数据。note_id和xsec_token必须真实有效，不能伪造或随机生成！\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        note_id: { type: \"string\", description: \"小红书笔记的note_id\" },\n        xsec_token: { type: \"string\", description: \"笔记对应的xsec_token\" },\n      },\n      required: [\"note_id\", \"xsec_token\"],\n    },\n  },\n  {\n    name: \"getHomeFeeds\",\n    description: \"获取小红书首页帖子列表。分类：homefeed_recommend(推荐), homefeed.fashion_v3(穿搭), homefeed.food_v3(美食), homefeed.cosmetics_v3(彩妆), homefeed.movie_and_tv_v3(影视), homefeed.career_v3(职场), homefeed.love_v3(情感), homefeed.household_product_v3(家居), homefeed.gaming_v3(游戏), homefeed.travel_v3(旅行), homefeed.fitness_v3(健身)\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        count: { type: \"number\", description: \"获取数量，默认10\" },\n        category: { type: \"string\", description: \"分类，默认推荐\" },\n      },\n      required: [],\n    },\n  },\n  {\n    name: \"getCurrentUser\",\n    description: \"获取当前登录的小红书账号详细信息\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        moreInfo: { type: \"boolean\", description: \"是否获取详细信息\" },\n      },\n      required: [],\n    },\n  },\n  {\n    name: \"searchUser\",\n    description: \"根据关键词搜索用户。返回数据中的xsec_token很重要，后续调用可能需要\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        keyword: { type: \"string\", description: \"搜索关键词\" },\n        count: { type: \"number\", description: \"获取数量，默认5\" },\n      },\n      required: [\"keyword\"],\n    },\n  },\n  {\n    name: \"getUserPosts\",\n    description: \"获取指定用户已发布的笔记列表。user_id和xsec_token必须真实有效！\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        user_id: { type: \"string\", description: \"用户ID，24个字符\" },\n        xsec_token: { type: \"string\", description: \"用户主页的xsec_token\" },\n        count: { type: \"number\", description: \"获取数量，默认5\" },\n      },\n      required: [\"user_id\", \"xsec_token\"],\n    },\n  },\n  {\n    name: \"getNoteComments\",\n    description: \"获取指定笔记的评论列表。note_id和xsec_token必须真实有效！\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        note_id: { type: \"string\", description: \"笔记note_id（24位）\" },\n        xsec_token: { type: \"string\", description: \"笔记对应的xsec_token\" },\n        count: { type: \"number\", description: \"获取数量，默认10\" },\n      },\n      required: [\"note_id\", \"xsec_token\"],\n    },\n  },\n  {\n    name: \"getMentions\",\n    description: \"获取用户的消息通知（评论和@）\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        count: { type: \"number\", description: \"获取数量，默认20\" },\n        cursor: { type: \"string\", description: \"分页指针\" },\n      },\n      required: [],\n    },\n  },\n  {\n    name: \"getUserLikes\",\n    description: \"获取当前用户收到的赞和收藏通知\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        count: { type: \"number\", description: \"获取数量，默认20\" },\n        cursor: { type: \"string\", description: \"分页指针\" },\n      },\n      required: [],\n    },\n  },\n  {\n    name: \"getNewFollwers\",\n    description: \"获取新增关注通知\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        count: { type: \"number\", description: \"获取数量，默认20\" },\n        cursor: { type: \"string\", description: \"分页指针\" },\n      },\n      required: [],\n    },\n  },\n  {\n    name: \"searchNotes\",\n    description: \"根据关键词搜索小红书笔记列表\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        keyword: { type: \"string\", description: \"搜索关键词\" },\n        count: { type: \"number\", description: \"获取数量，默认20\" },\n      },\n      required: [\"keyword\"],\n    },\n  },\n];\n\nconst server = new Server(\n  { name: \"xhs-mcp-server\", version: \"1.3.13\" },\n  { capabilities: { tools: {} } }\n);\n\nserver.setRequestHandler(ListToolsRequestSchema, async () => ({ tools }));\n\nserver.setRequestHandler(CallToolRequestSchema, async (request) => {\n  const { name, arguments: args } = request.params;\n\n  try {\n    let result;\n    switch (name) {\n      case \"getNoteDetail\": {\n        result = await xhsPost(\"/api/sns/web/v1/feed\", {\n          source_note_id: args.note_id,\n          image_formats: [\"jpg\", \"webp\", \"avif\"],\n          extra: { need_body_topic: \"1\" },\n          xsec_source: \"pc_feed\",\n          xsec_token: args.xsec_token,\n        });\n        break;\n      }\n      case \"getHomeFeeds\": {\n        const count = args.count || 10;\n        const category = args.category || \"homefeed_recommend\";\n        let cursor_score = \"\";\n        let note_index = 0;\n        let loaded_count = 0;\n        const results_all = [];\n        while (loaded_count < count) {\n          const res = await xhsPost(\"/api/sns/web/v1/homefeed\", {\n            cursor_score,\n            num: 27,\n            refresh_type: 1,\n            note_index,\n            unread_begin_note_id: \"\",\n            unread_end_note_id: \"\",\n            unread_note_count: 0,\n            category,\n            search_key: \"\",\n            need_num: 12,\n            image_formats: [\"jpg\", \"webp\", \"avif\"],\n            need_filter_image: false,\n          });\n          if (!res.items || res.items.length === 0) break;\n          for (const item of res.items) {\n            if (loaded_count >= count) break;\n            results_all.push(item);\n            loaded_count++;\n          }\n          if (loaded_count >= count) break;\n          cursor_score = res.cursor_score || \"\";\n          note_index = res.items.length;\n          await sleep(2000);\n        }\n        result = results_all;\n        break;\n      }\n      case \"getCurrentUser\": {\n        const moreInfo = args.moreInfo || false;\n        const me = await xhsGet(\"/api/sns/web/v2/user/me\");\n        result = { me };\n        if (moreInfo) {\n          const info = await xhsGet(\"/api/sns/web/v1/user/selfinfo\");\n          result.info = info;\n        }\n        break;\n      }\n      case \"searchUser\": {\n        const keyword = args.keyword;\n        const count = args.count || 5;\n        const searchId = createSearchId();\n        let current_page = 1;\n        const pageSize = 20;\n        const results_all = [];\n        let loaded_count = 0;\n        while (loaded_count < count) {\n          const res = await xhsPost(\"/api/sns/web/v1/search/usersearch\", {\n            search_user_request: {\n              keyword,\n              search_id: searchId,\n              page: current_page,\n              page_size: pageSize,\n              biz_type: \"web_search_user\",\n              request_id: Math.random().toString().slice(2, 11) + \"-\" + Date.now(),\n            },\n          });\n          if (!res.result || !res.result.success) {\n            throw new Error(JSON.stringify(res.result || res));\n          }\n          for (const user of res.users || []) {\n            if (loaded_count >= count) break;\n            results_all.push(user);\n            loaded_count++;\n          }\n          if (loaded_count >= count) break;\n          current_page += 1;\n          await sleep(2000);\n        }\n        result = { success: true, result: results_all };\n        break;\n      }\n      case \"getUserPosts\": {\n        const results = [];\n        let cursor = \"\";\n        while (true) {\n          const res = await xhsGet(\"/api/sns/web/v1/user_posted\", {\n            num: 10,\n            cursor,\n            user_id: args.user_id,\n            image_formats: \"jpg,webp,avif\",\n            xsec_token: args.xsec_token,\n            xsec_source: \"pc_feed\",\n          });\n          if (!res.notes || res.notes.length === 0) break;\n          for (const note of res.notes) {\n            if (args.count >= 0 && results.length >= args.count) break;\n            results.push(note);\n          }\n          if (!res.hasMore) break;\n          cursor = res.cursor || \"\";\n          if (args.count >= 0 && results.length >= args.count) break;\n          await sleep(2000);\n        }\n        result = { success: true, result: results };\n        break;\n      }\n      case \"getNoteComments\": {\n        let cursor = \"\";\n        const result_arr = [];\n        while (true) {\n          const count = args.count || 10;\n          if (count !== -1 && result_arr.length >= count) break;\n          const res = await xhsGet(\"/api/sns/web/v2/comment/page\", {\n            note_id: args.note_id,\n            cursor,\n            top_comment_id: \"\",\n            image_formats: \"jpg,webp,avif\",\n            xsec_token: args.xsec_token,\n          });\n          if (!res.comments || res.comments.length === 0) break;\n          result_arr.push(...res.comments);\n          cursor = res.cursor || \"\";\n          await sleep(2000);\n        }\n        result = { success: true, result: result_arr };\n        break;\n      }\n      case \"getMentions\": {\n        const res = await xhsGet(\"/api/sns/web/v1/you/mentions\", {\n          num: args.count || 20,\n          cursor: args.cursor || \"\",\n        });\n        result = { success: true, data: res };\n        break;\n      }\n      case \"getUserLikes\": {\n        const res = await xhsGet(\"/api/sns/web/v1/you/likes\", {\n          num: args.count || 20,\n          cursor: args.cursor || \"\",\n        });\n        result = { success: true, data: res };\n        break;\n      }\n      case \"getNewFollwers\": {\n        const res = await xhsGet(\"/api/sns/web/v1/you/new_followings\", {\n          num: args.count || 20,\n          cursor: args.cursor || \"\",\n        });\n        result = { success: true, data: res };\n        break;\n      }\n      case \"searchNotes\": {\n        const keyword = args.keyword;\n        const count = args.count || 20;\n        const searchId = createSearchId();\n        let current_page = 1;\n        const pageSize = 20;\n        const results_all = [];\n        let loaded_count = 0;\n        while (loaded_count < count) {\n          const res = await xhsPost(\"/api/sns/web/v1/search/notes\", {\n            keyword,\n            search_id: searchId,\n            page: current_page,\n            page_size: pageSize,\n            sort: \"general\",\n            note_type: 0,\n          });\n          if (!res.items || res.items.length === 0) break;\n          for (const item of res.items) {\n            if (loaded_count >= count) break;\n            results_all.push(item);\n            loaded_count++;\n          }\n          if (loaded_count >= count) break;\n          current_page += 1;\n          await sleep(2000);\n        }\n        result = results_all;\n        break;\n      }\n      default:\n        throw new Error(`Unknown tool: ${name}`);\n    }\n\n    return {\n      content: [\n        {\n          type: \"text\",\n          text: JSON.stringify(result, null, 2),\n        },\n      ],\n    };\n  } catch (error) {\n    return {\n      content: [\n        {\n          type: \"text\",\n          text: `Error: ${error.message}`,\n        },\n      ],\n      isError: true,\n    };\n  }\n});\n\nasync function main() {\n  const transport = new StdioServerTransport();\n  await server.connect(transport);\n  console.error(\"XHS MCP Server running on stdio\");\n}\n\nmain().catch((err) => {\n  console.error(\"Fatal error:\", err);\n  process.exit(1);\n});\n"}
