loop 16 | Tool=Write, Args={"file_path":"/home/silimon/mcp-auto/claude_code/mcp_server/bestk_vscode-internal-command-mcp-server/server.js","content":"import { FastMCP } from \"fastmcp\";\nimport { z } from \"zod\";\nimport { exec } from \"child_process\";\nimport { promisify } from \"util\";\nimport * as fs from \"fs\";\nimport * as path from \"path\";\nimport * as os from \"os\";\n\nconst execAsync = promisify(exec);\n\nconst server = new FastMCP({\n  name: \"vscode-internal-command-mcp-server\",\n  version: \"1.0.0\",\n  instructions:\n    \"VSCode MCP Server - Execute VSCode internal commands and get workspace info. Supports command execution and workspace query. Note: This is a standalone wrapper - commands are executed as system shell commands since VSCode is not available.\",\n  health: {\n    enabled: true,\n    path: \"/health\",\n    message: \"VSCode internal command MCP is running\",\n    status: 200,\n  },\n});\n\n// Tool 1: execute_vscode_command\n// Since we don't have VSCode, we execute shell commands instead\nserver.addTool({\n  name: \"execute_vscode_command\",\n  description:\n    \"Execute a VSCode internal command. In standalone mode, executes as a system shell command.\",\n  parameters: z.object({\n    command: z.string().describe(\"VSCode command or shell command to execute\"),\n    arguments: z.array(z.string()).optional().describe(\"Command arguments\"),\n  }),\n  execute: async (args) => {\n    try {\n      const { command, arguments: cmdArgs } = args;\n      // Map known VSCode commands to shell equivalents or provide helpful messages\n      const knownCommands = {\n        \"editor.action.formatDocument\": \"No shell equivalent - requires VSCode\",\n        \"workbench.action.files.save\": \"No shell equivalent - requires VSCode\",\n        \"editor.action.clipboardCopyAction\": \"No shell equivalent - requires VSCode\",\n        \"editor.action.clipboardPasteAction\": \"No shell equivalent - requires VSCode\",\n        \"workbench.action.files.saveAll\": \"No shell equivalent - requires VSCode\",\n      };\n\n      if (knownCommands[command]) {\n        return {\n          content: [\n            {\n              type: \"text\",\n              text: `${knownCommands[command]}\\n\\nNote: This MCP server is running in standalone mode without VSCode.\\nCommand requested: ${command}\\nArguments: ${JSON.stringify(cmdArgs || [])}`,\n            },\n          ],\n        };\n      }\n\n      // Execute as shell command\n      const cmd = cmdArgs ? `${command} ${cmdArgs.join(\" \")}` : command;\n      const { stdout, stderr } = await execAsync(cmd, {\n        cwd: process.cwd(),\n        timeout: 30000,\n      });\n      const output = stderr ? `STDERR:\\n${stderr}\\nSTDOUT:\\n${stdout}` : stdout || \"Command executed successfully\";\n      return {\n        content: [\n          {\n            type: \"text\",\n            text: `Command '${command}' executed successfully:\\n${output}`,\n          },\n        ],\n      };\n    } catch (error) {\n      return {\n        content: [\n          {\n            type: \"text\",\n            text: `Command execution failed: ${error instanceof Error ? error.message : String(error)}`,\n          },\n        ],\n        isError: true,\n      };\n    }\n  },\n});\n\n// Tool 2: list_vscode_commands\nserver.addTool({\n  name: \"list_vscode_commands\",\n  description:\n    \"List available VSCode commands. In standalone mode, returns system commands and supported VSCode command mappings.\",\n  parameters: z.object({}),\n  execute: async () => {\n    try {\n      // List common VSCode commands that this server supports\n      const vscodeCommands = [\n        \"editor.action.formatDocument\",\n        \"workbench.action.files.save\",\n        \"editor.action.clipboardCopyAction\",\n        \"editor.action.clipboardPasteAction\",\n        \"workbench.action.files.saveAll\",\n        \"editor.action.undo\",\n        \"editor.action.redo\",\n        \"workbench.action.closeEditor\",\n        \"workbench.action.newFile\",\n        \"workbench.action.openFolder\",\n      ];\n\n      // Also list some system commands available\n      const { stdout } = await execAsync(\"ls /usr/bin | head -50\", { timeout: 5000 });\n      const systemCommands = stdout.trim().split(\"\\n\").filter(Boolean);\n\n      const result = [\n        `Available VSCode Commands (${vscodeCommands.length} total):`,\n        ...vscodeCommands.slice(0, 20).map((c) => `  • ${c}`),\n        \"\",\n        `System Commands (first 20 from /usr/bin):`,\n        ...systemCommands.slice(0, 20).map((c) => `  • ${c}`),\n        \"\",\n        \"Note: In standalone mode, VSCode commands require VSCode to be running.\",\n        \"Use shell commands directly for system operations.\",\n      ].join(\"\\n\");\n\n      return {\n        content: [\n          {\n            type: \"text\",\n            text: result,\n          },\n        ],\n      };\n    } catch (error) {\n      return {\n        content: [\n          {\n            type: \"text\",\n            text: `Failed to list commands: ${error instanceof Error ? error.message : String(error)}`,\n          },\n        ],\n        isError: true,\n      };\n    }\n  },\n});\n\n// Tool 3: get_workspace_info\nserver.addTool({\n  name: \"get_workspace_info\",\n  description:\n    \"Get workspace information. In standalone mode, returns information about the current working directory.\",\n  parameters: z.object({}),\n  execute: async () => {\n    try {\n      const cwd = process.cwd();\n      const hostname = os.hostname();\n      const username = os.userInfo().username;\n\n      // Get directory contents\n      let dirEntries = [];\n      try {\n        const entries = fs.readdirSync(cwd, { withFileTypes: true });\n        dirEntries = entries.map((e) => ({\n          name: e.name,\n          type: e.isDirectory() ? \"directory\" : \"file\",\n        }));\n      } catch {\n        dirEntries = [];\n      }\n\n      const workspaceInfo = {\n        name: path.basename(cwd) || \"root\",\n        hostname,\n        username,\n        cwd,\n        folders: [\n          {\n            name: path.basename(cwd),\n            uri: `file://${cwd}`,\n          },\n        ],\n        activeEditor: \"N/A (standalone mode)\",\n        entries: dirEntries.slice(0, 50),\n      };\n\n      return {\n        content: [\n          {\n            type: \"text\",\n            text: `Workspace Info:\\n${JSON.stringify(workspaceInfo, null, 2)}`,\n          },\n        ],\n      };\n    } catch (error) {\n      return {\n        content: [\n          {\n            type: \"text\",\n            text: `Failed to get workspace info: ${error instanceof Error ? error.message : String(error)}`,\n          },\n        ],\n        isError: true,\n      };\n    }\n  },\n});\n\n// Start the server using stdio transport (for MCP client connection)\nasync function main() {\n  const port = parseInt(process.env.MCP_PORT || \"8080\", 10);\n  const host = process.env.MCP_HOST || \"localhost\";\n  const transport = process.env.MCP_TRANSPORT || \"httpStream\";\n\n  console.error(\n    `Starting VSCode Internal Command MCP Server on ${transport} (${host}:${port})...`,\n  );\n\n  if (transport === \"httpStream\") {\n    await server.start({\n      transportType: \"httpStream\",\n      httpStream: {\n        port,\n        host,\n        endpoint: \"/mcp\",\n      },\n    });\n  } else {\n    await server.start({\n      transportType: \"stdio\",\n    });\n  }\n\n  console.error(`VSCode Internal Command MCP Server started on ${transport}://${host}:${port}/mcp`);\n}\n\nmain().catch((error) => {\n  console.error(\"Failed to start server:\", error);\n  process.exit(1);\n});\n"}
