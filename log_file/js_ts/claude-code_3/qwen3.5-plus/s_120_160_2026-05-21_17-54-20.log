loop 14 | Tool=Bash, Args={"command":"node /home/silimon/MCP-Auto/mcp_server/1049633925_bestK_vscode-internal-command-mcp-server/standaloneServer.js &\nSERVER_PID=$!\nsleep 2\n\n# Full session flow with session ID tracking\necho \"=== Step 1: Initialize ===\"\nINIT_RESPONSE=$(curl -s -D- -X POST http://localhost:8080/mcp \\\n  -H \"Content-Type: application/json\" \\\n  -H \"Accept: application/json, text/event-stream\" \\\n  -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"1.0.0\"}}}')\n\necho \"$INIT_RESPONSE\"\n\n# Extract session ID from response headers or body\nSESSION_ID=$(echo \"$INIT_RESPONSE\" | grep -i \"mcp-session-id\" | tr -d '\\r' | cut -d' ' -f2 | tr -d '\"')\nif [ -z \"$SESSION_ID\" ]; then\n  SESSION_ID=$(echo \"$INIT_RESPONSE\" | grep -oP 'mcp-session-id: \\K[^;]+')\nfi\necho \"\"\necho \"Extracted session ID: $SESSION_ID\"\n\n# Now try to call tools/list with the session\necho \"\"\necho \"=== Step 2: List Tools ===\"\nif [ -n \"$SESSION_ID\" ]; then\n  curl -s -X POST http://localhost:8080/mcp \\\n    -H \"Content-Type: application/json\" \\\n    -H \"Accept: application/json, text/event-stream\" \\\n    -H \"X-Mcp-Session-Id: $SESSION_ID\" \\\n    -d '{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}'\nelse\n  echo \"No session ID found, trying without session...\"\n  # Try the initialized connection from the same curl\n  curl -s -X POST http://localhost:8080/mcp \\\n    -H \"Content-Type: application/json\" \\\n    -H \"Accept: application/json, text/event-stream\" \\\n    -d '{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}'\nfi\necho \"\"\n\nkill $SERVER_PID 2>/dev/null; wait $SERVER_PID 2>/dev/null","timeout":30000}
