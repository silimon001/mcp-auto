loop 18 | Tool=Write, Args={"file_path":"/home/silimon/MCP-Auto/mcp_server/943509346_1RB_mongo-mcp/wrapper.js","content":"#!/usr/bin/env node\nimport { MongoMemoryServer } from 'mongodb-memory-server';\n\nasync function main() {\n  const mongoMemoryServer = await MongoMemoryServer.create();\n  const uri = mongoMemoryServer.getUri();\n\n  console.error(`MongoMemoryServer started at: ${uri}`);\n\n  const { spawn } = await import('child_process');\n\n  const mcpServer = spawn('node', ['dist/index.js', uri], {\n    cwd: new URL('.', import.meta.url).pathname,\n    stdio: ['inherit', 'inherit', 'inherit'],\n    env: { ...process.env, MONGO_DB_NAME: 'test' },\n  });\n\n  mcpServer.on('error', (err) => {\n    console.error(`MCP Server error: ${err.message}`);\n    mongoMemoryServer.stop();\n    process.exit(1);\n  });\n\n  mcpServer.on('exit', (code) => {\n    console.error(`MCP Server exited with code ${code}`);\n    mongoMemoryServer.stop();\n    process.exit(code ?? 1);\n  });\n\n  process.on('SIGINT', async () => {\n    mcpServer.kill('SIGINT');\n    await mongoMemoryServer.stop();\n    process.exit(0);\n  });\n\n  process.on('SIGTERM', async () => {\n    mcpServer.kill('SIGTERM');\n    await mongoMemoryServer.stop();\n    process.exit(0);\n  });\n}\n\nmain().catch((err) => {\n  console.error(`Fatal: ${err.message}`);\n  process.exit(1);\n});\n"}
