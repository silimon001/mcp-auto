loop 11 | Tool=Write, Args={"file_path":"/home/silimon/MCP-Auto/mcp_server/1049633925_bestK_vscode-internal-command-mcp-server/standaloneServer.js","content":"#!/usr/bin/env node\n\"use strict\";\n\nconst { FastMCP } = require(\"fastmcp\");\nconst { z } = require(\"zod\");\nconst http = require(\"http\");\n\n// Mock VSCode API\nconst vscode = {\n  commands: {\n    _commands: new Map(),\n    registerCommand: (cmd, fn) => {\n      vscode.commands._commands.set(cmd, fn);\n      return { dispose: () => vscode.commands._commands.delete(cmd) };\n    },\n    getCommands: async (filterInternal) => {\n      const all = [...vscode.commands._commands.keys()];\n      if (filterInternal) {\n        return all.filter((c) => !c.startsWith(\"_\"));\n      }\n      return all;\n    },\n    executeCommand: async (cmd, ...args) => {\n      const fn = vscode.commands._commands.get(cmd);\n      if (fn) return fn(...args);\n      throw new Error(`Command '${cmd}' not found`);\n    },\n  },\n  workspace: {\n    name: \"standalone-workspace\",\n    workspaceFolders: [\n      {\n        name: \"workspace\",\n        uri: { toString: () => \"file:///workspace\" },\n      },\n    ],\n    getConfiguration: () => ({\n      get: (key, defaultValue) => {\n        const config = {\n          \"vscode-internal-command-mcp-server.host\": \"localhost\",\n          \"vscode-internal-command-mcp-server.port\": 8080,\n          \"vscode-internal-command-mcp-server.autoStart\": true,\n          \"vscode-internal-command-mcp-server.asyncExecution\": true,\n          \"vscode-internal-command-mcp-server.executionDelay\": 500,\n          \"vscode-internal-command-mcp-server.allowedCommands\": [],\n        };\n        return config[key] ?? defaultValue;\n      },\n    }),\n  },\n  window: {\n    createStatusBarItem: () => ({\n      show: () => {},\n      dispose: () => {},\n      text: \"\",\n    }),\n  },\n};\n\n// Override require to inject vscode mock\nconst Module = require(\"module\");\nconst originalRequire = Module.prototype.require;\nModule.prototype.require = function (id) {\n  if (id === \"vscode\") return vscode;\n  return originalRequire.apply(this, arguments);\n};\n\nclass CommandExecutor {\n  constructor() {\n    this.allowedCommands = [];\n    this.asyncExecution = true;\n    this.executionDelay = 500;\n    this._taskQueue = new Map();\n    this._taskIdCounter = 0;\n    this._stats = { total: 0, pending: 0, running: 0, completed: 0, failed: 0, cancelled: 0 };\n    this._timer = null;\n    this._startBackgroundProcessing();\n  }\n\n  _startBackgroundProcessing() {\n    this._timer = setInterval(() => {\n      for (const [id, task] of this._taskQueue.entries()) {\n        if (task.status === \"pending\" && Date.now() >= task.executeAt) {\n          task.status = \"running\";\n          this._stats.pending--;\n          this._stats.running++;\n          this._executeTask(id, task);\n        }\n      }\n    }, 100);\n    this._timer.unref();\n  }\n\n  async _executeTask(id, task) {\n    try {\n      await vscode.commands.executeCommand(task.command, ...(task.args || []));\n      task.status = \"completed\";\n      task.result = { success: true };\n      this._stats.running--;\n      this._stats.completed++;\n    } catch (error) {\n      task.status = \"failed\";\n      task.error = error.message;\n      this._stats.running--;\n      this._stats.failed++;\n    }\n  }\n\n  submitTask(command, args, delay) {\n    const id = `bg_task_${++this._taskIdCounter}_${Date.now()}`;\n    this._taskQueue.set(id, {\n      command,\n      args,\n      status: \"pending\",\n      createdAt: Date.now(),\n      executeAt: Date.now() + (delay || 0),\n    });\n    this._stats.total++;\n    this._stats.pending++;\n    return id;\n  }\n\n  getTaskStats() {\n    return { ...this._stats };\n  }\n\n  async executeCommand(command, args = []) {\n    if (!this.isCommandAllowed(command)) {\n      throw new Error(`Command '${command}' is not allowed`);\n    }\n\n    if (this.asyncExecution) {\n      const taskId = this.submitTask(command, args, this.executionDelay);\n      const stats = this.getTaskStats();\n      return {\n        success: true,\n        async: true,\n        taskId,\n        message: `Command '${command}' submitted for background execution with ${this.executionDelay}ms delay`,\n        command,\n        arguments: args,\n        executionDelay: this.executionDelay,\n        queueLength: stats.pending + stats.running,\n        taskStats: stats,\n      };\n    } else {\n      try {\n        const result = await vscode.commands.executeCommand(command, ...(args || []));\n        return { success: true, async: false, result, command, arguments: args };\n      } catch (error) {\n        return {\n          success: false,\n          async: false,\n          error: error.message,\n          command,\n          arguments: args,\n        };\n      }\n    }\n  }\n\n  async getAvailableCommands() {\n    const commands = await vscode.commands.getCommands();\n    const filtered = this.allowedCommands.length > 0 ? commands.filter((cmd) => this.isCommandAllowed(cmd)) : commands;\n    return filtered.sort();\n  }\n\n  isCommandAllowed(command) {\n    if (this.allowedCommands.length === 0) return true;\n    return this.allowedCommands.some((allowed) => {\n      if (allowed.endsWith(\"*\")) {\n        return command.startsWith(allowed.slice(0, -1));\n      }\n      return command === allowed;\n    });\n  }\n\n  dispose() {\n    if (this._timer) clearInterval(this._timer);\n  }\n}\n\nasync function main() {\n  const config = vscode.workspace.getConfiguration(\"vscode-internal-command-mcp-server\");\n  const host = config.get(\"vscode-internal-command-mcp-server.host\", \"localhost\");\n  const port = config.get(\"vscode-internal-command-mcp-server.port\", 8080);\n\n  const server = new FastMCP({\n    name: \"vscode-mcp-server\",\n    version: \"1.0.0\",\n    instructions:\n      \"VSCode MCP Server - Execute VSCode internal commands and get workspace info. Supports command execution and workspace queries.\",\n    health: {\n      enabled: true,\n      path: \"/health\",\n      message: \"VSCode internal command MCP is running\",\n      status: 200,\n    },\n  });\n\n  const commandExecutor = new CommandExecutor();\n\n  server.addTool({\n    name: \"execute_vscode_command\",\n    description: \"Execute a VSCode internal command\",\n    parameters: z.object({\n      command: z.string().describe(\"VSCode command ID to execute\"),\n      arguments: z.array(z.string()).optional().describe(\"Command arguments\"),\n    }),\n    execute: async (args) => {\n      try {\n        const { command, arguments: cmdArgs } = args;\n        const result = await commandExecutor.executeCommand(command, cmdArgs || []);\n        return `Command execution result: ${JSON.stringify(result, null, 2)}`;\n      } catch (error) {\n        return `Command execution failed: ${error instanceof Error ? error.message : String(error)}`;\n      }\n    },\n  });\n\n  server.addTool({\n    name: \"list_vscode_commands\",\n    description: \"List all available VSCode commands\",\n    parameters: z.object({}),\n    execute: async () => {\n      try {\n        const commands = await commandExecutor.getAvailableCommands();\n        const list = commands.slice(0, 20).join(\"\\n\");\n        const suffix = commands.length > 20 ? `\\n...(${commands.length - 20} more commands)` : \"\";\n        return `Available commands (${commands.length}):\\n${list}${suffix}`;\n      } catch (error) {\n        return `Failed to get command list: ${error instanceof Error ? error.message : String(error)}`;\n      }\n    },\n  });\n\n  server.addTool({\n    name: \"get_workspace_info\",\n    description: \"Get current workspace information\",\n    parameters: z.object({}),\n    execute: async () => {\n      try {\n        const workspaceInfo = {\n          name: vscode.workspace.name || \"unnamed workspace\",\n          folders: vscode.workspace.workspaceFolders?.map((f) => ({\n            name: f.name,\n            uri: f.uri.toString(),\n          })) || [],\n          activeEditor: \"no active editor (standalone mode)\",\n        };\n        return `Workspace info:\\n${JSON.stringify(workspaceInfo, null, 2)}`;\n      } catch (error) {\n        return `Failed to get workspace info: ${error instanceof Error ? error.message : String(error)}`;\n      }\n    },\n  });\n\n  await server.start({\n    transportType: \"httpStream\",\n    httpStream: {\n      port,\n      host,\n      endpoint: \"/mcp\",\n    },\n  });\n\n  console.log(`Standalone MCP server running at http://${host}:${port}/mcp`);\n  console.log(`Health check at http://${host}:${port}/health`);\n\n  // Graceful shutdown\n  process.on(\"SIGINT\", async () => {\n    console.log(\"Shutting down...\");\n    commandExecutor.dispose();\n    await server.stop();\n    process.exit(0);\n  });\n  process.on(\"SIGTERM\", async () => {\n    console.log(\"Shutting down...\");\n    commandExecutor.dispose();\n    await server.stop();\n    process.exit(0);\n  });\n}\n\nmain().catch((error) => {\n  console.error(\"Failed to start server:\", error);\n  process.exit(1);\n});\n"}
